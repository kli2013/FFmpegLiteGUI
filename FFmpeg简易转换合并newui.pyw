            def on_click(event):
                mask.withdraw()
                mask.update_idletasks()
                hex_color = get_pixel_color(event.x_root, event.y_root)
                mask.destroy()
                self.chroma_color.set(hex_color)
            def on_escape(event):
                mask.destroy()
            mask.bind("<Button-1>", on_click)
            mask.bind("<Escape>", on_escape)
            self.wait_window(mask)

