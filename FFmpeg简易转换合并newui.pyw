        _cur_token = self.enhance_settings.get("style_preset", "")
        self.style_preset_var.set(STYLE_PRESETS[_cur_token][0] if _cur_token in STYLE_PRESETS else "无")
        self.style_preset_combo = ttk.Combobox(style_row, textvariable=self.style_preset_var,
                                               values=STYLE_DISPLAYS, state="readonly", width=10)
        self.style_preset_combo.pack(side=tk.LEFT, padx=5)
        ttk.Label(style_row, text="强度", width=4).pack(side=tk.LEFT, padx=(6, 0))
        self.style_intensity_var = tk.DoubleVar(value=self.enhance_settings.get("style_intensity", 1.0))
        ttk.Scale(style_row, from_=0.0, to=1.0, variable=self.style_intensity_var,
                  orient=tk.HORIZONTAL, length=120).pack(side=tk.LEFT, padx=5, fill=tk.X, expand=True)
        self.style_pct_var = tk.StringVar()
        ttk.Label(style_row, textvariable=self.style_pct_var, width=7,
                  anchor=tk.E).pack(side=tk.LEFT, padx=(4, 0))

        # 实时显示「当前强度 → 实际滤镜参数」，让滑块与内部数值直接对应
        preview_row = ttk.Frame(style_frame)
        preview_row.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(preview_row, text="滤镜", width=6).pack(side=tk.LEFT, anchor=tk.N)
        self.style_preview_var = tk.StringVar()
        _pv = ttk.Label(preview_row, textvariable=self.style_preview_var,
                        font=("TkFixedFont", 9), wraplength=400, justify=tk.LEFT,
                        foreground="#555555")
        _pv.pack(side=tk.LEFT, padx=5, fill=tk.X, expand=True)

        def _update_style_preview(*_a):
            _disp = self.style_preset_var.get()
            _tok = STYLE_DISPLAY_TO_TOKEN.get(_disp, "")
            _i = self.style_intensity_var.get()
            self.style_pct_var.set(f"{int(round(_i * 100))}%")
            if not _tok or _tok not in STYLE_PRESETS:
                self.style_preview_var.set("（未选择预设）")
                return
            _chain = STYLE_PRESETS[_tok][1]
            _scaled = _scale_look_chain(_chain, _i)
            # 逗号后补空格，便于 Label 自动换行；等宽字体对齐参数
            self.style_preview_var.set(_scaled.replace(",", ", "))

        self.style_preset_var.trace_add("write", _update_style_preview)
        self.style_intensity_var.trace_add("write", _update_style_preview)
        _update_style_preview()
        ToolTip(style_frame,
                "一键套用调色风格（暖/冷/褪色/黑白/电影感等）。\n"
                "纯内置滤镜链实现，无需外部 LUT 文件；强度 0~100% 线性调节效果强弱。\n"
                "与上方 6 个颜色滑块相互独立，可叠加使用。\n"
                "下方实时显示「当前强度对应的实际滤镜参数」，滑块即所见数值。")

        # 反色（negate）：勾选按钮放在颜色校正块下方（不归入颜色校正块、不参与其重置）。
        # 滤镜链里放靠后（颜色校正之后），对绿幕抠图无效（子视频绿幕在滤镜链之后单独
        # 处理，negate 在绿幕之后才生效，不会破坏抠像）
        negate_chk = ttk.Checkbutton(right_frame, text="反色 (negate)", variable=self.negate_enabled)
        negate_chk.pack(anchor=tk.W, pady=(3, 0))
        ToolTip(negate_chk,
                "对整个画面取反色（负片效果）。\n"
                "滤镜会加在颜色校正/色相之后（靠后位置）；子视频若开绿幕抠图，\n"
                "negate 会在绿幕之后生效，不影响抠像。")
    
        # ==================== 第三栏：实时预览（全内存）====================
        # 2026-10-03 用户要求：把「当前真实帧」摆在设置右侧，实时反映增强滤镜效果。
        #   取帧：ffmpeg 输入级 -ss + setpts 还原 → PPM 字节直接进内存（零落盘、无 PIL）。
        #   套链：走 build_video_filter_chain 的增强段本体（与正式导出逐字同源）。
        #   并发：ffmpeg 在 worker 线程跑，PhotoImage 只在主线程 after(0) 里换
        #        （Tk 非线程安全）；拖滑块期间用 150ms 合并，避免每动一下就 spawn。
        _pv_state = {"src": "", "t": -1.0, "static": False,
                     "orig": None, "proc": None, "holding": False, "after": None,
                     "bw": 0, "bh": 0, "sug": None}
        _PV_DEBOUNCE_MS = 150

        def _pv_collect_enh():
            """UI 变量 → enhance_settings 字典。预览渲染与「保存并关闭」共用同一份，
            保证「预览所见 = 导出所得」（若两处各写一份，改一个键就会悄悄漂移）。"""
            return {
                "denoise_enabled": self.denoise_enabled.get(),
                "denoise_mode": self.denoise_mode.get().split("（")[0],
                "denoise_spatial": self.denoise_spatial.get(),
                "denoise_temporal": self.denoise_temporal.get(),
                "sharpen_enabled": self.sharpen_enabled.get(),
                "sharpen_mode": self.sharpen_mode.get().split("（")[0],
                "sharpen_strength": self.sharpen_strength.get(),
                "ivtc_enabled": self.ivtc_enabled.get(),
                "deblock_enabled": self.deblock_enabled.get(),
                "deblock_strength": self.deblock_strength.get(),
                "deblock_block": int(self.deblock_block.get() or 4),
                "colorspace_enabled": self.colorspace_enabled.get(),
                "colorspace_matrix": self.colorspace_matrix.get(),
                "mark_primaries": self.mark_primaries.get(),
                "mark_transfer": self.mark_transfer.get(),
                "mark_colorspace": self.mark_colorspace.get(),
                "mark_range": self.mark_range.get(),
                "tonemap_enabled": self.tonemap_enabled.get(),
                "tonemap_mode": self.tonemap_mode.get(),
                "eq_brightness": eq_brightness_var.get(),
                "eq_contrast": eq_contrast_var.get(),
                "eq_saturation": eq_saturation_var.get(),
                "eq_gamma": eq_gamma_var.get(),
                "hue_angle": hue_angle_var.get(),
                "hue_saturation": hue_saturation_var.get(),
                "style_preset": STYLE_DISPLAY_TO_TOKEN.get(self.style_preset_var.get(), ""),
                "style_intensity": round(self.style_intensity_var.get(), 3),
                "negate_enabled": self.negate_enabled.get(),
                "enh_seg_enabled": self.enh_seg_enabled.get(),
                "enh_seg_start": self.enh_seg_start.get().strip(),
                "enh_seg_end": self.enh_seg_end.get().strip(),
                "enh_seg_loop": self.enh_seg_loop.get(),
                "enh_seg_cycle": self.enh_seg_cycle.get().strip(),
                "enh_seg_once": self.enh_seg_once.get().strip(),
                "enh_preview_time": self._enh_pv_time.get().strip(),
            }

        def _pv_speed():
            # 只用于 enh_seg 的 enable 换算（要与导出同口径）；主视频未变速时本身就是 1.0
            try:
                return _trim_speed_from_settings(self.app.get_current_settings())[1]
            except Exception:
                return 1.0

        def _pv_measure_box():
            """实测预览框可用像素（扣 sunken 边框 + label 内边距）；只有量到有效值才写回锁定。"""
            try:
                _w = pv_canvas.winfo_width() - 10
                _h = pv_canvas.winfo_height() - 10
            except Exception:
                _w = _h = 0
            if _w < 64 or _h < 64:
                return (_pv_state.get("bw") or 400), (_pv_state.get("bh") or 340)
            _pv_state["bw"], _pv_state["bh"] = _w, _h
            return _w, _h

        def _pv_box_size():
            """预览框尺寸：实测一次后锁定，只有真实布局变化（拉窗口 / 拖分栏）才重测。

            ⛔ 绝不能每次渲染都重测：图片 → label 请求尺寸 → 框被撑大 → 下一帧按更大的框
            缩放 → 再撑大……单调漂移（2026-10-03 用户反馈：每拖一次滑块左右空隙就变大一点，
            上下因窗口高度钳制变化小）。现在 pv_canvas 已 pack_propagate(False) 断开这条反馈，
            这里再锁一层双保险，拖滑块期间尺寸恒定不变。"""
            _bw, _bh = _pv_state.get("bw") or 0, _pv_state.get("bh") or 0
            if _bw >= 64 and _bh >= 64:
                return _bw, _bh
            return _pv_measure_box()

        def _pv_cmd(_t, _static, _enh):
            _bw, _bh = _pv_box_size()
            return build_enhance_preview_cmd(
                self.app.ffmpeg_cmd, _pv_state["src"], _t,
                enhance_settings=_enh, static_image=_static, speed_factor=_pv_speed(),
                box_w=_bw, box_h=_bh)

        def _pv_run_ffmpeg(_cmd):
            """跑子进程取一帧 → PPM 字节；失败返回 (None, 简短原因)。"""
            try:
                _proc = subprocess.Popen(_cmd, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE,
                                         creationflags=_ffmpeg_spawn_flags())
                try:
                    _data, _err = _proc.communicate(timeout=30)
                except subprocess.TimeoutExpired:
                    _proc.kill()
                    _data, _err = _proc.communicate()
            except Exception:
                return None, "ffmpeg 启动失败"
            if _proc.returncode != 0 or not _data:
                _tail = [_l.strip() for _l in
                         (_err or b"").decode("utf-8", "replace").splitlines() if _l.strip()]
                return None, (_tail[-1][:120] if _tail else "ffmpeg 未返回图像")
            return _data, ""

        def _pv_async(_cmd, _on_done):
            """worker 线程跑 ffmpeg，结果经 after(0) 回主线程（不阻塞 UI）。"""
            def _worker():
                _ppm, _err = _pv_run_ffmpeg(_cmd)
                def _done():
                    with suppress(Exception):
                        if win.winfo_exists():
                            _on_done(_ppm, _err)
                with suppress(Exception):
                    win.after(0, _done)
            threading.Thread(target=_worker, daemon=True).start()

        def _pv_paint(_ppm):
            try:
                _img = tk.PhotoImage(data=_ppm)
            except Exception:
                self._enh_pv_status.set("图像渲染失败")
                return
            self._enh_pv_label.configure(image=_img, text="")
            self._enh_pv_label._img = _img   # 必须持引用，否则被 GC 后图变空白

        def _pv_show_current():
            """按状态显示：按住=原图，否则=效果帧（效果帧还没出就先显示原图）。"""
            _ppm = _pv_state["orig"] if _pv_state["holding"] else (
                _pv_state["proc"] or _pv_state["orig"])
            if _ppm is not None:
                _pv_paint(_ppm)

        def _pv_hold(_on):
            _pv_state["holding"] = _on
            _pv_show_current()

        def _pv_on_proc(_ppm, _err):
            if _ppm is None:
                self._enh_pv_status.set("效果帧失败：" + _err)
                return
            _pv_state["proc"] = _ppm
            _w, _h = _ppm_dimensions_from_bytes(_ppm)
            _msg = f"{_w}x{_h} · 取帧 {_pv_state['t']:.2f}s"
            if _pv_state["static"]:
                _msg += " · 静态图片"
            # 时间段：取帧点落在生效窗口外时，这帧本来就是原样 —— 不明说的话，
            # 用户会当成「调了参数没生效」（2026-10-03 反馈：默认 3s vs 结束 2s）。
            _cov, _sug = enh_seg_probe_time(_pv_collect_enh(), _pv_state["t"], _pv_speed())
            _pv_state["sug"] = _sug
            if not _cov:
                _msg += " · 取帧点在生效区间外：画面为原样"
                if _pv_state["static"]:
                    _msg += "（静态图片只有这一帧，请取消「启用时间段」）"
                    _pv_state["sug"] = None      # 无处可跳，别给手型光标
                elif _sug is not None:
                    _msg += f"，建议 {_sug:.2f}s（点此跳过去）"
                else:
                    _msg += "，可取消「启用时间段」再看"
            self._enh_pv_status.set(_msg)
            _pv_show_current()

        def _pv_on_orig(_ppm, _err):
            if _ppm is None:
                self._enh_pv_status.set("取原帧失败：" + _err)
                return
            _pv_state["orig"] = _ppm
            if _pv_state["holding"]:
                _pv_paint(_ppm)
            # 基帧换了 → 立刻拿新基帧重渲一版效果帧
            _pv_async(_pv_cmd(_pv_state["t"], _pv_state["static"], _pv_collect_enh()),
                      _pv_on_proc)

        def _pv_render(_reload=False):
            """拉一帧并渲染。_reload=True 强制重取原帧（源文件/时间点变了）。"""
            # 取帧入口统一走素材解析：队列项/画中画轨道/子视频 → current_file，
            # 转换页 → app.input_file（详见 resolve_enh_preview_source）
            _src = resolve_enh_preview_source(self)
            if not _src or not getattr(self.app, "ffmpeg_cmd", None):
                _pv_state["orig"] = _pv_state["proc"] = None
                self._enh_pv_label.configure(image="", text="（未选择输入文件）")
                self._enh_pv_label._img = None
                self._enh_pv_status.set("取不到可用素材，无法预览")
                return
            # 静态图片只有 t=0 一帧：-ss 会被忽略（与 extract_video_frame_scaled 同口径）
            _static = _is_static_image_file(_src)
            if _static:
                _t = 0.0
            else:
                try:
                    _t = max(0.0, float((self._enh_pv_time.get() or "0").strip()))
                except ValueError:
                    _t = 0.0
            _moved = (_reload or _pv_state["orig"] is None
                      or _src != _pv_state["src"] or abs(_t - _pv_state["t"]) > 1e-6)
            _pv_state["src"], _pv_state["t"], _pv_state["static"] = _src, _t, _static
            if _moved:
                self._enh_pv_status.set("正在取原帧…")
                _pv_async(_pv_cmd(_t, _static, None), _pv_on_orig)
            else:
                self._enh_pv_status.set("正在渲染…")
                _pv_async(_pv_cmd(_t, _static, _pv_collect_enh()), _pv_on_proc)

        def _pv_reload():
            _pv_state["orig"] = None
            _pv_render(True)

        def _pv_jump_seg(*_a):
            """状态行给出「建议 X.XXs」时点一下就跳过去（改 _enh_pv_time → trace 自动重取）。"""
            _s = _pv_state.get("sug")
            if _s is None:
                return
            with suppress(Exception):
                self._enh_pv_time.set(f"{_s:.2f}")

        def _pv_status_style(*_a):
            """有建议秒数才显示手型光标 —— 免得看着能点、其实点了没反应。"""
            with suppress(Exception):
                _pv_status_lbl.configure(
                    cursor="hand2" if _pv_state.get("sug") is not None else "")

        def _pv_schedule(*_a):
            """合并渲染：拖滑块时每 150ms 最多真跑一次 ffmpeg。"""
            if _pv_state["after"] is not None:
                with suppress(Exception):
                    win.after_cancel(_pv_state["after"])
            _pv_state["after"] = win.after(_PV_DEBOUNCE_MS, _pv_render)

        def _pv_schedule_reload(*_a):
            """尺寸变了 → 基帧也要按新尺寸重取（旧基帧是按旧框缩的）。"""
            if _pv_state["after"] is not None:
                with suppress(Exception):
                    win.after_cancel(_pv_state["after"])
            _pv_state["after"] = win.after(200, _pv_reload)

        def _pv_on_resize(_e):
            # 只有「真实布局变化」才重测重取：首 map / 拖分栏 / 拉窗口。
            # 换图本身不会再触发这里 —— pv_canvas 已 pack_propagate(False)，
            # 图片尺寸撑不动框了（旧版正是因此每渲一帧框就大一圈）。
            _w, _h = _e.width - 10, _e.height - 10
            if _w < 64 or _h < 64:
                return
            _bw, _bh = _pv_state.get("bw") or 0, _pv_state.get("bh") or 0
            if abs(_w - _bw) < 24 and abs(_h - _bh) < 24:
                return  # 小于 24px 的抖动不值得重跑 ffmpeg
            _pv_state["bw"], _pv_state["bh"] = _w, _h
            if _pv_state["src"]:
                _pv_schedule_reload()

        preview_frame = ttk.Frame(paned)
        paned.add(preview_frame, weight=1)
        pv_box = ttk.LabelFrame(preview_frame, text="实时预览（内存中）", padding="5")
        pv_box.pack(fill=tk.BOTH, expand=True, pady=5)

        self._enh_pv_time = tk.StringVar(
            value=str(self.enhance_settings.get("enh_preview_time", "3")))
        pv_row = ttk.Frame(pv_box)
        pv_row.pack(fill=tk.X, pady=(0, 5))
        ttk.Label(pv_row, text="取帧(秒)").pack(side=tk.LEFT)
        ttk.Entry(pv_row, textvariable=self._enh_pv_time, width=8).pack(side=tk.LEFT, padx=(4, 8))
        ttk.Button(pv_row, text="重新取帧", width=9, command=lambda: _pv_reload()).pack(side=tk.LEFT)

        pv_canvas = ttk.Frame(pv_box, relief=tk.SUNKEN, borderwidth=1, width=420, height=360)
        pv_canvas.pack(fill=tk.BOTH, expand=True)
        # 关键：关掉尺寸传播 —— 框的大小从此只由布局（窗口/分栏）决定，
        # 不再被图片反向撑大。开着的后果是「换图 → label 请求变大 → 框变大 →
        # 下一帧按更大的框缩放」单调漂移（用户 2026-10-03 反馈的空隙越变越大）。
        # 关掉后仍需显式 width/height：否则请求尺寸为 0，分栏会把它压得很窄。
        pv_canvas.pack_propagate(False)
        self._enh_pv_label = tk.Label(pv_canvas, text="正在取帧…", anchor=tk.CENTER,
                                      background="#ffffff", foreground="#777777")
        self._enh_pv_label.pack(fill=tk.BOTH, expand=True, padx=3, pady=3)
        self._enh_pv_label.bind("<ButtonPress-1>", lambda _e: _pv_hold(True))
        self._enh_pv_label.bind("<ButtonRelease-1>", lambda _e: _pv_hold(False))
        pv_canvas.bind("<Configure>", _pv_on_resize)
        self._enh_pv_status = tk.StringVar(value="")
        _pv_status_lbl = ttk.Label(pv_box, textvariable=self._enh_pv_status,
                                   foreground="#777777")
        _pv_status_lbl.pack(anchor=tk.W, pady=(5, 0))
        # 状态行带「建议 X.XXs」时单击即可把取帧时间挪过去（省得手抄数字）
        _pv_status_lbl.bind("<Button-1>", _pv_jump_seg)
        self._enh_pv_status.trace_add("write", _pv_status_style)
        ToolTip(_pv_status_lbl,
                "这一帧的信息：像素尺寸 · 取帧秒数。\n"
                "启用时间段后若取帧点落在区间外，画面会是原样（看着像没生效）——\n"
                "此时这里会给出建议秒数，单击即可跳过去。")
        ttk.Label(pv_box, text="按住图片看原图，松开看效果（不改磁盘）",
                  foreground="#888888").pack(anchor=tk.W)
        ToolTip(pv_box,
                "实时预览当前输入的真实帧，调参即时生效、所见即所得。\n"
                "• 取帧(秒)：从主视频第几秒抓这一帧（改了会自动重取，手动按钮亦可）\n"
                "• 显示的滤镜 = 本窗口全部增强设置（降噪/锐化/去块/色彩/色调/eq·hue/风格/反色/时间段）\n"
                "  链由正式导出同一份 build_video_filter_chain 生成，预览=导出\n"
                "• ⚠ 开了「启用时间段」时，取帧秒数要落在起止区间内才能看到效果；\n"
                "  落在区间外就是原样画面（默认 3s 常在这类早段窗口之外）。\n"
                "  下方状态行会标明并给出建议秒数，点一下即可跳过去\n"
                "• 全程 ffmpeg 管道 + tk.PhotoImage，不写任何临时文件、不引入 PIL\n"
                "• 为让预览跟手，画面会先缩到预览尺寸再套链：颜色类效果与全分辨率一致，\n"
                "  仅降噪/锐化的强度观感会随分辨率略有差异")

        # 任一相关变量改动 → 合并重渲（含「取帧秒数」本身，改了会自动重取）
        _pv_vars = [
            self.denoise_enabled, self.denoise_mode, self.denoise_spatial, self.denoise_temporal,
            self.sharpen_enabled, self.sharpen_mode, self.sharpen_strength,
            self.ivtc_enabled, self.deblock_enabled, self.deblock_strength, self.deblock_block,
            self.colorspace_enabled, self.colorspace_matrix,
            self.tonemap_enabled, self.tonemap_mode, self.negate_enabled,
            eq_brightness_var, eq_contrast_var, eq_saturation_var, eq_gamma_var,
            hue_angle_var, hue_saturation_var,
            self.style_preset_var, self.style_intensity_var,
            self.enh_seg_enabled, self.enh_seg_start, self.enh_seg_end,
            self.enh_seg_loop, self.enh_seg_cycle, self.enh_seg_once,
            self._enh_pv_time,
        ]
        for _v in _pv_vars:
            _v.trace_add("write", _pv_schedule)
        win.after(80, _pv_render)   # 起首帧（略延后，避开窗口布局）

        # ---- 底部按钮 ----
        btn_frame = ttk.Frame(main)
        btn_frame.pack(fill=tk.X, pady=(5,10))
    
        def save_and_close():
            if self.tonemap_enabled.get():
                # tonemap 输出恒为 bt709/tv：仍为 auto（旧版「随源」）的标记自动补默认（手动改过的尊重手动值）
                if self.mark_primaries.get() == "auto":
                    self.mark_primaries.set("bt709")
                if self.mark_transfer.get() == "auto":
                    self.mark_transfer.set("bt709")
                if self.mark_colorspace.get() == "auto":
                    self.mark_colorspace.set("bt709")
                if self.mark_range.get() == "auto":
                    self.mark_range.set("tv")
            # 与实时预览共用同一份采集器：预览看到的就是这里存下来的，杜绝两处漂移
            self.enhance_settings.update(_pv_collect_enh())
            if self.app:
                self.app.update_command_preview()
            if hasattr(self, '_preview_callback') and self._preview_callback:
                self._preview_callback()
            win.destroy()
    
        ttk.Button(btn_frame, text="保存并关闭", command=save_and_close).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="取消", command=win.destroy).pack(side=tk.LEFT, padx=5)




    def open_crop_editor(self, file_path=None, x_var=None, y_var=None, w_var=None, h_var=None,
                         frame_extractor=None, helper_rect=None, helper_label="裁剪框",
                         safe_border=False, title=None, on_apply=None,
                         initial_time_override=None, show_simple_pos=True, simple_pos_cb=None,
                         show_black_border=True, black_border_cb=None,
                         allow_alt_move=True, preload_points=None,
                         apply_label="保存并应用裁剪", clear_label="清除矩形", info_extra=None, modal=False):
        """统一矩形选区编辑器（富 UI 版）：可视化裁剪窗口与 delogo/局部滤镜可视化选区共用。

        完整功能：大窗口（按屏幕 0.9 计算、最低高度 720）、SAR 坐标换算、时间跳转重新取帧、
        拖拽绘制/Alt 整体搬移、宽高左上数值双向联动、边缘/平移微调、自动检测黑边、
        简易位置入口、清除/应用/取消三行按钮（文字可经 clear_label/apply_label 覆写，delogo 传自己的）。

        裁剪语境：show_simple_pos/show_black_border 开、on_apply=None（默认写回 crop_*）。
        delogo/局部滤镜语境：只取坐标 —— show_simple_pos/show_black_border 关、
        safe_border 留边（防滤镜失败）、helper_rect 显示裁剪框辅助、on_apply 写回 x/y/w/h。
        """
        """可视化裁剪窗口 - 拖拽绘制矩形，支持时间跳转重新取帧，初始时间自动从主界面或者当前编辑窗口的截取起始时间获取"""
        input_file = file_path
        if not input_file or not os.path.exists(input_file):
            # 恢复原语义（RectSelectEditor 重构时误删，2026-09-23）：无显式 file_path 时
            # 先读本滤镜帧的 current_file——封装页轨道/水印/队列窗口里它是轨道/任务文件
            # （这些语境的可视化裁剪源），转换页=输入文件。current_file 也无效时才按
            # _context 门控兜底 app.input_file（仅转换页；封装页不跨页拿转换页视频）。
            input_file = getattr(self, 'current_file', None)
        if not input_file or not os.path.exists(input_file):
            if getattr(self, "_context", "convert") == "convert":
                input_file = self.app.input_file.get().strip()
        if alert_if(not input_file or not os.path.exists(input_file), "错误", "请先选择一个有效的输入文件", 'error'):
            return
    
        ffmpeg = self.app.ffmpeg_cmd
        if alert_if(not ffmpeg, "错误", "未找到 ffmpeg，无法提取视频帧", 'error'):
            return
        frame_extractor = frame_extractor or getattr(self, "node_frame_extractor", None) \
            or self.extract_video_frame_scaled
    
        # ----- 从当前轨道或主界面获取截取起始时间 未启用则为0秒 -----
        initial_time = 0.0
        if hasattr(self, 'get_trim_settings_callback') and self.get_trim_settings_callback is not None:
            trim_settings = self.get_trim_settings_callback()
            if trim_settings.get("trim_enabled", False):
                start_str = trim_settings.get("trim_start", "").strip()
                if start_str:
                    sec = time_to_seconds(start_str)
                    if sec is not None and sec >= 0:
                        initial_time = sec
                        self.app._append_info_ui(f"[裁剪] 使用当前编辑窗口的截取起始时间: {sec:.2f}s")
        elif self.override_settings is not None:
            if self.override_settings.get("trim_enabled", False):
                start_str = self.override_settings.get("trim_start", "").strip()
                if start_str:
                    sec = time_to_seconds(start_str)
                    if sec is not None and sec >= 0:
                        initial_time = sec
                        self.app._append_info_ui(f"[裁剪] 使用外部设置的截取起始时间: {sec:.2f}s")
        elif self.current_track is not None:
            enc = self.current_track.enc_settings
            if enc.get("trim_enabled", False):
                start_str = enc.get("trim_start", "").strip()
                if start_str:
                    sec = time_to_seconds(start_str)
                    if sec is not None and sec >= 0:
                        initial_time = sec
                        self.app._append_info_ui(f"[裁剪] 使用轨道截取起始时间: {sec:.2f}s")
        elif getattr(self, "_context", "convert") == "convert":
            # 2026-09-23 收紧：主界面截取只属于转换页（_context=="convert"）。
            # 封装页/水印/队列窗口此前会跨页兜底到转换页截取设置（互相兜底无意义，
            # 且另一页的截取对本页画面语义错误），现在非转换页一律从 0 秒取帧。
            if self.app.trim_frame.trim_enabled.get():
                start_str = self.app.trim_frame.trim_start.get().strip()
                if start_str:
                    sec = time_to_seconds(start_str)
                    if sec is not None and sec >= 0:
                        initial_time = sec
                        self.app._append_info_ui(f"[裁剪] 使用主界面截取起始时间: {sec:.2f}s")
        # 外部覆盖（delogo 传 0 或指定；None=沿用上面 trim 计算）
        if initial_time_override is not None:
            initial_time = initial_time_override
    
        # ----- 初始取帧时间钳制（2026-09-08）-----
        # 换新主视频后旧「截取」起始时间会残留（各来源都不随加载重置），initial_time
        # 可能超出新视频时长 → ffmpeg -ss 越过 EOF → rc=0 但输出 0 字节 → 取帧必败。
        # 实测定版：-ss ≥ 时长 → 空输出；-ss = 时长-0.1 → 正常出帧。钳到末帧前 0.1s，
        # 只日志提示不弹窗（时间类校验铁律）。
        _dur = self.app._get_media_duration(input_file)
        if _dur is not None and initial_time > max(0.0, _dur - 0.1):
            self.app._append_info_ui(
                f"[裁剪] 初始取帧时间 {initial_time:.2f}s 超出视频时长 {_dur:.2f}s"
                "（旧「截取」设置残留），已钳制到末帧附近")
            initial_time = max(0.0, _dur - 0.1)

        current_time = initial_time

        # ----- 获取原始视频尺寸（用于计算显示比例） -----
        orig_w, orig_h = self.app._get_video_dimensions_cached(input_file)
        if orig_w is None or orig_h is None:
            # 降级：使用固定默认值
            orig_w, orig_h = 1920, 1080
            self.app._append_info_ui("[裁剪] 无法获取原始尺寸，使用默认值")
        # 2026-09-26「节点效果编辑器按时间取帧」：节点语境下编辑器坐标空间必须对齐到
        # 节点输出真实尺寸（取帧器产出的帧就是它），否则裁剪矩形坐标与正式输出对不上。
        if getattr(self, "node_frame_orig_size", None):
            orig_w, orig_h = self.node_frame_orig_size
            self.app._append_info_ui(
                "[裁剪] 节点语境：坐标空间对齐到节点输出 %dx%d" % (orig_w, orig_h))
    
        # ----- 非方形像素（SAR）检测（2026-09-07）：HandBrake crop 等场景会写 SAR
        # 保住源显示比例，出现「编码 1080x1080、播放器按 9:16 拉伸成 1080x1920」的文件。
        # 处理：预览帧按播放显示比例拉伸（ffmpeg scale 直接非等比输出到 disp 尺寸），
        # 坐标映射走 scale_x/scale_y 反算回编码像素网格（x/y 独立因子，天然支持非等比），
        # 裁剪结果所见即所得；转换端与坐标语义均不变。-----
        _sar = get_video_pixel_aspect(self.app.ffprobe_cmd, input_file)
        full_w, full_h = orig_w, orig_h
        sar_note = ""
        if _sar is not None:
            _sn, _sd = _sar
            if _sd > _sn:
                # 竖向拉伸（如 9:16）：播放器保持宽度、拉高 → 1080x1080 显示为 1080x1920
                full_h = max(1, int(round(orig_h * _sd / _sn)))
            else:
                # 横向拉伸：播放器保持高度、拉宽
                full_w = max(1, int(round(orig_w * _sn / _sd)))
            sar_note = f", 播放显示 SAR {_sn}:{_sd}"
            self.app._append_info_ui(
                "[裁剪] 检测到非方形像素 (SAR {0}:{1})：编码 {2}x{3}，播放器显示约 {4}x{5}；"
                "预览已按显示比例拉伸，裁剪坐标仍按编码像素换算".format(_sn, _sd, orig_w, orig_h, full_w, full_h))

        # ----- 计算显示尺寸（按播放显示比例 full_w x full_h 等比缩放进可用区域） -----
        screen_w = self.app.root.winfo_screenwidth()
        screen_h = self.app.root.winfo_screenheight()
        max_w = int(screen_w * 0.9)
        max_h = int(screen_h * 0.9)
        RIGHT_PANEL_WIDTH = 280
        EXTRA_HEIGHT = 10
        PADDING = 10           # 图片外边距
        WINDOW_MARGIN = 20     # 右边菜单控件和图片区的间隔
        avail_w = max_w - RIGHT_PANEL_WIDTH - WINDOW_MARGIN - PADDING * 2
        avail_h = max_h - EXTRA_HEIGHT - PADDING * 2

        scale = min(1.0, avail_w / full_w, avail_h / full_h)
        disp_w = int(full_w * scale)
        disp_h = int(full_h * scale)
        if disp_w < 1:
            disp_w = 1
        if disp_h < 1:
            disp_h = 1
        self.app._append_info_ui(f"[裁剪] 原始尺寸: {orig_w}x{orig_h}, 显示尺寸: {disp_w}x{disp_h}" + (f" (SAR {_sn}:{_sd} 拉伸预览)" if sar_note else ""))
    
        # ----- 坐标缩放因子（用于坐标系转换） -----
        scale_x = orig_w / disp_w
        scale_y = orig_h / disp_h

        # ----- 初始化闭包变量（必须在嵌套函数之前定义） -----
        scaled_temp_path = None   # 当前显示的临时文件路径
        img = None                # Tkinter 图像对象
        points = []               # 矩形坐标（原始坐标）
        rect_id = None            # 矩形画布 ID
        drag_rect_id = None       # 拖拽辅助矩形 ID
        drag_start_display = None # 拖拽起始点（显示坐标）
        # Alt + 拖拽 = 整体搬移已有矩形（2026-09-02）。与「重新绘制」互斥：
        # 普通拖拽 = 画新框（原行为），按住 Alt = 把当前框整体搬到新位置、尺寸不变。
        move_start_display = None # 搬移起点（显示坐标）
        move_orig_points = None   # 搬移开始时的 points 副本（原始坐标）
        img_w, img_h = disp_w, disp_h   # 图像实际尺寸（通常与 disp 一致）
    
        # ----- 临时文件管理（纯内存 PPM bytes，零磁盘写，无需清理文件） -----
        temp_file_info = {"data": None} 
    
        def cleanup_temp_file():
            # 内存模式无临时文件可清理
            temp_file_info["data"] = None
    
        # ----- 窗口布局 -----
        canvas_w = disp_w + PADDING * 2
        canvas_h = disp_h + PADDING * 2
        total_w = canvas_w + RIGHT_PANEL_WIDTH + WINDOW_MARGIN
        total_h = canvas_h + EXTRA_HEIGHT
        total_w = min(total_w, max_w)
        total_h = min(total_h, max_h)
        if total_w < 400:
            total_w = 400
        # 2026-08-30：窗口最低高度（保证右侧面板控件完整显示，不被小视频压矮）；
        # 屏幕高度不足时不超 max_h（min 保护，避免窗口溢出屏幕）。
        # 2026-09-02：下限 640 → 720。右栏新增「宽/高/左/上」数值区后实测内容
        # 最低点已达 624px，640 的窗口只剩 6px 余量——换字体或系统缩放就会被裁掉。
        if total_h < 720:
            total_h = min(720, max_h)
    
        with self.app.SafeToplevel(self.app.root) as win:
            win.title(f"{(title or '可视化裁剪 - 拖拽绘制矩形')} (显示 {disp_w}x{disp_h}, 原始 {orig_w}x{orig_h}{sar_note})")
            win.transient(self.app.root)
            if modal:
                win.grab_set()
            center_window(win, total_w, total_h, offset_y=15)
    
            # 窗口关闭时清理临时文件
            def on_window_close():
                cleanup_temp_file()
                win.destroy()
            win.protocol("WM_DELETE_WINDOW", on_window_close)
    
            main_pane = ttk.Frame(win)
            main_pane.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
    
            right_frame = ttk.Frame(main_pane, width=RIGHT_PANEL_WIDTH)
            right_frame.pack(side=tk.RIGHT, fill=tk.Y, padx=(10, 0))
            right_frame.pack_propagate(False)
    
            canvas_frame = ttk.Frame(main_pane)
            canvas_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    
            canvas = tk.Canvas(canvas_frame, bg='gray', width=canvas_w, height=canvas_h,
                               highlightthickness=0)
            canvas.pack(fill=tk.BOTH, expand=True)
            canvas.config(scrollregion=(0, 0, canvas_w, canvas_h))
            # 加载占位提示：帧提取完成前先显示（消除灰白占位的空白感）
            loading_text = canvas.create_text(
                canvas_w // 2, canvas_h // 2,
                text="正在加载画面…", fill="#666666", font=("Arial", 12)
            )
    
            # ----- 坐标转换函数 -----
            def canvas_to_display(cx, cy):
                x = canvas.canvasx(cx) - PADDING
                y = canvas.canvasy(cy) - PADDING
                return max(0, min(x, disp_w)), max(0, min(y, disp_h))
    
            def display_to_original(dx, dy):
                return int(dx * scale_x), int(dy * scale_y)
    
            def original_to_display(ox, oy):
                return ox / scale_x, oy / scale_y
    
            # ----- 信息显示 -----
            # 旋转/翻转提示（2026-09-20 健壮性审计，用户反馈「开左右翻转后背景没翻转=不一致」）：
            # 正式输出顺序 = 裁剪 → 旋转 → 翻转（与 _main_bg_pre_filter 同序），裁剪坐标定义在
            # 【处理前】的画面上 → 背景帧刻意显示原始画面，对裁剪才是所见即所得（位置编辑器
            # 则相反——它们编辑的是处理后的叠加位置，背景帧走 bg_pre_filter 显示处理后画面）。
            # 开旋转/翻转时在此说明；不做「背景翻转+坐标镜像换算」（风险大于收益）。
            _crop_note = ""
            try:
                _cs = None
                if getattr(self, "current_track", None) is not None:
                    _cs = self.current_track.enc_settings
                elif getattr(self, "override_settings", None) is not None:
                    _cs = self.override_settings
                elif hasattr(self.app, "get_current_settings"):
                    _cs = self.app.get_current_settings()
                if _cs and (_cs.get("vflip") or _cs.get("hflip")
                            or _cs.get("rotate", "none") != "none"):
                    _crop_note = ("\nℹ️ 主视频开了旋转/翻转：正式输出顺序=裁剪→旋转→翻转，"
                                  "背景显示的是处理前画面（裁剪坐标不受影响）")
            except Exception:
                _crop_note = ""
            info_var = tk.StringVar(value="👉 在图像上按住左键拖拽（可从边缘外开始）以绘制裁剪矩形"
                                         + _crop_note + (info_extra or ""))
            info_label = tk.Label(right_frame, textvariable=info_var, wraplength=RIGHT_PANEL_WIDTH - 20,
                                  justify=tk.LEFT, bg="#FFFFCC", relief=tk.SUNKEN, padx=5, pady=5)
            info_label.pack(pady=5, fill=tk.X)
            if helper_rect:
                try:
                    _hx, _hy, _hw, _hh = helper_rect
                    tk.Label(right_frame,
                             text=f"辅助:{helper_label} ({_hx},{_hy},{_hw},{_hh})",
                             foreground="blue", wraplength=RIGHT_PANEL_WIDTH - 20,
                             justify=tk.LEFT).pack(pady=2, fill=tk.X)
                except Exception:
                    pass
    
            # 延迟注册的「信息变更」回调（宽/高/左/上 数值框的回填挂在这里，
            # 它是矩形变化的唯一收口点：拖拽/微调/检测/清除都必经此处）。
            _info_hooks = []

            def update_info():
                if len(points) == 2:
                    x1, y1 = points[0]
                    x2, y2 = points[1]
                    x = min(x1, x2)
                    y = min(y1, y2)
                    w = abs(x2 - x1)
                    h = abs(y2 - y1)
                    info_var.set(f"✅ 矩形已确定\n左上: ({x}, {y})  宽: {w}  高: {h}\n"
                                 f"裁剪参数: crop={w}:{h}:{x}:{y}\n"
                                 "👉 可继续拖拽新矩形覆盖")
                else:
                    info_var.set("👉 在图像上按住左键拖拽（可从边缘外开始）以绘制裁剪矩形")
                for _fn in _info_hooks:
                    with suppress(Exception):
                        _fn()

            def _draw_helper():
                """绘制辅助框（蓝色虚线，只读）——delogo/局部滤镜语境显示裁剪框作参考。"""
                canvas.delete("helper")
                if helper_rect:
                    try:
                        _hx, _hy, _hw, _hh = helper_rect
                        _a1, _a2 = original_to_display(_hx, _hy)
                        _b1, _b2 = original_to_display(_hx + _hw, _hy + _hh)
                        canvas.create_rectangle(
                            _a1 + PADDING, _a2 + PADDING,
                            _b1 + PADDING, _b2 + PADDING,
                            outline="blue", width=1, dash=(4, 2), tags="helper")
                    except Exception:
                        pass

            def redraw_crop_rect():
                """删除旧矩形，按 points 重建画布矩形并更新信息"""
                nonlocal rect_id
                if rect_id:
                    canvas.delete(rect_id)
                    rect_id = None
                if len(points) == 2:
                    x1, y1 = points[0]
                    x2, y2 = points[1]
                    dx1, dy1 = original_to_display(x1, y1)
                    dx2, dy2 = original_to_display(x2, y2)
                    rect_id = canvas.create_rectangle(
                        dx1 + PADDING, dy1 + PADDING,
                        dx2 + PADDING, dy2 + PADDING,
                        outline='red', width=2
                    )
                update_info()

            def _set_points(new_pts):
                """（2026-09-06）points 的唯一写回入口。

                窗口内 on_drag_end / Alt 搬移 / 数值框 / 自动检测黑边 / 初始加载
                已有裁剪 都会重新绑定 points。工厂闭包只要拿 getter+setter 就与
                重绑定解耦，这里作为统一出口，避免将来又长出原地写点的分叉。"""
                nonlocal points
                points = list(new_pts)

            edge_adjust = _make_edge_adjuster(lambda: points, _set_points,
                                              orig_w, orig_h, redraw_crop_rect, grow=False)

            def shift_adjust(direction, delta):
                """平移矩形: direction='up'|'down'|'left'|'right'"""
                if len(points) != 2:
                    return
                x1, y1 = points[0]; x2, y2 = points[1]
                l = min(x1, x2); r = max(x1, x2)
                t = min(y1, y2); b = max(y1, y2)
                if direction == 'left':   l -= delta; r -= delta
                elif direction == 'right': l += delta; r += delta
                elif direction == 'up':    t -= delta; b -= delta
                elif direction == 'down':  t += delta; b += delta
                l = max(0, l); t = max(0, t)
                r = min(orig_w, r); b = min(orig_h, b)
                if r <= l or b <= t:
                    return
                _set_points([(l, t), (r, b)])
                redraw_crop_rect()

            grow_adjust = _make_edge_adjuster(lambda: points, _set_points,
                                              orig_w, orig_h, redraw_crop_rect, grow=True)
    
            # ----- 拖拽事件 -----
            def _alt_held(event):
                """Alt 是否按住（2026-09-02：Alt+拖 = 搬移矩形，不重画）。

                Tk 的 state 位：Windows 下 Alt=0x20000；X11/macOS 走 Mod1=0x0008。
                两个都认，避免换平台后 Alt 失灵。"""
                st = getattr(event, "state", 0) or 0
                return bool(st & 0x20000) or bool(st & 0x0008)

            def _moved_points(ddx, ddy):
                """搬移模式下按显示位移 (ddx,ddy) 算出钳制后的新 points。

                尺寸保持不变，只挪左上角；钳到画面内，不允许框被推出边界。"""
                px1, py1 = move_orig_points[0]
                px2, py2 = move_orig_points[1]
                pl = min(px1, px2); pr = max(px1, px2)
                pt = min(py1, py2); pb = max(py1, py2)
                pw = pr - pl; ph = pb - pt
                nl = int(max(0.0, min(pl + ddx * scale_x, orig_w - pw)))
                nt = int(max(0.0, min(pt + ddy * scale_y, orig_h - ph)))
                return [(nl, nt), (nl + pw, nt + ph)]

            def on_drag_start(event):
                nonlocal drag_start_display, drag_rect_id
                nonlocal move_start_display, move_orig_points
                dx, dy = canvas_to_display(event.x, event.y)
                if drag_rect_id:
                    canvas.delete(drag_rect_id)
                    drag_rect_id = None
                # Alt + 已有矩形 → 整体搬移（保留原矩形，只改坐标）；
                # 无矩形时 Alt 无意义，退化为普通重画。
                if allow_alt_move and _alt_held(event) and len(points) == 2 and rect_id:
                    move_start_display = (dx, dy)
                    move_orig_points = [tuple(points[0]), tuple(points[1])]
                    return
                move_start_display = None
                move_orig_points = None
                drag_start_display = (dx, dy)
                if rect_id:
                    canvas.delete(rect_id)
    
            def on_drag_motion(event):
                nonlocal drag_start_display, drag_rect_id
                # Alt 搬移：不画黄色虚线辅助框，直接把红框本身挪到新位置（所见即所得）
                if move_start_display is not None and move_orig_points is not None and rect_id:
                    cur_dx, cur_dy = canvas_to_display(event.x, event.y)
                    np0, np1 = _moved_points(cur_dx - move_start_display[0],
                                             cur_dy - move_start_display[1])
                    gx1, gy1 = original_to_display(np0[0], np0[1])
                    gx2, gy2 = original_to_display(np1[0], np1[1])
                    canvas.coords(rect_id,
                                  gx1 + PADDING, gy1 + PADDING,
                                  gx2 + PADDING, gy2 + PADDING)
                    return
                if drag_start_display is None:
                    return
                cur_dx, cur_dy = canvas_to_display(event.x, event.y)
                if drag_rect_id:
                    canvas.delete(drag_rect_id)
                sx, sy = drag_start_display
                drag_rect_id = canvas.create_rectangle(
                    sx + PADDING, sy + PADDING,
                    cur_dx + PADDING, cur_dy + PADDING,
                    outline='yellow', width=2, dash=(4, 2)
                )
    
            def on_drag_end(event):
                nonlocal drag_start_display, drag_rect_id, points, rect_id
                nonlocal move_start_display, move_orig_points
                # ---- Alt 搬移收尾：把预览期间的画布坐标正式落回 points ----
                if move_start_display is not None and move_orig_points is not None:
                    cur_dx, cur_dy = canvas_to_display(event.x, event.y)
                    np0, np1 = _moved_points(cur_dx - move_start_display[0],
                                             cur_dy - move_start_display[1])
                    _set_points([np0, np1])
                    move_start_display = None
                    move_orig_points = None
                    redraw_crop_rect()
                    return
                if drag_start_display is None:
                    return
                ex, ey = canvas_to_display(event.x, event.y)
                sx, sy = drag_start_display
                ox1, oy1 = display_to_original(sx, sy)
                ox2, oy2 = display_to_original(ex, ey)
                if abs(ox2 - ox1) > 0 and abs(oy2 - oy1) > 0:
                    _set_points([(ox1, oy1), (ox2, oy2)])
                    if rect_id:
                        canvas.delete(rect_id)
                    dx1, dy1 = original_to_display(ox1, oy1)
                    dx2, dy2 = original_to_display(ox2, oy2)
                    rect_id = canvas.create_rectangle(
                        dx1 + PADDING, dy1 + PADDING,
                        dx2 + PADDING, dy2 + PADDING,
                        outline='red', width=2
                    )
                    update_info()
                else:
                    if rect_id:
                        canvas.delete(rect_id)
                        rect_id = None
                    points = []
                    update_info()
                if drag_rect_id:
                    canvas.delete(drag_rect_id)
                    drag_rect_id = None
                drag_start_display = None
    
            canvas.bind("<ButtonPress-1>", on_drag_start)
            canvas.bind("<B1-Motion>", on_drag_motion)
            canvas.bind("<ButtonRelease-1>", on_drag_end)
    
            # ----- 清除矩形 -----
            def clear_rect():
                nonlocal points, rect_id, drag_start_display, drag_rect_id
                nonlocal move_start_display, move_orig_points
                points = []
                move_start_display = None
                move_orig_points = None
                if rect_id:
                    canvas.delete(rect_id)
                    rect_id = None
                if drag_rect_id:
                    canvas.delete(drag_rect_id)
                    drag_rect_id = None
                drag_start_display = None
                update_info()
    
            # ----- 应用裁剪 -----
            def apply_crop():
                if alert_if(len(points) != 2, "提示", "请先拖拽绘制一个裁剪矩形"):
                    return
                x1, y1 = points[0]
                x2, y2 = points[1]
                x = min(x1, x2)
                y = min(y1, y2)
                w = abs(x2 - x1)
                h = abs(y2 - y1)
                if alert_if(w <= 0 or h <= 0, "错误", "矩形尺寸无效", 'error'):
                    return
                # 保证偶数
                if w % 2:
                    if x + w + 1 <= orig_w:
                        w += 1
                    else:
                        w -= 1
                if h % 2:
                    if y + h + 1 <= orig_h:
                        h += 1
                    else:
                        h -= 1
                if x + w > orig_w:
                    w = orig_w - x
                if y + h > orig_h:
                    h = orig_h - y
                if alert_if(w <= 0 or h <= 0, "错误", "修正后矩形无效", 'error'):
                    return
                if safe_border:
                    if x < 1:
                        w -= (1 - x); x = 1
                    if y < 1:
                        h -= (1 - y); y = 1
                    if w > orig_w - x - 1:
                        w = orig_w - x - 1
                    if h > orig_h - y - 1:
                        h = orig_h - y - 1
                    if alert_if(w <= 0 or h <= 0, "错误", "选区贴近画面边缘，无法安全应用（需四周留边）", 'error'):
                        return
                if on_apply is not None:
                    _ok = on_apply((int(x), int(y), int(w), int(h)))
                    if _ok is False:
                        return
                else:
                    self.crop_enabled.set(True)
                    self.crop_width.set(str(int(w)))
                    self.crop_height.set(str(int(h)))
                    self.crop_left.set(str(int(x)))
                    self.crop_top.set(str(int(y)))
                    self.app._append_info_ui(f"[裁剪] 应用 crop={int(w)}:{int(h)}:{int(x)}:{int(y)}")
                win.destroy()
    
            # ----- 自动检测黑边 -----
            def auto_detect():
                # ---- 获取当前时间输入框的值 ----
                time_str = time_var.get().strip()
                if time_str:
                    sec = parse_time_str(time_str)
                    if sec is not None:
                        self._visual_crop_start_time = sec
                    else:
                        self._visual_crop_start_time = 0.0
                else:
                    self._visual_crop_start_time = 0.0
    
                self.crop_detect_frames.set(frames_var.get())
                self.crop_detect_round.set(round_var.get())
                old = self.current_file
                self.current_file = input_file
                try:
                    self.auto_detect_crop()
                finally:
                    self.current_file = old
                if self.crop_enabled.get():
                    try:
                        w = int(self.crop_width.get())
                        h = int(self.crop_height.get())
                        x = int(self.crop_left.get())
                        y = int(self.crop_top.get())
                        nonlocal points, rect_id
                        if rect_id:
                            canvas.delete(rect_id)
                        _set_points([(x, y), (x + w, y + h)])
                        dx1, dy1 = original_to_display(x, y)
                        dx2, dy2 = original_to_display(x + w, y + h)
                        rect_id = canvas.create_rectangle(
                            dx1 + PADDING, dy1 + PADDING,
                            dx2 + PADDING, dy2 + PADDING,
                            outline='red', width=2
                        )
                        update_info()
                    except:
                        pass
    
            # ----- 时间跳转和重新获取画面 -----
            # 2026-09-02：时间框与「重新获取画面」合并到同一行（左时间 / 右按钮），
            # 省掉一整行高度，右栏下方才有地方放「宽高左上」数值区。
            time_row = ttk.Frame(right_frame)
            time_row.pack(pady=(10, 2), fill=tk.X)
            time_var = tk.StringVar(value=str(initial_time))
            time_entry = ttk.Entry(time_row, textvariable=time_var, width=12)
            time_entry.pack(side=tk.LEFT, fill=tk.X, expand=True)
            # 在时间框里回车 = 点「重新获取画面」（手不离键盘改时间就刷新，省一次点击）
            time_entry.bind("<Return>", lambda _e: on_refresh_click())
    
            def parse_time_str(s):
                return time_to_seconds(s)
    
            def on_refresh_click():
                nonlocal current_time, img, scaled_temp_path, img_w, img_h
                nonlocal points, rect_id, drag_start_display, drag_rect_id
            
                time_str = time_var.get().strip()
                if alert_if(not time_str, "提示", "请输入时间"):
                    return
                sec = parse_time_str(time_str)
                if alert_if(sec is None, "错误", f"无效的时间格式: {time_str}\n支持格式: 秒数 (如 10.5) 或 HH:MM:SS[.mmm]", 'error'):
                    return
                total_duration = self.app._get_media_duration(input_file)
                if total_duration is not None and sec > total_duration:
                    messagebox.showwarning("警告", f"输入时间 {sec:.2f}s 超过视频总时长 {total_duration:.2f}s，将跳转到末尾")
                    # 2026-09-08：-ss 精确等于时长也会越过 EOF 取到 0 帧（实测 30s 视频：
                    # t=30 空输出 / t=29.9 正常），留 0.1s 余量。
                    sec = max(0.0, total_duration - 0.1)
                current_time = sec
            
                refresh_btn.config(state=tk.DISABLED, text="提取中...")
                info_var.set("⏳ 正在提取画面，请稍候...")
                win.update_idletasks()
            
                # --- 取消旧线程 ---
                if self._crop_extract_thread and self._crop_extract_thread.is_alive():
                    self._crop_cancel_event.set()
                    self._crop_extract_thread.join(timeout=0.5)
                self._crop_cancel_event.clear()
            
                # 定义提取线程（纯内存：PPM 管道输出，零磁盘写）
                def extract_thread():
                    # 如果取消标志被设置，则返回
                    if self._crop_cancel_event.is_set():
                        return
                    try:
                        w, h, data = frame_extractor(
                            input_file,
                            frame_sec=sec,
                            target_width=disp_w,
                            target_height=disp_h
                        )
                        # 再次检查取消标志
                        if self._crop_cancel_event.is_set():
                            return
                        if w is None or h is None:
                            self.app.root.after(0, lambda: on_extract_failed("提取帧失败，请检查文件是否支持"))
                            return
                        self.app.root.after(0, lambda: on_extract_success(data, w, h))
                    except Exception as e:
                        self.app.root.after(0, lambda e=e: on_extract_failed(f"提取异常: {e}"))
            
                # 启动新线程
                self._crop_extract_thread = threading.Thread(target=extract_thread, daemon=True)
                self._crop_extract_thread.start()
    
                def on_extract_success(new_data, new_orig_w, new_orig_h):
                    nonlocal img, scaled_temp_path, img_w, img_h
                    nonlocal points, rect_id, drag_start_display, drag_rect_id
                    try:
                        new_img = tk.PhotoImage(data=new_data)
                    except Exception as e:
                        on_extract_failed(f"加载缩放后的图像失败: {e}")
                        return

                    # 内存模式无临时文件，仅保存数据供后续清理逻辑兼容
                    temp_file_info["data"] = new_data
    
                    # 更新图像
                    canvas.delete("bg_img")
                    canvas.create_image(PADDING, PADDING, anchor=tk.NW, image=new_img, tags="bg_img")
                    canvas.image = new_img
                    _draw_helper()
                    img = new_img
    
                    # 重置选择状态
                    if rect_id:
                        canvas.delete(rect_id)
                        rect_id = None
                    if drag_rect_id:
                        canvas.delete(drag_rect_id)
                        drag_rect_id = None
                    points = []
                    drag_start_display = None
                    update_info()
                    info_var.set(f"✅ 已更新画面 (时间: {current_time:.2f}s) 请重新拖拽裁剪")
                    self.app._append_info_ui("[裁剪] 跳转到 {0:.2f}s，原始尺寸 {1}x{2}，显示尺寸 {3}x{4}".format(current_time, orig_w, orig_h, disp_w, disp_h))
                    refresh_btn.config(state=tk.NORMAL, text="重新获取画面")
    
                def on_extract_failed(err_msg):
                    # 清理可能残留的临时文件
                    cleanup_temp_file()
                    info_var.set(f"❌ {err_msg}")
                    self.app._append_info_ui(f"[裁剪] 提取失败: {err_msg}")
                    refresh_btn.config(state=tk.NORMAL, text="重新获取画面")
    
                threading.Thread(target=extract_thread, daemon=True).start()
    
            refresh_btn = ttk.Button(time_row, text="重新获取画面", command=on_refresh_click)
            refresh_btn.pack(side=tk.LEFT, padx=(6, 0))
    
            ttk.Label(right_frame, text="支持格式: 秒数 (如 10.5) 或 HH:MM:SS[.mmm]", foreground="gray",
                      wraplength=RIGHT_PANEL_WIDTH - 20).pack(pady=(2, 6))

            # ================= 裁剪框数值（宽/高/左/上）=================
            # 2026-09-02：可直接读改的四个数值，比那三组「加减/平移」按钮更精确
            # 双向联动：矩形变 → 回填；用户输入 → 改矩形（回车或失焦生效）。
            box_frame = ttk.LabelFrame(right_frame, text="裁剪框数值（回车生效）")
            box_frame.pack(fill=tk.X, pady=(0, 6))

            _bw, _bh = tk.StringVar(), tk.StringVar()
            _bx, _by = tk.StringVar(), tk.StringVar()
            _box_busy = [False]      # 回填期间置位，杜绝「回填→触发→再回填」回环

            def _box_cell(parent, label, var, col):
                cell = ttk.Frame(parent)
                cell.grid(row=0, column=col, sticky="w", padx=(0, 10))
                ttk.Label(cell, text=label).pack(side=tk.LEFT)
                e = ttk.Entry(cell, textvariable=var, width=7)
                e.pack(side=tk.LEFT, padx=(3, 0))
                return e

            _brow1 = ttk.Frame(box_frame)
            _brow1.pack(fill=tk.X, padx=6, pady=(4, 2))
            _be_w = _box_cell(_brow1, "宽", _bw, 0)
            _be_h = _box_cell(_brow1, "高", _bh, 1)
            _brow2 = ttk.Frame(box_frame)
            _brow2.pack(fill=tk.X, padx=6, pady=(0, 6))
            _be_x = _box_cell(_brow2, "左", _bx, 0)
            _be_y = _box_cell(_brow2, "上", _by, 1)

            def _sync_box_from_rect():
                """矩形 → 四个数值框（回填）。走 _tk_setv：值没变就不写，
                光标不会被顶到末尾（否则用户正在敲的数字会被冲到后面）。"""
                _box_busy[0] = True
                try:
                    if len(points) == 2:
                        x1, y1 = points[0]
                        x2, y2 = points[1]
                        _tk_setv(_bx, str(int(min(x1, x2))))
                        _tk_setv(_by, str(int(min(y1, y2))))
                        _tk_setv(_bw, str(int(abs(x2 - x1))))
                        _tk_setv(_bh, str(int(abs(y2 - y1))))
                    else:
                        for _v in (_bx, _by, _bw, _bh):
                            _tk_setv(_v, "")
                finally:
                    _box_busy[0] = False

            def _apply_box_to_rect():
                """四个数值框 → 矩形（回车/失焦）。非法或超界就地钳制后回显。"""
                if _box_busy[0]:
                    return
                if len(points) != 2:
                    _sync_box_from_rect()
                    return
                try:
                    l = int(float(_bx.get()))
                    t = int(float(_by.get()))
                    w = int(float(_bw.get()))
                    h = int(float(_bh.get()))
                except (ValueError, TypeError):
                    _sync_box_from_rect()
                    return
                w = max(1, min(w, orig_w))
                h = max(1, min(h, orig_h))
                l = max(0, min(l, orig_w - w))
                t = max(0, min(t, orig_h - h))
                _set_points([(l, t), (l + w, t + h)])
                redraw_crop_rect()          # 内部会调 update_info → _sync_box_from_rect 回显规范值

            for _e in (_be_w, _be_h, _be_x, _be_y):
                # ⚠️ 数值框一律不挂 write trace（会与回填互相触发），只绑回车与失焦。
                _e.bind("<Return>", lambda _ev: _apply_box_to_rect())
                _e.bind("<FocusOut>", lambda _ev: _apply_box_to_rect())

            _info_hooks.append(_sync_box_from_rect)   # 矩形一变就回填

            # ----- 其他按钮 -----
            btn_frame = ttk.Frame(right_frame)
            btn_frame.pack(fill=tk.X, pady=5)
    
            if show_black_border:
                ttk.Button(btn_frame, text="自动检测黑边", command=auto_detect).pack(fill=tk.X, pady=2)

            if show_black_border:
                param_frame = ttk.Frame(btn_frame)
                param_frame.pack(fill=tk.X, pady=5)
                row = ttk.Frame(param_frame)
                row.pack(fill=tk.X)
        
                frames_container = ttk.Frame(row)
                frames_container.pack(side=tk.LEFT, padx=(0, 10))
                ttk.Label(frames_container, text="分析帧数:").pack(side=tk.LEFT)
                frames_var = tk.StringVar(value=self.crop_detect_frames.get())
                ttk.Spinbox(frames_container, from_=1, to=100, width=5, textvariable=frames_var, state="normal").pack(side=tk.LEFT, padx=5)
                frames_var.trace_add("write", lambda *a: self.crop_detect_frames.set(frames_var.get()))
        
                round_container = ttk.Frame(row)
                round_container.pack(side=tk.LEFT)
                ttk.Label(round_container, text="round:").pack(side=tk.LEFT)
                round_var = tk.StringVar(value=self.crop_detect_round.get())
                ttk.Spinbox(round_container, from_=1, to=16, width=5, textvariable=round_var, state="normal").pack(side=tk.LEFT, padx=5)
                round_var.trace_add("write", lambda *a: self.crop_detect_round.set(round_var.get()))

            # ----- 边缘/平移微调按钮 -----
            # 边界收缩行（上减/下减/左减/右减 + 独立步进）
            edge_row = ttk.Frame(btn_frame)
            edge_row.pack(fill=tk.X, pady=1)
            edge_step = tk.StringVar(value="1")
            for label, edge in [("上减", "top"), ("下减", "bottom"), ("左减", "left"), ("右减", "right")]:
                ttk.Button(edge_row, text=label, width=4,
                           command=lambda e=edge: edge_adjust(e, _get_step(edge_step))).pack(side=tk.LEFT, padx=1)
            ttk.Label(edge_row, text="步进:").pack(side=tk.LEFT, padx=(8, 2))
            ttk.Spinbox(edge_row, textvariable=edge_step, from_=1, to=999, width=4).pack(side=tk.LEFT)

            # 边界扩大行（上加/下加/左加/右加 + 独立步进；2026-08-26 新增，紧接「减」行下方）
            grow_row = ttk.Frame(btn_frame)
            grow_row.pack(fill=tk.X, pady=1)
            grow_step = tk.StringVar(value="1")
            for label, edge in [("上加", "top"), ("下加", "bottom"), ("左加", "left"), ("右加", "right")]:
                ttk.Button(grow_row, text=label, width=4,
                           command=lambda e=edge: grow_adjust(e, _get_step(grow_step))).pack(side=tk.LEFT, padx=1)
            ttk.Label(grow_row, text="步进:").pack(side=tk.LEFT, padx=(8, 2))
            ttk.Spinbox(grow_row, textvariable=grow_step, from_=1, to=999, width=4).pack(side=tk.LEFT)

            # 平移行（上移/下移/左移/右移 + 独立步进）
            shift_row = ttk.Frame(btn_frame)
            shift_row.pack(fill=tk.X, pady=1)
            shift_step = tk.StringVar(value="1")
            for label, direction in [("上移", "up"), ("下移", "down"), ("左移", "left"), ("右移", "right")]:
                ttk.Button(shift_row, text=label, width=4,
                           command=lambda d=direction: shift_adjust(d, _get_step(shift_step))).pack(side=tk.LEFT, padx=1)
            ttk.Label(shift_row, text="步进:").pack(side=tk.LEFT, padx=(8, 2))
            ttk.Spinbox(shift_row, textvariable=shift_step, from_=1, to=999, width=4).pack(side=tk.LEFT)

            def _get_step(sv):
                try:
                    return int(sv.get())
                except ValueError:
                    return 1

            ttk.Button(btn_frame, text=clear_label, command=clear_rect).pack(fill=tk.X, pady=2)
            ttk.Button(btn_frame, text=apply_label, command=apply_crop).pack(fill=tk.X, pady=2)
            ttk.Button(btn_frame, text="取消", command=on_window_close).pack(fill=tk.X, pady=2)
    
            tip = ("按住左键拖拽绘制矩形（可从边缘外开始），松开确定。黄色虚线为辅助，红色为最终选区。\n"
                   "按住 Alt 拖拽 = 整体搬移已有矩形（尺寸不变）。")
            ttk.Label(right_frame, text=tip, foreground="gray", wraplength=RIGHT_PANEL_WIDTH - 20).pack(pady=10)

            # ----- 裁剪的动态位移（「简易位置」） -----
            # 2026-08-30：曾一度删除此入口（误以为画布模式完全替代），现已回溯保留：
            # 两者是不同的交互范式，需共存直到融合方案确定。二者同时启用时，
            # 生成命令以「画布模式」为准（build_video_filter_chain 的 _canvas_on 守卫），
            # 互不冲突。
            def open_simple_pos():
                # ⚠️ 无论是否点过「保存并应用裁剪」，都优先取当前框选（points 为未应用的最新框）
                if len(points) == 2:
                    x1, y1 = points[0]; x2, y2 = points[1]
                    bx, by = int(min(x1, x2)), int(min(y1, y2))
                    cw, ch = int(abs(x2 - x1)), int(abs(y2 - y1))
                elif self.crop_enabled.get():
                    try:
                        cw = int(self.crop_width.get())
                        ch = int(self.crop_height.get())
                        bx = int(self.crop_left.get())
                        by = int(self.crop_top.get())
                    except (ValueError, TypeError):
                        messagebox.showwarning("提示", "请先框选裁剪矩形（或先应用一个有效裁剪）")
                        return
                else:
                    messagebox.showwarning("提示", "请先框选裁剪矩形（或先应用一个有效裁剪）")
                    return
                if alert_if(cw <= 0 or ch <= 0, "提示", "裁剪矩形尺寸无效"):
                    return
                _cb = simple_pos_cb if simple_pos_cb is not None else self._crop_pos_dialog
                _cb(input_file, orig_w, orig_h, cw, ch, bx, by)

            if show_simple_pos:
                ttk.Button(right_frame, text="简易位置…", command=open_simple_pos).pack(fill=tk.X, pady=(6, 2))
                ttk.Label(right_frame,
                          text="简易位置：某段时间内裁剪框在画面内移动（列表轨迹式）；"
                               "与「位置、尺寸、旋转」并存，二者同时开启时以后者的画布模式为准。",
                          foreground="gray", wraplength=RIGHT_PANEL_WIDTH - 20).pack(pady=(0, 6))

            # ----- 初始矩形：外部 preload_points 优先；否则裁剪语境读 crop_* -----
            _preload = preload_points
            if _preload is None and on_apply is None and self.crop_enabled.get():
                try:
                    w = int(self.crop_width.get())
                    h = int(self.crop_height.get())
                    x = int(self.crop_left.get())
                    y = int(self.crop_top.get())
                    _preload = [(x, y), (x + w, y + h)]
                except (ValueError, TypeError):
                    _preload = None
            if _preload is not None:
                try:
                    (x1, y1), (x2, y2) = _preload
                    _set_points([(int(x1), int(y1)), (int(x2), int(y2))])
                    dx1, dy1 = original_to_display(int(x1), int(y1))
                    dx2, dy2 = original_to_display(int(x2), int(y2))
                    rect_id = canvas.create_rectangle(
                        dx1 + PADDING, dy1 + PADDING,
                        dx2 + PADDING, dy2 + PADDING,
                        outline='red', width=2
                    )
                    update_info()
                except Exception:
                    pass
    
            # ----- 初始加载图像 -----
            def initial_load():
                try:
                    w, h, data = frame_extractor(
                        input_file,
                        frame_sec=initial_time,
                        target_width=disp_w,
                        target_height=disp_h
                    )
                    if w is None or h is None:
                        messagebox.showerror("错误", "无法提取初始帧")
                        win.destroy()
                        return
                    # 加载图像（内存 bytes）
                    img_obj = tk.PhotoImage(data=data)
                    canvas.delete(loading_text)  # 清除占位提示
                    canvas.create_image(PADDING, PADDING, anchor=tk.NW, image=img_obj, tags="bg_img")
                    canvas.image = img_obj
                    _draw_helper()
                    nonlocal img, scaled_temp_path
                    img = img_obj
                    temp_file_info["data"] = data
                    # ⚠️ 任务1修复：图像 create_image 会盖住此前（4125 行）先画的裁剪框，
                    # 必须在图像显示后重画——否则"打开显示旧坐标框"看不到。
                    if points:
                        redraw_crop_rect()
                except Exception as e:
                    with suppress(Exception):
                        canvas.delete(loading_text)
                    messagebox.showerror("错误", f"加载初始帧失败: {e}")
                    win.destroy()

            # 调用初始加载
            initial_load()
    
            # 等待窗口关闭
            win.wait_window()


    def _open_canvas_editor(self, target_file=None):
        """画布模式入口按钮：打开「位置、尺寸、旋转」编辑器。

        编辑「自身」的位置/尺寸/旋转 → 基准必须是被编辑的文件自身：
        - 主视频（转换页/封装主视频）：自身 = 主视频文件；
        - 子视频：自身 = 子视频文件（调用方传 target_file=current_file，或本方法探测 self.current_file）。
        优先级：显式 target_file > self.current_file(子视频自身) > 本页主视频。
        ⚠️ 2026-08-30 修正：不再裸用 _context_main_video 当子视频/自身窗口的基准
        （会导致黑画布、时间预览「未找到主视频」、尺寸对不上）。
        ⚠️ 2026-09-23：兜底改为按宿主页取（self._context），转换页与封装页禁止互相兜底。"""
        app = getattr(self, "app", self)
        input_file = ""
        tf = (target_file or "").strip()
        if tf and os.path.exists(tf):
            input_file = tf
        if not input_file:
            # 子视频编辑对话框（VideoFilterFrame）self.current_file 即自身文件
            _cf = getattr(self, "current_file", None)
            if _cf and os.path.exists(str(_cf).strip()):
                input_file = str(_cf).strip()
        if not input_file:
            # 2026-09-23：按宿主页取主视频（转换页↔封装页禁止互相兜底：本页没主视频
            # 就是纯黑/报错，绝不能用另一页的视频当基准）。
            _pg = "merge" if getattr(self, "_context", "convert") == "merge" else "convert"
            try:
                _pf, _unused = _page_main_video(app, _pg)
                input_file = _pf or ""
            except Exception:
                input_file = ""
        if alert_if(not input_file or not os.path.exists(input_file), "错误", "未找到用于编辑的视频文件，无法打开位置/尺寸、旋转", 'error'):
            return
        pic_w, pic_h = None, None
        try:
            pic_w, pic_h = app._get_video_dimensions_cached(input_file)
        except Exception:
            pic_w, pic_h = None, None
        if pic_w is None or pic_h is None:
            pic_w, pic_h = 1280, 720
        # 窗口（画布）尺寸 = 裁剪框尺寸（与画布模式合并）；否则被编辑文件原始尺寸
        canvas_w, canvas_h = pic_w, pic_h
        crop_used = False
        _ce = getattr(self, "crop_enabled", None)
        if _ce is not None and _ce.get():
            try:
                _cw = int(self.crop_width.get()); _ch = int(self.crop_height.get())
                if _cw > 0 and _ch > 0:
                    canvas_w, canvas_h = _cw, _ch
                    crop_used = True
            except (ValueError, TypeError):
                pass
        # 内容=完整原始画面（pic_w×pic_h）；窗口=canvas_w×canvas_h（裁剪只缩窗口不缩内容）
        self._canvas_editor_dialog(input_file, canvas_w, canvas_h, pic_w, pic_h, crop_used)

    def _canvas_editor_dialog(self, input_file, canvas_w, canvas_h, pic_w, pic_h, crop_used=False):
        """画布模式统一编辑器（Shotcut 式「位置、尺寸、旋转」）。

        关键区分（2026-08-30 用户拍板）：画布=窗口，内容=完整原始画面，二者独立——
        - canvas_w/canvas_h = 窗口（黑底）大小 = 裁剪框大小（启用裁剪时）或主视频原始尺寸；
        - pic_w/pic_h = 内容（完整画面）大小 = 主视频原始尺寸，始终不裁剪。
        单一入口：左侧关键帧列表（点击即切换状态并实时反映大小/位置/旋转），
        右侧黑画布（= 窗口大小，固定黑色）+ 真实「完整画面」帧（按当前 缩放/偏移/旋转 摆放）。
        支持：拖拽移动、拉角缩放、旋转手柄、缩放滑块；「编辑结尾」勾选框切换起始/结尾关键帧。
        不显示微调按钮（与 _generic_overlay_editor 的 show_nudge 区分）。
        窗口严格卡死尺寸（仅显示端缩小，canvas_w/canvas_h=窗口=裁剪框大小/原始尺寸）；
        内容=完整原始画面 pic_w×pic_h，被窗口裁掉一部分即「简易位置」效果（裁剪时窗口<内容）。
        源帧走内存字节(LRU)缓存，合成帧全程内存
        （源帧 PPM 字节经 stdin 喂给 ffmpeg，合成结果直接以 PPM 字节喂给 tk.PhotoImage），
        不落盘、零临时文件、无多余 PNG 编解码。背景帧始终抽取完整原始画面（不应用裁剪）。
        """
        import math, subprocess, sys, os
        dlg_segs = copy.deepcopy(self.canvas_segments)
        app = getattr(self, "app", self)
        ffmpeg_cmd = getattr(app, "ffmpeg_cmd", None)
        ffprobe_cmd = getattr(app, "ffprobe_cmd", None)
        # 2026-09-02：关键帧行上限改为「更多设置」可配（默认 15，与列表轨迹/裁剪平移一致）
        try:
            MAX_ROWS = max(1, min(99, int(app.canvas_max_rows.get())))
        except Exception:
            MAX_ROWS = 15

        def _video_duration(fpath):
            if not ffprobe_cmd or not fpath or not os.path.exists(fpath):
                return None
            try:
                import json
                cmd = [ffprobe_cmd, "-v", "error", "-show_entries",
                       "format=duration", "-of", "json", fpath]
                flags = _ffmpeg_spawn_flags()
                out = subprocess.run(cmd, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL,
                                     creationflags=flags, timeout=15)
                j = json.loads(out.stdout.decode("utf-8", "ignore"))
                return float(j.get("format", {}).get("duration", 0) or 0)
            except Exception:
                return None

        # 2026-09-12：ds/DW/DH（自绘画布显示缩放）随左画面一并删除，窗口尺寸改为纯列表布局推导。

        win = tk.Toplevel(app.root)
        win.title("位置、尺寸、旋转 - 画布模式")
        win.transient(app.root)
        win.withdraw()

        # 当前编辑态
        sel_idx = tk.IntVar(value=-1)
        edit_end = tk.BooleanVar(value=False)  # 内部标记：False=编辑起始状态, True=编辑结尾状态
        cur_mode = tk.StringVar(value="不动")
        # 状态剪贴板：仅存「当前关键帧」（按 edit_end 区分起始/结尾）的
        # x/y/scale/angle；起始与结尾完全独立，可结尾→起始 或 起始→结尾 互拷。
        _state_clipboard = [None]

        def _copy_state():
            kv = _kf_values()
            if alert_if(not kv, "提示", "请先选择或添加关键帧", 'info'):
                return
            _idx, x, y, sc, ang, _t = kv
            _state_clipboard[0] = {"x": x, "y": y, "scale": sc, "angle": ang}
            where = "结尾" if (edit_end.get() and _seg_move_mode(dlg_segs[_idx]) != "still") else "起始"
            with suppress(Exception):
                app._append_info_ui(f"[画布模式] 已复制当前「{where}」状态"
                                    f"（x={int(round(x))}, y={int(round(y))}, 缩放={sc*100:g}%, 角度={ang:g}°）")

        def _paste_state():
            kv = _kf_values()
            if alert_if(not kv or _state_clipboard[0] is None, "提示", "剪贴板为空，请先「复制当前状态」", 'info'):
                return
            s = _state_clipboard[0]
            _set_kf(s["x"], s["y"], s["scale"], s["angle"])
            # 2026-09-12 修复：此前只写数据不刷新——切端粘贴后列表数值无反应、X/Y 框也不回填。
            _refresh(kv[0])   # 默认 sync_entries=True：列表单行更新 + X/Y 框随当前端回填
            where = "结尾" if (edit_end.get() and _seg_move_mode(dlg_segs[kv[0]]) != "still") else "起始"
            with suppress(Exception):
                app._append_info_ui(f"[画布模式] 已把剪贴板状态粘贴到当前「{where}」")

        # ---------- 布局 ----------
        # 2026-09-12：删除原 Canvas 滚动壳（_scroller / _cv / _vsb / _content）。
        # 它是「窗口宽度恒小于列表、末列必须手动拉宽才看得见」的根因：
        #   · 内容被塞进 _cv.create_window()，Canvas 的 reqwidth 与内容无关（Tk 默认约 378），
        #     窗口拿不到内容的真实宽度，只能靠硬编码常量凑；
        #   · 只有纵向滚动条，内容超宽部分被横向裁掉，末列因此永远不可见。
        # 现在控件直接挂 win，窗口按 winfo_reqwidth/reqheight 自然撑开——
        # 与「末端处理」等列表弹窗同一套做法（update_idletasks → reqwidth → 只定位不猜宽）。

        # 底部固定栏：确定 / 取消（置于整窗最下方、始终可见，居中排列）
        bottombar = ttk.Frame(win, padding=(0, 6))
        bottombar.pack(side=tk.BOTTOM, fill=tk.X)
        ttk.Frame(bottombar).pack(side=tk.LEFT, expand=True)  # 左弹簧：把按钮推到中间
        ttk.Button(bottombar, text="确定", command=lambda: _ok(), width=10).pack(side=tk.LEFT, padx=6)
        ttk.Button(bottombar, text="取消", command=lambda: _close(), width=10).pack(side=tk.LEFT, padx=6)
        ttk.Frame(bottombar).pack(side=tk.LEFT, expand=True)  # 右弹簧：对称居中

        top = ttk.Frame(win, padding=(8, 6, 8, 2))
        top.pack(fill=tk.X)
        # 2026-09-12：勾选与尺寸提示**分两行**——同一行时两者宽度相加（实测 ~726px）
        # 会把窗口撑到远宽于列表（574），右侧空出一大截。分两行后 top 的请求宽
        # = max(两者) 而非之和，窗口宽度由列表决定（590），正好贴合。
        _top_row1 = ttk.Frame(top)
        _top_row1.pack(fill=tk.X)
        chk_canvas = ttk.Checkbutton(_top_row1, text="启用画布模式（位置、尺寸、旋转）",
                                     variable=self.canvas_mode)
        chk_canvas.pack(side=tk.LEFT)
        _size_lbl = (f"  窗口（画布 固定尺寸）: {canvas_w} x {canvas_h}"
                     + ("  （来自裁剪框）" if crop_used else "  （原始尺寸）")
                     + f"  ｜ 内容(完整画面): {pic_w} x {pic_h}")
        _top_row2 = ttk.Frame(top)
        _top_row2.pack(fill=tk.X, pady=(2, 0))
        ttk.Label(_top_row2, text=_size_lbl, foreground="gray",
                  anchor=tk.W).pack(fill=tk.X)

        mid = ttk.Frame(win, padding=8)
        mid.pack(fill=tk.BOTH, expand=True)

        # 2026-09-12：左侧自绘黑画布已删除（含抽帧渲染/拖拽/拉角缩放/旋转手柄）。
        # 位置·尺寸·旋转统一走「起始坐标… / 结尾坐标…」→ 通用位置编辑器（带缩放滑块与八向方向预设），
        # 与简易位置等其他列表类入口一致，不再维护第二套自绘几何实现。


        right = ttk.Frame(mid)
        right.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        # ----- 右上：控件 -----
        ctrls = ttk.Frame(right, padding=(0, 0, 0, 4))
        ctrls.pack(side=tk.TOP, fill=tk.X)

        def _mk_row(label, w=9):
            f = ttk.Frame(ctrls)
            f.pack(fill=tk.X, pady=2)
            ttk.Label(f, text=label, width=w).pack(side=tk.LEFT)
            return f



        # 开始时间 / 时长（可手动修改）
        r_t = _mk_row("开始/时长")
        t_start = ttk.Entry(r_t, width=7)
        t_start.pack(side=tk.LEFT, padx=2)
        t_start.bind("<Return>", lambda e: _on_time_entry())
        t_start.bind("<FocusOut>", lambda e: _on_time_entry())
        t_start.bind("<KeyRelease>", lambda e: _on_time_entry())
        ttk.Label(r_t, text="  /  ").pack(side=tk.LEFT)
        t_dur = ttk.Entry(r_t, width=7)
        t_dur.pack(side=tk.LEFT, padx=2)
        t_dur.bind("<Return>", lambda e: _on_time_entry())
        t_dur.bind("<FocusOut>", lambda e: _on_time_entry())
        t_dur.bind("<KeyRelease>", lambda e: _on_time_entry())
        ttk.Button(r_t, text="时间预览", command=lambda: _open_time_preview()).pack(side=tk.LEFT, padx=8)

        # 方式（移动方式 + 缓动曲线合并为同一下拉，2026-09-13）
        r_md = _mk_row("方式")
        mode_combo = ttk.Combobox(r_md, textvariable=cur_mode, values=_traj_mode_choices(),
                                  state="readonly", width=12)
        mode_combo.pack(side=tk.LEFT)
        ToolTip(mode_combo,
                "平移/线性 = 匀速插值；缓入/缓出/缓入缓出/平滑(原) = 缓动曲线（贯穿整条轨迹，"
                "多段路径不再每个点顿一下）；不动 = 静止。曲线越往后越「弹」。")
        mode_combo.bind("<<ComboboxSelected>>", lambda e: _apply_mode_from_combo())
        def _apply_mode_from_combo():
            idx = sel_idx.get()
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            _mi = mode_combo.current()
            new_mode = _TRAJ_MODE_ORDER[_mi] if 0 <= _mi < len(_TRAJ_MODE_ORDER) else "move"
            w["move"] = new_mode
            # 如果是“不动”，将终点坐标同步为起点
            if new_mode == "still":
                w["ex"], w["ey"] = w["sx"], w["sy"]
            _refresh(idx)

        # 状态复制 / 粘贴（起始 / 结尾 各自独立，可互拷）
        # 2026-09-12：补「起始/结尾」编辑端显式单选（旧「开始帧/结尾帧」单选删除后的回归）。
        # X/Y 输入框、八向预设、上面复制/粘贴按钮都按当前端路由，单选让「当前端」可见可控；
        # 点「起始坐标…/结尾坐标…」或通用编辑器内切端也会自动同步显示（同一 BooleanVar）。
        # 跨行复制/粘贴走列表右键菜单（_attach_state_clipboard_menu）。
        r_cp = _mk_row("状态")
        ttk.Button(r_cp, text="复制当前状态", command=lambda: _copy_state(),
                   width=12).pack(side=tk.LEFT, padx=2)
        ttk.Button(r_cp, text="粘贴状态", command=lambda: _paste_state(),
                   width=10).pack(side=tk.LEFT, padx=2)
        ttk.Radiobutton(r_cp, text="起始", value=False, variable=edit_end,
                        command=lambda: _sync_xy_entries()).pack(side=tk.LEFT, padx=(10, 0))
        ttk.Radiobutton(r_cp, text="结尾", value=True, variable=edit_end,
                        command=lambda: _sync_xy_entries()).pack(side=tk.LEFT)
        ttk.Label(r_cp, text="(单选=当前编辑端；列表右键可跨行复制)", foreground="gray").pack(side=tk.LEFT, padx=4)

        # X / Y 偏移 + 八向飞入/飞出预设
        # ⚠️ 2026-09-12：这两项**保留在画布编辑器内**（键盘直接改数、点下拉即填方向），
        # 与通用位置编辑器里的同款下拉是**两处并存**，不是迁移——删此处会让手动微调失效。
        r_xy = _mk_row("X / Y")
        ent_x = ttk.Entry(r_xy, width=7)
        ent_x.pack(side=tk.LEFT, padx=2)
        ent_x.bind("<Return>", lambda e: _on_xy_entry())
        ent_x.bind("<FocusOut>", lambda e: _on_xy_entry())
        # 2026-09-03：键入字符即刷新——用户改数字时不等 Enter/失焦就刷到列表
        ent_x.bind("<KeyRelease>", lambda e: _on_xy_entry())
        ttk.Label(r_xy, text="  /  ").pack(side=tk.LEFT)
        ent_y = ttk.Entry(r_xy, width=7)
        ent_y.pack(side=tk.LEFT, padx=2)
        ent_y.bind("<Return>", lambda e: _on_xy_entry())
        ent_y.bind("<FocusOut>", lambda e: _on_xy_entry())
        ent_y.bind("<KeyRelease>", lambda e: _on_xy_entry())

        # 八向飞入/飞出预设（下拉，省空间）：往「当前帧」X/Y 填 (cx*W*倍率, cy*H*倍率)；
        # 倍率 = 当前关键帧 scale（1.0=原始），旋转不动。首行（canonical「reset」）= X/Y 归零（内容归位中心）。
        # 入场 = 先点「起始坐标…」再选方向；出场 = 先点「结尾坐标…」再选方向（与 edit_end 联动）。
        _corner_names, _corner_w = corner_dir_choices(minimum=9)
        corner_combo = ttk.Combobox(r_xy, width=_corner_w, state="readonly",
                                    values=_corner_names)
        corner_combo.pack(side=tk.LEFT, padx=(8, 0))
        corner_combo.current(0)
        corner_combo.bind("<<ComboboxSelected>>", lambda e: _on_corner())
        ttk.Label(r_xy, text="(方向=飞入/飞出角)", foreground="gray").pack(side=tk.LEFT, padx=4)

        # ----- 右下：关键帧列表 + 列表控制按钮 -----
        bottom = ttk.Frame(right, padding=(0, 8, 0, 0))
        bottom.pack(side=tk.TOP, fill=tk.BOTH, expand=True)
        bottom.rowconfigure(0, weight=1)
        bottom.columnconfigure(0, weight=1)
        # 2026-09-03：列表列改造——#→行；偏移→拆成「起始坐标/结尾坐标」；
        # 新增「起始角度/结尾角度」；末列 stretch 随窗口拉伸消除右侧空白。
        # 2026-10-01：原「时间(s)」单列 → 拆「开始时间/结束时间」两列，与列表轨迹/简易位置同口径。
        cols = ("idx", "btime", "dtime", "mode", "scale", "ra", "rb", "sx", "ex")
        headers = ("行", "开始时间", "结束时间", "方式", "缩放%", "起始角度", "结尾角度", "起始坐标", "结尾坐标")
        # 2026-09-03：列宽加宽以容纳整数坐标（如「1234,5678」~80px）；
        # 2026-10-01：时间列宽取 62，与另两个列表一致（6 位小数「10.133333」实测放得下）。
        # 2026-10-01：窗口 minsize +150×+100 后，列宽每列 +16（原 579→723px）作为比例基线；
        # 实际显示宽度由下方 <Configure> 按此比例铺满（末列不再独吞多余宽度）。
        widths = (46, 78, 78, 71, 71, 71, 71, 111, 111)
        tree = ttk.Treeview(bottom, columns=cols, show="headings", height=6)
        for c, h, wdt in zip(cols, headers, widths):
            tree.heading(c, text=h)
            # 2026-10-01：全部 stretch=False，列宽由 <Configure> 按比例分配（见下方 _fit_cols），
            # 不再用「单一弹性末列」（窗口加宽全灌末列）也不靠 Tk 多列 stretch（多余宽度平分≠按比例）。
            tree.column(c, width=wdt, anchor=tk.CENTER, stretch=False)
            # 2026-09-03：每列显式 minwidth = heading 文本宽 + padding，
            # 确保即使该列无 row 数据，Tk 也不会把它压到截断 heading 文字。
            # 中文字符 ~14px, ASCII ~8px。
            _min = sum((14 if ord(ch) > 127 else 8) for ch in h) + 10
            tree.column(c, minwidth=_min)
        vsb = ttk.Scrollbar(bottom, orient=tk.VERTICAL, command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        tree.grid(row=0, column=0, sticky="nsew")
        vsb.grid(row=0, column=1, sticky="ns")
        # 2026-10-01：列宽按设定 widths 比例自适应（窗口放大时各列等比铺满）。
        # 以 tree 实际像素宽为准分配；minwidth 作下界防截断；取整误差补到末列避免右侧留缝。
        # 全部 stretch=False，故 Tk 不干预列宽，这里手动按比例铺，避免末列独吞或平分变形。
        _base_w = widths
        _fitting = False
        def _fit_cols(*_):
            nonlocal _fitting
            if _fitting:
                return
            _avail = tree.winfo_width()
            if _avail <= 1:
                return
            _fitting = True
            try:
                _tot = sum(_base_w) or 1
                _alloc = [max(int(round(b * _avail / _tot)), tree.column(c, "minwidth"))
                          for b, c in zip(_base_w, cols)]
                _d = _avail - sum(_alloc)
                if _d:
                    _alloc[-1] += _d
                for c, w in zip(cols, _alloc):
                    tree.column(c, width=w)
            finally:
                _fitting = False
        tree.bind("<Configure>", _fit_cols)
        # grid 容器必须显式给 weight，sticky="nsew" 才会真正拉伸（与航点窗口 frm 同款）
        bottom.rowconfigure(0, weight=1)
        bottom.columnconfigure(0, weight=1)

        op = ttk.Frame(bottom, padding=(0, 4, 0, 0))
        op.grid(row=1, column=0, columnspan=2, sticky="ew")
        ttk.Button(op, text="添加", command=lambda: _add_row(), width=7).pack(side=tk.LEFT, padx=2)
        ttk.Button(op, text="删除", command=lambda: _del_row(), width=7).pack(side=tk.LEFT, padx=2)
        ttk.Button(op, text="上移", command=lambda: _move(-1), width=7).pack(side=tk.LEFT, padx=2)
        ttk.Button(op, text="下移", command=lambda: _move(1), width=7).pack(side=tk.LEFT, padx=2)
        ttk.Button(op, text="排序", command=lambda: _sort_by_time(), width=7).pack(side=tk.LEFT, padx=2)
        ttk.Separator(op, orient=tk.VERTICAL).pack(side=tk.LEFT, padx=4, fill=tk.Y)


        # 2026-09-12：原「开始帧 / 结尾帧」单选（切编辑态）→ 起始坐标… / 结尾坐标… 按钮入口，
        # 与简易位置等其他列表类统一：作用于当前选中行，点开复用通用位置编辑器。
        def _open_coord_editor(which):
            """起始 / 结尾坐标入口：先定编辑目标，再开通用位置编辑器。

            which: "start" 写 sx/sy/scale_start/rot_start；"end" 写 ex/ey/scale_end/rot_end。
            未选中行的情况由 _open_generic_editor 内部统一提示。
            """
            edit_end.set(which == "end")
            _sync_xy_entries()   # 切换起始/结尾：X/Y 框回填对应端关键帧的偏移
            _open_generic_editor()

        ttk.Button(op, text="起始坐标…", command=lambda: _open_coord_editor("start"),
                   width=11).pack(side=tk.LEFT, padx=2)
        ttk.Button(op, text="结尾坐标…", command=lambda: _open_coord_editor("end"),
                   width=11).pack(side=tk.LEFT, padx=2)

        # ---------- 辅助：读取当前关键帧值 ----------
        def _kf_values():
            idx = sel_idx.get()
            if idx < 0 or idx >= len(dlg_segs):
                return None
            w = dlg_segs[idx]
            end = edit_end.get()
            if end and _seg_move_mode(w) != "still":
                return (idx, _seg_num(w, "ex"), _seg_num(w, "ey"),
                        _seg_num(w, "scale_end", 1), _seg_num(w, "rot_end"),
                        _seg_num(w, "start") + _seg_num(w, "dur"))
            return (idx, _seg_num(w, "sx"), _seg_num(w, "sy"),
                    _seg_num(w, "scale_start", 1), _seg_num(w, "rot_start"),
                    _seg_num(w, "start"))

        def _set_kf(sx, sy, sc, ang):
            """写回当前关键帧（start 或 end，按 edit_end）。

            ⚠️ 编辑结尾(start≠end)→ 写 ex/ey/scale_end/rot_end；
               编辑起始 或 不动(still)→ 写 sx/sy/scale_start/rot_start，
               still 时起始结尾同步。
            2026-08-30 修复：此前编辑起始把 scale/rot 误写进 *_end 字段，
            导致起始关键帧「不能缩放/旋转」（存不进去，下次读取又被重置为 100%/0°）。
            """
            idx = sel_idx.get()
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            md = _seg_move_mode(w)
            if edit_end.get() and md != "still":
                w["ex"], w["ey"] = sx, sy
                w["scale_end"] = sc
                w["rot_end"] = ang
            else:
                w["sx"], w["sy"] = sx, sy
                w["scale_start"] = sc
                w["rot_start"] = ang
                if md == "still":
                    w["ex"], w["ey"] = sx, sy
                    w["scale_end"] = sc
                    w["rot_end"] = ang

        def _sync_xy_entries(sx=None, sy=None):
            """把当前关键帧（按 edit_end 决定起始/结尾）的偏移回填到 X/Y 输入框。

            只在「选中目标变化」时调用（切换行、切换起始/结尾、通用编辑器回写、增删移动行），
            不在用户键入时回写——否则会把「-0.5」之类的中间输入round掉、打断连续键入。
            """
            try:
                if sx is None or sy is None:
                    kv = _kf_values()
                    if not kv:
                        sx = sy = 0.0
                    else:
                        sx, sy = kv[1], kv[2]
                for _e, _v in ((ent_x, sx), (ent_y, sy)):
                    _e.delete(0, tk.END)
                    _e.insert(0, f"{int(round(_v)):d}")
            except Exception:
                pass

        def _on_xy_entry():
            """X/Y 输入框 → 写回当前关键帧（缩放/角度保持不变）。"""
            kv = _kf_values()
            if not kv:
                return
            x = _opt_float(ent_x.get(), kv[1])
            y = _opt_float(ent_y.get(), kv[2])
            sc, ang = kv[3], kv[4]
            _set_kf(x, y, sc, ang)
            _refresh(kv[0], sync_entries=False)

        def _fill_corner(cx, cy):
            """八向预设：按当前关键帧倍率把 X/Y 填成 (cx*W*倍率, cy*H*倍率)；(0,0)=归零。"""
            kv = _kf_values()
            if alert_if(not kv, "提示", "请先选择或添加关键帧", 'info'):
                return
            if cx == 0 and cy == 0:
                # 恢复：X/Y 归零，不依赖尺寸
                ent_x.delete(0, tk.END); ent_x.insert(0, "0")
                ent_y.delete(0, tk.END); ent_y.insert(0, "0")
                _on_xy_entry()
                return
            # 偏移基准尺寸：优先视频原始尺寸（与原实现同口径），取不到回落内容尺寸
            try:
                _dim = app._get_video_dimensions_cached(input_file)
            except Exception:
                _dim = (None, None)
            _w = (_dim[0] if _dim and _dim[0] else 0) or pic_w
            _h = (_dim[1] if _dim and _dim[1] else 0) or pic_h
            _sc = _opt_float(kv[3], 1.0)
            if not _sc or _sc <= 0:
                _sc = 1.0
            ent_x.delete(0, tk.END); ent_x.insert(0, str(int(round(cx * _w * _sc))))
            ent_y.delete(0, tk.END); ent_y.insert(0, str(int(round(cy * _h * _sc))))
            _on_xy_entry()

        def _on_corner(event=None):
            # 按索引取方向（不做显示文本匹配）：canonical 与 UI 语言/译文解耦，换语言不会错位
            _ci = corner_combo.current()
            if 0 <= _ci < len(CORNER_DIR_PRESETS):
                _fill_corner(CORNER_DIR_PRESETS[_ci][1], CORNER_DIR_PRESETS[_ci][2])

        # ---------- 列表 ----------
        def _row_values(i, w):
            md = _seg_move_mode(w)
            st = _seg_num(w, "start")
            en = st + _seg_num(w, "dur")
            sc = _seg_num(w, "scale_start", 1) * 100
            ra = _seg_num(w, "rot_start")
            rb = _seg_num(w, "rot_end")
            # 2026-09-03 坐标改整数显示（底层数据仍保留 float 精度，不影响输出/抽帧）。
            off_s = f"{int(round(_seg_num(w, 'sx')))},{int(round(_seg_num(w, 'sy')))}"
            off_e = "—" if md == "still" else f"{int(round(_seg_num(w, 'ex')))},{int(round(_seg_num(w, 'ey')))}"
            # 2026-10-01：原「时间(s)」单列（定点 3 位的 0.000-2.000）拆成「开始时间/结束时间」
            # 两列、显示改 _fmt_sec6（6 位），与列表轨迹/简易位置同口径。
            # 定点 3 位让起止边界与真值差最多 0.5ms（偶尔表现为差 1 帧），已被废弃；
            # 底层数据仍是完整 float 精度，不受显示位数影响。
            return (i + 1, _fmt_sec6(st), _fmt_sec6(en),
                    _traj_mode_display_map().get(md, "平移"),
                    f"{sc:g}", f"{ra:g}", f"{rb:g}", off_s, off_e)

        def _sync_mode_combo(idx):
            """把「方式」下拉同步到指定行段的移动方式（修复：切换行时下拉始终显示该行模式）。"""
            if 0 <= idx < len(dlg_segs):
                cur_mode.set(_traj_mode_display_map().get(_seg_move_mode(dlg_segs[idx]), "平移"))

        def _refresh(select_idx="__keep__", sync_entries=True):
            """刷新列表。sync_entries=True 时顺带把当前关键帧偏移回填 X/Y 输入框。

            ⚠️ 用户正在 X/Y 框里键入时必须传 sync_entries=False（见 _on_xy_entry），
            否则每敲一个字符就被回填覆盖，无法连续输入（如「-0.5」会被取整打断）。
            """
            prev = _rebuild_seg_tree(tree, dlg_segs, select_idx, _row_values)
            if sync_entries:
                _sync_xy_entries()
            _sync_mode_combo(prev if prev is not None else sel_idx.get())

            _selected = lambda: selected_tree_index(tree)

        def _on_select(ev=None):
            sel = tree.selection()
            if not sel:
                return
            idx = int(sel[0])
            if idx == sel_idx.get():
                return
            sel_idx.set(idx)
            _sync_mode_combo(idx)   # 切换行：下拉同步到该行移动方式
            _sync_xy_entries()   # 切换行：X/Y 框回填该行当前关键帧的偏移

        def _open_generic_editor():
            """复用通用位置编辑器（_generic_overlay_editor）编辑当前关键帧的位置/尺寸/旋转。

            画布编辑器模型：内容居中后再偏移 (sx,sy)、缩放 sc、旋转 ang；
            通用编辑器模型：左上角 (x,y)+宽高+角度。二者互转：
                x  = (canvas_w/2 + sx) - (pic_w*sc)/2
                sx = (x + w/2) - canvas_w/2 ; sc = w/pic_w ; ang = angle_cb 捕获
            """
            kv = _kf_values()
            if alert_if(not kv, "提示", "请先选择或添加关键帧", 'info'):
                return
            _idx, sx, sy, sc, ang, _t = kv
            if alert_if(pic_w <= 0 or pic_h <= 0, "提示", "内容尺寸未知，无法打开通用编辑器", 'info'):
                return
            rw = pic_w * sc
            rh = pic_h * sc
            rx = (canvas_w / 2.0 + sx) - rw / 2.0
            ry = (canvas_h / 2.0 + sy) - rh / 2.0
            captured = [float(ang)]
            # 八向方向预设的偏移基准尺寸：优先视频原始尺寸（与原八向预设同口径），取不到回落内容尺寸
            try:
                _dim = app._get_video_dimensions_cached(input_file)
            except Exception:
                _dim = (None, None)
            _cw = (_dim[0] if _dim and _dim[0] else pic_w)
            _ch = (_dim[1] if _dim and _dim[1] else pic_h)
            # 起始/结尾双端（条件调用）：构造 start_end，still 段起始==结尾→can_compare=False 隐藏切换+幽灵
            _se_idx = _idx
            _se_can = (_seg_move_mode(dlg_segs[_se_idx]) != "still")
            def _se_geom(end):
                """给定端返回画布坐标几何 (x,y,w,h,angle)，与 _open_generic_editor 的换算同口径。"""
                _w = dlg_segs[_se_idx]
                _md = _seg_move_mode(_w)
                _e = (end == "end")
                if _e and _md != "still":
                    # ⚠️ 2026-09-12 修复：结尾端必须读 ex/ey（此前误读 sx/sy → 表现为
                    # 「结尾记住了大小 scale_end、却跟随起始坐标」，写回时又把 ex/ey 污染成起始值）。
                    _sx, _sy = _seg_num(_w, "ex"), _seg_num(_w, "ey")
                    _sc, _ang = _seg_num(_w, "scale_end", 1), _seg_num(_w, "rot_end")
                else:
                    # start 端；不动段退化为 ex/ey/scale_end/rot_end（_set_kf 同款同步写）
                    if _md == "still":
                        _sx, _sy = _seg_num(_w, "ex"), _seg_num(_w, "ey")
                        _sc, _ang = _seg_num(_w, "scale_end", 1), _seg_num(_w, "rot_end")
                    else:
                        _sx, _sy = _seg_num(_w, "sx"), _seg_num(_w, "sy")
                        _sc, _ang = _seg_num(_w, "scale_start", 1), _seg_num(_w, "rot_start")
                _rw = pic_w * _sc
                _rh = pic_h * _sc
                return ((canvas_w / 2.0 + _sx) - _rw / 2.0,
                        (canvas_h / 2.0 + _sy) - _rh / 2.0, _rw, _rh, _ang)
            def _se_switch(end):
                edit_end.set(end == "end")
            start_end = {"active": ("end" if edit_end.get() else "start"),
                         "read": _se_geom, "on_switch": _se_switch, "can_compare": _se_can}
            win.grab_release()
            try:
                def _on_apply(nx, ny, nw, nh, ncw, nch):
                    try:
                        nsc = nw / pic_w if pic_w > 0 else 1.0
                        nsx = (nx + nw / 2.0) - canvas_w / 2.0
                        nsy = (ny + nh / 2.0) - canvas_h / 2.0
                    except Exception:
                        return
                    _set_kf(nsx, nsy, nsc, captured[0])
                    with suppress(Exception):
                        _refresh(_idx)
                self.app._generic_overlay_editor(
                    parent=win,
                    canvas_w=canvas_w, canvas_h=canvas_h,
                    rect_x=rx, rect_y=ry, rect_w=rw, rect_h=rh,
                    on_apply=_on_apply,
                    title="位置、尺寸、旋转（通用编辑器）",
                    allow_resize=True,
                    allow_negative_offset=True,
                    angle_editable=True,
                    rotate_angle=float(ang),
                    angle_cb=lambda a: captured.__setitem__(0, float(a)),
                    content_src_w=pic_w, content_src_h=pic_h,
                    main_video_file=None,
                    content_file=input_file,   # 把主视频内容帧画进矩形（沿用原始画布编辑器 ffmpeg 合成，无 PIL）
                    content_time=_t,           # 按当前关键帧时间点取内容帧
                    draw_diagonal=False,
                    show_nudge=False,          # 画布编辑器自有拖拽/缩放滑块，通用编辑器内不显示微调按钮
                    # 八向飞入/飞出预设（条件调用）：下拉落在「绘制新矩形/取消绘制」同一行右侧，
                    # 不额外占一行；用模块级常量 CORNER_DIR_PRESETS——与画布编辑器 X/Y 行下拉同源，
                    # 遮罩等其他位置类将来传同一常量即可复用，避免各处维护一份。
                    corner_dirs=CORNER_DIR_PRESETS,
                    corner_src_w=_cw, corner_src_h=_ch,
                    start_end=start_end,
                    # 2026-09-12：矩形=片段内容盒（可自由负偏移、clamp 全放开），
                    # 「重置位置」应归位图像区左上角 (0,0)，而非水印式的「右下角留边距」。
                    reset_origin=True,
                )
            finally:
                win.grab_set()

        def _edit_row_dialog(idx):
            """整行数值编辑弹窗（双击行 / 与其他列表窗口同款「编辑行」）。

            照抄简易位置窗口 _edit_row_dialog 的结构与校验口径，字段按画布编辑器每行
            实际持有的数据补全：起始/结尾坐标 + 移动方式 + 开始/结束时间 + 起始/结尾缩放
            + 起始/结尾角度。「不动」行无结尾态，结尾类输入置灰并随起始值同步。
            """
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            ed = tk.Toplevel(win)
            ed.title("编辑行")
            ed.transient(win)
            ed.withdraw()
            ef = ttk.Frame(ed, padding=10)
            ef.pack(fill=tk.BOTH, expand=True)
            r = 0

            def _pt_var(key_x, key_y):
                return tk.StringVar(value=f"{int(round(_seg_num(w, key_x))):d}, {int(round(_seg_num(w, key_y))):d}")

            ttk.Label(ef, text="起始坐标:").grid(row=r, column=0, sticky="e", pady=2)
            sa = _pt_var("sx", "sy")
            ttk.Entry(ef, textvariable=sa, width=18).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="移动方式:").grid(row=r, column=0, sticky="e", pady=2)
            _md_init = _traj_mode_display_map().get(_seg_move_mode(w), "平移")
            mdisp = tk.StringVar(value=_md_init)
            mb = ttk.Combobox(ef, textvariable=mdisp, values=_traj_mode_choices(),
                              state="readonly", width=14)
            mb.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾坐标:").grid(row=r, column=0, sticky="e", pady=2)
            sb = _pt_var("ex", "ey")
            eb = ttk.Entry(ef, textvariable=sb, width=18)
            eb.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="开始时间:").grid(row=r, column=0, sticky="e", pady=2)
            stv = tk.StringVar(value=_ffsec(_seg_num(w,'start')))
            ttk.Entry(ef, textvariable=stv, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结束时间:").grid(row=r, column=0, sticky="e", pady=2)
            env = tk.StringVar(value=_ffsec(_seg_num(w,'start') + _seg_num(w,'dur')))
            ttk.Entry(ef, textvariable=env, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="起始缩放(倍):").grid(row=r, column=0, sticky="e", pady=2)
            zma = tk.StringVar(value=f"{_seg_num(w, 'scale_start', 1.0):g}")
            ttk.Entry(ef, textvariable=zma, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾缩放(倍):").grid(row=r, column=0, sticky="e", pady=2)
            zmb = tk.StringVar(value=f"{_seg_num(w, 'scale_end', 1.0):g}")
            zmb_e = ttk.Entry(ef, textvariable=zmb, width=10)
            zmb_e.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="起始角度(度):").grid(row=r, column=0, sticky="e", pady=2)
            rta = tk.StringVar(value=f"{_seg_num(w, 'rot_start', 0):g}")
            ttk.Entry(ef, textvariable=rta, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾角度(度):").grid(row=r, column=0, sticky="e", pady=2)
            rtb = tk.StringVar(value=f"{_seg_num(w, 'rot_end', 0):g}")
            rtb_e = ttk.Entry(ef, textvariable=rtb, width=10)
            rtb_e.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="1.0=原始尺寸；坐标=居中后偏移",
                      foreground="gray").grid(row=r, column=0, columnspan=2, sticky="w", pady=(2, 0))
            r += 1

            def _sync_mode(*_a):
                # 「不动」行没有结尾态：结尾类输入置灰，避免填了也不生效的错觉
                _still = (mdisp.get() == "不动")
                for _e in (eb, zmb_e, rtb_e):
                    _e.config(state="disabled" if _still else "normal")
            mdisp.trace_add("write", _sync_mode)
            _sync_mode()

            def _parse_pt(s):
                try:
                    a, b = str(s).split(",")
                    return float(a.strip()), float(b.strip())
                except Exception:
                    return None

            def _close_ed():
                with suppress(Exception):
                    ed.grab_release()
                with suppress(Exception):
                    ed.destroy()
                win.grab_set()

            def _ok():
                # ⚠️ 先全部解析+校验，通过后才统一写回——否则「结尾坐标填错」时
                # 起始坐标/缩放/角度已被写进 w 形成半截状态（原简易位置版同款缺陷，此处修正）。
                _mi = mb.current()
                _md = _TRAJ_MODE_ORDER[_mi] if 0 <= _mi < len(_TRAJ_MODE_ORDER) else "move"
                move = (_md != "still")
                pa = _parse_pt(sa.get())
                if alert_if(pa is None, "提示", "起始坐标格式应为 x, y（如 30, 30）", 'info'):
                    return
                pb = None
                if move:
                    pb = _parse_pt(sb.get())
                    if alert_if(pb is None, "提示", "结尾坐标格式应为 x, y（如 200, 30）", 'info'):
                        return
                try:
                    s0 = float(stv.get().strip())
                    e0 = float(env.get().strip())
                except (ValueError, TypeError):
                    messagebox.showinfo("提示", "时间应为秒数")
                    return
                if e0 <= s0:
                    _log_time_order_warn(self.app, "[画布] ")
                    return
                try:
                    _za = float(zma.get().strip())
                except (ValueError, TypeError):
                    _za = _seg_num(w, "scale_start", 1.0)
                if not _za or _za <= 0:
                    _za = 1.0
                try:
                    _ra = float(rta.get().strip())
                except (ValueError, TypeError):
                    _ra = _seg_num(w, "rot_start", 0)
                _zb = _za
                _rb = _ra
                if move:
                    try:
                        _zb = float(zmb.get().strip())
                    except (ValueError, TypeError):
                        _zb = _seg_num(w, "scale_end", 1.0)
                    if not _zb or _zb <= 0:
                        _zb = 1.0
                    try:
                        _rb = float(rtb.get().strip())
                    except (ValueError, TypeError):
                        _rb = _seg_num(w, "rot_end", 0)
                # ---- 校验全过：统一写回 ----
                w["move"] = _md
                w["sx"], w["sy"] = pa
                w["scale_start"] = _za
                w["rot_start"] = _ra
                if move:
                    w["ex"], w["ey"] = pb
                    w["scale_end"] = _zb
                    w["rot_end"] = _rb
                else:
                    # 不动：结尾态跟随起始（与 _set_kf 的 still 分支同口径）
                    w["ex"], w["ey"] = pa
                    w["scale_end"] = _za
                    w["rot_end"] = _ra
                w["start"] = s0
                w["dur"] = e0 - s0
                _refresh(idx)
                _close_ed()

            ttk.Button(ef, text="确定", command=_ok, width=8).grid(
                row=r, column=0, sticky="e", padx=(0, 3), pady=(10, 0))
            ttk.Button(ef, text="取消", command=_close_ed, width=8).grid(
                row=r, column=1, sticky="w", padx=(3, 0), pady=(10, 0))
            # 自然尺寸实测 239x283；留标题栏+按钮栏余量（与轨迹控制带角度弹窗同口径 340 高）
            center_window(ed, 300, 340)
            win.grab_release()
            ed.grab_set()
            ed.deiconify()

        def _open_row_editor(idx=None):
            if idx is None:
                idx = _selected()
            if alert_if(idx is None, "提示", "请先选择一行", 'info'):
                return
            _edit_row_dialog(idx)

        def _on_time_entry():
            idx = sel_idx.get()
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            try:
                st = float(t_start.get())
            except (ValueError, TypeError):
                st = _seg_num(w, "start")
            try:
                du = float(t_dur.get())
            except (ValueError, TypeError):
                du = _seg_num(w, "dur")
            if du <= 0:
                du = max(0.1, _seg_num(w, "dur") or 0.1)
            w["start"] = st
            w["dur"] = du
            _refresh(idx)

        tree.bind("<<TreeviewSelect>>", _on_select)

        # 双击行 = 弹出该行的数值编辑窗口（与航点/简易位置等列表窗口同款「编辑行」）。
        # ⚠️ 双击不是可视化入口——位置/尺寸/旋转的可视化编辑走下方「起始坐标…/结尾坐标…」按钮。
        def _on_double(ev):
            iid = tree.identify_row(ev.y)
            if not iid:
                return
            try:
                ri = int(iid)
            except (ValueError, TypeError):
                return
            if 0 <= ri < len(dlg_segs):
                _open_row_editor(ri)
        tree.bind("<Double-1>", _on_double)

        # ---------- 列表右键：编辑 + 复制/粘贴行状态（起始/结尾） ----------
        # 2026-09-12：跨行保持两段连通（上一行结尾 → 下一行起始）的快捷路径；
        # 与「状态」行按钮并存（按钮作用于当前编辑端，右键直接指定源端/目标端免切换）。
        def _cb_state_get(idx, which):
            """读行状态 (x, y, scale, angle)——字段映射与 _kf_values/_set_kf 同口径。"""
            if idx < 0 or idx >= len(dlg_segs):
                return None
            w = dlg_segs[idx]
            if which == "end" and _seg_move_mode(w) != "still":
                return (_seg_num(w, "ex"), _seg_num(w, "ey"),
                        _seg_num(w, "scale_end", 1), _seg_num(w, "rot_end"))
            return (_seg_num(w, "sx"), _seg_num(w, "sy"),
                    _seg_num(w, "scale_start", 1), _seg_num(w, "rot_start"))

        def _cb_state_apply(idx, which, x, y, sc, ang):
            """写行状态——与 _set_kf 同口径（still 段起始结尾同步），随后刷新并回填 X/Y。"""
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            md = _seg_move_mode(w)
            if which == "end" and md != "still":
                w["ex"], w["ey"] = x, y
                w["scale_end"] = sc
                w["rot_end"] = ang
            else:
                w["sx"], w["sy"] = x, y
                w["scale_start"] = sc
                w["rot_start"] = ang
                if md == "still":
                    w["ex"], w["ey"] = x, y
                    w["scale_end"] = sc
                    w["rot_end"] = ang
            _refresh(idx)   # 默认 sync_entries=True：X/Y 框随当前端回填

        def _cb_state_can(idx, which):
            """still 段无独立结尾（写回强制同步）→ 结尾两项置灰（与通用编辑器 can_compare 同语义）。"""
            return which != "end" or _seg_move_mode(dlg_segs[idx]) != "still"

        _attach_state_clipboard_menu(tree, edit_row=_open_row_editor,
                                     get_state=_cb_state_get, apply_state=_cb_state_apply,
                                     can_edit=_cb_state_can)

        # ---------- 行操作 ----------
        def _add_row():
            n = len(dlg_segs)
            if alert_if(n >= MAX_ROWS, "提示", f"最多 {MAX_ROWS} 行", 'info'):
                return
            if n:
                pw = dlg_segs[-1]
                st = _seg_num(pw, "start") + max(_seg_num(pw, "dur"), 0)
                sx = _seg_num(pw, "ex") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sx")
                sy = _seg_num(pw, "ey") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sy")
            else:
                st = 0.0
                sx, sy = 0.0, 0.0
            dlg_segs.append({"sx": sx, "sy": sy, "ex": sx, "ey": sy,
                             "scale_start": 1.0, "scale_end": 1.0,
                             "rot_start": 0.0, "rot_end": 0.0,
                             "move": "move", "start": st, "dur": 2.0})
            sel_idx.set(n)
            _refresh(n)

        def _del_row():
            # 2026-10-01：支持多选批量删除（Ctrl/Shift 选中多行一次删；单选 = 原行为不变）
            idxs = sorted(int(iid) for iid in tree.selection()
                          if str(iid).isdigit())
            if alert_if(not idxs, "提示", "请先选择一行", 'info'):
                return
            for _di in reversed(idxs):
                if 0 <= _di < len(dlg_segs):
                    dlg_segs.pop(_di)
            sel_idx.set(-1)
            _refresh()

        def _move(d):
            idx = _selected()
            if idx is None:
                return
            j = idx + d
            if 0 <= j < len(dlg_segs):
                dlg_segs[idx], dlg_segs[j] = dlg_segs[j], dlg_segs[idx]
                sel_idx.set(j)
                _refresh(j)

        def _sort_by_time():
            dlg_segs.sort(key=lambda s: _seg_num(s, "start"))
            _refresh()
            sel_idx.set(-1)

        # ---------- 时间预览 ----------
        def _open_time_preview():
            idx = _selected()
            if idx is not None and (idx < 0 or idx >= len(dlg_segs)):
                return
            w = dlg_segs[idx] if idx is not None else None
            if alert_if(not input_file or not os.path.exists(input_file), "错误", "未找到主视频文件，无法时间预览", 'error'):
                return
            if alert_if(not ffmpeg_cmd, "提示", "未找到 ffmpeg，无法预览"):
                return
            win.grab_release()

            def _on_start(t):
                if w is None:
                    return
                w["start"] = float(t)
                _refresh(idx)

            def _on_end(t):
                if w is None:
                    return
                te = float(t)
                if te <= _seg_num(w, "start"):
                    _log_time_order_warn(self.app, "[简易位置] ")
                    return
                w["dur"] = te - _seg_num(w, "start")
                _refresh(idx)

            def _on_marks_to_canvas(segs):
                added = skipped = 0
                for s, e in segs:
                    if e <= s:
                        skipped += 1
                        continue
                    if len(dlg_segs) >= MAX_ROWS:
                        skipped += 1
                        continue
                    if dlg_segs:
                        pw = dlg_segs[-1]
                        sx = _seg_num(pw, "ex") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sx")
                        sy = _seg_num(pw, "ey") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sy")
                        ss = _seg_num(pw, "scale_end", 1)
                        ra = _seg_num(pw, "rot_end")
                    else:
                        sx = sy = 0.0
                        ss = 1.0
                        ra = 0.0
                    dlg_segs.append({"sx": sx, "sy": sy, "ex": sx, "ey": sy,
                                     "scale_start": ss, "scale_end": ss,
                                     "rot_start": ra, "rot_end": ra,
                                     "move": "move", "start": float(s),
                                     "dur": float(e - s)})
                    added += 1
                if added or skipped:
                    with suppress(Exception):
                        app._append_info_ui(
                            f"[画布模式] 已追加 {added} 个时间段（跳过 {skipped}）")
                _refresh()

            if w is not None:
                initial_marks = [(w["start"], w["start"] + _seg_num(w, "dur"))]
            else:
                initial_marks = [(s["start"], s["start"] + _seg_num(s, "dur"))
                                for s in dlg_segs]
            try:
                app.show_time_picker(win, input_file, on_set_start=_on_start,
                                     on_set_end=_on_end,
                                     initial_marks=initial_marks,
                                     on_send_waypoints=_on_marks_to_canvas)
            finally:
                win.grab_set()

        # ---------- 确定 / 取消 ----------
        def _refresh_host():
            """画布设置写回后刷新宿主页命令模板（转换/封装/队列），避免"确定后命令不刷新"。"""
            cb = getattr(self, "refresh_cb", None)
            if cb is not None:
                try:
                    cb()
                    return
                except Exception:
                    pass
            with suppress(Exception):
                self.app.update_command_preview()

        def _ok():
            if self.canvas_mode.get() and not dlg_segs:
                dlg_segs.append({"sx": 0.0, "sy": 0.0, "ex": 0.0, "ey": 0.0,
                                 "scale_start": 1.0, "scale_end": 1.0,
                                 "rot_start": 0.0, "rot_end": 0.0,
                                 "move": "move", "start": 0.0, "dur": 2.0})
            # 确定时静默收敛时间交叉（交叉=未定义行为：嵌套 if 下后行会抢占前行）
            report_seg_clamp("画布模式", clamp_seg_overlaps(dlg_segs), self.app)
            self.canvas_segments = copy.deepcopy(dlg_segs)
            _refresh_host()
            _close()

        def _close():
            with suppress(Exception):
                win.grab_release()
            win.destroy()

        # ---------- 初始化 ----------
        if dlg_segs:
            sel_idx.set(0)
            _refresh(0)
        else:
            _refresh(None)

        def _on_canvas_mode_toggle():
            # 启用画布模式：若关键帧列表为空则种子一条默认行，行为对齐其他列表轨迹
            # （航点「启用列表轨迹」_ensure_wps / 裁剪「启用简易位置」_on_enable_toggle：
            #   点击启用即落一条，无需手动「添加」）。
            if self.canvas_mode.get() and not dlg_segs:
                _add_row()

        chk_canvas.config(command=_on_canvas_mode_toggle)
        # 打开时若总开关已启用而列表尚空，同样种子默认段——否则只有点「确定」时才在
        # _ok() 里兜底补一行，用户全程看不到可编辑行（列表一直空着）。
        _on_canvas_mode_toggle()

        win.protocol("WM_DELETE_WINDOW", _close)
        # 窗口可缩放：拉宽时由末列 ex 吸收多余宽度（2026-08-30 布局修正）
        win.resizable(True, True)
        # 2026-09-12：窗口尺寸不再猜——先 update_idletasks 让布局落定，再用 winfo_reqwidth/
        # reqheight 取 Tk 自己算出的自然尺寸（列表 8 列完整宽度天然包含在内，无需手算列宽总和），
        # 最后只做「夹到屏幕内 + 居中定位」。
        # 照抄「末端处理」等列表弹窗（update_idletasks → reqwidth/reqheight → geometry("+x+y")）：
        # 列宽/控件一改窗口自动跟随，末列不会被裁，也不必手动拉宽。
        win.update_idletasks()
        _scr_w = win.winfo_screenwidth()
        _scr_h = win.winfo_screenheight()
        _nat_w = win.winfo_reqwidth()
        _nat_h = win.winfo_reqheight()
        # 2026-10-01：画布模式窗口比同类弹窗偏小 → 默认放大 +150 宽 / +100 高
        # 仅设下限 minsize，WM 仍按内容自然撑开、末列不被裁，也不触发标题栏扣减裁切
        _canvas_win_w = _nat_w + 150
        _canvas_win_h = _nat_h + 100
        win.minsize(_canvas_win_w, _canvas_win_h)
        _x = max(0, (_scr_w - _canvas_win_w) // 2)
        _y = max(0, (_scr_h - _canvas_win_h) // 2 - 20)
        _tree_w = sum(widths) + 20      # 列表 8 列设计宽 + 滚动条（兜底用）
        if _nat_w < _tree_w:
            # 布局未落定（reqwidth 异常小）才显式给宽，避免列表被压掉末列
            win.geometry(f"{min(_tree_w, max(320, _scr_w - 60))}x"
                         f"{min(max(_nat_h, 200), max(200, _scr_h - 60))}+{_x}+{_y}")
        else:
            # ⚠️ 只定位、不设宽高：reqwidth/reqheight 是**内容区**尺寸，不含标题栏与边框；
            # 若直接拿它去 geometry(f"WxH")，窗口管理器会再从里面扣掉标题栏，底部按钮被裁。
            # 让 WM 按内容自然撑开（与「末端处理」弹窗完全同款），列表末列必定完整可见。
            win.geometry(f"+{_x}+{_y}")
        win.deiconify()
        win.lift()
        win.focus_force()
        win.grab_set()


    def _crop_pos_dialog(self, input_file, orig_w, orig_h, crop_w, crop_h, base_x, base_y):
        """简易位置子窗口：列表轨迹式编辑「裁剪框随时间在画面内移动」。

        input_file: 主视频（背景帧/时间预览用）；orig_w/h: 原始尺寸（坐标钳制范围）；
        crop_w/h: 裁剪框尺寸（固定）；base_x/y: 基准=裁剪框左上角(crop_left/crop_top)。
        段数据存 self.crop_pos_segments，确定才深拷贝写回。"""
        # 裁剪平移行上限（2026-08-30）：默认 8，由「更多设置」可调 1~99
        MAX_ROWS = 8
        try:
            MAX_ROWS = max(1, min(99, int(self.app.crop_pos_max_rows.get())))
        except Exception:
            MAX_ROWS = 8
        dlg_segs = copy.deepcopy(self.crop_pos_segments)
        ffmpeg_cmd = getattr(self.app, "ffmpeg_cmd", None)
        ffprobe_cmd = getattr(self.app, "ffprobe_cmd", None)

        win = tk.Toplevel(self.app.root)
        win.title("简易位置 - 裁剪框动态位移")
        win.transient(self.app.root)
        win.withdraw()
        frm = ttk.Frame(win, padding=8)
        frm.pack(fill=tk.BOTH, expand=True)
        frm.grid_columnconfigure(0, weight=1)
        # ⚠️ 不设任何行 weight：开关行/列表/按钮/甘特/提示/确定栏全部按自然高度
        # 顺序紧贴，窗口拉高时多余空白落在最底部，而非被某一行拉伸。

        # 简易位置总开关（2026-08-30）：显式启用/禁用，不再只能靠「把列表删空」禁用。
        # 收在本窗口顶部：进编辑器改轨迹时即可开关，确定才写回（与列表同生命周期）。
        chk_on = tk.BooleanVar(value=bool(self.crop_pos_enabled.get()))
        chk_row = ttk.Frame(frm)
        chk_row.grid(row=0, column=0, columnspan=5, sticky="w", pady=(0, 4))
        chk_box = ttk.Checkbutton(chk_row, text="启用简易位置（裁剪框随时间在画面内移动）",
                                  variable=chk_on)
        chk_box.pack(side=tk.LEFT)
        ToolTip(chk_box,
                "简易位置总开关。\n"
                "勾选=启用（列表中的段生效）；取消=禁用，即使列表里还有段也不会生效（无需删空列表）。\n"
                "与「位置、尺寸、旋转」画布模式并存，二者同时开启时以后者的画布模式为准。",
                wraplength=420)

        # ---- 列表 ----
        cols = ("idx", "start", "mode", "end", "btime", "dtime")
        headers = ("行", "起始坐标", "移动方式", "结尾坐标", "开始时间", "结束时间")
        widths = (34, 110, 70, 110, 62, 62)
        tree = ttk.Treeview(frm, columns=cols, show="headings", height=7)
        for c, h, wdt in zip(cols, headers, widths):
            tree.heading(c, text=h)
            tree.column(c, width=wdt, anchor=tk.CENTER if c not in ("start", "end") else tk.W)
        vsb = ttk.Scrollbar(frm, orient=tk.VERTICAL, command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        tree.grid(row=1, column=0, columnspan=5, sticky="nsew")
        vsb.grid(row=1, column=5, sticky="ns")

        def _blank_click(ev):
            with suppress(Exception):
                if tree.identify_row(ev.y) == "":
                    tree.selection_remove(*tree.selection())

        tree.bind("<Button-1>", _blank_click)

        def _row_values(i, w):
            md = _seg_move_mode(w)
            sta = f"{int(round(_seg_num(w,'sx'))):d},{int(round(_seg_num(w,'sy'))):d}"
            endc = "—" if md == "still" else f"{int(round(_seg_num(w,'ex'))):d},{int(round(_seg_num(w,'ey'))):d}"
            btm = _fmt_sec6(_seg_num(w,'start'))
            dtt = _fmt_sec6(_seg_num(w,'start') + _seg_num(w,'dur'))
            mdisp = _traj_mode_display_map().get(md, "平移")
            return (i + 1, sta, mdisp, endc, btm, dtt)

        def _refresh(select_idx="__keep__"):
            prev = _rebuild_seg_tree(tree, dlg_segs, select_idx, _row_values)
            _update_hint()
            with suppress(Exception):
                _update_time_entries()

        _selected = lambda: selected_tree_index(tree)

        def _open_coord_editor(which):
            idx = _selected()
            if alert_if(idx is None, "提示", "请先选择一行", 'info'):
                return
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            if which == "start":
                cx, cy = _seg_num(w, "sx"), _seg_num(w, "sy")
                t0 = _seg_num(w, "start")
            else:
                cx, cy = _seg_num(w, "ex"), _seg_num(w, "ey")
                t0 = _seg_num(w, "start") + _seg_num(w, "dur")

            _active = [which]   # 可变活动端（内部「起始/结尾」翻转用）
            def _apply(nx, ny):
                if _active[0] == "start":
                    w["sx"], w["sy"] = float(nx), float(ny)
                else:
                    w["ex"], w["ey"] = float(nx), float(ny)
                _refresh()
            # 起始/结尾双端（条件调用）：构造 start_end，still 段起始==结尾→隐藏切换+幽灵
            _se_can = (_seg_move_mode(w) != "still")
            def _se_geom(end):
                if end == "end":
                    return (_seg_num(w, "ex"), _seg_num(w, "ey"), crop_w, crop_h, 0.0)
                return (_seg_num(w, "sx"), _seg_num(w, "sy"), crop_w, crop_h, 0.0)
            def _se_switch(end):
                _active[0] = end
            start_end = {"active": which, "read": _se_geom,
                         "on_switch": _se_switch, "can_compare": _se_can}

            # 复用通用叠加/偏移编辑器（取代原 _crop_pos_coord_editor 单独实现）：
            # 固定尺寸裁剪框=crop_w×crop_h，在 orig_w×orig_h 背景帧上拖拽；不绘制矩形内斜纹。
            # 打开前释放简易位置对话框模态锁、关闭后归还（与旧实现同款 grab 卫生）。
            win.grab_release()
            try:
                self.app._generic_overlay_editor(
                    parent=win,
                    canvas_w=orig_w, canvas_h=orig_h,
                    rect_x=cx, rect_y=cy, rect_w=crop_w, rect_h=crop_h,
                    on_apply=lambda nx, ny, *_a: _apply(nx, ny),
                    title="简易位置 - 坐标",
                    allow_resize=False,
                    coord_mode='top_left',
                    allow_negative_offset=False,
                    rect_color='red',
                    rect_label='裁剪框',
                    show_nudge=False,
                    rotate_angle=0.0,
                    angle_cb=None,
                    angle_editable=False,
                    rot_square=True,
                    show_canvas_controls=False,
                    main_video_file=input_file,
                    main_offset=(0, 0),
                    main_render_size=None,
                    initial_time=t0,
                    bg_pre_filter=None,
                    on_drag_commit=lambda nx, ny, *_a: _apply(nx, ny),
                    draw_diagonal=False,
                    start_end=start_end,
                )
            finally:
                win.grab_set()

        # ---- 行操作 ----
        btns = ttk.Frame(frm)
        btns.grid(row=2, column=0, columnspan=5, sticky="ew", pady=(6, 2))

        def _add_row():
            n = len(dlg_segs)
            if alert_if(n >= MAX_ROWS, "提示", f"最多 {MAX_ROWS} 行", 'info'):
                return
            # 新行接在尾巴上：开始时间=上一行结束，起始坐标=上一行结尾，移动方式=移动
            # （默认移动：零位移起步 sx==ex，列表显示「移动」，与用户要求一致；之前默认「不动」）
            # → 加行天然首尾相接（只种子新行，绝不动已有行）。
            if n:
                pw = dlg_segs[-1]
                st = _seg_num(pw, "start") + max(_seg_num(pw, "dur"), 0)
                sx = _seg_num(pw, "ex") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sx")
                sy = _seg_num(pw, "ey") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sy")
            else:
                st = 0.0
                sx, sy = float(base_x), float(base_y)
            new = {"sx": sx, "sy": sy, "move": "move",
                   "ex": sx, "ey": sy, "start": st, "dur": 2.0}
            dlg_segs.append(new)
            _refresh(n)

        def _on_enable_toggle():
            # 启用简易位置：若列表为空则种子一条默认段，行为对齐其他列表轨迹
            # （航点「启用列表轨迹」_ensure_wps：点击启用即落一条，无需手动「添加」）。
            if chk_on.get() and not dlg_segs:
                _add_row()

        chk_box.config(command=_on_enable_toggle)
        # 打开时若总开关已启用且列表尚空，同样种子默认段（对齐 waypoint 对话框
        # _sync_params 打开即 seed 的口径），保证「启用 + 空列表」一进窗就有可编辑行。
        _on_enable_toggle()

        def _del_row():
            # 2026-10-01：支持多选批量删除（Ctrl/Shift 选中多行一次删；单选 = 原行为不变）
            idxs = sorted(int(iid) for iid in tree.selection()
                          if str(iid).isdigit())
            if not idxs:
                return
            for _di in reversed(idxs):
                if 0 <= _di < len(dlg_segs):
                    del dlg_segs[_di]
            _refresh(min(idxs[0], len(dlg_segs) - 1) if dlg_segs else None)

        def _move(delta):
            idx = _selected()
            if idx is None:
                return
            j = idx + delta
            if j < 0 or j >= len(dlg_segs):
                return
            dlg_segs[idx], dlg_segs[j] = dlg_segs[j], dlg_segs[idx]
            _refresh()
            tree.selection_set(str(j))

        def _sort_by_time():
            dlg_segs.sort(key=lambda s: _seg_num(s, "start"))
            _refresh()

        def _edit_row_dialog(idx):
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            ed = tk.Toplevel(win)
            ed.title("编辑行")
            ed.transient(win)
            ed.withdraw()
            ef = ttk.Frame(ed, padding=10)
            ef.pack(fill=tk.BOTH, expand=True)
            r = 0

            def _pt_var(key_x, key_y):
                return tk.StringVar(value=f"{int(round(_seg_num(w, key_x))):d}, {int(round(_seg_num(w, key_y))):d}")

            ttk.Label(ef, text="起始坐标:").grid(row=r, column=0, sticky="e", pady=2)
            sa = _pt_var("sx", "sy")
            ttk.Entry(ef, textvariable=sa, width=18).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="移动方式:").grid(row=r, column=0, sticky="e", pady=2)
            _md_init = _traj_mode_display_map().get(_seg_move_mode(w), "平移")
            mdisp = tk.StringVar(value=_md_init)
            mb = ttk.Combobox(ef, textvariable=mdisp, values=_traj_mode_choices(),
                              state="readonly", width=14)
            mb.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾坐标:").grid(row=r, column=0, sticky="e", pady=2)
            sb = _pt_var("ex", "ey")
            eb = ttk.Entry(ef, textvariable=sb, width=18)
            eb.grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="开始时间:").grid(row=r, column=0, sticky="e", pady=2)
            stv = tk.StringVar(value=_ffsec(_seg_num(w,'start')))
            ttk.Entry(ef, textvariable=stv, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结束时间:").grid(row=r, column=0, sticky="e", pady=2)
            env = tk.StringVar(value=_ffsec(_seg_num(w,'start') + _seg_num(w,'dur')))
            ttk.Entry(ef, textvariable=env, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            def _sync_mode(*_a):
                eb.config(state="disabled" if mdisp.get() == "不动" else "normal")
            mdisp.trace_add("write", _sync_mode)
            _sync_mode()

            def _parse_pt(s):
                try:
                    a, b = str(s).split(",")
                    return float(a.strip()), float(b.strip())
                except Exception:
                    return None

            def _close():
                with suppress(Exception):
                    ed.grab_release()
                with suppress(Exception):
                    ed.destroy()
                win.grab_set()

            def _ok():
                _mi = mb.current()
                _md = _TRAJ_MODE_ORDER[_mi] if 0 <= _mi < len(_TRAJ_MODE_ORDER) else "move"
                move = (_md != "still")
                pa = _parse_pt(sa.get())
                if alert_if(pa is None, "提示", "起始坐标格式应为 x, y（如 30, 30）", 'info'):
                    return
                try:
                    s0 = float(stv.get().strip())
                    e0 = float(env.get().strip())
                except (ValueError, TypeError):
                    messagebox.showinfo("提示", "时间应为秒数")
                    return
                if e0 <= s0:
                    _log_time_order_warn(self.app, "[简易位置] ")
                    return
                w["move"] = _md
                w["sx"], w["sy"] = pa
                if move:
                    pb = _parse_pt(sb.get())
                    if alert_if(pb is None, "提示", "结尾坐标格式应为 x, y（如 200, 30）", 'info'):
                        return
                    w["ex"], w["ey"] = pb
                else:
                    w["ex"], w["ey"] = pa
                w["start"] = s0
                w["dur"] = e0 - s0
                _refresh()
                _close()

            ttk.Button(ef, text="确定", command=_ok, width=8).grid(
                row=r, column=0, sticky="e", padx=(0, 3), pady=(10, 0))
            ttk.Button(ef, text="取消", command=_close, width=8).grid(
                row=r, column=1, sticky="w", padx=(3, 0), pady=(10, 0))
            center_window(ed, 300, 250)
            win.grab_release()
            ed.grab_set()
            ed.deiconify()

        def _open_row_editor(idx=None):
            if idx is None:
                idx = _selected()
            if alert_if(idx is None, "提示", "请先选择一行", 'info'):
                return
            _edit_row_dialog(idx)

        def _open_time_preview():
            idx = _selected()
            if idx is not None and (idx < 0 or idx >= len(dlg_segs)):
                return
            w = dlg_segs[idx] if idx is not None else None
            if alert_if(not input_file or not os.path.exists(input_file), "错误", "未找到主视频文件，无法时间预览", 'error'):
                return
            if alert_if(not ffmpeg_cmd, "提示", "未找到 ffmpeg，无法预览"):
                return
            win.grab_release()

            def _on_start(t):
                if w is None:
                    return
                w["start"] = float(t)
                _refresh()

            def _on_end(t):
                if w is None:
                    return
                te = float(t)
                if te <= _seg_num(w, "start"):
                    _log_time_order_warn(self.app, "[简易位置] ")
                    return
                w["dur"] = te - _seg_num(w, "start")
                _refresh()

            def _on_marks_to_crop_pos(segs):
                """简易预览标记段 → 简易位置列表「不动」段（预览只选时间，坐标沿用
                上一行结尾或基准）。追加到末尾，受 MAX_ROWS 上限约束；与已有行重叠只
                提示、照常添加（时间不自动钳合，靠用户手动改）。"""
                added = skipped = 0
                overlap_hits = []
                for s, e in segs:
                    if e <= s:
                        skipped += 1
                        continue
                    if len(dlg_segs) >= MAX_ROWS:
                        skipped += 1
                        continue
                    if dlg_segs:
                        pw = dlg_segs[-1]
                        sx = _seg_num(pw, "ex") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sx")
                        sy = _seg_num(pw, "ey") if _seg_move_mode(pw) != "still" else _seg_num(pw, "sy")
                    else:
                        sx, sy = float(base_x), float(base_y)
                    dlg_segs.append({"sx": sx, "sy": sy, "move": "move",
                                     "ex": sx, "ey": sy,
                                     "start": float(s), "dur": float(e - s)})
                    added += 1
                    # 重叠检测（只提示不阻止）：与已存在的每一行比对新段
                    for oi, ow in enumerate(dlg_segs[:-1]):
                        os0 = _seg_num(ow, "start")
                        oe0 = os0 + max(_seg_num(ow, "dur"), 0)
                        if max(os0, float(s)) < min(oe0, float(e)):
                            overlap_hits.append((oi + 1, float(s), float(e)))
                if added or skipped:
                    msg = f"已追加 {added} 个时间段到简易位置列表"
                    if skipped:
                        msg += f"（跳过 {skipped} 个：超出 {MAX_ROWS} 行上限或无效）"
                    with suppress(Exception):
                        self.app._append_info_ui("[简易位置] " + msg)
                if overlap_hits:
                    _oi, _s, _e = overlap_hits[0]
                    messagebox.showinfo(
                        "提示",
                        f"新时间段与第 {_oi} 行等 {len(overlap_hits)} 处重叠（只提示，已照常添加）。\n"
                        "时间不会自动钳合，请在列表里手动调整。")
                _refresh()

            if w is not None:
                initial_marks = [(w["start"], w["start"] + _seg_num(w, "dur"))]
            else:
                initial_marks = [(s["start"], s["start"] + _seg_num(s, "dur")) for s in dlg_segs]
            try:
                self.app.show_time_picker(win, input_file, on_set_start=_on_start,
                                          on_set_end=_on_end, initial_marks=initial_marks,
                                          on_send_waypoints=_on_marks_to_crop_pos)
            finally:
                win.grab_set()

        # ---- 按钮行 ----
        W4 = 5
        ttk.Button(btns, text="添加", command=_add_row, width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="删除", command=_del_row, width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="上移", command=lambda: _move(-1), width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="下移", command=lambda: _move(1), width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="排序", command=_sort_by_time, width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="编辑", command=_open_row_editor, width=W4).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="起始坐标…", command=lambda: _open_coord_editor("start"), width=9).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="结尾坐标…", command=lambda: _open_coord_editor("end"), width=9).pack(side=tk.LEFT, padx=1)
        ttk.Button(btns, text="时间预览", command=_open_time_preview, width=9).pack(side=tk.LEFT, padx=1)
        ttk.Label(btns, text="开始:").pack(side=tk.LEFT, padx=(6, 0))
        t_start_var = tk.StringVar()
        t_start_e = ttk.Entry(btns, textvariable=t_start_var, width=7)
        t_start_e.pack(side=tk.LEFT)
        ttk.Label(btns, text="结束:").pack(side=tk.LEFT, padx=(6, 0))
        t_end_var = tk.StringVar()
        t_end_e = ttk.Entry(btns, textvariable=t_end_var, width=7)
        t_end_e.pack(side=tk.LEFT)
        ttk.Label(btns, text="(选中行时间)", foreground="gray").pack(side=tk.LEFT, padx=4)

        _time_owner = [None]

        def _update_time_entries():
            idx = _selected()
            if idx is None or idx >= len(dlg_segs):
                t_start_var.set("")
                t_end_var.set("")
                _time_owner[0] = None
                return
            w = dlg_segs[idx]
            t_start_var.set(_ffsec(_seg_num(w,'start')))
            t_end_var.set(_ffsec(_seg_num(w,'start') + _seg_num(w,'dur')))
            _time_owner[0] = idx

        def _apply_time_entries(_ev=None):
            idx = _time_owner[0]
            if idx is None or idx >= len(dlg_segs):
                _update_time_entries()
                return
            w = dlg_segs[idx]
            try:
                s0 = float(t_start_var.get().strip())
                e0 = float(t_end_var.get().strip())
            except (ValueError, TypeError):
                _update_time_entries()
                return
            if e0 <= s0:
                _log_time_order_warn(self.app, "[简易位置] ")
                return
            w["start"] = s0
            w["dur"] = e0 - s0
            with suppress(Exception):
                tree.item(str(idx), values=_row_values(idx, w))
            _update_hint()
            _update_time_entries()

        t_start_e.bind("<Return>", _apply_time_entries)
        t_end_e.bind("<Return>", _apply_time_entries)
        t_start_e.bind("<FocusOut>", _apply_time_entries)
        t_end_e.bind("<FocusOut>", _apply_time_entries)

        # ---- 甘特条 + 状态 ----
        prev_cv = tk.Canvas(frm, height=34, bg="#fafafa", highlightthickness=1,
                            highlightbackground="#cccccc")
        prev_cv.grid(row=3, column=0, columnspan=5, sticky="ew", pady=(4, 0))
        # 2026-08-28：灰色提示改 2 行（说明行 + 动态状态行）
        prev_lab = ttk.Label(frm, text="", foreground="gray", justify=tk.LEFT)
        prev_lab.grid(row=4, column=0, columnspan=5, sticky="w")

        HINT1 = (f"≤{MAX_ROWS} 行；段前=裁剪框基准，段内平移/静止，段后停上一行结尾（不回跳）；"
                 f"双击编辑整行")
        HINT2 = "⚠ 时间不自动钳合，需首尾相接（靠你手动改）"
        # 2026-08-29：主视频启用截取/变速 → 时间按输出时间线（滤镜 t=截取后从 0 起）填
        try:
            _ts0, _sp0 = _main_trim_speed(self.app)
            if _ts0 > 0 or _sp0 != 1.0:
                HINT2 += (f" ｜ ⚠ 主视频已截取(起点 {_ts0:.3f}s)/变速(×{_sp0:g})："
                          f"时间按主视频原始时间填，转换时自动换算（无需手动减）")
        except Exception:
            pass

        def _collect_warnings():
            ws = []
            ss = sorted(dlg_segs, key=lambda s: _seg_num(s, "start"))
            for i in range(1, len(ss)):
                pe = _seg_num(ss[i - 1], "start") + max(_seg_num(ss[i - 1], "dur"), 0)
                cs = _seg_num(ss[i], "start")
                if cs + 1e-6 < pe:
                    ws.append(f"第{i+1}行开始 {cs:.3f}s 与上一行结束 {pe:.3f}s 重叠")
                elif cs > pe + 1e-6:
                    ws.append(f"第{i+1}行开始 {cs:.3f}s 与上一行结束 {pe:.3f}s 空档 {cs-pe:.3f}s")
            return ws

        def _draw_preview():
            prev_cv.delete("all")
            wpx = prev_cv.winfo_width() or 560
            if not dlg_segs:
                prev_lab.config(text=HINT1 + "\n" + HINT2 + " ｜ 暂无分段（静态裁剪）")
                return
            t_max = max(_seg_num(w, "start") + max(_seg_num(w, "dur"), 0.05) for w in dlg_segs)
            if t_max <= 0:
                t_max = 1.0

            def x_of(t):
                return 6 + (t / t_max) * (wpx - 12)

            for i, w in enumerate(dlg_segs):
                s0 = _seg_num(w, "start")
                d0 = max(_seg_num(w, "dur", 1.0), 0.05)
                md = _seg_move_mode(w)
                _md_colors = {"move": "#85B7EB", "linear": "#9AD0C2",
                              "smoothstep": "#7FBF7F",
                              "ease_in": "#C9A0DC", "ease_out": "#F0B36B",
                              "ease_in_out": "#7FBF7F", "still": "#B4B2A9"}
                col = _md_colors.get(md, "#85B7EB")
                prev_cv.create_rectangle(x_of(s0), 8, max(x_of(s0 + d0), x_of(s0) + 4), 24,
                                         fill=col, outline="#5F5E5A")
                ax = x_of(s0)
                prev_cv.create_polygon(ax - 4, 8, ax + 4, 8, ax, 14, fill=col, outline="#333333")
            prev_cv.create_line(wpx - 6, 6, wpx - 6, 26, fill="#A32D2D", width=2)
            ws = _collect_warnings()
            if ws:
                prev_lab.config(text=HINT1 + "\n" + HINT2 + " ｜ ⚠ " + ws[0] + (" …" if len(ws) > 1 else ""))
            else:
                prev_lab.config(text=HINT1 + "\n" + HINT2 + " ｜ 时间首尾相接 ✓")

        def _update_hint():
            try:
                ex_x, ex_y = build_crop_pos_expr(dlg_segs, base_x, base_y)
                n = (len(ex_x) + len(ex_y)) // 2 if ex_x else 0
                prev_lab.config(text=HINT1 + "\n" + HINT2 + f" ｜ 表达式约 {n} 字符")
            except Exception:
                pass
            _draw_preview()

        def _on_double(ev):
            iid = tree.identify_row(ev.y)
            if not iid:
                return
            try:
                ri = int(iid)
            except (ValueError, TypeError):
                return
            if 0 <= ri < len(dlg_segs):
                _open_row_editor(ri)

        def _on_tree_select(*_a):
            with suppress(Exception):
                _apply_time_entries()
            _update_hint()
            _update_time_entries()

        tree.bind("<Double-1>", _on_double)
        tree.bind("<<TreeviewSelect>>", _on_tree_select)
        frm.bind("<Configure>", lambda *a: _draw_preview())

        # ---------- 列表右键：编辑 + 复制/粘贴行状态（起始/结尾） ----------
        # 2026-09-12：跨行保持两段连通（上一行结尾 → 下一行起始）。
        # 简易位置只消费坐标（无缩放/角度渲染），get_state 恒回 1.0/0.0、apply_state 只写坐标。
        def _sp_state_get(idx, which):
            if idx < 0 or idx >= len(dlg_segs):
                return None
            w = dlg_segs[idx]
            if which == "end":
                return (_seg_num(w, "ex"), _seg_num(w, "ey"), 1.0, 0.0)
            return (_seg_num(w, "sx"), _seg_num(w, "sy"), 1.0, 0.0)

        def _sp_state_apply(idx, which, x, y, sc, ang):
            if idx < 0 or idx >= len(dlg_segs):
                return
            w = dlg_segs[idx]
            md = _seg_move_mode(w)
            if which == "end" and md != "still":
                w["ex"], w["ey"] = x, y
            else:
                w["sx"], w["sy"] = x, y
                if md == "still":
                    w["ex"], w["ey"] = x, y   # still 段保持 ex/ey==sx/sy 的既有约定
            _refresh(idx)

        def _sp_state_can(idx, which):
            """still 段结尾显示为「—」（无独立结尾）→ 结尾两项置灰。"""
            return which != "end" or _seg_move_mode(dlg_segs[idx]) != "still"

        _attach_state_clipboard_menu(tree, edit_row=_open_row_editor,
                                     get_state=_sp_state_get, apply_state=_sp_state_apply,
                                     can_edit=_sp_state_can)

        # ---- 确定/取消 ----
        okf = ttk.Frame(frm)
        okf.grid(row=5, column=0, columnspan=5, sticky="ew", pady=(8, 0))

        def _close():
            with suppress(Exception):
                win.grab_release()
            with suppress(Exception):
                win.destroy()

        def _on_ok():
            self.crop_pos_enabled.set(chk_on.get())  # 简易位置总开关随本窗口确定写回
            # 确定时静默收敛时间交叉（在 deepcopy 之前改 dlg_segs，写回的才是收敛后的）
            report_seg_clamp("简易位置", clamp_seg_overlaps(dlg_segs), self.app)
            self.crop_pos_segments = copy.deepcopy(dlg_segs)
            _st = "已启用" if chk_on.get() else "已禁用（列表保留但不生效）"
            ws = _collect_warnings()
            if ws:
                self.app._append_info_ui(f"[简易位置] {_st}；已应用，但时间未首尾相接：" +
                                         "；".join(ws[:6]) + (" …" if len(ws) > 6 else ""))
            else:
                self.app._append_info_ui(f"[简易位置] {_st}；已应用 {len(dlg_segs)} 段（时间首尾相接）")
            _close()

        _btns = ttk.Frame(okf)
        _btns.pack(anchor=tk.CENTER)
        ttk.Button(_btns, text="确定", command=_on_ok, width=10).pack(side=tk.LEFT, padx=3)
        ttk.Button(_btns, text="取消", command=_close, width=10).pack(side=tk.LEFT, padx=3)

        _refresh()
        center_window(win, 900, 440)
        win.deiconify()
        win.grab_set()
        win.wait_window()

    def auto_detect_crop(self):
        input_file = getattr(self, 'current_file', None)
        if not input_file or not os.path.exists(input_file):
            # 2026-09-23：同 open_crop_editor，只有转换页语境才兜底到转换页输入文件
            if getattr(self, "_context", "convert") == "convert":
                input_file = self.app.input_file.get().strip()
        if alert_if(not input_file or not os.path.exists(input_file), "错误", "请先选择一个有效的输入文件", 'error'):
            return
    
        ffmpeg = self.app.ffmpeg_cmd
        if alert_if(not ffmpeg, "错误", "未找到 ffmpeg，无法检测黑边", 'error'):
            return
    
        try:
            frames = int(self.crop_detect_frames.get())
            round_val = int(self.crop_detect_round.get())
        except ValueError:
            messagebox.showerror("错误", "分析帧数和 round 必须为整数")
            return
    
        # ---- 获取截取起始时间 ----
        start_sec = 0.0
        # 优先使用可视化裁剪窗口传入的时间
        if hasattr(self, '_visual_crop_start_time') and self._visual_crop_start_time is not None:
            start_sec = self._visual_crop_start_time
            # 用完即清理，避免影响其他调用
            self._visual_crop_start_time = None
        else:
            # 原有的优先级逻辑（回调 -> 覆盖设置 -> 轨道 -> 主界面）
            if self.get_trim_settings_callback is not None:
                trim_settings = self.get_trim_settings_callback()
                if trim_settings.get("trim_enabled", False):
                    start_str = trim_settings.get("trim_start", "").strip()
                    if start_str:
                        sec = time_to_seconds(start_str)
                        if sec is not None:
                            start_sec = sec
            elif self.override_settings is not None:
                if self.override_settings.get("trim_enabled", False):
                    start_str = self.override_settings.get("trim_start", "").strip()
                    if start_str:
                        sec = time_to_seconds(start_str)
                        if sec is not None:
                            start_sec = sec
            elif self.current_track is not None:
                enc = self.current_track.enc_settings
                if enc.get("trim_enabled", False):
                    start_str = enc.get("trim_start", "").strip()
                    if start_str:
                        sec = time_to_seconds(start_str)
                        if sec is not None:
                            start_sec = sec
            elif getattr(self, "_context", "convert") == "convert":
                # 2026-09-23 收紧：同 open_crop_editor——主界面截取仅转换页语境可用，
                # 封装页/水印/队列不再跨页兜底转换页截取设置，非转换页从 0 秒检测。
                if self.app.trim_frame.trim_enabled.get():
                    start_str = self.app.trim_frame.trim_start.get().strip()
                    if start_str:
                        sec = time_to_seconds(start_str)
                        if sec is not None:
                            start_sec = sec
    
        # 禁用按钮防止重复点击
        for child in self.winfo_children():
            if isinstance(child, ttk.Button) and "自动检测黑边" in child.cget("text"):
                child.config(state=tk.DISABLED)
                break
    
        def detect():
            try:
                cmd = [ffmpeg, "-i", input_file]
                # 如果起始时间 > 0，添加 -ss 快速跳转
                if start_sec > 0:
                    cmd.insert(1, "-ss")
                    cmd.insert(2, _ffsec(start_sec))
                # 添加 cropdetect 参数
                cmd.extend([
                    "-vframes", str(frames),
                    "-vf", f"cropdetect=limit=0.1:round={round_val}:skip=0",  # skip=0 因为已用 -ss 跳转
                    "-f", "null", "-"
                ])
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    text=True, encoding='utf-8', errors='replace',
                    creationflags=_ffmpeg_spawn_flags()
                )
                _unused, stderr = proc.communicate(timeout=15)
    
                pattern = re.compile(r'crop=(\d+):(\d+):(\d+):(\d+)')
                matches = pattern.findall(stderr)
                if not matches:
                    self.app._append_info_ui("[黑边检测] 未检测到明显的黑边，请手动调整。")
                    return
    
                w, h, x, y = matches[-1]
                self.app.root.after(0, lambda: self.crop_width.set(w))
                self.app.root.after(0, lambda: self.crop_height.set(h))
                self.app.root.after(0, lambda: self.crop_left.set(x))
                self.app.root.after(0, lambda: self.crop_top.set(y))
                self.app.root.after(0, lambda: self.crop_enabled.set(True))
                self.app._append_info_ui(f"[黑边检测] 推荐裁剪参数: crop={w}:{h}:{x}:{y}，已自动填入并启用裁剪。")
            except subprocess.TimeoutExpired:
                self.app._append_info_ui("[黑边检测] 检测超时，请检查 ffmpeg 是否正常。")
            except Exception as e:
                self.app._append_info_ui(f"[黑边检测] 出错: {e}")
            finally:
                def enable_btn():
                    for child in self.winfo_children():
                        if isinstance(child, ttk.Button) and "自动检测黑边" in child.cget("text"):
                            child.config(state=tk.NORMAL)
                            break
                self.app.root.after(0, enable_btn)
    
        threading.Thread(target=detect, daemon=True).start()

    def _open_subtitle_dialog(self):
        """烧录字幕设置弹窗（2026-08-28 按钮化）：勾选启用 + 字幕文件 + 字符编码。
        控件用弹窗内临时变量，点「确定」才写回 self.subtitle_*（取消丢弃）。"""
        if getattr(self, "_sub_dialog", None) is not None and self._sub_dialog.winfo_exists():
            self._sub_dialog.lift()
            self._sub_dialog.focus_set()
            return
        win = tk.Toplevel(self)
        self._sub_dialog = win
        win.title("烧录字幕")
        win.transient(self.winfo_toplevel())
        win.resizable(False, False)
        win.withdraw()  # center_window 前提：先隐藏，定位后 deiconify 显示（避免左上角闪现）

        _en = tk.BooleanVar(value=self.subtitle_enabled.get())
        _path = tk.StringVar(value=self.subtitle_path.get())
        _charset = tk.StringVar(value=self.subtitle_charset.get())

        frm = ttk.Frame(win, padding=8)
        frm.pack(fill=tk.X)  # 不 expand：宽度由内容决定，紧凑（不用 grid 避免列拉伸隔太开）

        def _dlg_toggle():
            st = tk.NORMAL if _en.get() else tk.DISABLED
            entry.config(state=st)
            browse.config(state=st)
            charset_cb.config(state="readonly" if _en.get() else "disabled")

        def _dlg_browse():
            if not _en.get():
                _en.set(True)
                _dlg_toggle()
            path = filedialog.askopenfilename(
                title="选择字幕文件", parent=win,
                filetypes=[("字幕文件", "*.srt *.ass *.ssa *.vtt")])
            if path:
                _path.set(normalize_path(path))

        def _dlg_ok():
            self.subtitle_enabled.set(_en.get())
            self.subtitle_path.set(_path.get())
            self.subtitle_charset.set(_charset.get())
            if hasattr(self, '_preview_callback') and self._preview_callback:
                self._preview_callback()
            win.destroy()
            self._sub_dialog = None

        def _dlg_close():
            win.destroy()
            self._sub_dialog = None

        # 布局：pack 分层（每行一个水平 Frame 紧凑排布），不用 grid——控件少时 grid 列会
        # 把间距拉开、提示文字把窗口撑很宽显示不全。
        chk = ttk.Checkbutton(frm, text="启用烧录字幕", variable=_en, command=_dlg_toggle)
        chk.pack(anchor=tk.W)

        r1 = ttk.Frame(frm)
        r1.pack(fill=tk.X, pady=(6, 2))
        ttk.Label(r1, text="字幕文件:").pack(side=tk.LEFT)
        entry = ttk.Entry(r1, textvariable=_path, width=30)
        entry.pack(side=tk.LEFT, padx=(6, 4))
        browse = ttk.Button(r1, text="浏览…", command=_dlg_browse, width=8)
        browse.pack(side=tk.LEFT)

        r2 = ttk.Frame(frm)
        r2.pack(fill=tk.X, pady=(2, 6))
        ttk.Label(r2, text="字符编码:").pack(side=tk.LEFT)
        charset_cb = ttk.Combobox(r2, textvariable=_charset, state="readonly", width=10,
                                  values=("auto", "utf-8", "gb18030", "gbk", "big5"))
        charset_cb.pack(side=tk.LEFT, padx=(6, 8))
        ttk.Label(r2, text="中文记事本 SRT 选 GBK/GB18030", foreground="gray").pack(side=tk.LEFT)

        _btn_row = ttk.Frame(frm)
        _btn_row.pack(fill=tk.X, pady=(8, 0))
        ttk.Button(_btn_row, text="取消", command=_dlg_close, width=8).pack(side=tk.RIGHT)
        ttk.Button(_btn_row, text="确定", command=_dlg_ok, width=8).pack(side=tk.RIGHT, padx=(0, 6))

        win.protocol("WM_DELETE_WINDOW", _dlg_close)
        _dlg_toggle()
        center_window(win, 400, 160)  # 屏幕居中显示（紧凑尺寸）

    def get_settings(self):
        return {
            "frame_rate_type": self.frame_rate_type.get(),
            "frame_rate_custom": self.frame_rate_custom.get(),
            "gop_size": self.gop_size.get().strip(),
            "keyint_min": self.keyint_min.get().strip(),
            "frame_sync": (self.frame_sync.get().strip() or "auto"),
            "scale_enabled": self.scale_enabled.get(),
            "scale_width": self.scale_width.get(),
            "scale_height": self.scale_height.get(),
            "scale_method": self.scale_method.get(),
            "crop_enabled": self.crop_enabled.get(),
            "crop_left": self.crop_left.get(),
            "crop_top": self.crop_top.get(),
            "crop_width": self.crop_width.get(),
            "crop_height": self.crop_height.get(),
            # 简易位置：深拷贝导出，防止调用方（预设/队列）改副本串扰本对象（同 move_waypoints 坑）
            "crop_pos_segments": copy.deepcopy(self.crop_pos_segments),
            # 简易位置总开关：显式启用/禁用（2026-08-30）
            "crop_pos_enabled": self.crop_pos_enabled.get(),
            # 画布模式：深拷贝导出，与 crop_pos_segments 对称（防共享引用被外部篡改）
            "canvas_mode": self.canvas_mode.get(),
            "canvas_segments": copy.deepcopy(self.canvas_segments),
            "rotate": self.rotate.get(),
            "vflip": self.vflip.get(),
            "hflip": self.hflip.get(),
            "speed_enabled": self.speed_enabled.get(),
            "speed_factor": self.speed_factor.get(),
            "deinterlace_filter": self.deinterlace_filter.get(),
            "pix_fmt_enabled": self.pix_fmt_enabled.get(),
            "pix_fmt": self.pix_fmt.get(),
            "subtitle_enabled": self.subtitle_enabled.get(),
            "subtitle_path": self.subtitle_path.get(),
            "subtitle_charset": self.subtitle_charset.get(),
            "reverse_enabled": self.reverse_enabled.get(),
            "blur_enabled": self._blur_enabled.get(),
            "blur_type": self._blur_type.get(),
            "blur_strength": self._blur_strength.get(),
            "blur_x": self._blur_x.get(),
            "blur_y": self._blur_y.get(),
            "blur_w": self._blur_w.get(),
            "blur_h": self._blur_h.get(),
            "blur_region_only": self._blur_region_only.get(),
            # 多区域列表（2026-08-26）：有列表用列表，否则用旧单键迁移（旧预设兼容）
            "blur_items": self._blur_items or self._migrate_blur_single(),
        }

    def _migrate_blur_single(self):
        """旧版单实例键 → 单元素列表（向后兼容迁移）。仅当 _blur_items 为空时调用。"""
        if not self._blur_enabled.get() and self._blur_type.get() in ("", "delogo") \
                and not self._blur_x.get() and not self._blur_w.get():
            return []
        return [{
            "enabled": self._blur_enabled.get(),
            "type": self._blur_type.get() or "delogo",
            "x": self._blur_x.get(),
            "y": self._blur_y.get(),
            "w": self._blur_w.get(),
            "h": self._blur_h.get(),
            "strength": self._blur_strength.get(),
            "region_only": self._blur_region_only.get(),
            "enable_start": "", "enable_end": "", "enable_cycle": "", "enable_show": "",
        }]

    def set_settings(self, settings):
        self.frame_rate_type.set(settings.get("frame_rate_type", "keep"))
        self.frame_rate_custom.set(settings.get("frame_rate_custom", "30"))
        self.gop_size.set(settings.get("gop_size", ""))
        self.keyint_min.set(settings.get("keyint_min", ""))
        self.frame_sync.set(settings.get("frame_sync", "auto") or "auto")
        self.scale_enabled.set(settings.get("scale_enabled", False))
        self.scale_width.set(settings.get("scale_width", ""))
        self.scale_height.set(settings.get("scale_height", ""))
        self.scale_method.set(settings.get("scale_method", "width"))
        self.crop_enabled.set(settings.get("crop_enabled", False))
        self.crop_left.set(settings.get("crop_left", "0"))
        self.crop_top.set(settings.get("crop_top", "0"))
        self.crop_width.set(settings.get("crop_width", "iw/2"))
        self.crop_height.set(settings.get("crop_height", "ih"))
        # 简易位置：深拷贝导入（与导出对称），避免共享引用被外部篡改
        _cps = settings.get("crop_pos_segments")
        self.crop_pos_segments = [dict(s) for s in _cps] if _cps else []
        # 简易位置总开关导入（与导出对称）
        self.crop_pos_enabled.set(settings.get("crop_pos_enabled", False))
        # 画布模式：深拷贝导入（与导出对称）
        self.canvas_mode.set(settings.get("canvas_mode", False))
        _ccs = settings.get("canvas_segments")
        self.canvas_segments = [dict(s) for s in _ccs] if _ccs else []
        self.rotate.set(settings.get("rotate", "none"))
        self.vflip.set(settings.get("vflip", False))
        self.hflip.set(settings.get("hflip", False))
        self.speed_enabled.set(settings.get("speed_enabled", False))
        self.speed_factor.set(settings.get("speed_factor", "1.0"))
        self.deinterlace_filter.set(normalize_deinterlace_filter(settings.get("deinterlace_filter", "none")))
        self.pix_fmt_enabled.set(settings.get("pix_fmt_enabled", True))
        self.pix_fmt.set(settings.get("pix_fmt", "yuv420p"))
        self.subtitle_enabled.set(settings.get("subtitle_enabled", False))
        self.subtitle_path.set(settings.get("subtitle_path", ""))
        self.subtitle_charset.set(settings.get("subtitle_charset", "auto") or "auto")
        self.reverse_enabled.set(settings.get("reverse_enabled", False))
        self._blur_enabled.set(settings.get("blur_enabled", False))
        self._blur_type.set(settings.get("blur_type", "delogo"))
        self._blur_strength.set(settings.get("blur_strength", "5"))
        self._blur_x.set(settings.get("blur_x", "0"))
        self._blur_y.set(settings.get("blur_y", "0"))
        self._blur_w.set(settings.get("blur_w", "100"))
        self._blur_h.set(settings.get("blur_h", "100"))
        self._blur_region_only.set(settings.get("blur_region_only", False))
        # 多区域列表：优先取列表；无列表则从旧单键迁移（兼容旧预设/旧快照）
        items = settings.get("blur_items")
        if items:
            self._blur_items = [dict(i) for i in items]
        elif (settings.get("blur_enabled") or settings.get("blur_x") or settings.get("blur_w")):
            self._blur_items = [{
                "enabled": settings.get("blur_enabled", False),
                "type": settings.get("blur_type", "delogo") or "delogo",
                "x": settings.get("blur_x", "0"),
                "y": settings.get("blur_y", "0"),
                "w": settings.get("blur_w", "100"),
                "h": settings.get("blur_h", "100"),
                "strength": settings.get("blur_strength", "5"),
                "region_only": settings.get("blur_region_only", False),
                "enable_start": settings.get("blur_enable_start", ""),
                "enable_end": settings.get("blur_enable_end", ""),
                "enable_cycle": settings.get("blur_enable_cycle", ""),
                "enable_show": settings.get("blur_enable_show", ""),
            }]
        else:
            self._blur_items = []


def _open_tw_position_editor_impl(app, tw, canvas_w, canvas_h, refresh_cb, parent_widget,
                                  ctx_file=None, ctx_settings=None, scope=None,
                                  main_offset=None, main_render_size=None):
    """文字水印位置编辑器公共实现（AdvancedFrame 转换页/队列 与 封装页共用）。

    - tw：要编辑的文字水印设置 dict（写回 overlay_x/overlay_y/font_size/rotate）
    - canvas_w/h：画布尺寸（调用方各自计算：转换页/队列/封装页主视频渲染尺寸）
    - refresh_cb：应用后的刷新回调（命令预览）
    - parent_widget：通用编辑器的宿主控件（AdvancedFrame 自身 / 文字水印对话框）
    - ctx_file/ctx_settings：背景帧语境主视频（2026-09-03 问题②③：队列=task.input+
      task.settings、封装页=主轨 file_path+enc_settings）；
      None → _resolve_editor_bg 按 scope 在本页内兜底（2026-09-23：转换页/封装页
      禁止互相兜底，本页没主视频=纯黑；封装页已有独立文字水印，「注入到封装页」已下线，
      两页不再互相掺）。绝不再无条件封装页优先。
    - main_offset/main_render_size：封装页 pad 时主视频内容在画布中的偏移与渲染尺寸。
      2026-09-23：此前封装页不传 → 画布已是 pad 尺寸、背景帧却被拉伸铺满 → 画面变形；
      与子视频位置编辑器（open_visual_overlay_editor）同款传参后主视频按自身尺寸摆放、
      pad 留黑区保持黑色。None=铺满画布（旧行为，转换页无 pad 功能）。
    """
    text = tw.get("text", "")
    fs = _opt_int(tw.get("font_size", 48), 48)
    # 内容盒估算（2026-09-03 统一为 estimate_text_size，与渲染端 build_text_watermark_filtergraph
    # 同源）：渲染端内容盒 = estimate + 2×pad(8) → 编辑器矩形必须含 pad，否则
    # 「编辑时旋转中心看着居中、渲染后文字中心偏移」；旧 0.7/字符×1.3fs 估算偏宽偏矮。
    # 2026-09-25：与渲染端统一用 _tw_effective_text —— multiline 开保留换行（高盒）、
    # 关拼成一行（矮盒），编辑器矩形与最终渲染严格一致。
    _eff_text = _tw_effective_text(tw)
    _est_w, _est_h = estimate_text_size(_eff_text, "", fs)
    wm_w = _est_w + 16
    wm_h = _est_h + 16
    x_var = tk.StringVar(value=tw.get("overlay_x", "10"))
    y_var = tk.StringVar(value=tw.get("overlay_y", "10"))
    def on_apply(nx, ny, nw, nh, ncw, nch):
        x_var.set(str(nx))
        y_var.set(str(ny))
        tw["overlay_x"] = str(nx)
        tw["overlay_y"] = str(ny)
        # 矩形高度反推字体大小（wm_h = est_th+16 = fs*1.2×行数 + 16 → fs=(nh−16)/(1.2×行数)；
        # 单行即 (nh−16)/1.2，2026-09-03 与 estimate_text_size 行高 1.2fs 对齐）
        if nh > 0:
            _nlines = max(1, _eff_text.count("\n") + 1)
            new_fs = max(8, int(round((nh - 16) / (1.2 * _nlines))))
            old_fs = int(tw.get("font_size", 48))
            if new_fs != old_fs:
                tw["font_size"] = new_fs
                app._append_info_ui(f"[文字水印] 字体大小已更新: {old_fs} → {new_fs}")
        if refresh_cb:
            refresh_cb()
        app._append_info_ui(f"[文字水印] 位置已设置: ({nx}, {ny})")
    title = "可视化编辑文字水印位置"
    # 文字水印静态旋转角度（-180..180），旋转后为 hypot 正方形包围盒
    _tw_ra = _opt_float(tw.get("rotate", 0) or 0, 0.0)
    _tw_spin = bool(tw.get("spin_enabled", False))
    # 定位语义（2026-08-26 统一）：overlay_x/y 的 w/h 恒为内容盒（wm_w/wm_h），
    # 旋转时 d×d 正方形由编辑器内部自动居中（锚点=内容盒左上角），
    # 不再按正方形包围盒 d 求值（否则初始显示偏左上 (d-w)/2）。
    # 初始坐标：safe_eval_expr 可能返回 0（合法位置），必须用 None 判断而非 `or 10`，
    # 否则 y=0 会被 `0 or 10` 顶成 10，看起来「y 没返回数值」。
    _init_x = safe_eval_expr(x_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})
    _init_y = safe_eval_expr(y_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})

    def apply_tw_angle(new_angle):
        tw["rotate"] = float(new_angle or 0.0)
        # 同步回写文字水印对话框内的「旋转角度」数值框（对话框实例存于 app.text_wm_dialog）
        _dlg = getattr(app, "text_wm_dialog", None)
        if _dlg is not None:
            with suppress(Exception):
                if _dlg.winfo_exists():
                    _dlg.rotate_var.set(float(new_angle or 0.0))
        if refresh_cb:
            refresh_cb()
        app._append_info_ui(f"[文字水印] 旋转角度已更新: {new_angle}°")

    # ---- 背景帧源（2026-09-03 统一）：显式 ctx（队列 task / 封装页主轨）→ 按 scope
    # ---- 在本页内兜底（2026-09-23：转换页/封装页禁止互相兜底，本页没主视频=纯黑）。
    # ---- 旧代码无条件「封装页 merge_video 优先」是问题②③根因（转换页/队列文字水印
    # ---- 第一顺位错取封装页主视频）。
    _bg_file, _main_settings = _resolve_editor_bg(app, ctx_file, ctx_settings, scope=scope)
    _bg_filter = _main_bg_pre_filter(_main_settings) if _main_settings else None

    app._generic_overlay_editor(
        parent_widget, canvas_w, canvas_h,
        10 if _init_x is None else _init_x,
        10 if _init_y is None else _init_y,
        wm_w, wm_h, on_apply, title, None,
        bg_draw_func=None, rect_label='文字水印',
        min_visible_pixels=0, show_scale_tip=False,
        rotate_angle=_tw_ra, angle_cb=apply_tw_angle,
        show_nudge=False,   # 文字水印位置编辑器：看不到画布，无微调按钮
        main_video_file=_bg_file or None,   # 背景帧=实际主视频当前帧
        main_offset=main_offset,            # pad 时主视频内容偏移（超出画布部分留黑）
        main_render_size=main_render_size,  # pad 时主视频自身渲染尺寸（None=铺满画布）
        bg_pre_filter=_bg_filter)           # 主视频 crop/rotate（防背景帧变形）


class TextWatermarkDialog(tk.Toplevel):
    """文字水印设置窗口（drawtext）

    settings_target: 要编辑的文字水印设置 dict。默认 None → 编辑 app.text_watermark_settings
        （主界面全局）。队列任务编辑必须传入任务自己的 text_watermark dict，
        否则「队列里改文字水印」会改到转换主界面、且对任务不生效。
    refresh_cb: 设置变化后刷新命令预览的回调。默认 None → 用主界面 adv_frame 的回调；
        队列任务编辑传入任务编辑窗口的 update_preview。
    """
    def __init__(self, parent, app, settings_target=None, refresh_cb=None,
                 settings_container=None, position_editor_cb=None, canvas_file=None,
                 canvas_settings=None, canvas_scope=None):
        super().__init__(parent)
        self.withdraw()
        self.app = app
        self.parent = parent
        # 上下文主视频（叠加层时间线基准，时间预览/轨迹/位置编辑器共用）：
        # 队列任务编辑=task.input、封装页=merge_video/主轨道；None=回退转换页 app.input_file。
        self.canvas_file = (canvas_file or "").strip()
        # 上下文主视频设置（画布渲染/背景帧 crop+rotate 预处理同源，问题④）：队列=task.settings、
        # 封装=主轨 enc_settings；None → 轨迹编辑器回退转换页 get_current_settings。
        self.canvas_settings = canvas_settings
        # 宿主页作用域（2026-09-23）：'convert'/'merge' —— canvas_file 为空时只在本页
        # 内找主视频，绝不用另一页的主视频兜底抽帧（本页没主视频=纯黑背景帧）。
        # None → 按 'convert' 处理（旧调用点行为）。
        self.canvas_scope = canvas_scope
        self.settings = settings_target if settings_target is not None else app.text_watermark_settings
        self.tw_refresh = refresh_cb
        # 位置编辑器回调（封装页独立文字水印入口传入）：None → 委托 parent._open_text_wm_position_editor
        self._pos_editor_cb = position_editor_cb
        # 多文字水印容器（2026-08-26）：None → 主界面（app.text_watermark_items）；
        # 队列任务编辑 → task.settings（写 text_watermark_items）；封装页 → self._merge_tw dict
        self.items_container = settings_container if settings_container is not None else app
        # 多实例列表：优先容器.text_watermark_items，空则迁移当前单条。
        # ⚠️ 2026-08-26 修复：主界面容器是 App 对象（非 dict），原来只对 dict 容器读列表，
        #   导致「保存后重开只剩最开始那条空白项」——列表写进了 app.text_watermark_items
        #   却从未读回。这里统一支持 dict 与对象两种容器。
        if isinstance(self.items_container, dict):
            _items = self.items_container.get("text_watermark_items")
        else:
            _items = getattr(self.items_container, "text_watermark_items", None)
        if not _items:
            _tw = self.settings
            _items = [dict(_tw)] if (_tw.get("enabled") or _tw.get("text")) else [dict(_tw)]
        self.items = [copy.deepcopy(i) for i in _items]
        self.settings = self.items[0] if self.items else {}
        self._tw_last_sel = None
        # 对话框内自包含撤销/重做栈（关窗即弃，不污染主窗口历史）；仅覆盖水印项列表增删移
        self._tw_undo_stack = []
        self._tw_redo_stack = []
        self._tw_pending_before = None
        # 2026-08-26：_load_tw_form 期间置守卫，避免 var.set() → trace(_tw_sync_x 等)
        # → _refresh_tw_tree → selection 事件 → _load_tw_form 递归
        self._tw_loading = False
        # 保存到主应用，便于位置编辑器「应用」时同步回写本窗口的旋转角度数值框
        with suppress(Exception):
            app.text_wm_dialog = self
        self.title("文字水印")
        self.transient(parent)
        self.grab_set()
        self.resizable(False, False)

        # 2026-09-19：新增「倒计时（滚动小窗）」控件组（约 +120px），780 → 905
        width, height = 500, 905
        center_window(self, width, height)

        self.create_widgets()
        self._refresh_tw_tree()
        # 默认选中第 0 项：表单初始即对应 items[0]，且 _tw_last_sel 有值，
        # 之后「添加/切换/确定」能把表单编辑正确收集回列表（否则编辑内容丢失）
        if self.items:
            with suppress(Exception):
                self.tw_tree.selection_set("0")
            self._tw_last_sel = 0
        self.deiconify()

    def create_widgets(self):
        from tkinter.colorchooser import askcolor
        main = ttk.Frame(self, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        s = self.settings

        # ---- 多文字水印列表（2026-08-26：可添加多个文字水印）----
        list_frame = ttk.LabelFrame(main, text="多条文字水印（选中项编辑下方参数）", padding="3")
        list_frame.grid(row=0, column=0, columnspan=4, sticky="ew", pady=3)
        self.tw_tree = ttk.Treeview(list_frame, columns=("en", "txt", "pos"), show="headings", height=3)
        self.tw_tree.heading("en", text="启用")
        self.tw_tree.heading("txt", text="文字内容")
        self.tw_tree.heading("pos", text="位置")
        self.tw_tree.column("en", width=42, anchor="center")
        self.tw_tree.column("txt", width=220)
        self.tw_tree.column("pos", width=150)
        self.tw_tree.pack(fill=tk.X, padx=3, pady=(3, 1))
        self.tw_tree.bind("<<TreeviewSelect>>", self._on_tw_select)
        self.tw_tree.bind("<ButtonRelease-1>", self._on_tw_click)
        self.tw_tree.bind("<Button-1>", self._on_tw_blank_click)  # 点空白取消选中（未选中→预览回溯全部）
        tw_btn = ttk.Frame(list_frame)
        tw_btn.pack(fill=tk.X, padx=3, pady=(0, 3))
        self._tw_undo_btn = ttk.Button(tw_btn, text="撤销", state="disabled", width=5, command=self._tw_do_undo)
        self._tw_undo_btn.pack(side=tk.LEFT, padx=1)
        self._tw_redo_btn = ttk.Button(tw_btn, text="重做", state="disabled", width=5, command=self._tw_do_redo)
        self._tw_redo_btn.pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text="添加", width=5, command=self._add_tw_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text="删除", width=5, command=self._del_tw_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text="上移", width=5, command=lambda: self._move_tw_item(-1)).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text="下移", width=5, command=lambda: self._move_tw_item(1)).pack(side=tk.LEFT, padx=1)
        ttk.Label(tw_btn, text="点「启用」列可切换", foreground="gray").pack(side=tk.LEFT, padx=8)

        # ---- 启用（当前项）----
        self.enabled_var = tk.BooleanVar(value=s.get("enabled", False))
        ttk.Checkbutton(main, text="启用文字水印", variable=self.enabled_var).grid(
            row=1, column=0, sticky="w", pady=5)

        # ---- 基础参数区（文字内容 → 描边颜色）----
        # 2026-09-04 布局改造：这一整段原为 grid 单行排布，但 grid 的列宽由该列「最宽控件」
        # 决定——文字内容输入框(width=28)与透明度滑块(length=150)会把 col1 撑到最宽，
        # 于是字号/颜色这类短控件右侧留下一大片空白，视觉上对不齐。
        # 现改为「每行一个 Frame + 行内 pack」：间隔完全由 padx 控制，标签定宽对齐，
        # 与下方「显示时段」seg_frame 的既有做法（8952 行注释）保持一致。
        # ⚠️ 整段占用 row=2 一个格子、内部自行 pack，故下方 row=9 起的 14 处行号无需改动。
        basic = ttk.Frame(main)
        basic.grid(row=2, column=0, columnspan=4, sticky="ew")
        # 标签统一宽度（英文字符单位；最长标签「描边颜色:」约为 11），保证控件左边缘对齐
        LBL_W = 12

        def _tw_row():
            """建一个参数行（行内 pack，规避 grid 列宽被最长控件撑大导致的列间空白）"""
            _f = ttk.Frame(basic)
            _f.pack(fill=tk.X, pady=3)
            return _f

        # ---- 文字内容 ----
        _r = _tw_row()
        ttk.Label(_r, text="文字内容:", width=LBL_W, anchor="w").pack(side=tk.LEFT)
        self.text_var = tk.StringVar(value=s.get("text", ""))
        text_entry = ttk.Entry(_r, textvariable=self.text_var, width=30)
        text_entry.pack(side=tk.LEFT, padx=(0, 5))
        # 富文本（2026-09-19）：多行编辑入口。普通模式把多行拼成一行显示；
        # 倒计时模式按行拆分逐行排版（见 countdown_lines / build_tw_countdown_subgraph）。
        ttk.Button(_r, text="富文本", width=6,
                   command=self._open_rich_text_editor).pack(side=tk.LEFT, padx=(0, 4))
        # 富文本换行（2026-09-25）：勾选后渲染保留换行（竖排 / @字体式），不再拼成一行；
        # 与「启用倒计时」互斥（见 _tw_sync_multiline / _tw_sync_countdown）。
        self.multiline_var = tk.BooleanVar(value=bool(s.get("multiline", False)))

        def _tw_sync_multiline(*_a):
            if getattr(self, "_tw_loading", False):
                return
            st = self.settings
            _on = bool(self.multiline_var.get())
            st["multiline"] = _on
            if _on and getattr(self, "cd_enabled_var", None) is not None and self.cd_enabled_var.get():
                # 与倒计时互斥：勾选富文本换行 → 关掉倒计时
                self.cd_enabled_var.set(False)
                st["countdown_enabled"] = False
            self._sync_item_to_container()
            self._refresh_tw_tree()
            self._refresh()

        ttk.Checkbutton(_r, text="富文本换行", variable=self.multiline_var,
                        command=_tw_sync_multiline).pack(side=tk.LEFT)
        self.multiline_var.trace_add("write", _tw_sync_multiline)

        # ---- 字体（内置中文在前 → 常用英文 → 系统扫描字体，2026-09-04）----
        _r = _tw_row()
        ttk.Label(_r, text="字体:", width=LBL_W, anchor="w").pack(side=tk.LEFT)
        self.font_var = tk.StringVar(value=s.get("font_name", "微软雅黑"))
        try:
            _font_values = merged_font_names()      # 触发/复用字体缓存（~30ms，无感）
        except Exception:
            _font_values = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
        self.font_combo = ttk.Combobox(_r, textvariable=self.font_var, state="readonly",
                                       values=_font_values, width=18)
        self.font_combo.pack(side=tk.LEFT, padx=(0, 5))
        # 原选中值若不在新列表（极端情况：缓存重建后名称变化），回落到内置第一项
        if self.font_var.get() not in _font_values:
            self.font_var.set(_font_values[0] if _font_values else "微软雅黑")

        # 「检测本地」：强制重扫系统字体并刷新上方下拉（正常情况无需点——
        # 启动时已自动扫描并缓存；装了新字体后下拉没出现时才需要。扫描 ~30ms）。
        def _rescan_system_fonts():
            try:
                _lst = force_rescan_fonts()
            except Exception as _e:
                _lst = []
            _names = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
            _seen = set(_names)
            for _f in _lst:
                if _f.get("name") not in _seen:
                    _seen.add(_f["name"])
                    _names.append(_f["name"])
            self.font_combo.config(values=_names)
            if self.font_var.get() not in _names:
                self.font_var.set(_names[0] if _names else "微软雅黑")
            messagebox.showinfo("检测本地字体",
                                f"已重新检测系统字体，共 {len(_names)} 个可选项。",
                                parent=self)

        ttk.Button(_r, text="检测本地", command=_rescan_system_fonts,
                   width=8).pack(side=tk.LEFT)
        ToolTip(_r, "重新扫描 C:\\Windows\\Fonts 下的全部字体并刷新上方下拉。\n"
                "安装新字体后下拉未出现时点一下即可（无需重启程序）。",
                wraplength=340)

        # ---- 外部字体文件（留空则用上方「字体」下拉的系统字体）----
        # 2026-09-04：Entry → Combobox，下拉=最近用过的外部字体路径（来自
        # fonts_cache.json 的 recent_external），历史路径点选即填，也可继续手改。
        _r = _tw_row()
        _lbltt5 = ttk.Label(_r, text="外部字体:", width=LBL_W, anchor="w")
        _lbltt5.pack(side=tk.LEFT)
        # 仅回填「用户显式指定」的外部字体；不能用 font_path（它含系统字体解析结果，
        # 回填后编辑框非空会覆盖后续所有下拉选择）。详见 resolve_ext_font_path。
        self.ext_font_var = tk.StringVar(value=resolve_ext_font_path(s))
        try:
            _recent = get_recent_external_fonts()
        except Exception:
            _recent = []
        self.ext_font_combo = ttk.Combobox(_r, textvariable=self.ext_font_var,
                                           values=_recent, width=30)
        self.ext_font_combo.pack(side=tk.LEFT, padx=(0, 5))

        def _browse_ext_font():
            _p = filedialog.askopenfilename(
                title="选择字体文件",
                filetypes=[("字体文件", "*.ttf *.ttc *.otf"), ("所有文件", "*.*")],
                parent=self)
            if _p:
                self.ext_font_var.set(_p)

        ttk.Button(_r, text="浏览", command=_browse_ext_font, width=6).pack(side=tk.LEFT)

        def _clear_ext_font():
            self.ext_font_var.set("")

