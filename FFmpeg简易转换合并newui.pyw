    except (ValueError, TypeError):
        return None


def release_grab(root):
    """释放 root 当前持有的 grab（本窗 grab 会吃掉次级窗口焦点，开次级窗前必调）。

    抽取自 16 处同构体（2026-10-01）：
    try: g = root.grab_current(); if g is not None: g.grab_release()
    except Exception: pass
    """
    try:
        g = root.grab_current()
        if g is not None:
            g.grab_release()
    except Exception:
        pass


def loudnorm_i_norm(raw, default=-23):
    """响度标准化目标值（loudnorm I）防呆解析 → (ok, int)。

    防呆口径（2026-09-26 用户要求，开放「标准」编辑框后配套）：
    · 空 / 非数字 → (False, default)（调用方负责日志提示）
    · 正数按负值处理：输入 16 = 目标 -16（响度目标恒为负，用户常省负号）
    · clamp 到 loudnorm 合法域 [-70, -5]（ffmpeg 对 I 的参数范围）
    """
    v = _opt_float(raw, None)
    if v is None:
        return False, default
    if v > 0:
        v = -v
    if v < -70:
        v = -70
    elif v > -5:
        v = -5
    return True, int(v)


def _seg_num(s, k, d=0.0):
    """段 dict 安全取数值字段：缺键/非法 → d（照抄原局部实现，含 0 or d 行为）。"""
    try:
        return float(s.get(k, d) or d)
    except (ValueError, TypeError):
        return d


# 2026-09-10：遮罩轨迹画布尺寸的【兜底值】。
# 正常情况画布 = 打开遮罩窗口时的**子视频真实尺寸**，并随航点一起存进 settings
# （mask_traj_canvas_w / mask_traj_canvas_h）——航点与画布必须同坐标系，否则重开工程会错位。
# 只有探不到子视频尺寸时才用这里兜底。滤镜侧按存的画布尺寸等比还原到实际帧尺寸
# （x*W/cvw, y*H/cvh），所以行程比例恒正确、与素材分辨率解耦。
MASK_TRAJ_CANVAS_W = 1280
MASK_TRAJ_CANVAS_H = 720


MIN_SEG_DUR = 0.01
# ↑段被前行**完全覆盖**时的兜底时长：这种段砍完只剩 0 秒，而 0 时长的选择器（gte*lt）
# 恒为 0 → 该段彻底不出现、行也白留。故起点顶到前行结束、给一个极小可见时长。


def clamp_seg_overlaps(segs, dur_default=1.0, min_dur=MIN_SEG_DUR):
    """轨迹段「首尾相接」规范化：后一段若与前一段时间交叉，**砍掉它俩重叠的那一段**。

    就地修改 segs，返回改动清单 [(idx, old_start, old_dur, new_start, new_dur)]（无交叉时 []）。

    ⚠️ 必须「减时长」而不是「只把起点后挪」（2026-10-01 用户裁决）：
    只后挪起点、时长不变的话，这一段的**结束时间也跟着后移** → 它又和下一段交叉 →
    逐个传下去，本来只错一条，连锁之后变成后面全错。减时长的做法是：

        砍掉的永远是它与前一行重叠的**那个开头**  →
        new_start = 前行结束； new_dur = 原结束 - 前行结束

    于是这一段的**结束时间保持不变**，它的收缩不会往下传，后续段只有在自己本来就交叉
    时才会被改（一次修一处，不产生连锁）。

    例外：整段被前行完全覆盖（原 end <= 前行 end）时已经无重叠可砍（砍完为 0），这时才
    把起点顶到前行结束、dur 钳到 min_dur（代价：这一行会往后挪一点点，最多 min_dur）。

    按 start 升序处理（不依赖列表显示顺序），但**不重排列表**——列表顺序是用户自己排的。
    dur<=0 按 dur_default 计（与 build_waypoint_expr / build_crop_pos_expr 的兜底一致）。

    为什么必须收敛：段时间在两套表达式里都是「互斥」前提，
      - WP 扁平累加 `"+".join(gte*lt*值)`：交叉时两项同时为 1 → **坐标/倍率/透明度逐项相加**
      - CB/SP 嵌套 if：交叉时后行**抢占**前行 → 前段被截断、位置跳变
    两者都是静默算错（不报错），2026-10-01 实测确认。交叉**不是功能**。
    """
    out = []
    if not segs:
        return out

    def _s(i):
        return _opt_float(segs[i].get("start"), 0.0)

    def _d(i):
        v = _opt_float(segs[i].get("dur"), dur_default)
        return v if v > 0 else dur_default

    prev_end = None
    for i in sorted(range(len(segs)), key=_s):
        s0 = _s(i)
        d0 = _d(i)
        if prev_end is not None and s0 < prev_end - 1e-9:
            nd = s0 + d0 - prev_end          # 砍掉开头与前一行重叠的部分，终点保持不变
            if nd <= 1e-9:                   # 整段被前一行吞掉：无重叠可砍
                nd = min_dur
            ns = prev_end
            segs[i]["start"] = ns
            segs[i]["dur"] = nd
            out.append((i, s0, d0, ns, nd))
            s0, d0 = ns, nd
        prev_end = (s0 + d0) if prev_end is None else max(prev_end, s0 + d0)
    return out


def report_seg_clamp(tag, trims, app, idx_map=None):
    """把 clamp_seg_overlaps 的改动清单写成**一行信息栏日志**（不弹窗——用户明确要求
    设置过程中不反复提示，只在确定时告知一次）。

    idx_map: 段下标 → 原始列表下标（调用方若先过滤掉了终点行等非段成员，需传它才能
    报对用户看到的行号）。返回被改动的行数。
    """
    if not trims or app is None:
        return 0
    parts = []
    for i, old_s, old_d, new_s, new_d in trims[:6]:
        shown = (idx_map[i] + 1) if idx_map else (i + 1)
        if old_s + old_d <= new_s + 1e-9:      # 原结束时间没超过前行结束 = 整段被吞
            parts.append(f"第{shown}行 整段被前一行覆盖（起点 {old_s:.3f}s→{new_s:.3f}s、"
                         f"时长 {old_d:.3f}s→{new_d:.3f}s）")
        else:
            parts.append(f"第{shown}行 砍掉与前一行重叠的 {old_d - new_d:.3f}s"
                         f"（起点 {old_s:.3f}s→{new_s:.3f}s、时长 {old_d:.3f}s→{new_d:.3f}s，"
                         f"结束时间不变）")
    txt = f"[{tag}] 时间交叉已自动首尾相接：" + "；".join(parts) \
          + (" …" if len(trims) > 6 else "")
    with suppress(Exception):
        app._append_info_ui(txt)
    return len(trims)


def build_waypoint_expr(waypoints, sw="w", sh="h", spin_speed=60.0,
                        trim_start=0.0, speed_factor=1.0):
    """列表轨迹 → (x_expr, y_expr, spin_angle_expr, zoom_expr, alpha_expr) 或 (None, None, None, None, None)。

    - x/y：扁平累加（每段 gte/lt 选择互斥无空档），隐藏段/显示前/消失后 x=-100000 移出画面；
      插值天然在段内两端点之间，无需全局 clamp。
    - zoom_expr（2026-09-04）：每段 sa→sb 线性插值的**缩放倍率**（默认 1.0）。
      全部航点都是 1.0 时返回 None（调用方不挂 scale → 老工程行为完全不变）。
      ⓿ 消费端必须把它挂在 **rotate 之后**：实测 scale 逐帧变尺寸时若排在 rotate 前，
      rotate 的 ow/oh 锁死在首帧，放大后的内容会被裁掉。
    - spin_angle_expr：自旋转段分段 rotate angle（多段角度连续累计）；
      列表无自旋转段返回 None。定格(freeze)/保持后若末段是自旋转，角度继续累计（定格=旋转不停）。
    - 实测（C:/FFmpeg n8.x）：40 段/2400 字符（clip+隐藏+clamp 最坏形态）rc=0，
      15 条上限远低于崩溃点，无需再压缩。
    - 2026-08-29：段时间=主视频**原始时间** → 换算输出时间线（滤镜 t）：
      st_out=(start-trim)/speed，dur_out=dur/speed。预览 settings 已禁用 trim → 不换算。
    """
    wps = [w for w in (waypoints or []) if isinstance(w, dict)]
    if not wps:
        # ⚠️ 必须是 5 元组：调用方普遍取 [3]（缩放倍率）/[4]（透明度），返回 3 元组会在
        # move_mode=="waypoints" 但列表为空时抛 IndexError（2026-09-17 修）。
        return None, None, None, None, None
    # ---- 段时间换算（原始 → 输出时间线，统一入口 _timeline_convert）----
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    if _ts != 0.0 or _sp != 1.0:
        _wps = []
        for _w in wps:
            _w2 = dict(_w)
            try:
                _st2, _du2 = _timeline_convert(_w2.get("start", 0), _w2.get("dur", 0),
                                               _ts, _sp)
                _w2["start"] = _st2
                _w2["dur"] = _du2
            except (ValueError, TypeError):
                pass
            _wps.append(_w2)
        wps = _wps
    HIDE = -100000
    # 终点行 = mode=="end"（UI 限制只能最后一行）；其余全部按独立段处理（无需终点行兜底）
    segs = []
    end = None
    for w in wps:
        if (w.get("mode") or "move") == "end":
            end = w
        else:
            segs.append(w)
    if len(segs) > 1:
        # 2026-10-01：表达式层兜底收敛时间交叉（历史工程数据可能仍交叉，交叉=未定义行为）。
        # ⚠️ 必须先拷贝再 clamp —— 本函数是纯生成器，就地改会污染调用方的 list[dict]。
        segs = [dict(s) for s in segs]
        clamp_seg_overlaps(segs)
    if not segs:
        # 只有终点行（无任何段）：全程静态停在终点坐标
        _ex, _ey = (_wp_num(end, "xa"), _wp_num(end, "ya")) if end is not None else (0.0, 0.0)
        _ez = _wp_num(end, "sa", 1.0) if end is not None else 1.0
        if _ez <= 0:
            _ez = 0.01
        _ez_ret = f"{_ez:g}" if abs(_ez - 1.0) > 1e-9 else None
        return f"{_ex:g}", f"{_ey:g}", None, _ez_ret, None
    # ---- 独立终止点（首个 end_action != keep 的段） ----
    cut = None                # (t_cut, "hide"|"freeze", xb, yb, rb, sb)
    for s in segs:
        ea = (s.get("end_action") or "keep")
        if ea in ("hide", "freeze"):
            _t0 = _wp_num(s, "start")
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            cut = (_t0 + _d0, ea, _wp_num(s, "xb"), _wp_num(s, "yb"),
                   _wp_num(s, "rb", 0.0), _wp_num(s, "sb", 1.0), _wp_num(s, "ob", 1.0))
            break
    # ---- 截断后的有效段 ----
    valid = []
    for s in segs:
        if cut is not None and _wp_num(s, "start") >= cut[0] - 1e-9:
            break
        valid.append(s)
    if not valid:
        return None, None, None, None, None
    # t_end = 最后有效段结束
    _l0 = _wp_num(valid[-1], "start")
    _ld = _wp_num(valid[-1], "dur", 1.0)
    if _ld <= 0:
        _ld = 1.0
    t_end = _l0 + _ld

    # 段间空档（2026-10-01）：扁平累加在无段命中的区间会求和得 0 → 对象瞬移到画面左上角
    # （x/y 没有 zoom 那样的 max(0.01,…) 兜底）。故显式补「停在上一行结尾」的项；
    # 上一行是 hide 时延续 HIDE —— 否则隐藏的对象会在空档里复活到 (0,0)。
    _gaps = {}          # {valid 内前一段下标: (空档开始, 空档结束)}
    for _gi in range(len(valid) - 1):
        _gp = valid[_gi]
        _gd = _wp_num(_gp, "dur", 1.0)
        if _gd <= 0:
            _gd = 1.0
        _ge = _wp_num(_gp, "start") + _gd
        _gn = _wp_num(valid[_gi + 1], "start")
        if _gn > _ge + 1e-9:
            _gaps[_gi] = (_ge, _gn)

    pxs, pys = [], []
    _t_first = _wp_num(valid[0], "start")
    if _t_first > 0:
        pxs.append(f"lt(t,{_t_first:g})*{HIDE}")
        pys.append(f"lt(t,{_t_first:g})*{HIDE}")
    for _si, s in enumerate(valid):
        t0 = _wp_num(s, "start")
        d0 = _wp_num(s, "dur", 1.0)
        if d0 <= 0:
            d0 = 1.0
        t1 = t0 + d0
        mode = (s.get("mode") or "move")
        xa, ya = _wp_num(s, "xa"), _wp_num(s, "ya")
        xb, yb = _wp_num(s, "xb"), _wp_num(s, "yb")
        sel = f"gte(t,{t0:g})*lt(t,{t1:g})"
        if mode == "hide":
            pxs.append(f"{sel}*{HIDE}")
            pys.append(f"{sel}*{HIDE}")
        else:
            pxs.append(f"{sel}*({xa:g}+({xb - xa:g})*(t-{t0:g})/{d0:g})")
            pys.append(f"{sel}*({ya:g}+({yb - ya:g})*(t-{t0:g})/{d0:g})")
        if _si in _gaps:                      # 空档：停在上一行结尾（或延续隐藏）
            _gs = f"gte(t,{_gaps[_si][0]:g})*lt(t,{_gaps[_si][1]:g})"
            _gx = HIDE if mode == "hide" else xb
            _gy = HIDE if mode == "hide" else yb
            pxs.append(f"{_gs}*{_gx:g}")
            pys.append(f"{_gs}*{_gy:g}")
    # ---- 尾部处置（cut 优先；无 cut 时：终点行 / 末段消失 / 停在末段 B） ----
    if cut is not None:
        t_cut, _ea, _fx, _fy, _frb, _fz, _fob = cut
        if _ea == "freeze":
            pxs.append(f"gte(t,{t_cut:g})*{_fx:g}")
            pys.append(f"gte(t,{t_cut:g})*{_fy:g}")
        else:
            pxs.append(f"gte(t,{t_cut:g})*{HIDE}")
            pys.append(f"gte(t,{t_cut:g})*{HIDE}")
    else:
        _lea = (valid[-1].get("end_action") or "keep")
        if _lea == "hide":
            pxs.append(f"gte(t,{t_end:g})*{HIDE}")
            pys.append(f"gte(t,{t_end:g})*{HIDE}")
        elif end is not None:
            pxs.append(f"gte(t,{t_end:g})*{_wp_num(end, 'xa'):g}")
            pys.append(f"gte(t,{t_end:g})*{_wp_num(end, 'ya'):g}")
        else:
            pxs.append(f"gte(t,{t_end:g})*{_wp_num(valid[-1], 'xb'):g}")
            pys.append(f"gte(t,{t_end:g})*{_wp_num(valid[-1], 'yb'):g}")
    x_expr = "+".join(pxs)
    y_expr = "+".join(pys)

    # ---- 显式旋转分段 angle（每段 ra→rb 线性插值；仿 x/y；hide/spin 段不贡献显式旋转） ----
    # 2026-09-02：列表轨迹旋转角改用 ra（起始角度）/rb（结尾角度）双键，段内 ra→rb 线性插值
    # （与统一尝试版一致）；hide/spin 段不贡献显式旋转（spin 由下方自旋转负责，避免双旋转叠加）。
    # 单位=度，消费端乘 PI/180；仅任一航点 ra/rb 非 0 才返回非 None（否则不 emit rotate）。
    def _ra(w):
        return _wp_num(w, "ra", 0.0)
    def _rb(w):
        return _wp_num(w, "rb", 0.0)
    manual_parts = []
    _rot_any = any((abs(_ra(s)) > 1e-9 or abs(_rb(s)) > 1e-9) for s in valid)
    if _rot_any:
        _ra0 = _ra(valid[0])
        if _t_first > 0 and abs(_ra0) > 1e-9:
            manual_parts.append(f"lt(t,{_t_first:g})*({_ra0:g}*PI/180)")
        for _si, s in enumerate(valid):
            _t0 = _wp_num(s, "start")
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            _t1 = _t0 + _d0
            _a, _b = _ra(s), _rb(s)
            _sel = f"gte(t,{_t0:g})*lt(t,{_t1:g})"
            _mode = (s.get("mode") or "move")
            if _mode in ("hide", "spin"):
                # hide：元素移出画面，旋转无意义；spin：由下方连续自转负责，避免双旋转叠加
                manual_parts.append(f"{_sel}*0")
            elif abs(_b - _a) > 1e-9:
                manual_parts.append(
                    f"{_sel}*({_a:g}*PI/180+({_b - _a:g})*PI/180*(t-{_t0:g})/{_d0:g})")
            else:
                manual_parts.append(f"{_sel}*({_a:g}*PI/180)")
            if _si in _gaps:                  # 空档：停在上一行结尾角（hide/spin → 0）
                _gs = f"gte(t,{_gaps[_si][0]:g})*lt(t,{_gaps[_si][1]:g})"
                _ga = 0.0 if _mode in ("hide", "spin") else _b
                manual_parts.append(f"{_gs}*({_ga:g}*PI/180)")
        # 尾部：cut 优先；否则 终点行 / 末段消失 / 停在末段
        if cut is not None:
            if cut[1] == "freeze":
                manual_parts.append(f"gte(t,{cut[0]:g})*{cut[4]:g}*PI/180")
            else:
                manual_parts.append(f"gte(t,{cut[0]:g})*0")
        else:
            _lea = (valid[-1].get("end_action") or "keep")
            if _lea == "hide":
                manual_parts.append(f"gte(t,{t_end:g})*0")
            elif end is not None:
                manual_parts.append(f"gte(t,{t_end:g})*{_ra(end):g}*PI/180")
            else:
                manual_parts.append(f"gte(t,{t_end:g})*{_rb(valid[-1]):g}*PI/180")
    manual_angle = "+".join(manual_parts) if manual_parts else None

    # ---- 逐段缩放 zoom（2026-09-04）：sa→sb 线性插值，扁平累加（仿 x/y） ----
    # 返回**倍率**（1.0=原始尺寸）。消费端挂在 rotate 之后、用 iw/ih 相对表达
    # → 与旋转画布 d×d / 画布模式 / 静态角度全部解耦（不需要知道盒子到底是多大）。
    # ⚠️ 首段之前的 `lt(t,t_first)*z0` 项**不可省略**：段间若有空档，扁平累加会算出 0，
    # 倍率 0 会让下游 scale 拿到 w=0 直接报错（x/y 算出 0 只是位置错，不会崩）。
    def _za(w):
        _v = _wp_num(w, "sa", 1.0)
        return _v if _v > 0 else 0.01
    def _zb(w):
        _v = _wp_num(w, "sb", 1.0)
        return _v if _v > 0 else 0.01
    zoom_expr = None
    _zoom_any = any((abs(_za(s) - 1.0) > 1e-9 or abs(_zb(s) - 1.0) > 1e-9) for s in valid)
    if end is not None and abs(_za(end) - 1.0) > 1e-9:
        _zoom_any = True
    if _zoom_any:
        zparts = []
        zparts.append(f"lt(t,{_t_first:g})*{_za(valid[0]):g}")
        for _si, s in enumerate(valid):
            _t0 = _wp_num(s, "start")
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            _t1 = _t0 + _d0
            _a, _b = _za(s), _zb(s)
            _sel = f"gte(t,{_t0:g})*lt(t,{_t1:g})"
            if abs(_b - _a) > 1e-9:
                zparts.append(f"{_sel}*({_a:g}+({_b - _a:g})*(t-{_t0:g})/{_d0:g})")
            else:
                zparts.append(f"{_sel}*({_a:g})")
            if _si in _gaps:                  # 空档：停在上一行结尾倍率（不靠 max(0.01) 兜底）
                _gs = f"gte(t,{_gaps[_si][0]:g})*lt(t,{_gaps[_si][1]:g})"
                zparts.append(f"{_gs}*({_b:g})")
        # 尾部：cut 优先（freeze 停在 sb，hide 时已移出画面倍率无意义）；
        # 否则 终点行 sa → 末段 sb
        if cut is not None:
            zparts.append(f"gte(t,{cut[0]:g})*{_fz:g}")
        elif end is not None:
            zparts.append(f"gte(t,{t_end:g})*{_za(end):g}")
        else:
            zparts.append(f"gte(t,{t_end:g})*{_zb(valid[-1]):g}")
        # 兜底钳制：任何空档/异常都不允许倍率=0（scale w=0 会直接报错）
        zoom_expr = "max(0.01," + "+".join(zparts) + ")"

    # 透明度分段 alpha（2026-09-22 照抄 zoom 范式）：每段 oa→ob 线性插值（默认 1.0）。
    # 全部航点都是 1.0 时返回 None（调用方不挂 alpha 滤镜，老工程行为完全不变）。
    # 钳制 max(0,…) 而非 max(0.01,…) —— 0 透明度是合法语义（完全隐形）。
    def _oa(w):
        return _wp_num(w, "oa", 1.0)
    def _ob(w):
        return _wp_num(w, "ob", 1.0)
    alpha_expr = None
    _alpha_any = any((abs(_oa(s) - 1.0) > 1e-9 or abs(_ob(s) - 1.0) > 1e-9) for s in valid)
    if end is not None and abs(_oa(end) - 1.0) > 1e-9:
        _alpha_any = True
    if _alpha_any:
        alparts = []
        alparts.append(f"lt(t,{_t_first:g})*{_oa(valid[0]):g}")
        for _si, s in enumerate(valid):
            _t0 = _wp_num(s, "start")
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            _t1 = _t0 + _d0
            _a, _b = _oa(s), _ob(s)
            _sel = f"gte(t,{_t0:g})*lt(t,{_t1:g})"
            if abs(_b - _a) > 1e-9:
                alparts.append(f"{_sel}*({_a:g}+({_b - _a:g})*(t-{_t0:g})/{_d0:g})")
            else:
                alparts.append(f"{_sel}*({_a:g})")
            if _si in _gaps:                  # 空档：停在上一行结尾透明度（否则掉到 0）
                _gs = f"gte(t,{_gaps[_si][0]:g})*lt(t,{_gaps[_si][1]:g})"
                alparts.append(f"{_gs}*({_b:g})")
        # 尾部：cut 优先（freeze 停在 ob；hide 已移出画面，透明度表达式照挂同样无副作用）；
        # 否则 终点行 oa → 末段 ob
        if cut is not None:
            alparts.append(f"gte(t,{cut[0]:g})*{_fob:g}")
        elif end is not None:
            alparts.append(f"gte(t,{t_end:g})*{_oa(end):g}")
        else:
            alparts.append(f"gte(t,{t_end:g})*{_ob(valid[-1]):g}")
        alpha_expr = "max(0," + "+".join(alparts) + ")"

    # 自旋转分段 angle（多段角度连续累计；freeze/保持后末段为自旋转则继续转）
    spd = _opt_float(spin_speed, 60.0)
    spin_segs = [s for s in valid if (s.get("mode") or "move") == "spin"]
    spin_angle = None
    if spin_segs:
        acc = 0.0
        aparts = []
        for s in spin_segs:
            t0 = _wp_num(s, "start")
            d0 = _wp_num(s, "dur", 1.0)
            if d0 <= 0:
                d0 = 1.0
            t1 = t0 + d0
            aparts.append(
                f"gte(t,{t0:g})*lt(t,{t1:g})*({spd:g}*PI/180*(t-{t0:g})+{acc:g})")
            acc += spd * d0
        last_mode = (valid[-1].get("mode") or "move")
        if cut is not None and cut[1] == "freeze" and last_mode == "spin":
            aparts.append(f"gte(t,{cut[0]:g})*({spd:g}*PI/180*(t-{cut[0]:g})+{acc:g})")
        elif cut is None and last_mode == "spin":
            aparts.append(f"gte(t,{t_end:g})*({spd:g}*PI/180*(t-{t_end:g})+{acc:g})")
        spin_angle = "+".join(aparts)

    # 组合：手动角（弧度）+ 自旋转角（弧度）；无任何角度贡献 → None（不挂 rotate 滤镜，向后兼容）
    if manual_angle and spin_angle:
        angle_expr = f"({manual_angle})+({spin_angle})"
    elif manual_angle:
        angle_expr = manual_angle
    elif spin_angle:
        angle_expr = spin_angle
    else:
        angle_expr = None
    return x_expr, y_expr, angle_expr, zoom_expr, alpha_expr


# 航点行数超过该值 → 导出链 x/y 自动改用 sendcmd 命令文件驱动（2026-10-01 A 方案）。
# 阈值 15 = 旧时代行上限护栏（FFmpeg 7/8 报错遗产，2026-10-01 实测旧报错与表达式墙无关）：
# 默认 MAX_ROWS(15) 行以内走旧表达式路（行为不变），>15（用户主动调高上限加行）即 sendcmd。
_WP_SENDCMD_MIN_ROWS = 15

# 「更多设置」阈值的活动镜像（2026-10-01 全量接入：遮罩/简易位置/文字水印/画布等
# 大量模块级构建函数拿不到 app 实例 → 读这里；app 方法仍直接读 self.wp_sendcmd_min_rows）。
# 三处同步写入：__init__ 默认值 / load() / 设置弹窗确定。
_WP_SC_ROWS_LIVE = _WP_SENDCMD_MIN_ROWS


def _wp_sc_rows_limit():
    return _WP_SC_ROWS_LIVE


# drawtext x/y 命令支持的 ffmpeg 主版本门（2026-10-01 探针；2026-10-04 像素级重测修订，
# 权威档案 research/ffmpeg-95-seg-limit §21）：
# · 4.3 的 drawtext **有** process_command，但只实现了 `reinit` 一条 —— 发 x/y 命令被
#   **静默丢弃**（rc=0、stderr 无一字）→ 轨迹钉死占位值；改发 `reinit x=..:y=..` 则完全生效
#   （多条命令可做完整轨迹，且值可含 t 表达式，与 n9 逐帧一致）。
# · 7.1 / 9.0.1 直接支持 x/y 命令（走 RUNTIME_PARAM），无需 reinit。
# · overlay / crop 的 x/y 命令 4.3 本来就支持（2026-10-04 实测推翻旧「疑似不认」判），无需门。
# ⚠️ `-filters` 的 C 列不可作数：4.3 drawtext 标 `T.C` 却不吃 x/y，n9 标 `T.` 却吃得下。
# None = 未探测/探测失败 → **按不支持处理**（兜底 default 不承担"查不到"语义 → 调用方
#   回退表达式路；4.3 上 flat 表达式无 97 段墙，回退安全，见 §17）。
_FFMPEG_XY_CMD_MIN = 7
_FFMPEG_XY_CMD_MAJOR = None
_FFMPEG_XY_CMD_PROBED = None


def _probe_ffmpeg_major(path):
    """ffmpeg -version → 主版本号（按路径缓存，只探一次）；失败返回 None。"""
    global _FFMPEG_XY_CMD_MAJOR, _FFMPEG_XY_CMD_PROBED
    if path and path != _FFMPEG_XY_CMD_PROBED:
        _FFMPEG_XY_CMD_PROBED = path
        try:
            p = subprocess.run([path, "-version"], capture_output=True, timeout=5,
                               creationflags=_ffmpeg_spawn_flags())
            m = re.search(r"version\s+[nv]?(\d+)\.",
                          p.stdout.decode("utf-8", "replace"))
            _FFMPEG_XY_CMD_MAJOR = int(m.group(1)) if m else None
        except Exception:
            _FFMPEG_XY_CMD_MAJOR = None
    return _FFMPEG_XY_CMD_MAJOR


def _ffmpeg_xy_cmd_style():
    """drawtext x/y 的 sendcmd 命令形态（2026-10-04 实测定案，见 research §21）。

    返回三态，**不用布尔兜底**（探测失败不能再当"支持"，否则 4.3 上静默失效）：
      "xy"     —— ffmpeg >= 7：发 `x '值', y '值'` 命令（7.1 / 9.0.1 实测生效）
      "reinit" —— ffmpeg < 7（4.3 实测）：只认 `reinit x=值:y=值`，x/y 会被静默丢弃
      None     —— 版本未探测/探测失败 → 不支持，调用方回退表达式路
    """
    if _FFMPEG_XY_CMD_MAJOR is None:
        return None
    return "xy" if _FFMPEG_XY_CMD_MAJOR >= _FFMPEG_XY_CMD_MIN else "reinit"


def _ffmpeg_xy_cmd_ok():
    """sendcmd 能否驱动 drawtext 的 x/y（含 4.3 的 reinit 形态）。探测失败 → False。"""
    return _ffmpeg_xy_cmd_style() is not None


# overlay「alpha 主输入 + sendcmd 负坐标」4.3 bug（2026-10-01 探针
# _dbg_canvas43_twelfth~twentieth 系统钉死）：主输入带 alpha（rgba/yuva）的 overlay，
# x/y 命令值为负（内容移出画布左/上）→ 整层前景消失（导出画布看不见 / 预览百叶窗
# 开合）。4.3 的 alpha 混合路径（auto 协商到 gbrp/yuva）负 x 时不渲染前景；
# 强制 :format=rgb（packed RGB alpha 路径）绕开，混合数值运算同构（仅 ±1 舍入差）。
# 7.1 / 9.0.1 已修（同探针实测）；无 alpha 主输入（yuv / 遮罩 gbrp matte）不受影响。
def _overlay_sc_fmt_suffix():
    """仅当探测到 ffmpeg 主版本 < 7 时返回 ':format=rgb'，否则 ''（保持旧行为）。"""
    if _FFMPEG_XY_CMD_MAJOR is not None and _FFMPEG_XY_CMD_MAJOR < 7:
        return ":format=rgb"
    return ""


def build_waypoint_position_intervals(waypoints, trim_start=0.0, speed_factor=1.0):
    """build_waypoint_expr 的 x/y 语义 → 互斥时间区间表（sendcmd 命令文件用，2026-10-01）。

    与 build_waypoint_expr 的扁平累加 x/y 逐区间等价：显示前隐藏 / 段内线性 /
    空档停驻上一行结尾（hide 延续隐藏）/ cut freeze|hide / 终点行 / 停在末段 B。
    返回 [(t0, t1, kind, x0, y0, x1, y1)]，kind ∈ "move"|"hold"|"hide"；
    区间按时间升序互斥、覆盖 [0, +inf)（末区间 t1=None 表示直到结尾）。
    无有效段返回 None（调用方回退表达式路）。zoom/alpha/angle 不翻译（仍走表达式）。
    ⚠️ 逻辑照抄 build_waypoint_expr 的段预处理（时间换算/clamp/cut/gaps），改一处必查另一处。
    """
    wps = [w for w in (waypoints or []) if isinstance(w, dict)]
    if not wps:
        return None
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    if _ts != 0.0 or _sp != 1.0:
        _wps = []
        for _w in wps:
            _w2 = dict(_w)
            try:
                _st2, _du2 = _timeline_convert(_w2.get("start", 0), _w2.get("dur", 0),
                                               _ts, _sp)
                _w2["start"] = _st2
                _w2["dur"] = _du2
            except (ValueError, TypeError):
                pass
            _wps.append(_w2)
        wps = _wps
    segs = []
    end = None
    for w in wps:
        if (w.get("mode") or "move") == "end":
            end = w
        else:
            segs.append(w)
    if len(segs) > 1:
        # 与 build_waypoint_expr 同源：先拷贝再 clamp（纯生成器不污染调用方数据）
        segs = [dict(s) for s in segs]
        clamp_seg_overlaps(segs)
    if not segs:
        if end is None:
            return None
        _ex, _ey = _wp_num(end, "xa"), _wp_num(end, "ya")
        return [(0.0, None, "hold", _ex, _ey, _ex, _ey)]
    # ---- 独立终止点（首个 end_action != keep 的段），同 build_waypoint_expr ----
    cut = None                # (t_cut, "hide"|"freeze", xb, yb)
    for s in segs:
        ea = (s.get("end_action") or "keep")
        if ea in ("hide", "freeze"):
            _t0 = _wp_num(s, "start")
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            cut = (_t0 + _d0, ea, _wp_num(s, "xb"), _wp_num(s, "yb"))
            break
    valid = []
    for s in segs:
        if cut is not None and _wp_num(s, "start") >= cut[0] - 1e-9:
            break
        valid.append(s)
    if not valid:
        return None
    _l0 = _wp_num(valid[-1], "start")
    _ld = _wp_num(valid[-1], "dur", 1.0)
    if _ld <= 0:
        _ld = 1.0
    t_end = _l0 + _ld
    # ---- 段间空档（同 build_waypoint_expr：停在上一行结尾，hide 延续隐藏）----
    _gaps = {}
    for _gi in range(len(valid) - 1):
        _gp = valid[_gi]
        _gd = _wp_num(_gp, "dur", 1.0)
        if _gd <= 0:
            _gd = 1.0
        _ge = _wp_num(_gp, "start") + _gd
        _gn = _wp_num(valid[_gi + 1], "start")
        if _gn > _ge + 1e-9:
            _gaps[_gi] = (_ge, _gn)
    iv = []
    _t_first = _wp_num(valid[0], "start")
    if _t_first > 0:
        iv.append((0.0, _t_first, "hide", 0.0, 0.0, 0.0, 0.0))
    for _si, s in enumerate(valid):
        t0 = _wp_num(s, "start")
        d0 = _wp_num(s, "dur", 1.0)
        if d0 <= 0:
            d0 = 1.0
        t1 = t0 + d0
        mode = (s.get("mode") or "move")
        xa, ya = _wp_num(s, "xa"), _wp_num(s, "ya")
        xb, yb = _wp_num(s, "xb"), _wp_num(s, "yb")
        if mode == "hide":
            iv.append((t0, t1, "hide", 0.0, 0.0, 0.0, 0.0))
        else:
            iv.append((t0, t1, "move", xa, ya, xb, yb))
        if _si in _gaps:
            _gs, _ge2 = _gaps[_si]
            if mode == "hide":
                iv.append((_gs, _ge2, "hide", 0.0, 0.0, 0.0, 0.0))
            else:
                iv.append((_gs, _ge2, "hold", xb, yb, xb, yb))
    # ---- 尾部处置（cut 优先；无 cut：终点行 / 末段消失 / 停在末段 B）----
    if cut is not None:
        t_cut, _ea, _fx, _fy = cut
        if _ea == "freeze":
            iv.append((t_cut, None, "hold", _fx, _fy, _fx, _fy))
        else:
            iv.append((t_cut, None, "hide", 0.0, 0.0, 0.0, 0.0))
    else:
        _lea = (valid[-1].get("end_action") or "keep")
        if _lea == "hide":
            iv.append((t_end, None, "hide", 0.0, 0.0, 0.0, 0.0))
        elif end is not None:
            _ex, _ey = _wp_num(end, "xa"), _wp_num(end, "ya")
            iv.append((t_end, None, "hold", _ex, _ey, _ex, _ey))
        else:
            _fx, _fy = _wp_num(valid[-1], "xb"), _wp_num(valid[-1], "yb")
            iv.append((t_end, None, "hold", _fx, _fy, _fx, _fy))
    return iv


# 每条 sendcmd 命令覆盖的区间数：表达式 ~22 项（远低于 ~95 段墙），命令数 ≈ N/20
_WP_SC_SPAN_INTERVALS = 20


def write_waypoint_sendcmd_file(intervals, path, tag="wp", suffix_x="", suffix_y="", target=None,
                                cmd_style="xy"):
    """航点区间表 → sendcmd 命令文件（值加单引号容忍逗号/括号）。

    命令形态（ffmpeg n9.0.1 实测）：「时刻 目标 x '值', 目标 y '值';」——目标须与
    消费滤镜实例完整别名一致（编排器实测坑：overlay@l0 ≠ l0）。target=None 时用
    `overlay@{tag}`（列表轨迹/遮罩）；crop 等其他滤镜传完整别名如 `crop@cpp`。
    suffix_x/y 为旋转中心对齐后缀（照抄 _pip_overlay_xy 偏移语义），形如 '- 12.5'。

    cmd_style（2026-10-04 新增，见 research/ffmpeg-95-seg-limit §21 像素级实测）：
      "xy"（默认）—— `t 目标 x '值', 目标 y '值';`，>= 7.1 的所有滤镜。
      "reinit"    —— `t 目标 reinit x=值:y=值;`，**仅 ffmpeg < 7 的 drawtext**：
        4.3 的 drawtext 只实现了 `reinit` 一条命令，发 x/y 会被**静默丢弃**（rc=0 无报错）。
        实测 reinit 可驱动完整轨迹，且值可含 t 表达式（与 n9 逐帧一致）。
        ⚠️ 两条硬约束：① 值内不能含空格（sendcmd 空格分词；reinit 的 arg 用 ':' 分隔选项），
        故 suffix 拼进来后要去空格；② **不传 fontfile**——n9 上 reinit 带 fontfile 反而失效
        （4.3 正常），统一不带最安全（text/字体 reinit 后会保留，无需重传）。

    ⚠️ 分段安装（2026-10-01 实测铁律）：sendcmd 命令在「主帧推送进 framesync 缓冲」
    时就改写 overlay 选项（全局状态），而 overlay 消费滞后 0~3 帧（调度抖动、逐次
    运行不同）→ 逐段一条命令会在每个段边界抖动。本实现每 _WP_SC_SPAN_INTERVALS 个
    区间装一条命令，值 =「本段扁平累加（与 build_waypoint_expr 同式，段内逐帧精确）
    + 两端钳制守卫 if(lt(t,T0),V0,if(gte(t,Te),Ve,…))」——提前生效时守卫钳到端点
    （连续运动=精确续接），抖动点减少 ~20 倍。
    """
    def _val(iv, at_start):
        if iv[2] == "hide":
            return -100000.0, -100000.0
        return (iv[3], iv[4]) if at_start else (iv[5], iv[6])

    lines = []
    for s0 in range(0, len(intervals), _WP_SC_SPAN_INTERVALS):
        chunk = intervals[s0:s0 + _WP_SC_SPAN_INTERVALS]
        T0 = chunk[0][0]
        Te = chunk[-1][1] if chunk[-1][1] is not None else chunk[-1][0] + 1.0
        vx0, vy0 = _val(chunk[0], True)
        vx1, vy1 = _val(chunk[-1], False)
        xterms, yterms = [], []
        for (t0, t1, kind, xa, ya, xb, yb) in chunk:
            t1e = t1 if t1 is not None else t0 + 1.0
            sel = f"gte(t,{t0:g})*lt(t,{t1e:g})"
            if kind == "hide":
                xterms.append(f"{sel}*(-100000)")
                yterms.append(f"{sel}*(-100000)")
            else:
                d = t1e - t0
                xterms.append(f"{sel}*({xa:g}+({xb - xa:g})*(t-{t0:g})/{d:g})")
                yterms.append(f"{sel}*({ya:g}+({yb - ya:g})*(t-{t0:g})/{d:g})")
        fx = (f"if(lt(t,{T0:g}),{vx0:g},if(gte(t,{Te:g}),{vx1:g},"
              f"{'+'.join(xterms)}))")
        fy = (f"if(lt(t,{T0:g}),{vy0:g},if(gte(t,{Te:g}),{vy1:g},"
              f"{'+'.join(yterms)}))")
        if suffix_x:
            fx = f"({fx}) {suffix_x}"
        if suffix_y:
            fy = f"({fy}) {suffix_y}"
        _tgt = target or f"overlay@{tag}"
        if cmd_style == "reinit":
            # ffmpeg < 7 的 drawtext 只认 reinit（§21 实测）：x/y 命令被静默丢弃。
            # ⚠️ **整个 arg 必须单引号包裹**（不是只包值！）：sendcmd 用 ',' 分隔同一
            #    interval 内的多条命令，而表达式里全是逗号（if(lt(t,0),a,if(...)))。
            #    只写 x='…' 时 arg 以 "x=" 开头而非引号 → 第一个逗号处被切开，后半变成
            #    「没有 command 的命令」→ "No command specified in interval #0, command #1"
            #    整图初始化失败（2026-10-04 用户实测报错）。整 arg 加引号后 av_get_token
            #    吃掉外层引号、逗号受保护，交给 drawtext 的是干净的 x=…:y=…。
            # 另：值内空格必须去掉（空格也是 sendcmd 分词符），suffix 形如 ' - 12.5'
            #     拼进来带空格 → replace(" ", "") 后成 '(expr)-12.5'。
            lines.append(f"{T0:.6f} {_tgt} reinit 'x={fx.replace(' ', '')}"
                         f":y={fy.replace(' ', '')}';")
        else:
            lines.append(f"{T0:.6f} {_tgt} x '{fx}', {_tgt} y '{fy}';")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


# 轨迹「移动方式 / 缓动」统一下拉（2026-09-13 重构：缓动折进方式，所有轨迹窗口共用）。
# 旧版把「平滑」写死 smoothstep，并另开一个独立的「缓动」下拉；现合并为同一下拉：
#   平移/线性=线性插值（两个独立可选项，存储键不同：move / linear），
#   缓入/缓出/缓入缓出/平滑(原)=缓动插值，不动=常量。
# ⚠️ canonical key 恒为英文、与界面语言无关：下拉一律按「索引」取模式（不做显示文本匹配），
#    显示名走 _traj_mode_display_map()（与 CORNER_DIR_PRESETS / _mark_disp 同一套双变量做法）。
_TRAJ_MODE_ORDER = ["move", "smoothstep", "linear", "ease_in", "ease_out", "ease_in_out", "still"]
# 历史数据可能存中文「移动/平滑」或英文「smooth」等，统一归一为上述 canonical key。
_TRAJ_LEGACY_TO_KEY = {
    "移动": "move", "平移": "move", "move": "move", "linear": "linear",
    "线性": "linear",
    "平滑": "smoothstep", "平滑(原)": "smoothstep", "smooth": "smoothstep", "smoothstep": "smoothstep",
    "缓入": "ease_in", "ease_in": "ease_in",
    "缓出": "ease_out", "ease_out": "ease_out",
    "缓入缓出": "ease_in_out", "ease_in_out": "ease_in_out",
    "不动": "still", "still": "still",
}


def _traj_mode_display_map():
    """canonical key → 显示值（「平移/平滑(原)/线性/缓入/缓出/缓入缓出/不动」）。

    ⚠️ 必须是函数、在对话框构建时求值，**不能写成模块级常量**：multi 的 _() 依赖全局 TRANS，
    而 TRANS 要等启动后 load_language() 才装载——模块级调用会被冻在「导入时的中文」上，
    英文界面里这个下拉仍显示中文。做成函数后，multi 里 _() 在开窗时求值 → 跟随当前语言。
    """
    return {
        "move": "平移",
        "smoothstep": "平滑(原)",
        "linear": "线性",
        "ease_in": "缓入",
        "ease_out": "缓出",
        "ease_in_out": "缓入缓出",
        "still": "不动",
    }


def _traj_mode_choices():
    """→ 与 _TRAJ_MODE_ORDER 同序的下拉显示名列表（combobox values）。"""
    return _canon_disp_list(_TRAJ_MODE_ORDER, _traj_mode_display_map)


def _seg_move_mode(w):
    """轨迹段移动方式归一化 → canonical key：
    'move'（线性: 平移/线性）| 'smoothstep'（原平滑）|
    'ease_in' | 'ease_out' | 'ease_in_out' | 'still'（不动）。

    兼容历史写法：move=True/False、'移动'/'平滑'/'不动' 中文、'move'/'smooth'/'still' 英文、
    以及对话框写回的 canonical key。返回常量供 build_crop_pos_expr /
    build_canvas_filtergraph / 各轨迹列表显示统一使用。"""
    v = w.get("move", True)
    if v is False or v is None or v == "":
        return "still"
    if isinstance(v, str):
        k = _TRAJ_LEGACY_TO_KEY.get(v)
        if k:
            return k
    return "move"


def build_crop_pos_expr(segments, base_x, base_y, trim_start=0.0, speed_factor=1.0):
    """简易位置：把「某段时间内画面在裁剪区域变动」编译成 ffmpeg crop 的 x/y 表达式。

    模型（绝对分段 + 嵌套 if，按开始时间升序生成）：
      - 段前（第一行开始前）：停在基准位置 base_x/base_y（= 裁剪框左上角 crop_left/crop_top）
      - 段内：move='move' 从 起始→结尾 线性插值；move='smooth' 平滑插值（smoothstep，
        起止速度归零更丝滑）；move='still' 整段停在 起始坐标
      - 段后空档：停在上一行结尾坐标（min(1,...) 自然钳到结尾值，不回跳）
      - 末段之后：恒停在最后一行结尾坐标
    2026-08-29：段时间输入语义=主视频**原始时间**（用户在原始时间轴标记位置）；
    生成时自动换算**输出时间线**（滤镜 t）：st_out=(st-trim_start)/speed，d_out=dur/speed。
    未截取/变速（trim_start=0、speed=1）时换算无影响。
    segments: list[dict]，键 sx,sy(起始),ex,ey(结尾,move时),move('move'/'smooth'/bool),start,dur
    返回 (x_expr, y_expr)；无段返回 (None, None)。"""
    ts = float(trim_start or 0.0)
    sp = _opt_float(speed_factor or 1.0, 1.0)
    if sp <= 0:
        sp = 1.0
    segs = sorted(segments, key=lambda s: float(s.get("start", 0) or 0))
    if not segs:
        return None, None
    bx = float(base_x); by = float(base_y)

    def _st_dur(seg):
        # clamp 到 ≥0：段时间≈trim_start 时（如 1506.83 − 1506.833）浮点产生微小负阈值
        return _timeline_convert(seg.get("start", 0), seg.get("dur", 0), ts, sp)

    def term(seg, ks, ke):
        sx = float(seg.get(ks, 0)); ex = float(seg.get(ke, 0))
        st, d = _st_dur(seg)             # 输出时间线起点/段长（统一换算）
        if d <= 0:
            d = 1e-6  # 防止除零；min 瞬时钳满
        mode = _seg_move_mode(seg)
        if mode == "still":
            return f"{sx:g}"
        if mode in ("move", "linear"):
            return f"{sx:g}+({ex}-{sx})*min(1,(t-{st:g})/{d:g})"
        # 缓动（smoothstep / ease_in / ease_out / ease_in_out）：段内局部进度做 ease。
        # ffmpeg 不会解牛顿，故贝塞尔曲线用 _ease_ladder_expr 压平成线性段（与 canvas 同思路）。
        mm = f"min(1,(t-{st:g})/{d:g})"
        if mode == "smoothstep":
            # 原平滑 x²(3-2x)，与旧版逐字符等价（严格向后兼容）
            return f"{sx:g}+({ex}-{sx})*({mm}*{mm}*(3-2*{mm}))"
        eased = _ease_ladder_expr(mm, mode, steps=32)
        return f"{sx:g}+({ex}-{sx})*{eased}"

    ex_x = f"{bx:g}"
    ex_y = f"{by:g}"
    for seg in segs:
        st, _d = _st_dur(seg)
        ex_x = f"if(lt(t,{st:g}),{ex_x},{term(seg, 'sx', 'ex')})"
        ex_y = f"if(lt(t,{st:g}),{ex_y},{term(seg, 'sy', 'ey')})"
    return ex_x, ex_y


def build_crop_pos_intervals(segments, base_x, base_y, trim_start=0.0, speed_factor=1.0):
    """build_crop_pos_expr 的语义 → 互斥时间区间表（sendcmd 命令文件用，2026-10-01 全量接入）。

    段前停在 base；段内 move/linear 线性、still 常量；smoothstep/ease_* 按
    _ease_ladder_expr 同款 32 级采样展开成线性子区间（sendcmd 侧每子区间线性插值
    与表达式路阶梯逐点同值 → 数学等价）；后行开始早于前行结束（重叠）时后行胜出
    （嵌套 if 天然语义）；空档停上一行结尾；末段之后恒停最后一行结尾。
    返回 [(t0, t1, kind, x0, y0, x1, y1)]，kind ∈ "move"|"hold"；
    升序互斥覆盖 [0, +inf)（末区间 t1=None）。无有效段返回 None（调用方回退表达式路）。
    ⚠️ 逻辑照抄 build_crop_pos_expr，改一处必查另一处。
    """
    segs = sorted((s for s in (segments or []) if isinstance(s, dict)),
                  key=lambda s: float(s.get("start", 0) or 0))
    if not segs:
        return None
    ts = float(trim_start or 0.0)
    sp = _opt_float(speed_factor or 1.0, 1.0)
    if sp <= 0:
        sp = 1.0
    try:
        bx, by = float(base_x), float(base_y)
    except (ValueError, TypeError):
        return None

    def _lin_at(t0, t1, v0, v1, tq):
        if abs(t1 - t0) < 1e-12:
            return v0
        return v0 + (v1 - v0) * (tq - t0) / (t1 - t0)

    iv = []          # [(t0, t1, x0, y0, x1, y1)]（kind 最后统一填）
    tail_end = 0.0   # 已覆盖到的时间（重叠时后行截断前行）
    prev_x, prev_y = bx, by
    for seg in segs:
        try:
            sx = float(seg.get("sx", 0)); ex = float(seg.get("ex", 0))
            sy = float(seg.get("sy", 0)); ey = float(seg.get("ey", 0))
            st, d = _timeline_convert(seg.get("start", 0), seg.get("dur", 0), ts, sp)
        except (ValueError, TypeError):
            continue
        if d <= 0:
            d = 1e-6
        # 重叠：后行从 st 起胜出 → 截掉/裁短此前覆盖到 st 之后的区间
        while iv and iv[-1][0] >= st - 1e-9:
            iv.pop()
        if not iv:
            if st > 1e-9:
                iv.append((0.0, st, bx, by, bx, by))      # 段前停在 base（同嵌套 if 最内层）
        elif iv[-1][1] > st + 1e-9:
            t0, t1, x0, y0, x1, y1 = iv.pop()
            iv.append((t0, st, x0, y0, _lin_at(t0, t1, x0, x1, st), _lin_at(t0, t1, y0, y1, st)))
        elif iv[-1][1] < st - 1e-9:
            iv.append((iv[-1][1], st, prev_x, prev_y, prev_x, prev_y))   # 空档停驻
        mode = _seg_move_mode(seg)
        if mode == "still":
            iv.append((st, st + d, sx, sy, sx, sy))
        elif mode in ("move", "linear"):
            iv.append((st, st + d, sx, sy, ex, ey))
        else:
            # 缓动：32 级采样（与 _ease_ladder_expr 同采样点 → 分段线性逐点同值）
            _N = 32
            _pts = [_ease_value(i / _N, mode) for i in range(_N + 1)]
            for _j in range(_N):
                t0 = st + d * _j / _N
                t1 = st + d * (_j + 1) / _N
                iv.append((t0, t1,
                           sx + (ex - sx) * _pts[_j], sy + (ey - sy) * _pts[_j],
                           sx + (ex - sx) * _pts[_j + 1], sy + (ey - sy) * _pts[_j + 1]))
        tail_end = st + d
        prev_x, prev_y = ex, ey
    if not iv:
        return None
    if tail_end < float("inf") and (not iv or iv[-1][1] is not None):
        iv.append((tail_end, None, prev_x, prev_y, prev_x, prev_y))      # 末段之后恒停
    return [(t0, t1, ("hold" if (x0 == x1 and y0 == y1) else "move"), x0, y0, x1, y1)
            for (t0, t1, x0, y0, x1, y1) in iv]


# >>> EASING HELPERS START
# 轨迹缓动曲线（2026-09-13）：把「平滑」写死的 smoothstep 升级为可配置贝塞尔缓动。
# 借鉴 jub0t/Concat 的 bezier_y_at_x（牛顿+二分）；ffmpeg 不会解牛顿，故 resample 压平。
# 关键：缓动贯穿「整条轨迹」(全局 t0→tN)，而非每段各算各的——
#   单段时与旧 smoothstep 完全等价（向后兼容）；多段时中间点非零速度，不再每点停。
_EASE_PRESETS = {
    "linear":      (0.0, 0.0, 1.0, 1.0),
    "ease_in":     (0.42, 0.0, 1.0, 1.0),
    "ease_out":    (0.0, 0.0, 0.58, 1.0),
    "ease_in_out": (0.42, 0.0, 0.58, 1.0),
    "smoothstep":  None,   # 原平滑 x²(3-2x)，严格向后兼容
}


def _bezier_y_at_x(x, p1x, p1y, p2x, p2y, eps=1e-6, max_iter=8):
    """解三次贝塞尔：给定 x∈[0,1]，求 t 使 bezier_x(t)=x，再返回 bezier_y(t)。
    牛顿迭代 + 二分兜底（照搬 jub0t/Concat 思路）。"""
    if x <= 0.0:
        return 0.0
    if x >= 1.0:
        return 1.0
    t = x
    for _unused in range(max_iter):
        bx = 3 * (1 - t) ** 2 * t * p1x + 3 * (1 - t) * t ** 2 * p2x + t ** 3 - x
        if abs(bx) < eps:
            break
        d = 3 * (1 - t) ** 2 * p1x + 6 * (1 - t) * t * (p2x - p1x) + 3 * t ** 2 * (1 - p2x)
        if abs(d) < 1e-9:
            break
        t -= bx / d
        if t < 0.0:
            t = 0.0
        elif t > 1.0:
            t = 1.0
    lo, hi = 0.0, 1.0
    for _unused in range(20):
        mt = (lo + hi) / 2.0
        bx = 3 * (1 - mt) ** 2 * mt * p1x + 3 * (1 - mt) * mt ** 2 * p2x + mt ** 3
        if abs(bx - x) < eps:
            t = mt
            break
        if bx < x:
            lo = mt
        else:
            hi = mt
    return 3 * (1 - t) ** 2 * t * p1y + 3 * (1 - t) * t ** 2 * p2y + t ** 3


def _ease_value(frac, preset="smoothstep"):
    """frac∈[0,1] → 缓动后的值∈[0,1]。"""
    f = min(1.0, max(0.0, float(frac)))
    if preset == "smoothstep" or preset not in _EASE_PRESETS:
        return f * f * (3.0 - 2.0 * f)
    cx1, cy1, cx2, cy2 = _EASE_PRESETS[preset]
    return _bezier_y_at_x(f, cx1, cy1, cx2, cy2)


def _ease_ladder_expr(var, preset="smoothstep", steps=24):
    """把 ease(var) 压平成 ffmpeg 线性段表达式。
    var 是含帧变量 t 的 ffmpeg 表达式串；返回与 ease(var) 等价的分段线性串。
    段内线性插值逼近贝塞尔曲线（ffmpeg 不会解牛顿，必须压平）。"""
    pts = [_ease_value(i / steps, preset) for i in range(steps + 1)]
    inner = None
    for i in range(steps - 1, -1, -1):
        x0 = i / steps
        x1 = (i + 1) / steps
        seg = f"{pts[i]:g}+({pts[i + 1] - pts[i]:g})*(({var})-({x0:g}))/({x1 - x0:g})"
        if inner is None:
            inner = seg
        else:
            inner = f"if(lt({var},{x1:g}),{seg},{inner})"
    return f"if(lt({var},0),0,if(gt({var},1),1,{inner}))"
# >>> EASING HELPERS END


def _canvas_defers_mask(settings) -> bool:
    """画布模式下遮罩必须「延后」到画布段之后应用 —— 共享判据（唯一真源）。

    背景（2026-09-12 方案 A）：遮罩坐标的基准尺寸 = 打开遮罩窗口时的**最终渲染帧**
    （crop→rotate→scale 之后，见 _open_mask_dialog 里 compute_final_size_with_order）。
    画布模式把 crop/rotate/scale 全关、改由画布段接管，于是链尾遮罩实际作用在
    「画布之前的内容帧」（原始 W×H）上 —— 坐标空间对不上，表现为「开了画布模式遮罩就失效」。
    修法：画布模式下 build_video_filter_chain 跳过遮罩段，改由 build_canvas_filtergraph
    在画布段产出之后补上，使其重新落在最终渲染帧上。

    ⚠️ 本判据被两处消费，必须完全一致，否则会出现「双重遮罩」或「遮罩丢失」：
      ① build_video_filter_chain —— 为 True 时跳过链尾遮罩段；
      ② build_canvas_filtergraph —— 为 True 时在画布段之后追加遮罩段。
    """
    return (bool(settings.get("canvas_mode"))
            and bool(settings.get("canvas_segments"))
            and bool(settings.get("mask_enabled", False)))


def _resolve_crop_size(settings, W, H):
    """画布模式合并裁剪：若启用裁剪且宽高可解析为正整数，返回 (cw, ch) 作为画布/内容尺寸；否则 None。

    W,H = 主视频原始尺寸（用于把 iw/ih 表达式求值成具体像素，如 'iw/2' → W/2）。
    求值失败（复杂表达式等）返回 None，调用方回退到原始尺寸并关闭裁剪（避免内容≠画布尺寸错配）。"""
    if not settings.get("crop_enabled"):
        return None
    cw = str(settings.get("crop_width", "") or "").strip()
    ch = str(settings.get("crop_height", "") or "").strip()
    if not cw or not ch:
        return None
    try:
        W = int(round(float(W))); H = int(round(float(H)))
    except (ValueError, TypeError):
        return None
    if W <= 0 or H <= 0:
        return None
    def _ev(s):
        # 安全求值：走 safe_eval_expr 的白名单正则 + co_names 校验，拒绝 __class__ /
        # __subclasses__ / __globals__ 等属性链 → 杜绝 eval 沙盒逃逸 RCE（审计 H1）。
        # crop 表达式只用 iw/ih 与四则运算，safe_eval_expr 的字符白名单已全覆盖。
        return safe_eval_expr(s, {"iw": W, "ih": H})
    w, h = _ev(cw), _ev(ch)
    if w and h and w > 0 and h > 0:
        return (w, h)
    return None


def build_canvas_px_intervals(segments, trim_start=0.0, speed_factor=1.0, ease=None):
    """build_canvas_filtergraph 的 px/py（sx→ex / sy→ey 中心偏移）语义 → 互斥时间区间表。

    （sendcmd 命令文件用，2026-10-01 全量接入）语义照抄 _nested+_interp：
    嵌套 if（后行从其 start 起胜出；首行 start 之前 = 0 即画布居中）；
    still 行 / v1==v0 行常量；linear/move 行 min(1,) 钳制（行尾必收结点）；
    eased 行走「全局贯穿缓动」：g=(t-T0)/span 线性于 t → 取 32 个全局均匀 t 结点、
    值用 _ease_value 精确解（sendcmd 侧线性插值与表达式路阶梯同结点同值 → 数学等价）；
    行间空档沿用该行公式继续外推（阶梯 g 钳 [0,1]，与表达式路一致）。
    返回 [(t0, t1, kind, x0, y0, x1, y1)]，kind ∈ "move"|"hold"；末区间 t1=None。
    无有效段返回 None（调用方回退表达式路）。
    ⚠️ 逻辑照抄 build_canvas_filtergraph 的 _nested+_interp（px/py 专用），改一处必查另一处。
    """
    segs = [dict(s) for s in (segments or []) if isinstance(s, dict)]
    if not segs:
        return None
    ts = float(trim_start or 0.0)
    sp = _opt_float(speed_factor or 1.0, 1.0)
    if sp <= 0:
        sp = 1.0
    segs.sort(key=lambda s: float(s.get("start", 0) or 0))

    def _st_dur(seg):
        return _timeline_convert(seg.get("start", 0), seg.get("dur", 0), ts, sp)

    _g_t0 = _st_dur(segs[0])[0]
    _g_last = segs[-1]
    _g_tN = _st_dur(_g_last)[0] + _st_dur(_g_last)[1]
    _g_span = _g_tN - _g_t0
    if _g_span <= 1e-9:
        _g_span = 0.0

    def _row_val(seg, k0, k1, t):
        """t 时刻该行的值（嵌套 if 只在 t≥该行 start 时选中它，本函数不含窗口判断）。"""
        v0 = _seg_num(seg, k0)
        v1 = _seg_num(seg, k1)
        st, d = _st_dur(seg)
        if d <= 0:
            d = 1e-6
        mode = _seg_move_mode(seg)
        if mode == "still" or abs(v1 - v0) < 1e-9:
            return v0
        if mode in ("move", "linear"):
            return v0 + (v1 - v0) * min(1.0, (t - st) / d)
        _preset = ease if ease else mode
        if _g_span <= 0:
            u = min(1.0, max(0.0, (t - st) / d))
            return v0 + (v1 - v0) * _ease_value(u, _preset)
        eA = _ease_value((st - _g_t0) / _g_span, _preset)
        eB = _ease_value((st + d - _g_t0) / _g_span, _preset)
        denom = eB - eA
        if abs(denom) < 1e-9:
            return v0
        g = min(1.0, max(0.0, (t - _g_t0) / _g_span))
        return v0 + (v1 - v0) * (_ease_value(g, _preset) - eA) / denom

    # 结点集：每行 start（嵌套切换点）+ linear 行 end（min(1,) 钳制拐点）+ 全局 32 均匀结点
    _has_eased = any(_seg_move_mode(s) not in ("move", "linear", "still") for s in segs)
    knots = set()
    for s in segs:
        st, d = _st_dur(s)
        knots.add(max(0.0, st))
        knots.add(max(0.0, st + d))
    if _has_eased and _g_span > 0:
        for _j in range(33):
            knots.add(_g_t0 + _g_span * _j / 32.0)
    knots = sorted(k for k in knots if k >= 0.0)
    if not knots or knots[0] > 1e-9:
        knots.insert(0, 0.0)

    def _active(t):
        act = None
        for s in segs:
            if _st_dur(s)[0] <= t + 1e-9:
                act = s
            else:
                break
        return act

    iv = []
    for _i in range(len(knots)):
        t0 = knots[_i]
        t1 = knots[_i + 1] if _i + 1 < len(knots) else None
        act = _active(t0)
        if act is None:
            v = (0.0, 0.0)
        else:
            v = (_row_val(act, "sx", "ex", t0), _row_val(act, "sy", "ey", t0))
        if iv and iv[-1][1] is not None and abs(iv[-1][3] - v[0]) < 1e-9 \
                and abs(iv[-1][4] - v[1]) < 1e-9 and abs(iv[-1][1] - t0) < 1e-9:
            iv[-1] = (iv[-1][0], t1, iv[-1][2], iv[-1][3], v[0], v[1])   # 同值延段
            continue
        if t1 is None:
            iv.append((t0, None, v[0], v[1], v[0], v[1]))
        else:
            v1v = (_row_val(act, "sx", "ex", t1), _row_val(act, "sy", "ey", t1)) \
                if act is not None else (0.0, 0.0)
            iv.append((t0, t1, v[0], v[1], v1v[0], v1v[1]))
    if not iv:
        return None
    return [(t0, t1, ("hold" if abs(x0 - x1) < 1e-9 and abs(y0 - y1) < 1e-9 else "move"),
             x0, y0, x1, y1)
            for (t0, t1, x0, y0, x1, y1) in iv]


def build_canvas_filtergraph(settings, W, H, trim_start=0.0, speed_factor=1.0,
                            filter_trim_start=0.0, trim_duration=None,
                            src_label=None, out_label="v_canvas",
                            canvas_color="black", base_vf=None, tag="",
                            force_rgba=False, append_mask=True, ease=None):
    """画布模式（Shotcut 式「位置、尺寸、旋转」）滤镜图生成。

    主视频作为内容，在固定 = 主视频原始尺寸的黑色画布上 移动 + 缩放 + 旋转，
    做出「从画布外滑入、边滑边放大」效果。生成 filter_complex 字符串：

        [0:v]{base_vf}[v_base];   # v_base = 完整原始画面（裁剪只决定窗口大小，绝不裁内容）
        color=c=black:s=CWxCH[bg]; # 黑底=窗口（裁剪时=裁剪框大小，不裁剪时=原始尺寸）
        [v_base]scale=w='2*round(W*s(t)/2)':h='2*round(H*s(t)/2)'[v1];  # W,H=原始尺寸（内容缩放基准）
        [v1]rotate=angle='a(t)*PI/180':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[v2];
        [bg][v2]overlay=x='(main_w-overlay_w)/2+px(t)':y='(main_h-overlay_h)/2+py(t)'[v_canvas]

    - 缩放 s(t)：段内 scale_start→scale_end 插值（move 线性 / smooth 平滑 / still 静止），
      与 x/y 段模型同一套插值逻辑；偶数化避免 yuv420p 尺寸告警。
    - 旋转 a(t)：段内 rot_start→rot_end（度→弧度）插值；静态=常数。
    - 偏移 px/py：内容中心相对画布中心的偏移（中心锚点缩放，缩放不改中心），段内 sx/sy→ex/ey 插值。
    - 黑角：rotate 输出 hypot 正方形（黑角填充），overlay 中心对齐到黑画布 → 旋转露出的黑角
      与画布融为一体，即「内容在画布上转」的 Shotcut 语义。
    2026-08-30 用户拍板（关键区分）：画布=窗口，内容=完整原始画面，二者独立：
      - 不裁剪：窗口=原始尺寸，画面(缩放)移出去露黑，没问题。
      - 裁剪：仅窗口缩小到裁剪框大小（上面的 CW/CH），完整画面(缩放)在窗口内移动
              = 原「裁剪简易位置」效果 + 额外获得旋转；画面本身不参与裁剪。
      故裁剪只决定窗口大小（CW/CH），不影响内容（内容始终=完整原始画面，scale 基准=原始 W×H）。
      crop 的动态位移（crop_pos）在画布模式下被忽略（画布统一接管位置/缩放/旋转）。
    - 2026-08-29 时间语义（与简易位置 crop 同套）：seg['start']/['dur'] = **原始时间**；
      生成时按 _timeline_convert 自动换算**输出时间线**（滤镜 t）。预览传 trim_start=0/speed=1
      （不换算，滤镜 t = 原始时间戳），转换传真实值（换算）。
    - 2026-08-30 修复（combo-seek/双-ss 运动错位 + 卡顿）：新增 filter_trim_start / trim_duration
      形参。精确截取：输入未 seek，filter 链首注入
      trim=start=filter_trim_start:dur=trim_duration*speed,setpts=(PTS-STARTPTS)/speed
      把滤镜 t 归零到输出时间线。filter_trim_start=原始 trim_start。
      组合跳转(双-ss)：输入已 -ss 定位 + -t 限制时长（解码只跑截取段，不会整段卡顿），
      故「不注入」trim/setpts，滤镜直接用原始 [0:v]，filter t = 原始时间 - 前面新的 -ss。
      运动时间换算基准 trim_start 与 filter_trim_start 解耦：精确截取用原始 trim_start；
      组合跳转（双-ss）用「前面新的 -ss」pre_seek
      （用户实测：双-ss 下 ffmpeg 把 filter 时间线 0 点对到 pre_seek）。
      不传 trim_duration 则不注入（组合跳转/预览/无截取场景，滤镜 t=原始时间戳）。
    W,H = 内容原始渲染尺寸（裁剪尺寸解析基准 + scale 缩放基准；子视频=其原始尺寸）。
    2026-08-31 子视频画布（两段式，用户拍板）：本函数产出的是**独立数据流**，
      下游把它当独立文件消费（第 2 段：自由缩放 / 自旋转 / 透明度 / 轨迹 / 混合 → 贴主视频）。
      两次 overlay 不合并（对应 NLE：画布内=Transform 节点，贴主视频=Merge 节点）。
      新增参数（主视频不传 → 行为零变化）：
        src_label  输入标签（默认 "[0:v]"；子视频传前置链输出标签，如 "[v_temp_0]"）
        out_label  输出标签名（默认 "v_canvas"；多个画布并存时调用方传唯一名防冲突）
        canvas_color 画布底色（默认 "black" 不透明；**子视频必须传 "black@0" 透明**，
                     否则黑矩形会盖死主视频）
        base_vf    前置滤镜串（None=内部按 settings 构建；子视频传调用方已构建好的链，
                   避免重复构建 trim/loop/绿幕等）
        tag        内部临时标签后缀（多画布并存防重名，如 "s0"）
        force_rgba 强制 rgba 通道（canvas_color 含 "@" 时自动开启）
      ⚠️ 透明画布必须有 alpha：内容/画布底/输出全程 format=rgba，否则 rotate 的
         c=black@0 黑角与画布空白处会退化成不透明黑块。
    返回 filter_complex 字符串（含标签，供调用方 append 进 filter_parts）；
    无有效段或尺寸非法时返回 None。"""
    segs = settings.get("canvas_segments")
    if not segs:
        return None
    try:
        W = int(round(float(W))); H = int(round(float(H)))
    except (ValueError, TypeError):
        return None
    if W <= 0 or H <= 0:
        return None
    ts = float(trim_start or 0.0)
    sp = _opt_float(speed_factor or 1.0, 1.0)
    if sp <= 0:
        sp = 1.0

    segs = [dict(s) for s in segs]
    segs.sort(key=lambda s: float(s.get("start", 0) or 0))

    _num = _seg_num  # 段 dict 安全取数值（2026-09-22 抽公共，原局部实现逐字上移）

    def _st_dur(seg):
        return _timeline_convert(seg.get("start", 0), seg.get("dur", 0), ts, sp)

    # 全局缓动基准（2026-09-13）：缓动贯穿「整条轨迹」(t0→tN)，而非每段各算各的。
    # 单段时 t0=st, tN=st+d → 等价于旧逐段 smoothstep（向后兼容）；
    # 多段时中间点被「带着非零速度穿过」，不再每点减速到 0（即旧「平滑」顿挫的根因）。
    # 缓动曲线（2026-09-13 重构）：不再有独立 traj_ease 设置——曲线直接由每段 seg['move']
    # 的 canonical key（smoothstep/ease_in/...）决定，多段可各有不同曲线；ease 参数仅作
    # 旧接口兼容的整条轨迹强制覆盖（通常 None）。
    _ease = ease if ease else None
    _g_t0 = _st_dur(segs[0])[0]
    _g_last = segs[-1]
    _g_tN = _st_dur(_g_last)[0] + _st_dur(_g_last)[1]
    _g_span = _g_tN - _g_t0
    if _g_span <= 1e-9:
        _g_span = 0.0

    def _interp(seg, k0, k1, mode=None):
        """段内数值插值（still/线性/eased），返回 ffmpeg 表达式字符串。
        mode: 显式插值模式（canonical key）；None 时按 _seg_move_mode 推断。
        旋转字段传入 rot_mode（与位置/缩放解耦）。
        eased 模式走「全局贯穿缓动」：ease(g) 把整条轨迹映射成一条连续曲线，
        段内只做线性重映射，故多段接缝处位置连续、不再每点停（旧「平滑」顿挫的根因）。"""
        v0 = _num(seg, k0); v1 = _num(seg, k1)
        st, d = _st_dur(seg)
        if d <= 0:
            d = 1e-6
        if mode is None:
            mode = _seg_move_mode(seg)
        if mode == "still" or abs(v1 - v0) < 1e-9:
            return f"{v0:g}"
        if mode in ("move", "linear"):
            return f"{v0:g}+({v1}-{v0})*min(1,(t-{st:g})/{d:g})"
        # eased：smoothstep / ease_in / ease_out / ease_in_out
        # 若调用方强制传入 ease（旧接口），整条轨迹统一用该曲线；否则用每段自己的曲线
        _preset = _ease if _ease else mode
        if _g_span <= 0:
            # 退化单段：与旧逐段 smoothstep 逐字符等价（向后兼容）
            mm = f"min(1,(t-{st:g})/{d:g})"
            if _preset == "smoothstep":
                return f"{v0:g}+({v1}-{v0})*({mm}*{mm}*(3-2*{mm}))"
            eased = _ease_ladder_expr(mm, _preset, steps=32)
            return f"{v0:g}+({v1}-{v0})*{eased}"
        # 全局归一化时间 g=(t-T0)/span → ease(g)；段内局部进度 = (ease(g)-easeA)/(easeB-easeA)
        gvar = f"((t-{_g_t0:g})/{_g_span:g})"
        eased = _ease_ladder_expr(gvar, _preset, steps=32)
        gA = (st - _g_t0) / _g_span
        gB = (st + d - _g_t0) / _g_span
        easeA = _ease_value(gA, _preset)
        easeB = _ease_value(gB, _preset)
        denom = easeB - easeA
        local = "0" if abs(denom) < 1e-9 else f"({eased}-({easeA:g}))/({denom:g})"
        return f"{v0:g}+({v1}-{v0})*{local}"

    def _nested(segs, term_fn, default):
        """按开始时间升序生成嵌套 if(lt(t,st),prev,term) 表达式（段前停在 default）。"""
        expr = f"{default:g}"
        for seg in segs:
            st, _d = _st_dur(seg)
            expr = f"if(lt(t,{st:g}),{expr},{term_fn(seg)})"
        return expr

    # 窗口尺寸（黑底）= 裁剪框尺寸（启用裁剪时），否则主视频原始尺寸 W×H。
    # ⚠️ 关键区分（2026-08-30 用户拍板）：窗口=裁剪框大小，内容=完整原始画面。
    #   裁剪只决定「窗口」大小，绝不裁内容；内容缩放基准永远=原始 W×H（不裁剪时 cw=W，一致）。
    _crop = _resolve_crop_size(settings, W, H)
    if _crop:
        cw, ch = _crop
        crop_on = True
    else:
        cw, ch = W, H
        crop_on = False
    # 截取注入（仅精确截取，组合跳转不注入）：
    # 精确截取时输入未 seek，filter 不 trim 会整段解码 → 重型 scale/rotate/overlay 全程跑卡到爆炸，
    # 故链首注入 trim+setpts 把「输出时间线」归零，使下方表达式 t 与 _timeline_convert 一致。
    # 组合跳转(双-ss) 时输入已 -ss 定位 + -t 限制时长（解码只跑截取段），无需再 trim，
    # 反而注入 trim 会把 filter 时间线归零导致运动错位 → 直接传原始 [0:v]（trim_duration=None）。
    # filter_trim_start：精确截取=原始 trim_start（输入未 seek，filter 自行 trim）。
    # trim_duration：输出时长；原始时长=trim_duration*speed_factor（setpts 同时除 speed）。
    _src_inject = ""
    _td = None
    try:
        _td = float(trim_duration) if trim_duration is not None else None
    except (ValueError, TypeError):
        _td = None
    if _td and _td > 0:
        _tdo = _td * sp
        _fts = float(filter_trim_start or 0.0)
        if sp != 1.0:
            _src_inject = f"trim=start={_ffsec(_fts)}:duration={_ffsec(_tdo)},setpts=(PTS-STARTPTS)/{sp:.3f}"
        else:
            _src_inject = f"trim=start={_ffsec(_fts)}:duration={_ffsec(_tdo)},setpts=PTS-STARTPTS"

    _t = tag or ""
    _src_in_lbl = src_label or "[0:v]"
    # base chain：画布模式接管位置/尺寸/旋转 → 关闭 static scale/transpose/rotate；
    # 内容必须是「完整原始画面」（裁剪只缩窗口不缩内容），故 crop_enabled 始终 False。
    # 子视频：前置链（trim/loop/绿幕/色彩…）由调用方构建并通过 base_vf 传入，此处直接用。
    if base_vf is None:
        base_settings = dict(settings)
        base_settings["rotate"] = "none"
        base_settings["scale_enabled"] = False
        base_settings["crop_enabled"] = False
        base_vf = build_video_filter_chain(base_settings, include_subtitle=False,
                                           include_speed=False, include_trim=False,
                                           enhance_settings=settings.get("enhance"),
                                           reverse=False)
    if _src_inject:
        if base_vf and base_vf != "null":
            base_part = f"{_src_in_lbl}{_src_inject}[vt{_t}];[vt{_t}]{base_vf}[v_base{_t}];"
            src = f"[v_base{_t}]"
        else:
            base_part = f"{_src_in_lbl}{_src_inject}[vt{_t}];"
            src = f"[vt{_t}]"
    else:
        if base_vf and base_vf != "null":
            base_part = f"{_src_in_lbl}{base_vf}[v_base{_t}];"
            src = f"[v_base{_t}]"
        else:
            base_part = ""
            src = _src_in_lbl

    # 缩放 s(t)（默认 1.0 = 内容=完整原始画面大小；基准=原始 W×H，与窗口裁剪框大小 cw×ch 无关）
    sc_expr = _nested(segs, lambda s: _interp(s, "scale_start", "scale_end"), 1.0)
    # ⚠️ scale 默认 eval=init 不允许帧变量 t，画布缩放含 t 表达式必须显式 eval=frame，
    # 否则 ffmpeg 报 "Expressions with frame variables 't' are not valid in init eval_mode"
    # （转换命令与预览同此约束，2026-08-30 真实抽帧测试发现并修正）。
    # 透明画布（子视频）必须有 alpha 通道：内容 / 画布底 / 输出全程保持 rgba，
    # 否则 rotate 的 c=black@0 黑角与画布空白处会退化成不透明黑块，直接盖死主视频。
    _rgba = bool(force_rgba) or ("@" in str(canvas_color))
    _sc_expr = f"scale=w='2*round({W}*{sc_expr}/2)':h='2*round({H}*{sc_expr}/2)':eval=frame"
    if _rgba:
        scale_part = f"{src}format=rgba,{_sc_expr}[v1{_t}];[v1{_t}]format=rgba[v1r{_t}]"
        _v1_lbl = f"[v1r{_t}]"
    else:
        scale_part = f"{src}{_sc_expr}[v1{_t}]"
        _v1_lbl = f"[v1{_t}]"

    # 旋转 a(t)（度→弧度，默认 0）
    # 旋转与位置/缩放解耦：rot_start≠rot_end 即动画（即便段 move='still' 也原地旋转），
    # 仍尊重 smooth 曲线偏好；与简易位置 crop 的「想转就填不同值」语义一致（2026-08-30 修正耦合 bug）。
    def _rot_mode(seg):
        if abs(_num(seg, "rot_end") - _num(seg, "rot_start")) < 1e-9:
            return "still"
        _m = _seg_move_mode(seg)
        # 旋转与位置/缩放同曲线：段为 eased 模式时旋转也走该曲线，否则线性
        return _m if _m in ("smoothstep", "ease_in", "ease_out", "ease_in_out") else "move"
    ang_expr = _nested(segs, lambda s: f"({_interp(s,'rot_start','rot_end', _rot_mode(s))})*PI/180", 0.0)
    rot_part = (f"{_v1_lbl}rotate=angle='{ang_expr}'"
                f":ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[v2{_t}]")
    if _rgba:
        rot_part += f";[v2{_t}]format=rgba[v2r{_t}]"
        _v2_lbl = f"[v2r{_t}]"
    else:
        _v2_lbl = f"[v2{_t}]"

    # 方案 A（2026-10-01）：全时段 scale≡1 且 rot≡0 → 内容腿跳过 scale/rotate 节点直连
    # overlay——只动位置的项目不再每帧白算 N 层嵌套 if，命令大幅缩短，并绕开
    # 「px/py 走了 sendcmd、scale/rot 表达式仍撞段数墙」的缺口。px/py 语义不变
    # （内容中心==旋转盒中心，偏移量与盒子尺寸无关，overlay 基项 (main_w-overlay_w)/2
    # 自适应新盒宽）；守卫：W/H 为奇数时旧链 2*round(W/2) 会改尺寸 → 不跳过。
    _cv_static = (
        all(abs(_num(s, "scale_start") - 1.0) < 1e-9
            and abs(_num(s, "scale_end") - 1.0) < 1e-9
            and abs(_num(s, "rot_start")) < 1e-9
            and abs(_num(s, "rot_end")) < 1e-9
            for s in segs if isinstance(s, dict))
        and W % 2 == 0 and H % 2 == 0
    )
    if _cv_static:
        if _rgba:
            scale_part = f"{src}format=rgba[v1r{_t}]"
            _v1_lbl = f"[v1r{_t}]"
        else:
            scale_part = f"{src}null[v1{_t}]"
            _v1_lbl = f"[v1{_t}]"
        rot_part = ""
        _v2_lbl = _v1_lbl

    # 中心偏移 px/py（内容中心相对画布中心的偏移，默认 0 = 居中）
    px_expr = _nested(segs, lambda s: _interp(s, "sx", "ex"), 0.0)
    py_expr = _nested(segs, lambda s: _interp(s, "sy", "ey"), 0.0)
    # ⚠️ bg=color=c=black 是无限源；overlay 默认 eof_action=repeat 会无限循环 → 输出永不结束。
    # shortest=1：当较短输入(v2=内容, 已被 trim 截断为有限时长)结束时, overlay 立即结束 → 精确截断。
    # （此 ffmpeg 版本实测 eof_action=pass/endall 对无限 bg 不生效会卡死, shortest=1 最稳妥。）
    # 遮罩延后融合（2026-09-12 方案 A）：画布模式下遮罩段已从 base chain 摘除
    # （见 _canvas_defers_mask），改由这里在画布段产出之后追加 —— 使其作用在
    # **最终渲染帧**（画布窗口）而非画布之前的内容帧，坐标空间才与遮罩编辑器一致。
    # 做法：画布段输出到临时标签，遮罩段产出再回到 out_label —— 调用方零感知。
    _mask_deferred = bool(append_mask) and _canvas_defers_mask(settings)
    _canvas_out = (out_label + "_pre") if _mask_deferred else out_label
    # sendcmd 接入（关键帧行数 > 阈值；2026-10-01 全量接入）：px/py 改命令文件驱动，
    # sendcmd 挂 overlay 主输入支链（画布底腿）+ overlay 完整别名；缩放/旋转仍走表达式
    # （overlay_w 每帧随 scale 变 → 值内 (main_w-overlay_w)/2 项每帧重求，天然联动）。
    # 值后缀把「居中偏移基项」折进命令值；首命令值作 t=0 占位。
    _cv_sc = None
    if len([s for s in segs if isinstance(s, dict)]) > _wp_sc_rows_limit():
        try:
            _cv_iv = build_canvas_px_intervals(segs, trim_start=ts, speed_factor=sp, ease=ease)
        except Exception:
            _cv_iv = None
        if _cv_iv:
            _cv_sc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                _cv_iv, f"cvp{_t}", target=f"overlay@cvp{_t}",
                suffix_x="+ (main_w-overlay_w)/2", suffix_y="+ (main_h-overlay_h)/2")
    if _cv_sc is not None:
        # sendcmd 输出必须用独立新标签（[bgsc]）再分号接两输入 overlay ——
        # 不能复用 _v2_lbl（那是 rot_part 的输出标签，重定义=丢内容腿，ffmpeg Invalid argument）。
        # 4.3 alpha 主输入 overlay 负坐标 bug：命令值可为负（内容移出画布）→ 加 format=rgb 绕开
        _cv_ovfix = _overlay_sc_fmt_suffix() if _rgba else ""
        ov_part = (f"[bg{_t}]sendcmd=f='{_cv_sc}'[bgsc{_t}];"
                   f"[bgsc{_t}]{_v2_lbl}"
                   f"overlay@cvp{_t}=x='(main_w-overlay_w)/2+({_cv_iv[0][3]:g})'"
                   f":y='(main_h-overlay_h)/2+({_cv_iv[0][4]:g})':shortest=1{_cv_ovfix}[{_canvas_out}]")
    else:
        ov_part = (f"[bg{_t}]{_v2_lbl}overlay=x='(main_w-overlay_w)/2+({px_expr})'"
                   f":y='(main_h-overlay_h)/2+({py_expr})':shortest=1[{_canvas_out}]")
    if _rgba:
        bg_part = f"color=c={canvas_color}:s={cw}x{ch}[bg0{_t}];[bg0{_t}]format=rgba[bg{_t}];"
    else:
        bg_part = f"color=c={canvas_color}:s={cw}x{ch}[bg{_t}];"

    graph = f"{base_part}{bg_part}{scale_part}" + (f";{rot_part}" if rot_part else "") + f";{ov_part}"
    if _mask_deferred:
        _mseg = _build_mask_filter_block(
            settings, _t or "cv", _canvas_out, out_label, ts, sp)
        if _mseg:
            graph += ";" + _mseg
    return graph


def _log_time_order_warn(app, where=""):
    """时间校验（结束须晚于开始）失败 → 日志提示（2026-09-02 用户要求）。

    不做弹窗（打断连续填写、还要多点几次确定）、不清空/不归零用户输入
    （先填起始、比结尾小是常态，用户马上要改结尾）——只日志提示，返回 False 供调用方跳过写入。"""
    try:
        _w = str(where or "").strip()
        if app is not None and hasattr(app, "_append_info_ui"):
            app._append_info_ui(
                f"[时间] {_w}结束时间须晚于开始时间（已保留输入，未写入）")
    except Exception:
        pass
    return False


def _attach_state_clipboard_menu(tree, *, edit_row, get_state, apply_state, can_edit=None):
    """给列表 Treeview 挂右键菜单：「编辑 | 复制起始 / 复制结尾 / 粘贴到起始 / 粘贴到结尾」。

    面向航点/关键帧类列表的「两段之间首尾坐标保持连通」工作流：
    选中上一行右键「复制结尾」→ 选中下一行右键「粘贴到起始」，两步完成连通；
    源端/目标端直接写在菜单项里，无需任何「当前编辑端」切换。

    参数（由调用方按各自行数据模型实现，本函数不关心字段名）：
      edit_row:    () -> None。「编辑」项回调（各窗口现有 _open_row_editor）。
      get_state:   (idx, which) -> (x, y, scale, angle) 或 None；which ∈ {"start","end"}。
      apply_state: (idx, which, x, y, scale, angle) -> None。写回 + 该行刷新（各窗口自定）。
      can_edit:    (idx, which) -> bool。该端是否可操作（still 段结尾与起始同值、航点
                   终点行无结尾坐标——对应菜单项置灰）。缺省恒 True。

    剪贴板由本函数内部持有：**各窗口独立，不跨窗口共享**（行数据模型不同，共享无意义）。
    右键落在行上时：该行已在多选集合内 → 保持多选；否则单选该行再操作（与合并轨道
    右键菜单同体验）。**粘贴支持多选**：Ctrl/Shift 选中多行后「粘贴到起始/结尾」对每行
    可粘贴的行逐行写回（can_edit 置灰语义的行自动跳过）——连通填充 20 行从此两步搞定。
    列表被 set_enabled 整体置灰（如轨迹面板「启用列表轨迹」未勾）时右键不响应。
    返回 {"menu","copy","paste","refresh"} 仅供无头测试驱动，调用方可忽略。
    """
    if can_edit is None:
        def can_edit(idx, which):
            return True

    def _can(idx, which):
        try:
            return bool(can_edit(idx, which))
        except Exception:
            return False

    _clip = [None]   # {"x","y","scale","angle"}

    menu = tk.Menu(tree, tearoff=0)
    I_EDIT, I_CA, I_CB, I_PA, I_PB = 0, 2, 3, 4, 5   # entry 1 = 分隔线

    _sel_idx = lambda: selected_tree_index(tree)

    def _sel_idxs():
        """当前全部选中行索引（升序 int；iid=str(i) 契约同 selected_tree_index）。"""
        out = []
        for iid in tree.selection():
            try:
                out.append(int(iid))
            except (ValueError, TypeError):
                pass
        return sorted(out)

    def _refresh_menu():
        idxs = _sel_idxs()
        has_clip = _clip[0] is not None
        if not idxs:
            ok = {I_EDIT: False, I_CA: False, I_CB: False, I_PA: False, I_PB: False}
        else:
            # 编辑/复制看首行；粘贴看任一选中行可写（多选时部分行 can_edit=False 也照常可用）
            ok = {I_EDIT: _can(idxs[0], "start") or _can(idxs[0], "end"),
                  I_CA: _can(idxs[0], "start"), I_CB: _can(idxs[0], "end"),
                  I_PA: has_clip and any(_can(i, "start") for i in idxs),
                  I_PB: has_clip and any(_can(i, "end") for i in idxs)}
        for entry, enabled in ok.items():
            menu.entryconfigure(entry, state="normal" if enabled else "disabled")

    def _do_copy(which):
        idx = _sel_idx()
        if idx is None or not _can(idx, which):
            return
        kv = get_state(idx, which)
        if not kv:
            return
        _clip[0] = {"x": kv[0], "y": kv[1], "scale": kv[2], "angle": kv[3]}

    def _do_paste(which):
        # 多选批量：对每个选中行独立判定 can_edit 后写回（单选 = 原行为不变）
        for idx in _sel_idxs():
            if _clip[0] is None or not _can(idx, which):
                continue
            s = _clip[0]
            apply_state(idx, which, s["x"], s["y"], s["scale"], s["angle"])

    menu.add_command(label="编辑", command=lambda: edit_row())
    menu.add_separator()
    menu.add_command(label="复制起始", command=lambda: _do_copy("start"))
    menu.add_command(label="复制结尾", command=lambda: _do_copy("end"))
    menu.add_command(label="粘贴到起始", command=lambda: _do_paste("start"))
    menu.add_command(label="粘贴到结尾", command=lambda: _do_paste("end"))

    def _popup(ev):
        with suppress(Exception):
            if "disabled" in tree.state():
                return
        try:
            row = tree.identify_row(ev.y)
            # 右键落在选中集合内 → 保持多选（批量粘贴）；集合外 → 单选该行
            if row and row not in tree.selection():
                tree.selection_set(row)
        except Exception:
            pass
        try:
            _refresh_menu()
            menu.tk_popup(ev.x_root, ev.y_root)
        finally:
            with suppress(Exception):
                menu.grab_release()

    tree.bind("<Button-3>", _popup)
    return {"menu": menu, "copy": _do_copy, "paste": _do_paste, "refresh": _refresh_menu}


def _waypoints_panel(host, waypoints, edit_cb, canvas_w, canvas_h,
                     grab_win=None, video_file=None, ffmpeg_cmd=None, ffprobe_cmd=None,
                     app=None, allow_angle=True, consume_alpha=True):
    """列表轨迹面板（2026-08-27 内嵌版，替代原独立弹窗 _waypoints_dialog）。

    host: 承载面板的父 frame；waypoints: list[dict]，面板内直接修改（引用传递）。
    grab_win: 持有模态锁的父 Toplevel（打开行编辑/时间预览前释放锁、关闭后恢复）。
    allow_angle: False=列表隐藏「起始/结尾角度、起始/结尾缩放」四列（displaycolumns 裁剪，
    行数据 values 照常存 11 列不破坏对齐），行编辑弹窗同藏角度/缩放输入行。用于链路
    不消费 ra/rb/sa/sb 的调用方（如遮罩轨迹）——显示无效数值会误导用户。
    返回 (set_enabled, refresh)：set_enabled 由「启用列表轨迹」勾选驱动整面板置灰/启用；
    refresh 供勾选时种子默认行后刷新。
    沿用原弹窗 UI 约定：弹窗禁用 -topmost；含字面花括号处已转义。"""
    # 列表轨迹行上限（2026-08-30）：默认 15，由「更多设置」可调 1~99；app=None 时回退 15
    MAX_ROWS = 15
    if app is not None:
        try:
            MAX_ROWS = max(1, min(99, int(app.waypoint_max_rows.get())))
        except Exception:
            MAX_ROWS = 15
    MODES = [("move", "平移"), ("hide", "隐藏"), ("spin", "自旋转"), ("end", "终点")]
    EA = [("keep", "保持"), ("hide", "消失"), ("freeze", "定格")]
    # 2026-10-03（用户拍板）：新建行的「结尾坐标」= 起点坐标 + 固定偏移。
    # 起点（xa/ya）严格接上一行结尾（xb/yb）——编辑轨迹时前面坐标才是可信的，必须一脉相承；
    # 结尾仅作初始落位（用户说「大概率会改」），给个小偏移即可：
    # 可视化编辑器 _draw_ghost（≈35507）在起始/结尾完全重合时（still 段）**直接不画**
    # 非活动端幽灵框 → 两端同坐标就只有一个辅助框可见，+10 让两个都露出来。
    # 单位 = 视频帧像素（航点坐标空间见 build_waypoint_expr，默认 sw="w" sh="h"）；
    # 想改成单轴偏移：把其中一个置 0；想回到旧行为（零位移）：两个都置 0。
    _TAIL_DX, _TAIL_DY = 10.0, 10.0

    def _grab_release():
        if grab_win is not None:
            with suppress(Exception):
                grab_win.grab_release()

    def _grab_set():
        if grab_win is not None:
            with suppress(Exception):
                grab_win.grab_set()

    frm = ttk.LabelFrame(host, text="列表轨迹", padding="6")
    frm.pack(fill=tk.BOTH, expand=True)
    frm.grid_columnconfigure(0, weight=1)
    frm.grid_rowconfigure(0, weight=1)

    # ---- 列表 ----
    cols = ("idx", "start", "mode", "end", "btime", "dur", "ea", "ra", "rb", "za", "zb", "oa", "ob")
    headers = ("行", "起始坐标", "移动方式", "结尾坐标", "开始时间", "结束时间", "到期行为", "起始角度", "结尾角度", "起始缩放", "结尾缩放", "起始透明度", "结尾透明度")
    widths = (34, 130, 70, 130, 62, 62, 62, 54, 54, 54, 54, 58, 58)
    # allow_angle=False（遮罩）：displaycolumns 裁掉角度/缩放四列；consume_alpha=False（遮罩）
    # 再裁掉透明度两列——列定义保留（values 仍按 cols 存 13 项），只是不显示；行数据写入逻辑零改动。
    if allow_angle:
        _disp_cols = cols
    else:
        _disp_cols = tuple(c for c in cols if c not in ("ra", "rb", "za", "zb"))
    if not consume_alpha:
        _disp_cols = tuple(c for c in _disp_cols if c not in ("oa", "ob"))
    tree = ttk.Treeview(frm, columns=cols, show="headings", height=6,
                        displaycolumns=_disp_cols)
    for c, h, wdt in zip(cols, headers, widths):
        tree.heading(c, text=h)
        # 弹性列：透明度末列(ob, 显示时) / 角度缩放列(rb,zb) / 遮罩末列(ea) 之一 stretch，
        # 避免窗口拉宽右侧留白；其余列固定宽（含新加的 oa/ob）。
        _stretch = ((c == "ob" and consume_alpha)
                    or (c in ("rb", "zb") and allow_angle)
                    or (c == "ea" and not allow_angle))
        tree.column(c, width=wdt, anchor=tk.CENTER if c != "start" and c != "end" else tk.W,
                    stretch=_stretch)
    vsb = ttk.Scrollbar(frm, orient=tk.VERTICAL, command=tree.yview)
    hsb = ttk.Scrollbar(frm, orient=tk.HORIZONTAL, command=tree.xview)
    tree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
    tree.grid(row=0, column=0, columnspan=5, sticky="nsew")
    vsb.grid(row=0, column=5, sticky="ns")
    hsb.grid(row=1, column=0, columnspan=5, sticky="ew")

    def _blank_click(ev):
        # 点列表空白取消选中（ttk Treeview 默认点空白保持原选中），
        # 使「未选中 → 简易预览回溯全部行」状态可达。点行不干预。
        with suppress(Exception):
            if tree.identify_row(ev.y) == "":
                tree.selection_remove(*tree.selection())
    tree.bind("<Button-1>", _blank_click)

    # 角度编辑已统一收归「可视化位置编辑器」（ra/rb 经 _apply_angle 写回航点），
    # 列表「起始角度 / 结尾角度」两列负责显示；面板内不再另设常驻 Spinbox。

    def _row_values(i, w):
        """行显示值计算（供 _refresh 重建与 _apply 轻量单行更新共用）。"""
        is_end = (w.get("mode") == "end")
        mode = "终点" if is_end else (dict(MODES).get(w.get("mode"), "平移"))
        ea = "" if is_end else dict(EA).get(w.get("end_action"), "保持")
        # 2026-09-03：坐标归整数显示（用户要求去掉过多小数位），数据本身仍保留 float 精度
        sta = f"{int(round(_wp_num(w,'xa'))):d},{int(round(_wp_num(w,'ya'))):d}"
        endc = "" if is_end else f"{int(round(_wp_num(w,'xb'))):d},{int(round(_wp_num(w,'yb'))):d}"
        btm = _fmt_sec6(_wp_num(w,'start')) if not is_end else ""
        dur = _fmt_sec6(_wp_num(w,'start') + _wp_num(w,'dur')) if not is_end else ""
        _ra = f"{_wp_num(w, 'ra', 0):g}"
        _rb = f"{_wp_num(w, 'rb', 0):g}"
        _za = f"{_wp_num(w, 'sa', 1.0):g}"
        _zb = "" if is_end else f"{_wp_num(w, 'sb', 1.0):g}"
        # 透明度：终点行只持有「起始透明度」(oa) 作为尾部保持值，结尾透明度(ob)无意义 → 留空
        # （与缩放 rb/zb 处理一致）；非终点行显示 oa→ob 两列（段内线性插值）。
        _oa = f"{_wp_num(w, 'oa', 1.0):g}"
        _ob = "" if is_end else f"{_wp_num(w, 'ob', 1.0):g}"
        return (i + 1, sta, mode, endc, btm, dur, ea, _ra, _rb, _za, _zb, _oa, _ob)

    def _refresh(select_idx="__keep__"):
        """刷新列表；select_idx 指定选中行；默认保持当前选中（操作后不丢行）。"""
        prev = None
        if select_idx == "__keep__":
            _sel = tree.selection()
            if _sel:
                prev = _opt_int(_sel[0], None)
        elif select_idx is not None:
            prev = select_idx
        tree.delete(*tree.get_children())
        for i, w in enumerate(waypoints):
            tree.insert("", tk.END, iid=str(i), values=_row_values(i, w))
        if prev is not None and 0 <= prev < len(waypoints):
            tree.selection_set(str(prev))
            tree.see(str(prev))
        _update_hint()
        with suppress(Exception):
            _update_time_entries()

    _selected = lambda: selected_tree_index(tree)

    def _open_editor(which):
        row_idx = _selected()
        if alert_if(row_idx is None, "提示", "请先选择一行", 'info'):
            return
        if row_idx < 0 or row_idx >= len(waypoints):
            return
        w = waypoints[row_idx]
        is_end = (w.get("mode") == "end")
        if is_end:
            cx, cy = _wp_num(w, "xa"), _wp_num(w, "ya")
        else:
            cx, cy = (_wp_num(w, "xa"), _wp_num(w, "ya")) if which == "start" else (_wp_num(w, "xb"), _wp_num(w, "yb"))
        _active = [which]   # 可变活动端（内部「起始/结尾」翻转用）
        def _apply_xy(nx, ny):
            if is_end:
                w["xa"], w["ya"] = float(nx), float(ny)
            elif _active[0] == "start":
                w["xa"], w["ya"] = float(nx), float(ny)
            else:
                w["xb"], w["yb"] = float(nx), float(ny)
            _refresh()
        def _apply_angle(na):
            _v = float(na or 0.0)
            if is_end:
                w["ra"], w["rb"] = _v, _v
            elif _active[0] == "start":
                w["ra"] = _v
            else:
                w["rb"] = _v
            _refresh()
        _cur_angle = float(w.get("ra" if (is_end or which == "start") else "rb", 0.0))
        # 2026-09-03：背景帧取该航点自身时间（起点→start，结尾→start+dur），
        # 与「位置、尺寸、旋转」关键帧列表一致（而非固定取视频开头）
        _t0 = _wp_num(w, "start")
        if (not is_end) and which == "end":
            _t0 = _wp_num(w, "start") + _wp_num(w, "dur")
        try:
            edit_cb(row_idx, which, cx, cy, _cur_angle, _apply_xy, _apply_angle,
                    _t0, active_flag=_active, w=w)
        except Exception as e:
            messagebox.showerror("错误", f"无法打开可视化编辑器：{e}")

    # ---- 行操作按钮 ----
    btns = ttk.Frame(frm)
    btns.grid(row=1, column=0, columnspan=5, sticky="ew", pady=(6, 2))
    def _add_row():
        n = len(waypoints)
        if alert_if(n >= MAX_ROWS, "提示", f"最多 {MAX_ROWS} 行", 'info'):
            return
        # 追加到末尾（终点行前），不改变已有行的顺序与时间；上移/下移只交换行序、永不动时间。
        # 2026-10-01：新行 start 改为接「已有最大段尾」（而非末行尾部：列表顺序不保证等于时间顺序，
        # 上移/下移只换行序），避免时间互相交叉——交叉在表达式层是未定义行为（扁平累加会把两段
        # 坐标/倍率逐项相加，实测确认），恒 0.0 意味着一加行就制造交叉。
        # 2026-10-03：新行**坐标**改为接「上一行（插入位置之前那一行）的结尾坐标」，结尾坐标初始
        # = 起点（零位移起步，用户只改结尾即可拼出连续轨迹）。与简易位置 _add_row 同口径——这样
        # 航点列表（文字水印/遮罩/子视频/画中画/画布模式/列表轨迹共用此面板）也具备「首尾相接」，
        # 不再每加一行都从默认 (20,20)→(120,20) 起跳。
        # ⚠️ 2026-10-03 修复「继承坐标被改」：钳制（_lim_*）**只作用于兜底小默认**，
        # 绝不再夹继承值。两个坐标系不一致是根因：行编辑器（_edit_wp_point /
        # _edit_tw_wp_point）传给 _generic_overlay_editor 的画布是**真实帧渲染尺寸**
        # （mw/mh，如 576x1024），而本面板拿到的 canvas_w/canvas_h 是**名义画布**
        # （水印/子视频路径硬编码 1280x720，见 25186 行与 _trajectory_dialog 默认值）。
        # 于是「576x1024 竖屏贴底 y=1024-189=835」被 720-40=680 的名义边界夹回 680 ——
        # 实测 y>680 一律被拉回 680，竖屏下方 1/3 全程无法经由继承落位。
        # 对齐简易位置 _add_row（14384 行起：继承即原样，无任何 clamp）——继承必须保真，
        # 越界与否交由可视化编辑器自行呈现（与上一行行为一致，绝不偷偷改坐标）。
        try:
            _lim_x = max(0.0, float(canvas_w) - 40.0)
        except (TypeError, ValueError):
            _lim_x = 1e9
        try:
            _lim_y = max(0.0, float(canvas_h) - 40.0)
        except (TypeError, ValueError):
            _lim_y = 1e9
        # 取「已有的最大段尾」而非末行尾部：列表顺序不保证等于时间顺序（上移/下移只换行序）
        _prev_end = 0.0
        for _w in waypoints:
            if _w.get("mode") == "end":
                continue        # 终点行不占时间段
            _e = _wp_num(_w, "start") + max(0.0, _wp_num(_w, "dur", 2.0))
            if _e > _prev_end:
                _prev_end = _e
        # 坐标继承：上一行（插入位置之前那一行）的结尾坐标；末行是「终点」行时取倒数第二行。
        # 无上一行（空列表）或上一行是「终点」行 → 退回画布小默认 + 钳制（首行/兜底）。
        if waypoints:
            _pi = len(waypoints) - (2 if waypoints[-1].get("mode") == "end" else 1)
            _prev = waypoints[_pi] if 0 <= _pi < len(waypoints) else None
        else:
            _prev = None
        if _prev is not None and _prev.get("mode") != "end":
            # 继承即保真：直接沿用上一行结尾坐标（简易位置 _add_row 同口径，无 clamp），
            # 仅把非法负值兜成 0。旧实现 min(…, _lim_y) 曾把竖屏 576x1024 的贴底 835
            # 夹成 680（720-40），详见上方注释。
            _sx = max(0.0, _wp_num(_prev, "xb"))
            _sy = max(0.0, _wp_num(_prev, "yb"))
        else:
            # 兜底（空列表 / 上一行是终点行）：小默认 + 钳进名义画布
            _sx, _sy = min(20.0, _lim_x), min(20.0, _lim_y)
        new_row = {"xa": _sx, "ya": _sy, "mode": "move",
                   # 结尾 = 起点 + _TAIL_DX/_TAIL_DY（保真，不按名义画布 1280x720 夹）
                   "xb": _sx + _TAIL_DX, "yb": _sy + _TAIL_DY,
                   "start": _prev_end, "dur": 2.0, "end_action": "keep",
                   "ra": 0.0, "rb": 0.0, "oa": 1.0, "ob": 1.0}
        if n and waypoints[-1].get("mode") == "end":
            waypoints.insert(n - 1, new_row)
            _refresh(n - 1)
        else:
            waypoints.append(new_row)
            _refresh(n)
    def _del_row():
        # 2026-10-01：支持多选批量删除（Ctrl/Shift 选中多行一次删；单选 = 原行为不变）
        idxs = sorted(int(iid) for iid in tree.selection()
                      if str(iid).isdigit())
        if not idxs:
            return
        # 2026-10-01（用户拍板）：一律允许删到空——空列表 = 无轨迹（形状全程静止）。
        # 消费侧已安全：build_waypoint_expr 对空列表返回 5×None（2026-09-17 修）。
        # 此前只有遮罩轨迹能删空，水印列表保留「至少 1 行」守卫——现统一放开。
        # 「启用列表轨迹」勾选时宿主 _ensure_wps 会自动种子一行，无需手动「添加」。
        for _di in reversed(idxs):
            if 0 <= _di < len(waypoints):
                del waypoints[_di]
        if waypoints:
            _refresh(min(idxs[0], len(waypoints) - 1))
        else:
            _refresh(None)   # 空列表：不选中任何行，时间框随之清空
    def _move(delta):
        idx = _selected()
        if idx is None:
            return
        j = idx + delta
        if j < 0 or j >= len(waypoints):
            return
        waypoints[idx], waypoints[j] = waypoints[j], waypoints[idx]
        _refresh()
        tree.selection_set(str(j))

    def _edit_row_dialog(row_idx):
        """整行编辑弹窗：起始坐标 / 移动方式 / 结尾坐标 / 开始时间 / 结束时间 / 到期行为。
        终点行也可在此改回段行（以当前输入为准，选「终点」则只存坐标）。
        2026-08-27：打开前释放父窗模态锁、销毁时归还（grab 卫生，防主程序无法唤醒）。"""
        if row_idx < 0 or row_idx >= len(waypoints):
            return
        w = waypoints[row_idx]
        ed = tk.Toplevel(grab_win)
        ed.title("编辑行")
        ed.transient(grab_win)
        ed.withdraw()

        def _close():
            with suppress(Exception):
                ed.grab_release()
            with suppress(Exception):
                ed.destroy()
            _grab_set()   # 归还父窗模态锁
        ed.protocol("WM_DELETE_WINDOW", _close)
        ef = ttk.Frame(ed, padding="10")
        ef.pack(fill=tk.BOTH, expand=True)
        r = 0

        ttk.Label(ef, text="起始坐标:").grid(row=r, column=0, sticky="e", pady=2)
        _sa = tk.StringVar(value=f"{int(round(_wp_num(w, 'xa'))):d}, {int(round(_wp_num(w, 'ya'))):d}")
        ttk.Entry(ef, textvariable=_sa, width=18).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="移动方式:").grid(row=r, column=0, sticky="e", pady=2)
        _mdisp = tk.StringVar(value=dict(MODES).get(w.get("mode"), "平移"))
        ttk.Combobox(ef, textvariable=_mdisp, values=[d for _v, d in MODES],
                     state="readonly", width=14).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="结尾坐标:").grid(row=r, column=0, sticky="e", pady=2)
        _sb = tk.StringVar(value=f"{int(round(_wp_num(w, 'xb'))):d}, {int(round(_wp_num(w, 'yb'))):d}")
        ttk.Entry(ef, textvariable=_sb, width=18).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="开始时间:").grid(row=r, column=0, sticky="e", pady=2)
        _st = tk.StringVar(value=_ffsec(_wp_num(w, 'start')))
        ttk.Entry(ef, textvariable=_st, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="结束时间:").grid(row=r, column=0, sticky="e", pady=2)
        _en = tk.StringVar(value=_ffsec(_wp_num(w, 'start') + _wp_num(w, 'dur')))
        ttk.Entry(ef, textvariable=_en, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="到期行为:").grid(row=r, column=0, sticky="e", pady=2)
        _edisp = tk.StringVar(value=dict(EA).get(w.get("end_action"), "保持"))
        ttk.Combobox(ef, textvariable=_edisp, values=[d for _v, d in EA],
                     state="readonly", width=14).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        # allow_angle=False（遮罩）：角度/缩放链路不消费，输入行整块不建——
        # 下方 _ok() 的解析+写回段同步判 allow_angle，原有 ra/rb/sa/sb 键原值保留。
        _rta = _rtb = _zma = _zmb = None
        if allow_angle:
            ttk.Label(ef, text="起始角度(度):").grid(row=r, column=0, sticky="e", pady=2)
            _rta = tk.StringVar(value=f"{_wp_num(w, 'ra', 0):g}")
            ttk.Entry(ef, textvariable=_rta, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾角度(度):").grid(row=r, column=0, sticky="e", pady=2)
            _rtb = tk.StringVar(value=f"{_wp_num(w, 'rb', 0):g}")
            ttk.Entry(ef, textvariable=_rtb, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            # 2026-09-04 列表轨迹缩放：sa/sb = 段起点/结尾缩放倍率，段内线性插值。
            # 语义：坐标（起始/结尾坐标）一律指**缩放后**内容盒的左上角 → 缩放锚点=左上角，
            # 与既有「坐标=左上角」一致，x/y 表达式零补偿。终点行只用起始缩放（sb 忽略）。
            ttk.Label(ef, text="起始缩放(倍):").grid(row=r, column=0, sticky="e", pady=2)
            _zma = tk.StringVar(value=f"{_wp_num(w, 'sa', 1.0):g}")
            ttk.Entry(ef, textvariable=_zma, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾缩放(倍):").grid(row=r, column=0, sticky="e", pady=2)
            _zmb = tk.StringVar(value=f"{_wp_num(w, 'sb', 1.0):g}")
            ttk.Entry(ef, textvariable=_zmb, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="1.0=原始尺寸；坐标指缩放后内容盒的左上角",
                      foreground="#5F5E5A").grid(row=r, column=0, columnspan=2, sticky="w", pady=(2, 0))
            r += 1

        # consume_alpha=False（遮罩）：透明度链路不消费，输入行整块不建——
        # 下方 _ok() 解析+写回段同步判 consume_alpha，w 里的 oa/ob 键原值保留。
        _oa_v = _ob_v = None
        if consume_alpha:
            ttk.Label(ef, text="起始透明度(倍):").grid(row=r, column=0, sticky="e", pady=2)
            _oa_v = tk.StringVar(value=f"{_wp_num(w, 'oa', 1.0):g}")
            ttk.Entry(ef, textvariable=_oa_v, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="结尾透明度(倍):").grid(row=r, column=0, sticky="e", pady=2)
            _ob_v = tk.StringVar(value=f"{_wp_num(w, 'ob', 1.0):g}")
            ttk.Entry(ef, textvariable=_ob_v, width=10).grid(row=r, column=1, sticky="w", padx=6)
            r += 1

            ttk.Label(ef, text="0=完全隐形；1=不透明；段内 oa→ob 线性插值",
                      foreground="#5F5E5A").grid(row=r, column=0, columnspan=2, sticky="w", pady=(2, 0))
            r += 1

        def _parse_pt(s):
            try:
                _a, _b = str(s).split(",")
                return float(_a.strip()), float(_b.strip())
            except Exception:
                return None

        def _ok():
            _m = ""
            for _v, _d in MODES:
                if _d == _mdisp.get():
                    _m = _v
                    break
            if alert_if(_m == "end" and row_idx != len(waypoints) - 1, "提示", "「终点」只能作为最后一行", 'info'):
                return
            pa = _parse_pt(_sa.get())
            if alert_if(pa is None, "提示", "起始坐标格式应为 x, y（如 30, 30）", 'info'):
                return
            # allow_angle=False（遮罩）：无输入控件 → 不解析不写回，w 里的 ra/rb/sa/sb
            # 原键原值保留（行编辑只改坐标/时间/方式，不碰链路不消费的字段）。
            if allow_angle:
                _ra_v = _opt_float(_rta.get().strip(), 0.0)
                _rb_v = _opt_float(_rtb.get().strip(), 0.0)
                _za_v = _opt_float(_zma.get().strip(), 1.0)
                _zb_v = _opt_float(_zmb.get().strip(), 1.0)
                w["ra"] = _ra_v
                w["rb"] = _rb_v
                w["sa"] = _za_v
                w["sb"] = _zb_v
            # consume_alpha=False（遮罩）：无输入控件 → 不解析不写回，w 里的 oa/ob 原键原值保留。
            if consume_alpha:
                _oa_val = _opt_float(_oa_v.get().strip(), 1.0)
                _ob_val = _opt_float(_ob_v.get().strip(), 1.0)
                w["oa"] = _oa_val
                w["ob"] = _ob_val
            if _m != "end":
                pb = _parse_pt(_sb.get())
                if alert_if(pb is None, "提示", "结尾坐标格式应为 x, y（如 200, 30）", 'info'):
                    return
                try:
                    _s0 = float(_st.get().strip())
                    _e0 = float(_en.get().strip())
                except (ValueError, TypeError):
                    messagebox.showinfo("提示", "时间应为秒数")
                    return
                # ⚠️ 2026-09-11 修复：本判据原写在 if 块【外】→ 移动方式选「终点」时
                #    _s0/_e0 从未赋值，点「确定」必抛 UnboundLocalError（终点行无时段，不判）。
                if _e0 <= _s0:
                    _log_time_order_warn(app, "[轨迹] ")
                    return
            # 2026-09-03 修复：原 save 代码被上面的 return 压成死代码，
            # 导致普通行点「确定」不落盘、列表不刷新（只能保存工程再重开才看到）。
            # 这里统一把字段写回航点并刷新列表。
            if _m == "end":
                w["mode"] = "end"
                w["xa"], w["ya"] = pa
            else:
                _ea = "keep"
                for _v, _d in EA:
                    if _d == _edisp.get():
                        _ea = _v
                        break
                w["mode"] = _m
                w["xa"], w["ya"] = pa
                w["xb"], w["yb"] = pb
                w["start"] = _s0
                w["dur"] = _e0 - _s0
                w["end_action"] = _ea
            _refresh(row_idx)
            _close()

        ttk.Button(ef, text="确定", command=_ok, width=8).grid(row=r, column=0, sticky="e", padx=(0, 3), pady=(10, 0))
        ttk.Button(ef, text="取消", command=_close, width=8).grid(row=r, column=1, sticky="w", padx=(3, 0), pady=(10, 0))
        # 窗口高随角度/缩放/透明度输入行有无自适应（隐藏角度/缩放/透明度 ≈ 各 50px，含提示行）
        center_window(ed, 300, (340 if allow_angle else 190) + (55 if consume_alpha else 0))
        _grab_release()   # 打开子窗先释放父锁，避免嵌套锁链
        ed.grab_set()

    def _open_row_editor(idx=None):
        if idx is None:
            idx = _selected()
        if alert_if(idx is None, "提示", "请先选择一行", 'info'):
            return
        if idx < 0 or idx >= len(waypoints):
            return
        _edit_row_dialog(idx)

    def _open_time_preview():
        """简易时间预览：选中行 → 主视频帧浏览器（SimplePreviewer）回填 开始/结束时间。
        时间在主视频时间线上点选（与水印位置无关）；on_set_start/on_set_end 换算 start/dur。
        2026-08-28：未选中也能打开（标记/发送到轨迹用，不回填单行），选中则照旧回填。"""
        idx = _selected()
        if idx is not None:
            if idx < 0 or idx >= len(waypoints):
                return
            w = waypoints[idx]
            if alert_if(w.get("mode") == "end", "提示", "终点行没有时间段（移动方式/时间忽略）", 'info'):
                return
        else:
            w = None  # 未选中行：仅预览/标记/发送到轨迹，起点/终点不回填
        if alert_if(not video_file or not os.path.exists(video_file), "错误", "未找到主视频文件，无法时间预览", 'error'):
            return
        if alert_if(not ffmpeg_cmd, "提示", "未找到 ffmpeg，无法预览"):
            return
        _grab_release()

        def _on_start(t):
            if w is None:
                return  # 未选中行：起点仅预览定位，不回填
            w["start"] = float(t)
            _refresh()

        def _on_end(t):
            if w is None:
                return  # 未选中行：终点仅预览定位，不回填
            te = float(t)
            _st = _wp_num(w, "start")
            if te <= _st:
                _log_time_order_warn(app, "[轨迹] ")
                return
            w["dur"] = te - _st
            _refresh()

        def _on_marks_to_waypoints(segs):
            """简易预览标记段 → 轨迹列表「隐藏」行：mode=hide 只需 start/dur
            （build_waypoint_expr 隐藏段表达式不依赖坐标）。追加到末尾（终点行前），
            受 MAX_ROWS 上限约束，超出部分跳过并提示。"""
            added = skipped = 0
            for s, e in segs:
                if e <= s:
                    skipped += 1
                    continue
                if len(waypoints) >= MAX_ROWS:
                    skipped += 1
                    continue
                # 2026-09-22：隐藏行坐标虽不参与表达式，但编辑器红框仍按它画——同样钳进画布
                # （遮罩画布=子视频缩放后尺寸，固定 200 会落到画布外，红框不可见）。
                try:
                    _lim_x = max(0.0, float(canvas_w) - 40.0)
                except (TypeError, ValueError):
                    _lim_x = 1e9
                try:
                    _lim_y = max(0.0, float(canvas_h) - 40.0)
                except (TypeError, ValueError):
                    _lim_y = 1e9
                # 2026-10-03：新建隐藏行坐标也接上一行结尾（编辑器红框位置连续），
                # 与手动「添加」行同口径；隐藏段表达式不依赖坐标，仅影响红框绘制。
                if waypoints:
                    _pi = len(waypoints) - (2 if waypoints[-1].get("mode") == "end" else 1)
                    _prv = waypoints[_pi] if 0 <= _pi < len(waypoints) else None
                else:
                    _prv = None
                if _prv is not None and _prv.get("mode") != "end":
                    # 同手动「添加」行：继承即保真（不再被名义画布 720-40=680 夹回），
                    # 仅把非法负值兜成 0；越界交由编辑器自行呈现。
                    _sx = max(0.0, _wp_num(_prv, "xb"))
                    _sy = max(0.0, _wp_num(_prv, "yb"))
                else:
                    _sx, _sy = min(20.0, _lim_x), min(20.0, _lim_y)
                new_row = {"xa": _sx, "ya": _sy, "mode": "hide",
                           # 同手动「添加」行：结尾 = 起点 + 偏移（隐藏行在编辑器里也画红框，
                           # 坐标对称会导致红框/幽灵框不可分）
                           "xb": _sx + _TAIL_DX, "yb": _sy + _TAIL_DY,
                           "start": float(s), "dur": float(e - s),
                           "end_action": "keep", "ra": 0.0, "rb": 0.0,
                           "oa": 1.0, "ob": 1.0}
                if waypoints and waypoints[-1].get("mode") == "end":
                    waypoints.insert(len(waypoints) - 1, new_row)
                    _refresh(len(waypoints) - 2)
                else:
                    waypoints.append(new_row)
                    _refresh(len(waypoints) - 1)
                added += 1
            # 结果只写主窗口日志，不弹窗（弹窗会让预览窗口沉底、易堆积多个预览）
            if added or skipped:
                msg = f"已追加 {added} 个隐藏段到轨迹列表"
                if skipped:
                    msg += f"（跳过 {skipped} 个：超出 {MAX_ROWS} 行上限或无效）"
                with suppress(Exception):
                    app._append_info_ui("[轨迹] " + msg)

        # 回溯标记段：单选 → 只回该行；未选中（点列表空白取消选中）→ 全部行时段
        if w is not None:
            initial_marks = [(w["start"], w["start"] + w.get("dur", 0))]
        else:
            initial_marks = [(r["start"], r["start"] + r.get("dur", 0)) for r in waypoints]
        try:
            app.show_time_picker(grab_win, video_file, on_set_start=_on_start,
                                 on_set_end=_on_end, initial_marks=initial_marks,
                                 on_send_waypoints=_on_marks_to_waypoints)
        finally:
            _grab_set()

    W4 = 4
    ttk.Button(btns, text="添加", command=_add_row, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="删除", command=_del_row, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="上移", command=lambda: _move(-1), width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="下移", command=lambda: _move(1), width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="编辑", command=_open_row_editor, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="起始坐标…", command=lambda: _open_editor("start"), width=8).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="结尾坐标…", command=lambda: _open_editor("end"), width=8).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="时间预览", command=_open_time_preview, width=8).pack(side=tk.LEFT, padx=1)
    ttk.Label(btns, text="开始:").pack(side=tk.LEFT, padx=(6, 0))
    t_start_var = tk.StringVar()
    t_start_e = ttk.Entry(btns, textvariable=t_start_var, width=7)
    t_start_e.pack(side=tk.LEFT)
    ttk.Label(btns, text="结束:").pack(side=tk.LEFT, padx=(6, 0))
    t_end_var = tk.StringVar()
    t_end_e = ttk.Entry(btns, textvariable=t_end_var, width=7)
    t_end_e.pack(side=tk.LEFT)
    ttk.Label(btns, text="(选中行时间，回车/失焦生效)", foreground="gray").pack(side=tk.LEFT, padx=4)

    _time_owner = [None]   # 时间框当前对应行（写回目标）。2026-08-27：直接点下一行时
    # selection 先变、FocusOut 后触发，若用 _selected() 会把时间写到新点击的行 →
    # 必须锁定 owner，切行/失焦都写回原行。

    def _update_time_entries():
        """手动时间编辑框同步当前选中行（终点行清空）；同时更新 owner。"""
        idx = _selected()
        if idx is None or idx >= len(waypoints) or waypoints[idx].get("mode") == "end":
            t_start_var.set("")
            t_end_var.set("")
            _time_owner[0] = None
            return
        w = waypoints[idx]
        t_start_var.set(_ffsec(_wp_num(w, 'start')))
        t_end_var.set(_ffsec(_wp_num(w, 'start') + _wp_num(w, 'dur')))
        _time_owner[0] = idx

    def _apply_time_entries(_ev=None):
        # 写回目标 = 时间框 owner（原行），不是当前选中行——用户改完时间直接点下一行时
        # selection 已切到新行，用 _selected() 会写错行（2026-08-27 修复）
        idx = _time_owner[0]
        if idx is None or idx >= len(waypoints) or waypoints[idx].get("mode") == "end":
            _update_time_entries()
            return
        w = waypoints[idx]
        try:
            _s = float(t_start_var.get().strip())
            _e = float(t_end_var.get().strip())
        except (ValueError, TypeError):
            _update_time_entries()
            return
        if _e <= _s:
            _log_time_order_warn(app, "[轨迹] ")
            return
        w["start"] = _s
        w["dur"] = _e - _s
        # ⚠️ 2026-08-27 卡死修复：写回后只做单行更新（tree.item），绝不整表 _refresh()。
        # 根因（实证复现）：_refresh() 里 delete 清空 selection 后 selection_set 必排队
        # <<TreeviewSelect>> 异步事件；事件回调 _on_tree_select → _apply_time_entries →
        # 又 _refresh() → 又排队新事件 → 事件队列无限膨胀、Tk 主循环被独占 = 程序卡死
        # （用户症状：添加即卡死；修改时间失焦回写瞬间卡死）。
        # 该事件是异步排队（回调 depth 恒 1），布尔重入守卫挡不住；唯一断点就是
        # 把 _refresh() 从本函数移除——其他按钮（添加/删除/上移/编辑等）仍走 _refresh()，
        # 事件回调里的本函数现在只单行更新、不再触发 selection 变化 → 整条事件链终止。
        with suppress(Exception):
            tree.item(str(idx), values=_row_values(idx, w))
        _update_hint()
        _update_time_entries()

    t_start_e.bind("<Return>", _apply_time_entries)
    t_end_e.bind("<Return>", _apply_time_entries)
    t_start_e.bind("<FocusOut>", _apply_time_entries)
    t_end_e.bind("<FocusOut>", _apply_time_entries)

    # ---- 简易时间预览（甘特条） ----
    prev_cv = tk.Canvas(frm, height=34, bg="#fafafa", highlightthickness=1,
                        highlightbackground="#cccccc")
    prev_cv.grid(row=2, column=0, columnspan=5, sticky="ew", pady=(4, 0))
    prev_lab = ttk.Label(frm, text="", foreground="gray")
    prev_lab.grid(row=3, column=0, columnspan=5, sticky="w")

    HINT = f"≤{MAX_ROWS} 行，每行独立段（可不设终点行）；双击编辑整行；结束时间=开始+持续"
    # 2026-08-29：主视频启用截取/变速 → 轨迹时间按输出时间线（滤镜 t=截取后从 0 起）填
    try:
        _ts0, _sp0 = _main_trim_speed(app)
        if _ts0 > 0 or _sp0 != 1.0:
            HINT += (f" ｜ ⚠ 主视频已截取(起点 {_ts0:.3f}s)/变速(×{_sp0:g})："
                     f"时间按主视频原始时间填，转换时自动换算（无需手动减）")
    except Exception:
        pass

    def _draw_preview():
        prev_cv.delete("all")
        wpx = prev_cv.winfo_width() or 560
        non_end = [w for w in waypoints if w.get("mode") != "end"]
        if not non_end:
            prev_lab.config(text=HINT)
            return
        t_max = max(_wp_num(w, "start") + _wp_num(w, "dur", 1.0) for w in non_end)
        if t_max <= 0:
            t_max = 1.0
        # 按段索引循环调色板配色（相邻段颜色不同，重叠混色才看得见）；隐藏段保留灰色语义
        palette = ["#85B7EB", "#97C459", "#E1A33B", "#B58EDC", "#5FB0B5", "#D98A8A"]

        def seg_color(w, idx):
            if w.get("mode") == "hide":
                return "#B4B2A9"
            return palette[idx % len(palette)]

        x0, x1 = 6, wpx - 6

        def _blend(hexes):
            """重叠区混色：RGB 均值（与简易时间预览段落条一致，无 PIL 依赖）。"""
            try:
                r = g = b = 0
                for hx in hexes:
                    hx = hx.lstrip("#")
                    r += int(hx[0:2], 16); g += int(hx[2:4], 16); b += int(hx[4:6], 16)
                n = len(hexes)
                return "#%02x%02x%02x" % (r // n, g // n, b // n)
            except Exception:
                return hexes[0] if hexes else "#888888"

        def x_of(t):
            return x0 + (t / t_max) * (x1 - x0)

        # 每行时间段 [t0, t0+d0)；重叠区按边界切片做 RGB 均值混色（看出下层段）
        spans = []
        for idx, w in enumerate(non_end):
            t0 = _wp_num(w, "start")
            d0 = max(_wp_num(w, "dur", 1.0), 0.05)
            spans.append((t0, t0 + d0, w, idx))
        bounds = sorted(set([s for s, _e, _w, _i in spans] + [e for _s, e, _w, _i in spans]))
        for k in range(len(bounds) - 1):
            a, b = bounds[k], bounds[k + 1]
            if b <= a:
                continue
            mid = (a + b) / 2.0
            cover = [(w, i) for s, e, w, i in spans if s <= mid < e]
            if not cover:
                continue
            color = _blend([seg_color(w, i) for w, i in cover])
            prev_cv.create_rectangle(x_of(a), 8, max(x_of(b), x_of(a) + 4), 24,
                                     fill=color, outline="#5F5E5A")
        # 每段文字（hide 显示"隐藏"）与起点小三角（纯视觉标记，不绑定点击）
        for s, e, w, i in spans:
            prev_cv.create_text((x_of(s) + x_of(e)) / 2, 16,
                                text="隐藏" if w.get("mode") == "hide" else "",
                                font=("Microsoft YaHei", 8), fill="#2C2C2A")
            ax = x_of(s)
            prev_cv.create_polygon(ax - 4, 8, ax + 4, 8, ax, 14,
                                   fill=seg_color(w, i),
                                   outline="#333333", width=1)
        prev_cv.create_line(x1, 6, x1, 26, fill="#A32D2D", width=2)
        prev_lab.config(
            text=f"{HINT} ｜ 总时长 {t_max:.3f}s（红色竖线=终点；重叠段自动混色，段起点有三角）")

    def _update_hint():
        try:
            _x, _y, _ang, _zoom, _alpha = build_waypoint_expr(waypoints)
            _n = (len(_x) + len(_y) + len(_zoom or "")) // 2 if _x else 0
            prev_lab.config(text=f"{HINT} ｜ 表达式约 {_n} 字符（实测 2400+ 字符仍正常，安全）")
            _draw_preview()
        except Exception:
            pass

    def _on_double(ev):
        # 双击任意行 → 打开整行编辑弹窗（与「编辑」按钮一致）
        iid = tree.identify_row(ev.y)
        if not iid:
            return
        try:
            ri = int(iid)
        except (ValueError, TypeError):
            return
        if ri < 0 or ri >= len(waypoints):
            return
        _open_row_editor(ri)
    def _on_tree_select(*_a):
        # 切行前先提交时间框到 owner 行：用户改完时间直接点下一行时 selection 已切走、
        # FocusOut 晚于 selection 变化，此处兜底先提交原行，再同步新行时间框。
        # （幂等：时间框未改动时提交无效果）
        with suppress(Exception):
            _apply_time_entries()
        _update_hint()
        _update_time_entries()
    tree.bind("<Double-1>", _on_double)
    tree.bind("<<TreeviewSelect>>", _on_tree_select)
    frm.bind("<Configure>", lambda *a: _draw_preview())

    # ---------- 列表右键：编辑 + 复制/粘贴行状态（起始/结尾） ----------
    # 2026-09-12：跨行保持两段连通（上一行结尾 → 下一行起始）。缩放/角度随状态一起带走。
    # 终点行(mode=end)无独立结尾坐标 → 结尾两项置灰；hide/spin 行数据结构完整，照常可用。
    def _wp_state_get(idx, which):
        if idx < 0 or idx >= len(waypoints):
            return None
        w = waypoints[idx]
        # 复制/粘贴状态只搬 位置/缩放/角度（与 _attach_state_clipboard_menu 契约一致：
        # get_state→(x,y,scale,angle) 4 元组）；oa/ob 透明度在整行编辑弹窗改、不随
        # 坐标连通粘贴，apply_state 也只写回 x/y/scale/angle，故此处不返回。
        if which == "end":
            return (_wp_num(w, "xb"), _wp_num(w, "yb"),
                    _wp_num(w, "sb", 1.0), _wp_num(w, "rb", 0.0))
        return (_wp_num(w, "xa"), _wp_num(w, "ya"),
                _wp_num(w, "sa", 1.0), _wp_num(w, "ra", 0.0))

    def _wp_state_apply(idx, which, x, y, sc, ang):
        if idx < 0 or idx >= len(waypoints):
            return
        w = waypoints[idx]
        if which == "end":
            w["xb"], w["yb"] = x, y
            w["sb"] = sc
            w["rb"] = ang
        else:
            w["xa"], w["ya"] = x, y
            w["sa"] = sc
            w["ra"] = ang
        _refresh(idx)   # 与本面板坐标写回路径一致（整表重建+保持选中）

    def _wp_state_can(idx, which):
        if which != "end":
            return True
        try:
            return waypoints[idx].get("mode") != "end"
        except IndexError:
            return False

    _attach_state_clipboard_menu(tree, edit_row=_open_row_editor,
                                 get_state=_wp_state_get, apply_state=_wp_state_apply,
                                 can_edit=_wp_state_can)

    def set_enabled(flag):
        """「启用列表轨迹」勾选驱动：整面板置灰/启用（Treeview/按钮/时间输入框）。
        ⚠️ ttk 组件不支持 configure(state=...)，必须用 state([...]) 方法（TclError 实测）。"""
        tree.state(["disabled"] if not flag else ["!disabled"])
        for _b in btns.winfo_children():
            if not isinstance(_b, ttk.Button):
                continue
            if _b["text"] in ("起始坐标…", "结尾坐标…") and edit_cb is None:
                _b.state(["disabled"])
            else:
                _b.state(["disabled"] if not flag else ["!disabled"])
        t_start_e.state(["disabled"] if not flag else ["!disabled"])
        t_end_e.state(["disabled"] if not flag else ["!disabled"])

    def refresh():
        _refresh()

    _refresh()
    return set_enabled, refresh


def _trajectory_dialog(parent, initial, commit, edit_cb=None, canvas_w=1280, canvas_h=720,
                       video_file=None, ffmpeg_cmd=None, ffprobe_cmd=None, app=None,
                       show_presets=True, allow_angle=True,
                       consume_alpha=True):
    """轨迹控制弹窗公共实现（图片/视频水印与文字水印共用）。
    initial: dict，含 move_mode / move_cycle / move_dwell / move_margin / move_waypoints 初值；
    commit: callable(dict)，点「确定」时把规范化后的新值写回（写 tk 变量或 settings dict 均可）。
    edit_cb: callable(row_idx, which, cur_x, cur_y, cur_angle, apply_xy, apply_angle)，列表模式
    「可视化编辑坐标」回调（None 时列表编辑按钮禁用）。which∈{start,end}；cur_angle=当前选中点
    角度（起点=ra / 终点=rb）；apply_xy(nx,ny)/apply_angle(na) 写回该航点坐标/角度。
    canvas_w/h: 可视化编辑器的画布尺寸（主视频渲染尺寸）。
    show_presets: False=隐藏「运动轨迹」预设动效区（下拉+周期+每点停留+边距）。用于链路
    只消费航点、不消费 move_mode 预设的调用方（如遮罩轨迹）——摆设 UI 会误导用户。
    allow_angle: False=列表隐藏「起始/结尾角度、起始/结尾缩放」四列，行编辑弹窗同藏
    （用于链路不消费 ra/rb/sa/sb 的调用方，如遮罩轨迹）。
    2026-10-01：列表一律允许删到空（空列表 = 无轨迹/形状全程静止），不再按调用方分叉。
    2026-08-27 合并版（用户拍板方案 B）：运动轨迹+周期并成一行；「启用列表轨迹」勾选驱动
    waypoints（勾选后上方下拉自动忽略）；列表轨迹面板常驻（未勾选时整面板置灰禁用），
    不再嵌套「列表轨迹控制」子窗，弹窗层级 4 层 → 1 层。"""
    win = tk.Toplevel(parent)
    win.title("轨迹控制")
    win.withdraw()  # 先隐藏，center_window 自动居中显示
    with suppress(Exception):
        win.transient(parent.winfo_toplevel() if hasattr(parent, "winfo_toplevel") else parent)
        # 注意：grab_set 延后到 center_window(deiconify) 之后执行——withdraw 状态的窗口
        # 若中途异常未显示就带着模态锁，会吞掉全部输入（主程序无法唤醒/关不掉的根因之一）。

    MODES = [
        ("", "无（静态定位）"),
        ("h", "左右往返"),
        ("v", "上下往返"),
        ("diamond", "歪菱形循环"),
        ("corners", "四角跳跃"),
    ]
    # 列表轨迹不再占下拉项：由「启用列表轨迹」勾选框驱动（2026-08-27 合并版）
    mode_disp = tk.StringVar()
    mode_val = tk.StringVar(value=initial.get("move_mode", "") or "")
    if mode_val.get() == "waypoints":
        mode_val.set("")   # 存量 waypoints 数据：勾选框接管，下拉回退默认值
    for _v, _d in MODES:
        if _v == mode_val.get():
            mode_disp.set(_d)
            break
    if not mode_disp.get():
        mode_disp.set(MODES[0][1])
        mode_val.set("")

    frm = ttk.Frame(win, padding="10")
    frm.pack(fill=tk.BOTH, expand=True)
    frm.grid_columnconfigure(0, weight=1)

    # ---- 第 0 行：运动轨迹 + 周期（corners 时原位切换为 每点停留+边距）----
    # show_presets=False（遮罩轨迹）：整块不创建——链路只消费航点，预设动效是摆设 UI。
    # 下游 _sync_params/_apply 对 cb/tip_label/cyc_frm/dwell_frm 的引用全部判 show_presets。
    cb = cyc_frm = dwell_frm = tip_label = None
    if show_presets:
        row0 = ttk.Frame(frm)
        row0.grid(row=0, column=0, sticky="ew", pady=(0, 6))
        ttk.Label(row0, text="运动轨迹:").pack(side=tk.LEFT)
        cb = ttk.Combobox(row0, textvariable=mode_disp, values=[d for _v, d in MODES],
                          state="readonly", width=18)
        cb.pack(side=tk.LEFT, padx=6)

        cyc_frm = ttk.Frame(row0)
        _lbltt1 = ttk.Label(cyc_frm, text="周期(秒):")
        _lbltt1.pack(side=tk.LEFT)
        cyc_var = tk.DoubleVar(value=float(initial.get("move_cycle", 4.0) or 4.0))
        cyc_sb = ttk.Spinbox(cyc_frm, from_=0.5, to=600, increment=0.5, width=7, textvariable=cyc_var)
        cyc_sb.pack(side=tk.LEFT, padx=(2, 0))
        ToolTip(_lbltt1,
                """这里的周期管的是速度：周期越短，水印移动越快。
往返 = 单程来回一次的时间；菱形 = 走完一圈的时间；
四角跳跃不受此周期影响（用下方「每点停留」控制）。
往返无需幅度参数：左右往返自动横跨整个画面宽度（0→W），
上下往返自动纵跨整个画面高度（0→H）。""",
                wraplength=340)
        cyc_frm.pack(side=tk.LEFT, padx=(10, 0))

        dwell_frm = ttk.Frame(row0)
        ttk.Label(dwell_frm, text="每点停留(秒):").pack(side=tk.LEFT)
        dwell_var = tk.DoubleVar(value=float(initial.get("move_dwell", 2.0) or 2.0))
        ttk.Spinbox(dwell_frm, from_=0.2, to=600, increment=0.2, width=7,
                    textvariable=dwell_var).pack(side=tk.LEFT, padx=(2, 10))
        _lbltt2 = ttk.Label(dwell_frm, text="边距:")
        _lbltt2.pack(side=tk.LEFT)
        margin_var = tk.StringVar(value=initial.get("move_margin", "W*0.03") or "W*0.03")
        margin_entry = ttk.Entry(dwell_frm, textvariable=margin_var, width=10)
        margin_entry.pack(side=tk.LEFT, padx=2)
        ToolTip(_lbltt2,
                """四角跳跃时水印离屏幕边缘的距离。
可填像素数（如 20）或相对式（如 W*0.03 = 主画面宽度 3%）。""",
                wraplength=320)

        tip_label = ttk.Label(frm, text="", foreground="gray")
        tip_label.grid(row=1, column=0, sticky="ew", pady=(0, 2))

        # ---- 间隔条 ----
        ttk.Separator(frm, orient=tk.HORIZONTAL).grid(row=2, column=0, sticky="ew", pady=(2, 6))

    if not show_presets:
        # 隐藏预设动效区时 margin/cycle/dwell 三个 var 仍需存在（_apply 统一读回写 commit，
        # NameError 不在 except 捕获范围内）：取 initial 原值透传，不建 UI 控件。
        margin_var = tk.StringVar(value=initial.get("move_margin", "W*0.03") or "W*0.03")
        cyc_var = tk.DoubleVar(value=float(initial.get("move_cycle", 4.0) or 4.0))
        dwell_var = tk.DoubleVar(value=float(initial.get("move_dwell", 2.0) or 2.0))

    # ---- 勾选框：启用列表轨迹 ----
    chk_frm = ttk.Frame(frm)
    chk_frm.grid(row=3, column=0, sticky="ew", pady=(0, 2))
    wp_var = tk.BooleanVar(value=(initial.get("move_mode") == "waypoints"))
    wp_chk = ttk.Checkbutton(chk_frm, text="启用列表轨迹", variable=wp_var)
    wp_chk.pack(side=tk.LEFT)
    ToolTip(wp_chk,
            """勾选后上方的运动轨迹下拉自动忽略（列表轨迹优先）。
列表轨迹：每行=时间段，含平移/隐藏/自旋转与分段到期行为；启用后覆盖全局自旋转。""",
            wraplength=360)



    # ---- 列表轨迹面板（常驻：未勾选时整面板置灰禁用）----
    panel_host = ttk.Frame(frm)
    panel_host.grid(row=4, column=0, sticky="nsew")
    frm.grid_rowconfigure(4, weight=1)

    _wps = initial.get("move_waypoints")
    if not isinstance(_wps, list):
        _wps = []   # 占位：勾选时才种子默认行并写回 initial（不污染未使用列表轨迹的设置）
    _had_wps = initial.get("move_waypoints") is not None   # 打开时原本就有列表 → 确定时总写回
    set_panel_enabled, refresh_panel = _waypoints_panel(
        panel_host, _wps, edit_cb, canvas_w, canvas_h,
        grab_win=win, video_file=video_file, ffmpeg_cmd=ffmpeg_cmd, ffprobe_cmd=ffprobe_cmd,
        app=app, allow_angle=allow_angle,
        # ⚠️ 必须透传：遮罩调用点传 consume_alpha=False（链路不消费 oa/ob），
        # 漏透传则面板拿默认 True → 遮罩轨迹列表仍显示透明度两列（误导用户）。
        consume_alpha=consume_alpha)

    def _ensure_wps():
        """勾选时若列表为空则种子默认行，并写回 initial（WYSIWYG）。"""
        if _wps:
            return
        # 2026-09-22：种子行默认坐标改小（结尾偏移 100）+ 钳进画布——遮罩画布=
        # 子视频缩放后尺寸（画中画默认 320 缩放），旧 xb=400 会落到画布外 →
        # 编辑器红框不可见不可抓。大画布（水印=主视频）min 不触发，行为不变。
        try:
            _lim_x = max(0.0, float(canvas_w) - 40.0)
        except (TypeError, ValueError):
            _lim_x = 1e9
        try:
            _lim_y = max(0.0, float(canvas_h) - 40.0)
        except (TypeError, ValueError):
            _lim_y = 1e9
        _wps.extend([
            {"xa": min(30, _lim_x), "ya": min(30, _lim_y), "mode": "move",
             "xb": min(130, _lim_x), "yb": min(30, _lim_y),
             "start": 0, "dur": 3, "end_action": "keep", "ra": 0.0, "rb": 0.0},
        ])
        initial["move_waypoints"] = _wps
        refresh_panel()

    def _sync_params(*_a):
        for _v, _d in MODES:
            if _d == mode_disp.get():
                mode_val.set(_v)
                break
        wp_on = wp_var.get()
        if wp_on:
            _ensure_wps()
        if show_presets:
            cb.config(state="disabled" if wp_on else "readonly")
        set_panel_enabled(wp_on)
        if not wp_on and show_presets:
            mv = mode_val.get()
            if mv == "corners":
                cyc_frm.pack_forget()
                dwell_frm.pack(side=tk.LEFT, padx=(10, 0))
                tip_label.config(text="（四角跳跃忽略上方设置的位置坐标，自动贴屏幕四角）")
            else:
                dwell_frm.pack_forget()
                cyc_frm.pack(side=tk.LEFT, padx=(10, 0))
                tip_label.config(text="")
    wp_chk.config(command=_sync_params)
    if show_presets:   # cb 仅在预设动效区创建；隐藏时 None，bind 会 AttributeError
        cb.bind("<<ComboboxSelected>>", _sync_params)
    _sync_params()

    def _apply():
        wp_on = wp_var.get()
        vals = {
            "move_mode": "waypoints" if wp_on else mode_val.get(),
            "move_margin": margin_var.get().strip() or "W*0.03",
        }
        vals["move_cycle"] = _opt_float(cyc_var.get(), initial.get("move_cycle", 4.0))
        vals["move_dwell"] = _opt_float(dwell_var.get(), initial.get("move_dwell", 2.0))
        if _had_wps or wp_on:
            # 仅在「打开时原本有列表」或「最终勾选」时写回：避免勾选又取消后
            # 把种子默认行污染进设置（move_mode 非 waypoints 时列表会被忽略）
            _wpsl = initial.get("move_waypoints") or []
            # 确定时静默收敛时间交叉：终点行 mode=="end" 不占时间段，排除在收敛之外
            _seg_i = [i for i, w in enumerate(_wpsl)
                      if (w.get("mode") or "move") != "end"]
            report_seg_clamp("列表轨迹",
                             clamp_seg_overlaps([_wpsl[i] for i in _seg_i]),
                             app, _seg_i)
            vals["move_waypoints"] = _wpsl
        commit(vals)
        win.destroy()

    btn_row = ttk.Frame(frm)
    btn_row.grid(row=5, column=0, sticky="ew", pady=(8, 0))
    btn_row.grid_columnconfigure(0, weight=1)
    btn_row.grid_columnconfigure(2, weight=1)
    ttk.Button(btn_row, text="确定", command=_apply, width=8).grid(row=0, column=0, sticky="e", padx=(0, 3))
    ttk.Button(btn_row, text="取消", command=win.destroy, width=8).grid(row=0, column=1, sticky="w", padx=(3, 0))

    center_window(win, 920, 560)
    with suppress(Exception):
        win.grab_set()   # 延后到 deiconify 之后：withdraw+带锁窗口会吞输入（2026-08-27）


def open_trajectory_dialog(settings, parent, edit_cb=None, canvas_w=1280, canvas_h=720,
                           video_file=None, ffmpeg_cmd=None, ffprobe_cmd=None, app=None):
    """通用轨迹控制弹窗：针对传入的 settings dict 的 move_* 字段读写（文字水印用）。
    与 OverlayPositionFrame._open_trajectory_dialog 共用公共实现 _trajectory_dialog。"""
    _trajectory_dialog(
        parent,
        {"move_mode": settings.get("move_mode", "") or "",
         "move_cycle": settings.get("move_cycle", 4.0),
         "move_dwell": settings.get("move_dwell", 2.0),
         "move_margin": settings.get("move_margin", "W*0.03") or "W*0.03",
         "move_waypoints": settings.get("move_waypoints")},
        lambda v: settings.update(v),
        edit_cb=edit_cb, canvas_w=canvas_w, canvas_h=canvas_h,
        video_file=video_file, ffmpeg_cmd=ffmpeg_cmd, ffprobe_cmd=ffprobe_cmd,
        app=app,
    )




def _majority_audio_params(params):
    """逐维度众数：采样率、声道数、采样格式分别取出现最多的值（≥3 段跟随多数轨）。"""
    from collections import Counter
    sr = Counter(p["sr"] for p in params).most_common(1)[0][0]
    ch = Counter(p["ch"] for p in params).most_common(1)[0][0]
    fmt = Counter(p["fmt"] for p in params).most_common(1)[0][0]
    return {"sr": sr, "ch": ch, "fmt": fmt}


def build_concat_norm_plan(target_w, target_h, target_pix_fmt, target_fps,
                           has_xfade=False, global_norm=False):
    """串行合并「规格归一」参数的落位方案，返回 (pre_norm, post_norm)。

    pre_norm  = 必须写在**每段之前**的滤镜列表（concat 的硬门槛）
    post_norm = 可统一写在**concat 之后一次**的滤镜列表

    global_norm=False（默认 = 历史行为）：6 项全在 pre_norm，post_norm 为空，
                      生成的命令与改动前逐字符一致。
    global_norm=True（精简命令）：段前只留硬门槛，其余挪到 concat 后写一次，
                     命令长度从 6×N 降到 2×N+3（xfade 时 3×N+2）。

    ⚠️ 实测依据（ffmpeg n9.0.1，探针 tests/_probe_concat_global*.py，勿凭直觉改）：
      · scale / setsar = 硬门槛：尺寸或 SAR 不一致时 concat 直接 rc≠0，自动协商救不了。
        且 **scale 会为保持 DAR 而改写 SAR**（320x240→640x360 后 SAR 变 3:4），
        故只要各段缩放比例不同，段前 setsar 就不可省。
      · format / fps / settb = 可后置，输出与逐段归一**逐字段一致**
        （含 yuv420p10le 源：PSNR=inf，concat 自动协商到最宽格式，不丢位深）。
      · setpts **不在此函数内**：它只能段前（后置是整体平移，救不回段内偏移 →
        实测总时长会多出偏移量），由调用方按本段链是否含 trim 决定。
      · xfade 分支 fps **必须段前**：xfade 的 offset 按帧数算、吃帧率，
        帧率不一致直接 `First input link main frame rate do not match` rc≠0。
    """
    fps_str = f"fps={target_fps:.6f}".rstrip('0').rstrip('.')
    if not global_norm:
        # 历史顺序：scale, format, fps, setsar, settb, setpts —— 6 项全部逐段写
        return ([f"scale={target_w}:{target_h}", f"format={target_pix_fmt}", fps_str,
                 "setsar=1", "settb=AVTB", "setpts=PTS-STARTPTS"], [])
    pre = [f"scale={target_w}:{target_h}", "setsar=1"]
    if has_xfade:
        pre.append(fps_str)
        post = [f"format={target_pix_fmt}", "settb=AVTB"]
    else:
        post = [f"format={target_pix_fmt}", fps_str, "settb=AVTB"]
    return (pre, post)


# ================== 滤镜链构建 ==================

# ---------------------------------------------------------------------------
# 区域滤镜（delogo / 局部模糊 / 局部反色 同族）：矩形选区 → 处理 → 贴回原位
# ---------------------------------------------------------------------------
# 并行子图模板：split=2[bg][fg];[fg]crop=..,<滤镜>[bl];[bg][bl]overlay=X:Y
# 新增一个区域效果只需往 _REGION_EFFECT_FILTERS 里加一条，不必再动下面的生成逻辑。
#
# tpl      滤镜串模板，{s} 会被强度值替换；不含 {s} = 无强度参数
# default  强度默认值（有 {s} 时必填）
# neighbor True = 邻域运算（卷积类），走「外扩 bleed」链消除区域边缘的硬接缝
# bleed    外扩像素量 k
# tag      标签前缀（同一 blur_items 内多项并存时不撞标签；n=negate、b=局部模糊）
#
# ⚠️ 边缘接缝（2026-09-07 实测 n9.0.1）：卷积类滤镜在 crop 子图上跑时区域边界取不到
# 真实邻域，与「整帧跑同一滤镜」的结果差 **11.2 dB**（肉眼可见的方块边）；外扩 k px
# 处理完再裁回原尺寸后为 **64.9 dB**（几乎无差）。点运算（negate/hflip/lut…）本来
# 就没有接缝，不必外扩（白白多两次 crop）。
_REGION_EFFECT_FILTERS = {
    # --- 点运算：逐像素，无接缝 ---
    "negate":  {"tpl": "negate",                   "tag": "n"},
    "hflip":   {"tpl": "hflip",                    "tag": "e"},
    "vflip":   {"tpl": "vflip",                    "tag": "e"},
    "swapuv":  {"tpl": "swapuv",                   "tag": "e"},
    "desat":   {"tpl": "hue=s=0",                  "tag": "e"},
    "eq_bright": {"tpl": "eq=brightness={s}",      "tag": "e", "default": "-0.3"},
    "black":   {"tpl": "lutyuv=y=0:u=128:v=128",   "tag": "e"},
    "white":   {"tpl": "lutyuv=y=255:u=128:v=128", "tag": "e"},
    # --- 邻域运算：卷积类，必须外扩 ---
    # （sobel 已删：输出是梯度幅值图，效果强弱完全取决于区域纹理，平滑内容下
    #   近似均匀暗块、肉眼无感（2026-09-07 实测，scale 参数亦无视觉改善），不可靠。）
    "unsharp": {"tpl": "unsharp=5:5:{s}", "tag": "e", "default": "1.5", "neighbor": True, "bleed": 8},
    "avgblur": {"tpl": "avgblur={s}",     "tag": "e", "default": "5", "neighbor": True, "bleed": 24},
    "median":  {"tpl": "median={s}",      "tag": "e", "default": "3", "neighbor": True, "bleed": 8},
}

# 局部模糊（boxblur/gblur）同样是卷积类，局部模式下一并外扩
_REGION_BLUR_BLEED = {"boxblur": 24, "gblur": 24}


def _region_enable_suffix(enable_expr: str, filter_str: str) -> str:
    """区域滤镜的 enable 时间窗后缀。

    ⚠️ 实测（n9.0.1）：**无参滤镜必须用等号** —— `hflip:enable='gt(t,1)'` 直接解析失败
    （No option name near 'gt(t,1)'），`hflip=enable='gt(t,1)'` 才有效；带参滤镜两者皆可。
    统一按「滤镜串里有没有 =」选分隔符，避免每加一个无参滤镜就踩一次这个坑。
    """
    if not enable_expr:
        return ""
    return (":" if "=" in filter_str else "=") + f"enable='{enable_expr}'"


def _region_bleed_geom(x: str, y: str, w: str, h: str, k: int):
    """区域外扩几何，返回 (外扩 crop 串, 裁回 crop 串)。

    贴边区域没法真的外扩（x-k<0、或右侧越过画面），一律交给 min/max 表达式让 ffmpeg
    自己钳制；裁回偏移随之取「实际外扩量」min(x,k)，所以贴边既不会错位，也不会因为
    crop 尺寸越界直接失败（实测：不贴边 / 贴左上 / 贴右下 / 满幅 四种场景均通过）。
    """
    bx = f"max({x}-{k}\\,0)"
    by = f"max({y}-{k}\\,0)"
    ox = f"min({x}\\,{k})"
    oy = f"min({y}\\,{k})"
    bw = f"min({w}+{ox}+{k}\\,iw-{bx})"
    bh = f"min({h}+{oy}+{k}\\,ih-{by})"
    return f"crop={bw}:{bh}:{bx}:{by}", f"crop={w}:{h}:{ox}:{oy}"


def _build_chroma_filter(chroma_settings) -> str:
    """绿幕/纯色抠像滤镜串（chromakey / colorkey），未启用返回 ""。

    公共拼装函数：抠像可能插在滤镜链两处——默认在缩放后（小图抠，性能优）；
    与区域滤镜（delogo/局部效果）同时启用时前置到链首（保证抠像取样以原始画面
    为准，区域内的颜色处理不再破坏抠像）。两个插入点共用同一份参数拼装。
    """
    if not chroma_settings or not chroma_settings.get("chroma_enabled", False):
        return ""
    color = str(chroma_settings.get("chroma_color", "green") or "green")
    if color.startswith("#"):
        color = "0x" + color[1:].upper()
    similarity = _opt_float(chroma_settings.get("chroma_similarity", 0.2), 0.2)
    if similarity <= 0:
        similarity = 0.00001
    blend = _opt_float(chroma_settings.get("chroma_blend", 0.1), 0.1)
    filter_type = str(chroma_settings.get("chroma_filter_type", "chromakey") or "chromakey")
    if filter_type == "colorkey":
        return f"format=rgb24,colorkey={color}:{similarity}:{blend}"
    return f"chromakey={color}:{similarity}:{blend}"


def _effective_blur_items(settings: Dict[str, Any]) -> list:
    """去水印/模糊多区域列表统一出口：blur_items 优先，无列表时回退旧单键。"""
    items = settings.get("blur_items")
    if items:
        return items
    return [{
        "enabled": True,
        "type": settings.get("blur_type", "delogo"),
        "x": str(settings.get("blur_x", "0")).strip(),
        "y": str(settings.get("blur_y", "0")).strip(),
        "w": str(settings.get("blur_w", "100")).strip(),
        "h": str(settings.get("blur_h", "100")).strip(),
        "strength": settings.get("blur_strength", "5"),
        "region_only": settings.get("blur_region_only", False),
        "full_frame": False,
        "enable_start": "", "enable_end": "", "enable_cycle": "", "enable_show": "",
    }]


def _has_region_fx(settings: Dict[str, Any]) -> bool:
    """是否启用了任意去水印/模糊/区域效果项（抠像前置判定用）。"""
    if not settings.get("blur_enabled", False):
        return False
    return any(it.get("enabled", True) for it in _effective_blur_items(settings))


# 2026-09-10：遮罩「形状图」辅助。载入自制黑白图/透明底挡块图当 matte（心形/星星等多边形）。
# 彩色素材约定：alpha 路线按「不透明度」取形状（颜色无关）；黑白亮度路线取亮度。
# 判定某 pix_fmt 是否带 alpha 通道（载入弹窗用 ffprobe 探测后选路线；pal8 可能带 tRANS 也可能
# 不带，无法从 pix_fmt 单独判断 → 保守归入黑白亮度路线，用户可在下拉手动改「透明底挡块」）。
_MASK_SHAPE_ALPHA_PIXFMTS = {
    "rgba", "argb", "bgra", "abgr", "gbrap", "gbrap12le", "gbrap14le",
    "gbrap16le", "gbrap16be", "ya8", "ya16le", "yuva420p", "yuva422p",
    "yuva444p", "yuva444p10le", "yuva444p12le", "yuva444p16le",
}


def _mask_shape_movie_path(path):
    """遮罩形状图路径 → movie 滤镜可用路径；不可用返回 None。

    build_video_filter_chain 是模块级函数拿不到 self._movie_path_safe（实例方法），
    此处独立实现同款两步：反斜杠→正斜杠、冒号双重转义 \\\\（filtergraph 层 + movie 参数层
    各吃一次转义，单层 \\: 会被 graph 解析成裸冒号 → avformat_open_input 'C' 截断，
    与 _movie_path_safe 调用方 .replace(":", "\\\\:") 同款）。路径含 filtergraph 语法字符
    [ ] ' , ; 时（实测无法转义，见 _movie_path_safe 注释）→ 源文件同目录建临时硬链接
    改名（同盘必成功，不复制），登记进 _PREVIEW_LINKS 由程序退出统一清理；失败返回 None。
    """
    if not path or not os.path.exists(path):
        return None
    p = str(path).replace("\\", "/")
    if re.search(r"[\[\]',;]", p):
        try:
            h = hashlib.md5(p.encode("utf-8")).hexdigest()[:12]
            ext = os.path.splitext(p)[1] or ".png"
            target = os.path.join(os.path.dirname(p),
                                  f"ffmpeg_maskshape{h}_cache{ext}")
            if not os.path.exists(target):
                os.link(path, target)
            _PREVIEW_LINKS[str(path)] = target
            p = target
        except OSError:
            return None
    return p.replace(":", "\\\\:")


# 2026-09-11：遮罩「多形状列表」滤镜拼装（方案 B / Option 1）。
# 单一 matte 平面：底色涂满 → 每个形状各成一路独立源（矩形=color= 纯色画布，PNG=movie 载图）
# 缩放后 overlay 到同一块底 matte；非自己时段由 build_waypoint_expr 的 mode=hide 输出
# x/y=-100000 把形状移出画面（瞬切，与 Shotcut 同构）。全程只 format=rgba 一次、blend=multiply 一次，
# 规避「多段 rgba 串联」格式协商坑（tests/_probe_mask_multi_overlay.py 已验证 alpha 无 6% 残留）。
# 依赖（均为模块级）：build_waypoint_expr / _mask_shape_movie_path / _timeline_convert /
# _trim_speed_from_settings / MASK_TRAJ_CANVAS_W/H。
def _build_mask_multi_shape_filters(settings, graph_id="", motion_trim_start=None,
                                    motion_speed_factor=None):
    """遮罩多形状 → 返回滤镜段字符串（已含 format=rgba,split … alphamerge），或 None。

    settings["mask_shapes"] 为列表，每项为 dict：
      mode: "outside"(只露矩形/矩形外透明) | "inside"(矩形透明/矩形处挖孔)  ← 每行独立
      x,y,w,h: 矩形坐标 / 外部形状图目标尺寸（最终渲染帧像素）
      feather: 羽化 sigma（0=硬边）
      enabled: 是否启用（False 跳过）
      t_start,t_end: 激活时间窗（输出时间线秒；t_end<=0 视为全程）
      png 专用: png_path(非空即"外部形状图"), png_type("bw"|"alpha"), png_invert
      可选轨迹: traj_enabled + waypoints（启用时轨迹自管可见性，忽略 t_start/t_end）

    合成规则（2026-09-11：每行独立方向，单 matte 叠加）：
      底 matte 取【首个形状】的方向为基准色，其余形状按列表顺序 overlay（后盖先）——
        · 纯全 outside → 黑底 + 若干白矩形 = 可见区并集
        · 纯全 inside  → 白底 + 若干黑矩形 = 整幅可见、矩形处挖孔
        · 混用 → 列表顺序叠加：先「只露」后「矩形透明」= 在可见区上挖洞（上移/下移调层序）
    """
    _shapes = settings.get("mask_shapes")
    if not isinstance(_shapes, list):
        return None
    _shapes = [s for s in _shapes if isinstance(s, dict) and s.get("enabled", True)]
    if not _shapes:
        return None

    _sfx = graph_id or ""

    def _mode_of(_s):
        _m = str(_s.get("mode", settings.get("mask_mode", "outside")) or "outside").strip()
        return _m if _m in ("outside", "inside") else "outside"

    def _q(_e):
        """给 overlay 的 x/y 表达式加单引号（幂等）。

        ⚠️ 2026-09-11 探针修复：表达式的实参含逗号（gte(t,0)/lt(t,1e+09)），
        滤镜图解析器会把未加引号的逗号当成「下一个滤镜」→ Error parsing filterchain。
        静止窗口分支返回的是裸表达式（轨迹分支自己已带引号），这里统一补引号。
        """
        _s = str(_e)
        if len(_s) >= 2 and _s[0] == "'" and _s[-1] == "'":
            return _s
        return "'" + _s + "'"

    # outside：该矩形涂白（声明可见区）；inside：涂黑（声明透明区/挖孔）
    _base_c = "white" if _mode_of(_shapes[0]) == "inside" else "black"
    # 整帧底色用 lut 画（2026-10-01）：drawbox 在 FFmpeg 4.3 的格式列表不含 gbrp，
    # 协商会在 drawbox 前插 auto_scaler 转进 YUV（黑=Y16）→ extractplanes=g 报
    # "Requested planes not available" 整图初始化失败（用户 4.3 ffplay 预览实测）。
    # lut 直通 gbrp、全版本无转换；r=g=b 全帧填 0/255 与 drawbox t=fill 逐字节等价
    # （n9.0.1 探针 tests/_dbg_mask_lut_probe.py md5 一致）。
    _lut_v = "255" if _base_c == "white" else "0"

    _a, _as, _ml = f"mk{_sfx}a", f"mk{_sfx}as", f"mk{_sfx}ml"
    _bgl = f"mk{_sfx}bgl"
    seg = (
        f"format=rgba,split=3[{_a}][{_as}][{_ml}];"
        # ⚠️ 底色画完后必须 `extractplanes=g`（G 平面逐字节拷贝）再喂 overlay：
        #   本函数一路可能含 movie=（外部形状图），只要图里有 rgb 源，ffmpeg 的格式协商就会把
        #   尾部 format=gray 走成 limited-range 的 RGB→Y = 黑变 16 → 形状外 alpha=16（约 6% 漏光，
        #   子视频整帧浮出一层浅影）。extractplanes=g 是纯平面拷贝（黑=0 精确），与老单形状
        #   PNG 路径同款修法（见 build_video_filter_chain 内「底色用 lutyuv/gbrp+extractplanes」注释）。
        #   2026-09-11 探针 tests/_probe_mask_time_overlap.py 复现并修正。
        f"[{_ml}]format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v},extractplanes=g[{_bgl}];"
    )
    _matte_in = _bgl
    _emitted = 0

    try:
        _cvw = int(float(settings.get("mask_traj_canvas_w", 0) or 0)) or MASK_TRAJ_CANVAS_W
        _cvh = int(float(settings.get("mask_traj_canvas_h", 0) or 0)) or MASK_TRAJ_CANVAS_H
    except (ValueError, TypeError):
        _cvw, _cvh = MASK_TRAJ_CANVAS_W, MASK_TRAJ_CANVAS_H

    if motion_trim_start is not None:
        _ts0 = float(motion_trim_start)
        _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
    else:
        _ts0, _sp0 = _trim_speed_from_settings(settings)
    if not _sp0 or _sp0 <= 0:
        _sp0 = 1.0

    for _i, _sh in enumerate(_shapes):
        # 类型由「外部图路径是否有值」自动判定（UI 不再给类型下拉）：有路径=外部，空=矩形
        _raw = str(_sh.get("png_path", "") or "").strip()
        _typ = "png" if _raw else "rect"
        # 该行自己的着色：outside→白（可见），inside→黑（透明/挖孔）
        _shape_c = "black" if _mode_of(_sh) == "inside" else "white"
        try:
            _w = max(2, int(float(_sh.get("w", 100))))
            _h = max(2, int(float(_sh.get("h", 100))))
        except (ValueError, TypeError):
            _w = _h = 100
        _feather = _opt_float(_sh.get("feather", 0) or 0, 0.0)

        # ---- 形状源（矩形=color= 纯色画布；外部图=movie 载图）----
        _sl2 = f"mk{_sfx}sl{_i}"
        if _typ == "png":
            _ptype = _sh.get("png_type", "bw") or "bw"
            if _ptype not in ("bw", "alpha"):
                _ptype = "bw"
            _safe = _mask_shape_movie_path(_raw)
            if not _safe:
                continue  # 路径不可用，跳过该项（不阻断其余形状）
            _load = "format=rgba,alphaextract" if _ptype == "alpha" else "format=gbrp,extractplanes=g"
            if _sh.get("png_invert"):
                _load += ",negate"
            if _mode_of(_sh) == "inside":
                _load += ",negate"
            _sl = f"mk{_sfx}sl{_i}src"
            seg += f"movie={_safe}[{_sl}];[{_sl}]{_load},scale={_w}:{_h},format=gbrp[{_sl2}];"
            _emitted += 1
        else:
            seg += f"color=c={_shape_c}:s={_w}x{_h},format=gbrp[{_sl2}];"
            _emitted += 1

        # ---- 位置表达式（轨迹 or 静止时间窗）----
        _xe, _ye = _mask_shape_pos_expr(_sh, _cvw, _cvh, _ts0, _sp0)

        # ---- sendcmd 接入（轨迹航点行数 > 阈值；2026-10-01 全量接入）----
        # 挂 overlay 主输入支链（matte 累积链）+ overlay 起完整别名（sendcmd 按别名定向）
        _sc = None
        if _sh.get("traj_enabled") and isinstance(_sh.get("waypoints"), list):
            _sc = _mask_sendcmd_info(
                [w for w in _sh["waypoints"] if isinstance(w, dict)],
                _cvw, _cvh, _ts0, _sp0, f"mk{_sfx}ov{_i}")

        # ---- 羽化（软边）----
        _node = f"[{_sl2}]"
        if _feather > 0:
            _gl = f"mk{_sfx}g{_i}"
            seg += f"[{_sl2}]gblur=sigma={_feather:.1f}[{_gl}];"
            _node = f"[{_gl}]"

        # ---- overlay 到累积 matte ----
        _cur = f"mk{_sfx}m{_i}"
        if _sc is not None:
            _scp, _sx0, _sy0 = _sc
            _scin = f"mk{_sfx}sc{_i}"
            seg += (f"[{_matte_in}]sendcmd=f='{_scp}'[{_scin}];"
                    f"[{_scin}]{_node}overlay@mk{_sfx}ov{_i}=x='{_sx0}':y='{_sy0}'[{_cur}];")
        else:
            seg += f"[{_matte_in}]{_node}overlay=x={_q(_xe)}:y={_q(_ye)}[{_cur}];"
        _matte_in = _cur

    # 唯一一次 format=gray + blend=multiply（主 alpha × matte）+ alphamerge
    _msk, _aa, _am = f"mk{_sfx}msk", f"mk{_sfx}aa", f"mk{_sfx}am"
    if _emitted == 0:
        # 所有形状均无效（如 PNG 路径缺失）且被跳过 → 回退让调用方走旧单形状/无遮罩
        return None
    seg += (
        f"[{_matte_in}]format=gray[{_msk}];"
        f"[{_as}]alphaextract[{_aa}];"
        f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
        f"[{_a}][{_am}]alphamerge"
    )
    return seg


def _mask_shape_pos_expr(sh, cvw, cvh, ts0, sp0):
    """单形状的 overlay x/y 表达式：轨迹形状走 build_waypoint_expr（自管可见性），
    静止形状用合成航点把 t_start~t_end 框成「窗口内显示在 (x,y)、窗口外 hide 移出」。"""
    # 轨迹优先：航点自带 show/hide，忽略 t_start/t_end
    if sh.get("traj_enabled") and isinstance(sh.get("waypoints"), list):
        _wps = [w for w in sh["waypoints"] if isinstance(w, dict)]
        if _wps:
            _xe, _ye, _unused, _unused, _unused = build_waypoint_expr(
                _wps, sw=str(cvw), sh=str(cvh), trim_start=ts0, speed_factor=sp0)
            if _xe and _ye:
                return f"'({_xe})*main_w/{cvw}'", f"'({_ye})*main_h/{cvh}'"
    # 静止窗口：合成单段航点（mode=move + end_action=hide）
    try:
        _t0 = float(sh.get("t_start", 0) or 0)
        _t1 = float(sh.get("t_end", 1e9) or 1e9)
    except (ValueError, TypeError):
        _t0, _t1 = 0.0, 1e9
    if _t1 <= _t0:
        _t1 = _t0 + 0.04
    try:
        _ts_out, _dur_out = _timeline_convert(_t0, _t1 - _t0, ts0, sp0)
    except (ValueError, TypeError):
        _ts_out, _dur_out = _t0, _t1 - _t0
    try:
        _x = float(sh.get("x", 0) or 0)
        _y = float(sh.get("y", 0) or 0)
    except (ValueError, TypeError):
        _x = _y = 0.0
    _wps = [{
        "start": _ts_out, "dur": max(0.04, _dur_out), "mode": "move",
        "xa": _x, "ya": _y, "xb": _x, "yb": _y, "end_action": "hide",
    }]
    _xe, _ye, _unused, _unused, _unused = build_waypoint_expr(_wps)
    return _xe or "0", _ye or "0"


def _mask_sendcmd_info(wps, cvw, cvh, ts0, sp0, tag):
    """遮罩轨迹的 sendcmd 接入信息（航点行数 > 阈值才启用，2026-10-01 全量接入）。

    wps: 已过滤的有效航点 dict 列表（调用方负责 traj_enabled 门控）。
    返回 (转义路径, x0 占位表达式, y0 占位表达式) 或 None（回退表达式路）。
    值域 = 航点画布坐标，经 suffix 在 overlay 侧等比还原（*main_w/cvw，同表达式路）。
    """
    if not wps or len(wps) <= _wp_sc_rows_limit():
        return None
    _iv = build_waypoint_position_intervals(wps, trim_start=ts0, speed_factor=sp0)
    if not _iv:
        return None
    _p = FFmpegBatchGUI._write_waypoint_sendcmd_file(
        _iv, tag, suffix_x=f"* main_w/{cvw}", suffix_y=f"* main_h/{cvh}")
    if _p is None:
        return None
    if _iv[0][2] == "hide":
        _x0 = _y0 = "-100000"
    else:
        _x0 = f"{_iv[0][3]:g}"
        _y0 = f"{_iv[0][4]:g}"
    return _p, f"({_x0})*main_w/{cvw}", f"({_y0})*main_h/{cvh}"


def _outline_hex_to_rgb(_hex):
    """描边颜色 #RRGGBB / #RGB → (r, g, b)；非法返回 None（调用方回落白色）。"""
    _s = str(_hex or "").strip().lstrip("#")
    if len(_s) == 3:
        _s = "".join(_c * 2 for _c in _s)
    if len(_s) != 6:
        return None
    try:
        return tuple(int(_s[_i:_i + 2], 16) for _i in (0, 2, 4))
    except ValueError:
        return None


# 8 邻域位掩码（上下左右 + 四个斜角）/ 4 邻域位掩码（只有上下左右）
_OUTLINE_COORD_8 = 255
_OUTLINE_COORD_4 = 90


def _outline_dilation_seq(n):
    """返回长度 n 的 dilation 邻域序列 —— 用「八角形距离」逼近欧氏圆盘。

    dilation 的结构元素由 coordinates 位掩码决定，形状只有两种：
      · 8 邻域（3x3 方形，L∞ 单位球）：沿轴向外扩 1，沿 45° 外扩 √2=1.414 → 斜边**胖 41%**
      · 4 邻域（菱形，L1 单位球）    ：沿轴向外扩 1，沿 45° 外扩 √2/2=0.707 → 斜边**瘦 29%**
    单独用任一种都会让圆形轮廓变形（实测 dil8 凸边 5/细条 3，dil4 凸边 2/细条 3）。

    要各向同性，需要 n8 次 8 邻域 + n4 次 4 邻域满足：
        轴向 n8 + n4  ==  45° 方向 1.414·n8 + 0.707·n4
      ⇒ n4 ≈ 1.414·n8  ⇒  n8 ≈ n / 2.414
    ⚠️ 所以正确比例是 **4 邻域比 8 邻域多约 41%**，不是 1:1 —— 1:1 简单交替在 n=3 时
      仍有 +0.57px 误差；按本函数分布后残余误差 ≤0.25px（4px 边宽下差 0.1~0.24px）。
    两种邻域用 Bresenham 均匀交错（不能连着排，否则局部方向会先胖后瘦）。
    """
    n = max(1, int(n))
    n8 = int(round(n / 2.414))
    n8 = max(0, min(n, n8))
    if n8 == 0:
        return [_OUTLINE_COORD_4] * n
    if n8 == n:
        return [_OUTLINE_COORD_8] * n
    seq, acc = [], 0
    for _i in range(n):
        acc += n8
        if acc >= n:
            acc -= n
            seq.append(_OUTLINE_COORD_8)
        else:
            seq.append(_OUTLINE_COORD_4)
    return seq


def _build_outline_filter_block(settings, graph_id=""):
    """外轮廓描边滤镜段 —— 返回段字符串，或 None（未启用）。

    原理（2026-10-02 实测，证据 tests/_probe_dilation_vs_morpho.py）：
        ring = 膨胀后的 alpha − 原 alpha          （纯环，blend=all_mode=subtract）
        → 给环染上指定颜色 → overlay 到主体下面（环作底、主体作顶层）→ 只露出主体外一圈。
      ⚠️ 必须是**纯环**：直接把膨胀结果整块填白，会把主体自己的半透明边缘一起染白
        （羽化抠图尤其明显，实测 d=38 处 244,111,111 粉红 vs 纯环 242,69,68）。

    膨胀为什么用 dilation 的 8/4 邻域组合，而不用 morpho 圆盘结构元：
      · 两者原理相同（都是形态学膨胀），morpho 的圆盘是**真正各向同性**的；
        但 morpho 需要第二输入「结构元素图」，必须 movie= 载入一张 PNG，
        而**每个宽度都要一张不同尺寸的**（宽度 1~20 → 20 张），内置要生成/缓存/转义
        一整套文件 —— 且 build_video_filter_chain 是模块级函数，拿不到 self.ffmpeg_cmd，
        连"运行时生成一张"都无从发起进程。
      · dilation 是纯单输入滤镜，宽度只体现在重复次数上，零文件、零转义。
      ⇒ 用 8/4 邻域按比例组合逼近圆盘（见 _outline_dilation_seq），残余误差 ≤0.25px。
        ⚠️ 已知取舍：4px 边宽下圆形/斜边方向实测比直边多约 1px（凸边 5 / 直边 4，
          含斜边 1px 离散测量偏差）。若将来要求绝对等距，改造点只有 _outline_dilation_seq
          的调用处，换成 morpho 即可（需先解决模块级 ffmpeg 进程发起问题）。

    抗锯齿：形态学膨胀是离散硬边（锯齿），必须 gblur σ1.2 + 软阈值过渡带才"丝滑"。
      ⚠️ 实测 AA 恒定让可见边宽 **+2px** ⇒ 膨胀次数 = max(1, 宽度 − 2)。
        宽度 4 → 膨胀 2 次（实测凸边 5/细条 4，去掉斜边 1px 测量偏差即 4）。

    前置（入口 tooltip 已提示）：输入必须已有 alpha —— 抠图结果 / 带透明素材 / 遮罩。
      ⚠️ 输入无 alpha 时 alpha 全 1，膨胀后仍全 1，纯环为空 ⇒ 退化成画面四周一个矩形框。

    段尾**不写输出标签**：build_video_filter_chain 用 ",".join(filters) 拼接，
    无标签时后续元素才能自然接到本段 overlay 的输出上。
    """
    if not settings.get("outline_enabled", False):
        return None
    try:
        _w = int(str(settings.get("outline_width", "4")).strip() or "4")
    except (ValueError, TypeError):
        _w = 4
    _w = max(1, min(20, _w))
    _rgb = _outline_hex_to_rgb(settings.get("outline_color", "#FFFFFF")) or (255, 255, 255)
    _n = max(1, _w - 2)     # AA 恒定 +2px，故膨胀次数 = 宽度 − 2
    _dil = ",".join("dilation=coordinates=%d" % _c for _c in _outline_dilation_seq(_n))
    _s = graph_id or ""
    _a, _b = "ob%s_a" % _s, "ob%s_b" % _s
    _o1, _o2 = "ob%s_o1" % _s, "ob%s_o2" % _s
    _d, _dl = "ob%s_d" % _s, "ob%s_dl" % _s
    _ring, _wt = "ob%s_ring" % _s, "ob%s_w" % _s
    return ("format=rgba,split=2[%s][%s];"
            "[%s]alphaextract,format=gray,split=2[%s][%s];"
            "[%s]%s[%s];"
            "[%s]gblur=sigma=1.2,lut=y='min(255,max(0,(val-8)*255/40))'[%s];"
            "[%s][%s]blend=all_mode=subtract[%s];"
            "[%s]format=rgba,colorchannelmixer=aa=0:ar=1,"
            "lutrgb=r='%d':g='%d':b='%d'[%s];"
            "[%s][%s]overlay"
            % (_a, _b, _a, _o1, _o2, _o1, _dil, _d, _d, _dl,
               _dl, _o2, _ring, _ring, _rgb[0], _rgb[1], _rgb[2], _wt,
               _wt, _b))


def _build_mask_filter_block(settings, graph_id="", in_label=None, out_label=None,
                             motion_trim_start=None, motion_speed_factor=None):
    """遮罩（透明蒙版）滤镜段独立化 —— 返回段字符串，或 None（未启用 / 无有效形状）。

    2026-09-12 方案 A：本函数体 = 原 build_video_filter_chain 链尾的遮罩区块（逐字搬迁，
    只把 `filters.append(seg)` 改成「收集到 _out_seg」，并新增输入/输出标签包装）。
    搬迁动机：遮罩坐标基准 = 打开遮罩窗口时的**最终渲染帧**（crop→rotate→scale 之后）。
    画布模式把 crop/rotate/scale 交给画布段，链尾遮罩会落在「画布前的内容帧」→ 坐标错位，
    表现为「一开画布模式遮罩就失效」。故画布模式下由 build_canvas_filtergraph 在画布段
    产出之后调用本函数（in_label=画布输出、out_label=最终标签），重新落回最终渲染帧。

    in_label=None → 段首不带输入标签（接链内隐式流，即 build_video_filter_chain 的用法）；
    out_label=None → 段尾不带输出标签（同上）。两者都 None 时行为与搬迁前逐字节一致。

    回退链（与搬迁前一致）：多形状列表 → 单形状 PNG → 轨迹挡板 → 静态矩形。
    """
    if not settings.get("mask_enabled", False):
        return None
    _pre = ("[" + in_label + "]") if in_label else ""
    _post = ("[" + out_label + "]") if out_label else ""
    _out_seg = None
    # 2026-09-11：多形状列表优先（mask_shapes 非空且至少一项有效）→ Option 1 单 matte 链路；
    # 否则走下方原有单形状逻辑（PNG / 轨迹挡板 / 静态矩形），完全不变。
    _multi_seg = _build_mask_multi_shape_filters(
        settings, graph_id, motion_trim_start, motion_speed_factor)
    if _multi_seg:
        _out_seg = _multi_seg
    else:
        # ⚠️ 2026-09-11：本行是 mask 分支尾部所有标签（mk{_sfx}a/msk/aa/am）的唯一来源；
        #   漏掉它 → 单形状回退路径（mask_shapes 空/无效）引用未绑定 _sfx 直接抛
        #   UnboundLocalError（base 多形状重构 f2f1a18 曾真实发生）。切勿删除。
        #   守门：tests/_probe_mask_single_fallback.py ＋ tests/_test_mask_base_multi_parity.py。
        _sfx = graph_id or ""
        mx = str(settings.get("mask_x", "0")).strip() or "0"
        my = str(settings.get("mask_y", "0")).strip() or "0"
        mw = str(settings.get("mask_w", "100")).strip() or "0"
        mh = str(settings.get("mask_h", "100")).strip() or "0"
        _mode = settings.get("mask_mode", "outside")  # outside=只露矩形(矩形外透明); inside=矩形透明(矩形外正常)
        # 边缘羽化：matte 生成后追加 gblur 柔化边缘（0=硬边）。2026-09-10 接上对话框 feather 项
        # （此前对话框有 UI/tooltip 但滤镜未消费 mask_feather → 羽化不生效，本次补齐）。
        _feather = _opt_float(str(settings.get("mask_feather", "0")).strip() or "0", 0.0)
        _a, _msk = f"mk{_sfx}a", f"mk{_sfx}msk"
        _aa, _am = f"mk{_sfx}aa", f"mk{_sfx}am"   # alpha 相乘链标签（抠图兼容 2026-09-10）
        # ---- 动态轨迹挡板（2026-09-10 重建）：启用「遮罩轨迹」且有航点时，matte 走 split=3 ——
        # 一路整帧涂底色；一路 crop 出挡板矩形块、整面涂反向色；再 overlay 按 build_waypoint_expr
        # 轨迹表达式移动挡板 → 可选 gblur → format=gray → alphamerge。
        # 挡板移到哪，哪边按 mask_mode 显/隐（outside=擦除式揭示，inside=遮挡式擦除）。
        _traj_on = bool(settings.get("mask_traj_enabled", False))
        _raw_wps = settings.get("mask_waypoints")
        _wps = [w for w in _raw_wps if isinstance(w, dict)] if isinstance(_raw_wps, list) else []
        _cvw = int(_opt_float(settings.get("mask_traj_canvas_w", 0) or 0, 0))
        _cvh = int(_opt_float(settings.get("mask_traj_canvas_h", 0) or 0, 0))
        if not _cvw:
            _cvw = MASK_TRAJ_CANVAS_W
        if not _cvh:
            _cvh = MASK_TRAJ_CANVAS_H
        # ---- 形状图（2026-09-10）：载入自制黑白图/透明底挡块图当 matte（心形/星星等多边形）----
        # 链型：format=rgba,split=2 → 一路 lutyuv 涂底色（outside=黑 inside=白）；movie 载形状图
        # → alpha 源取不透明度（透明底挡块，颜色无关）/ 亮度图取灰度 → scale 到「矩形坐标」宽高
        # → (反转 negate / inside 再 negate) → overlay 贴上 → 可选 gblur 羽化 → format=gray → alphamerge。
        # ⚠️ 底色用 lutyuv 不用 drawbox：movie 引入 rgb 源后格式协商会把 drawbox 拖进 yuva420p，
        #   drawbox 的 black 在 yuv 上=limited 16 → PNG 区域外整圈 alpha=16 漏光
        #   （tests/_verify_mask_png 探针复现）；lutyuv 是查表滤镜恒保持 gray，0 恒 0。
        # ⚠️ movie 单帧 EOF 后 overlay 默认 eof_action=repeat 静止停留（t=2.5s 实测 alpha 不变）。
        # 形状与轨迹挡板两种 matte 语义不叠加：形状图生效时轨迹本轮不参与（日志提示）。
        _png_built = False
        _png_on = bool(settings.get("mask_png_enabled", False))
        _png_raw = str(settings.get("mask_png_path", "") or "").strip()
        if _png_on and _png_raw:
            _ptype = str(settings.get("mask_png_type", "bw") or "bw").strip()
            if _ptype not in ("bw", "alpha"):
                _ptype = "bw"
            try:
                _sw = max(2, int(float(str(settings.get("mask_w", "100")).strip() or "100")))
                _sh = max(2, int(float(str(settings.get("mask_h", "100")).strip() or "100")))
            except (ValueError, TypeError):
                _sw = _sh = 100
            _safe_png = _mask_shape_movie_path(_png_raw)
            if _safe_png:
                _pg = f"mk{_sfx}pgn"
                _shp = f"mk{_sfx}shp"
                _bgl = f"mk{_sfx}bg"
                _ml = f"mk{_sfx}m"
                _as = f"mk{_sfx}as"
                # 底色：outside=只露形状（黑底=透明）；inside=形状透明（白底=显示）
                # gbrp 域画底（RGB 白=255/黑=0 精确）→ extractplanes=g 取 full-range 灰度。
                # ⚠️ gray 域 matte 会被下游 blend 协商转 limited-range YUV（白→235/黑→16），
                # alphamerge 把它当 full-range alpha → 挡板外 6% 透明残留（2026-09-10 E 系列实测）。
                _base_c = "white" if _mode == "inside" else "black"
                # 整帧底色 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                _lut_v = "255" if _base_c == "white" else "0"
                _load = f"movie={_safe_png}[{_pg}];[{_pg}]"
                # rgb 路线：gbrp 取 G 平面（PNG 白=255 精确，gray 域转换会得 limited 白 235）；
                # alpha 路线：alpha 平面天生 full-range，原样保留
                _load += ("format=rgba,alphaextract" if _ptype == "alpha" else "format=gbrp,extractplanes=g")
                if bool(settings.get("mask_png_invert", False)):
                    _load += ",negate"
                if _mode == "inside":
                    _load += ",negate"
                # overlay x/y：启用轨迹且有航点 → 形状沿轨迹移动（心形探照灯/擦除），与矩形挡板
                # 同款等比还原（*main_w/cvw）与同段时间换算（motion_trim_start/speed 或
                # _trim_speed_from_settings）；否则静止在「矩形坐标」。表达式含逗号必须单引号包。
                _png_ox, _png_oy, _png_traj_on = mx, my, False
                _png_sc = None
                if _traj_on and _wps:
                    if motion_trim_start is not None:
                        _pts = float(motion_trim_start)
                        _psp = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
                    else:
                        _pts, _psp = _trim_speed_from_settings(settings)
                    _pxe, _pye, _pws, _pwz, _pwza = build_waypoint_expr(
                        _wps, sw=str(_cvw), sh=str(_cvh), trim_start=_pts, speed_factor=_psp)
                    if _pxe and _pye:
                        _png_ox = f"'({_pxe})*main_w/{_cvw}'"
                        _png_oy = f"'({_pye})*main_h/{_cvh}'"
                        _png_traj_on = True
                        _png_sc = _mask_sendcmd_info(_wps, _cvw, _cvh, _pts, _psp, f"mk{_sfx}png")
                _png_seg = (
                    f"format=rgba,"
                    # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离）：同一 split 输出同时喂
                    # alphaextract(→blend) 和 alphamerge 两条腿会触发 FFmpeg 协商 bug
                    # （alphamerge 报两腿尺寸不匹配=源尺寸，真机 2026-09-10 实测），
                    # split 多一腿隔离后正常
                    f"split=3[{_a}][{_as}][{_ml}];"
                    # 整帧底色 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                    f"[{_ml}]format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v},extractplanes=g[{_bgl}];"
                    f"{_load},scale={_sw}:{_sh},format=gray[{_shp}];"
                )
                if _png_sc is not None:
                    # sendcmd 挂 overlay 主输入支链（底色腿）+ overlay 起完整别名
                    _png_seg += (f"[{_bgl}]sendcmd=f='{_png_sc[0]}'[mk{_sfx}pgsc];"
                                 f"[mk{_sfx}pgsc][{_shp}]overlay@mk{_sfx}png"
                                 f"=x='{_png_sc[1]}':y='{_png_sc[2]}'")
                else:
                    _png_seg += f"[{_bgl}][{_shp}]overlay=x={_png_ox}:y={_png_oy}"
                if _feather > 0:
                    _png_seg += f",gblur=sigma={_feather:.1f}"
                # alpha 相乘（抠图兼容 2026-09-10）：无抠图时 format=rgba 已补 alpha=255
                # → 255×M/255=M 与旧替换语义等效；同开抠图时 = 抠图 alpha × 遮罩 matte（交集）。
                _png_seg += (
                    f",format=gray[{_msk}];"
                    f"[{_as}]alphaextract[{_aa}];"
                    f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                    f"[{_a}][{_am}]alphamerge"
                )
                _out_seg = _png_seg
                _png_built = True
                if _png_traj_on:
                    print(f"[遮罩] 形状图沿轨迹移动：{_png_raw}（路线={_ptype}，大小={_sw}x{_sh}，模式={_mode}，{len(_wps)} 航点）")
                else:
                    print(f"[遮罩] 形状图生效（静止）：{_png_raw}（路线={_ptype}，矩形={mx},{my},{_sw}x{_sh}，模式={_mode}）")
            else:
                print(f"[遮罩] 形状图路径不可用（不存在/含特殊字符且硬链接失败），回退矩形：{_png_raw}")
        _dyn_built = False
        if not _png_built and _traj_on and _wps:
            # 段时间换算与裁剪简易位置同款（2026-08-29：段时间=主视频原始时间 → 换算输出时间线）
            if motion_trim_start is not None:
                _ts0 = float(motion_trim_start)
                _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
            else:
                _ts0, _sp0 = _trim_speed_from_settings(settings)
            _xe, _ye, _ws, _wz, _wza = build_waypoint_expr(
                _wps, sw=str(_cvw), sh=str(_cvh), trim_start=_ts0, speed_factor=_sp0)
            if _xe and _ye:
                # 航点画布（cvw×cvh = 打开遮罩窗口时的最终渲染帧尺寸）→ 实际帧等比还原：
                # x*W/cvw、y*H/cvh，行程比例恒正确、与素材分辨率解耦（见 MASK_TRAJ_CANVAS_* 注释）。
                # x/y 表达式为纯数字累加 → 整体包一层括号乘系数即可，无变量歧义。
                # ⚠️ overlay 的 x/y 变量表里没有 iw/ih（那是 crop/drawbox 的），必须用 main_w/main_h。
                _xf = f"({_xe})*main_w/{_cvw}"
                _yf = f"({_ye})*main_h/{_cvh}"
                # 挡板尺寸同构还原；min 防挡板比帧大（轨迹挡板可拖出画布，但不能大于帧）
                _pw = f"min({mw}*iw/{_cvw},iw)"
                _ph = f"min({mh}*ih/{_cvh},ih)"
                if _mode == "inside":
                    # 矩形透明、矩形外正常：底=white（显示），黑挡板盖住处=透明
                    _base_c, _plate_c = "white", "black"
                else:
                    # 只露矩形（矩形外透明）：底=black（透明），白挡板扫过处=显示（擦除式揭示）
                    _base_c, _plate_c = "black", "white"
                # 整帧底色/挡板底用 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                _lut_v = "255" if _base_c == "white" else "0"
                _lut_pv = "255" if _plate_c == "white" else "0"
                _m0, _p0 = f"mk{_sfx}m0", f"mk{_sfx}p0"
                _as = f"mk{_sfx}as"
                _plt = f"mk{_sfx}plt"
                # sendcmd 接入（航点行数 > 阈值）：挂 overlay 主输入支链（matte 腿）内联 +
                # overlay 起完整别名（2026-10-01 全量接入）
                _dyn_sc = _mask_sendcmd_info(_wps, _cvw, _cvh, _ts0, _sp0, f"mk{_sfx}dyn")
                _msk_chain = f"format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v}"
                if _dyn_sc is not None:
                    _msk_chain += f",sendcmd=f='{_dyn_sc[0]}'"
                _seg1 = (
                    f"format=rgba,"
                    # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离），同 S2 形状图段注释
                    f"split=4[{_a}][{_as}][{_m0}][{_p0}];"
                    # gbrp 域画 matte（RGB 白=255/黑=0 精确）；overlay 同在 gbrp 域，
                    # 尾部 format=gray 转出 full-range 灰度进 blend（gray 域 matte 会被
                    # blend 协商转 limited YUV 白→235/黑→16，2026-09-10 E 系列实测）
                    f"[{_m0}]{_msk_chain}[{_msk}];"
                    f"[{_p0}]crop='{_pw}':'{_ph}':0:0,format=gbrp,"
                    f"lut=r={_lut_pv}:g={_lut_pv}:b={_lut_pv}[{_plt}];"
                )
                # overlay x/y 用单引号包表达式（航点累加表达式内含逗号）；
                # 隐藏段 x=-100000 → 挡板自动移出画面（hide/freeze 语义由 build_waypoint_expr 负责）
                if _dyn_sc is not None:
                    _seg2 = f"[{_msk}][{_plt}]overlay@mk{_sfx}dyn=x='{_dyn_sc[1]}':y='{_dyn_sc[2]}'"
                else:
                    _seg2 = f"[{_msk}][{_plt}]overlay=x='{_xf}':y='{_yf}'"
                if _feather > 0:
                    _seg2 += f",gblur=sigma={_feather:.1f}"
                _seg2 += f",format=gray[{_msk}];"
                # alpha 相乘（同形状图段注释）：抠图 alpha × 遮罩 matte = 交集
                _seg3 = (
                    f"[{_as}]alphaextract[{_aa}];"
                    f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                    f"[{_a}][{_am}]alphamerge"
                )
                _out_seg = _seg1 + _seg2 + _seg3
                _dyn_built = True
        if not _dyn_built and not _png_built:
            # 静态矩形（轨迹未启用 / 无航点 / 表达式构建失败时的兜底，行为与旧版一致）
            if _mode == "inside":
                # 矩形透明、矩形外正常：matte = 白底 + 黑矩形
                _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=white:t=fill,"
                         f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=black:t=fill")
            else:
                # 只露矩形（矩形外透明）：matte = 黑底 + 白矩形
                _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=black:t=fill,"
                         f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=white:t=fill")
            if _feather > 0:
                _draw += f",gblur=sigma={_feather:.1f}"
            _m = f"mk{_sfx}m"
            _as = f"mk{_sfx}as"
            _out_seg = (
                f"format=rgba,"
                # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离），同 S2 形状图段注释
                f"split=3[{_a}][{_as}][{_m}];"
                # gbrp 域画 matte（RGB 白=255/黑=0 精确）→ format=gray 转出 full-range 灰度；
                # gray 域 matte 会被 blend 协商转 limited YUV（白→235/黑→16），
                # alphamerge 当 full-range alpha → 挡板外 6% 透明残留（2026-09-10 E 系列实测）
                f"[{_m}]format=gbrp,{_draw},format=gray[{_msk}];"
                # alpha 相乘（同形状图段注释）：抠图 alpha × 遮罩 matte = 交集
                f"[{_as}]alphaextract[{_aa}];"
                f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                f"[{_a}][{_am}]alphamerge"
            )
    if _out_seg is None:
        return None
    return _pre + _out_seg + _post


# ==================== 图节点（中间标签）工具 —— 2026-09-25 ====================
# 用途：把 -filter_complex 里某个中间标签（例如「主视频叠加完 PNG 之后」）当成一个
# 新的视频素材来处理 —— ①截断到该节点渲染出行焊缝 ②把一段滤镜插到它后面。
#
# 两条硬约束（tests/_verify_graph_node_tap.py 实跑 ffmpeg 得出，改动前务必重读该档案）：
#   ① 标签独占消费：一个标签被下游滤镜消费后，不能再用 -map 把它当输出 —— 会报
#      "Output with label 'x' ... was already used elsewhere" ⇒ 只能「截断」或「split 分流」；
#   ② 命名输出必须有去处：截断 / 删段后悬空的输出标签必须补 nullsink —— 否则报
#      "Filter 'xxx' has output N (...) unconnected"（真实图里 split 分叉极多，一截就悬空）。
#
# 因此本组全部是**纯字符串搬运**：输入一串 filtergraph，输出一串新的 filtergraph，
# 不 import 任何东西、不碰任何 builder、不依赖 app 状态 ⇒ 可直接单元测试。


def graph_split(graph):
    """按 ';' 切成多段，感知单引号保护（drawtext=text='a;b' 里的分号不是分隔符）。"""
    parts, buf, q, esc = [], [], False, False
    for ch in (graph or ""):
        if esc:
            buf.append(ch); esc = False; continue
        if ch == "\\":
            buf.append(ch); esc = True; continue
        if ch == "'":
            q = not q; buf.append(ch); continue
        if ch == ";" and not q:
            parts.append("".join(buf)); buf = []; continue
        buf.append(ch)
    tail = "".join(buf)
    if tail.strip():
        parts.append(tail)
    return [p for p in parts if p.strip()]


def _scan_labels(seg):
    """扫描段内所有**不在单引号内**的 [标签]，返回 [(start, end, name)]（按位置升序）。"""
    res, q, esc, i, n = [], False, False, 0, len(seg)
    while i < n:
        c = seg[i]
        if esc:
            esc = False; i += 1; continue
        if c == "\\":
            esc = True; i += 1; continue
        if c == "'":
            q = not q; i += 1; continue
        if c == "[" and not q:
            j = seg.find("]", i)
            if j == -1:
                break
            res.append((i, j + 1, seg[i + 1:j]))
            i = j + 1
            continue
        i += 1
    return res


def graph_parse_chain(seg):
    """拆一段 → (ins, body, outs)。ins/outs 是标签名（不含方括号），body 是滤镜主体。"""
    labs = _scan_labels(seg)
    ins, pos, k = [], 0, 0
    while k < len(labs) and labs[k][0] == pos:      # 段首连续标签 = 输入
        ins.append(labs[k][2]); pos = labs[k][1]; k += 1
    outs, end, j = [], len(seg), len(labs) - 1      # 段尾连续标签 = 输出
    while j >= k and labs[j][1] == end:
        outs.insert(0, labs[j][2]); end = labs[j][0]; j -= 1
    return ins, seg[pos:end], outs


def _last_top_comma(body):
    """主体内最后一个不在引号内的逗号位置（-1=没有）。"""
    q, esc, res = False, False, -1
    for i, c in enumerate(body):
        if esc:
            esc = False; continue
        if c == "\\":
            esc = True; continue
        if c == "'":
            q = not q; continue
        if c == "," and not q:
            res = i
    return res


def chain_last_filter(body):
    """取主体里最后一个滤镜名（用于给节点生成可读名/指纹）。"""
    if not body:
        return ""
    i = _last_top_comma(body)
    tail = body[i + 1:] if i >= 0 else body
    return tail.split("=", 1)[0].strip().lstrip("-")


def graph_nodes(graph):
    """列出可作为节点（在其后插入滤镜）的候选 → [(段序号, 输出标签名, 末滤镜名)]。

    只收「恰好一个输出标签」的段：多输出即分叉（split），语义不明，本轮不支持。
    """
    nodes = []
    for i, seg in enumerate(graph_split(graph)):
        _ins, body, outs = graph_parse_chain(seg)
        if len(outs) == 1:
            nodes.append((i, outs[0], chain_last_filter(body)))
    return nodes


def graph_nodes_full(graph):
    """graph_nodes 的扩展：额外返回段主体（用于判别视频/音频段）。

    返回 [(段序号, 输出标签名, 末滤镜名, 主体)]，只收「恰好一个输出标签」的段。
    """
    out = []
    for i, seg in enumerate(graph_split(graph)):
        _ins, body, outs = graph_parse_chain(seg)
        if len(outs) == 1:
            out.append((i, outs[0], chain_last_filter(body), body))
    return out


# 音频段判定用的滤镜 token（含 = 的是带参滤镜名，避免误命中其它词）
_AUDIO_FILTER_TOKENS = (
    "anull", "amix", "acrossfade", "atrim", "adelay", "asetpts", "aformat",
    "aresample", "apad", "pan=", "bass=", "treble=", "equalizer=", "afftdn",
    "arnndn", "highpass=", "lowpass=", "loudnorm", "volume=", "acompressor",
    "aecho", "anlmdn", "acontrast", "dynaudnorm", "silenceremove", "asetrate",
    "achannelmap", "ajoin", "amerge", "asplit", "anullsrc", "anullsink",
    "areverse", "aphaser", "agate", "aemph", "adeclick", "adeclip",
)


def is_audio_segment(body):
    """判断一段 filter 主体是否为「音频段」（视频/音频节点对话框据此互相排除）。

    判别依据：①显式音频拼接标记 v=0:a=1 / a=1:v=0；②音频专用滤镜 token；
    ③aformat/aresample（音频归一）。视频段（overlay/scale/crop/format…）不含这些 → 判为视频。
    """
    b = (body or "").lower()
    if "v=0:a=1" in b or "a=1:v=0" in b:
        return True
    if "aformat=" in b or "aresample" in b:
        return True
    for _t in _AUDIO_FILTER_TOKENS:
        if _t in b:
            return True
    return False


def node_fingerprint(seg_index, last_filter, dup=0):
    """节点指纹 —— 「段序号 + 末滤镜名」。

    ⚠️ 为什么不用标签名当持久化 key：标签是随开关增减的 f-string（v_out_{i} / v_temp_{i}…），
    同一「第 N 步」在不同配置下名字会变 ⇒ 存了也对不上。改用位置+滤镜名作指纹，
    配置变了就自然失配 → 由调用方日志提示并跳过，绝不静默插到错误位置。
    """
    base = "#%d:%s" % (seg_index, last_filter or "null")
    return base if not dup else "%s#%d" % (base, dup)


def node_key_alias(base_nodes, target_nodes):
    """把「base 图」算出的节点指纹重锚到「target 图」的标签 → {指纹: 标签}。

    为什么需要：同一个「第 N 步」在两张图里**段序号常常不同**。正式命令图与预览图
    （mpv/ffplay 以及管道）是两套构图（预览多了 movie= 源段、trim 收尾段、末尾 null
    段等），于是直接拿各自算出的「#段序号:末滤镜名」互相对齐一定会大量落空
    （实测：3 个节点里只有主链那个对得上）。

    折中口径 —— **只按「同名末滤镜的第 n 次出现」对齐，且要求该滤镜名在两张图里出现
    次数完全相同**：次数不同说明这一层的结构真的变了（例如预览把某环节展开成多段），
    此时不给结果，由调用方按「处理链已变化」提示跳过。宁可不生效，也绝不插到别的节点上。

    精确相同的 key 由调用方**优先**使用，本函数只负责补齐没命中的那些。

    返回 {指纹: (标签, 段序号)}（2026-09-26 起带段序号）：PiP 级联 amix 的同名标签
    [amain] 顺序复用时，只拿标签名没法区分「第 n 个 amain」→ 调用方须按段序号插入
    （insert_after_at），否则永远命中第一个。
    """
    out = {}
    if not base_nodes or not target_nodes:
        return out
    tgt_by_f, base_cnt = {}, {}
    for _i, _n, _f in target_nodes:
        tgt_by_f.setdefault(_f, []).append((_n, _i))
    for _i, _n, _f in base_nodes:
        base_cnt[_f] = base_cnt.get(_f, 0) + 1
    seen = {}
    for _i, _n, _f in base_nodes:
        _nth = seen.get(_f, 0)
        seen[_f] = _nth + 1
        _lst = tgt_by_f.get(_f) or []
        if len(_lst) != base_cnt[_f]:      # 该滤镜层在两张图里数量不对等 → 不猜
            continue
        if _nth < len(_lst):
            out[node_fingerprint(_i, _f)] = _lst[_nth]   # (标签, 段序号)
    return out


def truncate_at(graph, label):
    """方案A 截断：丢掉该标签之后的所有段，让它变成末节点（这样就能 -map 了）。"""
    segs = graph_split(graph)
    for i, seg in enumerate(segs):
        _ins, _body, outs = graph_parse_chain(seg)
        if label in outs:
            return ";".join(segs[:i + 1])
    return None


def dangling_labels(graph):
    """图中「产出但无人消费」的输出标签（末段的输出=图的出口，不算悬空）。"""
    segs = graph_split(graph)
    produced, consumed = [], set()
    for i, seg in enumerate(segs):
        ins, _body, outs = graph_parse_chain(seg)
        consumed.update(ins)
        for o in outs:
            produced.append((i, o))
    last_i = len(segs) - 1
    return [o for i, o in produced if o not in consumed and i != last_i]


def add_nullsinks(graph, keep=None):
    """给悬空标签补 nullsink（约束②）。keep = 你自己要 -map 的那个，不给它补。"""
    dang = [d for d in dangling_labels(graph) if d != keep]
    if not dang:
        return graph
    extra = ";".join("[%s]nullsink" % d for d in dang)
    return "%s;%s" % (graph, extra) if graph else extra


def insert_after(graph, label, effect, tmp_suffix="_nf"):
    """在定义 label 的段后面插入一段滤镜。

    手法就是用户说的那句：把原输出改名成临时标签 → effect 接上 → 产出还原成原名。
    effect 可以是多段串（局部模糊之类的带标签子图就是这样）；只改「入口/出口」两端，
    内部自带标签原样并入。找不到或不满足前置条件返回 None（调用方负责提示）。
    """
    segs = graph_split(graph)
    for i, seg in enumerate(segs):
        ins, body, outs = graph_parse_chain(seg)
        if len(outs) != 1 or outs[0] != label:
            continue
        eff_segs = graph_split(effect)
        if not eff_segs:
            return None
        tmp = label + tmp_suffix
        new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
        eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])
        eff_segs[-1] = "%s[%s]" % (eff_segs[-1], label)
        return ";".join(segs[:i] + [new_seg] + eff_segs + segs[i + 1:])
    return None


def insert_after_at(graph, seg_index, effect, tmp_suffix="_nf"):
    """在指定段序号的段后面插入滤镜（insert_after 的按位版本）。

    为什么需要（2026-09-26）：PiP 级联 amix 的每个段输出都叫 [amain]（同名标签
    顺序复用），insert_after 按标签名找只会命中第一个 —— 用户在「音频节点」里选
    最后一个 amain，效果却插到第一个后面。按段序号（graph_split 下标）定位天然
    精确：指纹「段序号+末滤镜名」里的段序号在这里真正派上用场。
    手法与 insert_after 完全一致：原输出改名临时标签 → effect 接上 → 还原原名。
    段序号越界 / 该段输出不是单标签（分叉）/ effect 为空 → 返回 None（调用方提示）。
    """
    segs = graph_split(graph)
    if not (0 <= seg_index < len(segs)):
        return None
    ins, body, outs = graph_parse_chain(segs[seg_index])
    if len(outs) != 1:
        return None
    eff_segs = graph_split(effect)
    if not eff_segs:
        return None
    tmp = outs[0] + tmp_suffix
    new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
    eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])
    eff_segs[-1] = "%s[%s]" % (eff_segs[-1], outs[0])
    return ";".join(segs[:seg_index] + [new_seg] + eff_segs + segs[seg_index + 1:])


def _uc_seg_parts(seg):
    """段 → (ins, outs, body_span)，ins/outs 元素形如 (名字, 起, 止)（位置升序）。

    ⚠️ 分区口径与 graph_parse_chain **完全一致**（段首连续 = 输入、段尾连续 = 输出），
       差别只是把方括号的起止位置也带出来：改标签名必须按位置替换，
       拿子串 replace 会误伤参数文本里的方括号（drawtext 的 text='[' 之类）。
    """
    labs = _scan_labels(seg)
    ins, pos, k = [], 0, 0
    while k < len(labs) and labs[k][0] == pos:
        ins.append((labs[k][2], labs[k][0], labs[k][1])); pos = labs[k][1]; k += 1
    outs, end, j = [], len(seg), len(labs) - 1
    while j >= k and labs[j][1] == end:
        outs.insert(0, (labs[j][2], labs[j][0], labs[j][1])); end = labs[j][0]; j -= 1
    return ins, outs, (pos, end)


def graph_labels(graph):
    """图里已用到的**输出标签名**列表（去重保序）—— 自定义子图重名检查用。

    为什么要在写入前查：用户在自定义命令里写的标签若撞上主图已有的标签名，
    ffmpeg 会拒绝整条链（"multiple outputs with the name 'b'"），而报错只会甩一个
    陌生行号 ⇒ 自定义功能本来就是给高级用户的，但**提前把冲突点说清楚**不算替他兜底。
    """
    out = []
    for seg in graph_split(graph):
        for o in graph_parse_chain(seg)[2]:
            if o not in out:
                out.append(o)
    return out


def insert_effect_subgraph(graph, seg_index, effect, tmp_suffix="_uc_"):
    """在指定段后插入一条**允许带 [标签] / 用分号分多段**的自定义子图。

    2026-10-03 起：节点「自定义命令」开放标签（方案 B —— 保留用户写的标签，撞名/悬空只提示）。

    ⚠️ insert_after_at 为什么接不住：它的手法是「原输出改名 tmp → effect 前置 [tmp] →
       末段**追加**一个输出标签」，只覆盖「effect 恰好一段、零标签」这一种形状；
       effect 里但凡出现标签就必炸（More input/output link labels）。本函数补四件事：

      1. **入口注入**：首段若自带输入标签 → 把**第一个**换成 tmp（入口只能有一个，
         否则 ffmpeg 报 More input link labels）；没有 → 前置 `[tmp]`。
      2. **出口收口**：末段**改名**它最后一个输出标签成节点原标签（不是「追加」——
         追加会让末段多一个输出 ⇒ More output link labels）；没有输出标签 → 追加。
      3. **中段接线**：第 k 段没有输出标签、第 k+1 段却写了入口标签 → 把第 k+1 段的那个
         入口标签**上移**成第 k 段的输出（漏写输出标签最常见的就断在这里）。反过来
         「第 k 段输出 [12313]、第 k+1 段却写 [999]」→ 记为悬空引用，只提示、不改名。
      4. **多余输出接 nullsink**：末段除收口外还有没人接的输出（如写了 `[uc][uc2]`）→
         `[x]nullsink`（承既有约束②），并明确提示「这条支线画面不会进入最终输出」——
         ⚠️ 不静默吞：只补 nullsink 而不说，就是「错误找不到 + 效果丢失」的组合。

    返回 (新图, 提示列表)：
      - 新图为 None 表示插不进去（段序号越界 / 该段不是单输出 / effect 空）；
      - 提示列表 list[str] 全是**警告**，不拦、不改名 —— 用户原话「都已经用自定义了，
        默认高级用户，后果自负」；但凡我们替他动过标签的地方必须说清楚改了什么，
        否则「我写什么就跑什么」的直觉会变成排障噩梦。
    老写法（纯逗号链 / 无标签）走这里同样跑得通、提示为空 ⇒ 老工程零回归。
    """
    segs = graph_split(graph)
    if not (0 <= seg_index < len(segs)):
        return None, []
    ins, body, outs = graph_parse_chain(segs[seg_index])
    if len(outs) != 1:
        return None, []
    eff_segs = graph_split(effect)
    if not eff_segs:
        return None, []
    node_label = outs[0]
    tmp = node_label + tmp_suffix
    warn = []

    info = [_uc_seg_parts(s) for s in eff_segs]

    # 老形状（单段、入/出都没有标签）= 纯逗号滤镜链 = insert_after_at 支持的那种 ⇒ 直接复用，
    # 连临时标签后缀都用它的 "_nf"，老工程生成的图逐字节等价（零回归的第一道保险）。
    if len(eff_segs) == 1 and not info[0][0] and not info[0][1]:
        return insert_after_at(graph, seg_index, effect, "_nf"), []

    # ⚠️ 位置锚点一律**现场重算**，绝不复用开头的 info：下面的手法会来回改 eff_segs
    #    （前置 [tmp] / 把入口标签提到上一段 / 末段改名），任何一步改完，之前存下来的
    #    起止位置就整体错位 —— 实测踩过（2026-10-03）：末段写成 [uc][uc2] 时，前置 [b_uc_]
    #    之后旧位置切片把命令切成 "…:h[b]c][uc2]"，一条本来能跑的命令被改废。
    def _parts(i):
        return _uc_seg_parts(eff_segs[i])

    # ---- 1. 入口注入 ----
    _p0 = _parts(0)
    if _p0[0]:
        _nm, _s, _e = _p0[0][0]
        if _nm != tmp:
            eff_segs[0] = eff_segs[0][:_s] + "[%s]" % tmp + eff_segs[0][_e:]
            warn.append("第 1 段的入口标签 [%s] 已换成接本节点上游（[%s]）。" % (_nm, tmp))
        if len(_p0[0]) > 1:
            warn.append("第 1 段还带了 %d 个入口标签（[a][b] 形式），请确保它们是你图里真实存在的输出。"
                        % (len(_p0[0]) - 1))
    else:
        eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])

    # ---- 3. 中段接线（放在入口注入之后：第一段刚被改过）----
    #     _produced = 到当前为止「已经被某段产出」的标签名。悬空判据是「引用了但没人产出」，
    #     不是「和紧邻那段的输出名对不上」—— 分叉（split=2[a][p] 后紧跟 [p]delogo）这种
    #     完全正常的写法，用「对不上」判会一路刷屏自相矛盾的假警告。
    _produced = set(_nm for _nm, _a, _b in _parts(0)[1])
    for _k in range(len(eff_segs) - 1):
        _cur = _parts(_k)
        _n_ins = _parts(_k + 1)[0]
        if _n_ins:
            if not _cur[1]:
                _nm, _s, _e = _n_ins[0]
                # ⚠️ 2026-10-03 修「局部模糊在节点里标签必错」：这个标签若**已经被前面的段
                #    产出过**（典型 = 局部模糊的 split=2[bg][fg] 正好产出了下一段要接的 [fg]），
                #    上移就会造出第二个同名输出 ⇒ ffmpeg 拒（"multiple outputs with the
                #    name"）。这种其实是用户自己把分叉接好了，链本来就通 —— 一个字都不动。
                if _nm in _produced:
                    _produced |= set(_nm for _nm2, _a2, _b2 in _parts(_k)[1])
                    continue
                eff_segs[_k] = eff_segs[_k] + "[%s]" % _nm
                eff_segs[_k + 1] = eff_segs[_k + 1][:_s] + eff_segs[_k + 1][_e:]
                _rest = len(_n_ins) - 1
                warn.append("第 %d 段没写输出标签，已把第 %d 段的入口标签 [%s] 提上来当它的输出%s。"
                            % (_k + 1, _k + 2, _nm,
                               ("（第 %d 段其余入口标签保持原样）" % (_k + 2)) if _rest else ""))
            _produced |= set(_nm for _nm, _a, _b in _parts(_k)[1])
            _left = [x for x in _n_ins if x[0] not in _produced]
            if _left:
                warn.append("第 %d 段引用了标签 [%s]，但前面的段并没有输出它 → 这条支线会断（多半是标签名写错）。"
                            % (_k + 2, _left[0][0]))
        else:
            _produced |= set(_nm for _nm, _a, _b in _parts(_k)[1])

    # ---- 2. 出口收口 ----
    _m_outs = _parts(-1)[1]
    if _m_outs:
        _nm, _s, _e = _m_outs[-1]
        if _nm != node_label:
            eff_segs[-1] = eff_segs[-1][:_s] + "[%s]" % node_label + eff_segs[-1][_e:]
            warn.append("末段的输出标签 [%s] 已改名为 [%s]（接回本节点下游）。" % (_nm, node_label))
        _extra = []
        for _n2, _s2, _e2 in _m_outs[:-1]:
            _extra.append("[%s]nullsink" % _n2)
            warn.append("标签 [%s] 这条支线没有下游，已接到空输出端 —— 它的画面不会进入最终输出。"
                        % _n2)
        if _extra:
            eff_segs[-1] = "%s;%s" % (eff_segs[-1], ";".join(_extra))
    else:
        eff_segs[-1] = "%s[%s]" % (eff_segs[-1], node_label)
        warn.append("末段没写输出标签，已自动收口成 [%s]（结果接回本节点下游）。"
                    "想让它流向别处时，请自己补一个输出标签。" % node_label)

    # ---- 重名检查（方案 B 的「对比一下是否重名，然后提示一下」）----
    # ⚠️ 只有**末段收口后那一个**输出标签允许等于 node_label（收口本来就是把它的输出
    #    改名成 node_label 接回下游）；其余任何段（尤其第 1 段）只要产出/引用了这张图里
    #    既有的标签名就必然是冲突 —— ffmpeg 会直接拒掉整条链（"multiple outputs with
    #    the name 'b'"）。早期版本图省事把「== node_label」整个排除，撞名的真实场景
    #    （自定义里写了 [b]，恰好就是本节点的标签）反而一声不吭，纯属漏报。
    _exist = set(graph_labels(graph))
    _close_idx = len(eff_segs) - 1
    _last_outs = _uc_seg_parts(eff_segs[-1])[1]
    _close_name = _last_outs[-1][0] if _last_outs else node_label
    for _idx, _s in enumerate(eff_segs):
        _allowed = set([tmp])
        if _idx == _close_idx and _close_name == node_label:
            _allowed.add(node_label)
        for _nm2, _a, _b in _uc_seg_parts(_s)[0] + _uc_seg_parts(_s)[1]:
            if _nm2 and _nm2 in _exist and _nm2 not in _allowed:
                warn.append("标签 [%s] 与这张图里已有的标签重名，ffmpeg 会拒绝整条链；"
                            "换个没用过的名字（如 [uc_%d]）即可。" % (_nm2, _idx + 1))

    new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
    return ";".join(segs[:seg_index] + [new_seg] + eff_segs + segs[seg_index + 1:]), warn


NODE_FX_CUSTOM_KEY = "_custom_chain"


def node_fx_items(v):
    """node_fx[key] / node_audio_fx[key] → **效果项列表**（2026-10-02 L1「自由顺序」）。

    一个节点可以挂 N 个效果，顺序即列表顺序（UI 可上移/下移）。存储两态并存：
    - 新：`[{...}, {...}]`（效果列表）
    - 旧：`{...}`（2026-10-02 之前是「一节点一效果」的裸 dict）→ **自动包成 1 项**，
      老工程零迁移、零回归。
    非 dict/list（脏数据）→ []。
    """
    if isinstance(v, list):
        return [x for x in v if isinstance(x, dict)]
    if isinstance(v, dict):
        return [v] if v else []
    return []


def node_effect_chain_multi(v):
    """一个节点的效果列表 → 合并成**一条**滤镜串（顺序 = 列表顺序），交给一次插入。

    2026-10-03 起支持**链式**而非纯逗号拼接（开放 `[标签]` 后必须这样）：
    - 相邻两段「都没带标签」→ 仍用逗号连（= 老行为，纯逗号链仍然只是一个段）；
    - 任一侧带标签 → 用分号分两段，并把下段的入口标签对齐上段的输出标签
      （名字对不上就改下段的入口名）；上段没输出而下段有入口 → 把入口标签上移成上段输出。
    ⇒ 否则「同一节点挂 N 个效果」在带标签时整条链会断（实测 unconnected）。

    ⚠️ 必须合并成一条一次插入，不能逐项 insert_after_at：同一节点的多项段序号相同，
    插完第一项后第二项的段序号会漂移（现有 `_apply_node_fx` 只对**不同 key** 做降序
    防漂移，同 key 内无效）。合并后一次插入 ⇒ 顺序由列表决定、且零漂移。

    空列表 / 全空效果 → ''（调用方应跳过插入，与旧行为一致）。
    """
    _segs = []
    for _it in node_fx_items(v):
        _c = node_effect_chain(_it)
        if not _c:
            continue
        _parts = graph_split(_c)
        if not _parts:
            continue
        # 相邻两段都无标签 → 逗号连成一整段（老行为：纯逗号链永远只是一个段）
        if _segs and _uc_seg_parts(_segs[-1])[1] == [] and _uc_seg_parts(_parts[0])[0] == []:
            _segs[-1] = "%s,%s" % (_segs[-1], _parts[0])
            _parts = _parts[1:]
        _segs.extend(_parts)
    # 段间接线：下段的入口标签对齐上段的输出标签（对不上就改下段那个入口的名字）。
    # ⚠️ 2026-10-03 修「节点里局部模糊标签必错」（正常设置却没问题，根就在这）：
    #    这套接线只服务「下段**单入口**」的直线链。下段多入口（分叉合流）时**绝不能**
    #    只把第一个入口改名 —— 实测把局部模糊的 `[fg][bl]overlay` 改成 `[bl][bl]overlay`，
    #    「原帧当底图 + 糊块当叠加」的结构整个没了；再叠上「上段没输出就把入口名上移成
    #    上段输出」，还会给 overlay 追加一个和 split 已经产出的 [fg] 同名的新输出 ⇒
    #    ffmpeg 直接拒（"multiple outputs with the name"）。分叉一律**一个字都不动**，
    #    悬空/重名提示统一交给 insert_effect_subgraph 的 _produced 判据。
    for _k in range(len(_segs) - 1):
        _a_outs = _uc_seg_parts(_segs[_k])[1]
        _b_ins = _uc_seg_parts(_segs[_k + 1])[0]
        if not _b_ins or len(_b_ins) > 1:
            continue
        _nm, _s, _e = _b_ins[0]
        if _a_outs and _nm != _a_outs[0][0]:
            # ⚠️ 2026-10-03 续修：下段**单入口**时，入口名也可能根本不是「接上一段」，
            #    而是**接更早那一段的支线**（典型：局部模糊的 split=2[bg][fg] 产了 [fg]，
            #    下一段却写 [fg]delogo —— 用户是想把 delogo 挂在 split 的第二路上）。
            #    这种「对不上上段首个输出、但名字是前面某段真真实实产出来的」= 用户自己
            #    接好的分叉，照旧对齐改名就会把 [fg]delogo 改成 [bl]delogo（方案 B 明令
            #    不许替用户动标签）。只在「这个名字前面谁都没产出」时才认为是接错了，
            #    这时才按老行为对齐。
            if _nm in _produced_all(_segs, _k):
                continue
            _segs[_k + 1] = _segs[_k + 1][:_s] + "[%s]" % _a_outs[0][0] + _segs[_k + 1][_e:]
        elif not _a_outs and _nm not in _produced_all(_segs, _k):
            _segs[_k] = "%s[%s]" % (_segs[_k], _nm)
            _segs[_k + 1] = _segs[_k + 1][:_s] + _segs[_k + 1][_e:]
    return ";".join(_segs)


def _produced_all(_segs, _upto):
    """segs[0.._upto] 这段前缀里所有**已产出的标签名**集合（分叉接线前的重名护栏）。

    局部模糊这类结构：`split=2[bg][fg]` 已经产出了 [fg]，紧接着的 `[fg][bl]overlay`
    又被「上段没输出 → 把入口名上移成输出」的手法定成 `[fg][bl]overlay[fg]`，
    就变成两个同名输出 ⇒ ffmpeg 拒。所以上移之前必须先看这个名字是不是**用户（或
    前一效果）自己接好的现有支线**——是就别动，链本来就通。
    """
    _out = set()
    for _i in range(_upto + 1):
        for _nm, _a, _b in _uc_seg_parts(_segs[_i])[1]:
            _out.add(_nm)
    return _out


def node_label_friendly(name):
    """原始图标签 → 中文阶段名（**纯显示层**；定位仍靠指纹 = 段序号+末滤镜名）。

    为什么不做成「标签名 → 效果」的登记表（2026-09-27「节点窗显示友好名」）：标签是随开关
    增减的位置相关 f-string（`v_out_{i}` / `v_temp_{i}`…），登记表得改遍所有 builder。
    这里只做**从名字反推**的正则映射，漏匹配就原样返回原名 —— 显示降级，绝不误判。
    """
    import re as _re
    n = (name or "").strip()
    if not n:
        return "?"
    if n == "v_main_proc":
        return node_label_display("主视频（预处理后）")
    if n == "v_main_base":
        return node_label_display("主视频原始帧（blend 基底）")
    if n == "v_base":
        return node_label_display("画布基底")
    if n == "v1":
        return node_label_display("画布缩放后")
    if n == "amain":
        return node_label_display("主音频")
    if n == "aout":
        return node_label_display("音频输出")
    _m = _re.fullmatch(r"v_temp_(\d+)", n)
    if _m:
        return node_label_display("子视频 %d（预处理后）") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_out_(\d+)", n)
    if _m:
        return node_label_display("叠加子视频 %d 后") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_crop_(\d+)", n)
    if _m:
        return node_label_display("区域裁剪 %d") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_base(\d+)", n)
    if _m:
        return node_label_display("画布段 %d 基底") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"vt(\d+)", n)
    if _m:
        return node_label_display("画布段 %d 中间") % (int(_m.group(1)) + 1)
    return n


def node_label_display(name):
    """原始图阶段名 → **当前界面语言**的显示名（纯显示层，`node_label_friendly` 专用）。

    2026-10-02 建：node_label_friendly 里 11 条中文阶段名（「主视频（预处理后）」…）
    原是硬编码 return，multi 切英文界面也照出中文，这里统一收口到显示层。

    ⚠️ 必须是函数（multi 的 _() 依赖启动后装载的 TRANS）：写成模块级常量会把显示名
       冻在导入时的中文上（同 countdown_direction_display / node_group_display / node_fx_display）。
    ⚠️ 入参恒为中文阶段名（= _() 的 key），返回值恒为当前语言显示名；只用于**显示**，
       不参与任何比较/查表（定位仍靠指纹 = 段序号+末滤镜名）。
    ⚠️ 双版同构：base 不装 gettext → 恒等返回，中文界面行为零变化；multi 走 _()。
       改这一处务必同步另一版，反之亦然。
    """
    return name


