        # 高质量重采样（soxr）手动开关，默认关闭（见 audio_soxr_resample_filter）
        self.soxr_enabled = tk.BooleanVar(value=False)

    def _refresh_seg_label(self):
        """分段效果段数提示（纯展示，不参与命令构建）。"""
        try:
            segs = getattr(self, "audio_segments", None) or []
            n = sum(1 for s in segs if isinstance(s, dict) and s.get("enabled", True))
            self._seg_count_label.config(text=f"分段效果: {n} 段" if n else "分段效果: 未设置")
        except Exception:
            pass

    def _open_audio_segment_dialog(self):
        """音频分段效果入口：编辑 self.audio_segments（转换页全局音频设置）。

        数据落点与封装页不同（封装页走 track.enc_settings["audio_segments"]），
        但编辑器与滤镜编译共用模块级 AudioSegmentDialog / build_audio_segment_filters。
        """
        segs = AudioSegmentDialog(self.winfo_toplevel(),
                                  getattr(self, "audio_segments", []),
                                  title="音频分段效果",
                                  app=getattr(self, "app", None),
                                  file_source=getattr(self, "file_source", None)).show()
        if segs is None:
            return
        self.audio_segments = segs
        self._refresh_seg_label()
        # 弹窗确定即改数据 → 同步刷新宿主命令预览（转换页 update_command_preview /
        # 队列编辑窗口 update_preview），否则关闭后预览仍显示旧命令。
        cb = getattr(self, "refresh_cb", None)
        if cb is not None:
            with suppress(Exception):
                cb()

    def _open_advanced_audio_dialog(self):
        """高级音频弹窗：淡入淡出 / 响度标准化 / 降噪 / 声道 / 均衡器（节省主区空间）。"""
        win = tk.Toplevel(self)
        win.withdraw()  # 先隐藏，避免左上角闪一下
        win.title("高级音频处理")
        with suppress(Exception):
            center_window(win, 480, 340)
        win.transient(self.winfo_toplevel())

        fe = tk.BooleanVar(value=self.fade_enabled.get())
        fi = tk.StringVar(value=self.fade_in.get())
        fo = tk.StringVar(value=self.fade_out.get())
        le = tk.BooleanVar(value=self.loudnorm_enabled.get())
        ln_i = tk.StringVar(value=self.loudnorm_i.get())
        de = tk.BooleanVar(value=self.denoise_enabled.get())
        dn_method = tk.StringVar(value=self.denoise_method.get())
        hp_en = tk.BooleanVar(value=self.hp_enabled.get())
        hp_f = tk.StringVar(value=self.hp_freq.get())
        lp_en = tk.BooleanVar(value=self.lp_enabled.get())
        lp_f = tk.StringVar(value=self.lp_freq.get())
        cm = tk.StringVar(value=self.channel_mode.get())
        ee = tk.BooleanVar(value=self.eq_enabled.get())
        elo = tk.StringVar(value=self.eq_low.get())
        emi = tk.StringVar(value=self.eq_mid.get())
        ehi = tk.StringVar(value=self.eq_high.get())
        soxr_en = tk.BooleanVar(value=self.soxr_enabled.get())

        main = ttk.Frame(win, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        row = 0

        # ---- 行0：淡入淡出 ----
        chk_fade = ttk.Checkbutton(main, text="淡入淡出 (afade)", variable=fe)
        chk_fade.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_fade, "在音频开头和结尾添加音量渐变效果，不会改变音频总时长")

        lbl_fi = ttk.Label(main, text="淡入秒:")
        lbl_fi.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_fi, "淡入持续时间（秒），从 0 开始逐渐增大音量")
        entry_fi = ttk.Entry(main, textvariable=fi, width=6)
        entry_fi.grid(row=row, column=3, padx=2, sticky="w")

        lbl_fo = ttk.Label(main, text="淡出秒:")
        lbl_fo.grid(row=row, column=4, sticky="w", padx=(10, 2))
        ToolTip(lbl_fo, "淡出持续时间（秒），在音频末尾逐渐减小音量至静音")
        entry_fo = ttk.Entry(main, textvariable=fo, width=6)
        entry_fo.grid(row=row, column=5, padx=2, sticky="w")

        # ---- 行1：响度标准化 ----
        row += 1
        chk_loud = ttk.Checkbutton(main, text="响度标准化 (loudnorm)", variable=le)
        chk_loud.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_loud, "将音频响度标准化到广播级标准（EBU R128），适合统一多段音频的音量")
        _lbltt23 = ttk.Label(main, text="标准:")
        _lbltt23.grid(row=row, column=2, sticky="w", padx=(10, 2))
        combo_ln = ttk.Combobox(main, textvariable=ln_i, values=["-23", "-16", "-14"], width=9)
        combo_ln.grid(row=row, column=3, padx=2, sticky="w")
        ToolTip(_lbltt23, "-23=EBU R128（电视/广播） | -16=Spotify | -14=YouTube\n"
                          "可输入任意值：16 与 -16 等价（自动取负），合法范围 -70~-5，越界自动钳制")

        # ---- 行2：降噪 ----
        row += 1
        chk_denoise = ttk.Checkbutton(main, text="降噪", variable=de)
        chk_denoise.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_denoise, "开启降噪；算法在右侧下拉选择（afftdn=FFT 谱减法 / arnndn=RNN 语音降噪）")
        _lbltt24 = ttk.Label(main, text="算法:")
        _lbltt24.grid(row=row, column=2, sticky="w", padx=(10, 2))
        combo_dn = ttk.Combobox(main, textvariable=dn_method, values=["afftdn", "arnndn"], state="readonly", width=9)
        combo_dn.grid(row=row, column=3, padx=2, sticky="w")
        ToolTip(_lbltt24, "afftdn=FFT 谱减法（默认，兼容性好）；arnndn=RNN 语音降噪（质量更高，需 ffmpeg 编译含 RNN 模型）")

        # ---- 低频/高频截止（去隆隆声 / 去喷麦嘶声） ----
        row += 1
        chk_hp = ttk.Checkbutton(main, text="低频截止 (highpass)", variable=hp_en)
        chk_hp.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_hp, "切除低频隆隆声（空调/电流/风声），默认 200Hz")
        ttk.Label(main, text="截止Hz:").grid(row=row, column=2, sticky="w", padx=(10, 2))
        entry_hpf = ttk.Entry(main, textvariable=hp_f, width=6)
        entry_hpf.grid(row=row, column=3, padx=2, sticky="w")

        row += 1
        chk_lp = ttk.Checkbutton(main, text="高频截止 (lowpass)", variable=lp_en)
        chk_lp.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_lp, "切除高频嘶声/喷麦，默认 3000Hz")
        ttk.Label(main, text="截止Hz:").grid(row=row, column=2, sticky="w", padx=(10, 2))
        entry_lpf = ttk.Entry(main, textvariable=lp_f, width=6)
        entry_lpf.grid(row=row, column=3, padx=2, sticky="w")

        # ---- 高质量重采样（soxr）手动开关 ----
        row += 1
        chk_soxr = ttk.Checkbutton(main, text="高质量重采样 (soxr)", variable=soxr_en)
        chk_soxr.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_soxr, "关闭（默认）：用 ffmpeg 内置 swr 重采样，速度更快、可听范围无差异。\n"
                        "开启：用 libsoxr 高质量重采样，仅在重采样后采样率异于原音频（如 48k→44.1k）的超声区混叠抑制略好；\n"
                        "需 ffmpeg 编译含 libsoxr。仅当采样率≠auto 时生效。")

        # ---- 行3：声道 ----
        row += 1
        ch_frame = ttk.Frame(main)
        ch_frame.grid(row=row, column=0, columnspan=3, sticky="w", padx=5, pady=4)

        lbl_ch = ttk.Label(ch_frame, text="声道:")
        lbl_ch.pack(side=tk.LEFT)
        ToolTip(lbl_ch, "选择输出声道模式：\n• stereo：保持立体声\n• mono：混合为单声道\n• left：仅保留左声道\n• right：仅保留右声道\n• swap：左右交换")

        combo_ch = ttk.Combobox(ch_frame, textvariable=cm, values=["stereo", "mono", "left", "right", "swap"], state="readonly", width=12)
        combo_ch.pack(side=tk.LEFT, padx=5)

        # ---- 行4：均衡器 ----
        row += 1
        chk_eq = ttk.Checkbutton(main, text="均衡器 (EQ)", variable=ee)
        chk_eq.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_eq, "分别调节低音、中音、高音的增益（单位 dB），正数增强，负数衰减")

        lbl_low = ttk.Label(main, text="低音 (dB):")
        lbl_low.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_low, "低音增益（通常 60-250 Hz），正数增强低音，负数减弱")
        entry_low = ttk.Entry(main, textvariable=elo, width=5)
        entry_low.grid(row=row, column=3, padx=2, sticky="w")

        lbl_mid = ttk.Label(main, text="中音 (dB):")
        lbl_mid.grid(row=row, column=4, sticky="w", padx=(10, 2))
        ToolTip(lbl_mid, "中音增益（约 1kHz），调节人声和乐器的清晰度")
        entry_mid = ttk.Entry(main, textvariable=emi, width=5)
        entry_mid.grid(row=row, column=5, padx=2, sticky="w")

        # ---- 行5：高音 ----
        row += 1
        lbl_high = ttk.Label(main, text="高音 (dB):")
        lbl_high.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_high, "高音增益（通常 4-8 kHz），提升细节或减少刺耳感")
        entry_high = ttk.Entry(main, textvariable=ehi, width=5)
        entry_high.grid(row=row, column=3, padx=2, sticky="w")

        # ---- 底部按钮 ----
        row += 1
        btn_frame = ttk.Frame(main)
        btn_frame.grid(row=row, column=0, columnspan=6, pady=15)

        def _save():
            self.fade_enabled.set(fe.get())
            self.fade_in.set(fi.get().strip())
            self.fade_out.set(fo.get().strip())
            self.loudnorm_enabled.set(le.get())
            _ln_ok, _ln_v = loudnorm_i_norm(ln_i.get())
            if not _ln_ok and ln_i.get().strip():
                self._append_info_ui(f"[响度] 标准值「{ln_i.get().strip()}」无法解析，已按默认 -23")
            self.loudnorm_i.set(str(_ln_v))   # 归一回显（正数取负 / 钳到 -70~-5）
            self.denoise_enabled.set(de.get())
            self.denoise_method.set(dn_method.get())
            self.hp_enabled.set(hp_en.get())
            self.hp_freq.set(hp_f.get().strip() or "200")
            self.lp_enabled.set(lp_en.get())
            self.lp_freq.set(lp_f.get().strip() or "3000")
            self.channel_mode.set(cm.get())
            self.eq_enabled.set(ee.get())
            self.eq_low.set(elo.get().strip() or "0")
            self.eq_mid.set(emi.get().strip() or "0")
            self.eq_high.set(ehi.get().strip() or "0")
            self.soxr_enabled.set(soxr_en.get())
            win.destroy()

        ttk.Button(btn_frame, text="保存", command=_save).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="取消", command=win.destroy).pack(side=tk.LEFT, padx=5)

        win.wait_window()

    def get_settings(self):
        volume = self.volume_value.get()
        if volume < 0.1:
            volume = 0.1
        elif volume > 3.0:
            volume = 3.0
        res = {
            "audio_codec": self.audio_codec.get(),
            "audio_bitrate": self.audio_bitrate.get(),
            "audio_samplerate": self.audio_samplerate.get(),
            "audio_vbr": self.audio_vbr.get(),
            "audio_quality": self.audio_quality.get(),
            "audio_track_mode": self.audio_track_mode.get(),
            "only_audio": self.only_audio.get(),
            "audio_format": self.audio_format.get(),
            "volume": volume,
            "volume_enabled": self.volume_enabled.get(),
            "audio_speed_enabled": self.audio_speed_enabled.get(),
            "audio_speed_factor": self.audio_speed_factor.get().strip() or "1.0",
            "audio_reverse": self.audio_reverse.get(),
            "fade_enabled": self.fade_enabled.get(),
            "fade_in": self.fade_in.get().strip(),
            "fade_out": self.fade_out.get().strip(),
            "loudnorm_enabled": self.loudnorm_enabled.get(),
            "loudnorm_i": loudnorm_i_norm(self.loudnorm_i.get())[1],
            "denoise_enabled": self.denoise_enabled.get(),
            "denoise_method": self.denoise_method.get(),
            "hp_enabled": self.hp_enabled.get(),
            "hp_freq": self.hp_freq.get().strip() or "200",
            "lp_enabled": self.lp_enabled.get(),
            "lp_freq": self.lp_freq.get().strip() or "3000",
            "channel_mode": self.channel_mode.get(),
            "eq_enabled": self.eq_enabled.get(),
            "eq_low": self.eq_low.get().strip() or "0",
            "eq_mid": self.eq_mid.get().strip() or "0",
            "eq_high": self.eq_high.get().strip() or "0",
            "soxr_enabled": self.soxr_enabled.get(),
            # 音频分段效果：列表里每项 {enabled,start,end,type,p1,p2,soft}
            "audio_segments": [dict(s) for s in (getattr(self, "audio_segments", None) or [])
                               if isinstance(s, dict)],
        }
        if self.enable_checkbox:
            res["audio_enabled"] = self.audio_enabled.get()
        return res
    
    def set_settings(self, settings):
        if self.enable_checkbox and "audio_enabled" in settings:
            self.audio_enabled.set(settings["audio_enabled"])
        self.audio_codec.set(settings.get("audio_codec", "aac"))
        self.audio_bitrate.set(settings.get("audio_bitrate", "auto"))
        self.audio_samplerate.set(settings.get("audio_samplerate", "auto"))
        self.audio_vbr.set(settings.get("audio_vbr", False))
        self.audio_quality.set(settings.get("audio_quality", "2.0"))
        self.audio_track_mode.set(settings.get("audio_track_mode", "first"))
        if hasattr(self, "_sync_vbr_state"):
            self._sync_vbr_state()
        self.only_audio.set(settings.get("only_audio", False))
        self.audio_format.set(settings.get("audio_format", "m4a"))
        vol = settings.get("volume", 1.0)
        try:
            self.volume_value.set(float(vol))
        except (ValueError, TypeError):
            self.volume_value.set(1.0)
        self.volume_text.set(f"{self.volume_value.get():.2f}")
        enabled = settings.get("volume_enabled", False)
        self.volume_enabled.set(enabled)
        self.audio_speed_enabled.set(settings.get("audio_speed_enabled", False))
        self.audio_speed_factor.set(settings.get("audio_speed_factor", "1.0"))
        self.audio_reverse.set(settings.get("audio_reverse", False))
        self.fade_enabled.set(settings.get("fade_enabled", False))
        self.fade_in.set(settings.get("fade_in", ""))
        self.fade_out.set(settings.get("fade_out", ""))
        self.loudnorm_enabled.set(settings.get("loudnorm_enabled", False))
        self.loudnorm_i.set(str(loudnorm_i_norm(settings.get("loudnorm_i", -23))[1]))   # 旧工程可能存了正数/越界值，加载时归一
        self.denoise_enabled.set(settings.get("denoise_enabled", False))
        self.denoise_method.set(settings.get("denoise_method", "afftdn"))
        self.hp_enabled.set(settings.get("hp_enabled", False))
        self.hp_freq.set(settings.get("hp_freq", "200"))
        self.lp_enabled.set(settings.get("lp_enabled", False))
        self.lp_freq.set(settings.get("lp_freq", "3000"))
        self.channel_mode.set(settings.get("channel_mode", "stereo"))
        self.eq_enabled.set(settings.get("eq_enabled", False))
        self.eq_low.set(settings.get("eq_low", "0"))
        self.eq_mid.set(settings.get("eq_mid", "0"))
        self.eq_high.set(settings.get("eq_high", "0"))
        self.soxr_enabled.set(settings.get("soxr_enabled", False))
        # 音频分段效果（与 get_settings 对称；副本避免外部改动波及内部）
        self.audio_segments = [dict(s) for s in (settings.get("audio_segments") or [])
                               if isinstance(s, dict)]
        self._refresh_seg_label()


# ================== 截取片段组件 ==================
class TrimFrame(ttk.LabelFrame):
    def __init__(self, parent, show_combo_seek=True, update_callback=None,
                 app=None, file_source=None, **kwargs):
        kwargs.pop('update_callback', None)
        super().__init__(parent, text="截取片段", padding="5", **kwargs)
        self.show_combo_seek = show_combo_seek
        self.update_callback = update_callback
        self.combo_check = None
        self._setting = False
        self._combo_frame = None  # 组合跳转控件容器（仅 show_combo_seek 时创建）
        self._src_is_img_mode = None  # 素材类型模式缓存（None=未判定；refresh_source_mode 幂等用）
        # 简易时间预览：app=主程序引用（拿 ffmpeg/ffprobe 路径），file_source=返回当前文件路径的
        # 回调（None 则不显示「简易时间预览」按钮）。三处（转换页/队列编辑/封装页视频流编辑）
        # 复用同一个 TrimFrame，各自传入自己的文件来源。
        self.app = app
        self.file_source = file_source
        self.create_widgets()

    def create_widgets(self):
        self.trim_enabled = tk.BooleanVar(value=False)
        self._top_line = ttk.Frame(self)
        self._top_line.pack(fill=tk.X, pady=(0,5))

        self.trim_check = ttk.Checkbutton(self._top_line, text="启用截取片段", variable=self.trim_enabled,
                                          command=self.on_trim_toggle)
        self.trim_check.pack(side=tk.LEFT, padx=5)
        
        # 简易时间预览入口（内置帧浏览器，纯 ffmpeg 依赖）：替代外部播放器获取精确截取时间
        self.preview_btn = None
        if self.app is not None and self.file_source is not None:
            self.preview_btn = ttk.Button(self._top_line, text="简易时间预览",
                                          command=self._open_simple_preview)
            self.preview_btn.pack(side=tk.LEFT, padx=5)
            ToolTip(self.preview_btn,
                    "程序内置简易时间预览（纯 ffmpeg，无需 MPV / PotPlayer）：\n"
                    "播放/暂停 / 进度条拖动 / 上一帧·下一帧微调。\n"
                    "暂停在目标画面后点「设为起点/终点」，自动回填精确到毫秒的截取时间。\n\n"
                    "注意：大文件（4K / 长时间视频）或个别特殊格式（如大型 MKV / 高码率 / 8K）"
                    "加载可能较慢，极端情况下甚至无法预览。\n"
                    "若预览失败或一直卡在加载中，请改用 MPV / PotPlayer 等专业播放器定位时间，"
                    "再手动填入上方开始/结束时间框。",
                    wraplength=420)
            # 导入时间：读剪贴板一行 `-ss S -to E` 直接填入起止时间（不弹窗输入）。
            # 用户场景：习惯性在预览里标记首尾却忘了发送，或从音频等无预览窗口复制一行过来。
            self.import_trim_btn = ttk.Button(self._top_line, text="导入时间",
                                              command=self._import_trim_clipboard, width=8)
            self.import_trim_btn.pack(side=tk.LEFT, padx=5)
            ToolTip(self.import_trim_btn,
                    "从剪贴板导入一行时间直接填入开始/结束框（程序内部通用格式，不弹窗）：\n"
                    "`-ss 开始 -to 结束`，如 `-ss 12.345 -to 20.000`。\n"
                    "该格式与「简易时间预览」的复制时间/「章节编辑器」外部时间一致；"
                    "剪贴板有多行时只取第一行。",
                    wraplength=460)
        
        ToolTip(self.trim_check, 
                "默认是 -ss 在 -i 之前的快速模式，快速无损截取请把音频视频都改为Copy\n\n"
                "截取功能在普通转码模式下（无水印/画中画）表现稳定，支持快速截取（基于关键帧）和精准截取（基于解码帧）两种方式。\n\n"
                "当同时启用了「水印」或「画中画（子视频）」时：\n"
                "  主视频截取：\n"
                "    · 推荐使用「精准截取」模式（勾选“精准到帧”），可确保水印时长精确匹配主视频截取时长。\n"
                "    · 快速模式下因基于关键帧，结束时间可能有几帧偏差（通常可忽略）。\n\n"
                "  子视频（水印/画中画）截取：\n"
                "    · 子视频启用截取后，截取的片段会通过 loop 滤镜循环播放，直至主视频结束。\n"
                "    · 若循环次数有限（自定义次数），通过 enable 表达式限制显示时间，水印会在显示指定次数后消失，主视频继续播放。\n"
                "    · 若循环为无限或次数总时长超过主视频，水印将持续显示到视频结束。\n\n"
                "若您不希望水印循环或需要更精细控制，建议先在「视频转码」标签页单独处理好子视频，再导入作为水印/画中画素材。\n\n"
                "示例: 01:23:45 或 01:23:45.500 (留空表示到文件末尾)",
                wraplength=700)

        self._time_frame = ttk.Frame(self)
        self._time_frame.pack(fill=tk.X, pady=2)
        ttk.Label(self._time_frame, text="开始时间 (HH:MM:SS[.mmm]):").pack(side=tk.LEFT)
        self.trim_start = tk.StringVar(value="0")
        self.trim_start_entry = ttk.Entry(self._time_frame, textvariable=self.trim_start, width=12)
        self.trim_start_entry.pack(side=tk.LEFT, padx=5)
    
        self._time_frame2 = ttk.Frame(self)
        self._time_frame2.pack(fill=tk.X, pady=2)
        ttk.Label(self._time_frame2, text="结束时间 (HH:MM:SS[.mmm]):").pack(side=tk.LEFT)
        self.trim_end = tk.StringVar(value="")
        self.trim_end_entry = ttk.Entry(self._time_frame2, textvariable=self.trim_end, width=12)
        self.trim_end_entry.pack(side=tk.LEFT, padx=5)
    
        # 精准到帧
        self._precise_frame = ttk.Frame(self)
        self._precise_frame.pack(fill=tk.X, pady=5)
        self.precise_trim = tk.BooleanVar(value=False)
        self.precise_check = ttk.Checkbutton(
            self._precise_frame, 
            text="精准到帧（需重新编码，速度慢）", 
            variable=self.precise_trim,
            command=self.on_precise_toggle
        )
        self.precise_check.pack(side=tk.LEFT, padx=5)
        ToolTip(self.precise_check,
                "勾选后，截取将精确到帧，但必须重新编码视频。\n"
                "若编码器为「copy」将自动提示。\n"
                "取消勾选则为快速截取（基于关键帧），可能不精确但速度快。",
                wraplength=400)

        # ---------- 组合跳转控件（根据 show_combo_seek 决定是否显示） ----------
        if self.show_combo_seek:
            self._combo_frame = ttk.Frame(self)
            self._combo_frame.pack(fill=tk.X, pady=2)
            
            self.combo_seek = tk.BooleanVar(value=False)
            self.combo_threshold = tk.IntVar(value=30)

            self.combo_seek.trace_add('write', self._on_combo_changed)
            self.combo_threshold.trace_add('write', self._on_combo_changed)

            self.combo_check = ttk.Checkbutton(
                self._combo_frame, 
                text="组合跳转（加速长视频精确截取）", 
                variable=self.combo_seek,
                command=self._on_combo_toggle
            )
            self.combo_check.pack(side=tk.LEFT, padx=5)
            
            ttk.Label(self._combo_frame, text="后置微调阈值(秒):").pack(side=tk.LEFT, padx=(10,0))
            spin = ttk.Spinbox(self._combo_frame, from_=1, to=120, width=5, 
                               textvariable=self.combo_threshold)
            spin.pack(side=tk.LEFT, padx=2)
            
            ToolTip(self.combo_check,
                "⚡ 组合跳转模式（仅推荐用于单个纯净视频转码）\n\n"
                "原理：先快速跳到目标时间点之前的关键帧（输入跳转），\n"
                "      再精确解码到目标帧（输出跳转），兼顾速度与精度。\n\n"
                "阈值含义：\n"
                "  例如：起始时间 3600s，阈值 30s → 前置跳 3570s，后置微调 30s\n\n"
                "适用场景：\n"
                "  ✅ 单个视频文件，无叠加、无水印、无画中画\n"
                "  ✅ 需要从长视频中间位置开始截取（如从1小时处开始）\n"
                "  ✅ 编码器非 copy（必须重新编码）\n\n"
                "何时启用：\n"
                "  📌 当视频总时长 > 2分钟 且 截取起始时间 > 30秒 时，推荐开启此模式；\n"
                "  📌 若视频较短（<5分钟）或起始时间非常靠前（<10秒），提升不明显，\n\n"
                "不适用场景：\n"
                "  ❌ 启用「水印」或「画中画」（自动禁用）\n"
                "     原因：前后双 -ss 的后置 -ss 无法区分是针对主视频还是从视频，\n"
                "           容易误作用于其他输入，导致截取错位。\n"
                "  ❌ 启用「精准到帧」模式（互斥，勾选后自动取消）\n"
                "  ❌ 仅提取音频（only_audio）\n\n"
                "性能提升参考（2小时电影，从1小时处截取）：\n"
                "  • 软件解码：省去约15~30分钟的解码时间\n"
                "  • 硬件解码（cuda/qsv）：省去约5~10分钟\n"
                "  • 精准的trim模式需要慢慢把前面的全解码在丢弃，所以慢\n\n"
                "阈值建议：默认30秒足以覆盖绝大多数关键帧间隔（1~10秒），\n"
                "         无需调大，调大反而增加解码耗时。\n"
                "若起始时间小于阈值，则自动跳过前置跳转，仅执行后置微调。",
                wraplength=500)
        else:
            # 不显示组合跳转时，创建内部变量但强制为 False
            self.combo_seek = tk.BooleanVar(value=False)
            self.combo_threshold = tk.IntVar(value=30)
            self.combo_check = None



        self.on_trim_toggle()

        # ---- 图片素材专属：显示时长（秒） ----
        # 图片本身无时间轴，用「显示时长」规定它显示多少秒，无需预先转成视频（零画质损失）。
        self.img_duration = tk.StringVar(value="10")
        self._img_frame = ttk.Frame(self)
        self._img_frame.pack(fill=tk.X, pady=4)
        ttk.Label(self._img_frame, text="显示时长 (秒):").pack(side=tk.LEFT)
        self.img_duration_entry = ttk.Entry(self._img_frame, textvariable=self.img_duration, width=10)
        self.img_duration_entry.pack(side=tk.LEFT, padx=5)
        ToolTip(self.img_duration_entry,
                "图片素材的显示时长（秒）。图片本身没有时间长度，\n"
                "在这里直接规定它显示多少秒，无需预先转成视频，无画质损失。\n"
                "例：16 表示显示 16 秒。配合转场 / 淡入淡出 / 倒数文字水印直接挂在本段即可。",
                wraplength=420)
        ttk.Label(self._img_frame,
                  text="（图片素材专属，视频素材相关控件隐藏。）").pack(side=tk.LEFT, padx=5)
        # 创建末尾：根据素材类型切换 UI（图片→仅显示时长；视频→常规截取控件）
        self.refresh_source_mode()


    def _on_combo_changed(self, *args):
        """组合跳转相关控件变化时，触发外部刷新"""
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 新增：组合跳转切换回调 ----------
    def _on_combo_toggle(self):
        if self.combo_seek.get():
            # 启用组合跳转时，禁用精准模式（互斥）
            self.precise_trim.set(False)
            self.precise_check.config(state='disabled')
        else:
            self.precise_check.config(state='normal')
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 修改：精准模式切换回调（增加互斥） ----------
    def on_precise_toggle(self):
        if self.precise_trim.get() and self.show_combo_seek and self.combo_seek.get():
            # 如果精准模式被启用，但组合跳转已启用，则禁用组合跳转
            self.combo_seek.set(False)
            if self.combo_check:
                self.combo_check.config(state='normal')
        # 原有逻辑（如有）保留
        pass

    def on_trim_toggle(self):
        state = tk.NORMAL if self.trim_enabled.get() else tk.DISABLED
        self.trim_start_entry.config(state=state)
        self.trim_end_entry.config(state=state)

    # ---------- 图片素材模式：显示「显示时长」，隐藏常规截取控件 ----------
    def _current_source_is_image(self):
        u"""根据 file_source 回调判断当前素材是否为静态图片。"""
        try:
            if self.file_source is None:
                return False
            p = self.file_source()
            if not p:
                return False
            return _is_static_image_file(p)
        except Exception:
            return False

    def trim_active(self):
        u"""「截取」是否等效生效：图片素材没有时间轴，截取不适用（长度由「显示时长」决定）。
        统一出口——图片模式下控件已被隐藏，这里把残留状态一并屏蔽，
        避免隐藏控件的旧值被命令生成端消费（曾出现：图片被前置 -ss/-to 截取，覆盖显示时长）。"""
        if self._current_source_is_image():
            return False
        return bool(self.trim_enabled.get())

    def refresh_source_mode(self):
        u"""根据素材类型切换 UI：
        图片 → 仅显示「显示时长(秒)」，隐藏 启用截取/起止/精准/组合跳转；
        视频 → 显示常规截取控件，隐藏「显示时长」。
        幂等：模式未变直接返回（命令预览每次刷新都会调用一次）。"""
        is_img = self._current_source_is_image()
        if self._src_is_img_mode == is_img:
            return
        self._src_is_img_mode = is_img
        if is_img:
            for w in (self._top_line, self._time_frame, self._time_frame2,
                      self._precise_frame, self._combo_frame):
                if w is not None:
                    w.pack_forget()
            self._img_frame.pack(fill=tk.X, pady=4)
        else:
            self._img_frame.pack_forget()
            self._top_line.pack(fill=tk.X, pady=(0, 5))
            self._time_frame.pack(fill=tk.X, pady=2)
            self._time_frame2.pack(fill=tk.X, pady=2)
            self._precise_frame.pack(fill=tk.X, pady=5)
            if self._combo_frame is not None:
                self._combo_frame.pack(fill=tk.X, pady=2)
        if not is_img:
            self.on_trim_toggle()

    # ---------- 简易时间预览（内置帧浏览器，2026-08-25 方案 B） ----------
    def _open_simple_preview(self):
        """打开内置简易时间预览窗口，暂停后「设为起点/终点」自动回填截取时间。"""
        if not self.app or not self.file_source:
            return
        try:
            path = self.file_source()
        except Exception:
            path = None
        if alert_if(not path or not os.path.exists(path), "提示", "请先选择要预览的视频文件"):
            return
        if alert_if(not self.app.ffmpeg_cmd, "提示", "未找到 ffmpeg，无法预览"):
            return
        # ⚠️ 释放调用方弹窗的模态 grab（SafeToplevel 等）——否则预览窗口被 grab
        # 锁住焦点（点击/拖拽无效，与可视化选区同一问题），预览窗口自身置顶可交互。
        release_grab(self.app.root)
        self.app.show_time_picker(self.app.root, path,
                                  on_set_start=lambda s: self.trim_start.set(_format_preview_time(s)),
                                  on_set_end=lambda s: self.trim_end.set(_format_preview_time(s)),
                                  initial_marks=[(self.trim_start.get(), self.trim_end.get())],
                                  use_output_context=False)

    def _import_trim_clipboard(self):
        """读剪贴板一行 `-ss S -to E`（程序内部通用格式），直接填入开始/结束框（不弹窗）。
        用户场景：在预览里标记了首尾却忘了发送单段，或从音频等无预览窗口复制一行过来。"""
        # ⚠️ 非阻塞读（2026-09-16）：同步 clipboard_get 在预览窗口持有剪贴板时会死锁。
        read_clipboard_safe(self.winfo_toplevel(), self._import_trim_apply)

    def _import_trim_apply(self, text):
        text = (text or "").strip()
        pairs = parse_ss_to_commands(text)
        if alert_if(not pairs, "提示", "剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）", 'info'):
            return
        s, e = pairs[0]  # 只取第一行
        self.trim_start.set(_ffsec(s))
        self.trim_end.set(_ffsec(e))
        if not self._setting and self.update_callback:
            with suppress(Exception):
                self.update_callback()

    # ---------- 修改：get_settings 增加组合跳转字段 ----------
    def get_settings(self):
        res = {
            "trim_enabled": self.trim_active(),
            "trim_start": self.trim_start.get(),
            "trim_end": self.trim_end.get(),
            "precise_trim": self.precise_trim.get(),
            "img_duration": self.img_duration.get(),
        }
        if self.show_combo_seek:
            res["combo_seek"] = self.combo_seek.get()
            res["combo_threshold"] = self.combo_threshold.get()
        else:
            # 在不显示的场景下强制为 False
            res["combo_seek"] = False
            res["combo_threshold"] = 30
        return res

    # ---------- 修改：set_settings 增加组合跳转字段 ----------
    def set_settings(self, settings):
        self._setting = True
        try:
            self.trim_enabled.set(settings.get("trim_enabled", False))
            self.trim_start.set(settings.get("trim_start", "0"))
            self.trim_end.set(settings.get("trim_end", ""))
            self.precise_trim.set(settings.get("precise_trim", False))
            self.img_duration.set(settings.get("img_duration", "10"))
            self.refresh_source_mode()
            if self.show_combo_seek:
                self.combo_seek.set(settings.get("combo_seek", False))
                self.combo_threshold.set(settings.get("combo_threshold", 30))
                self._on_combo_toggle()
            else:
                self.combo_seek.set(False)
            self.on_trim_toggle()
        finally:
            self._setting = False

# ================== 内置简易时间预览（方案 B，2026-08-25） ==================
def _format_preview_time(sec: float) -> str:
    """秒 → HH:MM:SS.mmm（3 位小数），供截取时间回填。"""
    h, m, s = _hms_split(sec)
    return f"{h:02d}:{m:02d}:{s:09.6f}"


