        # ---- 滤镜类型（编辑当前选中项）----
        ttk.Label(main, text="滤镜类型:").grid(row=2, column=0, sticky="w", pady=5)
        self.type_var = tk.StringVar(value=self.filter_frame._blur_type.get())
