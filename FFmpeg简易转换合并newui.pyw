# ============ 非阻塞剪贴板读取（2026-09-16 修复「导入时间」死锁） ============
# 根因：SimplePreviewer / 各「复制时间」用 clipboard_clear()+clipboard_append() 把某个
# Toplevel 登记成 Windows 剪贴板的「惰性所有者」；主线程同步 clipboard_get() 会卡在等
# WM_RENDERFORMAT（同一进程同一线程无法自服务）→ 整个 GUI 卡死、只能杀进程。
# 实测触发条件：打开过 2 个时间预览窗口并从其中复制过时间，再到别的窗口点「导入时间」。
# 修法：读取放到后台线程（Windows 用 ctypes 直接 OpenClipboard/GetClipboardData 并带超时），
# 主线程全程不阻塞、继续跑事件循环以服务 WM_RENDERFORMAT；读毕经 after(0) 把结果交还主线程。
# 三个 clipboard_get 读点（音频分段 / 通用截取 / 转换页轨道编辑）统一走这里。
def read_clipboard_safe(root, on_done, timeout=1.5):
    """非阻塞读剪贴板纯文本：读完后经主线程 after(0) 调 on_done(text)。

    text 为 str（读不到 / 异常 → 空串）。主线程调用方全程不阻塞，故即便剪贴板
    所有者是另一个 Tk 窗口（需主线程渲染）也不会自锁死。"""
    if sys.platform != "win32":
        # X11 / 其它平台：Tk clipboard 在主线程读（无 Windows 惰性所有者死锁问题）
        try:
            on_done((root.clipboard_get() or "").strip())
        except Exception:
            on_done("")
        return

    def _worker():
        text = _win_clipboard_text(timeout)
        with suppress(Exception):
            root.after(0, lambda: on_done(text if text is not None else ""))

    threading.Thread(target=_worker, daemon=True).start()


def _win_clipboard_text(timeout=1.5):
    """Windows：用 ctypes 读 CF_UNICODETEXT，带超时（别的进程占用剪贴板时不永久卡）。"""
    import ctypes
    user32 = ctypes.windll.user32
    kernel32 = ctypes.windll.kernel32
    CF_UNICODETEXT = 13
    # ⚠️ 必须显式声明 64 位句柄类型（默认 c_int 会被截断成 32 位 → GlobalLock 返回 NULL / 读到错数据）
    user32.OpenClipboard.argtypes = [ctypes.c_void_p]
    user32.OpenClipboard.restype = ctypes.c_int
    user32.CloseClipboard.restype = ctypes.c_int
    user32.GetClipboardData.argtypes = [ctypes.c_uint]
    user32.GetClipboardData.restype = ctypes.c_void_p
    kernel32.GlobalLock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalLock.restype = ctypes.c_void_p
    kernel32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalSize.argtypes = [ctypes.c_void_p]
    kernel32.GlobalSize.restype = ctypes.c_size_t
    deadline = time.time() + max(0.1, timeout)
    while time.time() < deadline:
        if user32.OpenClipboard(0):
            break
        time.sleep(0.05)
    else:
        return None
    try:
        h = user32.GetClipboardData(CF_UNICODETEXT)
        if not h:
            return None
        p = kernel32.GlobalLock(h)
        if not p:
            return None
        try:
            size = kernel32.GlobalSize(h)
            if not size:
                return None
            raw = ctypes.string_at(p, size)
            if raw.endswith(b"\x00\x00"):
                raw = raw[:-2]
            return raw.decode("utf-16-le", "replace")
        finally:
            kernel32.GlobalUnlock(h)
    finally:
        user32.CloseClipboard()
    return None


def write_clipboard_safe(root, text):
    """把纯文本写入系统剪贴板（与 read_clipboard_safe 对称、同源修复）。

    win32：用 ctypes 直接 SetClipboardData(CF_UNICODETEXT)，数据由系统持有、
    不依赖本进程存活 —— 关掉任何 Tk 窗口后剪贴板仍有效，也**不再把任何 Tk 窗口**
    登记成「惰性所有者」（外部程序粘贴时不用来向我们进程要数据、不会卡主线程）。
    后台线程执行以避开别的进程占用剪贴板时的短暂阻塞（带 1.5s 超时重试）。
    非 win32：直接用 Tk 的 clipboard（无 Windows 惰性所有者死锁问题）。

    注意：此处**不可**再用 self.win.clipboard_clear/append（会把 Toplevel 登记成惰性
    所有者，正是「导入时间」卡死的根因），所有「复制到剪贴板」点统一走本函数。"""
    text = text or ""
    if sys.platform == "win32":
        threading.Thread(target=_win_clipboard_set, args=(text,), daemon=True).start()
    else:
        try:
            root.clipboard_clear()
            root.clipboard_append(text)
        except Exception:
            pass


def _win_clipboard_set(text):
    """Windows：用 ctypes 把 UTF-16 文本写入系统剪贴板（数据归系统所有）。带超时。"""
    import ctypes
    user32 = ctypes.windll.user32
    kernel32 = ctypes.windll.kernel32
    CF_UNICODETEXT = 13
    GMEM_MOVEABLE = 0x0002
    user32.OpenClipboard.argtypes = [ctypes.c_void_p]
    user32.OpenClipboard.restype = ctypes.c_int
    user32.CloseClipboard.restype = ctypes.c_int
    user32.EmptyClipboard.restype = ctypes.c_int
    user32.SetClipboardData.argtypes = [ctypes.c_uint, ctypes.c_void_p]
    user32.SetClipboardData.restype = ctypes.c_void_p
    kernel32.GlobalAlloc.argtypes = [ctypes.c_uint, ctypes.c_size_t]
    kernel32.GlobalAlloc.restype = ctypes.c_void_p
    kernel32.GlobalLock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalLock.restype = ctypes.c_void_p
    kernel32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    data = text.encode("utf-16-le") + b"\x00\x00"
    deadline = time.time() + 1.5
    while time.time() < deadline:
        if user32.OpenClipboard(0):
            break
        time.sleep(0.05)
    else:
        return
    try:
        h = kernel32.GlobalAlloc(GMEM_MOVEABLE, len(data))
        if not h:
            return
        p = kernel32.GlobalLock(h)
        if not p:
            kernel32.GlobalFree(h)  # 审计 M3：GlobalLock 失败须释放 h，否则句柄泄漏
            return
        try:
            ctypes.memmove(p, data, len(data))
        finally:
            kernel32.GlobalUnlock(h)
        user32.EmptyClipboard()
        res = user32.SetClipboardData(CF_UNICODETEXT, h)
        if not res:
            kernel32.GlobalFree(h)  # 审计 M3：SetClipboardData 失败→所有权未转移，须释放 h
            return
    finally:
        user32.CloseClipboard()


def parse_ss_to_commands(text):
    """解析 `-ss S -to E` / `-ss S -t D` 逐行文本 → [(start_sec, end_sec), ...]。
    与分段拼接右栏导入同格式（复制时间按钮输出 `-ss 12.345 -to 20.000` 可直接粘贴）；
    跳过空行/# 注释/无 -ss 或无 -t/-to/时间无效/结束早于开始的行。"""
    import re as _re
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = _re.search(r"-ss\s+([\d:.]+)", line, _re.IGNORECASE)
        if not m:
            continue
        s = time_to_seconds(m.group(1))
        if s is None:
            continue
        tm = _re.search(r"-t\s+([\d:.]+)", line, _re.IGNORECASE)
        tom = _re.search(r"-to\s+([\d:.]+)", line, _re.IGNORECASE)
        if tm:
            d = time_to_seconds(tm.group(1))
            if d is None:
                continue
            e = s + d
        elif tom:
            e = time_to_seconds(tom.group(1))
            if e is None:
                continue
        else:
            continue
        if e <= s:
            continue
        out.append((s, e))
    return out


def detect_format(text):
    """内容嗅探：返回 FORMAT_* 之一。text 为文件全部内容。"""
    if not text:
        return FORMAT_CSV
    head = text[:2000]
    # FFmetadata
    if ";FFMETADATA1" in head and "[CHAPTER]" in head:
        return FORMAT_FFMETADATA
    # EDL：TITLE: 开头或 001 001 V C 事件行
    if re.search(r"(?m)^TITLE:\s", head) or re.search(r"(?m)^\d{3}\s+\d{3}\s+[VAvA]\s+C\s", head):
        return FORMAT_EDL
    # CUE：FILE "..."（单双引号均可）+ INDEX 01
    if re.search(r"(?im)^FILE\s+['\"]", head) and re.search(r"(?im)^\s*INDEX\s+01\s+\d+:\d+:\d+", head):
        return FORMAT_CUE
    # YouTube：行首 MM:SS 或 H:MM:SS 时间戳 + 标题
    yt_lines = [ln for ln in text.splitlines() if re.match(r"^\d{1,2}:\d{2}(?::\d{2})?\s+\S", ln)]
    if len(yt_lines) >= 1 and not re.search(r",|\t", head):
        return FORMAT_YOUTUBE
    return FORMAT_CSV


# ---------------------------------------------------------------------------
# 解析
# ---------------------------------------------------------------------------

def parse_ffmetadata(text):
    """解析 FFmetadata 章节 -> 内部模型列表。START/END 按 TIMEBASE 换算为秒。"""
    chapters = []
    cur = None
    timebase = 1000000  # 默认 1/1000000（微秒）
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("TIMEBASE="):
            tb = line.split("=", 1)[1].strip()
            m = re.fullmatch(r"(\d+)/(\d+)", tb)
            if m:
                den = float(m.group(2))
                timebase = den / float(m.group(1)) if float(m.group(1)) else 1.0
            else:
                timebase = 1.0
            continue
        if line == "[CHAPTER]":
            cur = {"start": None, "end": None, "title": None, "_raw_start": None, "_raw_end": None}
            chapters.append(cur)
        elif cur is not None:
            if line.upper().startswith("START="):
                cur["_raw_start"] = _opt_float(line.split("=", 1)[1])
            elif line.upper().startswith("END="):
                cur["_raw_end"] = _opt_float(line.split("=", 1)[1])
            elif line.upper().startswith("TITLE="):
                cur["title"] = line.split("=", 1)[1]
    result = []
    for c in chapters:
        if c["_raw_start"] is None:
            continue
        # timebase = "1 单位 = 多少微秒"（TIMEBASE=1/1000 → 1000 微秒 = 1 毫秒）
        start = c["_raw_start"] * timebase / 1000000.0
        end = c["_raw_end"] * timebase / 1000000.0 if c["_raw_end"] is not None else None
        result.append({
            "start": start,
            "title": c["title"] if c["title"] is not None else "",
            "end": end,
        })
    return result


def parse_cue(text):
    """解析 CUE -> 内部模型列表。TRACK 的 INDEX 01 是起点，TITLE 是曲名。"""
    chapters = []
    cur = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("TRACK "):
            cur = {"start": None, "title": None}
            chapters.append(cur)
        elif cur is not None:
            up = line.upper()
            if up.startswith("TITLE"):
                # TITLE "..." 或 TITLE '...' 或 TITLE 裸文本
                raw = line[5:].strip()
                if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ('"', "'"):
                    raw = raw[1:-1]
                cur["title"] = raw
            elif up.startswith("INDEX"):
                parts = up.split()
                if len(parts) >= 3 and parts[1] == "01":
                    cur["start"] = parse_cue_tc(parts[2])
    result = []
    for c in chapters:
        if c["start"] is None:
            continue
        result.append({
            "start": c["start"],
            "title": c["title"] if c["title"] is not None else "",
            "end": None,
        })
    return result


def parse_edl(text, fps=25.0):
    """解析 EDL -> 内部模型列表。每个事件行的事件起止时间转为章节。"""
    chapters = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        m = re.match(r"^\d{3}\s+\d{3}\s+[VAvA]\s+C\s+(\S+)\s+(\S+)", line)
        if not m:
            continue
        start = parse_edl_tc(m.group(1), fps)
        end = parse_edl_tc(m.group(2), fps)
        if start is None:
            continue
        chapters.append({"start": start, "end": end, "title": ""})
    return chapters


def parse_csv(text, delimiter=None):
    """解析 CSV/文本 -> 内部模型列表。每行: 时间[,分隔]标题（或 时间 标题）。
    自动探测分隔符（逗号/制表符）。标题可选。"""
    if delimiter is None:
        first = text.splitlines()[0] if text.splitlines() else ""
        delimiter = "\t" if "\t" in first else ","
    chapters = []
    for line in text.splitlines():
        line = line.rstrip("\r\n")
        if not line.strip():
            continue
        if delimiter in line:
            parts = [p.strip() for p in line.split(delimiter)]
            time_part = parts[0]
            title = parts[1] if len(parts) > 1 else ""
        else:
            # 无分隔符：尝试 "时间 标题"（空格分隔）
            m = re.match(r"^(\S+)\s+(.+)$", line.strip())
            if m:
                time_part, title = m.group(1), m.group(2)
            else:
                time_part, title = line.strip(), ""
        start = parse_hms_ms(time_part)
        if start is None:
            continue
        chapters.append({"start": start, "title": title.strip(), "end": None})
    return chapters


def parse_youtube(text):
    """解析 YouTube 时间戳文本 -> 内部模型列表。每行 "MM:SS 标题"。"""
    chapters = []
    for line in text.splitlines():
        line = line.rstrip("\r\n")
        m = re.match(r"^(\d{1,2}:\d{2}(?::\d{2})?(?:\.\d+)?)\s+(.+)$", line.strip())
        if not m:
            continue
        start = parse_hms_ms(m.group(1))
        if start is None:
            continue
        chapters.append({"start": start, "title": m.group(2).strip(), "end": None})
    return chapters


def parse_text(text, fmt=None, fps=25.0):
    """按指定格式（或自动嗅探）解析文本 -> 内部模型列表"""
    if fmt is None:
        fmt = detect_format(text)
    if fmt == FORMAT_FFMETADATA:
        return parse_ffmetadata(text)
    if fmt == FORMAT_CUE:
        return parse_cue(text)
    if fmt == FORMAT_EDL:
        return parse_edl(text, fps)
    if fmt == FORMAT_CSV:
        return parse_csv(text)
    if fmt == FORMAT_YOUTUBE:
        return parse_youtube(text)
    return []


def parse_file(path, fmt=None, fps=25.0):
    """按指定格式（或自动嗅探）解析文件 -> 内部模型列表"""
    text = chapter_fmts.read_text_auto(path)
    return parse_text(text, fmt, fps)


# ---------------------------------------------------------------------------
# 导出
# ---------------------------------------------------------------------------

def export_ffmetadata(chapters):
    """内部模型 -> FFmetadata 文本"""
    lines = [";FFMETADATA1"]
    for c in chapters:
        lines.append("[CHAPTER]")
        lines.append("TIMEBASE=1/1000")
        lines.append("START=%d" % int(round(c["start"] * 1000)))
        end_ms = int(round(c["end"] * 1000)) if c.get("end") is not None else int(round(c["start"] * 1000))
        lines.append("END=%d" % end_ms)
        lines.append("title=%s" % c.get("title", ""))
        lines.append("")
    return "\n".join(lines) + "\n"


def export_cue(chapters, title=""):
    """内部模型 -> CUE 文本"""
    lines = []
    if title:
        lines.append('REM GENRE "Chapters"')
        lines.append('TITLE "%s"' % title.replace('"', "'"))
    lines.append('FILE "chapters.cue" WAVE')
    for i, c in enumerate(chapters, 1):
        lines.append("  TRACK %02d AUDIO" % i)
        if c.get("title"):
            lines.append('    TITLE "%s"' % c["title"].replace('"', "'"))
        ms = int(round((c["start"] % 1) * 75))
        total_s = int(c["start"])
        mi, s = divmod(total_s, 60)
        lines.append("    INDEX 01 %02d:%02d:%02d" % (mi, s, ms))
    return "\n".join(lines) + "\n"


def export_edl(chapters, fps=25.0):
    """内部模型 -> EDL 文本（SMPTE 时间码 HH:MM:SS:FF）"""
    lines = ["TITLE: Chapters", "FCM: NON-DROP FRAME"]
    for i, c in enumerate(chapters, 1):
        start = c["start"]
        end = c.get("end")
        if end is None:
            end = start  # 无 end 时用起点占位
        start_tc = _format_edl_tc(start, fps)
        end_tc = _format_edl_tc(end, fps)
        lines.append("%03d  %03d  V     C        %s %s %s %s" % (
            i, i, start_tc, end_tc, start_tc, end_tc))
        if c.get("title"):
            lines.append("* FROM CLIP NAME: %s" % c["title"].replace("|", "/"))
    return "\n".join(lines) + "\n"


def _format_edl_tc(seconds, fps=25.0):
    seconds = max(0.0, float(seconds))
    total_frames = int(round(seconds * fps))
    fr = total_frames % int(round(fps))
    total_s = total_frames // int(round(fps))
    h, rem = divmod(total_s, 3600)
    m, s = divmod(rem, 60)
    return "%02d:%02d:%02d:%02d" % (h, m, s, fr)


def build_concat_segments_from_tracks(tracks):
    """串行合并（首尾拼接）预览/导出共用的视频轨收集（纯函数，便于无头测试）。

    入参 tracks：与 self.merge_tracks 同结构的轨道列表（每个元素需有
        .enabled / .type / .file_path / .enc_settings 属性）。
    返回 (segs, skipped)：
        segs   : [{"path": normalize_path 后路径,
                   "start": float(秒), "dur": float|None(=播到结尾),
                   "trim": bool(是否启用 trim)}, ...]
        skipped: 被跳过的轨道 file_path 列表（占位/错误/文件不存在）。
    ⚠ 不做任何路径字符过滤（`=` `,` `;` `!` `%` 全保留），具体能否进 EDL 由各
        格式化函数决定：内联 edl:// 与文件版同解析器，统一用
        _edl_escape_path 的 %<字节数>%<字面值> 长度守卫（旧注释「内联禁 =、
        文件版需转义 , ;」已实测证伪，2026-10-03）。
    """
    segs, skipped = [], []
    for t in tracks:
        if not getattr(t, "enabled", False) or getattr(t, "type", None) != "video":
            continue
        es = getattr(t, "enc_settings", {}) or {}
        if es.get("_placeholder", False) or es.get("_error"):
            skipped.append(getattr(t, "file_path", None))
            continue
        fp = getattr(t, "file_path", None)
        if not fp or not os.path.exists(fp):
            skipped.append(fp)
            continue
        start, dur, trim = 0.0, None, False
        if es.get("trim_enabled", False):
            trim = True
            ss = str(es.get("trim_start", "0") or "0").strip()
            s = time_to_seconds(ss) if ss else 0.0
            if s is None or s < 0:
                s = 0.0
            ee = str(es.get("trim_end", "") or "").strip()
            if ee:
                e = time_to_seconds(ee)
                if e is not None and e > s:
                    dur = e - s
            start = s
        segs.append({"path": normalize_path(fp), "start": start, "dur": dur, "trim": trim})
    return segs, skipped


def format_mpv_edl_inline(segs):
    """内联 edl:// 条目 -> ["file,start,dur", ...]。
    路径统一走 _edl_escape_path（mpv 官方 %<字节数>%<字面值> 长度守卫），
    因此调用方**不必**再过滤含 `=` 的路径（旧限制已拆，2026-10-03 实测）。"""
    out = []
    for s in segs:
        p = _edl_escape_path(s["path"])
        if s["trim"]:
            if s["dur"] is not None:
                out.append("%s,%.6f,%.6f" % (p, s["start"], s["dur"]))
            else:
                out.append("%s,%.6f" % (p, s["start"]))
        else:
            out.append(p)
    return out


def _edl_file_title(path):
    """mpv EDL 条目第 4 参数 `title=` 的值 —— **纯文件名**（把前面路径整段去掉）。

    官方语法（mpv DOCS/edl-mpv.rst「Implicit chapters」）：::

        # mpv EDL v0
        cap.ts,5,240
        OP.mkv,0,90,title=Show Opening

    mpv 会给每段条目的虚拟时间线插一个隐式章节，默认章节标题 = 该条目的**文件名**，
    所以不写 title 时章节里显示的是完整路径，路径一长（G:/a/UIDxxx_琪公主_发布作品/
    7541606378838920483-#有点上头....mp4）OSD 上就只看见前面一截 ⇒ 显式写 title=，
    只放文件名。

    ⚠ 与 _edl_escape_path 同一套「%<字节数>%<字面值>」守卫**必须再包一层**：
      param 的普通 <value> 只允许除 `,;!` 与换行以外的字符，文件名里一个逗号
      （`a,b.mkv`）就会把这条条目切成 5 段、file/start/length 全串位。
      guard 里的 valuebytes 原样取值，逗号分号全安全。
    ⚠ 字节数按 UTF-8 算（中文文件名正确），不是字符数。
    """
    name = path.rstrip("/").rsplit("/", 1)[-1] or path
    return "%%%d%%%s" % (len(name.encode("utf-8")), name)


def format_mpv_edl_file(segs):
    """mpv 原生 EDL 文件内容（含首行 `# mpv EDL v0`，UNIX/LF 换行）。
    ⚠ 必须以 LF 换行、首行固定头，否则 mpv 解析失败（最常见的「播不起来」原因）。
    路径统一走 _edl_escape_path（与内联同一套 %<字节数>%<字面值> 长度守卫）。
    ⚠ 旧注释写「文件版 `=` 合法、只需转义 , ;」是**错的**（2026-10-03 实测）：
    文件版与内联是同一个 EDL 解析器（;` 只是换行的等价物），裸 `=` 同样被当
    name=value 分割点 → 含 `=` 的路径导出的 .edl 也播不了，已一并修好。
    ⚠ 文件版每条**都**带第 4 参数 `title=<文件名>`（内联版刻意不加，见
      format_mpv_edl_inline）——导出的 .edl 是要给人看/以后再播的，
      章节标题显示短文件名比一长串路径有用。
    """
    lines = ["# mpv EDL v0"]
    for s in segs:
        p = _edl_escape_path(s["path"])
        title = "title=" + _edl_file_title(s["path"])
        if s["trim"]:
            if s["dur"] is not None:
                lines.append("%s,%.6f,%.6f,%s" % (p, s["start"], s["dur"], title))
            else:
                lines.append("%s,%.6f,%s" % (p, s["start"], title))
        else:
            lines.append("%s,%s" % (p, title))
    return "\n".join(lines) + "\n"


def _edl_escape_path(p):
    """mpv EDL 路径转义 —— **内联 edl:// 与实体 .edl 文件同一套写法**。

    官方语法（mpv DOCS/edl-mpv.rst）：
        param ::= [ <name> '=' ] ( <value> | '%' <number> '%' <valuebytes> )
    `%<字节数>%<字面值>` 是「任意内容守卫」：valuebytes 原样取值，
    因此其中出现 `=` `,` `;` `!` `%` 换行都不再参与语法解析。
    ⚠ 实测（2026-10-03，mpv 0.41 无头真机，tests/_verify_edl_escape.py）：
      · 裸路径含 `=` 或 `,`：`file=` 命名参数会被切成 name/value 两半 → 打不开；
      · 反斜杠 `\\,` `\\;`（旧写法）：`a,b.mp4` 同样打不开 —— **已废弃，不要再用**；
      · 只转义 `,` `;` 而不管 `=`（旧 `_edl_file_escape` 的短路分支）：文件版也打不开；
      · 本函数（无条件长度守卫）：`=` `,` `;` `!` `%` 空格 `#` 中文 六种怪名全 PASS；
      · 对照：`file://` + 百分号 URL 编码 除「文件名含字面 `%`」外都 PASS，故不用它。
    ⚠ 两处纪律：① 无条件守卫，禁「只在含分隔符时才转义」的短路（否则 `=` 必漏）；
    ② 字节数按 UTF-8 算（中文路径正确），不是字符数。
    """
    return "%%%d%%%s" % (len(p.encode("utf-8")), p)


def export_csv(chapters, delimiter=","):
    """内部模型 -> CSV 文本（时间,标题）"""
    lines = []
    for c in chapters:
        lines.append("%s%s%s" % (format_seconds_short(c["start"]), delimiter, c.get("title", "")))
    return "\n".join(lines) + "\n"


def export_youtube(chapters):
    """内部模型 -> YouTube 时间戳文本（MM:SS 标题）"""
    lines = []
    for c in chapters:
        lines.append("%s %s" % (format_seconds_short(c["start"]), c.get("title", "")))
    return "\n".join(lines) + "\n"


def _srt_tc(sec):
    """秒 -> SRT 时间码 HH:MM:SS,mmm（毫秒 3 位）。"""
    sec = max(0.0, float(sec))
    ms = int(round((sec - int(sec)) * 1000))
    if ms >= 1000:
        ms = 999
    h, rem = divmod(int(sec), 3600)
    m, s = divmod(rem, 60)
    return "%02d:%02d:%02d,%03d" % (h, m, s, ms)


def _ssa_tc(sec):
    """秒 -> SSA/ASS 时间码 h:mm:ss.cc（厘秒 2 位）。ASS 规范 cc 只允许 0-99，毫秒 3 位会被解析器拒收/误读。"""
    sec = max(0.0, float(sec))
    cs = int(round((sec - int(sec)) * 100))
    if cs >= 100:
        cs = 99
    h, rem = divmod(int(sec), 3600)
    m, s = divmod(rem, 60)
    return "%d:%02d:%02d.%02d" % (h, m, s, cs)


def _chapter_end(chapters, i, fallback=2.0):
    """章节结束时间：有 end 用 end；无 end 用下一条的 start；最后一条 start+fallback。"""
    c = chapters[i]
    if c.get("end") is not None:
        return float(c["end"])
    if i + 1 < len(chapters):
        return float(chapters[i + 1]["start"])
    return float(c["start"]) + fallback


def export_srt(chapters):
    """内部模型 -> SRT 字幕文本（章节标题作为字幕文本，可改名 .srt 供播放器/剪辑软件用）"""
    lines = []
    for i, c in enumerate(chapters, 1):
        lines.append(str(i))
        lines.append("%s --> %s" % (_srt_tc(c["start"]), _srt_tc(_chapter_end(chapters, i - 1))))
        lines.append(c.get("title", "") or " ")
        lines.append("")
    return "\n".join(lines) + "\n"


def export_ssa(chapters):
    """内部模型 -> SSA 字幕文本（可改名 .ass；含 V4 默认样式，时间码厘秒 2 位）

    样式段必须有：Dialogue 引用 Default 样式而文件里无定义时，部分播放器/libass
    行为异常（实测显示时间错位）。整体结构与 Aegisub 保存的 .ssa 一致，
    兼容 .ssa/.ass 两种后缀（ASS 播放器可读 SSA，反之不行，故输出 SSA 最稳）。
    """
    lines = [
        "[Script Info]",
        "ScriptType: v4.00",
        "PlayResX: 1920",
        "PlayResY: 1080",
        "YCbCr Matrix: TV.709",
        "",
        "[V4 Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, TertiaryColour, BackColour, Bold, Italic, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, AlphaLevel, Encoding",
        "Style: Default,Arial,48,16777215,255,0,0,0,0,1,2,2,2,10,10,10,0,1",
        "",
        "[Fonts]",
        "",
        "[Graphics]",
        "",
        "[Events]",
        "Format: Marked, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for i, c in enumerate(chapters):
        s = _ssa_tc(c["start"])
        e = _ssa_tc(_chapter_end(chapters, i))
        txt = (c.get("title", "") or " ").replace("\n", " ").replace(",", ";")
        lines.append("Dialogue: Marked=0,%s,%s,Default,,0,0,0,,%s" % (s, e, txt))
    return "\n".join(lines) + "\n"


def export_text(chapters, fmt, fps=25.0):
    """按指定格式导出内部模型 -> 文本"""
    if fmt == FORMAT_FFMETADATA:
        return export_ffmetadata(chapters)
    if fmt == FORMAT_CUE:
        return export_cue(chapters)
    if fmt == FORMAT_EDL:
        return export_edl(chapters, fps)
    if fmt == FORMAT_CSV:
        return export_csv(chapters)
    if fmt == FORMAT_YOUTUBE:
        return export_youtube(chapters)
    if fmt == FORMAT_SRT:
        return export_srt(chapters)
    if fmt == FORMAT_SSA:
        return export_ssa(chapters)
    return ""


def export_file(chapters, path, fmt, fps=25.0):
    """按指定格式导出内部模型 -> 文件"""
    text = export_text(chapters, fmt, fps)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path


# ---------------------------------------------------------------------------
# 便捷：内部模型 -> 应用可用的 FFmetadata 临时文件路径
# ---------------------------------------------------------------------------

def write_ffmetadata_temp(chapters, tmpdir=None):
    """把内部模型写成 FFmetadata 临时文件，返回文件路径（调用方负责清理）。"""
    import tempfile
    text = export_ffmetadata(chapters)
    fd, path = tempfile.mkstemp(suffix=".txt", prefix="ffchapter_", dir=tmpdir, text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    return path


