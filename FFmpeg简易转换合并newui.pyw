        ttk.Label(row1, text="高:").pack(side=tk.LEFT, padx=(10,0))
        self.h_var = tk.StringVar(value=self.filter_frame._blur_h.get())
        h_entry = ttk.Entry(row1, textvariable=self.h_var, width=6)
