def normalize_deinterlace_filter(value):
    """把旧版 deinterlace_filter 值迁移为当前有效值；非 str 原样返回（空值判断交给调用方）。"""
    if isinstance(value, str):
        return _DEINTERLACE_LEGACY_ALIASES.get(value, value)
    return value

