        "libsvtav1":  ["0", "1", "2", "3", "4", "5", "6", "7", "8"],   # SVT-AV1 预设 0~8，速度从快到慢
        "mpeg4":      ["medium"],
        "libxvid":    ["medium"],
        "libtheora":  ["medium"],

        # NVENC
