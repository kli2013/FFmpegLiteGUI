def _look_with_enable(chain, enable_expr):
    """给风格 look 链逐个子滤镜挂同一份时间段 enable 表达式（接入 enh_seg，2026-10-03）。

    为什么要单独写（而不是把 look 塞进 enh 段统一包裹）：链里的 `format=`
    **不支持 timeline** —— 实测 n9.0.1 报

        Timeline ('enable' option) not supported with filter 'format'
        （4.3 报 Use '|' to separate the filters）

    挂上去整条链都跑不起来。故对 `format=` 跳过（常开），其余滤镜照常挂 enable，
    链尾补一枚 `format=yuv420p` 把像素格式收回。跳过 format 的判据与
    `_scale_look_chain` 同款（按 '=' 前的名字比较）。

    ⚠️ 别拿「窗口外帧 == 原帧」当验收判据 —— 多滤镜链的 yuv420p↔rgb 静态格式协商会带来
    max=2 / mean=0.35 的往返舍入（80750 个差异字节全是它，肉眼不可见），写了会假 FAIL。
    正确判据见 tests/_test_look_seg_enable.py E1–E5：窗口外**逐字节 == 同链挂恒假 enable
    （gte(t,9999)）** → 证明被真正关闭；窗口内 max 差 >8 → 证明真的生效。

    ⚠️ 链拆分依赖「选项值里没有裸逗号」：现 18 个预设的选项一律用 ':' 分隔参数、
    curves 的点对用空格分隔，成立；新增预设不得在选项值里写裸逗号。
    """
    if not chain or not enable_expr:
        return chain
    out = []
    _has_fmt = False
    for part in chain.split(','):
        _p = part.strip()
        if not _p:
            continue
        if _p.split('=', 1)[0].strip() == "format":
            _has_fmt = True
            out.append(_p)
            continue
        out.append(_p + _region_enable_suffix(enable_expr, _p))
    if _has_fmt:
        out.append("format=yuv420p")
    return ','.join(out)


def build_video_filter_chain(settings: Dict[str, Any], include_subtitle: bool = True, include_speed: bool = True,
                              include_trim: bool = True, include_format: bool = True, include_scale: bool = True,
                              enhance_settings=None, reverse=False, graph_id: str = "",
                              include_fade: bool = True, clip_duration=None,
                              include_negate: bool = True,
                              include_mask: bool = True,
                              chroma_settings=None, loop_size=None, force_scale=None,
                              motion_trim_start=None, motion_speed_factor=None,
                              window_start=None, window_end=None, window_loop_count=None) -> str:
    """
    从设置字典构建视频滤镜链。
    include_subtitle: 是否包含字幕滤镜
    include_speed: 是否包含变速滤镜
    include_trim: 是否包含精准截取（trim+setpts）滤镜
    include_format: 是否包含像素格式转换（format）滤镜
    enhance_settings:高级一点的滤镜
    graph_id: 当本滤镜链会被拼进同一个 filter_complex（画中画/串联合并等多路场景）时，
              调用方传入唯一标识，用于给「局部模糊」等带标签的子图生成互不冲突的标签名。
    顺序优化：
    精准截取 → 局部模糊/去水印 → 裁剪 → 旋转/翻转 → 缩放 → IVTC（反胶卷过带） → 反交错 →
    去块滤波 → 降噪 → 锐化 → 色彩空间转换 → 颜色校正+色相 → 像素格式 → 变速 → 倒放
    绿幕/纯色抠像默认插在缩放之后（小图抠）；与去水印/区域效果同时启用时改前置到
    链首（精准截取/loop 之后、去水印之前），保证抠像取样以原始画面为准。

    注意：「局部模糊」会生成带标签的分支子图（split/overlay），返回值可能是包含 ';' 的
    完整 filtergraph，而不再是单纯的逗号串。-vf 与 filter_complex 均支持该语法。
    """
    filters = []

    # 绿幕/纯色抠像滤镜串（公共拼装，见 _build_chroma_filter）：默认插在缩放后；
    # 与区域滤镜（delogo/局部效果）同时启用时前置到链首——区域链里带颜色处理的
    # 类型会改写区域色度，抠像若排在区域链之后会吃到被改过的像素 → 抠不干净。
    _chroma_f = _build_chroma_filter(chroma_settings)
    _chroma_front = bool(_chroma_f) and _has_region_fx(settings)

    # 提前确定硬件滤镜模式与「帧是否已在显存」（供像素格式处理使用）
    _filter_mode = settings.get("hw_filter_mode")
    if not _filter_mode:
        if settings.get("wrap_cpu_nvidia"):
            _filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            _filter_mode = "vaapi"
        else:
            _filter_mode = "cpu"
    _hw_active = _filter_mode in ("cuda", "qsv", "vaapi")
    _native = _hw_active and settings.get("hwaccel_enabled", False) and _decoder_matches_api(settings.get("hwaccel_decoder", ""), _filter_mode)

    # ----- 精准截取（trim + setpts）-----
    if include_trim and settings.get("precise_trim", False) and settings.get("trim_enabled", False):
        start = settings.get("trim_start", "").strip()
        end = settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start) if start else None
        end_sec = time_to_seconds(end) if end else None
        if start_sec is not None or end_sec is not None:
            trim_parts = []
            if start_sec is not None:
                trim_parts.append(f"start={_ffsec(start_sec)}")
            if end_sec is not None:
                trim_parts.append(f"end={_ffsec(end_sec)}")
            if trim_parts:
                filters.append(f"trim={':'.join(trim_parts)}")
                filters.append("setpts=PTS-STARTPTS")

    # ----- 子视频循环（loop）-----
    # loop_size 非 None 时在 trim 之后、其余滤镜之前插 loop（子视频画中画/水印用：
    # movie 层只载入不循环，由这里统一循环 trim 片段或整段）。非循环场景（主视频/普通转码）
    # 不传 loop_size，行为不变。
    # ⚠️ 2026-09-02 窗口优化（抄统一尝试版）：当 window 生效（有界显示窗口）时，loop 改为
    # 「有限循环，仅覆盖窗口时长」(loop=loop=窗口循环次数:size=片段长)，而非无限 loop=-1 ——
    # 即凡是有限显示都走 loop=N 节省模式；仅「无界窗口」(show_start 无 end / loop_mode=infinite)
    # 才维持无限 loop=-1。窗口外不产生帧、下游重滤镜只在窗口内运行，省掉「enable 隐藏但内部
    # 照跑」的浪费；并把子链首帧锚到输出时间线 show_start，子链在 show_end 正常 EOF，
    # 配合调用方追加 eof_action=pass 避免冻帧/截断。
    # ⚠️ 结构（与统一尝试版 2869 逐字一致）：**window 判定在外层**，loop_size 在内层——
    # 不能写成「loop_size 在外、window 在内」，否则未开截取（loop_size=None）时窗口锚定
    # 不生效，有限显示窗口形同虚设。
    if window_start is not None and window_end is not None and window_end > window_start:
        if loop_size is not None and loop_size > 0:
            # window_loop_count = **重复次数**（总供给 = N+1 遍）。显式 0 = 窗口一遍即满，
            # 不加 loop（防回放帧 pts 回退泄漏进显示边界 → 闪首帧）；None 才兜底 1（旧行为）。
            if window_loop_count is None:
                _wc = 1
            else:
                _wc = int(window_loop_count)
            if _wc > 0:
                filters.append(f"loop=loop={_wc}:size={int(loop_size)}:start=0")
        # 锚定子链首帧到输出时间线 show_start（TB=输入时基，show_start/TB 即 show_start 秒）。
        # 此时 PTS 已归零（截取/loop 保证），setpts 同时完成重置+偏移；窗口外不产生帧。
        filters.append(f"setpts=PTS-STARTPTS+{float(window_start):.6g}/TB")
    else:
        if loop_size is not None and loop_size > 0:
            filters.append(f"loop=loop=-1:size={int(loop_size)}:start=0")

    # ----- 绿幕/纯色抠像（前置模式：与区域滤镜同开时排到滤镜链最前）-----
    # 区域链（delogo/局部效果）中带颜色处理的类型会改写区域色度；抠像若排在区域链之后，
    # 取样吃到的是被改过的像素 → 抠不干净。两者同开时把抠图提到区域链之前（仅在
    # trim/loop 之后），取样以原始画面为准。
    # ⚠️ 2026-09-07 实测 n9.0.1：chromakey/colorkey 输出带 alpha，其后接 delogo / eq /
    # negate / boxblur / lutyuv 及区域子图(split/overlay)，alpha 全程保留（自动插入的
    # 格式转换不丢透明），前置无副作用。
    if _chroma_front:
        filters.append(_chroma_f)

    # ----- 去水印/模糊（必须排在裁剪/旋转/缩放之前，坐标才与原始帧一致）-----
    # 显示时段换算基准（2026-09-13 修复）：本链 trim+setpts 已把滤镜 t 归零，delogo/
    # 区域效果的 enable 窗口若直接用源时间会整体右偏 trim 起点（如 trim=6.567 起、
    # 窗口 between(t,6.567,20) 的前 6.567s 永不命中）。基准解析与 crop_pos 同源
    # （motion_trim_start 优先，否则取 settings 的 trim_start）。
    # ⚠️ 只减 trim 不除 speed：区域链位在变速 setpts 之前（链尾 drawtext 才做全换算）。
    if motion_trim_start is not None:
        _blur_tbase = float(motion_trim_start)
    else:
        _blur_tbase, _unused = _trim_speed_from_settings(settings)
    if settings.get("blur_enabled", False):
        # 多区域列表（2026-08-26）：遍历 blur_items 生成多条；无列表时回退旧单键（统一出口）
        blur_items = _effective_blur_items(settings)
        for _bi in blur_items:
            if not _bi.get("enabled", True):
                continue
            blur_type = str(_bi.get("type", "delogo") or "delogo").strip()
            x = str(_bi.get("x", "0")).strip() or "0"
            y = str(_bi.get("y", "0")).strip() or "0"
            w = str(_bi.get("w", "100")).strip() or "100"
            h = str(_bi.get("h", "100")).strip() or "100"
            strength = _bi.get("strength", "5")
            region_only = _bi.get("region_only", False)

            # 显示时段 / 循环控制（与文字水印同套 enable 表达式；2026-08-26 新增）
            _enable_expr = _build_drawtext_enable(_bi, trim_start=_blur_tbase)
            _sfx_en = f":enable='{_enable_expr}'" if _enable_expr else ""

            if blur_type == "delogo":
                filters.append(f"delogo=x={x}:y={y}:w={w}:h={h}{_sfx_en}")
            elif blur_type in _REGION_EFFECT_FILTERS:
                # 区域效果（2026-09-07）：局部反色 / 镜像 / 去色 / 纯色 / 锐化 / 描边 …
                # 全部走同一条并行子图，恒局部（不看 region_only）。新增类型只改
                # _REGION_EFFECT_FILTERS，不必动这里。
                _spec = _REGION_EFFECT_FILTERS[blur_type]
                _tpl = _spec["tpl"]
                if "{s}" in _tpl:
                    _sv = str(strength).strip() or str(_spec.get("default", ""))
                    _f = _tpl.format(s=_sv)
                else:
                    _f = _tpl
                # ⚠️ 无参滤镜（negate/hflip…）必须 =enable=，冒号写法 ffmpeg 解析失败
                _f += _region_enable_suffix(_enable_expr, _f)
                if _bi.get("full_frame", False):
                    # 全帧时间段效果（2026-09-07）：不框区域，直接主链追加。
                    # 时间段（enable）照常生效 → 「5~8 秒亮度高一点」这类需求；
                    # 卷积类全帧无裁剪边界 → 无需 bleed。delogo/boxblur/gblur 不走此路
                    #（delogo 必须框区域；boxblur/gblur 不勾「仅应用到选定区域」即全帧）。
                    filters.append(_f)
                else:
                    _sfx = graph_id or ""
                    _idx = blur_items.index(_bi) if blur_items else 0
                    _sfx += f"{_spec.get('tag', 'e')}{_idx}"
                    _bg, _fg, _bl = f"rb{_sfx}bg", f"rb{_sfx}fg", f"rb{_sfx}bl"
                    if _spec.get("neighbor"):
                        # 卷积类：外扩 k px 处理完再裁回原尺寸，消除区域边缘的硬接缝
                        _outer, _inner = _region_bleed_geom(x, y, w, h, int(_spec.get("bleed", 8)))
                        _sub = f"{_outer},{_f},{_inner}"
                    else:
                        _sub = f"crop={w}:{h}:{x}:{y},{_f}"
                    filters.append(
                        f"split=2[{_bg}][{_fg}];"
                        f"[{_fg}]{_sub}[{_bl}];"
                        f"[{_bg}][{_bl}]overlay={x}:{y}"
                    )
            elif blur_type in ("boxblur", "gblur"):
                if blur_type == "boxblur":
                    _blur_f = f"boxblur={strength}:{strength}{_sfx_en}"
                else:
                    _blur_f = f"gblur=sigma={strength}{_sfx_en}"
                if region_only and w and h:
                    # 局部模糊：把原帧一分为二，一路裁出目标区域做模糊，再叠回原位。
                    # 生成的是带标签的分支子图，因此本函数返回值可能含 ';'。
                    # 多条时用序号后缀避免标签冲突。
                    # 2026-09-07：卷积类同样外扩，消除区域边缘的硬接缝（11dB → 65dB）。
                    _sfx = graph_id or ""
                    _idx = blur_items.index(_bi) if blur_items else 0
                    _sfx += f"b{_idx}"
                    _bg, _fg, _bl = f"rb{_sfx}bg", f"rb{_sfx}fg", f"rb{_sfx}bl"
                    _outer, _inner = _region_bleed_geom(x, y, w, h, _REGION_BLUR_BLEED.get(blur_type, 24))
                    filters.append(
                        f"split=2[{_bg}][{_fg}];"
                        f"[{_fg}]{_outer},{_blur_f},{_inner}[{_bl}];"
                        f"[{_bg}][{_bl}]overlay={x}:{y}"
                    )
                else:
                    filters.append(_blur_f)

    # ----- 遮罩 / 透明蒙版：实现见「negate 之后」的链尾区块（2026-09-10 两迁：裁剪前 → 缩放后 → 链尾，抠图兼容）-----
    # ----- 裁剪 -----
    if settings.get("crop_enabled", False):
        w = settings.get("crop_width", "").strip()
        h = settings.get("crop_height", "").strip()
        left = settings.get("crop_left", "0").strip()
        top = settings.get("crop_top", "0").strip()
        if w and h:
            # 简易位置：有分段时 x/y 用按时间 t 插值的单引号表达式（QSV 不支持 → 走软件）
            # 2026-08-29：段时间=主视频原始时间，生成时自动换算输出时间线（滤镜 t）
            # 2026-08-30：画布模式已接管「动态移动」，故开启画布模式时忽略 crop_pos（避免双重位移）
            _cps = settings.get("crop_pos_segments")
            _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
            _cpos_on = bool(settings.get("crop_pos_enabled", False))
            if _cps and _cpos_on and not _canvas_on:
                try:
                    if motion_trim_start is not None:
                        _ts0 = float(motion_trim_start)
                        _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
                    else:
                        _ts0, _sp0 = _trim_speed_from_settings(settings)
                    _ex, _ey = build_crop_pos_expr(_cps, left, top,
                                                   trim_start=_ts0, speed_factor=_sp0)
                except Exception:
                    _ex = _ey = None
                # sendcmd 接入（行数 > 阈值；2026-10-01 全量接入）：sendcmd 挂 crop 前同链，
                # 命令目标 = crop 完整别名（graph_id 保证同图多链不撞名）；
                # 静态 x/y 占位 = 首命令值（t=0 命令首帧未应用，同列表航点做法）
                _csc = None
                if _ex and _ey and len(_cps) > _wp_sc_rows_limit():
                    try:
                        _civ = build_crop_pos_intervals(_cps, left, top,
                                                        trim_start=_ts0, speed_factor=_sp0)
                    except Exception:
                        _civ = None
                    if _civ:
                        _csc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                            _civ, f"cpp{graph_id or 'm'}", target=f"crop@cpp{graph_id or 'm'}")
                if _csc is not None:
                    filters.append(f"sendcmd=f='{_csc}'")
                    filters.append(f"crop@cpp{graph_id or 'm'}={w}:{h}:"
                                   f"'{_civ[0][3]:g}':'{_civ[0][4]:g}'")
                elif _ex and _ey:
                    filters.append(f"crop={w}:{h}:'{_ex}':'{_ey}'")
                else:
                    filters.append(f"crop={w}:{h}:{left}:{top}")
            else:
                filters.append(f"crop={w}:{h}:{left}:{top}")

    # ----- 旋转/翻转 -----
    rot = settings.get("rotate", "none")
    if rot == "90":
        filters.append("transpose=1")
    elif rot == "180":
        filters.append("transpose=2,transpose=2")
    elif rot == "270":
        filters.append("transpose=2")
    if settings.get("vflip", False):
        filters.append("vflip")
    if settings.get("hflip", False):
        filters.append("hflip")

    # ----- IVTC（反胶卷过带）-----
    # 隔行场信息在缩小后会被平均丢失，fieldmatch/decimate 需在接近原始分辨率做 → 提前到缩放前
    ivtc_enabled = enhance_settings and enhance_settings.get("ivtc_enabled", False)
    if ivtc_enabled:
        filters.append("fieldmatch,decimate")

    # ----- 反交错（仅当 IVTC 未启用时执行）-----
    # 同样提前到缩放前，保留完整场信息（缩放后反交错易拉丝/误判）
    if not ivtc_enabled:  # 添加条件
        deint = normalize_deinterlace_filter(settings.get("deinterlace_filter", "none"))
        # 防御：旧设置/模板可能存 bool（False/True），str 之外一律忽略，否则会被直接
        # append 进滤镜链导致 ",".join 崩溃（expected str instance, bool found）
        if isinstance(deint, str) and deint not in ("none", ""):
            filters.append(deint)

    # ----- 缩放 -----
    if force_scale is not None and isinstance(force_scale, (tuple, list)) and len(force_scale) == 2:
        # 预览强制渲染尺寸：替代调用方外部手动 scale（防双 scale）
        _fw = int(force_scale[0])
        _fh = int(force_scale[1])
        if _fw > 0 and _fh > 0:
            filters.append(f"scale={_fw}:{_fh}")
    elif include_scale and settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        w = settings.get("scale_width", "").strip()
        h = settings.get("scale_height", "").strip()
        if method == "width" and w:
            filters.append(f"scale={w}:-2")
        elif method == "height" and h:
            filters.append(f"scale=-2:{h}")
        elif method == "exact" and w and h:
            filters.append(f"scale={w}:{h}")

    # ----- 绿幕/纯色抠像（子视频水印/画中画，默认位置）-----
    # 插在缩放之后 → 小图抠（性能）；且颜色校正/色相/反色在其后 → 不影响抠像。
    # 仅当未与区域滤镜（delogo/局部效果）同时启用时在此插入；同时启用时已在链首
    # 前置（见 _chroma_front），保证抠像取样以原始画面为准。
    # 只有画中画/水印子视频传 chroma_settings（非 None 即启用抠像）；主视频/普通转码不传。
    if _chroma_f and not _chroma_front:
        filters.append(_chroma_f)

    # ----- 增强滤镜统一时间段（2026-09-30）：捕获本块起点，块末统一挂 enable -----
    enh_start_idx = len(filters)

    # ----- 去块滤波（2026-08-27：强度 weak/medium/strong + 块尺寸 4/8，覆盖 HandBrake 式 strength/blocksize） -----
    if enhance_settings and enhance_settings.get("deblock_enabled", False):
        _f = str(enhance_settings.get("deblock_strength", "weak") or "weak")
        # 旧值兼容：旧字段存数值（如 4，当时作 block 用）→ 映射 weak
        if _f not in ("weak", "medium", "strong"):
            _f = "weak"
        _blk = int(enhance_settings.get("deblock_block", 4) or 4)
        if _blk not in (4, 8):
            _blk = 4
        filters.append(f"deblock=filter={_f}:block={_blk}")
    
    # ----- 降噪（2026-08-27：hqdn3d 轻量 / nlmeans 高质量，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("denoise_enabled", False):
        spatial = enhance_settings.get("denoise_spatial", 4.0)
        temporal = enhance_settings.get("denoise_temporal", 3.0)
        mode = str(enhance_settings.get("denoise_mode", "hqdn3d") or "hqdn3d")
        if mode == "nlmeans":
            # nlmeans：非局部均值，去噪强但慢（10~50×hqdn3d）；s 范围 [1-30]（实测 ffmpeg 报错确认），
            # 直接映射空间强度值并 clamp；p/pc/r/rc 保持默认
            _s = max(1.0, min(30.0, float(spatial)))
            filters.append(f"nlmeans=s={_s:.1f}:p=7:pc=3:r=5:rc=2")
        else:
            # hqdn3d 参数：空间亮度, 空间色度, 时间亮度, 时间色度
            filters.append(f"hqdn3d={spatial:.1f}:{spatial*0.75:.1f}:{temporal:.1f}:{temporal*0.75:.1f}")
    
    # ----- 锐化（2026-08-27：unsharp USM / cas 对比度自适应，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("sharpen_enabled", False):
        strength = enhance_settings.get("sharpen_strength", 1.0)
        mode = str(enhance_settings.get("sharpen_mode", "unsharp") or "unsharp")
        if mode == "cas":
            # cas：对比度自适应锐化，强度 0-5 → strength 0-1
            _s = max(0.0, min(1.0, float(strength) / 5.0))
            filters.append(f"cas=strength={_s:.2f}")
        else:
            # unsharp 参数：luma_msize_x:luma_msize_y:luma_amount:chroma_msize_x:chroma_msize_y:chroma_amount
            filters.append(f"unsharp=5:5:{strength:.2f}:5:5:{strength*0.5:.2f}")
    

    
    # ----- HDR→SDR 色调映射（2026-09-09：zscale+tonemap 经典链） -----
    # 本机 n9.0.1 实测：仅支持**已标记** HDR10(PQ)/HLG 源（未标记源用 zscale min/tin
    # 强转会触发 zimg "no path between colorspaces"，本构建 setparams 也无颜色选项）；
    # SDR 标记源过链无副作用（线性往返）。输出恒为 bt709/tv 标记（链内 zscale 完成，
    # 与「输出颜色标记」互补：链内打的是帧标记，容器标记仍由 append_video_output_extras 落）。
    # 末尾 format 用像素格式设置值（yuv420p 默认；alpha 遮罩场景由后续 format=rgba 覆盖）。
    if enhance_settings and enhance_settings.get("tonemap_enabled", False):
        _alg = str(enhance_settings.get("tonemap_mode", "hable") or "hable")
        if _alg not in ("hable", "mobius", "reinhard"):
            _alg = "hable"
        filters.append("zscale=t=linear:npl=100")
        filters.append("format=gbrpf32le")
        filters.append("zscale=p=bt709")
        filters.append(f"tonemap=tonemap={_alg}:desat=0")
        filters.append("zscale=tin=linear:t=bt709:m=bt709:p=bt709:r=tv")
        _tm_pix = "yuv420p"
        if include_format and settings.get("pix_fmt_enabled", True) \
                and not settings.get("mask_enabled", False):
            _tm_pix = str(settings.get("pix_fmt", "yuv420p") or "yuv420p")
        filters.append(f"format={_tm_pix}")

    # ----- 色彩空间转换 -----
    if enhance_settings and enhance_settings.get("colorspace_enabled", False):
        matrix = enhance_settings.get("colorspace_matrix", "bt709:bt2020")
        filters.append(f"colormatrix={matrix}")

    # ----- 颜色校正（eq）-----
    if enhance_settings:
        eq_parts = []
        b = enhance_settings.get("eq_brightness", 0.0)
        if b != 0.0:
            eq_parts.append(f"brightness={b:.2f}")
        c = enhance_settings.get("eq_contrast", 1.0)
        if c != 1.0:
            eq_parts.append(f"contrast={c:.2f}")
        s = enhance_settings.get("eq_saturation", 1.0)
        if s != 1.0:
            eq_parts.append(f"saturation={s:.2f}")
        g = enhance_settings.get("eq_gamma", 1.0)
        if g != 1.0:
            eq_parts.append(f"gamma={g:.2f}")
        if eq_parts:
            filters.append(f"eq={':'.join(eq_parts)}")

    # ----- 色相调整（hue）-----
    # ⚠️ ffmpeg hue 滤镜大小写是两种单位，别写反（2026-10-03 实测，纯红单帧验证）：
    #     小写 h = **度**：hue=h=180 → 青绿（补色）✅ 我们要的
    #     大写 H = **弧度**：hue=H=3.14159 → 青绿；hue=H=6.28319 → 红（转满一圈回原点）
    #   旧代码用大写 H 却喂「度」的滑块值（-180~180）→ 180 弧度≈10313°，整条滑块跑了
    #   约 57 圈色相环（用户反馈「紫色出现两次、感觉循环了」），故必须改回小写 h。
    #   s 的基准是 **1.0**（s=0=全去色、s=-1=色相翻转），UI 滑块是「增减量」(-1~1，0=原样)，
    #   因此要写 1+delta —— 旧代码直接把滑块值当 s 传，导致 0→跳过(原样)、1→也是原样，
    #   非空单调（中段反而变灰），同属 bug。
    if enhance_settings:
        hue_parts = []
        h_angle = enhance_settings.get("hue_angle", 0.0)
        if h_angle != 0.0:
            hue_parts.append(f"h={h_angle:.1f}")          # 度（小写 h）
        h_sat = enhance_settings.get("hue_saturation", 0.0)
        if h_sat != 0.0:
            hue_parts.append(f"s={max(0.0, 1.0 + h_sat):.2f}")  # 基准 1.0 + 增量，下限 0（全灰）
        if hue_parts:
            filters.append(f"hue={':'.join(hue_parts)}")

    # ----- 反色（negate）-----
    # 放在颜色校正/色相之后、像素格式之前（靠后）。绿幕 chromakey 无论默认位置（缩放后）
    # 还是前置模式（链首）都先于 negate，negate 天然在抠图之后生效，不影响抠像——
    # 子视频调用点不再需要 include_negate=False + 外部补丁。
    if include_negate and enhance_settings and enhance_settings.get("negate_enabled", False):
        filters.append("negate")

    # ----- 增强滤镜统一时间段（2026-09-30）-----
    # 本块（deblock→negate）位于 speed(setpts=1/factor*PTS) 之前：滤镜入口 t = 输出t × speed_factor
    # （出口 t = 入口t/factor）。用户填的是输出时间线秒数，故 _build_enh_seg_enable 已把窗口常数
    # 乘 speed_factor 换算回入口时间；trim 已在入口 t 起点归零（与输出时间线同起点），无需再减。
    # 对整段增强滤镜（含 tonemap 6 段与内部 format）统一挂同一 enable —— 各滤镜均支持 T(timeline)，
    # 窗口外帧原样透传，不破坏下游格式/坐标（与 fade/字幕同套机制，方向相反）。
    # 2026-10-03：表达式算到外层变量上 —— 风格预设(look) 不在这个切片里（它在切片之后才追加），
    # 但要挂**同一份**时间口径，故留给 _look_with_enable 单独包裹。
    _enh_en = ""
    if enhance_settings and enhance_settings.get("enh_seg_enabled", False):
        _enh_sp = _opt_float(settings.get("speed_factor", "1.0") or "1.0", 1.0)
        if _enh_sp <= 0:
            _enh_sp = 1.0
        _enh_en = _build_enh_seg_enable(enhance_settings, _enh_sp)
    if _enh_en:
        _enh_slice = filters[enh_start_idx:]
        filters[enh_start_idx:] = [f + _region_enable_suffix(_enh_en, f) for f in _enh_slice]

    # ----- 风格预设（look）-----
    # 纯内置滤镜链、无外部 LUT；强度 i<=0 时跳过（退化为恒等）。
    # 2026-10-03 起接入 enh_seg 时间段：链内每个子滤镜挂同一表达式，窗口外帧原样透传，
    # 行为与其余增强滤镜完全一致。
    # ⚠️ 旧注释称「sepia/duotone/green_fade/thermal 都含 format=gbrp，故独立于 enh_seg」
    #   是错的 —— 实测 STYLE_PRESETS 里**只有 thermal** 带 format=，当年把 4 个预设一起
    #   挡在门外纯属误伤。真正不支持 timeline 的也只有 format 这一个滤镜 → 见 _look_with_enable。
    if enhance_settings:
        _sp = enhance_settings.get("style_preset", "") or ""
        try:
            _raw = enhance_settings.get("style_intensity", 1.0)
            _si = float(_raw) if _raw not in (None, "") else 1.0
        except (TypeError, ValueError):
            _si = 1.0
        if _sp and _si > 0:
            _entry = STYLE_PRESETS.get(_sp)
            if _entry:
                _chain = _scale_look_chain(_entry[1], _si)
                if _chain:
                    filters.append(_look_with_enable(_chain, _enh_en))

    # ----- 遮罩 / 透明蒙版（最终渲染帧空间，WYSIWYG）-----
    # 2026-09-10 两迁记录：裁剪前（原始帧）→ 缩放之后 → 链尾（本位置，抠图兼容见下）。
    # 遮罩始终落在 crop/rotate/scale 之后的最终渲染帧上，与画布/显示/转换三同一坐标系；
    # 编辑器拖出的坐标直接可用，零换算（中间滤镜均不改尺寸，链尾坐标系不变）。
    # ⚠️ 锁色：matte 分支用 format=gray，ffmpeg 自动格式协商会把 scale 输出从 yuv420p 降级为
    #   gray → 主输入在 alphamerge 前丢失色彩（整帧发灰）。故在 split 之前插 format=rgba 锁死主
    #   输入像素格式；matte 的 gray 仅限 [m] 分支局部使用，互不影响（fix: tests/_repro_mask_gray2）。
    # 2026-09-10 抠图兼容（与绿幕 chromakey/colorkey 同开）：整段移到「negate 之后、像素
    # 格式之前」的链尾——绿幕无论默认位置（缩放后）还是前置模式（delogo 同开时链首）都
    # 已在前；下方 3 处 alphamerge 前加 alpha 相乘（alphaextract+blend=multiply），拿到的
    # 既有 alpha 即抠图结果 → 最终 alpha = 抠图 × 遮罩 matte（交集）。无抠图时 format=rgba
    # 补 alpha=255，乘法=matte 本身，与旧「替换」语义逐帧等效——一条链兼容全部组合，
    # 消除「谁后到谁通吃」（旧链序绿幕默认位置遮罩失效 / 前置位置抠图失效）。
    # delogo/区域效果只改像素不改 alpha（见 3218 行实测背书注释），与 matte 相乘零冲突。
    # ----- 遮罩 / 透明蒙版（最终渲染帧空间，WYSIWYG）-----
    # 2026-09-10 两迁记录：裁剪前（原始帧）→ 缩放之后 → 链尾（本位置，抠图兼容见下）。
    # 遮罩始终落在 crop/rotate/scale 之后的最终渲染帧上，与显示/转换同一坐标系；
    # 编辑器拖出的坐标直接可用，零换算（中间滤镜均不改尺寸，链尾坐标系不变）。
    # ⚠️ 锁色：matte 分支用 format=gray，ffmpeg 自动格式协商会把 scale 输出从 yuv420p 降级为
    #   gray → 主输入在 alphamerge 前丢失色彩（整帧发灰）。故在 split 之前插 format=rgba 锁死主
    #   输入像素格式；matte 的 gray 仅限 [m] 分支局部使用，互不影响（fix: tests/_repro_mask_gray2）。
    # ⚠️ 2026-09-12 画布模式（方案 A）：画布模式下遮罩**不在这里**生成 —— 画布把 crop/rotate/scale
    #   全交给画布段，此处若照旧作用在「画布前的内容帧」会与遮罩坐标（按最终渲染帧）错位，
    #   表现为「一开画布模式遮罩就失效」。改由 build_canvas_filtergraph 在画布段产出之后追加，
    #   判据共用 _canvas_defers_mask（两处必须一致，否则双重遮罩 / 遮罩丢失）。
    # ----- 外轮廓描边（2026-10-02 新增）-----
    # ⚠️ 顺序钉死：描边必须在遮罩**之前**。描边沿"当前可见轮廓"走，遮罩是"挖掉一块"，
    #   挖出来的洞口不该长描边；若反序（先遮罩后描边），遮罩的矩形洞口会被描上一圈边。
    # ⚠️ 画布模式下描边**不延后**（与遮罩不同）：遮罩延后是因为它的坐标基准是最终渲染帧；
    #   描边只看 alpha 形状、不消费任何坐标，画布怎么挪都不影响它的形状语义。
    #   副作用：画布模式会把描边连同内容一起缩放（宽度按比例变），已写进入口 tooltip。
    if settings.get("outline_enabled", False):
        _oseg = _build_outline_filter_block(settings, graph_id)
        if _oseg:
            filters.append(_oseg)

    # 段内容（多形状 → 单形状 PNG → 轨迹挡板 → 静态矩形）见 _build_mask_filter_block。
    if include_mask and settings.get("mask_enabled", False) \
            and not _canvas_defers_mask(settings):
        _mseg = _build_mask_filter_block(
            settings, graph_id, None, None, motion_trim_start, motion_speed_factor)
        if _mseg:
            filters.append(_mseg)


    # ----- 像素格式 -----
    if include_format and settings.get("pix_fmt_enabled", True):
        # 硬件滤镜模式下，纯硬件/混合链路在边界统一处理像素格式，不在中间插入软件 format
        if not _hw_active or not _native:
            # 遮罩启用时，本滤镜链已写入 alpha，必须用 rgba 保留透明通道
            # （否则默认的 yuv420p 会把刚生成的透明区丢掉）
            # ⚠️ 画布模式下遮罩已延后（_canvas_defers_mask）→ 本链不写 alpha，走普通像素格式。
            # 2026-10-02：描边同样写 alpha（且画布模式下不延后）→ 一并进 rgba 判据。
            if (settings.get("mask_enabled", False) and not _canvas_defers_mask(settings)) \
                    or settings.get("outline_enabled", False):
                filters.append("format=rgba")
            else:
                filters.append(f"format={settings.get('pix_fmt', 'yuv420p')}")
    
    # ----- 变速 -----
    if include_speed and settings.get("speed_enabled", False):
        try:
            factor = float(settings.get("speed_factor", "1.0"))
            if factor > 0 and factor != 1.0:
                filters.append(f"setpts={1.0/factor}*PTS")
        except ValueError:
            pass
    
    # ----- 字幕烧录（2026-08-27：支持 charenc 字符编码，解决 GBK/GB18030 中文 SRT 乱码） -----
    if include_subtitle and settings.get("subtitle_enabled", False):
        sub_path = settings.get("subtitle_path", "").strip()
        if sub_path:
            sub_path = sub_path.replace('\\', '/')
            sub_path = sub_path.replace(':', '\\:')
            sub_path = sub_path.replace("'", "\\'")
            _ch = str(settings.get("subtitle_charset", "auto") or "auto").strip().lower()
            if _ch and _ch != "auto":
                filters.append(f"subtitles='{sub_path}':charenc={_ch}")
            else:
                filters.append(f"subtitles='{sub_path}'")

    # ----- 倒放 -----
    if reverse:
        filters.append("reverse")

    # ----- 淡入淡出（片段首尾淡入黑 / 淡出黑，视频） -----
    if include_fade and settings.get("fade_enabled", False):
        fin = settings.get("fade_in", "")
        fout = settings.get("fade_out", "")
        fin_s = time_to_seconds(fin) if fin else 0.0
        fout_s = time_to_seconds(fout) if fout else 0.0
        if fin_s > 0:
            filters.append(f"fade=t=in:st=0:d={fin_s:.3f}")
        if fout_s > 0:
            if clip_duration and clip_duration > 0:
                # 淡出起点按输出时长定位（fade 在变速 setpts 之后，t=输出时间线）。
                # clip_duration 语义=源全时长；本链自身的 截取/变速 会缩短输出，
                # 2026-09-13 前直接用 clip_duration → 截取后淡出点落在输出之外（淡出丢失）。
                _od = clip_duration
                if include_trim and settings.get("precise_trim", False) and settings.get("trim_enabled", False):
                    _fs_raw = settings.get("trim_start", "").strip()
                    _fe_raw = settings.get("trim_end", "").strip()
                    _fs = time_to_seconds(_fs_raw) if _fs_raw else 0.0
                    _fe = time_to_seconds(_fe_raw) if _fe_raw else None
                    if _fe is not None and _fe > _fs:
                        _od = _fe - _fs
                    else:
                        _od = max(0.0, _od - _fs)
                if settings.get("speed_enabled", False):
                    try:
                        _fsp = float(settings.get("speed_factor", "1.0") or "1.0")
                        if _fsp > 0 and _fsp != 1.0:
                            _od = _od / _fsp
                    except ValueError:
                        pass
                st = max(0.0, _od - fout_s)
                filters.append(f"fade=t=out:st={st:.3f}:d={fout_s:.3f}")
            # 未知时长时无法精确定位淡出起点，跳过淡出（淡入仍生效）

    filter_chain = ",".join(filters) if filters else "null"
    
    # ---------- 滤镜硬件加速（软件 / NVIDIA / Intel QSV / AMD） ----------
    filter_mode = settings.get("hw_filter_mode")
    if not filter_mode:
        # 向后兼容：旧版用 wrap_cpu_nvidia / wrap_cpu_amd 标记
        if settings.get("wrap_cpu_nvidia"):
            filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            filter_mode = "vaapi"
        else:
            filter_mode = "cpu"

    if filter_mode in ("cuda", "qsv", "vaapi"):
        device = (settings.get("hw_filter_device") or "").strip()
        # 1) 尝试把软件滤镜替换为对应硬件滤镜
        hw_filters = []
        has_software_only = False
        for f in filters:
            hf = _map_software_to_hw_filter(f, filter_mode)
            if hf is None:
                has_software_only = True
                hw_filters.append(f)
            else:
                hw_filters.append(hf)
        # 合并相邻的 vpp_qsv 滤镜为单个 VPP 实例：更高效，且确保 denoise 与 procamp 等
        # 处于同一会话（分散到多个 vpp_qsv 实例虽不报错，但 procamp 开关易失效）。
        merged = []
        for f in hw_filters:
            if merged and merged[-1].startswith("vpp_qsv=") and f.startswith("vpp_qsv="):
                merged[-1] = merged[-1] + ":" + f[len("vpp_qsv="):]
            else:
                merged.append(f)
        hw_filters = merged
        # 2) 帧是否已在显存（需开启硬件解码且解码器与该 API 匹配）
        decoder = settings.get("hwaccel_decoder", "")
        native = settings.get("hwaccel_enabled", False) and _decoder_matches_api(decoder, filter_mode)
        enc_gpu = _is_gpu_encoder(settings.get("encoder", ""))
        if native and not has_software_only and hw_filters:
            # 纯硬件链路：数据全程在显存，无需 hwdownload / hwupload
            chain = ",".join(hw_filters)
            if not enc_gpu:
                pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", True) else "nv12"
                chain = f"{chain},hwdownload,format={pix}"
            return chain
        if not native:
            # 没有硬件解码 -> 帧在内存，无法 hwdownload，退回纯软件滤镜链
            return filter_chain
        # 3) 混合链路：软件滤镜用 hwdownload 拉回内存处理，再 hwupload 回显存
        sw_chain = ",".join(filters)
        if not sw_chain or sw_chain == "null":
            # 没有软件滤镜时不生成空白包裹（hwdownload,format=nv12,,hwupload=...）
            return "null"
        up = _hwupload_token(filter_mode, device)
        if enc_gpu:
            return f"hwdownload,format=nv12,{sw_chain},{up}"
        # CPU 编码器：处理完直接留在内存，并显式指定输出像素格式
        pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", True) else "nv12"
        return f"hwdownload,format=nv12,{sw_chain},format={pix}"

    return filter_chain


def _map_software_to_hw_filter(f: str, api: str):
    """把单个软件滤镜字符串映射为硬件滤镜；无解返回 None（表示仍需软件处理）。"""
    if f.startswith("scale="):
        suffix = {"cuda": "scale_cuda", "qsv": "scale_qsv", "vaapi": "scale_vaapi"}.get(api)
        if not suffix:
            return None
        body = f[len("scale="):]
        # 硬件缩放滤镜不支持 -2（软件 scale 的「强制偶数」语法），统一换成 -1。
        # -1 = 按宽高比自动计算另一维；因旋转在缩放之前执行，此时帧已是旋转后尺寸，
        # 所以 -1 自动按当前 iw/ih 计算，天然兼容旋转（无需手动算 540/1706）。
        body = body.replace("-2", "-1")
        # 转成 w=/h= 形式以兼容硬件滤镜（如 scale_cuda=w=1280:h=720）
        if "=" not in body:
            w, h = body.split(":")
            return f"{suffix}=w={w}:h={h}"
        return f"{suffix}={body}"
    if api == "qsv":
        # 旋转/翻转：vpp_qsv 的 transpose 用字符串枚举，不是软件滤镜的数字
        # 软件 transpose=1=90°顺时针 → vpp_qsv transpose=clock
        # 软件 transpose=2=90°逆时针 → vpp_qsv transpose=cclock
        # 软件 180°(transpose=2,transpose=2) → vpp_qsv transpose=reversal
        if f == "transpose=1":
            return "vpp_qsv=transpose=clock"
        if f == "transpose=2":
            return "vpp_qsv=transpose=cclock"
        if f == "transpose=2,transpose=2":
            return "vpp_qsv=transpose=reversal"
        # 翻转（用户实测 qsv 有翻转滤镜，无需走软件包裹）
        if f == "vflip":
            return "vpp_qsv=transpose=vflip"
        if f == "hflip":
            return "vpp_qsv=transpose=hflip"
        if f.startswith("crop="):
            crop_body = f[len("crop="):]
            # 含单引号 = 动态表达式（按时间 t 插值），vpp_qsv 的 cx/cy 不支持 t，
            # 必须走软件 crop（返回 None 让混合链路 hwdownload→crop→hwupload）。
            if "'" in crop_body:
                return None
            # crop=w:h:left:top -> vpp_qsv=cw=w:ch=h:cx=left:cy=top
            parts = crop_body.split(":")
            if len(parts) == 4:
                w, h, x, y = parts
                return f"vpp_qsv=cw={w}:ch={h}:cx={x}:cy={y}"
        if f.startswith("yadif") or f.startswith("bwdif"):
            # 反交错 → vpp_qsv deinterlace（1=Bob, 2=advanced；这里用 1）
            return "vpp_qsv=deinterlace=1"
        if f.startswith("hqdn3d"):
            # 降噪 → vpp_qsv denoise（取空间亮度等级，0..100）
            try:
                lvl = float(f[len("hqdn3d="):].split(":")[0])
            except ValueError:
                lvl = 0.0
            if lvl <= 0:
                return None
            return f"vpp_qsv=denoise={lvl:.0f}"
        if f.startswith("eq="):
            # 颜色校正 → vpp_qsv procamp（无 gamma；brightness 范围 -1..1 需换算成 -100..100）
            pp = []
            for kv in f[len("eq="):].split(":"):
                if "=" not in kv:
                    continue
                k, v = kv.split("=", 1)
                if k == "brightness":
                    try:
                        pp.append(f"brightness={float(v) * 100:.0f}")
                    except ValueError:
                        pass
                elif k in ("contrast", "saturation"):
                    pp.append(f"{k}={v}")
                # gamma 在 vpp_qsv 无对应项，丢弃
            if pp:
                # 关键：vpp_qsv 的亮度/对比度/饱和度都属于 ProcAmp，总开关 procamp 默认 0（关闭），
                # 不显式写 procamp=1 则这些参数被静默忽略（表现为「不报错但无变化」）。
                return "vpp_qsv=procamp=1:" + ":".join(pp)
            return None
    return None


def _decoder_matches_api(decoder: str, api: str) -> bool:
    """判断硬件解码器是否与目标滤镜 API 匹配（帧能否直接在对应显存中）。"""
    decoder = (decoder or "").lower()
    if api == "cuda":
        return ("cuda" in decoder) or ("cuvid" in decoder)
    if api == "qsv":
        return "qsv" in decoder
    if api == "vaapi":
        return ("vaapi" in decoder) or ("amf" in decoder)
    return False


def _is_gpu_encoder(encoder: str) -> bool:
    """判断编码器是否为硬件编码器（输出帧需在显存）。"""
    if not encoder:
        return False
    if encoder in ("nvenc", "qsv", "amf", "vaapi", "videotoolbox"):
        return True
    suffixes = ("_nvenc", "_qsv", "_amf", "_vaapi", "_videotoolbox",
                "_mediacodec", "_omx", "_mfx")
    return any(encoder.endswith(s) for s in suffixes)


def _hwupload_token(api: str, device: str) -> str:
    """返回软件->硬件的上传滤镜；device 非空时显式绑定显卡设备。"""
    if api == "cuda":
        return f"hwupload_cuda=device=cu" if device else "hwupload_cuda"
    if api == "qsv":
        # QSV 上传：derive_device=qsv 显式派生 QSV 设备（等价于用户实测可用的 hwupload=qsv）。
        # extra_hw_frames=64 不能放在这里，必须放在 -init_hw_device qsv=hw,extra_hw_frames=64 中。
        return "hwupload=derive_device=qsv"
    if api == "vaapi":
        return "hwupload=extra_hw_frames=64"
    return "hwupload"

def build_preview_filter_chain(settings: Dict[str, Any], target_height: int = 960, reverse: bool = False) -> str:
    """生成预览用的滤镜链，强制缩放到指定高度"""
    enhance_settings = settings.get("enhance", {})
    preview_settings = dict(settings)
    preview_settings["hw_filter_mode"] = "cpu"  # 预览/外部播放器强制软件滤镜，避免硬件滤镜冲突
    vf = build_video_filter_chain(
        preview_settings,
        include_subtitle=True,
        include_speed=True,
        enhance_settings=enhance_settings,
        reverse=reverse
    )
    # 追加文字水印 drawtext（多条非旋转项逗号串联；旋转项需 filter_complex，-vf 预览跳过）
    _ts0, _sp0 = _trim_speed_from_settings(settings)
    dt = build_drawtext_chain_vf(settings.get("text_watermark", {}),
                                 settings.get("text_watermark_items"),
                                 trim_start=_ts0, speed_factor=_sp0)
    if dt:
        vf = f"{vf},{dt}" if vf != "null" else dt
    if vf != "null":
        return f"{vf},scale=-2:{target_height}"
    else:
        return f"scale=-2:{target_height}"

def build_atempo_chain(factor: float) -> str:
    """构建音频变速滤镜链，支持大于2倍或小于0.5倍的场景"""
    if factor <= 0 or factor == 1.0:
        return ""
    chain = []
    r = factor
    while r > 2.0:
        chain.append(2.0)
        r /= 2.0
    while r < 0.5:
        chain.append(0.5)
        r /= 0.5
    if abs(r - 1.0) > 1e-6:
        chain.append(r)
    if not chain:
        return ""
    atempo_filters = [f"atempo={v:.10f}".rstrip('0').rstrip('.') for v in chain]
    return ",".join(atempo_filters)

