                # master=root 不恢复（root 拿 grab 会禁用全部 Toplevel）。
                if self.master:
                    try:
                        if isinstance(self.master, tk.Toplevel) and self.master.winfo_exists():
                            self.master.grab_set()
                        else:
                            self.master.grab_release()
                    except Exception:
