    def _is_region_blur(self) -> bool:
        """当前是否处于「局部模糊」状态（仅 boxblur/gblur 有意义）"""
        return bool(self.region_var.get()) and self.type_var.get() in ("boxblur", "gblur")

    def update_strength_state(self):
        """仅更新标签文字与可编辑状态，不改动用户已填的数值。"""
        ftype = self.type_var.get()
        if ftype == "delogo":
            self.strength_label.config(text="参数:")
            self.strength_entry.config(state="disabled")
        elif ftype == "boxblur":
            self.strength_label.config(text="半径:")
            self.strength_entry.config(state="normal")
        elif ftype == "gblur":
            self.strength_label.config(text="sigma:")
            self.strength_entry.config(state="normal")
    
    def update_coord_state(self):
        # delogo 需要坐标；boxblur/gblur 只有开启局部模糊时才需要坐标
        need_coord = (self.type_var.get() == "delogo") or self._is_region_blur()
        state = "normal" if need_coord else "disabled"
        for entry in getattr(self, "_coord_entries", []):
            entry.config(state=state)
        # delogo 本身就是区域滤镜，局部模糊开关对它无意义
        if hasattr(self, "region_chk"):
            self.region_chk.config(state="disabled" if self.type_var.get() == "delogo" else "normal")
    
    def on_type_change(self, event=None):
        ftype = self.type_var.get()
        if ftype == "delogo":
            # delogo 不需要强度参数，清空；也不适用局部模糊开关
            self.strength_var.set("")
            self.region_var.set(False)
        elif ftype in ("boxblur", "gblur"):
            # 切换类型时始终填入该类型的默认值，保证下拉选项与强度值联动
            default_map = {"boxblur": "5", "gblur": "2.0"}
            self.strength_var.set(default_map.get(ftype, "5"))
        self.update_strength_state()
        self.update_coord_state()

    def on_region_toggle(self):
        self.update_coord_state()

    def quick_region_blur(self):
        """一键切换到「局部模糊」：启用 + boxblur + 区域模式 + 自动补坐标"""
        self.enabled_var.set(True)
        if self.type_var.get() == "delogo":
            self.type_var.set("boxblur")
            self.strength_var.set("5")
        self.region_var.set(True)
        # 坐标缺失时尝试从「裁剪」设置带入
        if not (self.w_var.get().strip() and self.h_var.get().strip()):
            self.copy_from_crop(silent=True)
        if not self.strength_var.get().strip():
            self.strength_var.set("5" if self.type_var.get() == "boxblur" else "2.0")
        self.update_strength_state()
        self.update_coord_state()
        if getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                "已切换为局部模糊：应用后 -vf 将自动生成 split→crop→模糊→overlay 滤镜图，"
                "并排在裁剪/旋转/缩放/亮度等滤镜之前（坐标以原始画面为准）")
    
    def _resolve_crop_coord(self, expr):
        """把裁剪坐标表达式（可能含 iw/ih，如 iw/2、ih-100）按输入文件原始尺寸换算成数字。

        delogo 滤镜不支持表达式（x/y/w/h 只认像素数字），而裁剪参数常填 iw/2 等相对式，
        复制到 delogo 前必须求值。纯数字直接返回；取不到尺寸或求值失败则保留原样（与旧行为一致）。"""
        expr = expr.strip()
        if not expr:
            return expr
        if expr.lstrip("-").isdigit():
            return expr
        app = getattr(self.filter_frame, "app", None)
        file_path = ""
        if app is not None:
            inp = getattr(app, "input_file", None)
            if inp is not None:
                file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
            if not file_path:
                file_path = getattr(self.filter_frame, "current_file", "") or ""
        if file_path and os.path.exists(file_path) and app is not None:
            try:
                ow, oh = app._get_video_dimensions_cached(file_path)
            except Exception:
                ow = oh = None
            if ow and oh:
                # iw/ih 按原始尺寸求值（不再在此减 2：delogo 的边界安全化由
                # _delogo_safe 统一处理——仅减宽高不解决 x=0/y=0 贴边失败）
                if expr == "iw":
                    return str(ow)
                if expr == "ih":
                    return str(oh)
                val = safe_eval_expr(expr, {"iw": ow, "ih": oh})
                if val is not None:
                    return str(val)
        return expr

    def _delogo_safe(self, x, y, w, h, ow, oh):
        """delogo 区域必须四周留 ≥1 像素边界，否则滤镜失败（实测 ffmpeg 8.1：
        x/y=0 贴边、x+w≥iw、y+h≥ih 均报 Error reinitializing filters）。
        对复制/框选来的坐标统一缩进到安全范围。返回 (x,y,w,h)。"""
        if x < 1:
            w -= (1 - x)
            x = 1
        if y < 1:
            h -= (1 - y)
            y = 1
        if w > ow - x - 1:
            w = ow - x - 1
        if h > oh - y - 1:
            h = oh - y - 1
        return x, y, w, h

    def copy_from_crop(self, silent: bool = False):
        crop_w = self.filter_frame.crop_width.get().strip()
        crop_h = self.filter_frame.crop_height.get().strip()
        crop_x = self.filter_frame.crop_left.get().strip()
        crop_y = self.filter_frame.crop_top.get().strip()
        if not crop_w or not crop_h:
            if not silent:
                messagebox.showwarning("提示", "裁剪未启用或参数为空，请先在「视频滤镜」中启用裁剪并设置区域。")
            return
        # delogo 不支持表达式：iw/ih 按输入文件原始尺寸换算成数字后填入
        # delogo 的 x/y/w/h 不允许为 0（w/h=0 滤镜无效），凡解析为 0 一律改为 1
        def _nonzero(v):
            try:
                if int(v) == 0:
                    return "1"
            except (ValueError, TypeError):
                pass
            return v
        x = self._resolve_crop_coord(crop_x)
        y = self._resolve_crop_coord(crop_y)
        w = self._resolve_crop_coord(crop_w)
        h = self._resolve_crop_coord(crop_h)
        # delogo 区域必须四周留 ≥1px 边界（x/y=0 贴边或右/下越界 → 滤镜失败）。
        # 框选整画面 (0,0,720,405) 会被缩进为 (1,1,718,403)；数字与 iw/ih 表达式统一处理。
        if self.type_var.get() == "delogo":
            app = getattr(self.filter_frame, "app", None)
            file_path = ""
            if app is not None:
                inp = getattr(app, "input_file", None)
                if inp is not None:
                    file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
                if not file_path:
                    file_path = getattr(self.filter_frame, "current_file", "") or ""
            if file_path and os.path.exists(file_path) and app is not None:
                try:
                    ow, oh = app._get_video_dimensions_cached(file_path)
                except Exception:
                    ow = oh = None
                if ow and oh:
                    try:
                        xi, yi, wi, hi = int(x), int(y), int(w), int(h)
                    except (ValueError, TypeError):
                        pass  # 含无法求值的表达式 → 保持原样
                    else:
                        xi, yi, wi, hi = self._delogo_safe(xi, yi, wi, hi, ow, oh)
                        x, y, w, h = str(xi), str(yi), str(wi), str(hi)
        self.x_var.set(_nonzero(x))
        self.y_var.set(_nonzero(y))
        self.w_var.set(_nonzero(w))
        self.h_var.set(_nonzero(h))
        if not self.enabled_var.get():
            self.enabled_var.set(True)
        # 已开启局部模糊时保持当前模糊类型，不再强制切回 delogo
        switched = False
        if self.type_var.get() != "delogo" and not self.region_var.get():
            self.type_var.set("delogo")
            self.on_type_change()
            switched = True
        else:
            self.update_coord_state()
        if not silent and getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                "已从裁剪复制坐标，并自动切换到 delogo 模式" if switched else "已从裁剪复制坐标")
    
    # ---------- 多区域列表 ----------
    def _refresh_blur_tree(self):
        sel = None
        if self.tree.selection():
            sel = self.tree.selection()[0]
        self.tree.delete(*self.tree.get_children())
        for i, it in enumerate(self.items):
            _en = "☑" if it.get("enabled", True) else "☐"
            _t = it.get("type", "delogo")
            _sum = f"({it.get('x','0')},{it.get('y','0')}) {it.get('w','100')}x{it.get('h','100')}"
            _s = it.get("strength", "")
            if _s and _t != "delogo":
                _sum += f" r={_s}"
            self.tree.insert("", "end", iid=str(i), values=(_en, _t, _sum))
        if sel is not None and self.tree.exists(sel):
            self.tree.selection_set(sel)

    def _sync_current_to_tree(self, *args):
        """表单变量 trace 回调：把当前选中项表单值写回列表并刷新（实时联动）。

        2026-08-26 修复「新加 delogo 填完坐标列表数值不变」：坐标/类型/强度/
        启用任一变化即时更新当前项的列表行。加载表单期间由 _loading_form 守卫
        跳过（避免 set() → trace → 刷新 → selection 事件 → set() 死循环）。"""
        if getattr(self, "_loading_form", False):
            return
        idx = self._current_item_idx()
        if idx is None or not (0 <= idx < len(self.items)):
            return
        self._collect_form_to_item(idx)
        # ⚠️ 不再额外 selection_set：_refresh_blur_tree 已把选中行还原，
        # 再设一次只是多派发一轮 <<TreeviewSelect>>（白白多一次表单回读）。
        self._refresh_blur_tree()

    def _current_item_idx(self):
        s = self.tree.selection()
        if not s:
            return None
        try:
            return int(s[0])
        except (ValueError, TypeError):
            return None

    def _load_item_to_form(self, idx):
        """把第 idx 项读进表单。

        ⚠️ 2026-09-02 修复「半径 / sigma 输入框打字错乱」（回灌统一尝试版）：
        这里**绝不能**调 on_type_change()——那个方法会把 strength_var 无条件重置成
        类型默认值（boxblur→5、gblur→2.0）。用户敲一个键就会走
        「trace → _sync_current_to_tree → 刷列表 → selection_set → 选中事件
          → 本函数 → on_type_change → set(默认值)」，
        于是框里的值被冲回 5 / 2.0、光标跑到末尾，下一个字符追加到后面 →
        列表出现 51、2.01 这类怪值。加载表单只该同步**控件状态**，不该改数据。
        """
        # 加载期间置守卫，避免 var.set() → trace(_sync_current_to_tree) → 刷新 → 死循环
        self._loading_form = True
        try:
            it = self.items[idx]
            # ⚠️ enabled_var 是「启用去水印/模糊」总开关，单项启用由列表「启用」列点击管理——
            # 加载项时绝不覆盖总开关，否则点过启用列的项会被表单值覆盖回 True。
            # ⚠️ 一律走 _tk_setv：值没变就不写，避免把用户正在敲的框冲掉、光标跳到末尾。
            _tk_setv(self.type_var, it.get("type", "delogo"))
            _tk_setv(self.strength_var, it.get("strength", ""))
            _tk_setv(self.x_var, it.get("x", "0"))
            _tk_setv(self.y_var, it.get("y", "0"))
            _tk_setv(self.w_var, it.get("w", "100"))
            _tk_setv(self.h_var, it.get("h", "100"))
            _tk_setv(self.region_var, it.get("region_only", False))
            _tk_setv(self.enable_start_var, it.get("enable_start", ""))
            _tk_setv(self.enable_end_var, it.get("enable_end", ""))
            _tk_setv(self.enable_cycle_var, it.get("enable_cycle", ""))
            _tk_setv(self.enable_show_var, it.get("enable_show", ""))
            # 不再调 on_type_change()：它只负责「类型下拉变动」时的联动，加载表单不该改数据
            self.update_strength_state()
            self.update_coord_state()
        finally:
            self._loading_form = False

    def _collect_form_to_item(self, idx):
        it = self.items[idx]
        # enabled 不收集：单项启用只由列表「启用」列点击切换（_on_tree_click），
        # 表单保存（apply）不得用总开关覆盖它——这正是「取消启用后保存又恢复」的根因。
        it["type"] = self.type_var.get()
        it["strength"] = self.strength_var.get()
        it["x"] = self.x_var.get()
        it["y"] = self.y_var.get()
        it["w"] = self.w_var.get()
        it["h"] = self.h_var.get()
        it["region_only"] = self.region_var.get()
        # 显示时段 / 循环（起始/结束/周期/单次）
        it["enable_start"] = self.enable_start_var.get().strip()
        it["enable_end"] = self.enable_end_var.get().strip()
        it["enable_cycle"] = self.enable_cycle_var.get().strip()
        it["enable_show"] = self.enable_show_var.get().strip()

    def _on_tree_select(self, ev):
        idx = self._current_item_idx()
        if idx is None:
            return
        # ⚠️ 回环保卫：_refresh_blur_tree 重建行后会把选中行重新设回去，于是再派发一次
        # 本事件。若选中的还是同一行，说明这只是「刷新回声」——表单本来就是这行的数据，
        # 再回读一次会把用户正在敲的字符冲掉（radius 敲 1→1、再敲 1→51 的元凶之一）。
        if idx == self._last_sel:
            return
        # 先写回上一个选中项的表单值，再加载新选中项
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        self._load_item_to_form(idx)
        self._last_sel = idx

    def _on_tree_click(self, ev):
        try:
            if self.tree.identify_column(ev.x) == "#1":
                iid = self.tree.identify_row(ev.y)
                if iid:
                    idx = int(iid)
                    self.items[idx]["enabled"] = not self.items[idx].get("enabled", True)
                    self._refresh_blur_tree()
                    self.tree.selection_set(iid)
        except Exception:
            pass

    def _add_blur_item(self):
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        self.items.append({"enabled": True, "type": "delogo", "x": "100", "y": "100",
                           "w": "200", "h": "100", "strength": "", "region_only": False,
                           "enable_start": "", "enable_end": "", "enable_cycle": "",
                           "enable_show": ""})
        self._refresh_blur_tree()
        self.tree.selection_set(str(len(self.items) - 1))
        self._last_sel = len(self.items) - 1
        self._load_item_to_form(self._last_sel)

    def _del_blur_item(self):
        idx = self._current_item_idx()
        if idx is None or not self.items:
            return
        del self.items[idx]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(False)
            self.type_var.set("delogo")
            self.x_var.set("0"); self.y_var.set("0")
            self.w_var.set("100"); self.h_var.set("100")
            self.strength_var.set(""); self.region_var.set(False)
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.on_type_change()
            self.update_strength_state()
            self.update_coord_state()

    def _move_blur_item(self, d):
        idx = self._current_item_idx()
        if idx is None:
            return
        if 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        ni = idx + d
        if ni < 0 or ni >= len(self.items):
            return
        self.items[idx], self.items[ni] = self.items[ni], self.items[idx]
        self._refresh_blur_tree()
        self.tree.selection_set(str(ni))
        self._last_sel = ni
        self._load_item_to_form(ni)

    def load_settings(self):
        # 多区域列表：优先 filter_frame._blur_items，无则旧键迁移
        items = list(getattr(self.filter_frame, "_blur_items", None) or [])
        if not items:
            _fe = self.filter_frame._blur_enabled.get()
            _fx = self.filter_frame._blur_x.get()
            _fw = self.filter_frame._blur_w.get()
            if _fe or _fx or _fw:
                items = [{
                    "enabled": _fe,
                    "type": self.filter_frame._blur_type.get() or "delogo",
                    "strength": self.filter_frame._blur_strength.get(),
                    "x": _fx,
                    "y": self.filter_frame._blur_y.get(),
                    "w": _fw,
                    "h": self.filter_frame._blur_h.get(),
                    "region_only": self.filter_frame._blur_region_only.get(),
                    "enable_start": "", "enable_end": "", "enable_cycle": "",
                    "enable_show": "",
                }]
        self.items = [dict(i) for i in items]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(self.filter_frame._blur_enabled.get())
            self.type_var.set(self.filter_frame._blur_type.get())
            self.x_var.set(self.filter_frame._blur_x.get())
            self.y_var.set(self.filter_frame._blur_y.get())
            self.w_var.set(self.filter_frame._blur_w.get())
            self.h_var.set(self.filter_frame._blur_h.get())
            self.strength_var.set(self.filter_frame._blur_strength.get())
            self.region_var.set(self.filter_frame._blur_region_only.get())
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.update_strength_state()
            self.update_coord_state()

    def apply(self):
        # 当前选中项表单写回列表
        idx = self._current_item_idx()
        if idx is not None and 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        # 校验所有启用项
        for it in self.items:
            if not it.get("enabled", True):
                continue
            ftype = it.get("type", "delogo")
            region = it.get("region_only", False)
            if ftype == "delogo" or region:
                label = "局部模糊" if region else "delogo"
                for nm in ("x", "y", "w", "h"):
                    if not str(it.get(nm, "")).strip():
                        messagebox.showerror("错误", f"{label} 需要完整的区域坐标，{nm.upper()} 不能为空")
                        return
            if ftype in ("boxblur", "gblur") and not str(it.get("strength", "")).strip():
                it["strength"] = {"boxblur": "5", "gblur": "2.0"}.get(ftype, "5")
        # 写回
        self.filter_frame._blur_items = [dict(i) for i in self.items]
        self.filter_frame._blur_enabled.set(self.enabled_var.get())  # 总开关
        # 兼容：旧单键同步第一项（旧版读取路径/预览仍可用）
        if self.items:
            it0 = self.items[0]
            self.filter_frame._blur_type.set(it0.get("type", "delogo"))
            self.filter_frame._blur_strength.set(it0.get("strength", ""))
            self.filter_frame._blur_x.set(it0.get("x", "0"))
            self.filter_frame._blur_y.set(it0.get("y", "0"))
            self.filter_frame._blur_w.set(it0.get("w", "100"))
            self.filter_frame._blur_h.set(it0.get("h", "100"))
            self.filter_frame._blur_region_only.set(it0.get("region_only", False))
        if self.enabled_var.get() and getattr(self.filter_frame, "app", None):
            _n = len([i for i in self.items if i.get("enabled", True)])
            if _n:
                self.filter_frame.app._append_info_ui(
                    f"[去水印/模糊] 已启用 {_n} 个区域（{'、'.join(i.get('type','') for i in self.items if i.get('enabled', True))}）")
        if hasattr(self.filter_frame, 'app') and self.filter_frame.app:
            self.filter_frame.app.update_command_preview()
        self.destroy()


# ================== 音频组件 ==================
class AudioFrame(ttk.LabelFrame):
    def __init__(self, parent, enable_checkbox=False, **kwargs):
        super().__init__(parent, text="音频", padding="5", **kwargs)
        self.enable_checkbox = enable_checkbox
        self.create_widgets()

    def create_widgets(self):
        inner = ttk.Frame(self)
        inner.pack(fill=tk.X, expand=True)
    
        top_row = ttk.Frame(inner)
        top_row.pack(fill=tk.X, pady=(0,5))

        if self.enable_checkbox:
            self.audio_enabled = tk.BooleanVar(value=True)
            chk = ttk.Checkbutton(top_row, text="保留音频", variable=self.audio_enabled)
            chk.pack(side=tk.LEFT)

        self.only_audio = tk.BooleanVar(value=False)
        self.only_audio_cb = ttk.Checkbutton(top_row, text="仅提取音频", variable=self.only_audio)
        self.only_audio_cb.pack(side=tk.LEFT, padx=(50,2))

        # "仅提取音频" ↔ "保留音频" 联动：勾选仅音频时强制保留音频，取消时恢复
        self._prev_only_audio = False
        self._saved_audio_enabled = True  # 记录勾选"仅音频"前的状态
        def _on_only_audio_changed(*args):
            curr = self.only_audio.get()
            if curr and not self._prev_only_audio:
                # 勾上"仅音频" → 保存旧状态并强制保留音频
                self._saved_audio_enabled = self.audio_enabled.get()
                self.audio_enabled.set(True)
            elif not curr and self._prev_only_audio:
                # 取消"仅音频" → 恢复原来的保留音频状态
                self.audio_enabled.set(self._saved_audio_enabled)
            self._prev_only_audio = curr
        self.only_audio.trace_add("write", _on_only_audio_changed)

        ttk.Label(top_row, text="输出容器:").pack(side=tk.LEFT, padx=(12,2))
        self.audio_format = tk.StringVar(value="m4a")
        audio_format_combo = ttk.Combobox(top_row, textvariable=self.audio_format,
                                          values=["mp3", "aac", "m4a", "flac", "opus", "wav", "ac3"],
                                          state="readonly", width=6)
        audio_format_combo.pack(side=tk.LEFT, padx=2)
        ToolTip(self.only_audio_cb, "勾选后，将只输出音频文件（自动添加 -vn 忽略视频），\n输出容器将使用右边选择的音频格式", wraplength=440, offset_x=0, offset_y=5)
    
        controls_frame = ttk.Frame(inner)
        controls_frame.pack(fill=tk.X, expand=True, pady=(5,0))
        ttk.Label(controls_frame, text="编码器:").pack(side=tk.LEFT)
        self.audio_codec = tk.StringVar(value="aac")
        ttk.Combobox(controls_frame, textvariable=self.audio_codec,
                     values=ALL_AUDIO_ENCODERS, state="readonly", width=10).pack(side=tk.LEFT, padx=5)
        ttk.Label(controls_frame, text="比特率:").pack(side=tk.LEFT)
        self.audio_bitrate = tk.StringVar(value="128k")
        bitrate_combo = ttk.Combobox(controls_frame, textvariable=self.audio_bitrate, width=6, values=["64k","96k", "128k", "192k", "256k", "320k"], state='readonly')
        bitrate_combo.pack(side=tk.LEFT, padx=5)
        
        ttk.Label(controls_frame, text="采样率:").pack(side=tk.LEFT)
        self.audio_samplerate = tk.StringVar(value="44100")
        samplerate_combo = ttk.Combobox(controls_frame, textvariable=self.audio_samplerate, width=8, values=["8000","12000","16000","22050","32000", "44100", "48000", "96000"], state='readonly')
        samplerate_combo.pack(side=tk.LEFT, padx=5)

        volume_frame = ttk.Frame(inner)
        volume_frame.pack(fill=tk.X, pady=(2,0))
        self.volume_enabled = tk.BooleanVar(value=False)
        chk_volume = ttk.Checkbutton(volume_frame, text="启用音量", variable=self.volume_enabled)
        chk_volume.pack(side=tk.LEFT, padx=(0,5))
        ToolTip(chk_volume, "勾选后启用音量倍数调整，可拖动滑块设置倍数（0.1~3.0）\n\n1.0=原始音量", wraplength=400)
        ttk.Label(volume_frame, text="倍数:").pack(side=tk.LEFT, padx=(5,0))
        self.volume_value = tk.DoubleVar(value=1.0)
        self.volume_slider = ttk.Scale(volume_frame, from_=0.1, to=3.0, variable=self.volume_value,
                                       orient=tk.HORIZONTAL, length=110, state=tk.DISABLED)
        self.volume_slider.pack(side=tk.LEFT, padx=5)
        self.volume_label = ttk.Label(volume_frame, text="1.0", width=5)
        self.volume_label.pack(side=tk.LEFT)
        self.volume_slider.configure(command=lambda v: self.volume_label.config(text=f"{float(v):.2f}"))

        def on_volume_enabled(*args):
            state = tk.NORMAL if self.volume_enabled.get() else tk.DISABLED
            self.volume_slider.config(state=state)
        self.volume_enabled.trace_add("write", on_volume_enabled)

        # 变速 + 高级音频弹窗
        adv_row = ttk.Frame(inner)
        adv_row.pack(fill=tk.X, pady=(3,0))
        self.audio_speed_enabled = tk.BooleanVar(value=False)
        ttk.Checkbutton(adv_row, text="变速", variable=self.audio_speed_enabled).pack(side=tk.LEFT, padx=(0,3))
        ttk.Label(adv_row, text="倍数:").pack(side=tk.LEFT)
        self.audio_speed_factor = tk.StringVar(value="1.0")
        ttk.Entry(adv_row, textvariable=self.audio_speed_factor, width=7).pack(side=tk.LEFT, padx=3)
        ToolTip(adv_row, "音频变速（atempo），0.25~4.0，>2 自动串联多个 atempo", wraplength=400)

        # 音频倒放独立控制（不再跟随主视频倒放）
        self.audio_reverse = tk.BooleanVar(value=False)
        chk_reverse = ttk.Checkbutton(adv_row, text="音频倒放（独立于视频）", variable=self.audio_reverse)
        chk_reverse.pack(side=tk.LEFT, padx=(5,0))
        ToolTip(chk_reverse, "勾选后，音频将单独倒放，不受视频倒放影响；与上方「变速」同为独立控制。")

        ttk.Button(adv_row, text="高级音频…", command=self._open_advanced_audio_dialog).pack(side=tk.LEFT, padx=(10,0))

        # 高级音频设置（由弹窗修改，默认值）
        self.fade_enabled = tk.BooleanVar(value=False)
        self.fade_in = tk.StringVar(value="")
        self.fade_out = tk.StringVar(value="")
        self.loudnorm_enabled = tk.BooleanVar(value=False)
        self.denoise_enabled = tk.BooleanVar(value=False)
        self.channel_mode = tk.StringVar(value="stereo")
        self.eq_enabled = tk.BooleanVar(value=False)
        self.eq_low = tk.StringVar(value="0")
        self.eq_mid = tk.StringVar(value="0")
        self.eq_high = tk.StringVar(value="0")

    def _open_advanced_audio_dialog(self):
        """高级音频弹窗：淡入淡出 / 响度标准化 / 降噪 / 声道 / 均衡器（节省主区空间）。"""
        win = tk.Toplevel(self)
        win.withdraw()  # 先隐藏，避免左上角闪一下
        win.title("高级音频处理")
        try:
            center_window(win, 480, 260)
        except Exception:
            pass
        win.transient(self.winfo_toplevel())

        fe = tk.BooleanVar(value=self.fade_enabled.get())
        fi = tk.StringVar(value=self.fade_in.get())
        fo = tk.StringVar(value=self.fade_out.get())
        le = tk.BooleanVar(value=self.loudnorm_enabled.get())
        de = tk.BooleanVar(value=self.denoise_enabled.get())
        cm = tk.StringVar(value=self.channel_mode.get())
        ee = tk.BooleanVar(value=self.eq_enabled.get())
        elo = tk.StringVar(value=self.eq_low.get())
        emi = tk.StringVar(value=self.eq_mid.get())
        ehi = tk.StringVar(value=self.eq_high.get())

        main = ttk.Frame(win, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        row = 0

        # ---- 行0：淡入淡出 ----
        chk_fade = ttk.Checkbutton(main, text="淡入淡出 (afade)", variable=fe)
        chk_fade.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_fade, "在音频开头和结尾添加音量渐变效果，不会改变音频总时长")

        lbl_fi = ttk.Label(main, text="淡入秒:")
        lbl_fi.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_fi, "淡入持续时间（秒），从 0 开始逐渐增大音量")
        entry_fi = ttk.Entry(main, textvariable=fi, width=6)
        entry_fi.grid(row=row, column=3, padx=2, sticky="w")

        lbl_fo = ttk.Label(main, text="淡出秒:")
        lbl_fo.grid(row=row, column=4, sticky="w", padx=(10, 2))
        ToolTip(lbl_fo, "淡出持续时间（秒），在音频末尾逐渐减小音量至静音")
        entry_fo = ttk.Entry(main, textvariable=fo, width=6)
        entry_fo.grid(row=row, column=5, padx=2, sticky="w")

        # ---- 行1：响度标准化 ----
        row += 1
        chk_loud = ttk.Checkbutton(main, text="响度标准化 (loudnorm)", variable=le)
        chk_loud.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_loud, "将音频响度标准化到广播级标准（EBU R128），适合统一多段音频的音量")

        # ---- 行2：降噪 ----
        row += 1
        chk_denoise = ttk.Checkbutton(main, text="降噪 (afftdn)", variable=de)
        chk_denoise.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_denoise, "使用 FFT 降噪算法减少背景噪声，适合录音降噪")

        # ---- 行3：声道 ----
        row += 1
        ch_frame = ttk.Frame(main)
        ch_frame.grid(row=row, column=0, columnspan=3, sticky="w", padx=5, pady=4)

        lbl_ch = ttk.Label(ch_frame, text="声道:")
        lbl_ch.pack(side=tk.LEFT)
        ToolTip(lbl_ch, "选择输出声道模式：\n• stereo：保持立体声\n• mono：混合为单声道\n• left：仅保留左声道\n• right：仅保留右声道\n• swap：左右交换")

        combo_ch = ttk.Combobox(ch_frame, textvariable=cm, values=["stereo", "mono", "left", "right", "swap"], state="readonly", width=12)
        combo_ch.pack(side=tk.LEFT, padx=5)

        # ---- 行4：均衡器 ----
        row += 1
        chk_eq = ttk.Checkbutton(main, text="均衡器 (EQ)", variable=ee)
        chk_eq.grid(row=row, column=0, columnspan=2, sticky="w", padx=5, pady=4)
        ToolTip(chk_eq, "分别调节低音、中音、高音的增益（单位 dB），正数增强，负数衰减")

        lbl_low = ttk.Label(main, text="低音 (dB):")
        lbl_low.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_low, "低音增益（通常 60-250 Hz），正数增强低音，负数减弱")
        entry_low = ttk.Entry(main, textvariable=elo, width=5)
        entry_low.grid(row=row, column=3, padx=2, sticky="w")

        lbl_mid = ttk.Label(main, text="中音 (dB):")
        lbl_mid.grid(row=row, column=4, sticky="w", padx=(10, 2))
        ToolTip(lbl_mid, "中音增益（约 1kHz），调节人声和乐器的清晰度")
        entry_mid = ttk.Entry(main, textvariable=emi, width=5)
        entry_mid.grid(row=row, column=5, padx=2, sticky="w")

        # ---- 行5：高音 ----
        row += 1
        lbl_high = ttk.Label(main, text="高音 (dB):")
        lbl_high.grid(row=row, column=2, sticky="w", padx=(10, 2))
        ToolTip(lbl_high, "高音增益（通常 4-8 kHz），提升细节或减少刺耳感")
        entry_high = ttk.Entry(main, textvariable=ehi, width=5)
        entry_high.grid(row=row, column=3, padx=2, sticky="w")

        # ---- 底部按钮 ----
        row += 1
        btn_frame = ttk.Frame(main)
        btn_frame.grid(row=row, column=0, columnspan=6, pady=15)

        def _save():
            self.fade_enabled.set(fe.get())
            self.fade_in.set(fi.get().strip())
            self.fade_out.set(fo.get().strip())
            self.loudnorm_enabled.set(le.get())
            self.denoise_enabled.set(de.get())
            self.channel_mode.set(cm.get())
            self.eq_enabled.set(ee.get())
            self.eq_low.set(elo.get().strip() or "0")
            self.eq_mid.set(emi.get().strip() or "0")
            self.eq_high.set(ehi.get().strip() or "0")
            win.destroy()

        ttk.Button(btn_frame, text="保存", command=_save).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="取消", command=win.destroy).pack(side=tk.LEFT, padx=5)

        win.wait_window()

    def get_settings(self):
        volume = self.volume_value.get()
        if volume < 0.1:
            volume = 0.1
        elif volume > 3.0:
            volume = 3.0
        res = {
            "audio_codec": self.audio_codec.get(),
            "audio_bitrate": self.audio_bitrate.get(),
            "audio_samplerate": self.audio_samplerate.get(),
            "only_audio": self.only_audio.get(),
            "audio_format": self.audio_format.get(),
