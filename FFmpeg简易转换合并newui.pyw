        ed.protocol("WM_DELETE_WINDOW", _close)
        ef = ttk.Frame(ed, padding="10")
        ef.pack(fill=tk.BOTH, expand=True)
        r = 0

        ttk.Label(ef, text="起始坐标:").grid(row=r, column=0, sticky="e", pady=2)
        _sa = tk.StringVar(value=f"{int(round(_wp_num(w, 'xa'))):d}, {int(round(_wp_num(w, 'ya'))):d}")
        ttk.Entry(ef, textvariable=_sa, width=18).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="移动方式:").grid(row=r, column=0, sticky="e", pady=2)
        _mdisp = tk.StringVar(value=dict(MODES).get(w.get("mode"), "平移"))
        ttk.Combobox(ef, textvariable=_mdisp, values=[d for _v, d in MODES],
                     state="readonly", width=14).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="结尾坐标:").grid(row=r, column=0, sticky="e", pady=2)
        _sb = tk.StringVar(value=f"{int(round(_wp_num(w, 'xb'))):d}, {int(round(_wp_num(w, 'yb'))):d}")
        ttk.Entry(ef, textvariable=_sb, width=18).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="开始时间:").grid(row=r, column=0, sticky="e", pady=2)
        _st = tk.StringVar(value=f"{_wp_num(w, 'start'):.3f}")
        ttk.Entry(ef, textvariable=_st, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="结束时间:").grid(row=r, column=0, sticky="e", pady=2)
        _en = tk.StringVar(value=f"{_wp_num(w, 'start') + _wp_num(w, 'dur'):.3f}")
        ttk.Entry(ef, textvariable=_en, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="到期行为:").grid(row=r, column=0, sticky="e", pady=2)
        _edisp = tk.StringVar(value=dict(EA).get(w.get("end_action"), "保持"))
        ttk.Combobox(ef, textvariable=_edisp, values=[d for _v, d in EA],
                     state="readonly", width=14).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="起始角度(度):").grid(row=r, column=0, sticky="e", pady=2)
        _rta = tk.StringVar(value=f"{_wp_num(w, 'ra', 0):g}")
        ttk.Entry(ef, textvariable=_rta, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        ttk.Label(ef, text="结尾角度(度):").grid(row=r, column=0, sticky="e", pady=2)
        _rtb = tk.StringVar(value=f"{_wp_num(w, 'rb', 0):g}")
        ttk.Entry(ef, textvariable=_rtb, width=10).grid(row=r, column=1, sticky="w", padx=6)
        r += 1

        def _parse_pt(s):
            try:
                _a, _b = str(s).split(",")
                return float(_a.strip()), float(_b.strip())
            except Exception:
                return None

        def _ok():
            _m = ""
            for _v, _d in MODES:
                if _d == _mdisp.get():
                    _m = _v
                    break
            if _m == "end" and row_idx != len(waypoints) - 1:
                messagebox.showinfo("提示", "「终点」只能作为最后一行")
                return
            pa = _parse_pt(_sa.get())
            if pa is None:
                messagebox.showinfo("提示", "起始坐标格式应为 x, y（如 30, 30）")
                return
            try:
                _ra_v = float(_rta.get().strip())
            except (ValueError, TypeError):
                _ra_v = 0.0
            try:
                _rb_v = float(_rtb.get().strip())
            except (ValueError, TypeError):
                _rb_v = 0.0
            w["ra"] = _ra_v
            w["rb"] = _rb_v
            if _m != "end":
                pb = _parse_pt(_sb.get())
                if pb is None:
                    messagebox.showinfo("提示", "结尾坐标格式应为 x, y（如 200, 30）")
                    return
                try:
                    _s0 = float(_st.get().strip())
                    _e0 = float(_en.get().strip())
                except (ValueError, TypeError):
                    messagebox.showinfo("提示", "时间应为秒数")
                    return
            if _e0 <= _s0:
                _log_time_order_warn(app, "[轨迹] ")
                return
            # 2026-09-03 修复：原 save 代码被上面的 return 压成死代码，
            # 导致普通行点「确定」不落盘、列表不刷新（只能保存工程再重开才看到）。
            # 这里统一把字段写回航点并刷新列表。
            if _m == "end":
                w["mode"] = "end"
                w["xa"], w["ya"] = pa
            else:
                _ea = "keep"
                for _v, _d in EA:
                    if _d == _edisp.get():
                        _ea = _v
                        break
                w["mode"] = _m
                w["xa"], w["ya"] = pa
                w["xb"], w["yb"] = pb
                w["start"] = _s0
                w["dur"] = _e0 - _s0
                w["end_action"] = _ea
            _refresh(row_idx)
            _close()

        ttk.Button(ef, text="确定", command=_ok, width=8).grid(row=r, column=0, sticky="e", padx=(0, 3), pady=(10, 0))
        ttk.Button(ef, text="取消", command=_close, width=8).grid(row=r, column=1, sticky="w", padx=(3, 0), pady=(10, 0))
        center_window(ed, 300, 250)
        _grab_release()   # 打开子窗先释放父锁，避免嵌套锁链
        ed.grab_set()

    def _open_row_editor(idx=None):
        if idx is None:
            idx = _selected()
        if idx is None:
            messagebox.showinfo("提示", "请先选择一行")
            return
        if idx < 0 or idx >= len(waypoints):
            return
        _edit_row_dialog(idx)

    def _open_time_preview():
        """简易时间预览：选中行 → 主视频帧浏览器（SimplePreviewer）回填 开始/结束时间。
        时间在主视频时间线上点选（与水印位置无关）；on_set_start/on_set_end 换算 start/dur。
        2026-08-28：未选中也能打开（标记/发送到轨迹用，不回填单行），选中则照旧回填。"""
        idx = _selected()
        if idx is not None:
            if idx < 0 or idx >= len(waypoints):
                return
            w = waypoints[idx]
            if w.get("mode") == "end":
                messagebox.showinfo("提示", "终点行没有时间段（移动方式/时间忽略）")
                return
        else:
            w = None  # 未选中行：仅预览/标记/发送到轨迹，起点/终点不回填
        if not video_file or not os.path.exists(video_file):
            messagebox.showerror("错误", "未找到主视频文件，无法时间预览")
            return
        if not ffmpeg_cmd:
            messagebox.showwarning("提示", "未找到 ffmpeg，无法预览")
            return
        _grab_release()

        def _on_start(t):
            if w is None:
                return  # 未选中行：起点仅预览定位，不回填
            w["start"] = float(t)
            _refresh()

        def _on_end(t):
            if w is None:
                return  # 未选中行：终点仅预览定位，不回填
            te = float(t)
            _st = _wp_num(w, "start")
            if te <= _st:
                _log_time_order_warn(app, "[轨迹] ")
                return
            w["dur"] = te - _st
            _refresh()

        def _on_marks_to_waypoints(segs):
            """简易预览标记段 → 轨迹列表「隐藏」行：mode=hide 只需 start/dur
            （build_waypoint_expr 隐藏段表达式不依赖坐标）。追加到末尾（终点行前），
            受 MAX_ROWS 上限约束，超出部分跳过并提示。"""
            added = skipped = 0
            for s, e in segs:
                if e <= s:
                    skipped += 1
                    continue
                if len(waypoints) >= MAX_ROWS:
                    skipped += 1
                    continue
                new_row = {"xa": 20.0, "ya": 20.0, "mode": "hide",
                           "xb": 200.0, "yb": 20.0,
                           "start": float(s), "dur": float(e - s),
                           "end_action": "keep", "ra": 0.0, "rb": 0.0}
                if waypoints and waypoints[-1].get("mode") == "end":
                    waypoints.insert(len(waypoints) - 1, new_row)
                    _refresh(len(waypoints) - 2)
                else:
                    waypoints.append(new_row)
                    _refresh(len(waypoints) - 1)
                added += 1
            # 结果只写主窗口日志，不弹窗（弹窗会让预览窗口沉底、易堆积多个预览）
            if added or skipped:
                msg = f"已追加 {added} 个隐藏段到轨迹列表"
                if skipped:
                    msg += f"（跳过 {skipped} 个：超出 {MAX_ROWS} 行上限或无效）"
                try:
                    app._append_info_ui("[轨迹] " + msg)
                except Exception:
                    pass

        # 回溯标记段：单选 → 只回该行；未选中（点列表空白取消选中）→ 全部行时段
        if w is not None:
            initial_marks = [(w["start"], w["start"] + w.get("dur", 0))]
        else:
            initial_marks = [(r["start"], r["start"] + r.get("dur", 0)) for r in waypoints]
        try:
            app.show_time_picker(grab_win, video_file, on_set_start=_on_start,
                                 on_set_end=_on_end, initial_marks=initial_marks,
                                 on_send_waypoints=_on_marks_to_waypoints)
        finally:
            _grab_set()

    W4 = 4
    ttk.Button(btns, text="添加", command=_add_row, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="删除", command=_del_row, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="上移", command=lambda: _move(-1), width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="下移", command=lambda: _move(1), width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="编辑", command=_open_row_editor, width=W4).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="起始坐标…", command=lambda: _open_editor("start"), width=8).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="结尾坐标…", command=lambda: _open_editor("end"), width=8).pack(side=tk.LEFT, padx=1)
    ttk.Button(btns, text="时间预览", command=_open_time_preview, width=8).pack(side=tk.LEFT, padx=1)
    ttk.Label(btns, text="开始:").pack(side=tk.LEFT, padx=(6, 0))
    t_start_var = tk.StringVar()
    t_start_e = ttk.Entry(btns, textvariable=t_start_var, width=7)
    t_start_e.pack(side=tk.LEFT)
    ttk.Label(btns, text="结束:").pack(side=tk.LEFT, padx=(6, 0))
    t_end_var = tk.StringVar()
    t_end_e = ttk.Entry(btns, textvariable=t_end_var, width=7)
    t_end_e.pack(side=tk.LEFT)
    ttk.Label(btns, text="(选中行时间，回车/失焦生效)", foreground="gray").pack(side=tk.LEFT, padx=4)

    _time_owner = [None]   # 时间框当前对应行（写回目标）。2026-08-27：直接点下一行时
    # selection 先变、FocusOut 后触发，若用 _selected() 会把时间写到新点击的行 →
    # 必须锁定 owner，切行/失焦都写回原行。

    def _update_time_entries():
        """手动时间编辑框同步当前选中行（终点行清空）；同时更新 owner。"""
        idx = _selected()
        if idx is None or idx >= len(waypoints) or waypoints[idx].get("mode") == "end":
            t_start_var.set("")
            t_end_var.set("")
            _time_owner[0] = None
            return
        w = waypoints[idx]
        t_start_var.set(f"{_wp_num(w, 'start'):.3f}")
        t_end_var.set(f"{_wp_num(w, 'start') + _wp_num(w, 'dur'):.3f}")
        _time_owner[0] = idx

    def _apply_time_entries(_ev=None):
        # 写回目标 = 时间框 owner（原行），不是当前选中行——用户改完时间直接点下一行时
        # selection 已切到新行，用 _selected() 会写错行（2026-08-27 修复）
        idx = _time_owner[0]
        if idx is None or idx >= len(waypoints) or waypoints[idx].get("mode") == "end":
            _update_time_entries()
            return
        w = waypoints[idx]
        try:
            _s = float(t_start_var.get().strip())
            _e = float(t_end_var.get().strip())
        except (ValueError, TypeError):
            _update_time_entries()
            return
        if _e <= _s:
            _log_time_order_warn(app, "[轨迹] ")
            return
        w["start"] = _s
        w["dur"] = _e - _s
        # ⚠️ 2026-08-27 卡死修复：写回后只做单行更新（tree.item），绝不整表 _refresh()。
        # 根因（实证复现）：_refresh() 里 delete 清空 selection 后 selection_set 必排队
        # <<TreeviewSelect>> 异步事件；事件回调 _on_tree_select → _apply_time_entries →
        # 又 _refresh() → 又排队新事件 → 事件队列无限膨胀、Tk 主循环被独占 = 程序卡死
        # （用户症状：添加即卡死；修改时间失焦回写瞬间卡死）。
        # 该事件是异步排队（回调 depth 恒 1），布尔重入守卫挡不住；唯一断点就是
        # 把 _refresh() 从本函数移除——其他按钮（添加/删除/上移/编辑等）仍走 _refresh()，
        # 事件回调里的本函数现在只单行更新、不再触发 selection 变化 → 整条事件链终止。
        try:
            tree.item(str(idx), values=_row_values(idx, w))
        except Exception:
            pass
        _update_hint()
        _update_time_entries()

    t_start_e.bind("<Return>", _apply_time_entries)
    t_end_e.bind("<Return>", _apply_time_entries)
    t_start_e.bind("<FocusOut>", _apply_time_entries)
    t_end_e.bind("<FocusOut>", _apply_time_entries)

    # ---- 简易时间预览（甘特条） ----
    prev_cv = tk.Canvas(frm, height=34, bg="#fafafa", highlightthickness=1,
                        highlightbackground="#cccccc")
    prev_cv.grid(row=2, column=0, columnspan=5, sticky="ew", pady=(4, 0))
    prev_lab = ttk.Label(frm, text="", foreground="gray")
    prev_lab.grid(row=3, column=0, columnspan=5, sticky="w")

    HINT = f"≤{MAX_ROWS} 行，每行独立段（可不设终点行）；双击编辑整行；结束时间=开始+持续"
    # 2026-08-29：主视频启用截取/变速 → 轨迹时间按输出时间线（滤镜 t=截取后从 0 起）填
    try:
        _ts0, _sp0 = _main_trim_speed(app)
        if _ts0 > 0 or _sp0 != 1.0:
            HINT += (f" ｜ ⚠ 主视频已截取(起点 {_ts0:.3f}s)/变速(×{_sp0:g})："
                     f"时间按主视频原始时间填，转换时自动换算（无需手动减）")
    except Exception:
        pass

    def _draw_preview():
        prev_cv.delete("all")
        wpx = prev_cv.winfo_width() or 560
        non_end = [w for w in waypoints if w.get("mode") != "end"]
        if not non_end:
            prev_lab.config(text=HINT)
            return
        t_max = max(_wp_num(w, "start") + _wp_num(w, "dur", 1.0) for w in non_end)
        if t_max <= 0:
            t_max = 1.0
        # 按段索引循环调色板配色（相邻段颜色不同，重叠混色才看得见）；隐藏段保留灰色语义
        palette = ["#85B7EB", "#97C459", "#E1A33B", "#B58EDC", "#5FB0B5", "#D98A8A"]

        def seg_color(w, idx):
            if w.get("mode") == "hide":
                return "#B4B2A9"
            return palette[idx % len(palette)]

        x0, x1 = 6, wpx - 6

        def _blend(hexes):
            """重叠区混色：RGB 均值（与简易时间预览段落条一致，无 PIL 依赖）。"""
            try:
                r = g = b = 0
                for hx in hexes:
                    hx = hx.lstrip("#")
                    r += int(hx[0:2], 16); g += int(hx[2:4], 16); b += int(hx[4:6], 16)
                n = len(hexes)
                return "#%02x%02x%02x" % (r // n, g // n, b // n)
            except Exception:
                return hexes[0] if hexes else "#888888"

        def x_of(t):
            return x0 + (t / t_max) * (x1 - x0)

        # 每行时间段 [t0, t0+d0)；重叠区按边界切片做 RGB 均值混色（看出下层段）
        spans = []
        for idx, w in enumerate(non_end):
            t0 = _wp_num(w, "start")
            d0 = max(_wp_num(w, "dur", 1.0), 0.05)
            spans.append((t0, t0 + d0, w, idx))
        bounds = sorted(set([s for s, _e, _w, _i in spans] + [e for _s, e, _w, _i in spans]))
        for k in range(len(bounds) - 1):
            a, b = bounds[k], bounds[k + 1]
            if b <= a:
                continue
            mid = (a + b) / 2.0
            cover = [(w, i) for s, e, w, i in spans if s <= mid < e]
            if not cover:
                continue
            color = _blend([seg_color(w, i) for w, i in cover])
            prev_cv.create_rectangle(x_of(a), 8, max(x_of(b), x_of(a) + 4), 24,
                                     fill=color, outline="#5F5E5A")
        # 每段文字（hide 显示"隐藏"）与起点小三角（纯视觉标记，不绑定点击）
        for s, e, w, i in spans:
            prev_cv.create_text((x_of(s) + x_of(e)) / 2, 16,
                                text="隐藏" if w.get("mode") == "hide" else "",
                                font=("Microsoft YaHei", 8), fill="#2C2C2A")
            ax = x_of(s)
            prev_cv.create_polygon(ax - 4, 8, ax + 4, 8, ax, 14,
                                   fill=seg_color(w, i),
                                   outline="#333333", width=1)
        prev_cv.create_line(x1, 6, x1, 26, fill="#A32D2D", width=2)
        prev_lab.config(
            text=f"{HINT} ｜ 总时长 {t_max:.3f}s（红色竖线=终点；重叠段自动混色，段起点有三角）")

    def _update_hint():
        try:
            _x, _y, _ang = build_waypoint_expr(waypoints)
            _n = (len(_x) + len(_y)) // 2 if _x else 0
            prev_lab.config(text=f"{HINT} ｜ 表达式约 {_n} 字符（实测 2400+ 字符仍正常，安全）")
            _draw_preview()
        except Exception:
            pass

    def _on_double(ev):
        # 双击任意行 → 打开整行编辑弹窗（与「编辑」按钮一致）
        iid = tree.identify_row(ev.y)
        if not iid:
            return
        try:
            ri = int(iid)
        except (ValueError, TypeError):
            return
        if ri < 0 or ri >= len(waypoints):
            return
        _open_row_editor(ri)
    def _on_tree_select(*_a):
        # 切行前先提交时间框到 owner 行：用户改完时间直接点下一行时 selection 已切走、
        # FocusOut 晚于 selection 变化，此处兜底先提交原行，再同步新行时间框。
        # （幂等：时间框未改动时提交无效果）
        try:
            _apply_time_entries()
        except Exception:
            pass
        _update_hint()
        _update_time_entries()
    tree.bind("<Double-1>", _on_double)
    tree.bind("<<TreeviewSelect>>", _on_tree_select)
    frm.bind("<Configure>", lambda *a: _draw_preview())

    def set_enabled(flag):
        """「启用列表轨迹」勾选驱动：整面板置灰/启用（Treeview/按钮/时间输入框）。
        ⚠️ ttk 组件不支持 configure(state=...)，必须用 state([...]) 方法（TclError 实测）。"""
        tree.state(["disabled"] if not flag else ["!disabled"])
        for _b in btns.winfo_children():
            if not isinstance(_b, ttk.Button):
                continue
            if _b["text"] in ("起始坐标…", "结尾坐标…") and edit_cb is None:
                _b.state(["disabled"])
            else:
                _b.state(["disabled"] if not flag else ["!disabled"])
        t_start_e.state(["disabled"] if not flag else ["!disabled"])
        t_end_e.state(["disabled"] if not flag else ["!disabled"])

    def refresh():
        _refresh()

    _refresh()
    return set_enabled, refresh


def _trajectory_dialog(parent, initial, commit, edit_cb=None, canvas_w=1280, canvas_h=720,
                       video_file=None, ffmpeg_cmd=None, ffprobe_cmd=None, app=None):
    """轨迹控制弹窗公共实现（图片/视频水印与文字水印共用）。
    initial: dict，含 move_mode / move_cycle / move_dwell / move_margin / move_waypoints 初值；
    commit: callable(dict)，点「确定」时把规范化后的新值写回（写 tk 变量或 settings dict 均可）。
    edit_cb: callable(row_idx, which, cur_x, cur_y, cur_angle, apply_xy, apply_angle)，列表模式
    「可视化编辑坐标」回调（None 时列表编辑按钮禁用）。which∈{start,end}；cur_angle=当前选中点
    角度（起点=ra / 终点=rb）；apply_xy(nx,ny)/apply_angle(na) 写回该航点坐标/角度。
    canvas_w/h: 可视化编辑器的画布尺寸（主视频渲染尺寸）。
    2026-08-27 合并版（用户拍板方案 B）：运动轨迹+周期并成一行；「启用列表轨迹」勾选驱动
    waypoints（勾选后上方下拉自动忽略）；列表轨迹面板常驻（未勾选时整面板置灰禁用），
    不再嵌套「列表轨迹控制」子窗，弹窗层级 4 层 → 1 层。"""
    win = tk.Toplevel(parent)
    win.title("轨迹控制")
    win.withdraw()  # 先隐藏，center_window 自动居中显示
    try:
        win.transient(parent.winfo_toplevel() if hasattr(parent, "winfo_toplevel") else parent)
        # 注意：grab_set 延后到 center_window(deiconify) 之后执行——withdraw 状态的窗口
        # 若中途异常未显示就带着模态锁，会吞掉全部输入（主程序无法唤醒/关不掉的根因之一）。
    except Exception:
        pass

    MODES = [
        ("", "无（静态定位）"),
        ("h", "左右往返"),
        ("v", "上下往返"),
        ("diamond", "歪菱形循环"),
        ("corners", "四角跳跃"),
    ]
    # 列表轨迹不再占下拉项：由「启用列表轨迹」勾选框驱动（2026-08-27 合并版）
    mode_disp = tk.StringVar()
    mode_val = tk.StringVar(value=initial.get("move_mode", "") or "")
    if mode_val.get() == "waypoints":
        mode_val.set("")   # 存量 waypoints 数据：勾选框接管，下拉回退默认值
    for _v, _d in MODES:
        if _v == mode_val.get():
            mode_disp.set(_d)
            break
    if not mode_disp.get():
        mode_disp.set(MODES[0][1])
        mode_val.set("")

    frm = ttk.Frame(win, padding="10")
    frm.pack(fill=tk.BOTH, expand=True)
    frm.grid_columnconfigure(0, weight=1)

    # ---- 第 0 行：运动轨迹 + 周期（corners 时原位切换为 每点停留+边距）----
    row0 = ttk.Frame(frm)
    row0.grid(row=0, column=0, sticky="ew", pady=(0, 6))
    ttk.Label(row0, text="运动轨迹:").pack(side=tk.LEFT)
    cb = ttk.Combobox(row0, textvariable=mode_disp, values=[d for _v, d in MODES],
                      state="readonly", width=18)
    cb.pack(side=tk.LEFT, padx=6)

    cyc_frm = ttk.Frame(row0)
    ttk.Label(cyc_frm, text="周期(秒):").pack(side=tk.LEFT)
    cyc_var = tk.DoubleVar(value=float(initial.get("move_cycle", 4.0) or 4.0))
    cyc_sb = ttk.Spinbox(cyc_frm, from_=0.5, to=600, increment=0.5, width=7, textvariable=cyc_var)
    cyc_sb.pack(side=tk.LEFT, padx=(2, 0))
    ToolTip(cyc_sb,
            """这里的周期管的是速度：周期越短，水印移动越快。
往返 = 单程来回一次的时间；菱形 = 走完一圈的时间；
四角跳跃不受此周期影响（用下方「每点停留」控制）。
往返无需幅度参数：左右往返自动横跨整个画面宽度（0→W），
上下往返自动纵跨整个画面高度（0→H）。""",
            wraplength=340)
    cyc_frm.pack(side=tk.LEFT, padx=(10, 0))

    dwell_frm = ttk.Frame(row0)
    ttk.Label(dwell_frm, text="每点停留(秒):").pack(side=tk.LEFT)
    dwell_var = tk.DoubleVar(value=float(initial.get("move_dwell", 2.0) or 2.0))
    ttk.Spinbox(dwell_frm, from_=0.2, to=600, increment=0.2, width=7,
                textvariable=dwell_var).pack(side=tk.LEFT, padx=(2, 10))
    ttk.Label(dwell_frm, text="边距:").pack(side=tk.LEFT)
    margin_var = tk.StringVar(value=initial.get("move_margin", "W*0.03") or "W*0.03")
    margin_entry = ttk.Entry(dwell_frm, textvariable=margin_var, width=10)
    margin_entry.pack(side=tk.LEFT, padx=2)
    ToolTip(margin_entry,
            """四角跳跃时水印离屏幕边缘的距离。
可填像素数（如 20）或相对式（如 W*0.03 = 主画面宽度 3%）。""",
            wraplength=320)


    tip_label = ttk.Label(frm, text="", foreground="gray")
    tip_label.grid(row=1, column=0, sticky="ew", pady=(0, 2))

    # ---- 间隔条 ----
    ttk.Separator(frm, orient=tk.HORIZONTAL).grid(row=2, column=0, sticky="ew", pady=(2, 6))

    # ---- 勾选框：启用列表轨迹 ----
    chk_frm = ttk.Frame(frm)
    chk_frm.grid(row=3, column=0, sticky="ew", pady=(0, 2))
    wp_var = tk.BooleanVar(value=(initial.get("move_mode") == "waypoints"))
    wp_chk = ttk.Checkbutton(chk_frm, text="启用列表轨迹", variable=wp_var)
    wp_chk.pack(side=tk.LEFT)
    ToolTip(wp_chk,
            """勾选后上方的运动轨迹下拉自动忽略（列表轨迹优先）。
列表轨迹：每行=时间段，含平移/隐藏/自旋转与分段到期行为；启用后覆盖全局自旋转。""",
            wraplength=360)



    # ---- 列表轨迹面板（常驻：未勾选时整面板置灰禁用）----
    panel_host = ttk.Frame(frm)
    panel_host.grid(row=4, column=0, sticky="nsew")
    frm.grid_rowconfigure(4, weight=1)

    _wps = initial.get("move_waypoints")
    if not isinstance(_wps, list):
        _wps = []   # 占位：勾选时才种子默认行并写回 initial（不污染未使用列表轨迹的设置）
    _had_wps = initial.get("move_waypoints") is not None   # 打开时原本就有列表 → 确定时总写回
    set_panel_enabled, refresh_panel = _waypoints_panel(
        panel_host, _wps, edit_cb, canvas_w, canvas_h,
        grab_win=win, video_file=video_file, ffmpeg_cmd=ffmpeg_cmd, ffprobe_cmd=ffprobe_cmd,
        app=app)

    def _ensure_wps():
        """勾选时若列表为空则种子默认行，并写回 initial（WYSIWYG）。"""
        if _wps:
            return
        _wps.extend([
            {"xa": 30, "ya": 30, "mode": "move", "xb": 400, "yb": 30,
             "start": 0, "dur": 3, "end_action": "keep", "ra": 0.0, "rb": 0.0},
        ])
        initial["move_waypoints"] = _wps
        refresh_panel()

    def _sync_params(*_a):
        for _v, _d in MODES:
            if _d == mode_disp.get():
                mode_val.set(_v)
                break
        wp_on = wp_var.get()
        if wp_on:
            _ensure_wps()
        cb.config(state="disabled" if wp_on else "readonly")
        set_panel_enabled(wp_on)
        if wp_on:
            tip_label.config(text="")
        else:
            mv = mode_val.get()
            if mv == "corners":
                cyc_frm.pack_forget()
                dwell_frm.pack(side=tk.LEFT, padx=(10, 0))
                tip_label.config(text="（四角跳跃忽略上方设置的位置坐标，自动贴屏幕四角）")
            else:
                dwell_frm.pack_forget()
                cyc_frm.pack(side=tk.LEFT, padx=(10, 0))
                tip_label.config(text="")
    wp_chk.config(command=_sync_params)
    cb.bind("<<ComboboxSelected>>", _sync_params)
    _sync_params()

    def _apply():
        wp_on = wp_var.get()
        vals = {
            "move_mode": "waypoints" if wp_on else mode_val.get(),
            "move_margin": margin_var.get().strip() or "W*0.03",
        }
        try:
            vals["move_cycle"] = float(cyc_var.get())
        except (ValueError, TypeError):
            vals["move_cycle"] = initial.get("move_cycle", 4.0)
        try:
            vals["move_dwell"] = float(dwell_var.get())
        except (ValueError, TypeError):
            vals["move_dwell"] = initial.get("move_dwell", 2.0)
        if _had_wps or wp_on:
            # 仅在「打开时原本有列表」或「最终勾选」时写回：避免勾选又取消后
            # 把种子默认行污染进设置（move_mode 非 waypoints 时列表会被忽略）
            vals["move_waypoints"] = initial.get("move_waypoints")
        commit(vals)
        win.destroy()

    btn_row = ttk.Frame(frm)
    btn_row.grid(row=5, column=0, sticky="ew", pady=(8, 0))
    btn_row.grid_columnconfigure(0, weight=1)
    btn_row.grid_columnconfigure(2, weight=1)
    ttk.Button(btn_row, text="确定", command=_apply, width=8).grid(row=0, column=0, sticky="e", padx=(0, 3))
    ttk.Button(btn_row, text="取消", command=win.destroy, width=8).grid(row=0, column=1, sticky="w", padx=(3, 0))

    center_window(win, 820, 560)
    try:
        win.grab_set()   # 延后到 deiconify 之后：withdraw+带锁窗口会吞输入（2026-08-27）
    except Exception:
        pass


def open_trajectory_dialog(settings, parent, edit_cb=None, canvas_w=1280, canvas_h=720,
                           video_file=None, ffmpeg_cmd=None, ffprobe_cmd=None, app=None):
    """通用轨迹控制弹窗：针对传入的 settings dict 的 move_* 字段读写（文字水印用）。
    与 OverlayPositionFrame._open_trajectory_dialog 共用公共实现 _trajectory_dialog。"""
    _trajectory_dialog(
        parent,
        {"move_mode": settings.get("move_mode", "") or "",
         "move_cycle": settings.get("move_cycle", 4.0),
         "move_dwell": settings.get("move_dwell", 2.0),
         "move_margin": settings.get("move_margin", "W*0.03") or "W*0.03",
         "move_waypoints": settings.get("move_waypoints")},
        lambda v: settings.update(v),
        edit_cb=edit_cb, canvas_w=canvas_w, canvas_h=canvas_h,
        video_file=video_file, ffmpeg_cmd=ffmpeg_cmd, ffprobe_cmd=ffprobe_cmd,
        app=app,
    )




def _majority_audio_params(params):
    """逐维度众数：采样率、声道数、采样格式分别取出现最多的值（≥3 段跟随多数轨）。"""
    from collections import Counter
    sr = Counter(p["sr"] for p in params).most_common(1)[0][0]
    ch = Counter(p["ch"] for p in params).most_common(1)[0][0]
    fmt = Counter(p["fmt"] for p in params).most_common(1)[0][0]
    return {"sr": sr, "ch": ch, "fmt": fmt}


# ================== 滤镜链构建 ==================
def build_video_filter_chain(settings: Dict[str, Any], include_subtitle: bool = True, include_speed: bool = True,
                              include_trim: bool = True, include_format: bool = True, include_scale: bool = True,
                              enhance_settings=None, reverse=False, graph_id: str = "",
                              include_fade: bool = True, clip_duration=None,
                              include_negate: bool = True,
                              chroma_settings=None, loop_size=None, force_scale=None,
                              motion_trim_start=None, motion_speed_factor=None,
                              window_start=None, window_end=None, window_loop_count=None) -> str:
    """
    从设置字典构建视频滤镜链。
    include_subtitle: 是否包含字幕滤镜
    include_speed: 是否包含变速滤镜
    include_trim: 是否包含精准截取（trim+setpts）滤镜
    include_format: 是否包含像素格式转换（format）滤镜
    enhance_settings:高级一点的滤镜
    graph_id: 当本滤镜链会被拼进同一个 filter_complex（画中画/串联合并等多路场景）时，
              调用方传入唯一标识，用于给「局部模糊」等带标签的子图生成互不冲突的标签名。
    顺序优化：
    精准截取 → 局部模糊/去水印 → 裁剪 → 旋转/翻转 → 缩放 → IVTC（反胶卷过带） → 反交错 →
    去块滤波 → 降噪 → 锐化 → 色彩空间转换 → 颜色校正+色相 → 像素格式 → 变速 → 倒放

    注意：「局部模糊」会生成带标签的分支子图（split/overlay），返回值可能是包含 ';' 的
    完整 filtergraph，而不再是单纯的逗号串。-vf 与 filter_complex 均支持该语法。
    """
    filters = []

    # 提前确定硬件滤镜模式与「帧是否已在显存」（供像素格式处理使用）
    _filter_mode = settings.get("hw_filter_mode")
    if not _filter_mode:
        if settings.get("wrap_cpu_nvidia"):
            _filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            _filter_mode = "vaapi"
        else:
            _filter_mode = "cpu"
    _hw_active = _filter_mode in ("cuda", "qsv", "vaapi")
    _native = _hw_active and settings.get("hwaccel_enabled", False) and _decoder_matches_api(settings.get("hwaccel_decoder", ""), _filter_mode)

    # ----- 精准截取（trim + setpts）-----
    if include_trim and settings.get("precise_trim", False) and settings.get("trim_enabled", False):
        start = settings.get("trim_start", "").strip()
        end = settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start) if start else None
        end_sec = time_to_seconds(end) if end else None
        if start_sec is not None or end_sec is not None:
            trim_parts = []
            if start_sec is not None:
                trim_parts.append(f"start={start_sec}")
            if end_sec is not None:
                trim_parts.append(f"end={end_sec}")
            if trim_parts:
                filters.append(f"trim={':'.join(trim_parts)}")
                filters.append("setpts=PTS-STARTPTS")

    # ----- 子视频循环（loop）-----
    # loop_size 非 None 时在 trim 之后、其余滤镜之前插 loop（子视频画中画/水印用：
    # movie 层只载入不循环，由这里统一循环 trim 片段或整段）。非循环场景（主视频/普通转码）
    # 不传 loop_size，行为不变。
    # ⚠️ 2026-09-02 窗口优化（抄统一尝试版）：当 window 生效（有界显示窗口）时，loop 改为
    # 「有限循环，仅覆盖窗口时长」(loop=loop=窗口循环次数:size=片段长)，而非无限 loop=-1 ——
    # 即凡是有限显示都走 loop=N 节省模式；仅「无界窗口」(show_start 无 end / loop_mode=infinite)
    # 才维持无限 loop=-1。窗口外不产生帧、下游重滤镜只在窗口内运行，省掉「enable 隐藏但内部
    # 照跑」的浪费；并把子链首帧锚到输出时间线 show_start，子链在 show_end 正常 EOF，
    # 配合调用方追加 eof_action=pass 避免冻帧/截断。
    # ⚠️ 结构（与统一尝试版 2869 逐字一致）：**window 判定在外层**，loop_size 在内层——
    # 不能写成「loop_size 在外、window 在内」，否则未开截取（loop_size=None）时窗口锚定
    # 不生效，有限显示窗口形同虚设。
    if window_start is not None and window_end is not None and window_end > window_start:
        if loop_size is not None and loop_size > 0:
            _wc = int(window_loop_count) if window_loop_count and int(window_loop_count) > 0 else 1
            filters.append(f"loop=loop={_wc}:size={int(loop_size)}:start=0")
        # 锚定子链首帧到输出时间线 show_start（TB=输入时基，show_start/TB 即 show_start 秒）。
        # 此时 PTS 已归零（截取/loop 保证），setpts 同时完成重置+偏移；窗口外不产生帧。
        filters.append(f"setpts=PTS-STARTPTS+{float(window_start):.6g}/TB")
    else:
        if loop_size is not None and loop_size > 0:
            filters.append(f"loop=loop=-1:size={int(loop_size)}:start=0")

    # ----- 去水印/模糊（必须排在裁剪/旋转/缩放之前，坐标才与原始帧一致）-----
    if settings.get("blur_enabled", False):
        # 多区域列表（2026-08-26）：遍历 blur_items 生成多条；无列表时用旧单键
        blur_items = settings.get("blur_items")
        if not blur_items:
            blur_items = [{
                "enabled": True,
                "type": settings.get("blur_type", "delogo"),
                "x": str(settings.get("blur_x", "0")).strip(),
                "y": str(settings.get("blur_y", "0")).strip(),
                "w": str(settings.get("blur_w", "100")).strip(),
                "h": str(settings.get("blur_h", "100")).strip(),
                "strength": settings.get("blur_strength", "5"),
                "region_only": settings.get("blur_region_only", False),
                "enable_start": "", "enable_end": "", "enable_cycle": "", "enable_show": "",
            }]
        for _bi in blur_items:
            if not _bi.get("enabled", True):
                continue
            blur_type = str(_bi.get("type", "delogo") or "delogo").strip()
            x = str(_bi.get("x", "0")).strip() or "0"
            y = str(_bi.get("y", "0")).strip() or "0"
            w = str(_bi.get("w", "100")).strip() or "100"
            h = str(_bi.get("h", "100")).strip() or "100"
            strength = _bi.get("strength", "5")
            region_only = _bi.get("region_only", False)

            # 显示时段 / 循环控制（与文字水印同套 enable 表达式；2026-08-26 新增）
            _enable_expr = _build_drawtext_enable(_bi)
            _sfx_en = f":enable='{_enable_expr}'" if _enable_expr else ""

            if blur_type == "delogo":
                filters.append(f"delogo=x={x}:y={y}:w={w}:h={h}{_sfx_en}")
            elif blur_type in ("boxblur", "gblur"):
                if blur_type == "boxblur":
                    _blur_f = f"boxblur={strength}:{strength}{_sfx_en}"
                else:
                    _blur_f = f"gblur=sigma={strength}{_sfx_en}"
                if region_only and w and h:
                    # 局部模糊：把原帧一分为二，一路裁出目标区域做模糊，再叠回原位。
                    # 生成的是带标签的分支子图，因此本函数返回值可能含 ';'。
                    # 多条时用序号后缀避免标签冲突。
                    _sfx = graph_id or ""
                    _idx = blur_items.index(_bi) if blur_items else 0
                    _sfx += f"b{_idx}"
                    _bg, _fg, _bl = f"rb{_sfx}bg", f"rb{_sfx}fg", f"rb{_sfx}bl"
                    filters.append(
                        f"split=2[{_bg}][{_fg}];"
                        f"[{_fg}]crop={w}:{h}:{x}:{y},{_blur_f}[{_bl}];"
                        f"[{_bg}][{_bl}]overlay={x}:{y}"
                    )
                else:
                    filters.append(_blur_f)


    # ----- 遮罩 / 透明蒙版（子视频水印/画中画：矩形区域透明或保留，坐标同原始帧，排在裁剪前）-----
    if settings.get("mask_enabled", False):
        _sfx = graph_id or ""
        mx = str(settings.get("mask_x", "0")).strip() or "0"
        my = str(settings.get("mask_y", "0")).strip() or "0"
        mw = str(settings.get("mask_w", "100")).strip() or "0"
        mh = str(settings.get("mask_h", "100")).strip() or "0"
        _mode = settings.get("mask_mode", "outside")  # outside=只露矩形(矩形外透明); inside=矩形透明(矩形外正常)
        if _mode == "inside":
            # 矩形透明、矩形外正常：matte = 白底 + 黑矩形
            _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=white:t=fill,"
                     f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=black:t=fill")
        else:
            # 只露矩形（矩形外透明）：matte = 黑底 + 白矩形
            _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=black:t=fill,"
                     f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=white:t=fill")
        _a, _m, _msk = f"mk{_sfx}a", f"mk{_sfx}m", f"mk{_sfx}msk"
        filters.append(
            f"split=2[{_a}][{_m}];"
            f"[{_m}]format=gray,{_draw}[{_msk}];"
            f"[{_a}][{_msk}]alphamerge"
        )


    # ----- 裁剪 -----
    if settings.get("crop_enabled", False):
        w = settings.get("crop_width", "").strip()
        h = settings.get("crop_height", "").strip()
        left = settings.get("crop_left", "0").strip()
        top = settings.get("crop_top", "0").strip()
        if w and h:
            # 简易位置：有分段时 x/y 用按时间 t 插值的单引号表达式（QSV 不支持 → 走软件）
            # 2026-08-29：段时间=主视频原始时间，生成时自动换算输出时间线（滤镜 t）
            # 2026-08-30：画布模式已接管「动态移动」，故开启画布模式时忽略 crop_pos（避免双重位移）
            _cps = settings.get("crop_pos_segments")
            _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
            _cpos_on = bool(settings.get("crop_pos_enabled", False))
            if _cps and _cpos_on and not _canvas_on:
                try:
                    if motion_trim_start is not None:
                        _ts0 = float(motion_trim_start)
                        _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
                    else:
                        _ts0, _sp0 = _trim_speed_from_settings(settings)
                    _ex, _ey = build_crop_pos_expr(_cps, left, top,
                                                   trim_start=_ts0, speed_factor=_sp0)
                except Exception:
                    _ex = _ey = None
                if _ex and _ey:
                    filters.append(f"crop={w}:{h}:'{_ex}':'{_ey}'")
                else:
                    filters.append(f"crop={w}:{h}:{left}:{top}")
            else:
                filters.append(f"crop={w}:{h}:{left}:{top}")

    # ----- 旋转/翻转 -----
    rot = settings.get("rotate", "none")
    if rot == "90":
        filters.append("transpose=1")
    elif rot == "180":
        filters.append("transpose=2,transpose=2")
    elif rot == "270":
        filters.append("transpose=2")
    if settings.get("vflip", False):
        filters.append("vflip")
    if settings.get("hflip", False):
        filters.append("hflip")

    # ----- IVTC（反胶卷过带）-----
    # 隔行场信息在缩小后会被平均丢失，fieldmatch/decimate 需在接近原始分辨率做 → 提前到缩放前
    ivtc_enabled = enhance_settings and enhance_settings.get("ivtc_enabled", False)
    if ivtc_enabled:
        filters.append("fieldmatch,decimate")

    # ----- 反交错（仅当 IVTC 未启用时执行）-----
    # 同样提前到缩放前，保留完整场信息（缩放后反交错易拉丝/误判）
    if not ivtc_enabled:  # 添加条件
        deint = settings.get("deinterlace_filter", "none")
        # 防御：旧设置/模板可能存 bool（False/True），str 之外一律忽略，否则会被直接
        # append 进滤镜链导致 ",".join 崩溃（expected str instance, bool found）
        if isinstance(deint, str) and deint not in ("none", ""):
            filters.append(deint)

    # ----- 缩放 -----
    if force_scale is not None and isinstance(force_scale, (tuple, list)) and len(force_scale) == 2:
        # 预览强制渲染尺寸：替代调用方外部手动 scale（防双 scale）
        _fw = int(force_scale[0])
        _fh = int(force_scale[1])
        if _fw > 0 and _fh > 0:
            filters.append(f"scale={_fw}:{_fh}")
    elif include_scale and settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        w = settings.get("scale_width", "").strip()
        h = settings.get("scale_height", "").strip()
        if method == "width" and w:
            filters.append(f"scale={w}:-2")
        elif method == "height" and h:
            filters.append(f"scale=-2:{h}")
        elif method == "exact" and w and h:
            filters.append(f"scale={w}:{h}")

    # ----- 绿幕/纯色抠像（子视频水印/画中画）-----
    # 插在缩放之后 → 小图抠（性能）；且颜色校正/色相/反色在其后 → 不影响抠像。
    # 只有画中画/水印子视频传 chroma_settings（非 None 即启用抠像）；主视频/普通转码不传。
    if chroma_settings and chroma_settings.get("chroma_enabled", False):
        color = str(chroma_settings.get("chroma_color", "green") or "green")
        if color.startswith("#"):
            color = "0x" + color[1:].upper()
        try:
            similarity = float(chroma_settings.get("chroma_similarity", 0.2))
        except (ValueError, TypeError):
            similarity = 0.2
        if similarity <= 0:
            similarity = 0.00001
        try:
            blend = float(chroma_settings.get("chroma_blend", 0.1))
        except (ValueError, TypeError):
            blend = 0.1
        filter_type = str(chroma_settings.get("chroma_filter_type", "chromakey") or "chromakey")
        if filter_type == "colorkey":
            filters.append(f"format=rgb24,colorkey={color}:{similarity}:{blend}")
        else:
            filters.append(f"chromakey={color}:{similarity}:{blend}")
    
    # ----- 去块滤波（2026-08-27：强度 weak/medium/strong + 块尺寸 4/8，覆盖 HandBrake 式 strength/blocksize） -----
    if enhance_settings and enhance_settings.get("deblock_enabled", False):
        _f = str(enhance_settings.get("deblock_strength", "weak") or "weak")
        # 旧值兼容：旧字段存数值（如 4，当时作 block 用）→ 映射 weak
        if _f not in ("weak", "medium", "strong"):
            _f = "weak"
        _blk = int(enhance_settings.get("deblock_block", 4) or 4)
        if _blk not in (4, 8):
            _blk = 4
        filters.append(f"deblock=filter={_f}:block={_blk}")
    
    # ----- 降噪（2026-08-27：hqdn3d 轻量 / nlmeans 高质量，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("denoise_enabled", False):
        spatial = enhance_settings.get("denoise_spatial", 4.0)
        temporal = enhance_settings.get("denoise_temporal", 3.0)
        mode = str(enhance_settings.get("denoise_mode", "hqdn3d") or "hqdn3d")
        if mode == "nlmeans":
            # nlmeans：非局部均值，去噪强但慢（10~50×hqdn3d）；s 范围 [1-30]（实测 ffmpeg 报错确认），
            # 直接映射空间强度值并 clamp；p/pc/r/rc 保持默认
            _s = max(1.0, min(30.0, float(spatial)))
            filters.append(f"nlmeans=s={_s:.1f}:p=7:pc=3:r=5:rc=2")
        else:
            # hqdn3d 参数：空间亮度, 空间色度, 时间亮度, 时间色度
            filters.append(f"hqdn3d={spatial:.1f}:{spatial*0.75:.1f}:{temporal:.1f}:{temporal*0.75:.1f}")
    
    # ----- 锐化（2026-08-27：unsharp USM / cas 对比度自适应，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("sharpen_enabled", False):
        strength = enhance_settings.get("sharpen_strength", 1.0)
        mode = str(enhance_settings.get("sharpen_mode", "unsharp") or "unsharp")
        if mode == "cas":
            # cas：对比度自适应锐化，强度 0-5 → strength 0-1
            _s = max(0.0, min(1.0, float(strength) / 5.0))
            filters.append(f"cas=strength={_s:.2f}")
        else:
            # unsharp 参数：luma_msize_x:luma_msize_y:luma_amount:chroma_msize_x:chroma_msize_y:chroma_amount
            filters.append(f"unsharp=5:5:{strength:.2f}:5:5:{strength*0.5:.2f}")
    

    
    # ----- 色彩空间转换 -----
    if enhance_settings and enhance_settings.get("colorspace_enabled", False):
        matrix = enhance_settings.get("colorspace_matrix", "bt709:bt2020")
        filters.append(f"colormatrix={matrix}")

    # ----- 颜色校正（eq）-----
    if enhance_settings:
        eq_parts = []
        b = enhance_settings.get("eq_brightness", 0.0)
        if b != 0.0:
            eq_parts.append(f"brightness={b:.2f}")
        c = enhance_settings.get("eq_contrast", 1.0)
        if c != 1.0:
            eq_parts.append(f"contrast={c:.2f}")
        s = enhance_settings.get("eq_saturation", 1.0)
        if s != 1.0:
            eq_parts.append(f"saturation={s:.2f}")
        g = enhance_settings.get("eq_gamma", 1.0)
        if g != 1.0:
            eq_parts.append(f"gamma={g:.2f}")
        if eq_parts:
            filters.append(f"eq={':'.join(eq_parts)}")

    # ----- 色相调整（hue）-----
    if enhance_settings:
        hue_parts = []
        h_angle = enhance_settings.get("hue_angle", 0.0)
        if h_angle != 0.0:
            hue_parts.append(f"H={h_angle:.1f}")
        h_sat = enhance_settings.get("hue_saturation", 0.0)
        if h_sat != 0.0:
            hue_parts.append(f"s={h_sat:.2f}")
        if hue_parts:
            filters.append(f"hue={':'.join(hue_parts)}")

    # ----- 反色（negate）-----
    # 放在颜色校正/色相之后、像素格式之前（靠后）。绿幕 chromakey 已在缩放后插入（本函数内），
    # negate 天然在抠图之后生效，不影响抠像——子视频调用点不再需要 include_negate=False + 外部补丁。
    if include_negate and enhance_settings and enhance_settings.get("negate_enabled", False):
        filters.append("negate")


    # ----- 像素格式 -----
    if include_format and settings.get("pix_fmt_enabled", True):
        # 硬件滤镜模式下，纯硬件/混合链路在边界统一处理像素格式，不在中间插入软件 format
        if not _hw_active or not _native:
            # 遮罩启用时，本滤镜链已写入 alpha，必须用 rgba 保留透明通道
            # （否则默认的 yuv420p 会把刚生成的透明区丢掉）
            if settings.get("mask_enabled", False):
                filters.append("format=rgba")
            else:
                filters.append(f"format={settings.get('pix_fmt', 'yuv420p')}")
    
    # ----- 变速 -----
    if include_speed and settings.get("speed_enabled", False):
        try:
            factor = float(settings.get("speed_factor", "1.0"))
            if factor > 0 and factor != 1.0:
                filters.append(f"setpts={1.0/factor}*PTS")
        except ValueError:
            pass
    
    # ----- 字幕烧录（2026-08-27：支持 charenc 字符编码，解决 GBK/GB18030 中文 SRT 乱码） -----
    if include_subtitle and settings.get("subtitle_enabled", False):
        sub_path = settings.get("subtitle_path", "").strip()
        if sub_path:
            sub_path = sub_path.replace('\\', '/')
            sub_path = sub_path.replace(':', '\\:')
            sub_path = sub_path.replace("'", "\\'")
            _ch = str(settings.get("subtitle_charset", "auto") or "auto").strip().lower()
            if _ch and _ch != "auto":
                filters.append(f"subtitles='{sub_path}':charenc={_ch}")
            else:
                filters.append(f"subtitles='{sub_path}'")

    # ----- 倒放 -----
    if reverse:
        filters.append("reverse")

    # ----- 淡入淡出（片段首尾淡入黑 / 淡出黑，视频） -----
    if include_fade and settings.get("fade_enabled", False):
        fin = settings.get("fade_in", "")
        fout = settings.get("fade_out", "")
        fin_s = time_to_seconds(fin) if fin else 0.0
        fout_s = time_to_seconds(fout) if fout else 0.0
        if fin_s > 0:
            filters.append(f"fade=t=in:st=0:d={fin_s:.3f}")
        if fout_s > 0:
            if clip_duration and clip_duration > 0:
                st = max(0.0, clip_duration - fout_s)
                filters.append(f"fade=t=out:st={st:.3f}:d={fout_s:.3f}")
            # 未知时长时无法精确定位淡出起点，跳过淡出（淡入仍生效）

    filter_chain = ",".join(filters) if filters else "null"
    
    # ---------- 滤镜硬件加速（软件 / NVIDIA / Intel QSV / AMD） ----------
    filter_mode = settings.get("hw_filter_mode")
    if not filter_mode:
        # 向后兼容：旧版用 wrap_cpu_nvidia / wrap_cpu_amd 标记
        if settings.get("wrap_cpu_nvidia"):
            filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            filter_mode = "vaapi"
        else:
            filter_mode = "cpu"

    if filter_mode in ("cuda", "qsv", "vaapi"):
        device = (settings.get("hw_filter_device") or "").strip()
        # 1) 尝试把软件滤镜替换为对应硬件滤镜
        hw_filters = []
        has_software_only = False
        for f in filters:
            hf = _map_software_to_hw_filter(f, filter_mode)
            if hf is None:
                has_software_only = True
                hw_filters.append(f)
            else:
                hw_filters.append(hf)
        # 合并相邻的 vpp_qsv 滤镜为单个 VPP 实例：更高效，且确保 denoise 与 procamp 等
        # 处于同一会话（分散到多个 vpp_qsv 实例虽不报错，但 procamp 开关易失效）。
        merged = []
        for f in hw_filters:
            if merged and merged[-1].startswith("vpp_qsv=") and f.startswith("vpp_qsv="):
                merged[-1] = merged[-1] + ":" + f[len("vpp_qsv="):]
            else:
                merged.append(f)
        hw_filters = merged
        # 2) 帧是否已在显存（需开启硬件解码且解码器与该 API 匹配）
        decoder = settings.get("hwaccel_decoder", "")
        native = settings.get("hwaccel_enabled", False) and _decoder_matches_api(decoder, filter_mode)
        enc_gpu = _is_gpu_encoder(settings.get("encoder", ""))
        if native and not has_software_only and hw_filters:
            # 纯硬件链路：数据全程在显存，无需 hwdownload / hwupload
            chain = ",".join(hw_filters)
            if not enc_gpu:
                pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", True) else "nv12"
                chain = f"{chain},hwdownload,format={pix}"
            return chain
        if not native:
            # 没有硬件解码 -> 帧在内存，无法 hwdownload，退回纯软件滤镜链
            return filter_chain
        # 3) 混合链路：软件滤镜用 hwdownload 拉回内存处理，再 hwupload 回显存
        sw_chain = ",".join(filters)
        if not sw_chain or sw_chain == "null":
            # 没有软件滤镜时不生成空白包裹（hwdownload,format=nv12,,hwupload=...）
            return "null"
        up = _hwupload_token(filter_mode, device)
        if enc_gpu:
            return f"hwdownload,format=nv12,{sw_chain},{up}"
        # CPU 编码器：处理完直接留在内存，并显式指定输出像素格式
        pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", True) else "nv12"
        return f"hwdownload,format=nv12,{sw_chain},format={pix}"

    return filter_chain


def _map_software_to_hw_filter(f: str, api: str):
    """把单个软件滤镜字符串映射为硬件滤镜；无解返回 None（表示仍需软件处理）。"""
    if f.startswith("scale="):
        suffix = {"cuda": "scale_cuda", "qsv": "scale_qsv", "vaapi": "scale_vaapi"}.get(api)
        if not suffix:
            return None
        body = f[len("scale="):]
        # 硬件缩放滤镜不支持 -2（软件 scale 的「强制偶数」语法），统一换成 -1。
        # -1 = 按宽高比自动计算另一维；因旋转在缩放之前执行，此时帧已是旋转后尺寸，
        # 所以 -1 自动按当前 iw/ih 计算，天然兼容旋转（无需手动算 540/1706）。
        body = body.replace("-2", "-1")
        # 转成 w=/h= 形式以兼容硬件滤镜（如 scale_cuda=w=1280:h=720）
        if "=" not in body:
            w, h = body.split(":")
            return f"{suffix}=w={w}:h={h}"
        return f"{suffix}={body}"
    if api == "qsv":
        # 旋转/翻转：vpp_qsv 的 transpose 用字符串枚举，不是软件滤镜的数字
        # 软件 transpose=1=90°顺时针 → vpp_qsv transpose=clock
        # 软件 transpose=2=90°逆时针 → vpp_qsv transpose=cclock
        # 软件 180°(transpose=2,transpose=2) → vpp_qsv transpose=reversal
        if f == "transpose=1":
            return "vpp_qsv=transpose=clock"
        if f == "transpose=2":
            return "vpp_qsv=transpose=cclock"
        if f == "transpose=2,transpose=2":
            return "vpp_qsv=transpose=reversal"
        # 翻转（用户实测 qsv 有翻转滤镜，无需走软件包裹）
        if f == "vflip":
            return "vpp_qsv=transpose=vflip"
        if f == "hflip":
            return "vpp_qsv=transpose=hflip"
        if f.startswith("crop="):
            crop_body = f[len("crop="):]
            # 含单引号 = 动态表达式（按时间 t 插值），vpp_qsv 的 cx/cy 不支持 t，
            # 必须走软件 crop（返回 None 让混合链路 hwdownload→crop→hwupload）。
            if "'" in crop_body:
                return None
            # crop=w:h:left:top -> vpp_qsv=cw=w:ch=h:cx=left:cy=top
            parts = crop_body.split(":")
            if len(parts) == 4:
                w, h, x, y = parts
                return f"vpp_qsv=cw={w}:ch={h}:cx={x}:cy={y}"
        if f.startswith("yadif") or f.startswith("bwdif"):
            # 反交错 → vpp_qsv deinterlace（1=Bob, 2=advanced；这里用 1）
            return "vpp_qsv=deinterlace=1"
        if f.startswith("hqdn3d"):
            # 降噪 → vpp_qsv denoise（取空间亮度等级，0..100）
            try:
                lvl = float(f[len("hqdn3d="):].split(":")[0])
            except ValueError:
                lvl = 0.0
            if lvl <= 0:
                return None
            return f"vpp_qsv=denoise={lvl:.0f}"
        if f.startswith("eq="):
            # 颜色校正 → vpp_qsv procamp（无 gamma；brightness 范围 -1..1 需换算成 -100..100）
            pp = []
            for kv in f[len("eq="):].split(":"):
                if "=" not in kv:
                    continue
                k, v = kv.split("=", 1)
                if k == "brightness":
                    try:
                        pp.append(f"brightness={float(v) * 100:.0f}")
                    except ValueError:
                        pass
                elif k in ("contrast", "saturation"):
                    pp.append(f"{k}={v}")
                # gamma 在 vpp_qsv 无对应项，丢弃
            if pp:
                # 关键：vpp_qsv 的亮度/对比度/饱和度都属于 ProcAmp，总开关 procamp 默认 0（关闭），
                # 不显式写 procamp=1 则这些参数被静默忽略（表现为「不报错但无变化」）。
                return "vpp_qsv=procamp=1:" + ":".join(pp)
            return None
    return None


def _decoder_matches_api(decoder: str, api: str) -> bool:
    """判断硬件解码器是否与目标滤镜 API 匹配（帧能否直接在对应显存中）。"""
    decoder = (decoder or "").lower()
    if api == "cuda":
        return ("cuda" in decoder) or ("cuvid" in decoder)
    if api == "qsv":
        return "qsv" in decoder
    if api == "vaapi":
        return ("vaapi" in decoder) or ("amf" in decoder)
    return False


def _is_gpu_encoder(encoder: str) -> bool:
    """判断编码器是否为硬件编码器（输出帧需在显存）。"""
    if not encoder:
        return False
    if encoder in ("nvenc", "qsv", "amf", "vaapi", "videotoolbox"):
        return True
    suffixes = ("_nvenc", "_qsv", "_amf", "_vaapi", "_videotoolbox",
                "_mediacodec", "_omx", "_mfx")
    return any(encoder.endswith(s) for s in suffixes)


def _hwupload_token(api: str, device: str) -> str:
    """返回软件->硬件的上传滤镜；device 非空时显式绑定显卡设备。"""
    if api == "cuda":
        return f"hwupload_cuda=device=cu" if device else "hwupload_cuda"
    if api == "qsv":
        # QSV 上传：derive_device=qsv 显式派生 QSV 设备（等价于用户实测可用的 hwupload=qsv）。
        # extra_hw_frames=64 不能放在这里，必须放在 -init_hw_device qsv=hw,extra_hw_frames=64 中。
        return "hwupload=derive_device=qsv"
    if api == "vaapi":
        return "hwupload=extra_hw_frames=64"
    return "hwupload"

def build_preview_filter_chain(settings: Dict[str, Any], target_height: int = 960, reverse: bool = False) -> str:
    """生成预览用的滤镜链，强制缩放到指定高度"""
    enhance_settings = settings.get("enhance", {})
    preview_settings = dict(settings)
    preview_settings["hw_filter_mode"] = "cpu"  # 预览/外部播放器强制软件滤镜，避免硬件滤镜冲突
    vf = build_video_filter_chain(
        preview_settings,
        include_subtitle=True,
        include_speed=True,
        enhance_settings=enhance_settings,
        reverse=reverse
    )
    # 追加文字水印 drawtext（多条非旋转项逗号串联；旋转项需 filter_complex，-vf 预览跳过）
    _ts0, _sp0 = _trim_speed_from_settings(settings)
    dt = build_drawtext_chain_vf(settings.get("text_watermark", {}),
                                 settings.get("text_watermark_items"),
                                 trim_start=_ts0, speed_factor=_sp0)
    if dt:
        vf = f"{vf},{dt}" if vf != "null" else dt
    if vf != "null":
        return f"{vf},scale=-2:{target_height}"
    else:
        return f"scale=-2:{target_height}"

def build_atempo_chain(factor: float) -> str:
    """构建音频变速滤镜链，支持大于2倍或小于0.5倍的场景"""
    if factor <= 0 or factor == 1.0:
        return ""
    chain = []
    r = factor
    while r > 2.0:
        chain.append(2.0)
        r /= 2.0
    while r < 0.5:
        chain.append(0.5)
        r /= 0.5
    if abs(r - 1.0) > 1e-6:
        chain.append(r)
    if not chain:
        return ""
    atempo_filters = [f"atempo={v:.10f}".rstrip('0').rstrip('.') for v in chain]
    return ",".join(atempo_filters)

# ================== 文字水印 drawtext 辅助 ==================

# 常见中文字体名称 → Windows Fonts 目录下的文件名映射
CN_FONT_MAP = {
    "微软雅黑": "msyh.ttc",
    "微软雅黑 Bold": "msyhbd.ttc",
    "宋体": "simsun.ttc",
    "黑体": "simhei.ttf",
    "楷体": "simkai.ttf",
    "仿宋": "simfang.ttf",
}

def resolve_cn_font_path(font_name: str) -> str:
    """将中文字体名解析为系统字体文件完整路径，找不到返回空串。"""
    fname = CN_FONT_MAP.get(font_name, "")
    if not fname:
        return ""
    fonts_dir = os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
    return os.path.join(fonts_dir, fname)

def escape_drawtext_text(text: str) -> str:
    """转义 drawtext 的 text 参数中的特殊字符（: \\ ' , %）。
    不使用单引号包裹，纯靠 \\ 转义，FFmpeg filtergraph 和 mpv 都能正确解析。"""
    text = text.replace("\\", "\\\\")
    text = text.replace(":", "\\:")
    text = text.replace("'", "\\'")
    text = text.replace(",", "\\,")
    text = text.replace("%", "\\%")
    return text

def escape_drawtext_path(path: str) -> str:
    """
    转义 fontfile 路径中的特殊字符。
    - 统一为正斜杠。
    - 将冒号转义
    """
    path = path.replace("\\", "/")
    path = path.replace(":", "\\\\:")   # 双反斜杠 + 冒号，经测试 ffplay 和 mpv 均有效
    return path

def _build_drawtext_enable(s: dict, trim_start=0.0, speed_factor=1.0):
    """
    根据文字水印的显示时段 / 循环设置构建 drawtext 的 enable 表达式。
    返回空字符串表示始终显示。
    2026-08-29：段时间=主视频原始时间 → 换算输出时间线（滤镜 t）：
    绝对时间点(start/end)减 trim 再除 speed；周期/时长(cycle/show)只除 speed。
    预览 settings 已禁用 trim → 不换算。
    """
    def _f(v):
        v = (v or "").strip()
        if v == "":
            return None
        try:
            return float(v)
        except (ValueError, TypeError):
            return None
    _ts = float(trim_start or 0.0)
    try:
        _sp = float(speed_factor or 1.0)
    except (ValueError, TypeError):
        _sp = 1.0
    if _sp <= 0:
        _sp = 1.0
    start = _f(s.get("enable_start"))
    end = _f(s.get("enable_end"))
    cycle = _f(s.get("enable_cycle"))
    show = _f(s.get("enable_show"))
    if _ts != 0.0 or _sp != 1.0:
        # 绝对时间点：统一换算（减 trim、除 speed、clamp≥0）；周期/时长只除 speed
        if start is not None:
            start, _du = _timeline_convert(start, 0.0, _ts, _sp)
        if end is not None:
            end, _du = _timeline_convert(end, 0.0, _ts, _sp)
        if cycle is not None:
            cycle = cycle / _sp
        if show is not None:
            show = show / _sp
    if start is not None and end is not None and end > start:
        return f"between(t,{start:.3f},{end:.3f})"
    if cycle is not None and show is not None and cycle > 0 and show > 0:
        return f"lt(mod(t,{cycle:.3f}),{show:.3f})"
    if start is not None:
        return f"gte(t,{start:.3f})"
    if end is not None:
        return f"lte(t,{end:.3f})"
    return ""

def build_drawtext_filter(tw_settings: dict, trim_start=0.0, speed_factor=1.0):
    """
    根据文字水印设置构建 drawtext 滤镜字符串。
    返回空字符串表示无需添加。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    text = tw_settings.get("text", "").strip()
    if not text:
        return ""
    font_name = tw_settings.get("font_name", "微软雅黑")
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    try:
        font_size = int(tw_settings.get("font_size", 48))
    except (ValueError, TypeError):
        font_size = 48
    color = tw_settings.get("font_color", "#FFFFFF")
    try:
        opacity = float(tw_settings.get("opacity", 1.0))
    except (ValueError, TypeError):
        opacity = 1.0
    opacity = max(0.0, min(1.0, opacity))
    x_expr = tw_settings.get("overlay_x", "10").strip() or "10"
    y_expr = tw_settings.get("overlay_y", "10").strip() or "10"
    # 动态轨迹（与图片/视频水印同套逻辑；文字尺寸用 tw/th，主画布用 main_w/main_h）
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    if _mv == "waypoints":
        # 列表轨迹：画布绝对像素（数字），drawtext x/y 表达式含 t 每帧求值
        _wpr = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                   trim_start=trim_start, speed_factor=speed_factor)
        if _wpr is not None and _wpr[0] is not None:
            x_expr, y_expr = _wpr[0], _wpr[1]
    elif _mv:
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
        if _mx is not None:
            # drawtext 表达式环境不提供 W/H 别名，用 main_w/main_h 表示主画布
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    try:
        border_w = int(tw_settings.get("border_w", 0))
    except (ValueError, TypeError):
        border_w = 0
    border_color = tw_settings.get("border_color", "#000000")

    fc = color.lstrip("#")
    fontcolor = f"0x{fc}@{opacity:.2f}"

    parts = [
        f"fontfile={escape_drawtext_path(font_path)}",
        f"text={escape_drawtext_text(text)}",
        f"fontsize={font_size}",
        f"fontcolor={fontcolor}",
        f"x='{x_expr.replace(chr(39), chr(92)+chr(39))}'",
        f"y='{y_expr.replace(chr(39), chr(92)+chr(39))}'",
    ]
    if border_w > 0:
        bc = border_color.lstrip("#")
        parts.append(f"borderw={border_w}")
        parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
    # 显示时段 / 循环控制 (enable 表达式)
    enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                         speed_factor=speed_factor)
    if enable_expr:
        parts.append(f"enable='{enable_expr}'")
    return "drawtext=" + ":".join(parts)


def build_drawtext_chain_vf(tw_settings, tw_items=None, trim_start=0.0, speed_factor=1.0) -> str:
    """构建 -vf 可用的多条 drawtext 逗号串（仅非旋转项）。

    2026-08-26：普通预览（ffplay/SimplePreviewer 的 -vf 链）此前只渲染第一条文字水印。
    多条 drawtext 在 -vf 里可以用逗号链式串联（ffmpeg 支持），旋转/spin 项需要
    filter_complex 子图（color 源 + rotate + overlay），-vf 无法表达 → 跳过（完整合成
    与 mpv 实时预览仍走 build_text_watermark_chain，旋转项不受影响）。
    2026-08-29：trim_start/speed_factor 透传给 build_drawtext_filter（显示时段/轨迹时间
    =主视频原始时间，生成时换算输出时间线）。"""
    if tw_items is None:
        tw_items = [tw_settings]
    elif isinstance(tw_items, list) and not tw_items:
        tw_items = [tw_settings]
    parts = []
    for it in tw_items:
        if not it.get("enabled", True):
            continue
        if not str(it.get("text", "") or "").strip():
            continue
        if text_watermark_needs_subgraph(it):
            continue  # 旋转/spin 无法进 -vf → 跳过
        d = build_drawtext_filter(it, trim_start=trim_start, speed_factor=speed_factor)
        if d:
            parts.append(d)
    return ",".join(parts)


def estimate_text_size(text: str, font_path: str, font_size: int) -> Tuple[int, int]:
    """
    估算文字水印的像素宽高 (tw, th)，用于旋转时裁剪出贴合文字的透明层。
    纯 Python 标准库实现（不依赖 PIL）：
    - 全角区（CJK 等，U+2E80 起）按 1.0 × font_size 计宽；
    - ASCII 可打印按 0.6 × font_size 计宽（略偏大，宁可裁大不裁字）；
    - 其余半角扩展（拉丁扩展/希腊/西里尔等）按 0.9 × font_size 计宽；
    - 行高 = font_size × 1.2；多行取最大行宽。
    估算偏保守（偏大），旋转时 crop 包围盒还含 ±8px 内边距，实际不会裁到字。
    """
    try:
        fs = int(font_size)
    except (ValueError, TypeError):
        fs = 48
    if fs <= 0:
        fs = 48
    lines = (text or "").split("\n")
    th = int(fs * 1.2) * max(1, len(lines))
    tw = 0
    for line in lines:
        w = 0.0
        for ch in (line or " "):
            o = ord(ch)
            if o >= 0x2E80:          # CJK 及全角区（含中文/日韩/注音等）
                w += fs * 1.0
            elif o <= 0x7E:          # ASCII 可打印（含空格）
                w += fs * 0.6
            else:                    # 其余半角扩展字符
                w += fs * 0.9
        if int(w) > tw:
            tw = int(w)
    return max(tw, fs), th


def build_preview_border_frag(eh) -> str:
    """末端边框 → pad 滤镜片段（预览路径共用，iw/ih 表达式，无需知道绝对尺寸）。
    返回 'pad=trunc((iw+L+R+1)/2)*2:trunc((ih+T+B+1)/2)*2:L:T:color=C' 或 ''（未启用/全 0 边距）。
    与正式命令 _apply_end_handling_cmd 的 pad 注入同构（#RRGGBB→0xRRGGBB、颜色名透传、trunc 偶数化）。
    播放预览（-vf/lavfi-complex）、快照（filter_complex）、封装实时预览（lavfi-complex）三处共用。"""
    if not eh:
        return ""
    if not eh.get("border_enabled", False):
        return ""
    try:
        t = max(0, int(eh.get("border_top", 0) or 0))
        b = max(0, int(eh.get("border_bottom", 0) or 0))
        l = max(0, int(eh.get("border_left", 0) or 0))
        r = max(0, int(eh.get("border_right", 0) or 0))
    except (ValueError, TypeError):
        return ""
    if t + b + l + r <= 0:
        return ""
    _bc = (eh.get("border_color", "") or "").strip()
    if re.fullmatch(r"#[0-9a-fA-F]{6}", _bc):
        _pad_c = "0x" + _bc[1:].upper()
    else:
        _pad_c = _bc if _bc else "black"
    return (f"pad=trunc((iw+{l}+{r}+1)/2)*2:trunc((ih+{t}+{b}+1)/2)*2:"
            f"{l}:{t}:color={_pad_c}")


def build_end_split_filters(rows: int, cols: int, in_label: str = "[v_in]", out_label: str = "[v_out]") -> str:
    """
    末端多画面拼接滤镜：把输入视频流 split 成 rows×cols 份拼接成网格。
    返回 filter_complex 片段字符串（以 in_label 开头、out_label 结尾），总格数 = rows*cols（限制 2-5）。

    - 行=1（列>1）→ 横排：split=N + hstack=inputs=N
    - 列=1（行>1）→ 竖排：split=N + vstack=inputs=N
    - 行>1 且列>1 → 网格：每行先 hstack，再把各行 vstack
      例 2×2：split=4[v1][v2][v3][v4];[v1][v2]hstack=inputs=2[top];[v3][v4]hstack=inputs=2[bottom];[top][bottom]vstack=inputs=2[vo]
    """
    rows = max(1, int(rows or 1))
    cols = max(1, int(cols or 1))
    n = rows * cols
    if n < 2 or n > 5:
        n = max(2, min(5, n))
        # 重新折算：若行=1 保持 n 列；列=1 保持 n 行；否则 2×2
        if rows == 1:
            cols = n
        elif cols == 1:
            rows = n
        else:
            rows, cols = 2, 2
            n = 4
    # 标签用独特前缀（sp/sr）避免与调用方既有 filtergraph 标签冲突
    labels = [f"[sp{i}]" for i in range(n)]
    parts = [f"{in_label}split={n}{''.join(labels)}"]
    if rows == 1:
        # 横排
        parts.append(f"{''.join(labels)}hstack=inputs={n}{out_label}")
    elif cols == 1:
        # 竖排
        parts.append(f"{''.join(labels)}vstack=inputs={n}{out_label}")
    else:
        # 网格：每行 hstack 再整体 vstack
        row_labels = []
        for r in range(rows):
            row_lbl = f"[sr{r}]"
            row_in = "".join(labels[r * cols:(r + 1) * cols])
            parts.append(f"{row_in}hstack=inputs={cols}{row_lbl}")
            row_labels.append(row_lbl)
        parts.append(f"{''.join(row_labels)}vstack=inputs={rows}{out_label}")
    return ";".join(parts)


def build_end_concat_filters(tail_path: str, tail_sec: float,
                             in_label: str = "[v_in]", tail_label: str = "[tail]",
                             out_label: str = "[v_out]",
                             main_w: int = 1280, main_h: int = 720, fps: float = 30.0,
                             main_dur: float = 0.0) -> str:
    """
    末端 concat 图片/视频滤镜：把一段图片（显示 tail_sec 秒）或视频接到主视频末尾。

    - 图片：输入是 `-loop 1 -framerate {fps} -t {tail_sec} -i {tail_path}`（有限时长流），
      滤镜：scale 保持比例适配 main_w×main_h（不足则 pad 黑底居中）+ fps 对齐 + format + setpts 归零。
    - 视频：输入是 `-i {tail_path}`，同样 scale/pad 适配输出尺寸后 concat。

    tail_label：尾部素材在 filter_complex 中的输入标签（调用方指定，如 [1:v]）。
    main_dur > 0 时：在 concat 前给主链强制 trim=0:{main_dur} 收尾——
      解决画中画 overlay 默认 eof_action=repeat 导致主视频结束后定格、子视频无限循环、
      concat 永远等不到主链结束的问题（主链必须显式结束才能切换到尾部素材）。
    返回 filter_complex 片段（以 tail 链开头、out_label 结尾）：
      [tail_label]scale=...pad=...[v_tail];[in_label]trim=0:D,setpts=PTS-STARTPTS[v_main_trim];[v_main_trim][v_tail]concat=n=2:v=1:a=0[out]
    注意：调用方负责在命令里为 tail 流添加额外输入（-loop 1 ... -i 或 -i）。
    """
    if not tail_path or not os.path.exists(tail_path):
        return ""
    # 图片/视频统一走 scale 保持比例 + pad 黑底居中（图片小或用户 scale 后仍小于输出尺寸时自动黑边居中）
    tail_chain = (
        f"{tail_label}scale={main_w}:{main_h}:force_original_aspect_ratio=decrease,"
        f"pad={main_w}:{main_h}:(ow-iw)/2:(oh-ih)/2:black,"
        f"setsar=1,fps={fps:.6f}".rstrip('0').rstrip('.') + ","
        f"format=yuv420p,setpts=PTS-STARTPTS[v_tail]"
    )
    # 主链强制收尾：overlay 默认 eof_action=repeat（主视频结束后定格最后一帧、子视频继续循环），
    # 不加 trim 时主链永不结束，concat 永远不切换到尾部素材（只能靠 -t 截断 = 定格+子视频循环）。
    if main_dur and main_dur > 0:
        main_trim = f"{in_label}trim=0:{main_dur:.3f},setpts=PTS-STARTPTS[v_main_trim];"
        concat_in = "[v_main_trim]"
    else:
        main_trim = ""
        concat_in = in_label
    # concat 只拼视频（v=1:a=0），音频保持主视频原样；尾部图片段无音频（静音），
    # 视频段自带音频会被 concat 丢弃（与"只拼视频"语义一致）。
    return f"{tail_chain};{main_trim}{concat_in}[v_tail]concat=n=2:v=1:a=0{out_label}"


def build_text_watermark_filtergraph(tw_settings: dict, main_label: str = "", out_label: str = "[v_tw]",
                                     trim_start=0.0, speed_factor=1.0):
    """
    构建文字水印的 filter_complex 片段（或单节点 drawtext）。

    - 未启用/无效 → 返回 ""
    - 未启用旋转与持续旋转 → 返回 f"{main_label}drawtext=...{out_label}"
      （等价于原 build_drawtext_filter 直接作用于主视频；main_label 为空则用隐式输入）
    - 启用旋转（rotate≠0）或持续旋转（spin_enabled）→ 返回「透明层(color来自主视频alpha清零)
      + drawtext(居中) + rotate(静态角度，可选) + rotate(持续旋转 angle=转速*PI/180*t，可选) + overlay」
      的子图，主视频输入用 main_label（为空则隐式输入，适用预览 lavfi/-filter_complex），
      以 out_label 结尾。调用方负责把该片段接入总 filter_complex（用 ; 分隔，并把 out_label 作为后续视频标签）。

    设计要点：FFmpeg drawtext 原生不支持旋转，故旋转时把文字画到一块透明层上、
    用 rotate 绕文字自身中心旋转、再 overlay 回主视频（与图片/视频水印 rotate 思路一致）。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    text = tw_settings.get("text", "").strip()
    if not text:
        return ""
    font_name = tw_settings.get("font_name", "微软雅黑")
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    try:
        font_size = int(tw_settings.get("font_size", 48))
    except (ValueError, TypeError):
        font_size = 48
    color = tw_settings.get("font_color", "#FFFFFF")
    try:
        opacity = float(tw_settings.get("opacity", 1.0))
    except (ValueError, TypeError):
        opacity = 1.0
    opacity = max(0.0, min(1.0, opacity))
    x_expr = (tw_settings.get("overlay_x", "10") or "10").strip() or "10"
    y_expr = (tw_settings.get("overlay_y", "10") or "10").strip() or "10"

    def _dt_parts(xv, yv):
        parts = [
            f"fontfile={escape_drawtext_path(font_path)}",
            f"text={escape_drawtext_text(text)}",
            f"fontsize={font_size}",
            f"fontcolor=0x{color.lstrip('#')}@{opacity:.2f}",
            f"x='{xv.replace(chr(39), chr(92) + chr(39))}'",
            f"y='{yv.replace(chr(39), chr(92) + chr(39))}'",
        ]
        try:
            bw = int(tw_settings.get("border_w", 0))
        except (ValueError, TypeError):
            bw = 0
        if bw > 0:
            bc = (tw_settings.get("border_color", "#000000") or "#000000").lstrip("#")
            parts.append(f"borderw={bw}")
            parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
        enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                             speed_factor=speed_factor)
        if enable_expr:
            parts.append(f"enable='{enable_expr}'")
        return ":".join(parts)

    rotate = tw_settings.get("rotate", 0)
    try:
        rotate = float(rotate)
    except (ValueError, TypeError):
        rotate = 0.0

    # 持续旋转（spin）：绕中心匀速转（angle=转速*PI/180*t），与图片/视频水印同款；
    # 静态旋转（rotate）与 spin 可叠加：先静态转，再持续转。
    spin_on = bool(tw_settings.get("spin_enabled", False))
    sp = tw_settings.get("spin_speed", 60.0)
    try:
        sp = float(sp)
    except (ValueError, TypeError):
        sp = 60.0
    # 列表轨迹（waypoints）：x/y + 分段自旋转 + 到期行为统一由 build_waypoint_expr 生成；
    # 列表存在自旋转段 → needs_rot=True（走旋转子图），且列表自旋转覆盖全局 spin。
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    _wp_res_tw = None
    _wp_rot_tw = False
    if _mv == "waypoints":
        _wp_res_tw = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                         spin_speed=sp,
                                         trim_start=trim_start, speed_factor=speed_factor)
        _wp_rot_tw = (_wp_res_tw is not None and _wp_res_tw[2] is not None)
    needs_rot = rotate != 0 or (spin_on and sp != 0) or _wp_rot_tw

    # 动态轨迹（move）：旋转时子层尺寸用裁剪后的文字包围盒（含 padding）做钳制；
    # 非旋转时沿用 drawtext 的 tw/th 变量（与原 build_drawtext_filter 行为一致）。
    if not needs_rot:
        if _mv == "waypoints":
            if _wp_res_tw is not None and _wp_res_tw[0] is not None:
                x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
        elif _mv:
            _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
            if _mx is not None:
                x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
                y_expr = _my.replace("W", "main_w").replace("H", "main_h")
        dt = "drawtext=" + _dt_parts(x_expr, y_expr)
        return f"{main_label}{dt}{out_label}" if main_label else f"{dt}{out_label}"

    # ---- 旋转：透明层 + drawtext(居中) + rotate(静态/spin) + overlay ----
    tw, th = estimate_text_size(text, font_path, font_size)
    pad = 8
    tw2 = tw + 2 * pad
    th2 = th + 2 * pad
    # 持续旋转时 overlay 画布 = 对角线正方形（rotate ow/oh=hypot），钳制用该边长；
    # 仅静态旋转时钳制用 crop 包围盒尺寸。
    _clamp = int((tw2 * tw2 + th2 * th2) ** 0.5) if ((spin_on and sp != 0) or _wp_rot_tw) else tw2
    if _mv == "waypoints":
        if _wp_res_tw is not None and _wp_res_tw[0] is not None:
            x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
    elif _mv:
        # 用裁剪后的包围盒尺寸（字面量）做钳制，避免旋转后越界
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw=str(_clamp), sh=str(_clamp))
        if _mx is not None:
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    ml = main_label if main_label else ""
    # 透明层用独立 color 源（按 crop 尺寸 tw2×th2），不再 fork ml。
    # ⚠️ 关键：原先用 {ml}format=rgba,colorchannelmixer=aa=0[tw_bg] 时，ml（带图片水印的画布）被
    # format=rgba 强制全局转 rgba，最终 overlay 把图片水印内容弄丢。
    # 改用独立 color 源后，ml 只在最终 overlay 作为背景出现，画布内容完整保留。
    base_node = f"color=c=black@0:s={tw2}x{th2}:d=999999"
    dt_core = "drawtext=" + _dt_parts(str(pad), str(pad))
    crop_node = f"crop={tw2}:{th2}:0:0"
    rot_parts = []
    _cur = "[tw_crop]"
    if rotate != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{rotate}*PI/180':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_r1]")
        _cur = "[tw_r1]"
    if _wp_rot_tw:
        # 列表自旋转覆盖全局 spin（仅列表标记的自旋转时段旋转，边移边转）
        rot_parts.append(
            f"{_cur}rotate=angle='({_wp_res_tw[2]})':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    elif spin_on and sp != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{sp}*PI/180*t':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    # 中心对齐（2026-09-03 问题①修复）：rotate 输出 d×d（hypot(tw2,th2)）正方形画布，
    # 而 overlay_x/y 语义=内容盒（tw2×th2，含 pad）左上角（2026-08-26 铁律）→
    # 叠加盒左上角 = 内容盒左上角 − (d−tw2)/2、(d−th2)/2。缺失该减量时整块被向右下
    # 推移 (d−tw2)/2、(d−th2)/2，自旋转中心比预期低很多（与子视频 _content_box_shift
    # 中心对齐、图片水印 L18879 同源）。静态 rotate/spin/列表自旋转共用此 overlay。
    _rot_d = (tw2 * tw2 + th2 * th2) ** 0.5
    _ov_dx, _ov_dy = _content_box_shift(tw2, th2, _rot_d, _rot_d)
    ov_node = f"overlay=x='({x_expr}) - {_ov_dx:.6g}':y='({y_expr}) - {_ov_dy:.6g}':format=auto"
    frag = ";".join([
        f"{base_node}[tw_bg]",
        f"[tw_bg]{dt_core}[tw_full]",
        f"[tw_full]{crop_node}[tw_crop]",
    ] + rot_parts + [f"{ml}{_cur}{ov_node}{out_label}"])
    return frag


def build_text_watermark_chain(tw_input, main_label: str = "", out_label: str = "[v_tw]") -> str:
    """多个文字水印链式生成（2026-08-26）。

    tw_input: 完整 settings（含 text_watermark_items / text_watermark）或单条 tw dict。
    - 完整 settings 且有 text_watermark_items → 遍历启用项逐个调用 build_text_watermark_filtergraph，
      out_label 逐级串联（第 k 项输出接第 k+1 项输入）；
    - 无 items → 退化为单条（text_watermark 或 tw_input 本身），行为与旧版一致。
    """
    if isinstance(tw_input, dict) and ("text_watermark_items" in tw_input or "text_watermark" in tw_input):
        items = tw_input.get("text_watermark_items")
        if not items:
            items = [tw_input.get("text_watermark") or {}]
    else:
        items = [tw_input or {}]
    active = [i for i in items
              if i.get("enabled", True) and str(i.get("text", "")).strip()]
    if not active:
        return ""
    # 2026-08-29：tw_input=完整主视频 settings 时取 trim/speed 换算输出时间线
    # （文字水印显示时段/列表轨迹时间=主视频原始时间）；预览 settings 已禁用 trim → 不换算
    _ts, _sp = _trim_speed_from_settings(tw_input)
    cur_in = main_label
    frags = []
    for k, tw in enumerate(active):
        out = out_label if k == len(active) - 1 else f"[v_tw{k}]"
        f = build_text_watermark_filtergraph(tw, main_label=cur_in, out_label=out,
                                             trim_start=_ts, speed_factor=_sp)
        if f:
            frags.append(f)
            cur_in = out
    return ";".join(frags)


def text_watermark_needs_subgraph(tw_settings) -> bool:
    """文字水印是否需要「透明层 + rotate + overlay」子图：静态旋转(rotate≠0)或持续旋转(spin)任一启用。
    ⚠️ 必须与 build_text_watermark_filtergraph 内部的 needs_rot 判定逐字一致——
    各调用点用它决定走 -filter_complex 子图还是普通 -vf drawtext。
    曾因漏查 spin_enabled，导致「只开自旋转、旋转角度=0」时走了普通 drawtext 路径而不转。"""
    if not tw_settings:
        return False
    try:
        rot = float(tw_settings.get("rotate", 0) or 0) != 0
    except (ValueError, TypeError):
        rot = False
    spin = bool(tw_settings.get("spin_enabled", False))
    try:
        sp = float(tw_settings.get("spin_speed", 0) or 0)
    except (ValueError, TypeError):
        sp = 0.0
    if rot or (spin and sp != 0):
        return True
    # 列表轨迹：存在自旋转段 → 需要旋转子图（判定须与 build_text_watermark_filtergraph 一致）
    if (tw_settings.get("move_mode") or "") == "waypoints":
        try:
            _wpr = build_waypoint_expr(tw_settings.get("move_waypoints"), spin_speed=sp)
            if _wpr is not None and _wpr[2] is not None:
                return True
        except Exception:
            pass
    return False


def text_watermark_active(tw_settings) -> tuple:
    """文字水印是否生效 + 是否需要走旋转子图。返回 (enabled, needs_subgraph)。

    - enabled         = 开启且文字非空
    - needs_subgraph  = enabled 且 (静态旋转 rotate≠0 或 持续旋转 spin_enabled)

    ⚠️ 各命令生成点用它一次性算出 _tw_enabled / _tw_rotate，避免「启用判定」
    与 text_watermark_needs_subgraph 在各处重复书写而漂移。"""
    enabled = bool(tw_settings.get("enabled")) and bool((tw_settings.get("text", "") or "").strip())
    return enabled, (enabled and text_watermark_needs_subgraph(tw_settings))


def _ensure_tw_duration_limit(app, cmd_list, *, input_path=None, main_duration=None,
                              audio_enabled=True, tag="[文字水印]"):
    """文字水印旋转/持续旋转(spin)时，build_text_watermark_filtergraph 使用
    color=c=black@0:s=WxH:d=999999 的无限时长透明源；若命令尚未加任何时长限制，
    必须补上时长限制，否则输出会被无限拉长到 999999s（甚至卡死）。

    时长限制策略（经真实 ffmpeg 验证）：
    - 主视频【有音频】且音频输出启用 → 用 -shortest（音频为有限流，可正确截断；
      实测无音频时 -shortest 对 color 无限源会卡死/不截断，故无音频绝不用 -shortest）。
    - 主视频【无音频】或音频禁用 → 必须用 -t 精确截断：优先用调用方传入的 main_duration，
      否则尝试探测主视频时长；两者皆无才无奈回退 -shortest（可能卡，但总比无限输出好）。

    非旋转文字水印（drawtext）不带无限源，命令里不含 color=c=black@0 标记会自动跳过，
    不影响正常有界输出。模块级辅助，app 传入调用方实例（需 _get_cached_stream_info /
    _get_media_duration / _append_info_ui）。只就地 append 到 cmd_list。"""
    # 仅当命令确实包含文字水印的无限透明源时才需要限制
    if not any("color=c=black@0" in str(a) for a in cmd_list):
        return
    # 已有限制（trim 自带 -t、或别处已加 -shortest）则跳过，避免重复
    if "-shortest" in cmd_list or "-t" in cmd_list:
        return
    has_audio_stream = False
    if input_path and os.path.exists(input_path):
        info = app._get_cached_stream_info(input_path)
        if info and any(s.get("codec_type") == "audio"
                        for s in info.get("streams", [])):
            has_audio_stream = True
    # 有音频：优先 -shortest（音频有限流可正确截断）
    if audio_enabled and has_audio_stream:
        cmd_list.append("-shortest")
        return
    # 无音频 / 音频禁用：必须用 -t 精确截断，避免 -shortest 对 color 无限源卡死
    eff = main_duration
    # 静态图片主视频：无真实时长概念（ffprobe 对图片常返回 N/A 或 0.04 等小值），
    # 统一按默认 10s 处理（与 merge_build_cmd_list 的图片默认时长逻辑一致），
    # 避免文字水印旋转/spin 触发的时长限制把 -t 干扰成 -t 0.040。
    if input_path and os.path.exists(input_path) and \
            os.path.splitext(input_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
        eff = 10.0
    elif not (eff and eff > 0) and input_path and os.path.exists(input_path):
        try:
            eff = app._get_media_duration(input_path)
        except Exception:
            eff = None
    if eff and eff > 0:
        cmd_list.extend(["-t", f"{eff:.3f}"])
    else:
        # 兜底：连时长都算不出，退 -shortest（可能卡，但总比无限输出好）
        cmd_list.append("-shortest")
        try:
            app._append_info_ui(
                f"{tag} 警告：无法计算主视频时长，使用 -shortest 控制输出。")
        except Exception:
            pass


# ================== 视频尺寸计算 ==================
def get_video_dimensions(ffprobe_cmd: str, file_path: str) -> Tuple[Optional[int], Optional[int]]:
    """获取视频原始宽高（不考虑旋转）"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None, None
    cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
           "-show_entries", "stream=width,height", "-of", "csv=p=0", file_path]
    try:
        flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
        if result.returncode == 0 and ',' in result.stdout.strip():
            w_str, h_str = result.stdout.strip().split(',')
            return int(w_str), int(h_str)
    except:
        pass
    return None, None

def get_video_rotated_dimensions(ffprobe_cmd: str, file_path: str, settings: Dict[str, Any]) -> Tuple[Optional[int], Optional[int]]:
    """获取考虑元数据旋转和用户旋转后的尺寸"""
    w, h = get_video_dimensions(ffprobe_cmd, file_path)
    if w is None:
        return None, None
    # 检测元数据旋转
    if ffprobe_cmd:
        cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
               "-show_entries", "stream=side_data_list", "-of", "json", file_path]
        try:
            flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
            result = subprocess.run(cmd, capture_output=True, text=True,
                                    timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
            if result.returncode == 0:
                data = json.loads(result.stdout)
                streams = data.get("streams", [])
                if streams:
                    side_data = streams[0].get("side_data_list", [])
                    for sd in side_data:
                        if sd.get("rotation") is not None:
                            rot = int(sd.get("rotation"))
                            if rot % 180 == 90:
                                w, h = h, w
                            break
        except:
            pass
    # 用户旋转
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    return w, h

def compute_rendered_size(original_w: int, original_h: int, settings: Dict[str, Any]) -> Tuple[int, int]:
    """根据设置（裁剪、旋转、缩放）计算最终渲染尺寸"""
    w, h = original_w, original_h

    # --- 防御性检查，避免除零 ---
    if w == 0 or h == 0:
        return 0, 0

    # 裁剪
    if settings.get("crop_enabled", False):
        crop_w = settings.get("crop_width", "").strip()
        crop_h = settings.get("crop_height", "").strip()
        if crop_w and crop_h:
            def eval_crop(expr):
                if not expr:
                    return None
                expr2 = expr.replace('iw', str(w)).replace('ih', str(h))
                result = safe_eval_expr(expr2, {})
                return result if result is not None else None
            cw = eval_crop(crop_w)
            ch = eval_crop(crop_h)
            if cw and ch and cw > 0 and ch > 0:
                w, h = cw, ch
    # 用户旋转（2026-08-29 补：rotate 90/270 交换宽高，与 compute_final_size_with_order
    # 的 crop→rotate→scale 顺序一致——原版漏 rotate，主视频旋转时文字水印画布宽高
    # 不交换=「编辑框尺寸没旋转但背景帧(transpose)转了」错位）
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    # 缩放
    if settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        sw = settings.get("scale_width", "").strip()
        sh = settings.get("scale_height", "").strip()
        try:
            if method == "width" and sw:
                target_w = int(float(sw))
                target_h = int(round(target_w * h / w))
                w, h = target_w, target_h
            elif method == "height" and sh:
                target_h = int(float(sh))
                target_w = int(round(target_h * w / h))
                w, h = target_w, target_h
            elif method == "exact" and sw and sh:
                w, h = int(float(sw)), int(float(sh))
        except:
            pass
    return w, h


def _blend_move_exprs(mode, move_settings=None, sw="w", sh="h"):
    """为 blend 动态区域构造【双轴】轨迹表达式（overlay 版 W/H/w/h；crop 版由调用方 W/H→iw/ih）。

    ⚠️ 2026-08-24 实测纠错：crop 的 x/y 表达式【支持】逗号函数与状态变量
    （min/max/mod/lt/gte/st/ld/分号全可用，ffmpeg 8.1 六项实验全过）——旧认知
    "crop 不支持逗号函数"是当年实测误判。因此 h/v/diamond/corners 所有轨迹均可
    blend 动态跟随（"走到哪混到哪"），不再有仅 h/v 的限制。
    表达式基于 build_move_xy_expr（含 min/max 夹紧到画布内），sw/sh 传区域尺寸数字。
    返回 (x_expr, y_expr)；mode 不支持返回 (None, None)。"""
    ms = move_settings or {}
    if mode not in ("h", "v", "diamond", "corners"):
        return None, None
    x0 = str(ms.get("overlay_x", "0") or "0")
    y0 = str(ms.get("overlay_y", "0") or "0")
    return build_move_xy_expr(mode, x0, y0, ms, sw=str(sw), sh=str(sh))


def _blend_crop_exprs(x_expr, y_expr, bw, bh):
    """动态轨迹 blend 的 crop 版表达式：W/H→iw/ih + 独立 w/h→区域尺寸数字。
    crop 表达式环境只有 iw/ih（无 W/H/w/h 变量）；overlay_x/y 基准可能含 "W-w-10" 等。
    正则 \bw\b/\bh\b 只匹配独立变量，不会误伤 iw/ih 里的 w/h（前接 i 非单词边界）。
    返回 (x_crop, y_crop)。正式命令 / 合并页预览 / 转换页预览 三处共用，勿复制粘贴。"""
    def _conv(e):
        e = e.replace("W", "iw").replace("H", "ih")
        e = re.sub(r"\bw\b", str(bw), e)
        e = re.sub(r"\bh\b", str(bh), e)
        return e
    return _conv(x_expr), _conv(y_expr)


def _blend_region_size(w, h, rotated):
    """blend 区域尺寸：旋转（自旋转/静态角度）时用对角线 d=round(hypot(w,h))（需求2：
    不切旋转内容，与正式命令 _overlay_sub_size 一致）；非旋转用渲染尺寸。偶数化 + min 2。
    正式命令 / 合并页预览 / 转换页预览 三处共用，勿复制粘贴。"""
    if rotated:
        d = int(round(((w * w + h * h) ** 0.5)))
        bw = bh = d
    else:
        bw, bh = int(w), int(h)
    if bw % 2:
        bw -= 1
    if bh % 2:
        bh -= 1
    return max(2, bw), max(2, bh)


def _content_box_expr(expr, w, h):
    """把位置表达式里的独立 \bw\b/\bh\b 替换为内容盒尺寸数字。

    旋转时 overlay 的 w/h 变量 = 旋转画布 d×d（overlay 输入尺寸），而 overlay_x/y
    （如 "W-w-10"）的语义是**内容盒**（未旋转 w×h）→ 求值前必须替换，否则内容整体
    偏移 (d-w)/2。正则 \bw\b 不会误伤 iw/ih/ow/oh 里的 w/h（前接 i/o 非单词边界）。
    与 _blend_crop_exprs 的 _conv 同一策略，勿复制粘贴。"""
    e = re.sub(r"\bw\b", str(w), str(expr))
    e = re.sub(r"\bh\b", str(h), e)
    return e


def _content_box_shift(content_w, content_h, box_w, box_h):
    """旋转中心对齐偏移：内容盒（未旋转 w×h）→ 叠加盒（旋转画布 d×d 或 clamp 后区域）
    的定位偏移。叠加盒与内容盒中心重合 → 叠加盒左上角 = 内容盒左上角 - (box-w)/2。
    非旋转时 box=内容盒 → 返回 (0,0)。"""
    return (box_w - content_w) / 2.0, (box_h - content_h) / 2.0


def _pad_canvas_geometry(main_settings) -> Optional[Tuple[int, int, str, str]]:
    """提取 pad 画布几何：返回 (pad_w, pad_h, offset_x, offset_y) 或 None（未启用/无效）。
    正式命令 + 转换页预览 + 合并页预览三处共用，避免 pad 判定分叉。"""
    if not main_settings.get("pad_enabled", False):
        return None
    pw = (main_settings.get("pad_width", "") or "").strip()
    ph = (main_settings.get("pad_height", "") or "").strip()
    if not pw or not ph:
        return None
    try:
        cw, ch = int(float(pw)), int(float(ph))
        if cw <= 0 or ch <= 0:
            return None
    except (ValueError, TypeError):
        return None
    ox = (main_settings.get("offset_x", "0") or "0").strip() or "0"
    oy = (main_settings.get("offset_y", "0") or "0").strip() or "0"
    return cw, ch, ox, oy

# ================== 子进程执行封装 ==================
def run_ffmpeg_command(cmd: List[str], on_output_line: Optional[Callable] = None, timeout: Optional[float] = None) -> Tuple[int, str]:
    """
    执行 FFmpeg 命令，实时输出行。返回 (返回码, 完整stderr文本)
    cmd: 列表形式的命令参数
    """
    full_output = []
    try:
        proc = subprocess.Popen(cmd, shell=False, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0)
        for line in proc.stdout:
            full_output.append(line)
            if on_output_line:
                on_output_line(line)
        proc.wait(timeout=timeout)
        return proc.returncode, "".join(full_output)
    except subprocess.TimeoutExpired:
        proc.kill()
        return -1, "进程超时被终止"
    except Exception as e:
        return -1, str(e)

def ffprobe_json(ffprobe_cmd: str, file_path: str) -> Optional[Dict[str, Any]]:
    """调用 ffprobe 获取媒体信息的 JSON 格式"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None
    cmd = [ffprobe_cmd, "-v", "error", "-print_format", "json", "-show_streams", file_path]
    try:
        flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
        res = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8', errors='replace', creationflags=flags, timeout=10)
        if res.returncode != 0:
            return None
        data = json.loads(res.stdout)
        if "streams" not in data:
            return None
        return data
    except:
        return None

def detect_crop(ffmpeg_cmd: str, input_file: str, timeout: float = 15) -> Optional[Tuple[int, int, int, int]]:
    """自动检测黑边，返回 (w, h, x, y) 或 None"""
    if not ffmpeg_cmd or not os.path.exists(input_file):
        return None
    cmd = [
        ffmpeg_cmd, "-i", input_file,
        "-t", "5",
        "-vf", "cropdetect=limit=0.1:round=2",
        "-f", "null", "-"
    ]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0)
        _, stderr = proc.communicate(timeout=timeout)
        pattern = re.compile(r'crop=(\d+):(\d+):(\d+):(\d+)')
        matches = pattern.findall(stderr)
        if not matches:
            return None
        w, h, x, y = map(int, matches[-1])
        return w, h, x, y
    except:
        return None

# ================== 播放器预览 ==================
def launch_player(file_path: str, filters: str = "", audio_only: bool = False, volume: int = 10,
                  extra_args: Optional[List[str]] = None,
                  use_mpv: bool = False, mpv_path: str = "mpv", ffplay_path: Optional[str] = None):
    """安全启动播放器预览，列表模式 + 等号参数（兼容 mpv）"""
    file_path = normalize_path(file_path)
    extra_args = extra_args or []

    if audio_only:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-nodisp", "-autoexit", "-volume", str(volume), file_path]
    else:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
            if filters and filters.strip():
                # 与预览分支一致：mpv 用 lavfi=[...] 解析 libavfilter 滤镜图，不再用 lavfi=graph 或裸 --vf
                cmd.append(f"--vf=lavfi=[{filters}]")
            if extra_args:
                cmd.extend(extra_args)
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-i", file_path]
            if filters and filters.strip():
                cmd.extend(["-vf", filters])
            cmd.extend(["-volume", str(volume)])
            if extra_args:
                cmd.extend(extra_args)
            if "-window_title" not in cmd:
                cmd.extend(["-window_title", f"预览: {os.path.basename(file_path)}"])

    flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=flags)
    except Exception as e:
        print(f"预览失败: {e}")

