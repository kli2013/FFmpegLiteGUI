            # ---- AdvancedFrame，并传入 update_callback ----
            watermark_dict = task.settings.get("watermark", {})   # 防止 KeyError
            # 任务文字水印设置：队列编辑必须改任务自己的 dict，不能动主界面全局
            # text_watermark_settings（否则「队列里改文字水印」改的是转换主界面、
