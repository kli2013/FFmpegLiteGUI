                    bgm_path_var = tk.StringVar(value=initial_settings.get("bgm_audio_path", "") or "")
                    _bv = _opt_float(initial_settings.get("bgm_volume", 0.3) or 0.3, 0.3)
                    bgm_volume_var = tk.DoubleVar(value=_bv)
                    bgm_trim_start_var = tk.StringVar(value=initial_settings.get("bgm_trim_start", "") or "")
                    bgm_trim_end_var = tk.StringVar(value=initial_settings.get("bgm_trim_end", "") or "")

                    bgm_frame = ttk.LabelFrame(bind_frame, text="背景音乐 (BGM，全局叠加)", padding="4")
                    bgm_frame.grid(row=3, column=0, columnspan=2, sticky="we", padx=5, pady=4)

                    # 叠加背景音乐：勾选后展开【右侧】开始/结束 与【下方】音量/音频文件
                    # 原灰色说明文字收进 ToolTip（不再单独占用界面）
                    _bgm_chk = ttk.Checkbutton(
                        bgm_frame, text="叠加背景音乐",
                        variable=bgm_enabled_var,
                        command=lambda: (_bgm_r0.grid() if bgm_enabled_var.get() else _bgm_r0.grid_remove(),
                                         _bgm_r1.grid() if bgm_enabled_var.get() else _bgm_r1.grid_remove())
                    )
                    _bgm_chk.grid(row=0, column=0, sticky="w", padx=5, pady=3)
                    ToolTip(_bgm_chk,
                            "外部音频将循环铺满整段合并输出，并按此处比例降低音量后垫在原音之下。\n"
                            "背景音乐按时间点【精准截取】（帧精确），无需预先在外面处理长度；\n"
                            "可在右侧「开始 / 结束」指定背景音乐文件内的片段，循环填充整段输出。")

                    # 第一行右侧（紧贴 checkbox 右边）：开始 / 结束 / 默认精准截取（仅说明，无勾选框）
                    _bgm_r0 = ttk.Frame(bgm_frame)
                    _bgm_r0.grid(row=0, column=1, sticky="w", padx=(20, 5), pady=3)
                    _lbltt36 = ttk.Label(_bgm_r0, text="开始:")
                    _lbltt36.pack(side=tk.LEFT, padx=(0, 2))
                    _bgm_start = ttk.Entry(_bgm_r0, textvariable=bgm_trim_start_var, width=12)
                    _bgm_start.pack(side=tk.LEFT, padx=2)
                    ToolTip(_lbltt36, "背景音乐开始时间（文件内时间轴），格式：秒数 (如 30) 或 HH:MM:SS.ms。留空=从头")
                    _lbltt37 = ttk.Label(_bgm_r0, text="结束:")
                    _lbltt37.pack(side=tk.LEFT, padx=(12, 2))
                    _bgm_end = ttk.Entry(_bgm_r0, textvariable=bgm_trim_end_var, width=12)
                    _bgm_end.pack(side=tk.LEFT, padx=2)
                    ToolTip(_lbltt37, "背景音乐结束时间（文件内时间轴），格式：秒数 或 HH:MM:SS.ms。留空=到文件末尾")
                    _bgm_precise = ttk.Label(_bgm_r0, text="默认精准截取", foreground="gray")
                    _bgm_precise.pack(side=tk.LEFT, padx=(12, 0))
                    ToolTip(_bgm_precise, "背景音乐按时间点帧精确裁剪，无需预先处理文件长度；\n"
                                          "只取某段循环请填上方开始/结束，留空则使用整段。")

                    # ---- 时间预览入口（作用于外部 BGM 音频文件，默认音频模式）----
                    # BGM 是纯音频文件时 has_video=False，SimplePreviewer 会自动在探测后
                    # 禁用「画面模式」切换（见 _apply_probe_ui），不会因无视频流报错。
                    def _bgm_open_preview():
                        p = bgm_path_var.get().strip()
                        if alert_if(not p or not os.path.exists(p), "提示", "请先选择背景音乐文件再打开时间预览", 'info', parent=win):
                            return
                        release_grab(self.root)
                        self.show_time_picker(
                            win, p,
                            start_mode="audio", use_output_context=False,
                            on_set_start=lambda s: bgm_trim_start_var.set(_format_preview_time(s)),
                            on_set_end=lambda s: bgm_trim_end_var.set(_format_preview_time(s)),
                            initial_marks=[(bgm_trim_start_var.get(), bgm_trim_end_var.get())])
                    _bgm_tp_btn = ttk.Button(_bgm_r0, text="时间预览", width=8,
                                             command=_bgm_open_preview)
                    _bgm_tp_btn.pack(side=tk.LEFT, padx=(12, 0))
                    ToolTip(_bgm_tp_btn,
                            "打开简易时间预览（音频模式）：在背景音乐文件内定位开始/结束时间点，\n"
                            "点「设为起点/终点」回填上方开始/结束框。\n"
                            "该文件无视频流，仅支持音频波形定位，不能切到画面模式。",
                            wraplength=440)

                    # 第二行：音量 / 音频文件 / 浏览
                    _bgm_r1 = ttk.Frame(bgm_frame)
                    _bgm_r1.grid(row=1, column=0, columnspan=2, sticky="we", padx=5, pady=3)
                    ttk.Label(_bgm_r1, text="音量:").pack(side=tk.LEFT, padx=(0, 2))
                    _bgm_scale = ttk.Scale(_bgm_r1, from_=0.0, to=1.0, orient=tk.HORIZONTAL,
                                           variable=bgm_volume_var, length=160)
                    _bgm_scale.pack(side=tk.LEFT, padx=2)
                    # 滑块右侧编辑框：可直接键入音量（0.0~1.0），与滑块双向同步（2026-09-26）
                    # ⚠️ 本方法会被反复调用，闭包里的变量必须用默认参数就地绑定，
                    #    否则上一次窗口的回调会抓到本帧新建的变量（late binding 陷阱）。
                    _bgm_voltxt = tk.StringVar(value=f"{_bv:.2f}")
                    _bgm_volsync = [False]
                    _bgm_vollen = ttk.Entry(_bgm_r1, textvariable=_bgm_voltxt, width=5,
                                             justify=tk.CENTER)
                    _bgm_vollen.pack(side=tk.LEFT, padx=(2, 8))

                    def _bgm_vol_from_entry(*_a, _txt=_bgm_voltxt, _var=bgm_volume_var,
                                            _lock=_bgm_volsync):
                        if _lock[0]:
                            return
                        try:
                            v = float(_txt.get())
                        except (ValueError, TypeError):
                            _lock[0] = True
                            _txt.set(f"{_var.get():.2f}")
                            _lock[0] = False
                            return
                        if v < 0.0:
                            v = 0.0
                        elif v > 1.0:
                            v = 1.0
                        _lock[0] = True
                        _var.set(v)
                        _txt.set(f"{v:.2f}")
                        _lock[0] = False

                    def _bgm_vol_from_slider(v, _txt=_bgm_voltxt, _lock=_bgm_volsync):
                        if _lock[0]:
                            return
                        # ⚠️ 置锁必须在写文本**之前**：写文本会触发 trace →
                        #    _bgm_vol_from_entry，不置锁会反向写回 bgm_volume_var。
                        _lock[0] = True
                        _txt.set(f"{float(v):.2f}")
                        _lock[0] = False

                    _bgm_voltxt.trace_add("write", _bgm_vol_from_entry)
                    _bgm_vollen.bind("<Return>",
                                     lambda e, _e=_bgm_vollen: _e.selectrange(0, tk.END))
                    _bgm_scale.config(command=_bgm_vol_from_slider)
                    ttk.Label(_bgm_r1, text="音频文件:").pack(side=tk.LEFT, padx=(0, 2))
                    _bgm_entry = ttk.Entry(_bgm_r1, textvariable=bgm_path_var, width=34)
                    _bgm_entry.pack(side=tk.LEFT, padx=2)
                    ttk.Button(_bgm_r1, text="浏览...",
                               command=lambda: self._browse_bgm_file(bgm_path_var)).pack(side=tk.LEFT, padx=2)

                    if not bgm_enabled_var.get():
                        _bgm_r0.grid_remove()
                        _bgm_r1.grid_remove()

                    # ---- 音频独立截取（不分段）：仅 concat 模式（跨分段接管音频）；画中画无「分段」概念 → 隐藏 ----
                    if is_concat_mode:
                        # 用户 2026-09-16：与「分段拼接设置窗口左下」同款模块；
                        # 跨分段生效——开启后从【主视频源文件】音频中单独截取一段，整段接管合并输出音频
                        # （忽略各分段自身的嵌入音频）。程序不检测是否同源，仅提示 + 勾选时双重确认。
                        audio_trim_enabled_var = tk.BooleanVar(
                            value=bool(initial_settings.get("audio_trim_enabled", False)))
                        audio_trim_start_var = tk.StringVar(
                            value=initial_settings.get("audio_trim_start", "") or "")
                        audio_trim_end_var = tk.StringVar(
                            value=initial_settings.get("audio_trim_end", "") or "")

                        at_frame = ttk.LabelFrame(bind_frame, text="音频独立截取（不分段）", padding="4")
                        at_frame.grid(row=4, column=0, columnspan=2, sticky="we", padx=5, pady=4)

                        # 拼接后视频总时长参考（各启用视频轨「截取+变速」视频时间相加 − 转场重叠）
                        _at_ref = self._merge_at_total_ref()

                        at_r0 = ttk.Frame(at_frame)
                        at_r0.pack(fill=tk.X, pady=(0, 3))
                        at_chk = ttk.Checkbutton(at_r0, text="启用音频独立截取",
                                                 variable=audio_trim_enabled_var,
                                                 command=lambda: self._merge_at_confirm_toggle(
                                                     audio_trim_enabled_var, at_start_entry, at_end_entry))
                        at_chk.pack(side=tk.LEFT)
                        ToolTip(at_chk,
                                "跨分段生效：开启后从【主视频源文件】音频中单独截取一段，\n"
                                "整段接管合并输出的所有音频（忽略各分段自身的嵌入音频）。\n"
                                "本功能完全对齐转换页面分段拼接窗口内的模块，不是为不同文件列表设计的。\n"
                                "目的还是在重新整合视频片段时不打断原始背景音乐的连续性。\n"
                                "⚠ 程序不自动检测源文件是否一致——请自行确认本列表所有分段来自同一源文件，\n"
                                "否则音频与画面会对不上。音频起止以【源文件】时间轴为准。",
                                wraplength=420)
                        # 蓝字参考：放启用复选框右边，简短（作为音频截取长度参考）
                        # 常驻标签 + 句柄，供「一键淡入淡出(all)/一键转场(all)」即时刷新
                        # （这两个操作直接写回 merge_tracks.enc_settings，无需保存重开即可重算总时长）
                        self._at_total_ref_label = ttk.Label(at_r0, text="", foreground="blue")
                        self._at_total_ref_label.pack(side=tk.LEFT, padx=(10, 0))
                        self._refresh_at_total_ref()

                        at_r1 = ttk.Frame(at_frame)
                        at_r1.pack(fill=tk.X, pady=(2, 0))
                        _lbltt38 = ttk.Label(at_r1, text="音频起始:")
                        _lbltt38.pack(side=tk.LEFT)
                        at_start_entry = ttk.Entry(at_r1, textvariable=audio_trim_start_var, width=12)
                        at_start_entry.pack(side=tk.LEFT, padx=3)
                        ToolTip(_lbltt38, "音频开始时间（源文件时间轴），格式：秒数 (如 0) 或 HH:MM:SS.ms")
                        _lbltt39 = ttk.Label(at_r1, text="音频结束:")
                        _lbltt39.pack(side=tk.LEFT, padx=(15, 0))
                        at_end_entry = ttk.Entry(at_r1, textvariable=audio_trim_end_var, width=12)
                        at_end_entry.pack(side=tk.LEFT, padx=3)
                        ToolTip(_lbltt39, "音频结束时间（源文件时间轴），格式：秒数 或 HH:MM:SS.ms。留空=到文件末尾")

                        # 初始禁用状态
                        self._merge_at_toggle(audio_trim_enabled_var, at_start_entry, at_end_entry)

                # 静音流说明已移至「生成静音流」单选按钮的 ToolTip，不再占用界面空间

                # 预留外部文件控件（暂时隐藏）
                # external_frame = ttk.Frame(bind_frame)
                # external_frame.grid(row=2, column=0, columnspan=2, sticky="we", padx=5, pady=5)
                # external_frame.grid_remove()
    
            # ================== 新增结束 ==================

            # ---- 窗口居中 ----
            center_window(win, 700, 310)

            # ---- 保存按钮 ----
            def save():
                try:
                    new_settings = {}
                    new_settings.update(enc_frame.get_settings())
                    new_settings.update(filt_frame.get_settings())
                    new_settings.update(trim_frame.get_settings())
                    new_settings["fade_enabled"] = fade_enabled_var.get()
                    new_settings["fade_in"] = fade_in_var.get().strip()
                    new_settings["fade_out"] = fade_out_var.get().strip()
                    # 串行转场（逐轨常驻）：转场挂本段，末段写回无效（命令生成会忽略末段）
                    new_settings["transition_enabled"] = transition_enabled_var.get()
                    new_settings["transition_type"] = transition_type_var.get().strip() or "fade"
                    new_settings["transition_duration"] = transition_duration_var.get().strip() or "1.0"
                    if loop_chroma_frame is not None:
                        new_settings.update(loop_chroma_frame.get_settings())
                    if overlay_frame is not None:
                        new_settings.update(overlay_frame.get_settings())
                    if is_watermark:
                        new_settings["enabled"] = True
                        new_settings["file_path"] = initial_settings.get("file_path", "")
                        new_settings["duration"] = initial_settings.get("duration", None)
                    else:
                        # 音频绑定设置：画中画 + 串行模式的主视频均收集 BGM；音频源类型 / 音频独立截取仅串行
                        if (is_concat_mode or is_pip) and track_obj is not None and track_obj.type == "video":
                            if is_concat_mode:
                                new_settings["audio_source_type"] = audio_source_type_var.get()
                            if is_main_video and bgm_enabled_var is not None:
                                new_settings["bgm_enabled"] = bgm_enabled_var.get()
                                new_settings["bgm_audio_path"] = bgm_path_var.get().strip()
                                new_settings["bgm_volume"] = bgm_volume_var.get()
                                new_settings["bgm_trim_start"] = bgm_trim_start_var.get().strip()
                                new_settings["bgm_trim_end"] = bgm_trim_end_var.get().strip()
                            if pip_aft_var is not None:
                                new_settings["pip_audio_follow_transition"] = pip_aft_var.get()
                            if is_concat_mode and is_main_video:
                                # 音频独立截取（不分段）：仅主视频 concat 模式
                                new_settings["audio_trim_enabled"] = audio_trim_enabled_var.get()
                                new_settings["audio_trim_start"] = audio_trim_start_var.get().strip()
                                new_settings["audio_trim_end"] = audio_trim_end_var.get().strip()
                            # 以下两项暂不支持，留作未来扩展
                            # new_settings["external_audio_path"] = ""
                            # new_settings["external_audio_stream"] = "0:a:0"

                    new_settings["enhance"] = filt_frame.get_enhance_settings()

                    if track_obj is not None and not is_watermark:
                        # 优先使用自定义输入框，否则使用下拉框值
                        raw_lang = custom_lang_var.get().strip() or lang_var.get().strip()
                        # 尝试映射为标准码
                        if raw_lang:
                            # 如果下拉框选了显示名，但自定义框为空，这里 raw_lang 可能是显示名，需要映射
                            # 我们只对纯代码进行映射，显示名通过下拉框关联
                            # 但为了安全，先尝试从 COMMON_LANGUAGES 反向查找
                            found_code = None
                            for display, code in self.COMMON_LANGUAGES:
                                if display == raw_lang:
                                    found_code = code
                                    break
                            if found_code:
                                new_settings["language"] = found_code
                            else:
                                # 否则视为代码，应用映射表
                                new_settings["language"] = self.LANGUAGE_MAP.get(raw_lang.lower(), raw_lang)
                        else:
                            new_settings["language"] = ""
                        new_settings["title"] = title_var.get().strip()
                        # 章节标签（仅串行模式）
                        if is_concat_mode:
                            new_settings["chapter_label"] = chapter_label_var.get().strip()

                    on_save(new_settings)
                except Exception as e:
                    import traceback
                    traceback.print_exc()
                    messagebox.showerror("保存错误", f"发生错误：{e}\n请查看控制台详细错误。")
                finally:
                    try:
                        win.destroy()
                    except:
                        pass

            ttk.Button(win, text="保存", command=save).pack(pady=10)
            win.wait_window()

    def merge_edit_video_track(self, track_idx):
        track = self.merge_tracks[track_idx]
        enabled_videos = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        is_main = (enabled_videos and enabled_videos[0] == track)
        overlay_mode = 'main' if is_main else 'sub'
        # 仅在画中画模式且不是主视频时显示循环/绿幕控制
        show_loop = self.pip_enabled.get() and not is_main

        initial_settings = track.enc_settings.copy()
        if "enhance" not in initial_settings:
            initial_settings["enhance"] = {
                "denoise_enabled": False,
                "denoise_spatial": 4.0,
                "denoise_temporal": 3.0,
                "sharpen_enabled": False,
                "sharpen_strength": 1.0,
                "ivtc_enabled": False,
                "deblock_enabled": False,
                "deblock_strength": 4,
                "colorspace_enabled": False,
                "colorspace_matrix": "bt709:bt2020",
            }

        self.edit_video_settings(
            title=f"视频轨道设置 - {track.codec}",
            initial_settings=initial_settings,
            on_save=lambda new: self._update_track_enc(track_idx, new),
            file_path=track.file_path,
            is_watermark=False,
            track_idx=track_idx,
            pip_enabled_var=self.pip_enabled,
            overlay_mode=overlay_mode,
            parent=self.root,
            show_loop_chroma=show_loop,
            track_obj=track,   # 传递轨道对象
            is_concat_mode=self.concat_enabled.get(),
            canvas_file=self._merge_context_main_video(),   # 子视频显示时段预览=封装页主视频
            pip_subctrl=(self.pip_enabled.get() and is_main)   # 画中画主视频 → 「子视频控制」页
        )
    
    
    def _update_track_enc(self, idx, new_settings):
        track = self.merge_tracks[idx]  # 先获取 track 对象
        old_encoder = track.enc_settings.get("encoder")
        new_encoder = new_settings.get("encoder")
        track.enc_settings = new_settings
        # 更新字幕元数据
        track.language = new_settings.get("language", "")
        track.title = new_settings.get("title", "")

        if "enhance" in new_settings:
            track.enc_settings["enhance"] = new_settings["enhance"]
        # 同步属性（兼容旧代码）

        # 缺键时按 True（与 Track 默认一致）：编辑器没产出该键（如 overlay_frame 为 None）
        # 不该把轨道悄悄变成「不叠加」（2026-09-24 修正，原为 False）。
        track.overlay_enabled = new_settings.get("overlay_enabled", True)
        track.overlay_x = new_settings.get("overlay_x", DEFAULT_OVERLAY_X)
        track.overlay_y = new_settings.get("overlay_y", DEFAULT_OVERLAY_Y)
        track.pad_enabled = new_settings.get("pad_enabled", False)
        track.pad_width = new_settings.get("pad_width", "")
        track.pad_height = new_settings.get("pad_height", "")
        track.offset_x = new_settings.get("offset_x", "0")
        track.offset_y = new_settings.get("offset_y", "0")

        # 检测是否切换为 copy（仅在视频轨道且编码器变化时）
        if track.type == "video" and old_encoder != new_encoder:
            if new_encoder == "copy":
                self._append_info_ui("[封装] 该视频轨道编码器已设为 copy，视频滤镜将被忽略。")

        self.merge_refresh_ui()


    def merge_edit_audio_track(self, track_idx=None, node_key=None,
                              initial_settings=None, on_save=None):
        is_node = node_key is not None
        if is_node:
            # 节点模式：没有真实轨道，用一个轻量代理承载音频效果设置，
            # 复用整个「音频轨道设置」UI（仅把保存落点改成 on_save，不写回轨道）。
            class _NodeAudioProxy:
                def __init__(self, es):
                    self.enc_settings = dict(es or {})
                    self.language = self.enc_settings.get("language", "")
                    self.title = self.enc_settings.get("title", "")
                    self.codec = "节点"
                    self.file_path = None
            track = _NodeAudioProxy(initial_settings)
            win_title = f"音频节点效果 [{node_key}]"
        else:
            track = self.merge_tracks[track_idx]
            win_title = f"音频轨道设置 - {track.codec}"
        with self.SafeToplevel(self.root) as win:
            win.title(win_title)
            center_window(win, 880, 570)
            win.transient(self.root)
    
            main_frame = ttk.Frame(win, padding="10")
            main_frame.pack(fill=tk.BOTH, expand=True)

            # 左右两列布局：左列放常显控件，右列放有条件显示的控件，并借用部分常显控件以平衡高度
            top_frame = ttk.Frame(main_frame)
            top_frame.pack(fill=tk.X, pady=5)
            left_col = ttk.Frame(top_frame)
            right_col = ttk.Frame(top_frame)
            left_col.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(0, 6))
            right_col.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(6, 0))
    
            # ---- 编码参数（水平布局） ----
            enc_frame = ttk.LabelFrame(left_col, text="编码参数", padding="5")
            enc_frame.pack(fill=tk.X, pady=5)
    
            row = ttk.Frame(enc_frame)
            row.pack(fill=tk.X, pady=2)
    
            ttk.Label(row, text="编码器:").pack(side=tk.LEFT, padx=5)
            encoder_var = tk.StringVar(value=track.enc_settings.get("encoder", "copy"))
            encoder_combo = ttk.Combobox(row, textvariable=encoder_var, values=ALL_AUDIO_ENCODERS, state="readonly", width=12)
            encoder_combo.pack(side=tk.LEFT, padx=5)
    
            _lbltt40 = ttk.Label(row, text="比特率:")
            _lbltt40.pack(side=tk.LEFT, padx=5)
            bitrate_var = tk.StringVar(value=track.enc_settings.get("bitrate", "auto"))
            _br_values = ["auto", "64k", "96k", "128k", "192k", "256k", "320k"]
            if bitrate_var.get() not in _br_values:
                _br_values.append(bitrate_var.get())
            bitrate_combo = ttk.Combobox(row, textvariable=bitrate_var, width=8, values=_br_values, state="readonly")
            bitrate_combo.pack(side=tk.LEFT, padx=5)
            ToolTip(_lbltt40, "auto = 不向 ffmpeg 传 -b:a，由编码器自行决定。无损编码器（FLAC/ALAC/PCM）不接受比特率——ffmpeg 会静默忽略。", wraplength=420)

            _lbltt41 = ttk.Label(row, text="采样率:")
            _lbltt41.pack(side=tk.LEFT, padx=5)
            samplerate_var = tk.StringVar(value=track.enc_settings.get("samplerate", "auto"))
            _sr_values = ["auto", "8000", "12000", "16000", "22050", "32000", "44100", "48000", "96000"]
            if samplerate_var.get() not in _sr_values:
                _sr_values.append(samplerate_var.get())
            samplerate_combo = ttk.Combobox(row, textvariable=samplerate_var, width=8, values=_sr_values, state="readonly")
            samplerate_combo.pack(side=tk.LEFT, padx=5)
            ToolTip(_lbltt41, "auto = 保持源采样率，不传 -ar（推荐）。无损/直通编码器会强制 auto 并置灰——否则 -ar 会破坏无损。", wraplength=420)

            # ---- 切换保护：选无损/直通编码器时禁用比特率、采样率强制 auto 并置灰（与转换页一致） ----
            _br_backup = [None]
            _sr_backup = [None]
            def _sync_bitrate_state(*_args):
                _codec = encoder_var.get()
                _lossless_or_copy = (_codec in LOSSLESS_AUDIO_CODECS) or (_codec == "copy")
                if _lossless_or_copy:
                    _br_backup[0] = bitrate_combo.get()
                    _sr_backup[0] = samplerate_combo.get()
                    bitrate_combo.config(state=tk.DISABLED)
                    samplerate_combo.config(state=tk.DISABLED)
                    # 采样率必须改 auto，否则 -ar 会破坏无损
                    samplerate_combo.set(AUDIO_AUTO)
                else:
                    bitrate_combo.config(state="readonly")
                    samplerate_combo.config(state="readonly")
                    if _sr_backup[0] is not None:
                        samplerate_combo.set(_sr_backup[0])
                    if _br_backup[0] is not None:
                        bitrate_combo.set(_br_backup[0])
            encoder_var.trace_add("write", _sync_bitrate_state)
            _sync_bitrate_state()
    
            # ---- 轨道元数据（语言下拉+自定义输入，标题） ----
            meta_frame = ttk.LabelFrame(left_col, text="轨道元数据", padding="5")
            meta_frame.pack(fill=tk.X, pady=5)
    
            # 语言部分：下拉框 + 手动输入框
            lang_row = ttk.Frame(meta_frame)
            lang_row.pack(fill=tk.X, pady=2)
    
            ttk.Label(lang_row, text="语言:").pack(side=tk.LEFT, padx=5)
            
            lang_display_var = tk.StringVar()
            # 显示名列表
            lang_display_list = [display for display, code in self.COMMON_LANGUAGES]
            lang_combo = ttk.Combobox(lang_row, textvariable=lang_display_var,
                                      values=lang_display_list,
                                      state="normal", width=18)
            lang_combo.pack(side=tk.LEFT, padx=5)
    
            # 手动输入框（用于输入未列出的代码，如 "cmn"）
            ttk.Label(lang_row, text="或输入代码:").pack(side=tk.LEFT, padx=(10,2))
            custom_lang_entry = ttk.Entry(lang_row, width=10)
            custom_lang_entry.pack(side=tk.LEFT, padx=2)
            
            # 从现有语言值初始化（track.language 可能是标准码）
            current_lang = track.language or ""
            if current_lang:
                # 查找是否在映射表中
                found_display = None
                for display, code in self.COMMON_LANGUAGES:
                    if code == current_lang:
                        found_display = display
                        break
                if found_display:
                    lang_display_var.set(found_display)
                    custom_lang_entry.delete(0, tk.END)
                    custom_lang_entry.insert(0, current_lang)
                else:
                    # 未找到，直接填入手动输入框
                    custom_lang_entry.insert(0, current_lang)
                    # 尝试在下拉框中匹配显示名（可能为"未指定 (und)"等）
                    for display, code in self.COMMON_LANGUAGES:
                        if code == "und":
                            lang_display_var.set(display)
                            break
    
            # 绑定下拉选择事件：自动填充自定义框
            lang_combo.bind("<<ComboboxSelected>>", _make_on_lang_select(lang_display_var, custom_lang_entry, self.COMMON_LANGUAGES))
    
            # 标题
            title_row = ttk.Frame(meta_frame)
            title_row.pack(fill=tk.X, pady=2)
            ttk.Label(title_row, text="标题:").pack(side=tk.LEFT, padx=5)
            title_var = tk.StringVar(value=track.title)
            title_entry = ttk.Entry(title_row, textvariable=title_var, width=40)
            title_entry.pack(side=tk.LEFT, padx=5)

            # 默认轨标记 (disposition)
            disp_row = ttk.Frame(meta_frame)
            disp_row.pack(fill=tk.X, pady=2)
            ttk.Label(disp_row, text="默认轨:").pack(side=tk.LEFT, padx=5)
            disp_var = tk.StringVar(value=track.enc_settings.get("disposition", ""))
            ttk.Combobox(disp_row, textvariable=disp_var, width=18,
                         values=["", "default", "none", "forced", "hearing_impaired", "visual_impaired"],
                         state="readonly").pack(side=tk.LEFT, padx=5)
            ttk.Label(disp_row, text="（留空=沿用首轨 default）").pack(side=tk.LEFT, padx=5)

            # 获取模式标志
            is_pip = self.pip_enabled.get()
            is_concat = self.concat_enabled.get()

            # 章节标签（仅串行模式）
            chapter_label_var = tk.StringVar(value="")
            if is_concat:
                cl_row = ttk.Frame(meta_frame)
                cl_row.pack(fill=tk.X, pady=2)
                ttk.Label(cl_row, text="章节标签:").pack(side=tk.LEFT, padx=5)
                chapter_label_var.set(track.enc_settings.get("chapter_label", ""))
                chapter_label_entry = ttk.Entry(cl_row, textvariable=chapter_label_var, width=40)
                chapter_label_entry.pack(side=tk.LEFT, padx=5)

            # ---- 音量控制（所有模式可用；无外框，仅勾选 + 滑块） ----
            vol_enabled_var = tk.BooleanVar(value=track.enc_settings.get("volume_enabled", False))
            vol_value_var = tk.DoubleVar(value=track.enc_settings.get("volume", 1.0))

            vol_row = ttk.Frame(left_col)
            vol_row.pack(fill=tk.X, pady=(5,0))
            vol_check = ttk.Checkbutton(vol_row, text="启用音量调整", variable=vol_enabled_var)
            vol_check.pack(side=tk.LEFT)
            vol_control_frame = ttk.Frame(vol_row)
            vol_control_frame.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(10,0))

            ttk.Label(vol_control_frame, text="倍数:").pack(side=tk.LEFT)
            vol_slider = ttk.Scale(vol_control_frame, from_=0.1, to=3.0, variable=vol_value_var,
                                   orient=tk.HORIZONTAL, length=120, state=tk.DISABLED)
            vol_slider.pack(side=tk.LEFT, padx=5, fill=tk.X, expand=True)
            # 滑块右侧编辑框：可直接键入倍数（0.1~3.0），与滑块双向同步（2026-09-26）
            # ⚠️ 本方法会被反复调用（每个音频轨一次），闭包变量必须用默认参数就地绑定，
            #    否则旧窗口的回调会抓到新帧的变量（late binding 陷阱）。
            vol_txt = tk.StringVar(value=f"{vol_value_var.get():.2f}")
            vol_sync = [False]
            vol_entry = ttk.Entry(vol_control_frame, textvariable=vol_txt, width=5,
                                  justify=tk.CENTER)
            vol_entry.pack(side=tk.LEFT)

            def _vol_from_entry(*_a, _txt=vol_txt, _var=vol_value_var, _lock=vol_sync):
                if _lock[0]:
                    return
                try:
                    v = float(_txt.get())
                except (ValueError, TypeError):
                    _lock[0] = True
                    _txt.set(f"{_var.get():.2f}")
                    _lock[0] = False
                    return
                if v < 0.1:
                    v = 0.1
                elif v > 3.0:
                    v = 3.0
                _lock[0] = True
                _var.set(v)
                _txt.set(f"{v:.2f}")
                _lock[0] = False

            def _vol_from_slider(v, _txt=vol_txt, _lock=vol_sync):
                if _lock[0]:
                    return
                # ⚠️ 置锁必须在写文本**之前**：写文本会触发 trace →
                #    _vol_from_entry，不置锁会反向写回 vol_value_var。
                _lock[0] = True
                _txt.set(f"{float(v):.2f}")
                _lock[0] = False

            vol_txt.trace_add("write", _vol_from_entry)
            vol_entry.bind("<Return>", lambda e, _e=vol_entry: _e.selectrange(0, tk.END))
            vol_slider.configure(command=_vol_from_slider)

            def on_vol_enabled(*args):
                state = tk.NORMAL if vol_enabled_var.get() else tk.DISABLED
                vol_slider.config(state=state)
                # 编辑框跟随滑块一起禁用/启用，否则「未勾选启用」还能键入（口径不一致）
                vol_entry.config(state=state)
            vol_enabled_var.trace_add("write", on_vol_enabled)
            on_vol_enabled()

            # ---- 套用同源视频轨（V→A）：同源音频轨一键套用对应视频轨截取/变速/倒放（独立一行，不嵌套音量块） ----
            src_video = None if is_node else self._find_src_video_track(track)
            apply_row = ttk.Frame(left_col)
            apply_row.pack(fill=tk.X, pady=(8,2))
            if src_video is not None:
                def apply_src_video_to_this():
                    s = self._find_src_video_track(track)
                    if s is None:
                        return
                    ss = s.enc_settings
                    trim_enabled = ss.get("trim_enabled", False)
                    trim_start = ss.get("trim_start", "")
                    trim_end = ss.get("trim_end", "")
                    precise_trim = ss.get("precise_trim", False)
                    speed_enabled = ss.get("speed_enabled", False)
                    speed_factor = ss.get("speed_factor", "1.0")
                    reverse_enabled = ss.get("reverse_enabled", False)
                    # 单条越界保护：弹窗问是否仍套用
                    if trim_enabled:
                        dur = self._get_media_duration(track.file_path)
                        if dur is not None:
                            try:
                                end = time_to_seconds(trim_end.strip()) if trim_end else None
                                start = time_to_seconds(trim_start.strip()) if trim_start else 0.0
                            except Exception:
                                end, start = None, 0.0
                            over = end if (end is not None and end > dur) else (start if start > dur else None)
                            if over is not None:
                                if not messagebox.askyesno(
                                    "时长超出告警",
                                    f"音频轨源时长只有 {dur:.1f} 秒，\n"
                                    f"而视频截取时间点为 {over:.1f} 秒，超出音频时长，\n"
                                    f"套用后 atrim 可能报错或产生静音。\n\n仍要套用吗？"):
                                    self._append_info_ui("已取消套用同源视频轨（音频时长不足）")
                                    return
                    # 写局部变量（对话框同步显示）
                    trim_enabled_var.set(trim_enabled)
                    trim_start_var.set(trim_start)
                    trim_end_var.set(trim_end)
                    precise_trim_var.set(precise_trim)
                    speed_enabled_var.set(speed_enabled)
                    speed_factor_var.set(str(speed_factor))
                    audio_reverse_var.set(reverse_enabled)
                    # 写回 track.enc_settings（供预览与保存）
                    track.enc_settings.update({
                        "trim_enabled": trim_enabled,
                        "trim_start": trim_start,
                        "trim_end": trim_end,
                        "precise_trim": precise_trim,
                        "audio_speed_enabled": speed_enabled,
                        "audio_speed_factor": str(speed_factor),
                        "audio_reverse": reverse_enabled,
                    })
                    self._append_info_ui(f"已套用同源视频轨 {os.path.basename(s.file_path)} 的截取/变速/倒放（可自由取消）")
                    self.merge_refresh_ui()

                btn_apply_src = ttk.Button(apply_row, text="套用同源视频轨截取、变速、倒放(v→a)", command=apply_src_video_to_this)
                btn_apply_src.pack(side=tk.LEFT)
                ToolTip(btn_apply_src,
                        "把来源相同的视频轨的截取/变速/倒放一键套用到本音频轨（写明确值，可自由取消）",
                        wraplength=420)
            else:
                ttk.Label(apply_row,
                          text="（本音频来自外部文件，无同源视频轨，请用右键『复制/粘贴 截取/变速/倒放 (V→A)』）",
                          foreground="gray").pack(side=tk.LEFT)

            # ---- 音频混合（2026-09-30）：复选框已由「时间轴与输出-输出方式」下拉取代
            #（框架见下方 right_column 内 offset 之后）。新语义：混音以主音频为底、
            # 未混音轨道保留为独立音轨（旧「未勾选即丢弃」行为废除）。

            # ---- 音频倒放（独立于视频，所有模式可用） ----
            reverse_frame = ttk.Frame(right_col)
            reverse_frame.pack(fill=tk.X, pady=5)
            audio_reverse_var = tk.BooleanVar(value=track.enc_settings.get("audio_reverse", False))
            chk_reverse = ttk.Checkbutton(
                reverse_frame,
