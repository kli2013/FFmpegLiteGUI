            trim_frame = ttk.LabelFrame(left_col, text="音频截取（精确到毫秒）", padding="5")
            trim_frame.pack(fill=tk.X, pady=(8, 2))

            trim_enabled_var = tk.BooleanVar(value=track.enc_settings.get("trim_enabled", False))
            chk = ttk.Checkbutton(trim_frame, text="启用截取", variable=trim_enabled_var)
            chk.grid(row=0, column=0, sticky="w", padx=5, pady=5)
            ToolTip(chk,
                    "注意：若截取时长短于主视频，输出将以音频为准提前结束，导致主视频内容丢失。\n"
                    "建议截取时长 ≥ 主视频时长，或保持不截取。",
                    wraplength=500)
            # 导入时间：读剪贴板一行 `-ss S -to E` 直接填入起止时间（不弹窗输入）
            def _import_trim():
                # ⚠️ 非阻塞读（2026-09-16）：同步 clipboard_get 在预览窗口持有剪贴板时会死锁
                read_clipboard_safe(win, _import_trim_apply)

            def _import_trim_apply(text):
                text = (text or "").strip()
                pairs = parse_ss_to_commands(text)
                if alert_if(not pairs, "提示", "剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）", 'info'):
                    return
                s, e = pairs[0]  # 只取第一行（音频场景一般只复制一行）
                trim_start_var.set(_ffsec(s))
                trim_end_var.set(_ffsec(e))

            import_btn = ttk.Button(trim_frame, text="导入时间", width=8, command=_import_trim)
            import_btn.grid(row=0, column=1, sticky="w", padx=(20, 0), pady=5)
            ToolTip(import_btn,
                    "从剪贴板导入一行时间直接填入开始/结束框（程序内部通用格式，不弹窗）：\n"
                    "`-ss 开始 -to 结束`，如 `-ss 12.345 -to 20.000`。\n"
                    "该格式与「简易时间预览」的复制时间/「章节编辑器」外部时间一致；"
                    "剪贴板有多行时只取第一行。",
                    wraplength=460)

            # ---- 时间预览入口（作用于音频轨源文件，默认音频模式）----
            def _at_open_preview():
                p = track.file_path
                if alert_if(not p or not os.path.exists(p), "提示", "未找到音频轨源文件，无法打开时间预览", 'info', parent=win):
                    return
                release_grab(self.root)
                self.show_time_picker(
                    win, p,
                    start_mode="audio", use_output_context=False,
                    on_set_start=lambda s: trim_start_var.set(_format_preview_time(s)),
                    on_set_end=lambda s: trim_end_var.set(_format_preview_time(s)),
                    initial_marks=[(trim_start_var.get(), trim_end_var.get())])
            _at_tp_btn = ttk.Button(trim_frame, text="时间预览", width=8, command=_at_open_preview)
            _at_tp_btn.grid(row=0, column=2, sticky="w", padx=(8, 0), pady=5)
            ToolTip(_at_tp_btn,
                    "打开简易时间预览（音频模式）：在音频轨源文件内定位截取起止时间点，\n"
                    "点「设为起点/终点」回填上方开始/结束框。\n"
                    "音频轨源文件若含视频流，可点「画面模式」切回帧浏览器。",
                    wraplength=440)

            ttk.Label(trim_frame, text="开始时间 (HH:MM:SS[.mmm]):").grid(row=1, column=0, sticky="w", padx=5, pady=5)
            trim_start_var = tk.StringVar(value=track.enc_settings.get("trim_start", "0"))
            ttk.Entry(trim_frame, textvariable=trim_start_var, width=15).grid(row=1, column=1, sticky="w", padx=5, pady=5)

            ttk.Label(trim_frame, text="结束时间 (HH:MM:SS[.mmm]):").grid(row=2, column=0, sticky="w", padx=5, pady=5)
            trim_end_var = tk.StringVar(value=track.enc_settings.get("trim_end", ""))
            ttk.Entry(trim_frame, textvariable=trim_end_var, width=15).grid(row=2, column=1, sticky="w", padx=5, pady=5)
            ttk.Label(trim_frame, text="结束时间 (留空到末尾)").grid(row=2, column=2, sticky="w", padx=5, pady=5)

            precise_trim_var = tk.BooleanVar(value=track.enc_settings.get("precise_trim", False))
            ttk.Checkbutton(trim_frame, text="精准模式（精确到帧）", variable=precise_trim_var).grid(row=3, column=0, columnspan=3, sticky="w", padx=5, pady=5)

            ttk.Label(trim_frame, text="注意：启用截取后，编码器将自动改为非 copy 格式（如 aac）", foreground="gray").grid(row=4, column=0, columnspan=3, sticky="w", padx=5, pady=5)

            # ---- 右列容器（高级音频区之下：上：偏移，下：分段效果） ----
            right_column = ttk.Frame(right_col)
            right_column.pack(fill=tk.X, pady=(8, 2))

            # ---- 时间偏移对齐（上） ----
            offset_frame = ttk.LabelFrame(right_column, text="时间偏移对齐（延后秒数）", padding="5")
            offset_frame.pack(side=tk.TOP, fill=tk.X, expand=False, pady=(0, 2))

            offset_var = tk.StringVar(value=str(track.enc_settings.get("audio_offset", "")))
            of_row = ttk.Frame(offset_frame)
            of_row.pack(fill=tk.X, pady=(2, 0))
            ttk.Label(of_row, text="延后(秒, ≥0):").pack(side=tk.LEFT, padx=5)
            ttk.Entry(of_row, textvariable=offset_var, width=10).pack(side=tk.LEFT, padx=5)
            of_hint = ttk.Label(offset_frame, text="（配音比原声晚 N 秒时填 N；触发重新编码）",
                                foreground="#666666", wraplength=360)
            of_hint.pack(fill=tk.X, padx=5, pady=(0, 2), anchor=tk.W)

            # ---- 时间轴与输出（2026-09-30「分离音频自由」：输出方式 + 开始/结束） ----
            out_frame = ttk.LabelFrame(right_column, text="时间轴与输出", padding="5")
            out_frame.pack(side=tk.TOP, fill=tk.X, expand=False, pady=(6, 2))
            _OM_PAIRS = (("独立音轨", "stream"), ("混音进主音频", "mix"), ("忽略（不输出）", "ignore"))
            _om_lbl2key = dict(_OM_PAIRS)
            _om_key2lbl = {v: k for k, v in _OM_PAIRS}
            _om_mode = str(track.enc_settings.get("audio_out_mode", "") or "")
            if _om_mode not in ("stream", "mix", "ignore"):
                _om_mode = "mix" if track.enc_settings.get("mix_enabled", False) else "stream"
            out_mode_var = tk.StringVar(value=_om_key2lbl[_om_mode])
            om_row = ttk.Frame(out_frame); om_row.pack(fill=tk.X, pady=(2, 0))
            ttk.Label(om_row, text="输出方式:").pack(side=tk.LEFT, padx=5)
            ttk.Combobox(om_row, textvariable=out_mode_var, state="readonly", width=14,
                         values=[lbl for lbl, _k in _OM_PAIRS]).pack(side=tk.LEFT, padx=5)
            st_row = ttk.Frame(out_frame); st_row.pack(fill=tk.X, pady=2)
            _st_lbl1 = ttk.Label(st_row, text="开始(秒):")
            _st_lbl1.pack(side=tk.LEFT, padx=5)
            ttk.Entry(st_row, textvariable=offset_var, width=10).pack(side=tk.LEFT, padx=2)
            _st_lbl2 = ttk.Label(st_row, text="结束(秒):")
            _st_lbl2.pack(side=tk.LEFT, padx=(14, 0))
            free_end_var = tk.StringVar(value=str(track.enc_settings.get("audio_free_end", "") or ""))
            ttk.Entry(st_row, textvariable=free_end_var, width=12).pack(side=tk.LEFT, padx=2)
            ToolTip(_st_lbl1,
                    "开始(秒)=延迟(delay)：本轨音频在输出时间轴上从第 N 秒开始。\n"
                    "与上方「时间偏移对齐-延后(秒)」是同一个值，任一处修改两边同步。",
                    wraplength=420)
            ToolTip(_st_lbl2,
                    "结束=输出时间轴结束点(秒)：内容到输出的第 N 秒为止（留空=不限）。\n"
                    "独立于「截取-结束时间」，无需启用截取；内容比结束短 → 自然播完（不循环），\n"
                    "内容比结束长 → 在结束处截断。",
                    wraplength=420)
            ToolTip(out_frame,
                    "独立音频轨（外部音频）的时间轴与输出方式：\n"
                    "• 独立音轨：作为独立音轨封装进输出文件\n"
                    "• 混音进主音频：按开始/结束窗口混进主音频（多条自动叠加求和；\n"
                    "  ⚠️ 是整段时间轴的最终混音——串行合并模式下混进最终输出音频，不是单独某一段的混音）\n"
                    "• 忽略（不输出）：本轨不参与输出\n"
                    "开始与「时间偏移对齐-延后(秒)」同值联动；结束为独立值（输出时间轴结束点），\n"
                    "与「截取-结束时间」互不影响。\n"
                    "预览/命令预览不含混音音频，以正式输出为准。\n"
                    "子视频的绑定音频仍默认跟随视频窗口，不受此处影响。",
                    wraplength=440)

            # ---- 音频分段效果（下） ----
            # 串行合并（concat）模式整体屏蔽：段级钳制 atrim=0:T 会截断分段时间轴，
            # 且该模式无可靠手段确认音频时间（用户定版：超级边缘场景，直接无视）。
            # 已设置的分段数据保留在 enc_settings 里，仅在非 concat 模式下生效。
            segs_box = [copy.deepcopy(track.enc_settings.get("audio_segments") or [])]
            if (not is_concat) and (not is_node):
                seg_frame = ttk.Frame(right_column)
                seg_frame.pack(side=tk.TOP, fill=tk.X, expand=False)

                seg_count_lbl = ttk.Label(seg_frame, text="", foreground="#555555")
                seg_count_lbl.pack(side=tk.LEFT, padx=5, anchor=tk.W)

                def _refresh_seg_label():
                    n = sum(1 for s in segs_box[0] if isinstance(s, dict) and s.get("enabled", True))
                    seg_count_lbl.config(text=f"分段效果: {n} 段" if n else "分段效果: 未设置")

                def _open_audio_segments():
                    got = AudioSegmentDialog(win, segs_box[0], title="音频分段效果",
                                             app=self,
                                             file_source=lambda: track.file_path).show()
                    if got is None:
                        return
                    segs_box[0] = got
                    _refresh_seg_label()

                ttk.Button(seg_frame, text="音频分段效果…", width=14,
                           command=_open_audio_segments).pack(side=tk.LEFT, padx=5)
                ToolTip(seg_frame,
                        "在指定的若干时间段内施加音频效果（静音 / 局部音量 / 淡入淡出 / 降噪 / 滤波 / EQ），\n"
                        "音频总时长不变。时间填源文件里听到第几秒；本轨启用截取/变速后会自动换算。\n"
                        "注意：串行合并模式下此功能不可用（入口已隐藏）。",
                        wraplength=420)
                _refresh_seg_label()


            # ---- 保存按钮 ----
            def save():
                enc = encoder_var.get()
                # 如果截取启用且编码器为 copy，强制改 aac
                if trim_enabled_var.get() and enc == "copy":
                    enc = "aac"
                    self._append_info_ui("音频截取启用，编码器已从 copy 改为 aac")
                if offset_var.get().strip() and (float(offset_var.get().strip() or 0) > 0) and enc == "copy":
                    enc = "aac"
                    self._append_info_ui("音频偏移启用，编码器已从 copy 改为 aac")
                # 分段效果会生成音频滤镜，copy 模式下无法生效 → 同样强制重编码
                # （串行合并模式屏蔽分段效果，不触发此联动）
                if not is_concat and build_audio_segment_filters(segs_box[0]) and enc == "copy":
                    enc = "aac"
                    self._append_info_ui("音频分段效果启用，编码器已从 copy 改为 aac")
                # 混音进主音频时同样强制改 aac（普通模式）
                _om_save = _om_lbl2key.get(out_mode_var.get(), "stream")
                if not is_pip and not is_concat and _om_save == "mix" and enc == "copy":
                    enc = "aac"
                    self._append_info_ui("音频混音启用，编码器已从 copy 改为 aac")
                # 响度标准值防呆归一（正数取负 / 钳到 -70~-5 / 非法按默认）
                _ln_ok, _ln_v = loudnorm_i_norm(loudnorm_i_var.get())
