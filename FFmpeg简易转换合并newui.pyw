class LoopChromaFrame(ttk.LabelFrame):
    """循环播放与绿幕抠像设置组件 - 左右并排（grid布局）"""
    def __init__(self, master, filt_frame=None, **kwargs):
        super().__init__(master, text="循环/绿幕控制", padding="5", **kwargs)
