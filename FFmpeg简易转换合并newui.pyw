            def _d2c(*_a):
                _v = self._mark_d2v.get(_disp.get())
                if _v and _canon.get() != _v:
                    _canon.set(_v)
            def _c2d(*_a):
                _d = self._mark_disp.get(_canon.get(), _canon.get())
                if _disp.get() != _d:
                    _disp.set(_d)
            _disp.trace_add("write", _d2c)
            _canon.trace_add("write", _c2d)
            return _canon

