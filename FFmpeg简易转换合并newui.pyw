            self._sync_global_settings()
            # 显式同步一次（trace 在值未变时不触发，这里兜底对齐模块标志与看门狗属性）
            self._on_priority_change()
            self._on_watchdog_change()
        finally:
            self._loading_settings = False

        # 互斥兜底：旧预设可能滤镜变速与 mpv 整体变速都存了 true，加载后按"滤镜优先"纠正
        # （此时 _loading_settings 已关）
        self._preview_speed_exclusive()

        # 更新路径
        self._update_ffmpeg_paths()

    def save_player_settings(self):
        """防抖版保存播放器设置：合并高频触发，延迟 200ms 一次性写盘。"""
        if getattr(self, '_suppress_save', False) or getattr(self, '_loading_settings', False):
            return
        if getattr(self, '_save_ps_after_id', None):
            with suppress(Exception):
                self.root.after_cancel(self._save_ps_after_id)
        self._save_ps_after_id = self.root.after(200, self._do_save_player_settings)

    def _do_save_player_settings(self):
        """立即将播放器设置写入磁盘（供防抖到点或程序退出时 flush）。"""
        self._save_ps_after_id = None
        if getattr(self, '_suppress_save', False) or getattr(self, '_loading_settings', False):
            return
        self.preset_manager.save_player_settings({
            "use_mpv": self.use_mpv.get(),
            "mpv_path": self.mpv_path.get(),
            "log_enabled": self.log_enabled_var.get(),
            "log_path": self.log_path_var.get(),
            "overwrite_policy": self.overwrite_policy.get(),
            "cmd_output_path": self.cmd_output_path.get(),
            "ffmpeg_dir_enabled": self.ffmpeg_dir_enabled.get(),
            "ffmpeg_dir_path": self.ffmpeg_dir_path.get(),
            "preview_editable": self.preview_editable_var.get(),
            "pix_fmt_enabled_default": self.pix_fmt_enabled_default.get(),

            # 流提取相关
            "extract_custom_dir": self.extract_custom_dir.get(),
            "extract_output_dir": self.extract_output_dir.get().strip(),
            "auto_match_audio_ext": self.auto_match_audio_ext.get(),
            "auto_match_subtitle_ext": self.auto_match_subtitle_ext.get(),
            "extract_keep_chapters": self.extract_keep_chapters.get(),
            "extract_clear_metadata": self.extract_clear_metadata.get(),
            "extract_attachments": self.extract_attachments.get(),

            "ffprobe_parallel": self.ffprobe_parallel.get(),
            # 更多设置（2026-08-28）
            "preview_max_w": self.preview_max_w.get(),
            "preview_max_h": self.preview_max_h.get(),
            "ffprobe_timeout": self.ffprobe_timeout.get(),
            "preview_margin": self.preview_margin.get(),
            "preview_volume": self.preview_volume.get(),
            # 2026-08-30：上限 / 预览选项
            "sub_video_preview_max": self.sub_video_preview_max.get(),
            "waypoint_max_rows": self.waypoint_max_rows.get(),
            "crop_pos_max_rows": self.crop_pos_max_rows.get(),
            "canvas_max_rows": self.canvas_max_rows.get(),
            "wp_sendcmd_min_rows": self.wp_sendcmd_min_rows.get(),
            "preview_realtime_speed": self.preview_realtime_speed.get(),
            "preview_realtime_reverse": self.preview_realtime_reverse.get(),
            "preview_filter_speed": self.preview_filter_speed.get(),
            "save_output_history_enabled": self.save_output_history_enabled.get(),
