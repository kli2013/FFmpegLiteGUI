    def _merge_sort_ask(self):
        """弹出询问框，选择排序方式（仅在串行合并模式下可用）"""
        if alert_if(not self.concat_enabled.get(), "提示", "排序功能仅在「串行合并（首尾拼接）」模式下可用。\n请先勾选「串行合并（首尾拼接）」选项。", 'info'):
            return
        result = messagebox.askyesno("排序方式", "按文件名排序？\n（选“是”按文件名，选“否”按修改时间）")
        if result:
            self.merge_sort_by_filename()
        else:
            self.merge_sort_by_mtime()


    def _open_transcode_end_handling(self):
        """转码页末端处理弹窗入口：编辑 self._trans_end_handling（独立于封装页/队列），
        确定后刷新转码页命令预览（generate_ffmpeg_command wrapper 会注入末端处理）。"""
        self._open_end_handling_dialog(
            target=self._trans_end_handling,
            on_apply=lambda: self.update_command_preview())

    def _open_end_handling_dialog(self, target=None, on_apply=None):
        """末端处理弹窗（通用）：①多画面拼接（split 网格） ②末端 concat 图片/视频 ③边框（pad 画布外扩）。
        - target：设置 dict（封装页默认 self._merge_end_handling；转换页传 self._trans_end_handling；
          队列任务编辑传 task.settings["end_handling"]——三处独立不互相干扰）
        - on_apply：确定后的刷新回调（默认封装页 merge_update_command_preview）。
        弹窗直接读写 target dict（就地修改）。"""
        eh = target if target is not None else self._merge_end_handling
        win = tk.Toplevel(self.root)
        win.title("末端处理")
        win.withdraw()  # 先隐藏，center_window 自动居中显示
        try:
            win.transient(self.root)
            win.grab_set()
        except Exception:
            pass

        # ---------- 功能1：多画面拼接 ----------
        f1 = ttk.LabelFrame(win, text="多画面拼接（split 网格）", padding="6")
        f1.pack(fill=tk.X, padx=10, pady=(10, 4))
        split_on = tk.BooleanVar(value=bool(eh.get("split_enabled", False)))
        # split 与 concat 互斥（同标签 [v_end_out] 冲突会导致 ffmpeg 报错）：
        # 勾选一个自动取消另一个；注入侧也有兜底（见 _apply_end_handling_cmd）
        def _set_split():
            if split_on.get() and concat_on.get():
                concat_on.set(False)
        ttk.Checkbutton(f1, text="启用多画面拼接", variable=split_on, command=_set_split).pack(anchor=tk.W)
        r1 = ttk.Frame(f1)
        r1.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(r1, text="行数:").pack(side=tk.LEFT)
        rows_var = tk.IntVar(value=int(eh.get("split_rows", 1) or 1))
        ttk.Spinbox(r1, from_=1, to=5, width=4, textvariable=rows_var).pack(side=tk.LEFT, padx=(2, 12))
        ttk.Label(r1, text="列数:").pack(side=tk.LEFT)
        cols_var = tk.IntVar(value=int(eh.get("split_cols", 1) or 1))
        ttk.Spinbox(r1, from_=1, to=5, width=4, textvariable=cols_var).pack(side=tk.LEFT, padx=2)
        ttk.Label(r1, text="(总格数 = 行×列，限制 2-5)", foreground="gray").pack(side=tk.LEFT, padx=(8, 0))
        ttk.Label(f1, text="行=1 → 横排 hstack；列=1 → 竖排 vstack；行>1且列>1 → 网格",
                  foreground="gray").pack(anchor=tk.W, pady=(2, 0))
        ToolTip(f1,
                "把视频画面复制成 N 份（2-5）拼接成网格，类似监控墙。\n"
                "行=1 列=3 → 3 份横排 [v1][v2][v3]hstack；\n"
                "行=3 列=1 → 3 份竖排 vstack；\n"
                "行=2 列=2 → 2x2 网格（每行先 hstack 再整体 vstack）。\n"
                "最终输出画面 = 每份都是完整画面缩小后的拼接效果。",
                wraplength=380)

        # ---------- 功能2：末端 concat 图片/视频 ----------
        f2 = ttk.LabelFrame(win, text="末端 concat（图片/视频）", padding="6")
        f2.pack(fill=tk.X, padx=10, pady=4)
        concat_on = tk.BooleanVar(value=bool(eh.get("concat_enabled", False)))
        def _set_concat():
            if concat_on.get() and split_on.get():
                split_on.set(False)
        ttk.Checkbutton(f2, text="在视频末尾追加一段图片或视频", variable=concat_on,
                        command=_set_concat).pack(anchor=tk.W)
        r2 = ttk.Frame(f2)
        r2.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(r2, text="文件:").pack(side=tk.LEFT)
        path_var = tk.StringVar(value=eh.get("concat_path", "") or "")
        path_entry = ttk.Entry(r2, textvariable=path_var, width=34)
        path_entry.pack(side=tk.LEFT, padx=(2, 4))

        def _pick_concat_file():
            p = filedialog.askopenfilename(
                title="选择末端追加文件（图片或视频）",
                filetypes=media_filetypes()
            )
            if p:
                path_var.set(p)

        ttk.Button(r2, text="浏览…", command=_pick_concat_file, width=8).pack(side=tk.LEFT)
        r3 = ttk.Frame(f2)
        r3.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(r3, text="图片显示秒数:").pack(side=tk.LEFT)
        sec_var = tk.DoubleVar(value=float(eh.get("concat_sec", 5.0) or 5.0))
        ttk.Spinbox(r3, from_=0.5, to=600, increment=0.5, width=7, textvariable=sec_var).pack(side=tk.LEFT, padx=(2, 12))
        ttk.Label(r3, text="(视频忽略此项)", foreground="gray").pack(side=tk.LEFT)
        ttk.Label(f2, text="图片自动缩放适配主视频尺寸，不足则 pad 黑底居中；视频直接拼接在末尾。",
                  foreground="gray").pack(anchor=tk.W, pady=(2, 0))
        ToolTip(f2,
                "在输出视频末尾追加一段内容：\n"
                "• 图片（如二维码）：循环显示指定秒数，自动缩放适配输出尺寸，\n"
                "  图片较小（用户 scale 后仍小于输出）时自动 pad 黑色背景并居中，再 concat。\n"
                "• 视频：作为第二段直接拼接在末尾（同样按输出尺寸缩放适配）。\n\n"
                "原理：[-loop 1 -framerate fps -t N -i img] 生成有限时长图片流，\n"
                "scale+pad 对齐主视频尺寸/帧率后 concat 拼接。",
                wraplength=400)

        # ---------- 功能3：边框（pad 画布外扩） ----------
        f3 = ttk.LabelFrame(win, text="边框（pad 画布外扩）", padding="6")
        f3.pack(fill=tk.X, padx=10, pady=4)

        def _valid_hex_color(_v):
            """#RRGGBB 合法才用于色块预览；颜色名交给 ffmpeg 解析。"""
            return bool(re.fullmatch(r"#[0-9a-fA-F]{6}", str(_v or "").strip()))

        border_on = tk.BooleanVar(value=bool(eh.get("border_enabled", False)))
        ttk.Checkbutton(f3, text="在画面四周加边框（扩大输出画布）", variable=border_on).pack(anchor=tk.W)
        # 颜色行：取色按钮 + hex 输入 + 色块预览（与文字水印取色同款交互）
        c_row = ttk.Frame(f3)
        c_row.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(c_row, text="颜色:").pack(side=tk.LEFT)
        border_color_var = tk.StringVar(value=eh.get("border_color", "#000000") or "#000000")
        _color_swatch = tk.Label(c_row, width=3, relief=tk.SUNKEN,
                                 bg=border_color_var.get() if _valid_hex_color(border_color_var.get()) else "#000000")
        _color_swatch.pack(side=tk.LEFT, padx=(4, 4))

        def _pick_border_color():
            from tkinter.colorchooser import askcolor
            _rgb, _hex = askcolor(color=border_color_var.get() if _valid_hex_color(border_color_var.get()) else "#000000",
                                  title="选择边框颜色", parent=win)
            if _hex:
                border_color_var.set(_hex)
                _color_swatch.config(bg=_hex)

        ttk.Button(c_row, text="自定义…", command=_pick_border_color, width=10).pack(side=tk.LEFT)
        color_entry = ttk.Entry(c_row, textvariable=border_color_var, width=10)
        color_entry.pack(side=tk.LEFT, padx=(6, 4))
        ttk.Label(c_row, text="(#RRGGBB 或颜色名)", foreground="gray").pack(side=tk.LEFT)

        # 边距两行：上/下一行、左/右一行（弹窗宽度有限，一行 4 个 Spinbox 会挤）
        m_row1 = ttk.Frame(f3)
        m_row1.pack(fill=tk.X, pady=(4, 0))
        top_var = tk.IntVar(value=int(eh.get("border_top", 0) or 0))
        bottom_var = tk.IntVar(value=int(eh.get("border_bottom", 0) or 0))
        ttk.Label(m_row1, text="上边距:").pack(side=tk.LEFT)
        ttk.Spinbox(m_row1, from_=0, to=2000, increment=1, width=6, textvariable=top_var).pack(side=tk.LEFT, padx=(2, 14))
        ttk.Label(m_row1, text="下边距:").pack(side=tk.LEFT)
        ttk.Spinbox(m_row1, from_=0, to=2000, increment=1, width=6, textvariable=bottom_var).pack(side=tk.LEFT, padx=2)
        m_row2 = ttk.Frame(f3)
        m_row2.pack(fill=tk.X, pady=(4, 0))
        left_var = tk.IntVar(value=int(eh.get("border_left", 0) or 0))
        right_var = tk.IntVar(value=int(eh.get("border_right", 0) or 0))
        ttk.Label(m_row2, text="左边距:").pack(side=tk.LEFT)
        ttk.Spinbox(m_row2, from_=0, to=2000, increment=1, width=6, textvariable=left_var).pack(side=tk.LEFT, padx=(2, 14))
        ttk.Label(m_row2, text="右边距:").pack(side=tk.LEFT)
        ttk.Spinbox(m_row2, from_=0, to=2000, increment=1, width=6, textvariable=right_var).pack(side=tk.LEFT, padx=2)
        # 边框位置（2026-08-27）：split 之后=网格外框（默认）；split 之前=每格带框（格间边框背靠背）
        p_row = ttk.Frame(f3)
        p_row.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(p_row, text="边框位置:").pack(side=tk.LEFT)
        border_pos_var = tk.StringVar(
            value="split 之后（网格外框）" if eh.get("border_after_split", True) else "split 之前（每格带框）")
        ttk.Combobox(p_row, textvariable=border_pos_var, state="readonly", width=20,
                     values=("split 之后（网格外框）", "split 之前（每格带框）")).pack(side=tk.LEFT, padx=(2, 6))
        ttk.Label(p_row, text="(未启用多画面拼接时无差别)", foreground="gray").pack(side=tk.LEFT)
        ttk.Label(f3, text="边距单位=像素，输出尺寸 = 原画布 + 四边距之和；与 split/concat 可同时启用（边框在最外层）。",
                  foreground="gray").pack(anchor=tk.W, pady=(4, 0))
        ToolTip(f3,
                "在最终画布四周加边框（实现=ffmpeg pad 滤镜，HandBrake Pad 同款）：\n"
                "pad=原宽+左+右 : 原高+上+下 : 左 : 上 : 颜色\n"
                "• 边距=像素，四边各自独立；全 0 = 不加边框\n"
                "• 颜色支持 #RRGGBB 或颜色名（black/white/red…）\n"
                "• 边框位置：split 之后=整个网格外面一圈边框（默认）；\n"
                "  split 之前=每份画面先加边框再拼网格（格间边框背靠背，视觉 2 倍边距线）\n"
                "• 未启用多画面拼接时两种位置效果相同\n"
                "• 输出尺寸为奇数时自动向上取偶（yuv420p 要求）\n"
                "• 纯 copy 编码会自动切换重编码（滤镜必须）",
                wraplength=400)

        # ---------- 功能4：串行合并参数归一（2026-09-13 新增，仅封装页 + 串行合并模式显示） ----------
        # 控制 concat 的「统一规格」参数写在哪里：逐段写（历史）vs concat 之后写一次（精简）。
        # 新路径默认关闭，与历史路径共存观察。落位规则见 build_concat_norm_plan。
        _merge_page = (target is None) or (target is self._merge_end_handling)
        if _merge_page and getattr(self, "concat_enabled", None) is not None and self.concat_enabled.get():
            f4 = ttk.LabelFrame(win, text="串行合并 · 参数归一（实验）", padding="6")
            f4.pack(fill=tk.X, padx=10, pady=4)
            ttk.Checkbutton(f4, text="精简命令：format / fps / settb 挪到 concat 之后（只写一次）",
                            variable=self.concat_norm_global,
                            command=lambda: self.merge_update_command_preview()).pack(anchor=tk.W)
            ttk.Label(f4, text="每段 6 个归一滤镜 → 只留 scale+setsar（启用转场时保留 fps），输出规格不变。",
                      foreground="gray").pack(anchor=tk.W, pady=(2, 0))
            ToolTip(f4,
                    "串行合并时 concat 要求各段规格一致，所以每段都要先「归一」。\n"
                    "本开关只决定这些归一参数写在什么地方，不改变输出结果：\n\n"
                    "· 不勾选（默认，历史行为）：每段都写\n"
                    "  scale / format / fps / setsar / settb / setpts —— 10 段就是 60 个滤镜，命令很长。\n\n"
                    "· 勾选（实验）：段前只留 concat 真正需要的 scale + setsar，\n"
                    "  format / fps / settb 挪到 concat 之后统一写一次 —— 10 段只要 20+3 个。\n\n"
                    "实测（ffmpeg n9.0.1）：两种写法输出的分辨率、像素格式、帧率、SAR、\n"
                    "帧数、时长完全一致（含 10bit 源，逐像素 PSNR=inf）。\n"
                    "启用转场（xfade）时 fps 会自动留在段前：xfade 的 offset 按帧数算，\n"
                    "帧率不一致会直接报错，无法后置。\n\n"
                    "实验期默认关闭，发现异常请取消勾选并反馈。",
                    wraplength=460)

        # ---------- 确定 / 取消 ----------
        btm = ttk.Frame(win)
        btm.pack(fill=tk.X, padx=10, pady=(6, 10))

        def _on_ok():
            rows = max(1, int(rows_var.get() or 1))
            cols = max(1, int(cols_var.get() or 1))
            n = rows * cols
            if alert_if(split_on.get() and not (2 <= n <= 5), "提示", f"总格数 {rows}×{cols}={n} 超出限制，需为 2-5。", parent=win):
                return
            eh["split_enabled"] = bool(split_on.get())
            eh["split_rows"] = rows
            eh["split_cols"] = cols
            eh["concat_enabled"] = bool(concat_on.get())
            p = path_var.get().strip()
            if alert_if(eh["concat_enabled"] and not p, "提示", "请选择要追加的图片或视频文件。", parent=win):
                return
            eh["concat_path"] = p
            eh["concat_sec"] = max(0.5, float(sec_var.get() or 5.0))
            eh["border_enabled"] = bool(border_on.get())
            eh["border_top"] = max(0, int(top_var.get() or 0))
            eh["border_bottom"] = max(0, int(bottom_var.get() or 0))
            eh["border_left"] = max(0, int(left_var.get() or 0))
            eh["border_right"] = max(0, int(right_var.get() or 0))
            _bc = border_color_var.get().strip()
            eh["border_color"] = _bc if _bc else "#000000"
            eh["border_after_split"] = (border_pos_var.get() != "split 之前（每格带框）")
            win.destroy()
            if on_apply is not None:
                on_apply()
            else:
                self.merge_update_command_preview()
            self._append_info_ui("[末端] 末端处理设置已更新")

        _btns = ttk.Frame(btm)
        _btns.pack(anchor=tk.CENTER)
        ttk.Button(_btns, text="确定", command=_on_ok, width=8).pack(side=tk.LEFT, padx=6)
        ttk.Button(_btns, text="取消", command=win.destroy, width=8).pack(side=tk.LEFT, padx=6)

        # 居中显示
        win.update_idletasks()
        w = win.winfo_reqwidth()
        h = win.winfo_reqheight()
        x = self.root.winfo_rootx() + (self.root.winfo_width() - w) // 2
        y = self.root.winfo_rooty() + (self.root.winfo_height() - h) // 3
        win.geometry(f"+{max(0, x)}+{max(0, y)}")
        win.deiconify()


    def _apply_end_handling(self, cmd_list, enabled_tracks):
        """末端处理统一注入（封装页入口）。解析主轨道尺寸/帧率/时长后调通用 _apply_end_handling_cmd。"""
        eh = self._merge_end_handling
        if not (eh.get("split_enabled", False) or eh.get("concat_enabled", False)
                or eh.get("border_enabled", False)):
            return cmd_list
        main_track = None
        for t in enabled_tracks:
            if t.type == "video":
                main_track = t
                break
        main_w, main_h = 1280, 720
        fps = 30.0
        main_dur = 0.0   # 主视频有效时长（考虑截取/变速；concat 前强制收尾用）
        if main_track is not None:
            with suppress(Exception):
                main_w, main_h = self._get_canvas_size(main_track)
            try:
                _f = self._get_video_framerate(main_track.file_path)
                if _f and _f > 0:
                    fps = float(_f)
            except Exception:
                pass
            try:
                _d = self._get_effective_duration(main_track.enc_settings, input_path=main_track.file_path)
                if _d and _d > 0:
                    main_dur = float(_d)
            except Exception:
                pass
        return self._apply_end_handling_cmd(cmd_list, eh, main_w, main_h, fps, main_dur)

    def _probe_end_handling_dims(self, input_path, settings):
        """转换页/队列主视频末端处理对齐参数：画布尺寸/帧率/有效时长。
        与封装页 _get_canvas_size 同构（pad 优先 → compute_final_size_with_order）。"""
        main_w, main_h = 1280, 720
        pad_on = bool(settings.get("pad_enabled", False))
        if pad_on:
            try:
                _pw = int(str(settings.get("pad_width", "")).strip())
                _ph = int(str(settings.get("pad_height", "")).strip())
                if _pw > 0 and _ph > 0:
                    main_w, main_h = _pw, _ph
            except (ValueError, TypeError):
                pass
        if (main_w, main_h) == (1280, 720) or not pad_on:
            _w, _h = self._cached_video_dimensions(input_path)
            if _w is not None and _h is not None:
                _w2, _h2 = self.compute_final_size_with_order(_w, _h, settings)
                if _w2 and _w2 > 0 and _h2 and _h2 > 0:
                    main_w, main_h = _w2, _h2
        try:
            _f = self._get_video_framerate(input_path)
            fps = float(_f) if (_f and _f > 0) else 30.0
        except Exception:
            fps = 30.0
        try:
            _d = self._get_effective_duration(settings, input_path=input_path)
            main_dur = float(_d) if (_d and _d > 0) else 0.0
        except Exception:
            main_dur = 0.0
        return main_w, main_h, fps, main_dur

    def _apply_end_handling_cmd(self, cmd_list, eh, main_w, main_h, fps, main_dur):
        """末端处理统一注入（封装页/转换页/队列三处共用）。
        在 cmd_list 生成后调用：
        ①多画面拼接（split 网格）→ 在最终视频输出标签上追加 split/hstack/vstack 段；
        ②末端 concat 图片/视频 → 额外输入文件 + scale/pad 适配输出尺寸后 concat 到主视频末尾。
        eh：末端处理设置 dict（三处各自独立：_merge_end_handling / _trans_end_handling /
            task.settings["end_handling"]）。
        main_w/main_h/fps/main_dur：主视频对齐参数（封装页从轨道、转换页从 _probe_end_handling_dims）。

        ⚠️ 本方法修改的是 cmd_list（就地重建），需要找到「最终视频输出标签」：
        - 有 -filter_complex → filtergraph 末尾的输出标签（-map [xxx] 的目标，排除音频 [a...]）
        - 只有 -vf（普通模式无旋转）→ 视频输出是主视频输入流，需把 -vf 链并入新的 filter_complex 再追加末端段
        - 纯 copy（普通/串行流复制）→ 强制升级为 filter_complex + 重编码（末端处理必须重编码）
        返回新 cmd_list；未启用末端处理或解析失败时原样返回。"""
        split_on = bool(eh.get("split_enabled", False))
        concat_on = bool(eh.get("concat_enabled", False))
        # 边框（2026-08-27）：pad 画布外扩，四边距像素 + 颜色；链尾最外层，包住 split/concat 产物。
        # 全 0 边距 = 无边框（border_effective 用于统一判定，避免空 pad）
        border_on = bool(eh.get("border_enabled", False))
        b_top = max(0, int(eh.get("border_top", 0) or 0))
        b_bottom = max(0, int(eh.get("border_bottom", 0) or 0))
        b_left = max(0, int(eh.get("border_left", 0) or 0))
        b_right = max(0, int(eh.get("border_right", 0) or 0))
        border_effective = border_on and (b_top + b_bottom + b_left + b_right) > 0
        if not split_on and not concat_on and not border_effective:
            return cmd_list
        split_rows = max(1, int(eh.get("split_rows", 1) or 1))
        split_cols = max(1, int(eh.get("split_cols", 1) or 1))
        concat_path = (eh.get("concat_path", "") or "").strip()
        concat_sec = float(eh.get("concat_sec", 5.0) or 5.0)
        if split_on and concat_on:
            # 互斥兜底（弹窗已联动，这里防残留/外部设置的旧值）：concat 优先，split 忽略
            split_on = False
            self._append_info_ui("[末端] 多画面拼接与末端 concat 互斥，已优先 concat（split 忽略）")
        if split_on and not (2 <= split_rows * split_cols <= 5):
            split_on = False
        if concat_on and (not concat_path or not os.path.isfile(concat_path)):
            concat_on = False
        if not split_on and not concat_on and not border_effective:
            return cmd_list

        # ---- 解析 cmd_list：-filter_complex / -vf / 视频 -map / 输入计数 / copy 标记 ----
        fc_idx = None; fc_val = ""
        vf_idx = None; vf_val = ""
        vmap_idx = None; vmap_val = ""    # 视频 -map（[label] 或 N:v:M）
        input_count = sum(1 for a in cmd_list if a == "-i")
        is_copy = False
        i = 0
        while i < len(cmd_list):
            a = cmd_list[i]
            if a == "-filter_complex" and fc_idx is None:
                fc_idx = i; fc_val = cmd_list[i + 1] if i + 1 < len(cmd_list) else ""
                i += 2
                continue
            if a == "-vf" and vf_idx is None:
                vf_idx = i; vf_val = cmd_list[i + 1] if i + 1 < len(cmd_list) else ""
                i += 2
                continue
            if a == "-map" and i + 1 < len(cmd_list):
                tgt = cmd_list[i + 1]
                # 视频映射：[label]（排除 [a...] 音频）或 N:v / N:v? / N:v:M
                if vmap_idx is None and self._is_video_map_target(tgt):
                    vmap_idx = i; vmap_val = tgt
            if a == "-c:v" and i + 1 < len(cmd_list):
                if cmd_list[i + 1] == "copy":
                    is_copy = True
            i += 1

        # ---- 构建末端滤镜段（输入标签统一用 [v_end_in]，注入时替换为实际标签） ----
        end_parts = []
        cur_label = "[v_end_in]"
        # 边框位置（2026-08-27）：True=split 之后（网格外框，默认）；False=split 之前（每格带框）。
        # before 仅 split 启用时生效（concat 场景保持 after——边框应包住追加段，split/concat 已互斥）。
        border_after_split = bool(eh.get("border_after_split", True))
        _border_before = border_effective and split_on and (not border_after_split)
        # 边框在链尾最外层：split/concat 输出标签在边框生效（after）时改 [v_end_pre]，最后 pad → [v_end_out]
        mid_out = "[v_end_pre]" if (border_effective and not _border_before) else "[v_end_out]"
        # pad 片段（iw/ih 表达式，与预览共用 build_preview_border_frag；#RRGGBB→0xRRGGBB/颜色名/trunc 偶数化）
        _pad_frag = build_preview_border_frag(eh) if border_effective else ""
        if split_on:
            if _border_before:
                # 先 pad 边框（→[v_end_bp]），再 split 网格（→[v_end_out]）：每格带框
                end_parts.append(f"{cur_label}{_pad_frag}[v_end_bp]")
                end_parts.append(build_end_split_filters(split_rows, split_cols,
                                                         in_label="[v_end_bp]", out_label="[v_end_out]"))
                cur_label = "[v_end_out]"
            else:
                end_parts.append(build_end_split_filters(split_rows, split_cols,
                                                         in_label=cur_label, out_label=mid_out))
                cur_label = mid_out
        if concat_on:
            is_img = os.path.splitext(concat_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp')
            tail_label = f"[{input_count}:v]"
            end_parts.append(build_end_concat_filters(
                concat_path, concat_sec, in_label=cur_label, tail_label=tail_label,
                out_label=mid_out, main_w=main_w, main_h=main_h, fps=fps,
                main_dur=main_dur))
            cur_label = mid_out
            # 输入级循环：图片加 -loop 1 -framerate fps -t sec（有限时长流）；视频直接 -i
            if is_img:
                extra_in = ["-loop", "1", "-framerate", f"{fps:.6f}".rstrip('0').rstrip('.'),
                            "-t", f"{concat_sec:.3f}", "-i", normalize_path(concat_path)]
            else:
                extra_in = ["-i", normalize_path(concat_path)]
        else:
            extra_in = []
        if border_effective and not _border_before:
            # pad 画布外扩（HandBrake Pad 同款）：输出 = iw+L+R : ih+T+B，内容偏移 (L,T)，填 border_color
            end_parts.append(f"{cur_label}{_pad_frag}[v_end_out]")
        end_frag = ";".join(end_parts)

        # ---- 注入（三种形态） ----
        new_cmd = list(cmd_list)
        # 形态 A：有 -filter_complex → 在 filtergraph 末尾追加末端段
        if fc_idx is not None and fc_val:
            if vmap_val and vmap_val.startswith("["):
                base_label = vmap_val
            else:
                # 无 -map：取 filtergraph 最后一个输出标签作为末端段输入
                # （如 [0:v]...drawtext=...[v_base] → [v_base]）
                _tags = re.findall(r"\[([^\]]+)\](?=\s*(?:;|$))", fc_val)
                base_label = f"[{_tags[-1]}]" if _tags else "[v_end_in]"
            frag = end_frag.replace("[v_end_in]", base_label)
            # 保证 base_label 存在：若 fc 里没有该标签则回退 [v_end_in]（理论上不会）
            new_fc = fc_val + ";" + frag
            new_cmd[fc_idx + 1] = new_fc
            # 视频 -map 改指向 [v_end_out]
            if vmap_idx is not None:
                new_cmd[vmap_idx + 1] = "[v_end_out]"
            if extra_in:
                # 新输入追加到最后一个 -i 及其路径值之后（不改变已有输入索引；input_count 指向新文件）
                pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
                if pos > 0 and pos + 1 < len(new_cmd):
                    pos += 2  # 跳过 -i 与路径值
                new_cmd[pos:pos] = extra_in
            if is_copy:
                # filter_complex 强制重编码：把 -c:v copy 改为 libx265
                for k, a in enumerate(new_cmd):
                    if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                        new_cmd[k + 1] = "libx265"
                        break
            # 无视频 -map 时补映射（转换页普通命令；否则 [v_end_out] unconnected）
            new_cmd = self._ensure_end_video_map(new_cmd)
            return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

        # 形态 B：只有 -vf（普通模式无旋转，视频直接 map 源流）→ 并入 filter_complex
        if vf_idx is not None and vf_val:
            v_idx = vmap_val.split(":")[0] if vmap_val and ":" in vmap_val else "0"
            base_vf = vf_val if vf_val != "null" else "null"
            frag = end_frag.replace("[v_end_in]", "[v_base]")
            new_fc = f"[{v_idx}:v]{base_vf}[v_base];{frag}"
            # 删除 -vf 及其值
            del new_cmd[vf_idx:vf_idx + 2]
            # 找插入点：第一个 -map 之前；无 -map（转换页普通命令）→ 输出文件前
            ins = next((k for k, a in enumerate(new_cmd) if a == "-map"), None)
            if ins is None:
                ins = self._find_end_output_pos(new_cmd)
            new_cmd[ins:ins] = ["-filter_complex", new_fc]
            # 插入后视频 -map 索引偏移 2；统一重新查找视频 -map 改为 [v_end_out]
            for k, a in enumerate(new_cmd):
                if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                    new_cmd[k + 1] = "[v_end_out]"
                    break
            if extra_in:
                pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
                if pos > 0 and pos + 1 < len(new_cmd):
                    pos += 2  # 跳过 -i 与路径值
                new_cmd[pos:pos] = extra_in
            if is_copy:
                for k, a in enumerate(new_cmd):
                    if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                        new_cmd[k + 1] = "libx265"
                        break
            new_cmd = self._ensure_end_video_map(new_cmd)
            return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

        # 形态 C：纯 copy（无 -vf 无 filter_complex）→ 新建 filter_complex + 强制重编码
        v_idx = vmap_val.split(":")[0] if vmap_val and ":" in vmap_val else "0"
        frag = end_frag.replace("[v_end_in]", f"[{v_idx}:v]")
        new_fc = frag
        ins = next((k for k, a in enumerate(new_cmd) if a == "-map"), None)
        if ins is None:
            # 无 -map（转换页普通命令）：插到输出文件之前，绝不能插到输出文件后
            # （ffmpeg 会把 -filter_complex 认作下一输出、图输出不映射）
            ins = self._find_end_output_pos(new_cmd)
        new_cmd[ins:ins] = ["-filter_complex", new_fc]
        # 插入后视频 -map 索引偏移 2；统一重新查找视频 -map 改为 [v_end_out]
        for k, a in enumerate(new_cmd):
            if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                new_cmd[k + 1] = "[v_end_out]"
                break
        if extra_in:
            pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
            if pos > 0 and pos + 1 < len(new_cmd):
                pos += 2  # 跳过 -i 与路径值
            new_cmd[pos:pos] = extra_in
        if is_copy:
            for k, a in enumerate(new_cmd):
                if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                    new_cmd[k + 1] = "libx265"
                    break
        new_cmd = self._ensure_end_video_map(new_cmd)
        return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

    @staticmethod
    def _is_video_map_target(tgt):
        """-map 目标是否指向视频流：`[label]`（排除 [a…]/[A…] 音频标签）或 `0:v` / `0:v?` / `1:v:2`。
        ⚠️ 必须容忍可选流后缀 `?`——转码页普通路径映射写的是 `-map 0:v?`，本方法曾用
        `parts[1] == "v"` 精确比对，导致 `0:v?` 被误判为"非视频映射"。"""
        if tgt.startswith("["):
            return not (tgt.startswith("[a") or tgt.startswith("[A"))
        if ":" in tgt:
            return tgt.split(":")[1].rstrip("?") == "v"
        return False

    def _find_end_output_pos(self, new_cmd):
        """找输出文件路径在命令中的位置（倒序第一个非选项参数，跳过 -filter_complex/-vf
        的滤镜图值——用户命令里 filter_complex 可能出现在输出文件之后）。返回索引。"""
        i = len(new_cmd) - 1
        while i >= 0:
            a = new_cmd[i]
            if not a.startswith("-") and not a.startswith("["):
                # 非选项参数：若它是 -filter_complex/-vf 的值（前一项是指令）则跳过
                if i > 0 and new_cmd[i - 1] in ("-filter_complex", "-vf"):
                    i -= 2
                    continue
                return i
            i -= 1
        return len(new_cmd) - 1

    def _ensure_end_video_map(self, new_cmd):
        """末端处理注入后确保输出映射完整：
        转换页普通命令**没有 -map**（默认 map 输入流），而 filter_complex 的输出流不会
        自动映射 → 注入的 [v_end_out] 会 unconnected 报错。此处扫描：已有视频 -map 则
        不动；否则在输出文件前显式补 `-map [v_end_out] -map 0:a?`（视频用合成结果、
        音频保持源可选流）。"""
        for k, a in enumerate(new_cmd):
            if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                return new_cmd  # 已有视频 -map
        out_idx = self._find_end_output_pos(new_cmd)
        new_cmd[out_idx:out_idx] = ["-map", "[v_end_out]", "-map", "0:a?"]
        return new_cmd

    def _adjust_end_concat_duration(self, new_cmd, main_dur, concat_sec, concat_path, concat_on=False):
        """concat 尾部素材启用时调整输出时长：
        - 仅当 concat_on=True 且 concat_path 有效时生效（否则直接返回，绝不干扰 -t/-shortest）
        - 移除 -shortest（concat 尾部为有限流，自然结束即可；-shortest 会被音频长度截断导致尾部丢失）
        - 图片尾部：必须给 -t = 主视频有效时长 + 尾部秒数（图片 -loop 无限/主视频无限循环时无天然终点）
        - 视频尾部：有限流自然结束，无需额外 -t（若已存在 -t 则保留用户手动时长）
        main_dur：主视频有效时长（封装页从轨道算、转换页从 settings 算；None/<=0 时默认 10s）。"""
        if not concat_on or not concat_path or not os.path.isfile(concat_path):
            return new_cmd
        is_img = os.path.splitext(concat_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp')
        if not is_img:
            # 视频尾部有限流：移除 -shortest 即可，不追加 -t
            if "-shortest" in new_cmd:
                new_cmd = [a for a in new_cmd if a != "-shortest"]
            return new_cmd
        # ---- 图片尾部：确保输出级有 -t = 主时长 + 尾部秒数 ----
        if main_dur is None or main_dur <= 0:
            # 图片主视频默认 10s（与 merge_build_cmd_list 的图片默认时长逻辑一致）
            main_dur = 10.0
        total = main_dur + concat_sec
        # 移除 -shortest
        new_cmd = [a for a in new_cmd if a != "-shortest"]
        # 找已有输出级 -t（排除输入级：输入级 -t 必在最后一个 -i 之前，输出级在最后一个 -i 之后）
        last_i = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=-1)
        t_idx = None
        for k, a in enumerate(new_cmd):
            if k <= last_i:
                continue
            if a == "-t" and k + 1 < len(new_cmd) and not new_cmd[k + 1].startswith("-"):
                t_idx = k
                break
        if t_idx is not None:
            new_cmd[t_idx + 1] = f"{total:.3f}"
        else:
            # 追加输出级 -t：插到输出文件路径前（跳过 -filter_complex/-vf 的滤镜图值）
            out_idx = self._find_end_output_pos(new_cmd)
            new_cmd[out_idx:out_idx] = ["-t", f"{total:.3f}"]
        with suppress(Exception):
            self._append_info_ui(f"[末端] 图片尾部已设置输出总时长 -t {total:.3f}s（主视频 {main_dur:.1f}s + 尾部 {concat_sec:.1f}s）")
        return new_cmd


