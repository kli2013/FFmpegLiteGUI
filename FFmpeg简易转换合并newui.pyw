    def set_settings(self, settings):
        self.loop_enabled.set(settings.get("loop_enabled", False))
        self.loop_mode.set(settings.get("loop_mode", "infinite"))
        self.loop_count.set(settings.get("loop_count", 3))
        self.show_start_var.set(str(settings.get("show_start", "")))
        self.show_end_var.set(str(settings.get("show_end", "")))
        self.show_cycle_var.set(str(settings.get("show_cycle", "")))
        self.show_once_var.set(str(settings.get("show_once", "")))
        self.chroma_enabled.set(settings.get("chroma_enabled", False))
        self.chroma_color.set(settings.get("chroma_color", "#3fff08"))
        sim = settings.get("chroma_similarity", 0.2)
        if sim <= 0:
            sim = 0.2
        self.chroma_similarity.set(sim)
        self.sim_entry_var.set(f"{sim:.4f}")
        blend = settings.get("chroma_blend", 0.1)
        self.chroma_blend.set(blend)
        self.blend_entry_var.set(f"{blend:.2f}")
        self.chroma_filter_type.set(settings.get("chroma_filter_type", "chromakey"))
        # 子视频音频模式恢复（英文键 → 中文显示）
        self.audio_mode.set(settings.get("audio_mode", "default") or "default")
        self.audio_mode_disp.set(self._audio_mode_v2d.get(self.audio_mode.get(), "默认"))
        self.color_swatch.config(bg=self.chroma_color.get())
        self._update_loop_state()
    
        # 新增透明度恢复
        self.alpha_enabled.set(settings.get("alpha_enabled", False))
        val = settings.get("alpha_value", 1.0)
        self.alpha_value.set(val)
        self.alpha_spinbox_var.set(f"{val:.1f}")

        # 外轮廓描边 恢复（2026-10-02；旧工程无此项 → 三个默认值，行为完全不变）
        self.outline_enabled.set(bool(settings.get("outline_enabled", False)))
        _oc = str(settings.get("outline_color", "#FFFFFF") or "#FFFFFF").strip()
        self.outline_color.set(_oc or "#FFFFFF")
        try:
            _ow = int(str(settings.get("outline_width", "4")).strip() or "4")
        except (ValueError, TypeError):
            _ow = 4
        self.outline_width.set(str(max(1, min(20, _ow))))

        # 遮罩 / 透明蒙版 恢复
        self.mask_enabled.set(settings.get("mask_enabled", False))
        self.mask_x.set(str(settings.get("mask_x", "0")))
        self.mask_y.set(str(settings.get("mask_y", "0")))
        self.mask_w.set(str(settings.get("mask_w", "100")))
        self.mask_h.set(str(settings.get("mask_h", "100")))
        self.mask_mode.set(settings.get("mask_mode", "outside"))
        # 2026-09-10：遮罩轨迹 + 边缘羽化 恢复
        self.mask_feather.set(str(settings.get("mask_feather", "0")))
        self.mask_traj_enabled.set(settings.get("mask_traj_enabled", False))
        self.mask_waypoints = list(settings.get("mask_waypoints") or [])
        # 2026-09-10：形状图恢复（type 非法值归位 bw）
        self.mask_png_enabled.set(bool(settings.get("mask_png_enabled", False)))
        self.mask_png_path.set(str(settings.get("mask_png_path", "") or ""))
        self.mask_png_invert.set(bool(settings.get("mask_png_invert", False)))
        _t_pt = str(settings.get("mask_png_type", "bw") or "bw")
        self.mask_png_type.set(_t_pt if _t_pt in ("bw", "alpha") else "bw")
        # 航点坐标系：随航点一起恢复（0/缺失 → 生成时按 MASK_TRAJ_CANVAS_* 兜底）
        try:
            self.mask_traj_canvas_w.set(int(settings.get("mask_traj_canvas_w", 0) or 0))
            self.mask_traj_canvas_h.set(int(settings.get("mask_traj_canvas_h", 0) or 0))
        except (ValueError, TypeError):
            self.mask_traj_canvas_w.set(0)
            self.mask_traj_canvas_h.set(0)
        # 2026-09-11：遮罩多形状列表（旧工程无此项→空列表→走旧单形状逻辑）
        self.mask_shapes = [s for s in (settings.get("mask_shapes") or []) if isinstance(s, dict)]

    def set_duration_info(self, duration_sec: Optional[float]):
        """设置时长显示信息"""
        if duration_sec is not None and duration_sec > 0:
            text = f"视频时长: {format_seconds_short(duration_sec)}"
            self.duration_label.config(text=text)
        else:
            self.duration_label.config(text="")

    def _update_loop_state(self):
        if self.loop_enabled.get():
            self.count_spinbox.config(state="readonly")
            self.loop_mode.set("count")
        else:
            self.count_spinbox.config(state="disabled")
            self.loop_mode.set("infinite")

# ================== 公共组件：叠加位置与画布偏移（仅轨道模式） ==================
class OverlayPositionFrame(ttk.LabelFrame):
    """
    叠加位置（子视频）或画布偏移（主视频）设置组件。
    仅用于画中画或水印模式，始终显示控件。
    """
    def __init__(self, master, app, mode='sub', track_idx=None, track_obj=None,
                 filt_frame=None, visual_callback=None,
                 page_scope="merge", ctx_main_file=None, ctx_main_settings=None, **kwargs):
        super().__init__(master, **kwargs)
        self.app = app
        self.mode = mode
        # 2026-09-23 修正：本组件不只封装页用——edit_video_settings 还把它用于
        # 转换页水印编辑器（page_scope='convert'）与队列任务水印（ctx_main_file=任务输入）。
        # 轨迹/坐标编辑器的主视频解析按此作用域取「本页自己的主视频」，两页绝不互相兜底。
        self.page_scope = page_scope or "merge"
        self.ctx_main_file = ctx_main_file      # 显式语境主视频（队列任务编辑=task.input）优先
        self.ctx_main_settings = ctx_main_settings  # 与 ctx_main_file 同源设置（队列=task.settings）
        self.track_idx = track_idx
        self.track_obj = track_obj
        self.filt_frame = filt_frame
        self.visual_callback = visual_callback
        self._controls = []
        self.blend_mode = tk.StringVar(value="normal")
        self._create_controls()

    def _create_controls(self):
        if self.mode == 'sub':
            self._create_sub_controls()
        else:
            self._create_main_controls()

    def _create_sub_controls(self):
        """子视频叠加位置控件"""
        self.overlay_enabled = tk.BooleanVar(value=True)
        top_row = ttk.Frame(self)
        top_row.pack(anchor=tk.W, pady=(0,5))
        cb = ttk.Checkbutton(top_row, text="启用叠加", variable=self.overlay_enabled)
        cb.pack(side=tk.LEFT)
        self._controls.append(cb)
        ttk.Label(top_row, text="混合模式:").pack(side=tk.LEFT, padx=(40,5))
        self._blend_display = {
            "normal": "正常(透明叠加)",
            "overlay": "叠加混合(blend)",
            "screen": "滤色(screen)",
            "multiply": "正片叠底(multiply)",
            "darken": "变暗(darken)",
            "lighten": "变亮(lighten)",
            "addition": "相加(addition)",
            "difference": "差值(difference)",
            "softlight": "柔光(softlight)",
            "hardlight": "强光(hardlight)",

            "average": "平均(average)",
            "burn": "颜色加深(burn)",
            "grainextract": "颗粒提取(grainextract)",
            "divide": "划分(divide)",
            "dodge": "颜色减淡(dodge)",
            "freeze": "冻结(freeze)",
            "exclusion": "排除(exclusion)",
            "extremity": "极值(extremity)",
            "glow": "发光(glow)",
            "hardmix": "实色混合(hardmix)",
            "heat": "加热(heat)",
            "linearlight": "线性光(linearlight)",
            "multiply128": "正片叠底128(multiply128)",
            "grainmerge": "颗粒合并(grainmerge)",
            "phoenix": "凤凰(phoenix)",
            "pinlight": "点光(pinlight)",
            "reflect": "反射(reflect)",
            "subtract": "相减(subtract)",
            "vividlight": "亮光(vividlight)",

             #位运算类（and/or/xor/negation）是逐像素按位逻辑运算，8-bit 下效果很怪（基本是黑白噪点感），合法但实用价值低
            "or": "按位或(or)",
            "and": "按位与(and)",
            "xor": "按位异或(xor)",
            "negation": "反相(negation)",

        }
        blend_values = list(self._blend_display.keys())
        blend_labels = [self._blend_display[k] for k in blend_values]
        self.blend_mode_display = tk.StringVar(value=self._blend_display.get(self.blend_mode.get(), blend_labels[0]))
        blend_cb = ttk.Combobox(top_row, textvariable=self.blend_mode_display, width=18,
                               values=blend_labels, state="readonly")
        blend_cb.pack(side=tk.LEFT, padx=(0,5))

        self.overlay_free_layout = tk.BooleanVar(value=False)
        free_cb = ttk.Checkbutton(top_row, text="放开边界", variable=self.overlay_free_layout)
        free_cb.pack(side=tk.LEFT, padx=10)
        ToolTip(free_cb,
                "放开边界限制（自由布局）：允许子视频比主视频大、可拖出主画面之外（编辑器不滚动，超出部分自然出框）。\n"
                "位置/大小原样送入 ffmpeg，最终输出画布=主视频（超出部分被主帧裁掉）；主视频启用偏移/pad 时底=pad 画布。",
                wraplength=400)
        self._controls.append(free_cb)

        def _on_blend_selected(evt=None):
            sel = blend_cb.get()
            if sel in blend_labels:
                self.blend_mode.set(blend_values[blend_labels.index(sel)])
        blend_cb.bind("<<ComboboxSelected>>", _on_blend_selected)
        ToolTip(blend_cb, "「正常(透明叠加)」=常规 overlay：子视频保留自身透明、叠在主画面上层，位置随 X/Y。其余为 Photoshop 式混合算法(blend)：子视频按 X/Y 摆放、其外部区域以该模式中性色填充后再对整帧按算法混合，与「正常」视觉完全不同。", wraplength=440)
        self._controls.append(top_row)

        # X/Y 位置：2 行（标签行 + 编辑框行）。用 grid 分两列，
        # 第 1 列放 X 标签/编辑框，第 2 列放 Y 标签/编辑框，
        # 列各自左对齐 → 右侧 Y 标签与 Y 编辑框天然左对齐（不受 X 宽度影响）。
        pos_frame = ttk.Frame(self)
        pos_frame.pack(anchor=tk.W, fill=tk.X, pady=(2, 4))
        self.overlay_x = tk.StringVar(value=DEFAULT_OVERLAY_X)
        self.overlay_y = tk.StringVar(value=DEFAULT_OVERLAY_Y)
        ttk.Label(pos_frame, text="X 位置 (支持表达式，如 W-w-10):").grid(row=0, column=0, sticky="w")
        ttk.Label(pos_frame, text="Y 位置 (支持表达式):").grid(row=0, column=1, sticky="w", padx=(24, 0))
        x_entry = ttk.Entry(pos_frame, textvariable=self.overlay_x, width=28)
        x_entry.grid(row=1, column=0, sticky="w", pady=2)
        y_entry = ttk.Entry(pos_frame, textvariable=self.overlay_y, width=28)
        y_entry.grid(row=1, column=1, sticky="w", padx=(24, 0), pady=2)
        self._controls.extend([pos_frame, x_entry, y_entry])

        # 快速预设
        preset_frame = ttk.LabelFrame(self, text="快速预设", padding="3")
        preset_frame.pack(fill=tk.X, pady=5)
        self._controls.append(preset_frame)

        positions = {
            "左上角": ("10", "10"),
            "右上角": (DEFAULT_OVERLAY_X, "10"),
            "左下角": ("10", DEFAULT_OVERLAY_Y),
            "右下角": (DEFAULT_OVERLAY_X, DEFAULT_OVERLAY_Y),
            "居中": ("(W-w)/2", "(H-h)/2")
        }
        def set_position(x_val, y_val):
            self.overlay_x.set(x_val)
            self.overlay_y.set(y_val)
        for text, (x_val, y_val) in positions.items():
            btn = ttk.Button(preset_frame, text=text,
                             command=lambda x=x_val, y=y_val: set_position(x, y))
            btn.pack(side=tk.LEFT, padx=2, pady=2)
            self._controls.append(btn)

        # 可视化编辑
        def open_visual():
            if alert_if(not self.overlay_enabled.get(), "提示", "请先勾选「启用叠加」再使用可视化编辑功能。", 'info'):
                return
            if self.visual_callback is not None:
                self.visual_callback()
            elif self.app and self.track_idx is not None:
                parent_win = self.winfo_toplevel()
                _free = self.overlay_free_layout.get()
                self.app.open_visual_overlay_editor(
                    self.track_idx,
                    ov_x_var=self.overlay_x,
                    ov_y_var=self.overlay_y,
                    ov_angle_var=getattr(self, "rotate_angle", None),
                    filt_frame=self.filt_frame,
                    parent=parent_win,
                    free_layout=_free
                )
            else:
                messagebox.showinfo("提示", "无法启动可视化编辑：缺少轨道索引或回调")
        btn = ttk.Button(preset_frame, text="🎨 可视化编辑坐标", command=open_visual)
        btn.pack(side=tk.LEFT, padx=5, pady=2)
        self._controls.append(btn)

        # 持续旋转（绕中心动态旋转）——仅子视频（水印/画中画）
        spin_frame = ttk.Frame(self)
        spin_frame.pack(anchor=tk.W, fill=tk.X, pady=(4, 2))
        self.spin_enabled = tk.BooleanVar(value=False)
        spin_cb = ttk.Checkbutton(spin_frame, text="持续旋转 (绕中心)", variable=self.spin_enabled)
        spin_cb.pack(side=tk.LEFT)
        self._controls.append(spin_cb)
        ttk.Label(spin_frame, text="转速 (度/秒):").pack(side=tk.LEFT, padx=(12, 2))
        self.spin_speed = tk.DoubleVar(value=60.0)
        spin_sb = ttk.Spinbox(spin_frame, from_=1, to=720, increment=5, width=6,
                              textvariable=self.spin_speed)
        spin_sb.pack(side=tk.LEFT)
        self._controls.append(spin_sb)
        ToolTip(spin_cb,
                "让水印/画中画在叠加过程中绕自身中心持续旋转（动态动画，不是单次旋转）。\n"
                "转速单位为度/秒，例如 60 = 每 6 秒转一圈（angle = 转速×π/180×t）。\n"
                "旋转后边角填充为透明（c=black@0），与现有透明/遮罩/放开边界管线兼容。\n"
                "注意：水印本身不宜过大，旋转包围盒为对角线尺寸，过大会被主画面边缘裁切。",
                wraplength=420)

        # ---- 轨迹控制（动态水印：位置随时间循环移动） ----
        # move 字段独立持久化；命令生成时由 build_move_xy_expr 生成 x/y 表达式，
        # 不覆盖用户设置的 overlay_x/overlay_y 基准。
        self.move_mode = tk.StringVar(value="")          # "" / h / v / diamond / corners
        self.move_cycle = tk.DoubleVar(value=4.0)        # 周期（秒，往返/菱形）
        self.move_amp = tk.StringVar(value="W*0.1")     # 幅度/尺寸（可填像素或 W*0.1 相对式）
        self.move_dwell = tk.DoubleVar(value=2.0)        # 四角跳跃每点停留（秒）
        self.move_margin = tk.StringVar(value="W*0.03") # 四角跳跃边距（像素或相对式）
        self.move_waypoints = []   # 列表轨迹（move_mode=="waypoints" 时生效）
        ttk.Button(spin_frame, text="轨迹控制...", command=self._open_trajectory_dialog
                   ).pack(side=tk.LEFT, padx=(16, 0))

        # ---- 静态角度旋转（自由角度）：透明层上绕中心旋转，边角透明，与文字水印旋转一致 ----
        _lbltt32 = ttk.Label(spin_frame, text="角度:")
        _lbltt32.pack(side=tk.LEFT, padx=(16, 2))
        self.rotate_angle = tk.DoubleVar(value=0.0)
        rot_sb = ttk.Spinbox(spin_frame, from_=-180, to=180, increment=1, width=6,
                             textvariable=self.rotate_angle)
        rot_sb.pack(side=tk.LEFT)
        self._controls.append(rot_sb)
        ToolTip(_lbltt32,
                "静态角度旋转（自由角度，度，支持负角）。\n"
                "与文字水印旋转一致：在透明层上绕自身中心旋转，边角填充透明(c=black@0)，\n"
                "叠加到主视频不会出现黑色裁切块。\n"
                "与「持续旋转」可叠加：先转静态角度、再持续旋转。\n"
                "注意：旋转包围盒为对角线尺寸，水印不宜过大，否则会被主画面边缘裁切。",
                wraplength=420)

    def _edit_wp_point(self, row_idx, which, cur_x, cur_y, cur_angle, apply_xy, apply_angle, t0=0.0,
                       active_flag=None, w=None):
        """列表轨迹行的坐标可视化编辑（单框，起点/终点各一个入口按钮）。
        2026-09-02：旋转手柄拖拽经 angle_cb 写回航点 ra/rb（选起点→ra，选终点→rb）。
        t0：背景帧取帧时间（该航点自身 start / start+dur），与「位置、尺寸、旋转」关键帧一致。"""
        app = self.app
        if app is None:
            apply_xy(cur_x, cur_y)
            return
        mw = mh = None
        _mf = ""
        _bg_file = ""            # 背景帧源（封装页=主视频轨道文件，转换页=input_file）
        _bg_offset = (0, 0)      # pad 时主视频内容偏移（背景帧按此摆放）
        _bg_render_size = None   # pad 时主视频实际渲染尺寸（画布含 pad 留黑）
        _src_from_merge = False   # ⚠️ 2026-08-27 修复：主视频画布设置的来源（封装页/转换页）
        try:
            # 2026-09-23 修正：OverlayPositionFrame 不只封装页用——edit_video_settings 还把
            # 它用于转换页水印编辑器（page_scope='convert'）与队列任务水印（ctx_main_file）。
            # 主视频解析按宿主语境取「本页自己的主视频」，两页绝不互相兜底：
            #   1) ctx_main_file（队列任务编辑显式传入的 task.input）优先；
            #   2) 否则按 page_scope 取本页主视频（'merge'=封装页主视频 / 'convert'=input_file）。
            # 本页没有主视频 → 提示并退出（等价纯黑），绝不拿另一页的文件抽帧。
            if self.ctx_main_file:
                _mf = self.ctx_main_file if os.path.exists(self.ctx_main_file) else ""
                _src_from_merge = False
                _no_video_hint = "未找到该任务的主视频文件，请确认任务输入有效"
            else:
                _pf, _unused = _page_main_video(app, self.page_scope)
                _mf = _pf or ""
                _src_from_merge = bool(_mf and os.path.exists(_mf)) and self.page_scope == "merge"
                _no_video_hint = ("请先在封装页设置主视频后再使用可视化坐标编辑"
                                  if self.page_scope == "merge" else
                                  "请先在转换页设置输入文件后再使用可视化坐标编辑")
            if alert_if(not _mf, "提示", _no_video_hint, 'info'):
                return
            _wd, _hd = app._cached_video_dimensions(_mf)
            mw, mh = _wd, _hd
            if _src_from_merge:
                # ⚠️ 2026-08-27 修复（三连，用户拍板照抄 open_visual_overlay_editor）：
                # 封装页子视频列表轨迹坐标编辑的画布/背景帧语义与子视频位置编辑器完全一致：
                #   · 画布 = _get_canvas_size(main_track)：**pad 优先**（pad 时画布>主视频、
                #     主视频内容按 offset 摆放、超出黑色）；否则 crop→rotate→scale 渲染尺寸。
                #   · 背景帧 = main_track.file_path + main_offset + main_render_size
                #     （_generic_overlay_editor 按 offset 摆放主视频内容，超出黑色）。
                # 之前只按 merge_video 源旋转尺寸算画布，pad 场景画布/背景全错（黑边/错位）。
                try:
                    _tracks = app._get_enabled_video_tracks() if hasattr(app, "_get_enabled_video_tracks") else []
                    if _tracks:
                        _mt = _tracks[0]
                        if hasattr(app, "_get_canvas_size"):
                            _cw, _ch = app._get_canvas_size(_mt)
                            if _cw and _ch:
                                mw, mh = int(_cw), int(_ch)
                        if hasattr(app, "_get_video_render_size"):
                            _rnd = app._get_video_render_size(_mt)
                            if _rnd and _rnd[0] and _rnd[1]:
                                _bg_render_size = (int(_rnd[0]), int(_rnd[1]))
                        if _mt.enc_settings.get("pad_enabled", False):
                            try:
                                _ox = safe_eval_expr(str(_mt.enc_settings.get("offset_x", "0") or "0"),
                                                     {"W": mw, "H": mh}) or 0
                                _oy = safe_eval_expr(str(_mt.enc_settings.get("offset_y", "0") or "0"),
                                                     {"W": mw, "H": mh}) or 0
                                _bg_offset = (int(_ox), int(_oy))
                            except Exception:
                                pass
                        _bg_file = _mt.file_path
                except Exception:
                    pass
                if not _bg_file:
                    _bg_file = _mf
            else:
                # 转换页/队列：渲染画布 = 本语境主视频设置（队列=ctx_main_settings=task.settings，
                # 转换页=get_current_settings()，主视频 crop/scale/rotate 后），背景帧 = 本语境主视频。
                # ⚠️ 切勿从 self.filt_frame 读设置——OverlayPositionFrame
                # 的 filt_frame 是【子视频/水印自己】的滤镜框架（scale_width/height=子视频尺寸），
                # 上一版误用导致画布变成子视频缩放大小。正确来源：语境设置 +
                # app._main_render_size（与正式命令 _compute_output_canvas 同源）。
                _bg_file = _mf
                if getattr(app, "_main_render_size", None):
                    try:
                        if self.ctx_main_settings is not None:
                            _ms0 = (self.ctx_main_settings
                                    if isinstance(self.ctx_main_settings, dict)
                                    else dict(self.ctx_main_settings))
                        else:
                            _ms0 = app.get_current_settings() if hasattr(app, "get_current_settings") else {}
                        _rw0, _rh0 = app._main_render_size(_ms0 or {}, _mf)
                        if _rw0 and _rh0:
                            mw, mh = _rw0, _rh0
                    except Exception:
                        pass
        except Exception:
            pass
        mw = mw or 1280
        mh = mh or 720
        # ⚠️ 2026-09-11 修复（轨迹坐标编辑器尺寸取错）：
        #   原代码直接读 ff.scale_height，子视频「320宽 + 高度自动」时该值为空 → 兜底 120
        #   → 得到错误 320x120，必须先去「可视化位置窗口」确认一次把 exact 尺寸写回才正确。
        #   现改为与「可视化位置窗口」(open_visual_overlay_editor → _get_video_render_size
        #   → compute_final_size_with_order) 完全同源地解析真实渲染尺寸，「width 模式 / 高度
        #   自动」按源比例推得真实高度（如 320x569），一打开即正确。
        wm_w = wm_h = None
        ff = self.filt_frame
        # 路径①（最优）：有轨道对象时直接问 app 要渲染尺寸（含 crop→rotate→scale）
        _to0 = getattr(self, "track_obj", None)
        if _to0 is not None and hasattr(app, "_get_video_render_size"):
            try:
                _rnd0 = app._get_video_render_size(_to0, None)
                if _rnd0 and _rnd0[0] and _rnd0[1]:
                    wm_w, wm_h = int(_rnd0[0]), int(_rnd0[1])
            except Exception:
                wm_w = wm_h = None
        # 路径②（兜底同源）：用 filt_frame 设置 + 子视频源文件比例自算
        if (not wm_w or not wm_h) and ff is not None:
            _sub_f = ""
            try:
                _sub_f = (getattr(ff, "current_file", "") or "").strip()
            except Exception:
                _sub_f = ""
            if not _sub_f:
                # 二级来源：filt_frame 绑定的轨道对象（set_track 时会带 file_path）
                try:
                    _ct = getattr(ff, "current_track", None)
                    if _ct is not None:
                        _sub_f = (getattr(_ct, "file_path", "") or "").strip()
                except Exception:
                    pass
            if not _sub_f:
                # 三级来源：本框自己的 track_obj（部分调用点会传，防未来构造点变化）
                try:
                    _to2 = getattr(self, "track_obj", None)
                    if _to2 is not None:
                        _sub_f = (getattr(_to2, "file_path", "") or "").strip()
                except Exception:
                    pass
            if _sub_f and os.path.exists(_sub_f):
                try:
                    _settings = {
                        "crop_enabled": ff.crop_enabled.get(),
                        "crop_width": ff.crop_width.get(),
                        "crop_height": ff.crop_height.get(),
                        "scale_enabled": ff.scale_enabled.get(),
                        "scale_method": ff.scale_method.get(),
                        "scale_width": ff.scale_width.get(),
                        "scale_height": ff.scale_height.get(),
                        "rotate": ff.rotate.get(),
                    }
                    _sw, _sh = app._cached_video_dimensions(_sub_f)
                    if _sw and _sh:
                        _fw, _fh = app.compute_final_size_with_order(int(_sw), int(_sh), _settings)
                        if _fw and _fh:
                            wm_w, wm_h = int(_fw), int(_fh)
                except Exception:
                    wm_w = wm_h = None
        if not wm_w or not wm_h:
            # 兜底：直接读 filt_frame 控件（scale_width / scale_height）。⚠️ 若 width 模式
            # 且高度为空，仍需按比例推高，否则会退回错误 320x120（用户原始问题）。
            wm_w = wm_h = 120
            if ff is not None:
                with suppress(Exception):
                    wm_w = int(float(ff.scale_width.get() or 0) or wm_w)
                try:
                    wm_h = int(float(ff.scale_height.get() or 0) or 0) or 0
                except Exception:
                    wm_h = 0
                if not wm_h:
                    # 高度自动：取子视频源比例（width→高、height→宽）
                    try:
                        _m = ff.scale_method.get()
                    except Exception:
                        _m = "width"
                    try:
                        _cf = (getattr(ff, "current_file", "") or "").strip()
                        _sw2, _sh2 = app._cached_video_dimensions(_cf) if _cf else (None, None)
                        if _sw2 and _sh2:
                            if _m == "width":
                                # 宽已定，按源比例推高
                                wm_h = max(1, int(round(wm_w * _sh2 / _sw2)))
                            elif _m == "height":
                                _hh = int(float(ff.scale_height.get() or 0) or 0)
                                if _hh > 0:
                                    wm_w = max(1, int(round(_hh * _sw2 / _sh2)))
                                    wm_h = _hh
                    except Exception:
                        pass
                # 仍推不出高度 → 回退安全值 120（不得留 0，否则编辑器盒子高度为 0）
                if not wm_h:
                    wm_h = 120
        # 背景帧预处理：主视频 crop/rotate（防「渲染尺寸画布+完整原帧=变形」，2026-08-28）
        _bg_filter = None
        try:
            if _src_from_merge:
                _gt = getattr(app, "_get_enabled_video_tracks", None)
                if _gt:
                    _t0 = _gt()
                    if _t0:
                        _bg_filter = _main_bg_pre_filter(_t0[0].enc_settings)
            else:
                _ms0 = app.get_current_settings() if hasattr(app, "get_current_settings") else None
                if _ms0:
                    _bg_filter = _main_bg_pre_filter(_ms0)
        except Exception:
            _bg_filter = None
        vx = tk.StringVar(value=f"{int(round(cur_x)):d}")
        vy = tk.StringVar(value=f"{int(round(cur_y)):d}")
        def _wp_on_apply(nx, ny, nw, nh, ncw, nch):
            # 2026-09-14 改（起点/终点各存各的大小）：重绘/缩放 → 按【当前活动端】写回
            # 该端缩放倍率 sa/sb，不再改全局 scale_width/height。
            #   基准尺寸 wm_w/wm_h 是「子视频整体渲染尺寸」，sa/sb 是相对它的倍率（滤镜侧
            #   build_waypoint_expr 的 zoom 每段线性插值，默认 1.0 → 旧工程行为不变）。
            #   整体基准尺寸的设定权交给「可视化位置窗口」(open_visual_overlay_editor)：
            #   本窗口只调该端相对大小，故重绘不再污染全局尺寸（原「Alt 重绘统一两端」根因）。
            vx.set(str(int(round(nx)))); vy.set(str(int(round(ny))))
            # 坐标顺带落盘 + 刷新列表（列表「起始/结尾缩放」两列随之立即更新）。
            # 与 on_drag_commit 同一函数（_open_editor 的 _apply_xy：按活动端写 xa/ya|xb/yb + _refresh）。
            try:
                apply_xy(float(nx), float(ny))
            except (ValueError, TypeError):
                pass
            _ns = None
            if (w is not None) and (active_flag is not None) and wm_w:
                try:
                    _ns = float(nw) / float(wm_w)
                except (TypeError, ValueError, ZeroDivisionError):
                    _ns = None
                if _ns and _ns > 0:
                    with suppress(Exception):
                        if w.get("mode") == "end":
                            # 终点行：无独立结尾端（_se_can=False）→ sa/sb 同值，
                            # 与 _apply_angle 的 ra/rb 同值策略一致。
                            w["sa"] = _ns
                            w["sb"] = _ns
                        elif active_flag[0] == "end":
                            w["sb"] = _ns
                        else:
                            w["sa"] = _ns
            # 刷新命令预览（转换页 update_command_preview / 封装页 merge_update_command_preview）：
            # sa/sb 变化即 zoom 表达式变化，必须重生成命令串。
            _app = self.app
            if _app is not None:
                for _m in ("update_command_preview", "merge_update_command_preview"):
                    _rf = getattr(_app, _m, None)
                    if _rf is not None:
                        with suppress(Exception):
                            _rf()
            with suppress(Exception):
                self.app._append_info_ui(
                    f"[轨迹] 该端尺寸已更新: {nw}x{nh}"
                    + (f"（缩放倍率 {_ns:.4g}）" if _ns else ""))
        # 起始/结尾双端（条件调用）：仅当调用方传入 w + active_flag 时启用
        # （active_flag 由 _open_editor 的 _active 可变列表提供，翻转即切写回目标端）
        start_end = None
        if w is not None and active_flag is not None:
            _se_can = (w.get("mode") != "end")   # 2026-09-12 修复：按数据模型判定——坐标相等(如粘贴连通)≠无第二端；仅终点行(mode=end)无独立结尾
            def _se_scale(key):
                # 2026-09-14：安全取该端缩放倍率（缺省/非法/非正 → 1.0=基准尺寸，旧工程行为不变）
                _s = _opt_float(w.get(key, 1.0) or 1.0, 1.0)
                return _s if _s > 0 else 1.0
            def _se_read(end):
                # 2026-09-14 修复（起点/终点尺寸被「统一成最新大小」）：
                #   尺寸按【端点】返回各自缩放后的内容盒 —— wm_w/wm_h=全局基准尺寸，
                #   sa/sb=该端缩放倍率。切换端点时尺寸随之改变，与角度 ra/rb 对称。
                #   原实现两端都返回同一个 wm_w/wm_h → 切端尺寸恒等；配合 _wp_on_apply
                #   写全局尺寸 → Alt 重绘一次就把两端统一（用户实测根因）。
                #   倍率取整到像素：sa = round(wm_w*sa)/wm_w，反复开关会收敛到稳定点，不累积漂移。
                if end == "end":
                    _sk = _se_scale("sb")
                    return (w.get("xb", 0), w.get("yb", 0),
                            int(round(wm_w * _sk)), int(round(wm_h * _sk)), w.get("rb", 0))
                _sk = _se_scale("sa")
                return (w.get("xa", 0), w.get("ya", 0),
                        int(round(wm_w * _sk)), int(round(wm_h * _sk)), w.get("ra", 0))
            def _se_switch(end):
                active_flag[0] = end
            start_end = {"active": ("end" if active_flag[0] == "end" else "start"),
                         "read": _se_read, "on_switch": _se_switch, "can_compare": _se_can}
        # 2026-09-14：初始矩形=当前活动端缩放后的实际内容盒（否则滑块初始恒显 100%，
        # 与该端真实倍率不一致；切到另一端时尺寸由 start_end["read"](_se_read) 重载）。
        _init_s = 1.0
        if (w is not None) and (active_flag is not None):
            _init_s = _opt_float(w.get("sb" if active_flag[0] == "end" else "sa", 1.0) or 1.0, 1.0)
            if _init_s <= 0:
                _init_s = 1.0
        app.open_watermark_overlay_editor(
            mw, mh, max(int(round(wm_w * _init_s)), 10), max(int(round(wm_h * _init_s)), 10), vx, vy,
            # 2026-09-14：内容源=全局基准尺寸 → 启用「缩放 (倍率)」滑块（100%=当前基准尺寸，
            # 与「位置、尺寸、旋转」画布编辑器同口径）。重绘/滑块 → 按端写 sa/sb（见 _wp_on_apply）。
            content_src_w=wm_w, content_src_h=wm_h,
            scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
            watermark_dict=None, filt_frame=None, parent=self.winfo_toplevel(),
            # 2026-09-12 修复：原先硬编码 False → 面板上勾了「放开边界」，轨迹列表里
            # 起始/结尾坐标编辑器仍是收边版本（拖不出主画面、不能比主视频大），勾选形同无效。
            # 与主 可视化编辑坐标 入口（_create_sub_controls 内 open_visual_overlay_editor）同口径。
            free_layout=bool(getattr(self, "overlay_free_layout", None)
                             and self.overlay_free_layout.get()),
            main_video_file=_bg_file,
            main_offset=_bg_offset, main_render_size=_bg_render_size,
            bg_pre_filter=_bg_filter,
            init_angle=(cur_angle or 0.0),   # 2026-09-02：航点旋转接回 ra/rb
            angle_cb=apply_angle,   # 2026-09-02：旋转手柄拖拽 → 写回航点 ra/rb
            on_apply=_wp_on_apply,  # 2026-09-14：重绘/缩放 → 按端写回缩放倍率 sa/sb 并刷新
            on_drag_commit=apply_xy,  # 2026-09-03：拖拽松手即把坐标写回航点并实时刷新列表
            initial_time=t0,        # 背景帧=该航点自身时间（起始/结尾），与位置尺寸旋转列表一致
            start_end=start_end)
        try:
            apply_xy(float(vx.get()), float(vy.get()))
        except (ValueError, TypeError):
            pass

    def _open_trajectory_dialog(self):
        """轨迹控制弹窗：预设动效 + 列表轨迹（与文字水印共用公共实现 _trajectory_dialog）。"""
        _vf = ""
        _ffm = _fprobe = None
        if self.app is not None:
            try:
                # 2026-09-23 修正：按宿主语境取本页主视频（转换页水印编辑器/队列任务也会
                # 实例化本组件），绝不跨页兜底：队列=ctx_main_file（任务输入）优先，
                # 否则 page_scope（'merge'=封装页 / 'convert'=转换页 input_file）。
                if self.ctx_main_file and os.path.exists(self.ctx_main_file):
                    _vf = self.ctx_main_file
                else:
                    _pf, _unused = _page_main_video(self.app, self.page_scope)
                    _vf = _pf or ""
            except Exception:
                _vf = ""
            _ffm = getattr(self.app, "ffmpeg_cmd", None)
            _fprobe = getattr(self.app, "ffprobe_cmd", None)
        _trajectory_dialog(
            self,
            {"move_mode": self.move_mode.get(),
             "move_cycle": self.move_cycle.get(),
             "move_dwell": self.move_dwell.get(),
             "move_margin": self.move_margin.get(),
             "move_waypoints": self.move_waypoints},
            lambda v: (self.move_mode.set(v["move_mode"]),
                       self.move_cycle.set(v["move_cycle"]),
                       self.move_dwell.set(v["move_dwell"]),
                       self.move_margin.set(v["move_margin"]),
                       list(v["move_waypoints"]) if v.get("move_waypoints") is not None else None),
            edit_cb=self._edit_wp_point,
            canvas_w=1280, canvas_h=720,
            video_file=_vf, ffmpeg_cmd=_ffm, ffprobe_cmd=_fprobe,
            app=self.app)

    def _create_main_controls(self):
        """主视频画布偏移控件 - 左右分栏（左侧偏移设置，右侧快捷操作）"""
        # 主容器：水平分割
        main_container = ttk.Frame(self)
        main_container.pack(fill=tk.BOTH, expand=True)
    
        # ---------- 左容器：偏移设置 ----------
        left_frame = ttk.Frame(main_container)
        left_frame.pack(side=tk.LEFT, fill=tk.Y, expand=False)
    
        self.pad_enabled = tk.BooleanVar(value=False)
        cb = ttk.Checkbutton(left_frame, text="启用画布偏移", variable=self.pad_enabled)
        cb.pack(anchor=tk.W, pady=(0,5))
        self._controls.append(cb)
    
        w_frame = ttk.Frame(left_frame)
        w_frame.pack(fill=tk.X, pady=2)
        ttk.Label(w_frame, text="画布宽度:").pack(side=tk.LEFT)
        self.pad_width = tk.StringVar(value="")
        entry = ttk.Entry(w_frame, textvariable=self.pad_width, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([w_frame, entry])
    
        if self.app:
            def fetch_size():
                # 2026-09-23：按宿主页取本页主视频（不跨页兜底，拿到另一页的视频尺寸）；
                # 画布偏移控件只出现在封装页轨道设置 → page_scope 恒为 'merge'。
                main_file, _unused = _page_main_video(self.app, self.page_scope)
                main_file = main_file or ""
                if alert_if(not main_file or not os.path.exists(main_file), "错误", "未找到主视频文件，请先在封装页设置主视频", 'error'):
                    return
                w, h = self.app._get_video_dimensions_cached(main_file)
                if w is not None and h is not None:
                    self.pad_width.set(str(w))
                    self.pad_height.set(str(h))
                    self.app._append_info_ui(f"[尺寸获取] 获取到主视频尺寸: {w}x{h}")
                else:
                    messagebox.showerror("错误", f"无法获取视频尺寸，请检查 ffprobe 是否可用或文件是否正常。")
            btn = ttk.Button(w_frame, text="获取尺寸", command=fetch_size)
            btn.pack(side=tk.LEFT, padx=5)
            self._controls.append(btn)
    
        h_frame = ttk.Frame(left_frame)
        h_frame.pack(fill=tk.X, pady=2)
        ttk.Label(h_frame, text="画布高度:").pack(side=tk.LEFT)
        self.pad_height = tk.StringVar(value="")
        entry = ttk.Entry(h_frame, textvariable=self.pad_height, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([h_frame, entry])
    
        ox_frame = ttk.Frame(left_frame)
        ox_frame.pack(fill=tk.X, pady=2)
        ttk.Label(ox_frame, text="偏移 X:").pack(side=tk.LEFT)
        self.offset_x = tk.StringVar(value="0")
        entry = ttk.Entry(ox_frame, textvariable=self.offset_x, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([ox_frame, entry])
    
        oy_frame = ttk.Frame(left_frame)
        oy_frame.pack(fill=tk.X, pady=2)
        ttk.Label(oy_frame, text="偏移 Y:").pack(side=tk.LEFT)
        self.offset_y = tk.StringVar(value="0")
        entry = ttk.Entry(oy_frame, textvariable=self.offset_y, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([oy_frame, entry])
    
        def open_pad_editor():
            if alert_if(not self.pad_enabled.get(), "提示", "请先勾选「启用画布偏移」再使用可视化编辑功能。", 'info'):
                return
            if self.app and self.track_idx is not None:
                parent_win = self.winfo_toplevel()
                self.app.open_visual_pad_editor(
                    self.track_idx,
                    self.pad_width,
                    self.pad_height,
                    self.offset_x,
                    self.offset_y,
                    live_filt_frame=self.filt_frame, 
                    parent=parent_win
                )
            else:
                messagebox.showinfo("提示", "无法启动可视化编辑：缺少轨道索引")
        btn = ttk.Button(left_frame, text="🎨 可视化编辑画布偏移", command=open_pad_editor)
        btn.pack(anchor=tk.W, pady=5)
        self._controls.append(btn)
    
        # ---------- 右容器：快捷操作 ----------
        right_frame = ttk.Frame(main_container)
        right_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True, padx=(10, 0))
    

        row1 = ttk.Frame(right_frame)
        row1.pack(anchor=tk.W, fill=tk.X, pady=(0, 5))
        
        # --- 取消子视频缩放/裁剪 ---
        btn_reset_sub = ttk.Button(
            row1,
            text="取消子视频缩放/裁剪",
            command=self._reset_sub_video_filters,
            width=18
        )
        btn_reset_sub.pack(side=tk.LEFT, padx=(0, 5))
        ToolTip(btn_reset_sub,
                "将所有子视频（非主视频）的「启用缩放」和「启用裁剪」复选框取消勾选，\n"
                "恢复子视频为原始尺寸。")

        # --- 统一坐标（左 / 上） ---
        btn_unify_xy = ttk.Button(row1, text="统一坐标", command=self._apply_unified_coords, width=10)
        btn_unify_xy.pack(side=tk.LEFT, padx=(12, 2))
        self.unify_x_var = tk.StringVar(value="")
        ttk.Label(row1, text="左:").pack(side=tk.LEFT)
        entry_unify_x = ttk.Entry(row1, textvariable=self.unify_x_var, width=6)
        entry_unify_x.pack(side=tk.LEFT, padx=2)
        self.unify_y_var = tk.StringVar(value="")
        ttk.Label(row1, text="上:").pack(side=tk.LEFT, padx=(6, 0))
        entry_unify_y = ttk.Entry(row1, textvariable=self.unify_y_var, width=6)
        entry_unify_y.pack(side=tk.LEFT, padx=2)
        ToolTip(btn_unify_xy,
                "把所有子视频（非主视频）的叠加位置统一设为这里填的坐标，主视频不动。\n"
                "左 = 距左边的距离，上 = 距上边的距离，两栏留空的那一项保持原值不变。\n"
                "可直接填数字，也支持 ffmpeg 表达式（如 W-w-10 表示贴右边留 10 像素）。\n"
                "典型用途：先把所有子视频排到同一位置，再逐个微调或做重叠对比。")

        row2 = ttk.Frame(right_frame)
        row2.pack(anchor=tk.W, fill=tk.X, pady=(0, 5))

        # --- 统一高度 ---
        self.unify_height_var = tk.StringVar(value="")
        btn_unify_h = ttk.Button(
            row2,
            text="统一高度",
            command=self._apply_unified_height,
            width=10
        )
        btn_unify_h.pack(side=tk.LEFT)
        spin_h = ttk.Spinbox(row2, from_=1, to=9999, width=6, textvariable=self.unify_height_var)
        spin_h.pack(side=tk.LEFT, padx=2)
        
        # --- 统一宽度 ---
        self.unify_width_var = tk.StringVar(value="")
        btn_unify_w = ttk.Button(
            row2,
            text="统一宽度",
            command=self._apply_unified_width,
            width=10
        )
        btn_unify_w.pack(side=tk.LEFT, padx=2)
        spin_w = ttk.Spinbox(row2, from_=1, to=9999, width=6, textvariable=self.unify_width_var)
        spin_w.pack(side=tk.LEFT, padx=2)
    

        # ---- 修改子视频编码 ----
        row3 = ttk.Frame(right_frame)
        row3.pack(anchor=tk.W, fill=tk.X, pady=(0, 5))
        btn_set_sub_encoder = ttk.Button(
            row3,
            text="修改子视频编码",
            command=self._set_sub_video_encoder,
            width=18
        )
