        ttk.Label(main_frame, text=label_text).pack(anchor=tk.W, padx=5, pady=(0, 0))
    
        # ---- 文件列表容器（无边框） ----
        list_container = ttk.Frame(main_frame)
        list_container.pack(fill=tk.BOTH, expand=True, padx=(5,0), pady=2)
    
