        self.nudge_row = nudge_row
        ttk.Label(nudge_row, text="微调").pack(side=tk.LEFT, padx=(0, 6))
        _ntip = ("按秒微调当前位置：0.05 精修、0.1 中档、0.5 快挪。\n"
