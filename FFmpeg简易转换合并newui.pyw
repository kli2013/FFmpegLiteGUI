    def _on_combo_changed(self, *args):
        """组合跳转相关控件变化时，触发外部刷新"""
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 新增：组合跳转切换回调 ----------
    def _on_combo_toggle(self):
        if self.combo_seek.get():
            # 启用组合跳转时，禁用精准模式（互斥）
            self.precise_trim.set(False)
            self.precise_check.config(state='disabled')
        else:
            self.precise_check.config(state='normal')
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 修改：精准模式切换回调（增加互斥） ----------
    def on_precise_toggle(self):
        if self.precise_trim.get() and self.show_combo_seek and self.combo_seek.get():
            # 如果精准模式被启用，但组合跳转已启用，则禁用组合跳转
            self.combo_seek.set(False)
            if self.combo_check:
                self.combo_check.config(state='normal')
        # 原有逻辑（如有）保留
        pass

    def on_trim_toggle(self):
        state = tk.NORMAL if self.trim_enabled.get() else tk.DISABLED
        self.trim_start_entry.config(state=state)
        self.trim_end_entry.config(state=state)

    # ---------- 简易时间预览（内置帧浏览器，2026-08-25 方案 B） ----------
    def _open_simple_preview(self):
        """打开内置简易时间预览窗口，暂停后「设为起点/终点」自动回填截取时间。"""
        if not self.app or not self.file_source:
            return
        try:
            path = self.file_source()
        except Exception:
            path = None
        if not path or not os.path.exists(path):
            messagebox.showwarning("提示", "请先选择要预览的视频文件")
            return
        if not self.app.ffmpeg_cmd:
            messagebox.showwarning("提示", "未找到 ffmpeg，无法预览")
            return
        # ⚠️ 释放调用方弹窗的模态 grab（SafeToplevel 等）——否则预览窗口被 grab
        # 锁住焦点（点击/拖拽无效，与可视化选区同一问题），预览窗口自身置顶可交互。
        try:
            g = self.app.root.grab_current()
            if g is not None:
                g.grab_release()
        except Exception:
            pass
        self.app.show_time_picker(self.app.root, path,
                                  on_set_start=lambda s: self.trim_start.set(_format_preview_time(s)),
                                  on_set_end=lambda s: self.trim_end.set(_format_preview_time(s)),
                                  initial_marks=[(self.trim_start.get(), self.trim_end.get())],
                                  use_output_context=False)

    def _import_trim_clipboard(self):
        """读剪贴板一行 `-ss S -to E`（程序内部通用格式），直接填入开始/结束框（不弹窗）。
        用户场景：在预览里标记了首尾却忘了发送单段，或从音频等无预览窗口复制一行过来。"""
        try:
            text = self.winfo_toplevel().clipboard_get().strip()
        except Exception:
            text = ""
        pairs = parse_ss_to_commands(text)
        if not pairs:
            messagebox.showinfo("提示", "剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）")
            return
        s, e = pairs[0]  # 只取第一行
        self.trim_start.set(f"{s:.3f}")
        self.trim_end.set(f"{e:.3f}")
        if not self._setting and self.update_callback:
            try:
                self.update_callback()
            except Exception:
                pass

    # ---------- 修改：get_settings 增加组合跳转字段 ----------
    def get_settings(self):
        res = {
            "trim_enabled": self.trim_enabled.get(),
            "trim_start": self.trim_start.get(),
            "trim_end": self.trim_end.get(),
            "precise_trim": self.precise_trim.get(),
        }
        if self.show_combo_seek:
            res["combo_seek"] = self.combo_seek.get()
            res["combo_threshold"] = self.combo_threshold.get()
        else:
            # 在不显示的场景下强制为 False
            res["combo_seek"] = False
            res["combo_threshold"] = 30
        return res

    # ---------- 修改：set_settings 增加组合跳转字段 ----------
    def set_settings(self, settings):
        self._setting = True
        try:
            self.trim_enabled.set(settings.get("trim_enabled", False))
            self.trim_start.set(settings.get("trim_start", "0"))
            self.trim_end.set(settings.get("trim_end", ""))
            self.precise_trim.set(settings.get("precise_trim", False))
            if self.show_combo_seek:
                self.combo_seek.set(settings.get("combo_seek", False))
                self.combo_threshold.set(settings.get("combo_threshold", 30))
                self._on_combo_toggle()
            else:
                self.combo_seek.set(False)
            self.on_trim_toggle()
        finally:
            self._setting = False

# ================== 内置简易时间预览（方案 B，2026-08-25） ==================
def _format_preview_time(sec: float) -> str:
    """秒 → HH:MM:SS.mmm（3 位小数），供截取时间回填。"""
    s = max(0.0, float(sec))
    h = int(s // 3600)
    m = int((s % 3600) // 60)
    return f"{h:02d}:{m:02d}:{s % 60:06.3f}"


