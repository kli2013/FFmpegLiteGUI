            #   (显示名, id) 才能直接当显示名→token 用）。
            _name2id = {_v: _k for _k, _v in countdown_direction_display().items()}
            st["countdown_direction"] = _name2id.get(self.cd_dir_var.get(), "top_bottom")
            # 滚动时段/行距/窗口存原始字符串：空 = 自动（时段=0~行数−1 秒、窗口=单行满幅）
