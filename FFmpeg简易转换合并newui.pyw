    def __init__(self, preset_path: str, app_name: str = "FFLiteGUI"):
        self.preset_path = preset_path
        # 全局设置文件：与预设文件恒同目录。目录本身由 _resolve_config_dir() 锚定，
        # 这里不再做任何 exists 判定，否则会出现「预设在本地、设置跑用户目录」的撕裂。
        self.settings_path = os.path.join(os.path.dirname(preset_path) or ".", APP_SETTINGS_FILE)
        self.user_data_dir = os.path.join(os.path.expanduser("~"), f".{app_name}")
        os.makedirs(self.user_data_dir, exist_ok=True)
#        self._ensure_default_preset()

    def _ensure_default_preset(self):
        if os.path.exists(self.preset_path):
            return
    
        # 尝试从内置资源复制
        bundled = find_resource("ffmpeg_presets.json")
        if bundled:
            try:
                shutil.copy2(bundled, self.preset_path)
                print(f"首次运行，已从内部释放默认配置到：{self.preset_path}")
                return
            except Exception as e:
                print(f"释放配置文件失败: {e}")
    
        # 没有内置预设，写入精简默认模板
        try:
            with open(self.preset_path, 'w', encoding='utf-8') as f:
                json.dump(self.DEFAULT_PRESET_TEMPLATE, f, indent=4, ensure_ascii=False)
            print(f"首次运行，已创建精简预设模板：{self.preset_path}")
        except Exception as e:
            print(f"创建预设文件失败: {e}")

    def _write_data_atomic(self, data: Dict[str, Any], target_path: str = None):
        """原子写入 data 到 target_path（缺省=预设文件）；若文件已存在且（解析后的）内容
        与 data 完全一致，则直接跳过写入——避免「打开程序 / 触发一次 trace」就把文件
        无谓重写一遍（mtime 变化、但数值没有任何修改）。

        判定用解析后的 dict 比较（而非文本比较），因此即便磁盘文件排序/格式略有差异，
        只要语义内容相同就视为未变化。"""
        target_path = target_path or self.preset_path
        if os.path.exists(target_path):
            try:
                with open(target_path, 'r', encoding='utf-8') as _f:
                    _existing = json.load(_f)
                if _existing == data:
                    return
            except Exception:
                pass
        dir_name = os.path.dirname(target_path)
        temp_name = None
        try:
            with tempfile.NamedTemporaryFile('w', dir=dir_name, delete=False, encoding='utf-8') as tf:
                json.dump(data, tf, indent=4, ensure_ascii=False)
                temp_name = tf.name
            os.replace(temp_name, target_path)
        except Exception as e:
            if temp_name and os.path.exists(temp_name):
                os.unlink(temp_name)
            raise e

    def load_all(self) -> Dict[str, Any]:
        """加载所有预设，返回字典 {预设名: 设置字典}。
        全局设置已迁出到 app_settings.json（见 load_player_settings），新写的预设文件
        不会再出现 "player_settings" 键；这里仍过滤一次，只为兼容迁移尚未发生的旧文件
        （例如从别处拷来的旧备份），免得它混进预设列表。"""
        if not os.path.exists(self.preset_path):
            return {}
        try:
            with open(self.preset_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            return {k: v for k, v in data.items() if k != "player_settings"}
        except:
            return {}

    def _keep_legacy_shadow(self, data: Dict[str, Any]) -> None:
        """写预设文件时，把既有的 player_settings 原样带回去。

        load_all() 会过滤掉这个键（它不属于预设），若不带回，任何一次保存预设都会把
        旧版程序赖以读配置的影子写没了。"""
        legacy = self._read_json(self.preset_path).get("player_settings")
        if isinstance(legacy, dict) and legacy:
            data["player_settings"] = legacy

    def save_preset(self, name: str, settings: Dict[str, Any]):
        """保存预设（与全局设置无耦合），采用原子写入防止文件损坏"""
        data = self.load_all()
        data[name] = settings
        self._keep_legacy_shadow(data)
        self._write_data_atomic(data)

    def delete_preset(self, name: str) -> bool:
        """删除预设，采用原子写入防止文件损坏"""
        data = self.load_all()
        if name not in data:
            return False
        del data[name]
        self._keep_legacy_shadow(data)
        self._write_data_atomic(data)
        return True

    def _read_json(self, path: str) -> Dict[str, Any]:
        """读 JSON 对象；文件不存在/损坏/非对象一律返回 {}（不抛）。"""
        if not os.path.exists(path):
            return {}
        try:
            with open(path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def load_player_settings(self) -> Dict[str, Any]:
        """全局设置。真源 = app_settings.json；不存在时回退读旧位置
        （ffmpeg_presets.json 里的 "player_settings"）并立即迁移。"""
        if os.path.exists(self.settings_path):
            return self._read_json(self.settings_path)
        legacy = self._read_json(self.preset_path).get("player_settings")
        if not isinstance(legacy, dict):
            return {}
        self._migrate_legacy_player_settings(legacy)
        return legacy

    def _migrate_legacy_player_settings(self, legacy: Dict[str, Any]) -> None:
        """旧位置 → app_settings.json（同目录）。写后读回校验，不通过就下次启动再试。

        注意：旧键 player_settings 不摘除。旧版程序只认 ffmpeg_presets.json，摘了它
        就丢配置；新版以 app_settings.json 为真源，旧键只是给旧版看的影子。"""
        try:
            self._write_data_atomic(legacy, self.settings_path)
        except Exception:
            return                      # 新文件写不进去，什么也别动
        try:
            if self._read_json(self.settings_path) != legacy:
                return                  # 校验不过，保留旧数据，下次再迁
        except Exception:
            return

    def save_player_settings(self, settings: Dict[str, Any]):
        """只写 app_settings.json，不再连带重写整个预设库。"""
        self._write_data_atomic(settings, self.settings_path)

    def replace_all(self, data: Dict[str, Any]):
        """整体替换预设库（导入用），采用原子写入。"""
        self._write_data_atomic(data)



def time_to_seconds(timestr: str) -> Optional[float]:
    """将 HH:MM:SS[.mmm] 或 MM:SS[.mmm] 或纯数字转换为秒数"""
    if not timestr:
        return None
    timestr = timestr.strip()
    parts = timestr.split(':')
    try:
        if len(parts) == 3:
            h, m, s = parts
            return int(h) * 3600 + int(m) * 60 + float(s)
        elif len(parts) == 2:
            m, s = parts
            return int(m) * 60 + float(s)
        else:
            return float(timestr)
    except ValueError:
        return None


def _ppm_dimensions_from_bytes(data):
    """从 PPM (P6) 头部解析宽高：'P6' 后读两个数字 token（跳过注释/空白），无依赖。"""
    try:
        tokens = []
        i = 2  # 跳过 'P6'
        n = len(data)
        while len(tokens) < 2 and i < n:
            while i < n and data[i:i+1] in (b' ', b'\t', b'\n', b'\r'):
                i += 1
            if i >= n:
                break
            if data[i:i+1] == b'#':
                while i < n and data[i:i+1] != b'\n':
                    i += 1
                continue
            start = i
            while i < n and data[i:i+1].isdigit():
                i += 1
            if i > start:
                tokens.append(int(data[start:i]))
            else:
                i += 1
        if len(tokens) >= 2:
            return tokens[0], tokens[1]
        return None, None
    except Exception:
        return None, None


def _main_bg_pre_filter(settings):
    """从主视频设置生成位置编辑器背景帧的预处理滤镜串（crop + 旋转 + 上下/左右翻转）。

    静态裁剪 → crop=W:H:X:Y；简易位置动态裁剪（含 t 时间表达式）→ 同样生成表达式 crop
    （由 _generic_overlay_editor 取帧时注入 setpts=PTS+取帧时间/TB 让表达式在取帧时刻求值，
    否则 input -ss 后 t 恒从 0 起=段前基准值）；旋转 → transpose；翻转 → vflip/hflip。
    顺序必须与正式命令主视频链逐字一致：crop → rotate → vflip → hflip（2026-09-03：
    补 vflip/hflip——此前只含 crop+rotate，主视频开翻转时背景帧未翻转=与正式输出错位）。
    无任何处理返回 None。2026-08-28/29：修复位置编辑器背景帧「渲染尺寸画布+完整原帧=变形」——
    画布尺寸已按渲染算好，背景帧必须取裁剪后的画面再缩放。"""
    if not settings:
        return None
    parts = []
    if settings.get("crop_enabled", False):
        cw = str(settings.get("crop_width", "") or "").strip()
        ch = str(settings.get("crop_height", "") or "").strip()
        cx = str(settings.get("crop_left", "0") or "0").strip()
        cy = str(settings.get("crop_top", "0") or "0").strip()
        if cw and ch:
            parts.append(f"crop={cw}:{ch}:{cx}:{cy}")
    rot = settings.get("rotate", "none")
    if rot == "90":
        parts.append("transpose=1")
    elif rot == "180":
        parts.append("transpose=2,transpose=2")
    elif rot == "270":
        parts.append("transpose=2")
    if settings.get("vflip", False):
        parts.append("vflip")
    if settings.get("hflip", False):
        parts.append("hflip")
    return ",".join(parts) if parts else None


def _page_main_video(app, page):
    """按页面取该页自己的主视频：返回 (文件, 设置) 或 (None, None)。

    2026-09-23：转换页与封装页【禁止互相兜底】——本页没有主视频就是纯黑背景帧，
    绝不能用另一页的主视频抽帧（用户实测：转换页文字水印位置编辑器空输入时却显示
    封装页主视频的画面帧）。page 语义：
      'convert' → 转换页输入文件 app.input_file（设置=get_current_settings()）；
      'merge'   → 封装页「主视频」框 merge_video → 首个启用视频轨
                  （设置=该轨 enc_settings，保证与文件同源）；
      None      → (None, None)。"""
    if app is None or not page:
        return None, None
    f = s = None
    with suppress(Exception):
        if page == "convert":
            if getattr(app, "input_file", None):
                p = app.input_file.get().strip()
                if p and os.path.exists(p):
                    f = p
                    if hasattr(app, "get_current_settings"):
                        s = app.get_current_settings()
        elif page == "merge":
            _tracks = [t for t in (getattr(app, "merge_tracks", None) or [])
                       if getattr(t, "enabled", False) and getattr(t, "type", "") == "video"]
            if getattr(app, "merge_video", None):
                p = app.merge_video.get().strip()
                if p and os.path.exists(p):
                    f = p
                    # 设置必须与文件同源：主视频框通常就是首轨文件，同名优先，否则退回首轨
                    for _t in _tracks:
                        if _t.file_path and os.path.abspath(_t.file_path) == os.path.abspath(p):
                            s = _t.enc_settings
                            break
                    if s is None and _tracks:
                        s = _tracks[0].enc_settings
            if f is None and _tracks:
                if _tracks[0].file_path and os.path.exists(_tracks[0].file_path):
                    f = _tracks[0].file_path
                    s = _tracks[0].enc_settings
    return f, s


def _resolve_editor_bg(app, ctx_file=None, ctx_settings=None, scope=None):
    """位置编辑器背景帧统一解析：返回 (主视频文件, 主视频设置) 或 (None, None)（纯黑）。

    背景帧必须来自「被编辑对象所属语境」的主视频，且文件与设置必须同源（crop/rotate/
    scale 预处理与画布尺寸一致），禁止各入口死读 app.get_current_settings()——
    封装页/队列语境下那是转换页全局设置 = 错源（2026-09-03 问题②③④统一修复，
    替代此前 3-4 份互相矛盾的手写兜底链）。优先级：
    1. ctx_file/ctx_settings：调用方显式语境（队列=task.input+task.settings、
       封装页=主轨 file_path+enc_settings）；
    2. 按 scope 只在本页内兜底（2026-09-23）：scope='convert' → 转换页 input_file；
       scope='merge' → 封装页主视频。⚠️ 两页绝不互相兜底——本页没主视频就是纯黑，
       不再出现「转换页空输入却显示封装页画面帧」。scope=None（旧调用点未标注语境）
       → 依次 convert → merge。"""
    f, s = None, None
    if ctx_file:
        try:
            p = str(ctx_file).strip()
            if p and os.path.exists(p):
                f = p
                s = ctx_settings
        except Exception:
            pass
    if f is None and app is not None:
        with suppress(Exception):
            for _pg in ((scope,) if scope else ("convert", "merge")):
                _pf, _ps = _page_main_video(app, _pg)
                if _pf:
                    f = _pf
                    if s is None:
                        s = _ps
                    break
    # 设置仍缺 → 退回转换页全局设置。2026-09-23：封装页语境（scope='merge'）绝不用转换页
    # 设置兜底（背景帧预处理 crop/rotate 会与画布不同源）；本页无主视频（f=None）直接
    # 返回 (None, None) = 纯黑，设置也无需再凑。
    if s is None and f is not None and scope != "merge" and app is not None:
        try:
            if hasattr(app, "get_current_settings"):
                _gs = app.get_current_settings()
                if _gs:
                    s = _gs
        except Exception:
            s = None
    return f, s


def _main_trim_speed(app, current_track=None, get_trim_settings_callback=None,
                     override_settings=None):
    """主视频截取/变速参数：(trim_start, speed_factor)。

    段时间输入语义=主视频原始时间（用户在原始时间轴标记位置）；生成 crop 表达式时
    自动换算输出时间线（原始=trim_start+输出×speed，输出=滤镜 t）。trim_start 多级来源
    （与 open_crop_editor 的 initial_time 一致）：get_trim_settings_callback →
    override_settings → current_track.enc_settings → app.trim_frame。
    speed_factor 来自主视频滤镜设置：current_track.enc_settings 或 app.get_current_settings()。
    未启用截取/变速时返回 (0.0, 1.0)。2026-08-29。"""
    ts = 0.0
    try:
        if get_trim_settings_callback is not None:
            _td = get_trim_settings_callback()
            if _td and _td.get("trim_enabled", False):
                ts = float(str(_td.get("trim_start", "0") or "0"))
        elif override_settings is not None and override_settings.get("trim_enabled", False):
            ts = float(str(override_settings.get("trim_start", "0") or "0"))
        elif current_track is not None and current_track.enc_settings.get("trim_enabled", False):
            ts = float(str(current_track.enc_settings.get("trim_start", "0") or "0"))
        elif app is not None:
            _tf = getattr(app, "trim_frame", None)
            if _tf is not None and _tf.trim_enabled.get():
                ts = float(str(_tf.trim_start.get() or "0")) or 0.0
    except (ValueError, TypeError, AttributeError):
        ts = 0.0
    sp = 1.0
    try:
        src = None
        if current_track is not None:
            src = current_track.enc_settings
        elif app is not None and hasattr(app, "get_current_settings"):
            src = app.get_current_settings()
        if src and src.get("speed_enabled", False):
            sp = float(str(src.get("speed_factor", "1.0") or "1.0")) or 1.0
    except (ValueError, TypeError, AttributeError):
        sp = 1.0
    if sp <= 0:
        sp = 1.0
    return ts, sp


def _timeline_convert(st, dur, trim_start=0.0, speed_factor=1.0):
    """段时间（主视频原始时间线）→ 输出时间线（滤镜 t）的统一换算入口。

    公式：st_out=max(0,(st−trim_start)/speed)，dur_out=dur/speed。
    未截取/变速（trim_start=0、speed=1）时原样返回（零影响）。
    2026-08-29：供 build_waypoint_expr / build_crop_pos_expr / _build_drawtext_enable
    共用，port 时只需搬这一个函数 + 三处调用。"""
    ts = float(trim_start or 0.0)
    sp = _opt_float(speed_factor or 1.0, 1.0)
    if sp <= 0:
        sp = 1.0
    _st = _opt_float(st or 0.0, 0.0)
    _du = _opt_float(dur or 0.0, 0.0)
    if ts == 0.0 and sp == 1.0:
        return _st, _du
    return max(0.0, (_st - ts) / sp), _du / sp


def _main_trim_range(app, current_track=None, get_trim_settings_callback=None,
                     override_settings=None):
    """主视频截取参数 (trim_start, trim_end, speed_factor)。trim_end=None=截到结尾。

    与 _main_trim_speed 同源取数（trim_start 多级来源），多取 trim_end 供越界校验
    （2026-08-29 方向C）。te<=ts 视为无效（截取终点早于起点）返回 None。"""
    ts, sp = _main_trim_speed(app, current_track, get_trim_settings_callback,
                              override_settings)
    te = None
    try:
        if get_trim_settings_callback is not None:
            _td = get_trim_settings_callback()
            if _td and _td.get("trim_enabled", False):
                _te = str(_td.get("trim_end", "") or "").strip()
                if _te:
                    te = float(_te)
        elif override_settings is not None and override_settings.get("trim_enabled", False):
            _te = str(override_settings.get("trim_end", "") or "").strip()
            if _te:
                te = float(_te)
        elif current_track is not None and current_track.enc_settings.get("trim_enabled", False):
            _te = str(current_track.enc_settings.get("trim_end", "") or "").strip()
            if _te:
                te = float(_te)
        elif app is not None:
            _tf = getattr(app, "trim_frame", None)
            if _tf is not None and _tf.trim_enabled.get():
                _te = str(_tf.trim_end.get() or "").strip()
                if _te:
                    te = float(_te)
    except (ValueError, TypeError, AttributeError):
        te = None
    if te is not None and te <= ts:
        te = None
    return ts, te, sp


def _trim_speed_from_settings(settings):
    """从主视频 settings dict（get_current_settings 聚合）取 (trim_start, speed_factor)。
    供 build_video_filter_chain 生成 crop 表达式换算输出时间线用。"""
    ts = 0.0
    sp = 1.0
    if settings and settings.get("trim_enabled", False):
        ts = _opt_float(str(settings.get("trim_start", "0") or "0"), 0.0)
    if settings and settings.get("speed_enabled", False):
        try:
            sp = float(str(settings.get("speed_factor", "1.0") or "1.0")) or 1.0
        except (ValueError, TypeError):
            sp = 1.0
    if sp <= 0:
        sp = 1.0
    return ts, sp


def _motion_trim_base(settings, used_combo=False, pre_seek=0.0):
    """运动表达式时间换算基准（统一入口，2026-08-30）。

    双-ss(组合跳转/combo_seek) 模式：输入已 -ss 定位 + -t 限制时长，用户实测 ffmpeg
    把 filter 时间线 0 点对到 pre_seek（前面新的 -ss），而非 content-start。
    故所有基于「输出时间线」的运动表达式（crop 位置 / 画布 / 列表轨迹 / 文字水印
    显示时段）的换算基准 = pre_seek，而非原始 trim_start。
    非双-ss（精确截取 / 正常）：基准 = 原始 trim_start（filter 自行 trim 归零或时间线一致）。
    speed_factor 始终取主视频设置，不随 combo 改变。

    此函数取代各处零散的「used_combo 时取 pre_seek、否则取原始 trim_start」分支，
    让 trim / crop / 画布 / 轨迹 / drawtext 全部引用同一基准（改一处即可全链路生效）。"""
    _ts, _sp = _trim_speed_from_settings(settings)
    if used_combo:
        return float(pre_seek or 0.0), _sp
    return _ts, _sp


def _extract_frame_scaled(ffmpeg_cmd, input_file, frame_sec=0.0,
                          target_width=None, target_height=None, pre_vf=None):
    """模块级：用 ffmpeg 提取单帧并缩放到目标尺寸，输出 PPM bytes（管道，零磁盘写）。
    返回 (w, h, ppm_bytes) 或 (None, None, None)。供 AdvancedFrame 等没有
    extract_video_frame_scaled 方法的类复用（与 VideoFilterFrame.extract_video_frame_scaled 同逻辑）。
    2026-08-27：接入模块级 LRU 帧缓存（_FRAME_CACHE）——可视化编辑器（水印/子视频/裁剪框）
    每次打开都抽同一背景帧，反复打开会重复启动 ffmpeg 子进程。
    2026-08-28：新增 pre_vf（缩放前的预处理滤镜串，如主视频 crop/rotate），
    供位置编辑器取「裁剪后」的背景帧（否则完整原帧拉伸变形）；缓存键含 pre_vf。"""
    if not ffmpeg_cmd or not input_file:
        return None, None, None
    # 静态图片只有 t=0 一帧：忽略 seek，始终抽首帧（避免 -ss>0 抽不到帧 → 抽帧失败）。
    # 「检测到图片就直接使用图片」：背景帧 = 图片本身（下游 tk.PhotoImage 渲染不变）。
    _is_img = _is_static_image_file(input_file)
    if _is_img:
        frame_sec = 0.0
    _ck = _frame_cache_key(input_file, frame_sec, target_width, target_height, pre_vf)
    _cv = _frame_cache_get(_ck)
    if _cv is not None:
        return _cv
    scale_filter = ""
    if target_width is not None and target_height is not None:
        scale_filter = f"scale={target_width}:{target_height}"
    elif target_width is not None:
        scale_filter = f"scale={target_width}:-2"
    elif target_height is not None:
        scale_filter = f"scale=-2:{target_height}"
    vf_parts = []
    if pre_vf:
        vf_parts.append(pre_vf)
    if scale_filter:
        vf_parts.append(scale_filter)
    cmd = [ffmpeg_cmd, "-i", input_file, "-vframes", "1",
           "-f", "image2pipe", "-vcodec", "ppm"]
    if not _is_img:
        # 视频才需要 seek；图片无时间轴，加 -ss 反而不抽帧。
        cmd.insert(1, "-ss")
        cmd.insert(2, str(frame_sec))
    if vf_parts:
        vframes_idx = cmd.index("-vframes")
        cmd.insert(vframes_idx, "-vf")
        cmd.insert(vframes_idx + 1, ",".join(vf_parts))
    cmd += ["pipe:1"]
    try:
        flags = _ffmpeg_spawn_flags()
        # 2026-09-08：stderr DEVNULL→PIPE + communicate(timeout=30)。
        # 旧写法 stdout.read() 无超时，ffmpeg 异常挂住时线程永久阻塞；
        # communicate 同时泵两根管道，stderr 充满也不会反向卡死 stdout。
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                creationflags=flags)
        try:
            data, _err = proc.communicate(timeout=30)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
                proc.communicate()
            except Exception:
                pass
            return None, None, None
        if proc.returncode != 0 or not data:
            return None, None, None
        w, h = _ppm_dimensions_from_bytes(data)
        _frame_cache_put(_ck, (w, h, data))
        return w, h, data
    except Exception:
        return None, None, None


def _tk_setv(var, val):
    """只在值真的变了才写 tk 变量（2026-09-02 从统一尝试版回灌，铁律）。

    ⚠️ Tk 的 write trace **写同一个值也会触发**（跟 Python 变量赋值不一样），
    而且对 Entry 的 -textvariable 调 set() 会把**输入光标推到末尾**——于是
    「用户敲一个键 → trace → 回写表单 → set()」会打断连续输入：
    用户看到的框值被冲回旧值，后敲的字符追加到后面，列表里就出现
    51 / 2.01 这种怪值（实测：boxblur 默认 5，敲 1→1，再敲 1→51）。
    所有「程序回填表单」一律走这里，绝不裸调 var.set()。
    """
    try:
        cur = var.get()
    except Exception:
        cur = None
    if isinstance(cur, bool) or isinstance(val, bool):
        with suppress(Exception):
            if bool(cur) == bool(val):
                return False
    else:
        with suppress(Exception):
            if str(cur) == ("" if val is None else str(val)):
                return False
    try:
        var.set(val)
        return True
    except Exception:
        return False


# ---- 可视化背景帧 LRU 缓存（2026-08-27）----
# 取帧并非纯内存：每次都启动 ffmpeg 子进程做 seek+解码（输出走管道只是省了磁盘写）。
# 同一 (文件, 时间点, 目标尺寸) 在反复打开多个可视化编辑器时会被重复抽取，
# 这里用模块级 LRU 缓存消除重复子进程。键含 mtime_ns/size，源文件被外部修改后自动失效。
# 上限 8 帧：1080p PPM ≈ 6MB/帧，峰值约 50MB，可接受。
_FRAME_CACHE = {}
_FRAME_CACHE_MAX = 8

def _frame_cache_key(input_file, frame_sec, target_width, target_height, pre_vf=None):
    try:
        st = os.stat(input_file)
        return (input_file, round(float(frame_sec), 3), target_width, target_height,
                pre_vf, st.st_mtime_ns, st.st_size)
    except (OSError, ValueError, TypeError):
        return None

def _frame_cache_get(key):
    if key is None:
        return None
    v = _FRAME_CACHE.pop(key, None)
    if v is not None:
        _FRAME_CACHE[key] = v   # 重新插入 = 移到末尾（最近使用，dict 保序）
    return v

def _frame_cache_put(key, val):
    if key is None or val is None or val[0] is None:
        return
    _FRAME_CACHE.pop(key, None)
    _FRAME_CACHE[key] = val
    while len(_FRAME_CACHE) > _GLOBAL_SETTINGS["frame_cache_max"]:
        _FRAME_CACHE.pop(next(iter(_FRAME_CACHE)))   # 弹出最久未用


def _channel_layout_name(ch):
    """把声道数映射为 ffmpeg aformat 可识别的声道布局名；无法映射时返回 None。"""
    return {1: "mono", 2: "stereo", 4: "quad", 5: "5.0", 6: "5.1", 7: "6.1", 8: "7.1"}.get(ch)


def build_move_xy_expr(mode, x0, y0, move_settings=None, sw="w", sh="h"):
    """生成动态水印 overlay 的 x/y 表达式（纯表达式，无需 sendcmd）。

    mode: '' 无 | 'h' 左右往返 | 'v' 上下往返 | 'diamond' 歪菱形循环 | 'corners' 四角跳跃
    x0/y0: 现有基准（overlay_x/overlay_y 字符串，如 "W-w-10"）。
           往返模式中：h 用 y0 控制水印距上边距（x 全宽 0→W 来回）；
           v 用 x0 控制水印距左边距（y 全高 0→H 来回）；运动速度由周期自动计算。
    move_settings: 参数 dict，键：move_cycle(周期秒) move_dwell(四角停留秒)
                   move_margin(四角边距,可含 W/H 表达式)

    返回 (x_expr, y_expr)；mode 无效/为空返回 (None, None)。
    表达式求值环境：W/H 主画布、w/h 子视频尺寸、t 帧时间（overlay x/y 默认逐帧求值）。
    所有模式均用 min/max 钳制到画面内，避免水印跑出屏幕。
    """
    ms = move_settings or {}
    T = _opt_float(ms.get("move_cycle", 4.0) or 4.0, 4.0)
    if T <= 0:
        T = 4.0

    def _clamp_x(expr):
        return f"min(max(({expr}),0),W-{sw}-5)"

    def _clamp_y(expr):
        return f"min(max(({expr}),0),H-{sh}-5)"

    def _amp(v, default):
        s = str(v if v is not None else "").strip()
        if not s:
            return default
        try:
            float(s)
            return s
        except ValueError:
            return s  # 含 W/H 的表达式，原样使用

    if mode == "h":
        # 左右往返：x 从最左到最右（0 → W-w，水印右边缘贴到 W），y 保持基准（控制上边距）。
        # 无幅度参数，运动速度由周期自动计算。
        tria = f"(1-2*abs(mod(t,{T:.4f})/{T:.4f}-0.5))"
        return _clamp_x(f"(W-{sw})*{tria}"), _clamp_y(f"({y0})")

    if mode == "v":
        # 上下往返：y 从最上到最下（0 → H-h，水印下边缘贴到 H），x 保持基准（控制左边距）。
        tria = f"(1-2*abs(mod(t,{T:.4f})/{T:.4f}-0.5))"
        return _clamp_x(f"({x0})"), _clamp_y(f"(H-{sh})*{tria}")

    if mode == "diamond":
        # 歪菱形循环：4 顶点取自轨迹编辑器的 5x5 网格（label = 行+1, 列+1，范围 1..5）：
        #   (4,1) → (1,2) → (2,5) → (5,4)
        # 网格映射：x = 10+(W-w-20)*c/4，y = 10+(H-h-20)*r/4（c=列-1, r=行-1）。
        # 顶点（r, c）：
        #   V0 (4,1): r=3 c=0  V1 (1,2): r=0 c=1  V2 (2,5): r=1 c=4  V3 (5,4): r=4 c=3
        # 匀速：各段用时与边长成正比（速度 = 周长/周期 恒定），消除短边慢长边快。
        # 用 eval 的 st/ld 变量槽存储边长/周长/段进度，避免 hypot 重复展开导致表达式膨胀。
        def _X(c):
            return {0: "10", 1: f"10+(W-{sw}-20)*0.25",
                    3: f"10+(W-{sw}-20)*0.75", 4: f"10+(W-{sw}-20)"}[c]
        def _Y(r):
            return {0: "10", 1: f"10+(H-{sh}-20)*0.25",
                    3: f"10+(H-{sh}-20)*0.75", 4: f"10+(H-{sh}-20)"}[r]
        vx = [_X(0), _X(1), _X(4), _X(3)]  # V0..V3 的 x
        vy = [_Y(3), _Y(0), _Y(1), _Y(4)]  # V0..V3 的 y
        # st(0..3) = 各边长；st(4) = 周长；st(5..8) = 各段进度 frac
        prefix = []
        for i in range(4):
            j = (i + 1) % 4
            prefix.append(f"st({i},hypot(({vx[j]})-({vx[i]}),({vy[j]})-({vy[i]})))")
        prefix.append("st(4,ld(0)+ld(1)+ld(2)+ld(3))")
        tp = f"mod(t,{T:.4f})"
        acc = ""
        for i in range(4):
            num = f"(({tp})*ld(4)/({T:.4f})"
            if acc:
                num += "-(" + acc + ")"
            num += f")/ld({i})"
            # 不钳制 frac：边界处轻微越界（≤1e-6 级，位置偏移 <0.001px 不可见），
            # 由下方 1e-6 容差段判断保证任意时刻恰好一段选中（无突变/无重叠）。
            prefix.append(f"st({5 + i},{num})")
            acc = acc + "+" + f"ld({i})" if acc else f"ld({i})"
        pre = ";".join(prefix) + ";"
        # 段判断：1e-6 容差消除边界处浮点误差导致的「全段不匹配→位置突变 0」。
        # 相邻段容差区间在边界处恰好首尾相接（前段 frac 超 1 的越界量 ≈ 后段 frac 的 ε 级），
        # 任意时刻恰好选中一段，位置连续。
        segs = [
            f"lte(ld(5),1+1e-6)",
            f"(gt(ld(6),1e-6)*lte(ld(6),1+1e-6))",
            f"(gt(ld(7),1e-6)*lte(ld(7),1+1e-6))",
            f"gt(ld(8),1e-6)",
        ]
        x_parts = []
        y_parts = []
        for i in range(4):
            j = (i + 1) % 4
            x_parts.append(f"{segs[i]}*(({vx[i]})+(({vx[j]})-({vx[i]}))*ld({5 + i}))")
            y_parts.append(f"{segs[i]}*(({vy[i]})+(({vy[j]})-({vy[i]}))*ld({5 + i}))")
        return _clamp_x(pre + "+".join(x_parts)), _clamp_y(pre + "+".join(y_parts))

    if mode == "corners":
        # 四角跳跃：屏幕四角内缩 margin，每点停留 dwell 秒后瞬移下一角。
        # 角0 左上 角1 右上 角2 右下 角3 左下（忽略基准 x0/y0）。
        D = _opt_float(ms.get("move_dwell", 2.0) or 2.0, 2.0)
        if D <= 0:
            D = 2.0
        M = _amp(ms.get("move_margin"), "W*0.03")
        period = 4.0 * D
        p = f"mod(t,{period:.4f})"
        s0 = f"(lt({p},{D:.4f}))"
        s1 = f"(gte({p},{D:.4f})*lt({p},{2*D:.4f}))"
        s2 = f"(gte({p},{2*D:.4f})*lt({p},{3*D:.4f}))"
        s3 = f"(gte({p},{3*D:.4f}))"
        m = f"({M})"
        # 角坐标（含边距，钳制到画布内）
        x_l = f"({m})"
        x_r = f"(W-{sw}-({m}))"
        y_t = f"({m})"
        y_b = f"(H-{sh}-({m}))"
        x = f"{s0}*{x_l}+{s1}*{x_r}+{s2}*{x_r}+{s3}*{x_l}"
        y = f"{s0}*{y_t}+{s1}*{y_t}+{s2}*{y_b}+{s3}*{y_b}"
        return _clamp_x(x), _clamp_y(y)

    return None, None


# ================== 列表轨迹（move_mode == "waypoints"） ==================
# 数据结构（2026-08-27 拍板：双坐标 + 分段到期行为，删除跳跃——隐藏段天然承担"瞬移后出现"）：
#   move_waypoints = list[dict]
#   中间行: {"xa","ya","sa","mode","xb","yb","sb","start","dur","end_action","ra","rb"}
#     mode: "move" 平移 | "hide" 隐藏 | "spin" 自旋转（边移边转，覆盖全局自旋转）
#     end_action: "keep" 连续（段末交棒下一段）| "hide" 段末消失 | "freeze" 段末定格（位置停、子视频/自旋转不停）
#     sa/sb（2026-09-04 新增）：段起点/结尾**缩放倍率**，段内线性插值，默认 1.0（不缩放）。
#       语义：航点坐标 xa/ya、xb/yb 一律指**缩放后**内容盒的左上角；缩放锚点=左上角
#       （与既有的「坐标=左上角」语义一致 → x/y 零补偿，表达式不膨胀）。
#       旋转生效时叠加盒随 z(t) 一起放大，中心对齐偏移需乘 z(t)（见消费端）。
#     ra/rb：段起点/结尾角度（度），段内线性插值（hide/spin 段不贡献显式旋转）。
#   最后一行(终点): {"xa","ya","sa","mode":"end"}（xb/sb/start/dur/end_action 忽略，坐标=最终停留点）
# 首个 end_action != keep 的段 = 独立终止点（该段之后的段全部失效）。

def _wp_num(w, key, default=0.0):
    # ⚠️ 不能用 `w.get(key, default) or default`：0.0 是合法值（如透明度 oa/ob=0
    # 表示完全隐形、scale=0 经 _za/_zb 钳制为 0.01），0.0 的 falsy 会让
    # `0.0 or default` 错误地回退到 default。必须区分「缺键」与「值为 0」。
    v = w.get(key, None)
    if v is None:
        return default
    try:
        return float(v)
    except (ValueError, TypeError):
        return default


def _opt_float(v, default=None):
    """宽容地把 UI 字符串/数值转 float：None/空串/非法 → default，绝不抛异常。

    唯一口径（2026-09-22 抽取）：取代散落各处的局部 _f/_to_f/_num/_aseg_float/
    _parse_ffmeta_num 同构体。dict 取数值字段请用 _seg_num / _wp_num（注意 0 是合法值，
    不能用 `x or d` 语义的口径混淆「缺键」与「值为 0」）。
    """
    if v is None:
        return default
    if isinstance(v, str):
        v = v.strip()
        if v == "":
            return default
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _append_bitrate_args(cmd_list, settings):
    """把 -maxrate/-bufsize 追加进命令列表（build_params 内 4 处逐字同构）"""
    maxrate = settings.get("maxrate", "").strip()
    if maxrate:
        cmd_list.extend(["-maxrate", maxrate + "k"])
    bufsize = settings.get("bufsize", "").strip()
    if bufsize:
        cmd_list.extend(["-bufsize", bufsize + "k"])

def _trimmed_duration(main_video, raw_duration):
    """按主视频轨的 trim 设置算出「有效时长」未设 trim 则原样返回"""
    main_duration = raw_duration
    if main_video.enc_settings.get("trim_enabled", False):
        start = main_video.enc_settings.get("trim_start", "0").strip()
        end = main_video.enc_settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start) if start else 0.0
        end_sec = time_to_seconds(end) if end else None
        if end_sec and end_sec > start_sec:
            main_duration = end_sec - start_sec
        elif raw_duration:
            main_duration = raw_duration - start_sec
    return main_duration

