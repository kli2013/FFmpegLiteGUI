class SimplePreviewer:
    """内置简易时间预览：纯 ffmpeg 依赖（无需 mpv/PotPlayer），定位截取时间用。
    - ffmpeg 解码 rawvideo rgb24 走 stdout（每帧 w*h*3 字节），双 -ss（输入粗 seek +
      输出精 seek）首帧精确到目标网格帧（B 帧正确重排）。
    - **时间 = anchor(seek 目标) + 帧计数/fps 推算**，确定性、无外部依赖。绝不读
      ffmpeg stderr 传时间——实测其 stderr 为 4KB 块缓冲，showinfo 行不逐帧 flush，
      会导致时间停住（"无法恢复播放"的根源）。
    - **暂停 = 立即 kill ffmpeg 进程**（画面保留在 canvas，时间固定）——不做"停读
      管道让 ffmpeg 挂起"（管道缓冲写满会死锁）。恢复播放 = 从当前位置重新双 -ss
      seek 启动（与步进同一条已验证好用的路径，~200ms）。
    - 步进（上一帧/下一帧）= 暂停态从 当前时间 ± 1/fps 重启，读一帧显示后即 kill 停住。
    - 进度条拖动 = kill + 双 -ss 重启（250ms 防抖），拖动后进入播放态，时间立即精确。
    - 线程模型：worker 线程只读原始字节，主线程 after() 创建 PhotoImage 显示（tk 非线程安全）。
      所有管道读取均非阻塞+超时（_read_frame_data），worker 绝不可能卡死。
    """
    PREVIEW_WIDTH = 640

    def __init__(self, root, ffmpeg_cmd, ffprobe_cmd, file_path,
                 on_set_start=None, on_set_end=None, app=None, on_send_segments=None,
                 on_send_waypoints=None, on_send_tw_items=None, on_send_chapters=None,
                 initial_marks=None, trim_start=None, speed_factor=None,
                 use_output_context=True):
        """initial_marks: 打开预览时回溯调用方已有时间 [(s, e), ...]（秒/字符串/None 混合），
        探测完成后重建为标记段显示在段落条上，可直接「复制时间」粘到别处（如音频窗口）。
        on_send_*（2026-08-29 回滚恢复）：单对单「发送到」按钮，mark_row 原位、点击即发，
        各调用方只传自己的目标（跨窗口同步走「复制时间/导入时间」-ss/-to 剪贴板）。
        trim_start/speed_factor（2026-08-29 方向A/阶段1）：主视频截取/变速参数。默认 None
        且 use_output_context=True 时**自动从 app.get_time_context() 读取**（子功能预览），
        调用方零参数；激活时在时间旁追加「成片」时间显示（=(素材−trim)/speed）。
        主视频自身预览（截取/分段/章节）传 use_output_context=False：纯素材时间、不显示成片。"""
        self.root = root
        self.ff = ffmpeg_cmd
        self.ffprobe = ffprobe_cmd
        self.file = file_path
        self.on_set_start = on_set_start
        self.on_set_end = on_set_end
        self._stop = False
        self._playing = True
        self._step = 0            # 帧步进请求：1=下一帧, -1=上一帧
        self._seek_target = None  # 待 seek 时间（秒），worker 取走即清
        self._gen = 0             # 世代号：每次 kill（暂停/seek）递增，worker 检测到
                                  # 变化即放弃当前 proc（防启动竞态下的孤儿进程）
        self._anchor_us = 0       # 当前 proc 首帧绝对时间（= seek 目标，双 -ss 精确到网格帧）
        self._frame_idx = 0       # 当前 proc 已显示帧数（时间推算用）
        self._current_us = 0      # 当前帧微秒时间戳（progress 更新，GIL 原子读写）
        self._frame_shown = False # 当前 proc 是否已显示过帧（暂停态重启后用于读首帧）
        self._at_eof = False      # 播放到末尾标记（恢复播放时从头）
        self._dur = None
        self._fps = 25.0
        self._vw, self._vh = 640, 360
        self._frame_bytes = 0
        self._proc = None
        self._img = None          # PhotoImage 引用保持（替换即释放旧图）
        self._last_rgb = None     # 最近一帧 raw rgb24 字节（导出 PNG 用）
        self._ppm_header = None   # PPM 头缓存（_vw/_vh 探测后惰性构建，_show_frame 复用）
        self._last_scale_tick = 0.0  # 播放中进度条跟随节流（100ms）
        self._seek_after = None   # 进度条拖动防抖
        self._updating_scale = False  # 抑制 scale.set 触发的 command（防自我 seek 循环）
        self._aspect = 16.0 / 9.0  # 视频宽高比（_run_probe 更新；初始默认 16:9）
        self._probe_done = threading.Event()  # 后台探测完成信号（worker 等待，主线程不阻塞）
        self._keyframes = None  # ffprobe 预扫描的关键帧 pts_time 列表（None=扫描中/失败/过密禁用）
        self._kf_buttons_enabled = False  # 关键帧按钮是否已启用（主线程轮询置位）
        self._kf_scan_done = False  # 关键帧扫描是否结束（成功/失败都置位，主线程轮询据此提示）
        self._seek_read_one = False  # 本次 seek 是否只读一帧即停（暂停态跳关键帧用）
        # ---- 成片时间显示（2026-08-29 方向A/阶段1：默认自动读 app 时间上下文）----
        if use_output_context:
            if trim_start is None and app is not None:
                try:
                    _tc = app.get_time_context()
                    trim_start, _te, speed_factor = _tc[0], _tc[1], _tc[2]
                except Exception:
                    trim_start, speed_factor = 0.0, 1.0
            if trim_start is None:
                trim_start = 0.0
            if speed_factor is None:
                speed_factor = 1.0
            self.trim_start = float(trim_start or 0.0)
            try:
                self.speed_factor = float(speed_factor or 1.0)
            except (ValueError, TypeError):
                self.speed_factor = 1.0
            if self.speed_factor <= 0:
                self.speed_factor = 1.0
            self._show_disp_time = (self.trim_start != 0.0 or self.speed_factor != 1.0)
        else:
            # 主视频自身预览（截取/分段/章节）：纯素材时间线，不显示成片时间
            self.trim_start = 0.0
            self.speed_factor = 1.0
            self._show_disp_time = False
        # ---- 标记 / 段落条 / 循环预览（2026-08-28） ----
        self._marks = []            # 已闭合标记段 [(s, e), ...]（秒）
        self._initial_marks = initial_marks  # 调用方回溯的初始时间（探测完成后注入）
        self._initial_injected = False  # 初始标记是否已注入（探测完成只注入一次）
        self._open_start = None     # 未闭合起点（None=当前无待闭合起点）
        self._selected_seg = None   # 当前选中段索引（段落条点击/双击）
        self._loop_active = False   # 循环预览某段中
        self._loop_s = 0.0
        self._loop_e = 0.0
        self._loop_cooldown = 0.0   # 循环回跳防抖时间戳
        self._loop_seek_pending = False  # 循环内部 seek 守卫（避免自我退出循环）
        # 外部播放器入口：已透传进所有调用点，故「外部播放此段」按钮始终创建（None 时点击仅提示）
        self._app = app
        self._on_send_segments = on_send_segments  # 发送全部标记到分段列表回调
        self._on_send_waypoints = on_send_waypoints  # 发送全部标记到轨迹列表回调（hide 段）
        self._on_send_tw_items = on_send_tw_items  # 发送全部标记到文字水印列表回调（占位条目）
        self._on_send_chapters = on_send_chapters  # 发送全部标记到章节列表回调（段起点章节点）
        self._mark_palette = ["#85B7EB", "#97C459", "#E1A33B", "#B58EDC", "#5FB0B5"]
        self._seg_tri = []          # 段落条起点三角标记命中检测 [(x, idx), ...]
        self._ph_line = None        # 播放头竖线图元
        self._ph_tri = None         # 播放头顶部小三角图元
        self._build_ui()
        # 关键帧表就绪轮询（主线程）：扫描线程只写普通 Python 属性 _keyframes，
        # 绝不在后台线程碰 tkinter（win.after 跨线程注册实测不触发）→ 由主线程 200ms 轮询启用按钮
        self.win.after(200, self._poll_keyframes_ready)
        # 异步探测：ffprobe 放后台线程，主线程立即返回 → 即使队列编辑等模态对话框
        # 里点开预览，也不会因探测慢/文件被锁而"卡死"。探测结果回主线程 _apply_probe_ui 落控件。
        threading.Thread(target=self._worker_loop, daemon=True).start()
        threading.Thread(target=self._run_probe, daemon=True).start()
        # 关键帧表独立线程预扫描（不拖慢首屏）：完成后主线程启用「上一关键帧/下一关键帧」
        threading.Thread(target=self._scan_keyframes, daemon=True).start()
        # 解析过程提示（成功/失败由 _poll_keyframes_ready 替换）
        try:
            self.status_label.config(text="正在解析关键帧…")
        except Exception:
            pass

    # ---------- UI ----------
    def _build_ui(self):
        self.win = tk.Toplevel(self.root)
        self.win.title("简易时间预览 - " + os.path.basename(self.file))
        # 不置顶（2026-08-28）：置顶会把标记/内部播放等按钮的 ToolTip（普通 Toplevel）盖住，
        # 导致提示显示不出来。父窗按项目约定均非置顶（弹窗禁 -topmost），且打开预览前已
        # grab_release，普通 Toplevel + 打开时 lift/focus_force 已足够盖住父窗可交互。
        # 窗口固定尺寸（不随拖动变化，避免画面频繁重启/按钮被挤出屏外）；
        # 初始尺寸由 _fit_window 按屏幕自适应并居中，矮屏/高 DPI 下按钮必然可见。
        self.win.resizable(False, False)
        self.canvas = ttk.Label(self.win, text="正在加载预览…", anchor=tk.CENTER,
                                background="black", foreground="white")
        self.canvas.pack(fill=tk.BOTH, expand=True, padx=6, pady=6)
        self.ctl_frame = ttk.Frame(self.win)
        self.ctl_frame.pack(fill=tk.X, padx=6)
        ctl = self.ctl_frame
        self.btn_play = ttk.Button(ctl, text="暂停", width=6, command=self.toggle_play)
        self.btn_play.pack(side=tk.LEFT)
        ttk.Button(ctl, text="上一帧", width=6, command=lambda: self.request_step(-1)).pack(side=tk.LEFT, padx=4)
        ttk.Button(ctl, text="下一帧", width=6, command=lambda: self.request_step(1)).pack(side=tk.LEFT)
        self.time_label = ttk.Label(ctl, text="00:00:00.000", width=14, anchor=tk.E)
        self.time_label.pack(side=tk.LEFT, padx=(12, 4))
        # 成片时间（2026-08-29 方向A）：主视频截取/变速激活时显示，=(素材时间−trim)/speed
        self.disp_time_label = None
        if self._show_disp_time:
            self.disp_time_label = ttk.Label(ctl, text="", width=18, anchor=tk.E,
                                             foreground="#0F6E56")
            self.disp_time_label.pack(side=tk.LEFT, padx=(0, 4))
        self.scale = ttk.Scale(ctl, from_=0, to=100, command=self._on_scale)
        self.scale.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=6)
        ttk.Button(ctl, text="设为起点", width=8, command=self._set_start).pack(side=tk.LEFT, padx=2)
        ttk.Button(ctl, text="设为终点", width=8, command=self._set_end).pack(side=tk.LEFT, padx=2)
        ttk.Button(ctl, text="导出帧", width=6, command=self.save_current_frame_png).pack(side=tk.LEFT, padx=2)
        # 第二行：关键帧跳转（ffprobe 预扫描，2026-08-26）独占一行左侧 + 状态提示右侧。
        # 第一行控件已满（换行挤压），故关键帧按钮放这里，文字用全称不被裁。
        kf_row = ttk.Frame(self.win)
        kf_row.pack(fill=tk.X, padx=6, pady=(0, 4))
        self.kf_row = kf_row
        self.kf_prev_btn = ttk.Button(kf_row, text="上一关键帧", width=10, state=tk.DISABLED,
                                      command=self._goto_prev_keyframe)
        self.kf_prev_btn.pack(side=tk.LEFT)
        ToolTip(self.kf_prev_btn,
                "跳到上一个关键帧（I 帧）：ffprobe 已预扫描关键帧时间表，"
                "跳转只查数组、毫秒级响应、不卡界面。\n"
                "当前帧正好压在关键帧上时跳到相邻帧（±0.05s 容差，兼容 VFR 变帧率视频的浮点误差）。\n"
                "按钮灰显=关键帧表仍在后台扫描，或该视频关键帧过密（如录屏每帧都是 I 帧），"
                "此时可用「上一帧/下一帧」逐帧定位。")
        self.kf_next_btn = ttk.Button(kf_row, text="下一关键帧", width=10, state=tk.DISABLED,
                                      command=self._goto_next_keyframe)
        self.kf_next_btn.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(self.kf_next_btn,
                "跳到下一个关键帧（I 帧）：ffprobe 已预扫描关键帧时间表，"
                "跳转只查数组、毫秒级响应、不卡界面。\n"
                "当前帧正好压在关键帧上时跳到相邻帧（±0.05s 容差，兼容 VFR 变帧率视频的浮点误差）。\n"
                "按钮灰显=关键帧表仍在后台扫描，或该视频关键帧过密（如录屏每帧都是 I 帧），"
                "此时可用「上一帧/下一帧」逐帧定位。")
        # 状态提示行（设为起点/终点/关键帧跳转 的反馈，不关闭窗口可连续设置）→ 同行右侧
        self.status_label = ttk.Label(kf_row, text="", foreground="#007700")
        self.status_label.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(10, 0))
        # ---------- 第三行：标记 / 段落条（2026-08-28） ----------
        # 标记=交替记起点/终点成段；段落条：点任意位置=定位时间（不自动播放），
        # 点段起点三角=选中该段（两者区域不冲突）；内部/外部播放针对选中段。
        mark_row = ttk.Frame(self.win)
        mark_row.pack(fill=tk.X, padx=6, pady=(0, 2))
        self.mark_row = mark_row
        self.mark_btn = ttk.Button(mark_row, text="标记", width=8, command=self._mark_toggle)
        self.mark_btn.pack(side=tk.LEFT)
        ToolTip(self.mark_btn,
                "交替打点：按一次记起点，再按一次记终点成段，如此往复。\n"
                "撤销标记=删最后一段/放弃未闭合起点；上一/下一标记=跳到相邻标记点；清除全部=清空所有标记。\n"
                "段落条：点任意位置=定位时间并暂停；点段起点三角=选中该段；"
                "双击色块=循环预览该段；内部/外部播放针对选中段。\n\n"
                "本标记功能块专为「分段拼接」类列表窗口适配：打出的段可用「复制时间」粘到该窗口外部命令栏导入，"
                "或（从分段拼接打开时）用「发送到列表」直接追加到片段列表。\n"
                "适用窗口还有文字水印列表、列表轨迹、章节编辑等")
        self.mark_undo_btn = ttk.Button(mark_row, text="撤销标记", width=8, state=tk.DISABLED,
                                        command=self._undo_mark)
        self.mark_undo_btn.pack(side=tk.LEFT, padx=(4, 0))
        self.mark_prev_btn = ttk.Button(mark_row, text="上一标记", width=8, state=tk.DISABLED,
                                        command=lambda: self._goto_mark(-1))
        self.mark_prev_btn.pack(side=tk.LEFT, padx=(4, 0))
        self.mark_next_btn = ttk.Button(mark_row, text="下一标记", width=8, state=tk.DISABLED,
                                        command=lambda: self._goto_mark(1))
        self.mark_next_btn.pack(side=tk.LEFT, padx=(4, 0))
        self.mark_clear_btn = ttk.Button(mark_row, text="清除全部", width=8, state=tk.DISABLED,
                                         command=self._clear_marks)
        self.mark_clear_btn.pack(side=tk.LEFT, padx=(4, 0))
        self.copy_marks_btn = ttk.Button(mark_row, text="复制时间", width=8,
                                         command=self._copy_segments_clipboard)
        self.copy_marks_btn.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(self.copy_marks_btn,
                "把所有已标记段落复制成 `-ss 12.345 -to 20.000` 逐行文本到剪贴板。\n"
                "该格式专供「分段拼接」窗口右栏命令区使用：粘贴后点导入即可逐行解析成片段；"
                "单个时间点也可随手复制一行当起点/终点回填。")
        self.import_marks_btn = ttk.Button(mark_row, text="导入时间", width=8,
                                           command=self._import_time_dialog)
        self.import_marks_btn.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(self.import_marks_btn,
                "粘贴 `-ss 开始 -to 结束` 逐行文本（「复制时间」/章节编辑器「外部时间」"
                "同款格式），解析后追加为标记段。\n"
                "用于把其它窗口的时间同步过来（如音频截取、章节编辑器），"
                "再发送到水印/轨迹/分段等列表。")

        if self._on_send_segments is not None:
            self.send_marks_btn = ttk.Button(mark_row, text="发送到列表", width=10, state=tk.DISABLED,
                                             command=self._send_segments_to_list)
            self.send_marks_btn.pack(side=tk.LEFT, padx=(4, 0))
        if self._on_send_waypoints is not None:
            self.send_wp_btn = ttk.Button(mark_row, text="发送到轨迹", width=10, state=tk.DISABLED,
                                          command=self._send_segments_to_waypoints)
            self.send_wp_btn.pack(side=tk.LEFT, padx=(4, 0))
            ToolTip(self.send_wp_btn,
                    "把已标记的段落作为「隐藏」行追加到轨迹列表（该时段水印隐藏）。\n"
                    "只取时间段、坐标为默认值，追加后可改为平移/自旋转等模式；"
                    "轨迹列表有行数上限，超出部分会提示跳过。")
        if self._on_send_tw_items is not None:
            self.send_tw_btn = ttk.Button(mark_row, text="发送到水印", width=10, state=tk.DISABLED,
                                          command=self._send_segments_to_tw_items)
            self.send_tw_btn.pack(side=tk.LEFT, padx=(4, 0))
            ToolTip(self.send_tw_btn,
                    "把已标记段落作为占位文字水印追加到列表：文本=标记N、显示时段=段起止，\n"
                    "之后可逐条修改文字内容/位置；文字水印条目无数量上限。")
        if self._on_send_chapters is not None:
            self.send_ch_btn = ttk.Button(mark_row, text="发送到章节", width=10, state=tk.DISABLED,
                                          command=self._send_segments_to_chapters)
            self.send_ch_btn.pack(side=tk.LEFT, padx=(4, 0))
            ToolTip(self.send_ch_btn,
                    "把已标记段落按起点生成章节：每段一个章节点（标题=标记N），"
                    "结束时间=段终点（字幕导出用），追加到章节列表，之后可修改标题。")
        # 内部播放（窗口内循环预览选中段，比双击更直接）；外部播放=mpv/ffplay。
        # 两者都只针对已选中的段（点段落条起点三角选中）。
        self.inner_play_btn = ttk.Button(mark_row, text="内部播放", width=8, state=tk.DISABLED,
                                         command=self._play_segment_inner)
        self.inner_play_btn.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(self.inner_play_btn,
                "在预览窗口内循环播放选中的段落（无需外部播放器）。\n"
                "先点段落条上该段起点的小三角选中它，再点此按钮（未选中时按钮不可用）；"
                "任意跳转退出循环。")
        # 外部播放：所有入口都显示（app 已透传进各调用点）
        self.ext_play_btn = ttk.Button(mark_row, text="外部播放", width=8, state=tk.DISABLED,
                                       command=self._play_segment_external)
        self.ext_play_btn.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(self.ext_play_btn,
                "用外部播放器（mpv/ffplay）播放选中的段落。\n"
                "先点段落条上该段起点的小三角选中它，再点此按钮（未选中时按钮不可用）。")
        # 第四行：颜色段落条（点击任意位置=定位时间、点起点三角=选中段、双击=循环预览、竖指示线播放头）
        seg_row = ttk.Frame(self.win)
        seg_row.pack(fill=tk.X, padx=6, pady=(0, 4))
        self.seg_row = seg_row
        self.seg_cv = tk.Canvas(seg_row, height=34, bg="#fafafa", cursor="hand2")
        self.seg_cv.pack(fill=tk.X, expand=True)
        self.seg_cv.bind("<Button-1>", self._on_seg_click)
        self.seg_cv.bind("<Double-Button-1>", self._on_seg_double)
        self.seg_cv.bind("<Motion>", self._on_seg_motion)   # 悬停显示该处时间
        self.seg_cv.bind("<Leave>", self._on_seg_leave)
        self.seg_lab = ttk.Label(seg_row, text="用「标记」按钮打点成段；点彩色条任意位置=定位时间，点段起点小三角=选中该段")
        self.seg_lab.pack(fill=tk.X)
        # 第五行：标记状态信息（单独一行，避免被按钮挤掉）
        status_row = ttk.Frame(self.win)
        status_row.pack(fill=tk.X, padx=6, pady=(0, 4))
        self.status_row = status_row
        self.mark_status = ttk.Label(status_row, text="", foreground="#007700")
        self.mark_status.pack(side=tk.LEFT, fill=tk.X, expand=True)
        # 第六行：关闭按钮（本窗口无确认/取消概念，操作实时生效，关闭=中性收尾）
        close_row = ttk.Frame(self.win)
        close_row.pack(fill=tk.X, padx=6, pady=(0, 6))
        self.close_row = close_row
        ttk.Button(close_row, text="关闭", width=8, command=self.close).pack(expand=True, anchor='center')
        self.win.protocol("WM_DELETE_WINDOW", self.close)
        # 构造时先 withdraw() 隐藏：否则 Toplevel 默认立即可见，而此时画布黑底且
        # 尚未 _fit_window 算好尺寸 → 会"黑窗闪一下"。等 _apply_probe_ui 算好尺寸
        # 再 deiconify 显示（见 _apply_probe_ui）。父窗 grab 已由调用方在构造前 release。
        try:
            self.win.withdraw()
        except Exception:
            pass

    def _fit_window(self):
        """窗口尺寸按屏幕自适应 + 居中：画面 + 控件区，保证不超出屏幕（按钮始终可见）。
        窗口宽度至少容纳整行控件（竖屏视频画面窄时不被裁掉）。矮屏/高 DPI 下自动缩小。"""
        try:
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
        except Exception:
            sw, sh = 1920, 1080
        try:
            # 必须先 update_idletasks 让布局完成，否则 reqheight 返回小值 → 窗口高度算少 → 按钮被裁
            self.win.update_idletasks()
            ctl_h = self.ctl_frame.winfo_reqheight()
            ctl_w = self.ctl_frame.winfo_reqwidth()
        except Exception:
            ctl_h = ctl_w = 0
        if ctl_h < 24:
            ctl_h = 40  # 兜底：按钮行最小高度（ttk 按钮约 28px + 边距）
        # 第二行（关键帧按钮 + 状态提示）高度/宽度也计入，否则换行后按钮被窗口下缘裁掉
        try:
            kf_h = getattr(self, "kf_row", None).winfo_reqheight() if getattr(self, "kf_row", None) else 0
            kf_w = getattr(self, "kf_row", None).winfo_reqwidth() if getattr(self, "kf_row", None) else 0
        except Exception:
            kf_h = kf_w = 0
        if kf_h < 24:
            kf_h = 28  # 兜底：关键帧按钮行最小高度
        # 第三行（标记按钮）+ 第四行（段落条 + 选择信息）也计入，否则新按钮被窗口下缘裁掉
        try:
            mark_h = self.mark_row.winfo_reqheight() if getattr(self, "mark_row", None) else 0
            mark_w = self.mark_row.winfo_reqwidth() if getattr(self, "mark_row", None) else 0
            seg_h = self.seg_row.winfo_reqheight() if getattr(self, "seg_row", None) else 0
            seg_w = self.seg_row.winfo_reqwidth() if getattr(self, "seg_row", None) else 0
            stat_h = self.status_row.winfo_reqheight() if getattr(self, "status_row", None) else 0
            stat_w = self.status_row.winfo_reqwidth() if getattr(self, "status_row", None) else 0
            close_h = self.close_row.winfo_reqheight() if getattr(self, "close_row", None) else 0
            close_w = self.close_row.winfo_reqwidth() if getattr(self, "close_row", None) else 0
        except Exception:
            mark_h = mark_w = seg_h = seg_w = stat_h = stat_w = close_h = close_w = 0
        if mark_h < 24:
            mark_h = 28
        if seg_h < 56:
            seg_h = 56  # 段落条 34 + 选择信息行 ≈ 56
        if stat_h < 20:
            stat_h = 22  # 标记状态单独一行
        if close_h < 24:
            close_h = 28  # 关闭按钮行最小高度
        # 宽度 = max(画面宽, 各行控件所需宽) + 边距 → 竖屏视频控件也完整可见
        win_w = min(max(self._vw + 24, ctl_w + 12, kf_w + 12, mark_w + 12, seg_w + 12,
                        stat_w + 12, close_w + 12), sw - 60)
        win_h = min(self._vh + ctl_h + kf_h + mark_h + seg_h + stat_h + close_h + 24 + 16,
                    sh - 120)
        if win_w < 260:
            win_w = 260
        if win_h < 220:
            win_h = 220
        x = max(0, (sw - win_w) // 2)
        y = max(0, (sh - win_h) // 2 - 40)  # 略偏上，避开任务栏
        try:
            self.win.geometry(f"{win_w}x{win_h}+{x}+{y}")
        except Exception:
            pass

    def _run_probe(self):
        """后台线程：ffprobe 探测时长/帧率/比例（不碰 tk 控件，线程安全）。
        结果存属性，再调度 _apply_probe_ui 在主线程更新控件。任何异常都保证
        _apply_probe_ui 被调度，使 previewer 永不卡在"探测中"（主线程也绝不被阻塞）。"""
        try:
            info = ffprobe_json(self.ffprobe, self.file)
            if info and info.get("format"):
                d = info["format"].get("duration")
                if d:
                    try:
                        self._dur = float(d)
                    except (ValueError, TypeError):
                        pass
            if info:
                for s in info.get("streams", []):
                    if s.get("codec_type") == "video":
                        w, h = s.get("width"), s.get("height")
                        if w and h:
                            self._aspect = float(w) / float(h)
                        if self._dur is None:
                            d = s.get("duration")  # 流级时长（ffprobe_json 只带 streams）
                            if d:
                                try:
                                    self._dur = float(d)
                                except (ValueError, TypeError):
                                    pass
                        afr = s.get("avg_frame_rate")
                        if afr and "/" in str(afr):
                            try:
                                a, b = str(afr).split("/", 1)
                                b = float(b) or 1.0
                                self._fps = float(a) / b
                            except (ValueError, ZeroDivisionError):
                                pass
                        break
        except Exception:
            pass
        if self._dur is None:
            # ffprobe_json 只带 streams，容器级时长（format.duration）拿不到 →
            # 单独查一次 format 段（长视频/部分 mp4 流级 duration 缺失，
            # 否则时间轴会停留在默认 100 秒=1:40 的 bug）
            try:
                _cmd = [self.ffprobe, "-v", "error", "-show_entries",
                        "format=duration", "-of", "json", self.file]
                _flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
                _res = subprocess.run(_cmd, capture_output=True, text=True,
                                      encoding="utf-8", errors="replace",
                                      creationflags=_flags, timeout=10)
                if _res.returncode == 0:
                    _d = json.loads(_res.stdout).get("format", {}).get("duration")
                    if _d:
                        self._dur = float(_d)
            except Exception:
                pass
        if self._fps <= 0 or self._fps > 240:
            self._fps = 25.0
        if self._aspect <= 0:
            self._aspect = 16.0 / 9.0
        # 调度主线程更新控件（tk 非线程安全，所有控件操作必须回主线程）
        try:
            self.root.after(0, self._apply_probe_ui)
        except Exception:
            # root 已销毁等极端情况：直接标记完成，避免 worker 永久阻塞
            self._probe_done.set()

    @staticmethod
    def _parse_sec(v):
        """把回溯时间解析为秒：None/空 → None；数字 → float；
        字符串走模块级 time_to_seconds（HH:MM:SS / MM:SS / 纯数字，
        兼容 seconds_to_time 短格式 MM:SS.ms）。"""
        if v is None:
            return None
        if isinstance(v, (int, float)):
            return float(v)
        return time_to_seconds(str(v))

    def _normalize_marks(self, pairs):
        """[(s,e),...]（可含 str/None）→ 有效闭合段 [[s,e],...]：
        容错解析 + clamp 到 [0, dur] + 塌缩段跳过。注入与导入共用。"""
        dur = self._dur or 0.0
        out = []
        for s_raw, e_raw in pairs:
            s = self._parse_sec(s_raw)
            e = self._parse_sec(e_raw)
            if s is None or e is None or e <= s:
                continue  # 只认有效闭合段（同「发送」逻辑）
            if dur > 0:
                s = max(0.0, min(s, dur))
                e = max(s, min(e, dur))
            if e <= s:
                continue  # clamp 后塌缩（整段超出视频时长）无意义，跳过
            out.append([s, e])
        return out

    def _inject_initial_marks(self):
        """探测完成后把调用方回溯的时间重建为标记段（只执行一次）：
        容错解析、只取有效闭合段、clamp 到 [0, dur]；注入后直接可
        「复制时间」粘到别处（如无简易预览的音频窗口）。"""
        if self._initial_injected or not self._initial_marks:
            self._initial_injected = True
            return
        self._initial_injected = True
        marks = self._normalize_marks(self._initial_marks)
        if not marks:
            return
        self._marks = marks
        try:
            self.mark_status.config(
                text=f"已回溯 {len(marks)} 段（来源当前窗口已有时间），可直接复制；清除全部后重新标记")
        except Exception:
            pass
        self._update_mark_buttons()
        self._draw_segments()

    def _apply_probe_ui(self):
        """主线程：根据探测到的比例计算画面尺寸、更新进度条与窗口布局。
        末尾（finally）置 _probe_done，唤醒等待中的 worker。"""
        try:
            if not self.win.winfo_exists():
                return
            # 画面尺寸上限 = 更多设置值（填多少就是多少，与弹窗显示一一对应）；
            # 窗口不超屏由 _fit_window 兜底（min(sw-60) 等），这里不再二次减余量
            # （旧逻辑 min(设置值, sw-100) 导致"填 700 实际 600"的数值不一致，2026-08-28 修复）。
            max_w = _GLOBAL_SETTINGS["preview_max_w"]
            max_h = _GLOBAL_SETTINGS["preview_max_h"]
            if self._aspect >= 1:
                self._vw = int(min(max_w, max_h * self._aspect))
                self._vh = int(self._vw / self._aspect)
            else:
                self._vh = int(min(max_h, max_w / self._aspect))
                self._vw = int(self._vh * self._aspect)
            self._vw = max(64, self._vw)
            self._vh = max(64, self._vh)
            self._frame_bytes = self._vw * self._vh * 3
            self._frame_delay = 1.0 / min(self._fps, 15.0)  # 显示帧率上限 15fps（tkinter 瓶颈）
            if self._dur:
                self.scale.config(to=self._dur)
            self._fit_window()
            # 回溯调用方已有时间 → 标记段（探测完成、dur 已知后注入）
            self._inject_initial_marks()
            # 段落条初绘（窗口未映射时 winfo_width 可能为 1，故 deiconify 后再补一次）
            self._draw_segments()
            # 探测完成、尺寸算好、窗口已居中 → 显示窗口（之前 withdraw 隐藏，
            # 避免黑窗闪一下）。方向B加固：lift + 抢焦点（不置顶，置顶会挡 ToolTip，
            # 见 _build_ui 注释），避免模态父窗仍持 grab 时点击被吞（表现为"卡死"）。
            try:
                self.win.deiconify()
                self.win.lift()
                self.win.focus_force()
            except Exception:
                pass
            try:
                self.win.after(60, self._draw_segments)  # 窗口映射后宽度正确，重绘段落条
            except Exception:
                pass
        except Exception:
            pass
        finally:
            self._probe_done.set()

    # ---------- 控制 ----------
    def toggle_play(self):
        if self._playing:
            # 暂停：立即 kill ffmpeg（画面保留在 canvas、时间固定）。
            # 不做"停读管道"——管道缓冲写满会死锁、进程 EOF 状态难判（恢复不了播放的根源）。
            self._playing = False
            self.btn_play.config(text="播放")
            self._gen += 1  # 让 worker 放弃当前 proc（含启动竞态下的新 proc）
            self._loop_active = False  # 暂停即退出循环预览
            try:
                self.mark_status.config(text="已退出循环预览")
            except Exception:
                pass
            proc = self._proc
            if proc:
                try:
                    proc.kill()
                except Exception:
                    pass
            self._proc = None
        else:
            # 恢复：不直接 seek，由 worker 检测到 playing & proc None 后
            # 从当前位置重启（EOF 后从头）——与步进同一条快路径
            self._playing = True
            self.btn_play.config(text="暂停")
        self._ui_tick()

    def request_step(self, d):
        self._step = d
        self._loop_active = False  # 步进=手动定位，退出循环预览
        try:
            self.mark_status.config(text="已退出循环预览")
        except Exception:
            pass

    def _on_scale(self, val):
        # 程序自己 scale.set（播放跟随）会触发 command → 必须抑制，否则自我 seek 死循环
        if self._updating_scale:
            return
        if self._seek_after:
            try:
                self.win.after_cancel(self._seek_after)
            except Exception:
                pass
        self._seek_after = self.win.after(250, lambda: self._do_seek(val))

    def _do_seek(self, sec):
        self._seek_after = None
        try:
            sec = float(sec)
        except (ValueError, TypeError):
            return
        self._request_seek(max(0.0, sec))

    def _request_seek(self, sec, read_one=False):
        # 拖到最右/末尾时 clamp 到末帧之前：seek 到 ≥ 实际末帧时间无帧输出会直接 EOF
        # （画面不动/时间条回退）。容器时长 _dur 通常比实际末帧大（mkv 末尾可能有
        # 附加数据，实测 6.95GB mkv _dur=9850.59 但末帧仅 ~9850.3）→ 留 0.5 秒余量
        # （比 2/fps≈0.08s 更稳），保证能取到最后一帧。
        if self._dur:
            _max = max(0.0, self._dur - max(0.5, 2.0 / max(self._fps, 1.0)))
            if sec > _max:
                sec = _max
        # 先置 _seek_read_one 再置 _seek_target：worker 只认 _seek_target（可见性顺序），
        # 否则可能读到旧 read_one=False 就把暂停态跳关键帧当成连续播放（实测竞态）
        self._seek_read_one = read_one  # True=只读该帧即停（暂停态跳关键帧，不自动播放）
        self._seek_target = max(0.0, sec)
        self._playing = True
        self._at_eof = False
        self._gen += 1  # kill 语义：让 worker 放弃当前 proc（含启动竞态下的新 proc）
        # 非循环内部 seek（用户手动拖/步进/跳段/选其它段）→ 退出循环预览
        if not self._loop_seek_pending:
            self._loop_active = False
        self.btn_play.config(text="暂停")
        proc = self._proc
        if proc:
            try:
                proc.kill()
            except Exception:
                pass
        # 关键：kill 后立即断开 _proc 引用 → 旧 progress 线程检测到
        # self._proc is not proc → 停止写 _current_us，防止旧进程残留输出
        # 覆盖新进程的精确时间（"时间条在最前面"的根因）。
        self._proc = None

    # ---------- 关键帧跳转（ffprobe 预扫描，2026-08-26） ----------
    def _scan_keyframes(self):
        """后台线程：ffprobe 预扫描关键帧 pts_time（-skip_frame nokey 只解码关键帧，
        2 小时视频一般数秒出完；stderr=DEVNULL 防管道写满死锁）。结果去重排序存
        self._keyframes；成功/失败都置 _kf_scan_done（主线程轮询据此启用按钮或提示失败）。
        全 I 帧/录屏（每帧都是关键帧，列表超 5000）或扫描失败 → 不启用按钮，
        由 _poll_keyframes_ready 提示「解析失败」，用上一帧/下一帧逐帧兜底。"""
        try:
            cmd = [self.ffprobe, "-v", "error", "-select_streams", "v:0",
                   "-skip_frame", "nokey", "-show_entries", "frame=pts_time",
                   "-of", "csv=p=0", self.file]
            flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    creationflags=flags)
            out = proc.stdout.read()
            proc.wait(timeout=30)
            if proc.returncode != 0:
                return
            kfs = []
            for line in out.decode("utf-8", "replace").splitlines():
                line = line.strip()
                if not line:
                    continue
                try:
                    # -of csv=p=0 输出形如 "2.000000,"（带尾逗号）→ 取逗号前字段再转 float
                    kfs.append(float(line.split(",")[0].strip()))
                except ValueError:
                    continue
            kfs = sorted(set(kfs))  # VFR 重复 pts 去重 + 升序（bisect 前提）
            if not kfs or len(kfs) > 5000:
                return  # 空 / 关键帧过密（全 I 帧录屏）→ 不启用按钮
            self._keyframes = kfs  # 只写普通属性；按钮启用由主线程 _poll_keyframes_ready 完成
        except Exception:
            pass
        finally:
            self._kf_scan_done = True  # 无论成败都通知主线程轮询（成功/失败提示）

    def _poll_keyframes_ready(self):
        """主线程轮询（200ms）：扫描线程只写 self._keyframes/_kf_scan_done（普通 Python
        属性），这里负责启用「上一关键帧/下一关键帧」或提示解析失败——后台线程绝不碰
        tkinter（win.after 跨线程注册实测不触发，见 2026-08-26 冒烟测试）。"""
        try:
            if not self._kf_scan_done:
                if not self._stop:
                    self.win.after(200, self._poll_keyframes_ready)
                return
            if self._keyframes and not self._kf_buttons_enabled:
                self._kf_buttons_enabled = True
                self._enable_kf_buttons()
            elif not self._keyframes:
                # 扫描结束但无可用关键帧表 → 提示失败（RMVB/特殊封装/全 I 帧录屏等）
                self.status_label.config(
                    text="关键帧解析失败（RMVB/特殊格式可能不支持，或关键帧过密），"
                         "可用「上一帧/下一帧」逐帧定位")
        except Exception:
            pass

    def _enable_kf_buttons(self):
        try:
            if self._keyframes:
                self.kf_prev_btn.config(state=tk.NORMAL)
                self.kf_next_btn.config(state=tk.NORMAL)
                self.status_label.config(
                    text=f"✓ 已扫描 {len(self._keyframes)} 个关键帧，可用「上一关键帧/下一关键帧」跳转")
        except Exception:
            pass

    def _goto_prev_keyframe(self):
        self._goto_keyframe(-1)

    def _goto_next_keyframe(self):
        self._goto_keyframe(1)

    def _goto_keyframe(self, direction):
        """按预扫描的关键帧数组跳转（毫秒级）：direction -1=上一个、+1=下一个。
        容差 EPS=0.05s：当前帧正好压在关键帧上（±EPS 内）时跳到相邻帧，避免原地
        踏步；VFR 下 CFR 推算时间（_current_us=anchor+帧序号/fps）与 pts_time 有
        漂移，0.01 偏紧故取 0.05（关键帧间隔通常 ≥0.5s，不会误跳帧）。"""
        if not self._keyframes:
            return
        import bisect
        kfs = self._keyframes
        t = self._current_us / 1e6
        EPS = 0.05
        if direction < 0:
            idx = bisect.bisect_left(kfs, t - EPS) - 1
            if idx < 0:
                self.status_label.config(text="已在第一个关键帧")
                return
        else:
            idx = bisect.bisect_right(kfs, t + EPS)
            if idx >= len(kfs):
                self.status_label.config(text="已在最后一个关键帧")
                return
        kf = kfs[idx]
        self.status_label.config(text=f"已跳转到关键帧 {_format_preview_time(kf)}")
        # 暂停态跳关键帧：只读该帧显示并保持暂停（read_one=True），不自动播放——
        # 否则连续「上一关键帧/下一关键帧」会被播放打断，无法顺利逐关键帧核对。
        was_playing = self._playing
        self._request_seek(kf, read_one=not was_playing)
        if not was_playing:
            # _request_seek 内部会置 _playing=True（拖动 seek 语义），这里恢复暂停态
            self._playing = False
            try:
                self.btn_play.config(text="播放")
            except Exception:
                pass

    # ---------- 标记 / 段落条 / 循环预览（2026-08-28） ----------
    def _mark_toggle(self):
        """交替标记：首次按=记起点；再次按=闭合终点成段（video_cut.lua 同款语义）。
        终点早于起点时提示并要求重标，避免误标整段反向。"""
        t = self._current_us / 1e6
        if self._open_start is None:
            self._open_start = t
            self.mark_status.config(text=f"已标起点 {_format_preview_time(t)}，再按「标记」记终点")
            return
        e = t
        if e <= self._open_start:
            self.mark_status.config(
                text=f"终点 {_format_preview_time(e)} 须晚于起点 "
                     f"{_format_preview_time(self._open_start)}，请移到后面再按「标记」或「撤销标记」")
            return
        self._marks.append([self._open_start, e])
        self._open_start = None
        self._update_mark_buttons()
        self._draw_segments()
        self.mark_status.config(
            text=f"✓ 已标第 {len(self._marks)} 段："
                 f"{_format_preview_time(self._marks[-1][0])} → "
                 f"{_format_preview_time(self._marks[-1][1])}")

    def _undo_mark(self):
        if self._open_start is not None:
            self._open_start = None
            self.mark_status.config(text="已撤销未闭合的起点")
        elif self._marks:
            self._marks.pop()
            if self._selected_seg is not None and self._selected_seg >= len(self._marks):
                self._selected_seg = None
            self.mark_status.config(text="已撤销最后一段")
        else:
            return
        self._update_mark_buttons()
        self._draw_segments()

    def _clear_marks(self):
        self._marks = []
        self._open_start = None
        self._selected_seg = None
        self._loop_active = False
        self._update_mark_buttons()
        self._draw_segments()
        self.mark_status.config(text="已清除全部标记")

    def _update_mark_buttons(self):
        """按标记状态启用/禁用按钮。"""
        has = bool(self._marks) or self._open_start is not None
        st = tk.NORMAL if has else tk.DISABLED
        try:
            self.mark_undo_btn.config(state=st)
            self.mark_clear_btn.config(state=st)
            self.mark_prev_btn.config(state=st)
            self.mark_next_btn.config(state=st)
        except Exception:
            pass
        for _btn_name in ("send_marks_btn", "send_wp_btn", "send_tw_btn", "send_ch_btn"):
            _btn = getattr(self, _btn_name, None)
            if _btn is not None:
                try:
                    _btn.config(state=tk.NORMAL if self._marks else tk.DISABLED)
                except Exception:
                    pass
        # 内部/外部播放按钮：按是否选中段启用（外部按钮所有入口都创建，app 已透传）
        en = tk.NORMAL if (self._selected_seg is not None and self._marks) else tk.DISABLED
        try:
            self.inner_play_btn.config(state=en)
            self.ext_play_btn.config(state=en)
        except Exception:
            pass

    def _goto_mark(self, direction):
        """跳到当前时间前后最近的标记点（起点+终点合并排序，精确值无需容差）。"""
        pts = []
        for s, e in self._marks:
            pts.append(s)
            pts.append(e)
        if self._open_start is not None:
            pts.append(self._open_start)
        if not pts:
            return
        import bisect
        pts = sorted(set(pts))
        t = self._current_us / 1e6
        if direction < 0:
            idx = bisect.bisect_left(pts, t) - 1
            if idx < 0:
                self.mark_status.config(text="已在第一个标记点")
                return
        else:
            idx = bisect.bisect_right(pts, t)
            if idx >= len(pts):
                self.mark_status.config(text="已在最后一个标记点")
                return
        p = pts[idx]
        self.mark_status.config(text=f"已跳转到标记点 {_format_preview_time(p)}")
        self._seek_no_autoplay(p)  # 手动跳转：保持播放/暂停态，不强行自动播放（同关键帧跳转）

    def _seek_no_autoplay(self, sec):
        """跳转定位（同「上一/下一关键帧」语义）：保持当前播放/暂停态，不强行自动播放。
        用于上一/下一标记跳转——与滑块拖动 seek（会播放）区分开。"""
        was_playing = self._playing
        self._request_seek(sec, read_one=not was_playing)
        if not was_playing:
            # _request_seek 内部会置 _playing=True（拖动 seek 语义），这里恢复暂停态
            self._playing = False
            try:
                self.btn_play.config(text="播放")
            except Exception:
                pass

    def _seek_pause(self, sec):
        """彩色条点击定位：无论当前是否在播放，一律定位到该帧并保持暂停
        （主流播放器点时间轴即暂停核对画面的语义，与滑块拖动 seek 区分）。"""
        self._request_seek(sec, read_one=True)
        self._playing = False
        try:
            self.btn_play.config(text="播放")
        except Exception:
            pass

    def _blend_colors(self, hexes):
        """多段重叠区混色：RGB 均值（无 PIL 依赖）。返回 #rrggbb。"""
        try:
            rs = gs = bs = 0
            for hx in hexes:
                hx = hx.lstrip("#")
                rs += int(hx[0:2], 16)
                gs += int(hx[2:4], 16)
                bs += int(hx[4:6], 16)
            n = len(hexes)
            return "#%02x%02x%02x" % (rs // n, gs // n, bs // n)
        except Exception:
            return hexes[0] if hexes else "#888888"

    def _draw_segments(self):
        """重绘颜色段落条：横轴=真实视频时长。
        - 重叠区按各段调色板色做 RGB 均值混色（看出下层段）；
        - 每段起点画小三角标记（可点击切换选中）；
        - 选中段描红边；未闭合起点画竖线；当前播放位置画竖指示线+小三角（播放头）。
        无标记时画空底提示。"""
        try:
            cv = self.seg_cv
            cv.delete("all")
            w = cv.winfo_width() or 600
            h = cv.winfo_height() or 34
            cv.create_rectangle(0, 0, w, h, fill="#fafafa", outline="#cccccc")
            self._seg_tri = []  # [(x, idx), ...] 三角标记命中检测
            if not self._dur or self._dur <= 0:
                cv.create_text(w // 2, h // 2, text="等待视频时长解析…", fill="#999999")
                return
            def x_of(sec):
                return max(0, min(w, int(sec / self._dur * w)))
            # ---- 混色分区：按所有边界点切片，每段区间填其覆盖段的均值色 ----
            bounds = sorted(set([s for s, e in self._marks] + [e for s, e in self._marks]))
            for k in range(len(bounds) - 1):
                a, b = bounds[k], bounds[k + 1]
                if b <= a:
                    continue
                mid = (a + b) / 2.0
                cover = [i for i, (s, e) in enumerate(self._marks) if s <= mid < e]
                if not cover:
                    continue
                color = self._blend_colors([self._mark_palette[i % len(self._mark_palette)] for i in cover])
                x0, x1 = x_of(a), x_of(b)
                cv.create_rectangle(x0, 2, max(x1, x0 + 2), h - 2, fill=color, outline="")
            # ---- 选中段描红边 ----
            if self._selected_seg is not None and 0 <= self._selected_seg < len(self._marks):
                s, e = self._marks[self._selected_seg]
                x0, x1 = x_of(s), x_of(e)
                cv.create_rectangle(x0, 2, max(x1, x0 + 2), h - 2,
                                    outline="#dd1111", width=2)
            # ---- 每段起点小三角标记（可点击切换选中）----
            for i, (s, e) in enumerate(self._marks):
                x0 = x_of(s)
                col = self._mark_palette[i % len(self._mark_palette)]
                cv.create_polygon(x0 - 5, h - 3, x0 + 5, h - 3, x0, h - 13,
                                  fill=col, outline="#333333", width=1)
                self._seg_tri.append((x0, i))
            # ---- 未闭合起点竖线 ----
            if self._open_start is not None:
                xo = x_of(self._open_start)
                cv.create_line(xo, 0, xo, h, fill="#dd1111", width=2)
            # ---- 播放头（竖指示线 + 顶部小三角）----
            self._draw_playhead(cv, w, h)
        except Exception:
            pass

    def _draw_playhead(self, cv, w, h):
        """在段落条画当前播放位置指示线（竖线+顶部小三角）。"""
        try:
            cv.delete("playhead")
        except Exception:
            pass
        if not self._dur or self._dur <= 0:
            self._ph_line = None
            self._ph_tri = None
            return
        x = max(0, min(w, int((self._current_us / 1e6) / self._dur * w)))
        self._ph_line = cv.create_line(x, 0, x, h, fill="#2222cc", width=2, tags="playhead")
        self._ph_tri = cv.create_polygon(x - 4, 0, x + 4, 0, x, 8,
                                         fill="#2222cc", tags="playhead")

    def _update_playhead(self):
        """播放中移动播放头（轻量：只移动现有图元，不重绘整条）。"""
        cv = self.seg_cv
        if not self._dur or self._dur <= 0:
            return
        w = cv.winfo_width() or 600
        h = cv.winfo_height() or 34
        x = max(0, min(w, int((self._current_us / 1e6) / self._dur * w)))
        if not getattr(self, "_ph_line", None):
            self._draw_playhead(cv, w, h)
            return
        try:
            cv.coords(self._ph_line, x, 0, x, h)
            cv.coords(self._ph_tri, x - 4, 0, x + 4, 0, x, 8)
        except Exception:
            self._draw_playhead(cv, w, h)

    def _on_seg_motion(self, event):
        """鼠标悬停彩色条：在指针上方画一个白色小气泡显示该处时间（轻量：先删旧的再画）。
        移出画布（<Leave>）时删除，不影响点击/选中。"""
        try:
            if self._dur is None or self._dur <= 0:
                return
            cv = self.seg_cv
            w = cv.winfo_width() or 600
            t = max(0.0, min(1.0, event.x / w)) * self._dur
            cv.delete("hover_time")
            bx = max(34, min(w - 34, event.x))
            cv.create_rectangle(bx - 30, 1, bx + 30, 13,
                                fill="#ffffff", outline="#888888", tags="hover_time")
            cv.create_text(bx, 7, text=_format_preview_time(t),
                           fill="#222222", font=("Microsoft YaHei", 8), tags="hover_time")
        except Exception:
            pass

    def _on_seg_leave(self, event):
        try:
            self.seg_cv.delete("hover_time")
        except Exception:
            pass

    def _on_seg_click(self, event):
        """单击段落条：与主流播放器一致——点时间轴任意位置=定位到该帧并暂停（read_one 只读一帧）；
        选中段落只靠点「段起点小三角」（±6px 命中），两者物理区域分离、互不冲突。"""
        if self._dur is None or self._dur <= 0:
            return
        w = self.seg_cv.winfo_width() or 1
        x = event.x
        # 1) 三角标记命中（优先）：点中某段起点三角=切换选中该段（再点取消）
        for tx, idx in reversed(getattr(self, "_seg_tri", [])):
            if abs(x - tx) <= 6:
                if self._selected_seg == idx:
                    self._selected_seg = None
                    self.seg_lab.config(text="已取消选中（可点起点三角重新选段）")
                else:
                    self._selected_seg = idx
                    self.seg_lab.config(
                        text=f"选中第 {idx+1} 段：{_format_preview_time(self._marks[idx][0])} → "
                             f"{_format_preview_time(self._marks[idx][1])}，"
                             f"长 {self._marks[idx][1]-self._marks[idx][0]:.3f}s")
                self._update_mark_buttons()
                self._draw_segments()
                return
        # 2) 色块内/空白一律=定位并暂停（主流播放器点时间轴语义）；不影响当前选中段
        t = max(0.0, min(1.0, x / w)) * self._dur
        self._seek_pause(t)
        sel_info = ""
        if self._selected_seg is not None and 0 <= self._selected_seg < len(self._marks):
            sel_info = f"（当前仍选中第 {self._selected_seg+1} 段，点起点三角可切换）"
        self.seg_lab.config(
            text=f"已定位并暂停 {_format_preview_time(t)}{sel_info}")

    def _on_seg_double(self, event):
        """双击：点中色块=循环预览该段（重叠区取最上层，同单击选中语义）；点空白不动作。"""
        if self._dur is None or self._dur <= 0:
            return
        w = self.seg_cv.winfo_width() or 1
        t = max(0.0, min(1.0, event.x / w)) * self._dur
        hit = -1
        for i, (s, e) in enumerate(self._marks):
            if s <= t <= e:
                hit = i  # 保留最后一个（最上层）
        if hit >= 0:
            self._loop_segment(hit)

    def _loop_segment(self, idx):
        if idx < 0 or idx >= len(self._marks):
            return
        if self._loop_active and self._selected_seg == idx:
            self._loop_active = False
            self.mark_status.config(text="已退出循环预览")
            self._draw_segments()
            return
        self._selected_seg = idx
        s, e = self._marks[idx]
        self._loop_active = True
        self._loop_s, self._loop_e = s, e
        self._loop_cooldown = 0.0
        self._loop_seek_pending = True
        self._request_seek(s)      # 初始 seek 走守卫，不立即被自身清掉循环
        self._loop_seek_pending = False
        self.mark_status.config(
            text=f"循环预览第 {idx+1} 段：{_format_preview_time(s)} → "
                 f"{_format_preview_time(e)}（任意跳转/双击退出）")
        self._draw_segments()

    def _copy_segments_clipboard(self):
        """复制所有已闭合段到剪贴板：逐行 `-ss S -to E`（秒，3 位小数）。
        该格式即分段拼接右栏解析格式，粘回即导入。"""
        if not self._marks:
            self.mark_status.config(text="暂无已闭合标记，无法复制")
            return
        txt = "\n".join(f"-ss {s:.3f} -to {e:.3f}" for s, e in self._marks)
        try:
            self.win.clipboard_clear()
            self.win.clipboard_append(txt)
            self.mark_status.config(
                text=f"已复制 {len(self._marks)} 段时间到剪贴板（粘到分段拼接右栏导入）")
        except Exception:
            self.mark_status.config(text="复制失败")

    def _import_time_dialog(self):
        """「导入时间」弹窗：粘贴 `-ss S -to E` 逐行（「复制时间」/章节「外部时间」同款），
        解析后追加为标记段（不清空现有），用于把别处时间同步到水印/轨迹/分段等列表。"""
        win = tk.Toplevel(self.win)
        win.title("导入时间 - 粘贴时间命令")
        win.transient(self.win)
        win.withdraw()
        win.resizable(False, False)
        try:
            win.grab_set()
        except Exception:
            pass
        tk.Label(win,
                 text="每行一条 `-ss 开始 -to 结束`（或 `-t 时长`），解析后追加为标记段：\n"
                 "如 `-ss 12.345 -to 20.000`；空行/# 注释/时间无效/结束早于开始 自动跳过。",
                 foreground="#333333", anchor=tk.W).pack(fill=tk.X, padx=10, pady=(10, 4))
        txt = scrolledtext.ScrolledText(win, height=12, wrap=tk.NONE, font=("Consolas", 9))
        txt.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)
        bf = ttk.Frame(win)
        bf.pack(fill=tk.X, padx=10, pady=(0, 10))

        def _do():
            pairs = parse_ss_to_commands(txt.get(1.0, tk.END))
            if not pairs:
                messagebox.showinfo("提示", "未解析到有效时间（格式：-ss 10.5 -to 20.3）")
                return
            marks = self._normalize_marks(pairs)
            if not marks:
                messagebox.showinfo("提示", "解析出的时间段为空或超出视频时长，未导入")
                return
            self._marks.extend(marks)
            self._update_mark_buttons()
            self._draw_segments()
            self.mark_status.config(
                text=f"已导入 {len(marks)} 段（共 {len(self._marks)} 段），可复制时间/发送到各列表")
            win.destroy()

        ttk.Button(bf, text="解析并添加", command=_do).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text="清空", command=lambda: txt.delete(1.0, tk.END)).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text="关闭", command=win.destroy).pack(side=tk.RIGHT, padx=2)
        center_window(win, 560, 360)
        win.deiconify()

    def _send_segments_to_list(self):
        """仅当 on_send_segments 有值时：把已闭合且 start<end 的段发给回调（追加）。"""
        if self._on_send_segments is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        n_open = 1 if self._open_start is not None else 0
        if not valid:
            self.mark_status.config(text="没有可发送的已闭合标记")
            return
        self._on_send_segments(valid)
        msg = f"已发送 {len(valid)} 段到分段列表"
        if n_open:
            msg += "（忽略 1 个未闭合标记）"
        self.mark_status.config(text=msg)

    def _send_segments_to_waypoints(self):
        """仅当 on_send_waypoints 有值：把已闭合段发给回调（轨迹列表追加 hide 段）。"""
        if self._on_send_waypoints is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        if not valid:
            self.mark_status.config(text="没有可发送的已闭合标记")
            return
        self._on_send_waypoints(valid)
        self.mark_status.config(text=f"已发送 {len(valid)} 段到轨迹列表（隐藏段）")

    def _send_segments_to_tw_items(self):
        """仅当 on_send_tw_items 有值：把已闭合段发给回调（文字水印占位条目）。"""
        if self._on_send_tw_items is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        if not valid:
            self.mark_status.config(text="没有可发送的已闭合标记")
            return
        self._on_send_tw_items(valid)
        self.mark_status.config(text=f"已发送 {len(valid)} 段到文字水印列表（占位条目）")

    def _send_segments_to_chapters(self):
        """仅当 on_send_chapters 有值：把已闭合段发给回调（每段起点一个章节点）。"""
        if self._on_send_chapters is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        if not valid:
            self.mark_status.config(text="没有可发送的已闭合标记")
            return
        self._on_send_chapters(valid)
        self.mark_status.config(text=f"已发送 {len(valid)} 段到章节列表（每段起点一个章节点）")

    def _play_segment_inner(self):
        """内部循环预览选中段：复用 _loop_segment（到段尾回跳段首，任意跳转退出）。
        替代双击入口（更直接，不依赖鼠标手势）。"""
        if self._selected_seg is None or not self._marks:
            self.mark_status.config(text="请先点段落条上的起点三角选中一段，再内部播放")
            return
        self._loop_segment(self._selected_seg)

    def _play_segment_external(self):
        """外部播放器播选段：复用 app.preview_with_player（mpv↔ffplay 回退）。"""
        if self._app is None:
            self.mark_status.config(text="此预览入口未提供外部播放器")
            return
        if self._selected_seg is None or not self._marks:
            self.mark_status.config(text="请先点段落条上的起点三角选中一段，再外部播放")
            return
        s, e = self._marks[self._selected_seg]
        if e <= s:
            return
        try:
            self._app.preview_with_player(self.file, start_time=s, duration=e - s)
            self.mark_status.config(
                text=f"已用外部播放器播放第 {self._selected_seg+1} 段："
                     f"{_format_preview_time(s)} → {_format_preview_time(e)}")
        except Exception as ex:
            self.mark_status.config(text=f"外部播放失败：{ex}")

    # ---------- 后台线程 ----------
    def _worker_loop(self):
        """永不退出的播放调度循环（除 close）。三种请求驱动：
        1) _seek_target 有值（拖动/播放中 seek）→ 启动播放
        2) _step 有值（暂停态步进）→ 从 ±1/fps 重启、读一帧显示后停
        3) playing 且无进程（恢复播放/EOF 后重播）→ 从当前位置/头重启
        进程要么在播放（worker 在读），要么不存在——没有"挂起等待"的隐藏状态。"""
        while not self._stop:
            # 等待后台探测完成（探测在独立线程，主线程不阻塞）；窗口关闭时靠
            # _stop 及时退出，避免 worker 永久阻塞在 wait()。
            if not self._probe_done.is_set():
                self._probe_done.wait(0.5)
                continue
            if self._seek_target is not None:
                start = self._seek_target
                self._seek_target = None
                # read_one 由 _request_seek 置位：暂停态跳关键帧只读该帧（见 _goto_keyframe）
                self._run_proc(start, read_one=self._seek_read_one, gen=self._gen)
            elif self._step:
                d = self._step
                self._step = 0
                start = max(0.0, self._current_us / 1e6 + d / self._fps)
                self._run_proc(start, read_one=True, gen=self._gen)
            elif self._playing and self._proc is None:
                start = 0.0 if self._at_eof else self._current_us / 1e6
                self._run_proc(start, gen=self._gen)
            else:
                time.sleep(0.05)

    def _run_proc(self, start_sec, read_one=False, gen=None):
        """启动一次 ffmpeg 会话并读帧，返回后清理进程。read_one=True（步进/暂停态
        定位）时读一帧显示即停；否则持续播放到暂停/seek/EOF。"""
        proc = self._launch_proc(start_sec)
        if self._stop or proc is None:
            return
        self._proc = proc
        self._frame_shown = False
        self._anchor_us = int(start_sec * 1e6)  # 首帧绝对时间 = seek 目标（双 -ss 网格帧精确）
        self._frame_idx = 0
        self._read_frames(proc, read_one, gen)
        if self._stop:
            return
        # 清理：read 返回后 proc 应已 EOF/被 kill；若还活着（被替换成孤儿）→ 杀掉
        if proc.poll() is None:
            try:
                proc.kill()
            except Exception:
                pass
        if self._proc is proc:
            self._proc = None
        # 播放态且无新请求且进程 EOF（读到文件末尾）→ 标记停止，等待下次播放（从头）。
        # ⚠️ _read_frames 返回的原因不止 EOF：还有 _step（步进）、gen 变化（暂停/seek）。
        # 必须全部排除，否则播放中步进会被误判成 EOF 取消播放（"点播放没反应"）。
        # _at_eof 在此同步置位（不依赖主线程 after），避免用户立刻点播放时
        # _on_eof 异步晚到覆盖。
        if (self._playing and self._seek_target is None and self._step == 0
                and gen == self._gen and not read_one and not self._stop):
            self._playing = False
            self._at_eof = True
            self.win.after(0, self._on_eof)

    def _read_frames(self, proc, read_one=False, gen=None):
        fb = self._frame_bytes
        while not self._stop:
            if gen is not None and self._gen != gen:
                return  # 期间发生 kill（暂停/seek）→ 放弃本 proc（防启动竞态孤儿）
            if self._seek_target is not None or self._proc is not proc or self._step:
                return  # 有 seek/步进请求或 proc 已被 kill/替换 → 外层统一处理
            if not self._playing:
                # 暂停态：只允许读一帧（步进/定位落点），已显示过则停
                if read_one and not self._frame_shown:
                    pass  # 重启后尚未显示 → 读首帧显示后停
                else:
                    return
            try:
                data = self._read_frame_data(proc, fb)
            except Exception:
                return
            if data is None:
                return  # EOF / 进程被杀 / 超时（ffmpeg 异常不输出时防 worker 假死）
            # 帧时间 = anchor + 帧序号/fps 推算（CFR 视频精确；不依赖 ffmpeg stderr
            # 缓冲——实测其 stderr 为 4KB 块缓冲，showinfo 行不逐帧 flush，是
            # "时间停住/无法恢复播放"的根源，故彻底弃用 showinfo 解析）。
            # 首帧显示时 _frame_idx=0 → current=anchor（= seek 目标，拖动后时间立即精确）
            self._current_us = self._anchor_us + int(self._frame_idx * 1e6 / self._fps)
            self._frame_idx += 1
            self._frame_shown = True
            self._at_eof = False
            self.win.after(0, self._show_frame, data)
            if read_one:
                return  # 步进/暂停态定位：显示一帧即停
            time.sleep(self._frame_delay)

    def _read_frame_data(self, proc, fb, timeout=15.0):
        """带超时读一帧：非阻塞轮询，**绝不无限阻塞**。ffmpeg 若异常不输出
        （启动卡死/解码挂起），超时后放弃返回 None —— 这是"worker 假死、
        之后步进/播放/拖动全部失效"的最终防线。返回完整帧字节或 None。
        用 os.read 原始读取（BufferedReader 在非阻塞 fd 上会抛 BlockingIOError）。"""
        try:
            fd = proc.stdout.fileno()
            os.set_blocking(fd, False)
        except Exception:
            # 非阻塞不可用（非 Windows）→ 回退阻塞读
            try:
                data = proc.stdout.read(fb)
            except Exception:
                return None
            return data if data and len(data) >= fb else None
        try:
            data = b""
            deadline = time.time() + timeout
            while len(data) < fb:
                if time.time() > deadline:
                    return None
                try:
                    chunk = os.read(fd, fb - len(data))
                except BlockingIOError:
                    chunk = b""
                except Exception:
                    return None
                if not chunk:
                    if proc.poll() is not None:
                        return None  # EOF / 被杀
                    time.sleep(0.005)
                    continue
                data += chunk
            return data
        finally:
            try:
                os.set_blocking(fd, True)
            except Exception:
                pass

    def _launch_proc(self, sec):
        # ⚠️ 双 -ss 取精确帧：-ss 输入 seek（快，关键帧对齐）+ -ss 输出 seek（解码丢弃到
        # 精确时间，B 帧正确重排）→ 首帧 = 目标网格帧，无 1~2 帧跳变（步进依赖此精度）。
        # 时间不再读 stderr（ffmpeg stderr 4KB 块缓冲，showinfo 不逐帧 flush）——
        # 由 _run_proc 的 anchor(=sec) + 帧计数/fps 推算，确定性无外部依赖。
        # ⚠️ stderr 必须 DEVNULL：大文件/部分 MKV 的 ffmpeg 会输出大量 stderr 日志，
        # 若 stderr=PIPE 且无人读取 → 4KB 管道缓冲写满 → ffmpeg 阻塞 → stdout 无帧
        # → 预览永远卡"正在加载预览"（stderr 未读死锁，实测 6.95GB MKV 复现）。
        pre = max(0.0, sec - 2.0 / self._fps)
        post = max(0.0, sec - pre)
        cmd = [self.ff, "-hide_banner",
               "-ss", f"{pre:.6f}", "-i", self.file,
               "-ss", f"{post:.6f}",
               "-vf", f"scale={self._vw}:{self._vh}",
               "-f", "rawvideo", "-pix_fmt", "rgb24", "-an", "pipe:1"]
        flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
        return subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                creationflags=flags)

    # ---------- 主线程 UI 更新 ----------
    def _show_frame(self, rgb):
        try:
            self._last_rgb = rgb
            if self._ppm_header is None:
                # PPM 头只跟 _vw/_vh 有关（探测后固定），缓存复用
                self._ppm_header = b"P6\n%d %d\n255\n" % (self._vw, self._vh)
            ppm = self._ppm_header + rgb
            if self._img is None:
                self._img = tk.PhotoImage(data=ppm)
                self.canvas.config(image=self._img, text="")
            else:
                # 复用同一 PhotoImage 原地换数据（Tcl: image configure -data），
                # 避免每帧新建/销毁 Tcl 图像对象（640x360 下省 ~1-3ms/帧）
                self._img.configure(data=ppm)
        except Exception:
            pass
        self._ui_tick()

    def _ui_tick(self):
        try:
            self._update_playhead()  # 播放头随播放位置移动（轻量，不重绘整条）
        except Exception:
            pass
        try:
            self.time_label.config(text=_format_preview_time(self._current_us / 1e6))
            if self.disp_time_label is not None:
                _disp = (self._current_us / 1e6 - self.trim_start) / self.speed_factor
                if _disp < 0:
                    _disp = 0.0
                self.disp_time_label.config(text="成片 " + _format_preview_time(_disp))
            if self._dur and not self._seek_after:
                # 播放中进度条跟随 100ms 节流：每帧 scale.set 会触发 ttk.Scale 重绘，
                # 成本常比 PhotoImage 还高；暂停/步进/拖动不节流（定位要即时精确，
                # 拖动路径已被 _updating_scale 挡掉自身回调，不会自我 seek 循环）。
                now = time.time()
                if self._playing and now - self._last_scale_tick < 0.1:
                    return
                t = self._current_us / 1e6
                v = float(self.scale.get())
                if abs(v - t) > 0.1:
                    self._updating_scale = True
                    try:
                        self.scale.set(t)  # 播放中进度条跟随（拖动时不抢）
                    finally:
                        self._updating_scale = False
                    self._last_scale_tick = now
            # 循环预览：到段尾回跳段首（循环内部 seek，不退出循环）；冷却防重复触发
            if (self._loop_active and self._playing and self._seek_target is None
                    and self._step == 0 and (time.time() - self._loop_cooldown) > 0.15):
                t = self._current_us / 1e6
                if t >= self._loop_e - 0.03:
                    self._loop_cooldown = time.time()
                    self._loop_seek_pending = True
                    self._request_seek(self._loop_s)
                    self._loop_seek_pending = False
        except Exception:
            pass

    def _on_eof(self):
        if self._stop:
            return
        if self._playing:
            return  # 用户已在 EOF 后恢复播放/seek → 本 EOF 通知作废（竞态防护）
        self._at_eof = True
        self.btn_play.config(text="播放")
        self._ui_tick()

    # ---------- 回填（2026-08-25：不关闭窗口，可连续设置起点/终点） ----------
    def _set_start(self):
        t = self._current_us / 1e6
        if self.on_set_start:
            self.on_set_start(t)
        self.status_label.config(text=f"✓ 起点已设 {_format_preview_time(t)}（可继续设终点，完成后关闭窗口）")

    def _set_end(self):
        t = self._current_us / 1e6
        if self.on_set_end:
            self.on_set_end(t)
        self.status_label.config(text=f"✓ 终点已设 {_format_preview_time(t)}（可继续设起点，完成后关闭窗口）")

    def save_current_frame_png(self):
        """导出当前预览帧为 PNG：用 ffmpeg 把已解码的 raw rgb24 字节编码，免 PIL 依赖。"""
        if self._last_rgb is None:
            messagebox.showwarning("提示", "尚未加载画面，无法导出")
            return
        if not self.ff:
            messagebox.showerror("错误", "未找到 ffmpeg，无法导出 PNG")
            return
        from tkinter import filedialog
        base = os.path.splitext(os.path.basename(self.file))[0]
        ms = int(self._current_us / 1000)
        initial = f"{base}_{ms}ms.png"
        path = filedialog.asksaveasfilename(
            title="导出当前帧",
            defaultextension=".png",
            filetypes=[("PNG 图片", "*.png"), ("所有文件", "*.*")],
            initialfile=initial)
        if not path:
            return
        cmd = [self.ff, "-f", "rawvideo", "-pix_fmt", "rgb24",
               "-s", f"{self._vw}x{self._vh}", "-i", "-",
               "-frames:v", "1", "-y", path]
        try:
            subprocess.run(cmd, input=self._last_rgb, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=30)
            messagebox.showinfo("已导出", f"当前帧已保存：\n{path}")
        except Exception as e:
            messagebox.showerror("导出失败", f"无法导出 PNG：\n{e}")

    def close(self):
        self._stop = True
        proc = self._proc
        if proc:
            try:
                proc.kill()
            except Exception:
                pass
        try:
            self.win.destroy()
        except Exception:
            pass


# ================== 区域可视化编辑器（delogo / 遮罩独立选区） ==================
class RegionVisualEditor:
    """通用单/双框区域可视化编辑器：delogo 与遮罩各自独立的可视化选区入口。

    - 画布显示视频帧，拖拽绘制主选区（红色实线），实时写回 x/y/w/h 变量；
    - 可选显示裁剪框辅助（蓝色虚线，只读）——勾选了裁剪时同时显示两框，
      避免 delogo/遮罩选到裁剪区域之外（与主视频/子视频位置辅助框同理）；
    - 时间跳转重新取帧（复用调用方的 extract_video_frame_scaled）；
    - safe_border=True（delogo）时应用前做四周留边安全化（x/y=0 或越界滤镜失败）。
    """

    def __init__(self, app, file_path,
                 x_var, y_var, w_var, h_var,
                 frame_extractor,
                 helper_rect=None, helper_label="裁剪框",
                 safe_border=False, title="可视化选区",
                 on_apply=None):
        self.app = app
        self.root = app.root
        self.ff = app.ffmpeg_cmd
        self.file = file_path
        self.x_var, self.y_var = x_var, y_var
        self.w_var, self.h_var = w_var, h_var
        self.extract = frame_extractor
        self.helper_rect = helper_rect
        self.helper_label = helper_label
        self.safe_border = safe_border
        self.title = title
        self.on_apply = on_apply

        # 原始尺寸
        try:
            ow, oh = app._get_video_dimensions_cached(file_path)
        except Exception:
            ow = oh = None
        self.orig_w, self.orig_h = (ow or 1920), (oh or 1080)

        # 显示尺寸（屏幕内）。2026-08-26：与裁剪可视化一致——窗口高度=画布高+小余量，
        # 右侧按钮行不占画布空间，无需为它们加窗口高度（加高只会让画布 expand 撑出底部空白）
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        RIGHT = 270
        avail_w = min(int(sw * 0.9), 1200) - RIGHT - 40
        avail_h = min(int(sh * 0.85), 800) - 30
        scale = min(1.0, avail_w / self.orig_w, avail_h / self.orig_h)
        self.disp_w = max(1, int(self.orig_w * scale))
        self.disp_h = max(1, int(self.orig_h * scale))
        self.scale_x = self.orig_w / self.disp_w
        self.scale_y = self.orig_h / self.disp_h
        self.PAD = 10

        # 状态
        self.points = []          # [(x1,y1),(x2,y2)] 原始坐标
        self.rect_id = None
        self.drag_rect_id = None
        self.drag_start = None
        self.img = None

        self._build_ui()
        # 初始框：从现有变量恢复
        self._load_from_vars()
        self._initial_load(0.0)

    # ---------- UI ----------
    def _build_ui(self):
        self.win = tk.Toplevel(self.root)
        self.win.title(f"{self.title} (显示 {self.disp_w}x{self.disp_h}, 原始 {self.orig_w}x{self.orig_h})")
        self.win.resizable(False, False)
        try:
            self.win.transient(self.root)
            # 置顶：调用方（去水印/遮罩弹窗）可能仍是置顶/模态，本窗口必须盖住它可交互
            self.win.attributes("-topmost", True)
        except Exception:
            pass
        cw = self.disp_w + self.PAD * 2
        ch = self.disp_h + self.PAD * 2
        # 简单居中（窗口高=画布高+10，与裁剪可视化一致，画布 expand 后恰好占满，无底部空白）
        try:
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
            x = max(0, (sw - cw - 290) // 2)
            y = max(0, (sh - ch - 30) // 2)
            self.win.geometry(f"{cw + 290}x{ch + 10}+{x}+{y}")
        except Exception:
            pass
        self.win.protocol("WM_DELETE_WINDOW", self.win.destroy)

        main = ttk.Frame(self.win)
        main.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        right = ttk.Frame(main, width=270)
        right.pack(side=tk.RIGHT, fill=tk.Y, padx=(10, 0))
        right.pack_propagate(False)

        self.canvas = tk.Canvas(main, bg='gray', width=cw, height=ch, highlightthickness=0)
        self.canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self._loading = self.canvas.create_text(cw // 2, ch // 2, text="正在加载画面…",
                                                fill="#666666", font=("Arial", 12))

        # 信息
        self.info_var = tk.StringVar(value="👉 按住左键拖拽绘制选区")
        tk.Label(right, textvariable=self.info_var, wraplength=250, justify=tk.LEFT,
                 bg="#FFFFCC", relief=tk.SUNKEN, padx=5, pady=5).pack(pady=5, fill=tk.X)
        # 辅助框提示
        if self.helper_rect:
            hx, hy, hw, hh = self.helper_rect
            tk.Label(right, text=f"辅助:{self.helper_label} ({hx},{hy},{hw},{hh})",
                     foreground="blue", wraplength=250, justify=tk.LEFT).pack(pady=2, fill=tk.X)

        # 时间
        row = ttk.Frame(right)
        row.pack(fill=tk.X, pady=4)
        ttk.Label(row, text="时间:").pack(side=tk.LEFT)
        self.time_var = tk.StringVar(value="0")
        ttk.Entry(row, textvariable=self.time_var, width=10).pack(side=tk.LEFT, padx=4)
        ttk.Button(row, text="取帧", command=self._refresh_frame).pack(side=tk.LEFT)

        # 数值（实时显示 + 可编辑；2026-08-26：4 行改 2 行紧凑布局，腾空间给微调按钮）
        nf = ttk.LabelFrame(right, text="选区坐标 (x / y / 宽 / 高)", padding=5)
        nf.pack(fill=tk.X, pady=4)
        nf_r1 = ttk.Frame(nf)
        nf_r1.pack(fill=tk.X, pady=1)
        nf_r2 = ttk.Frame(nf)
        nf_r2.pack(fill=tk.X, pady=1)
        for i, (lab, var, row) in enumerate([("X", self.x_var, nf_r1), ("Y", self.y_var, nf_r1),
                                             ("宽", self.w_var, nf_r2), ("高", self.h_var, nf_r2)]):
            ttk.Label(row, text=lab + ":").pack(side=tk.LEFT)
            e = ttk.Entry(row, textvariable=var, width=6)
            e.pack(side=tk.LEFT, padx=2)

        # 微调按钮：移动 / 减 / 加 三行，各自带步进（2026-08-26 与裁剪可视化同套语义）
        nudge_frame = ttk.LabelFrame(right, text="微调 (像素)", padding=3)
        nudge_frame.pack(fill=tk.X, pady=4)
        _nudge_step = {}
        for _kind, _labels in [("move", [("上移", "up"), ("下移", "down"), ("左移", "left"), ("右移", "right")]),
                               ("shrink", [("上减", "top"), ("下减", "bottom"), ("左减", "left"), ("右减", "right")]),
                               ("grow", [("上加", "top"), ("下加", "bottom"), ("左加", "left"), ("右加", "right")])]:
            _row = ttk.Frame(nudge_frame)
            _row.pack(fill=tk.X, pady=1)
            for _label, _dir in _labels:
                ttk.Button(_row, text=_label, width=4,
                           command=lambda k=_kind, d=_dir: self._nudge_rect(k, d, _nudge_step_get(_kind))).pack(
                    side=tk.LEFT, padx=1)
            ttk.Label(_row, text="步进:").pack(side=tk.LEFT, padx=(6, 2))
            _sv = tk.StringVar(value="1")
            _nudge_step[_kind] = _sv
            ttk.Spinbox(_row, textvariable=_sv, from_=1, to=999, width=4).pack(side=tk.LEFT)

        def _nudge_step_get(kind):
            try:
                return int(_nudge_step[kind].get())
            except (ValueError, TypeError, KeyError):
                return 1

        # 清除/应用/取消
        bf = ttk.Frame(right)
        bf.pack(fill=tk.X, pady=8)
        ttk.Button(bf, text="清除选区", command=self._clear).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text="应用", command=self._apply).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text="取消", command=self.win.destroy).pack(side=tk.LEFT, padx=2)

        tip = "拖拽绘制主选区（红色）。辅助框（蓝色虚线）= 裁剪区域，仅供参考。"
        tk.Label(right, text=tip, foreground="gray", wraplength=250, justify=tk.LEFT).pack(pady=6)

        # 事件
        self.canvas.bind("<ButtonPress-1>", self._on_drag_start)
        self.canvas.bind("<B1-Motion>", self._on_drag_motion)
        self.canvas.bind("<ButtonRelease-1>", self._on_drag_end)

    # ---------- 坐标转换 ----------
    def _c2d(self, cx, cy):
        x = self.canvas.canvasx(cx) - self.PAD
        y = self.canvas.canvasy(cy) - self.PAD
        return max(0, min(x, self.disp_w)), max(0, min(y, self.disp_h))

    def _d2o(self, dx, dy):
        return int(dx * self.scale_x), int(dy * self.scale_y)

    def _o2d(self, ox, oy):
        return ox / self.scale_x, oy / self.scale_y

    # ---------- 画框 ----------
    def _redraw(self):
        if self.rect_id:
            self.canvas.delete(self.rect_id)
            self.rect_id = None
        # 辅助框（只读）
        self.canvas.delete("aux")
        if self.helper_rect:
            hx, hy, hw, hh = self.helper_rect
            _ax1, _ay1 = self._o2d(hx, hy)
            _ax2, _ay2 = self._o2d(hx + hw, hy + hh)
            self.canvas.create_rectangle(
                _ax1 + self.PAD, _ay1 + self.PAD,
                _ax2 + self.PAD, _ay2 + self.PAD,
                outline="blue", width=1, dash=(4, 2), tags="aux")
        if len(self.points) == 2:
            x1, y1 = self.points[0]
            x2, y2 = self.points[1]
            self.rect_id = self.canvas.create_rectangle(
                self._o2d(x1, y1)[0] + self.PAD, self._o2d(x1, y1)[1] + self.PAD,
                self._o2d(x2, y2)[0] + self.PAD, self._o2d(x2, y2)[1] + self.PAD,
                outline="red", width=2)
            self._sync_vars()
        self._update_info()

    def _sync_vars(self):
        if len(self.points) != 2:
            return
        x1, y1 = self.points[0]
        x2, y2 = self.points[1]
        try:
            self.x_var.set(str(int(min(x1, x2))))
            self.y_var.set(str(int(min(y1, y2))))
            self.w_var.set(str(int(abs(x2 - x1))))
            self.h_var.set(str(int(abs(y2 - y1))))
        except Exception:
            pass

    def _update_info(self):
        if len(self.points) == 2:
            self.info_var.set("✅ 选区已确定，可继续拖拽覆盖")
        else:
            self.info_var.set("👉 按住左键拖拽绘制选区")

    def _load_from_vars(self):
        """打开时从目标变量恢复旧框（任务1同款逻辑）。"""
        try:
            x = int(float(str(self.x_var.get()).strip() or 0))
            y = int(float(str(self.y_var.get()).strip() or 0))
            w = int(float(str(self.w_var.get()).strip() or 0))
            h = int(float(str(self.h_var.get()).strip() or 0))
            if w > 0 and h > 0:
                self.points = [(x, y), (x + w, y + h)]
        except (ValueError, TypeError):
            pass

    def _nudge_rect(self, kind, direction, step):
        """微调矩形（2026-08-26，与裁剪可视化同套语义）：
        - kind='move'   平移（up/down/left/right）
        - kind='shrink' 收缩边界（top/bottom/left/right）
        - kind='grow'   扩大边界（top/bottom/left/right）
        操作后 _redraw 自动写回 x/y/w/h 变量。"""
        if len(self.points) != 2 or not step:
            return
        x1, y1 = self.points[0]
        x2, y2 = self.points[1]
        l = min(x1, x2); r = max(x1, x2)
        t = min(y1, y2); b = max(y1, y2)
        if kind == "move":
            if direction == "left":   l -= step; r -= step
            elif direction == "right": l += step; r += step
            elif direction == "up":    t -= step; b -= step
            elif direction == "down":  t += step; b += step
        elif kind == "shrink":
            if direction == "left":   l += step
            elif direction == "right": r -= step
            elif direction == "top":   t += step
            elif direction == "bottom": b -= step
        elif kind == "grow":
            if direction == "left":   l -= step
            elif direction == "right": r += step
            elif direction == "top":   t -= step
            elif direction == "bottom": b += step
        else:
            return
        l = max(0, min(l, self.orig_w)); t = max(0, min(t, self.orig_h))
        r = max(0, min(r, self.orig_w)); b = max(0, min(b, self.orig_h))
        if r <= l or b <= t:
            return
        self.points = [(l, t), (r, b)]
        self._redraw()

    # ---------- 拖拽 ----------
    def _on_drag_start(self, ev):
        self.drag_start = self._c2d(ev.x, ev.y)
        if self.drag_rect_id:
            self.canvas.delete(self.drag_rect_id)
            self.drag_rect_id = None
        if self.rect_id:
            self.canvas.delete(self.rect_id)
            self.rect_id = None

    def _on_drag_motion(self, ev):
        if self.drag_start is None:
            return
        cur = self._c2d(ev.x, ev.y)
        if self.drag_rect_id:
            self.canvas.delete(self.drag_rect_id)
        sx, sy = self.drag_start
        self.drag_rect_id = self.canvas.create_rectangle(
            sx + self.PAD, sy + self.PAD, cur[0] + self.PAD, cur[1] + self.PAD,
            outline="yellow", width=2, dash=(4, 2))

    def _on_drag_end(self, ev):
        if self.drag_start is None:
            return
        sx, sy = self.drag_start
        ex, ey = self._c2d(ev.x, ev.y)
        ox1, oy1 = self._d2o(sx, sy)
        ox2, oy2 = self._d2o(ex, ey)
        if abs(ox2 - ox1) > 0 and abs(oy2 - oy1) > 0:
            self.points = [(ox1, oy1), (ox2, oy2)]
        else:
            self.points = []
        if self.drag_rect_id:
            self.canvas.delete(self.drag_rect_id)
            self.drag_rect_id = None
        self.drag_start = None
        self._redraw()

    # ---------- 帧 ----------
    def _initial_load(self, sec):
        try:
            w, h, data = self.extract(self.file, frame_sec=sec,
                                      target_width=self.disp_w, target_height=self.disp_h)
            if w is None or h is None:
                return
            self._show_img(data)
        except Exception:
            pass

    def _show_img(self, data):
        try:
            img = tk.PhotoImage(data=data)
            self.canvas.delete("bg_img")
            self.canvas.create_image(self.PAD, self.PAD, anchor=tk.NW, image=img, tags="bg_img")
            self.canvas.image = img
            self.img = img
            try:
                self.canvas.delete(self._loading)
            except Exception:
                pass
            self._redraw()  # 图像显示后画框（图像会盖住先画的）
        except Exception:
            pass

    def _refresh_frame(self):
        sec = time_to_seconds(self.time_var.get().strip() or "0") or 0.0
        try:
            w, h, data = self.extract(self.file, frame_sec=sec,
                                      target_width=self.disp_w, target_height=self.disp_h)
            if w is not None and h is not None:
                self._show_img(data)
                self.info_var.set(f"✅ 已更新画面 ({sec:.2f}s)")
        except Exception:
            pass

    # ---------- 操作 ----------
    def _clear(self):
        self.points = []
        self._redraw()

    def _apply(self):
        if len(self.points) != 2:
            messagebox.showwarning("提示", "请先拖拽绘制一个选区")
            return
        x1, y1 = self.points[0]
        x2, y2 = self.points[1]
        x, y = int(min(x1, x2)), int(min(y1, y2))
        w, h = int(abs(x2 - x1)), int(abs(y2 - y1))
        if w <= 0 or h <= 0:
            messagebox.showerror("错误", "选区尺寸无效")
            return
        if self.safe_border:
            # delogo 四周留 ≥1px 边界（x/y=0 贴边或越界 → 滤镜失败）
            if x < 1:
                w -= (1 - x)
                x = 1
            if y < 1:
                h -= (1 - y)
                y = 1
            if w > self.orig_w - x - 1:
                w = self.orig_w - x - 1
            if h > self.orig_h - y - 1:
                h = self.orig_h - y - 1
            if w <= 0 or h <= 0:
                messagebox.showerror("错误", "选区贴近画面边缘，无法安全应用（delogo 需四周留边）")
                return
        self.x_var.set(str(x))
        self.y_var.set(str(y))
        self.w_var.set(str(w))
        self.h_var.set(str(h))
        if self.on_apply:
            try:
                self.on_apply()
            except Exception:
                pass
        self.win.destroy()


