        self._coord_entries = [x_entry, y_entry, w_entry, h_entry]

        # 独立可视化选区入口（delogo / 局部模糊 各自可视化，可同时显示裁剪框辅助）
        def _open_region_visual():
            ff = self.filter_frame
            app = getattr(ff, "app", None)
            file_path = getattr(ff, "current_file", "") or ""
            if not file_path or not os.path.exists(file_path):
                if app is not None and app.input_file is not None:
                    file_path = app.input_file.get().strip()
            if alert_if(not file_path or not os.path.exists(file_path), "提示", "请先选择要处理的视频文件"):
                return
            helper = _crop_box_to_helper_rect(
                ff.crop_enabled, ff.crop_left, ff.crop_top,
                ff.crop_width, ff.crop_height, file_path=file_path, app=app)
            if app is None or app.root is None:
                return
            # ⚠️ 本对话框 grab_set 模态会锁住焦点 → 打开可视化前必须释放，
            # 否则可视化窗口无法拖拽画线
            with suppress(Exception):
                self.grab_release()
            def _delogo_apply(rect):
                _x, _y, _w, _h = rect
                self.x_var.set(str(int(_x)))
                self.y_var.set(str(int(_y)))
                self.w_var.set(str(int(_w)))
                self.h_var.set(str(int(_h)))
            _pre = None
            try:
                _px = int(float(str(self.x_var.get()).strip() or 0))
                _py = int(float(str(self.y_var.get()).strip() or 0))
                _pw = int(float(str(self.w_var.get()).strip() or 0))
                _ph = int(float(str(self.h_var.get()).strip() or 0))
                if _pw > 0 and _ph > 0:
                    _pre = [(_px, _py), (_px + _pw, _py + _ph)]
            except (ValueError, TypeError):
                _pre = None
            RectSelectEditor(
                self.filter_frame, file_path,
                self.x_var, self.y_var, self.w_var, self.h_var,
                frame_extractor=getattr(self.filter_frame, "node_frame_extractor", None) or ff.extract_video_frame_scaled,
                helper_rect=helper,
                safe_border=(self.type_var.get() == "delogo"),
                title="可视化选区 - delogo / 局部滤镜",
                on_apply=_delogo_apply,
                preload_points=_pre,
                initial_time_override=0.0,
                show_simple_pos=False,
                show_black_border=False,
                apply_label="应用",
                clear_label="清除选区",
            )

        btn_visual = ttk.Button(coord_frame, text="🎯 可视化选区…",
                                command=_open_region_visual)
        btn_visual.pack(pady=2)
        ToolTip(btn_visual,
                "打开独立可视化选区窗口：在画面上拖拽确定 delogo/局部滤镜 区域。\n"
                "已勾选「裁剪」时同时显示裁剪框（蓝色虚线）作为辅助，\n"
                "避免选区超出裁剪范围。delogo 应用时自动四周留 1px 边界。\n"
                "应用后坐标写回本窗口，点「保存」生效。")
        
        # ---- 显示时段 / 循环控制（起始/结束/周期/单次，与文字水印同套 enable 表达式）----
        time_frame = ttk.LabelFrame(main, text="显示时段 / 循环 (可选)", padding="4")
        time_frame.grid(row=5, column=0, columnspan=3, sticky="ew", pady=3)
        seg_row = ttk.Frame(time_frame)
        seg_row.pack(fill=tk.X, pady=1)
        _lbltt12 = ttk.Label(seg_row, text="起始:")
        _lbltt12.pack(side=tk.LEFT)
        self.enable_start_var = tk.StringVar(value="")
        es = ttk.Entry(seg_row, textvariable=self.enable_start_var, width=7)
        es.pack(side=tk.LEFT, padx=(0, 8))
        ToolTip(_lbltt12, "该区域开始生效的时间（秒），留空表示从头开始。与「结束」组合成 between(t,start,end)。")
        _lbltt13 = ttk.Label(seg_row, text="结束:")
        _lbltt13.pack(side=tk.LEFT)
        self.enable_end_var = tk.StringVar(value="")
        ee = ttk.Entry(seg_row, textvariable=self.enable_end_var, width=7)
        ee.pack(side=tk.LEFT)
        ToolTip(_lbltt13, "该区域结束生效的时间（秒），留空表示到结尾。")
        blur_prev_btn = ttk.Button(seg_row, text="简易时间预览", command=self._open_simple_preview_blur)
        blur_prev_btn.pack(side=tk.LEFT, padx=(10, 0))
        ToolTip(blur_prev_btn,
                "打开内置简易时间预览（纯 ffmpeg），暂停后「设为起点/终点」回填上方 起始/结束（秒，主视频时间线）。\n"
                "不关闭窗口可连续设置；大文件/特殊格式加载可能慢或失败，失败时可用 PotPlayer/MPV 取时间填回。")
        cyc_row = ttk.Frame(time_frame)
        cyc_row.pack(fill=tk.X, pady=1)
        _lbltt14 = ttk.Label(cyc_row, text="周期:")
        _lbltt14.pack(side=tk.LEFT)
        self.enable_cycle_var = tk.StringVar(value="")
        ec = ttk.Entry(cyc_row, textvariable=self.enable_cycle_var, width=7)
        ec.pack(side=tk.LEFT, padx=(0, 8))
        ToolTip(_lbltt14, "循环周期（秒）：每隔该时长重复一次生效。需配合「单次」使用。\n注意：周期不能比「单次」时长短，否则一直生效。")
        _lbltt15 = ttk.Label(cyc_row, text="单次:")
        _lbltt15.pack(side=tk.LEFT)
        self.enable_show_var = tk.StringVar(value="")
        esh = ttk.Entry(cyc_row, textvariable=self.enable_show_var, width=7)
        esh.pack(side=tk.LEFT)
        ToolTip(_lbltt15, "单次生效时长（秒）：每个周期内仅前这么多秒生效（enable='lt(mod(t,周期),单次)'）。")

        # ---- 操作按钮 ----
        btn_frame = ttk.Frame(main)
        btn_frame.grid(row=6, column=0, columnspan=3, pady=15)
        ttk.Button(btn_frame, text="应用", command=self.apply).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text="取消", command=self.destroy).pack(side=tk.LEFT, padx=5)

        # 2026-08-26 修复：表单值实时同步到列表摘要。原来坐标/类型/强度只在
        # 切换选中项或点「应用」时才写回，新加 delogo 填完坐标列表数值不变，
        # 要保存重开才看得到。给各表单变量挂 trace，任一变化即时刷新当前项列表行。
        self._loading_form = False
        for _v in (self.x_var, self.y_var, self.w_var, self.h_var,
                   self.type_var, self.strength_var, self.enabled_var, self.region_var,
                   self.enable_start_var, self.enable_end_var,
                   self.enable_cycle_var, self.enable_show_var):
            with suppress(Exception):
                _v.trace_add("write", self._sync_current_to_tree)

        self.update_coord_state()
    
    # 区域效果类型（2026-09-07）：走统一的「仅应用到选定区域」开关——
    # 勾=恒局部（旧行为，坐标解锁）；不勾=全帧时间段效果（坐标禁用）。
    # 与生成端 _REGION_EFFECT_FILTERS 一一对应，加类型时两边一起改。
    _REGION_EFFECTS = ("negate", "hflip", "vflip", "swapuv", "desat", "eq_bright",
                       "unsharp", "avgblur", "median", "black", "white")

    # 有强度参数的类型：type -> (强度框标签, 默认值)。不在此表里的类型强度框禁用。
    _STRENGTH_SPEC = {
        "boxblur": ("半径:", "5"),
        "gblur": ("sigma:", "2.0"),
        "unsharp": ("强度:", "1.5"),
        "avgblur": ("半径:", "5"),
        "median": ("半径:", "3"),
        "eq_bright": ("亮度:", "-0.3"),
    }

    def _is_region_blur(self) -> bool:
        """当前是否处于「局部模糊」状态（仅 boxblur/gblur 有意义）"""
        return bool(self.region_var.get()) and self.type_var.get() in ("boxblur", "gblur")

    def update_strength_state(self):
        """仅更新标签文字与可编辑状态，不改动用户已填的数值。"""
        ftype = self.type_var.get()
        _spec = self._STRENGTH_SPEC.get(ftype)
        if _spec:
            self.strength_label.config(text=_spec[0])
            self.strength_entry.config(state="normal")
        else:
            # delogo 沿用「参数:」，其余无强度的区域效果统一「无:」
            self.strength_label.config(text="参数:" if ftype == "delogo" else "无:")
            self.strength_entry.config(state="disabled")
    
    def update_coord_state(self):
        ftype = self.type_var.get()
        # delogo 恒区域；区域效果勾「仅应用到选定区域」时需坐标（不勾=全帧免坐标）；
        # boxblur/gblur 仅勾局部时需坐标
        if ftype == "delogo":
            need_coord = True
        elif ftype in self._REGION_EFFECTS:
            need_coord = bool(self.region_var.get())
        else:
            need_coord = self._is_region_blur()
        state = "normal" if need_coord else "disabled"
        for entry in getattr(self, "_coord_entries", []):
            entry.config(state=state)
        # 统一开关仅 delogo 不可用（恒区域）；其余类型都用它切换 局部/全帧
        if hasattr(self, "region_chk"):
            self.region_chk.config(state="disabled" if ftype == "delogo" else "normal")

    def on_type_change(self, event=None):
        ftype = self.type_var.get()
        _spec = self._STRENGTH_SPEC.get(ftype)
        if _spec:
            # 切换类型时始终填入该类型的默认值，保证下拉选项与强度值联动
            self.strength_var.set(_spec[1])
        else:
            # delogo 与无强度的区域效果：强度清空
            self.strength_var.set("")
        # delogo 恒区域，开关关掉；其余类型保留当前 局部/全帧 选择（换类型不打断）
        if ftype == "delogo":
            self.region_var.set(False)
        self.update_strength_state()
        self.update_coord_state()

    def on_region_toggle(self):
        self.update_coord_state()

    def quick_region_blur(self):
        """一键切换到「局部应用」：启用 + 勾「仅应用到选定区域」+ 自动补坐标
        （delogo 会自动换成 boxblur，其余类型保持不动只勾局部）"""
        self.enabled_var.set(True)
        if self.type_var.get() == "delogo":
            self.type_var.set("boxblur")
            self.strength_var.set("5")
        self.region_var.set(True)
        # 坐标缺失时尝试从「裁剪」设置带入
        if not (self.w_var.get().strip() and self.h_var.get().strip()):
            self.copy_from_crop(silent=True)
        if not self.strength_var.get().strip():
            self.strength_var.set("5" if self.type_var.get() == "boxblur" else "2.0")
        self.update_strength_state()
        self.update_coord_state()
        if getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                "已切换为局部应用（仅作用选定区域）：应用后 -vf 将自动生成 "
                "split→crop→滤镜→overlay 滤镜图，"
                "并排在裁剪/旋转/缩放等滤镜之前（坐标以原始画面为准）")
    
    def _resolve_crop_coord(self, expr):
        """把裁剪坐标表达式（可能含 iw/ih，如 iw/2、ih-100）按输入文件原始尺寸换算成数字。

        delogo 滤镜不支持表达式（x/y/w/h 只认像素数字），而裁剪参数常填 iw/2 等相对式，
        复制到 delogo 前必须求值。纯数字直接返回；取不到尺寸或求值失败则保留原样（与旧行为一致）。"""
        expr = expr.strip()
        if not expr:
            return expr
        if expr.lstrip("-").isdigit():
            return expr
        app = getattr(self.filter_frame, "app", None)
        file_path = ""
        if app is not None:
            inp = getattr(app, "input_file", None)
            if inp is not None:
                file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
            if not file_path:
                file_path = getattr(self.filter_frame, "current_file", "") or ""
        if file_path and os.path.exists(file_path) and app is not None:
            try:
                ow, oh = app._get_video_dimensions_cached(file_path)
            except Exception:
                ow = oh = None
            if ow and oh:
                # iw/ih 按原始尺寸求值（不再在此减 2：delogo 的边界安全化由
                # _delogo_safe 统一处理——仅减宽高不解决 x=0/y=0 贴边失败）
                if expr == "iw":
                    return str(ow)
                if expr == "ih":
                    return str(oh)
                val = safe_eval_expr(expr, {"iw": ow, "ih": oh})
                if val is not None:
                    return str(val)
        return expr

    def _delogo_safe(self, x, y, w, h, ow, oh):
        """delogo 区域必须四周留 ≥1 像素边界，否则滤镜失败（实测 ffmpeg 8.1：
        x/y=0 贴边、x+w≥iw、y+h≥ih 均报 Error reinitializing filters）。
        对复制/框选来的坐标统一缩进到安全范围。返回 (x,y,w,h)。"""
        if x < 1:
            w -= (1 - x)
            x = 1
        if y < 1:
            h -= (1 - y)
            y = 1
        if w > ow - x - 1:
            w = ow - x - 1
        if h > oh - y - 1:
            h = oh - y - 1
        return x, y, w, h

    def copy_from_crop(self, silent: bool = False):
        crop_w = self.filter_frame.crop_width.get().strip()
        crop_h = self.filter_frame.crop_height.get().strip()
        crop_x = self.filter_frame.crop_left.get().strip()
        crop_y = self.filter_frame.crop_top.get().strip()
        if not crop_w or not crop_h:
            if not silent:
                messagebox.showwarning("提示", "裁剪未启用或参数为空，请先在「视频滤镜」中启用裁剪并设置区域。")
            return
        # delogo 不支持表达式：iw/ih 按输入文件原始尺寸换算成数字后填入
        # delogo 的 x/y/w/h 不允许为 0（w/h=0 滤镜无效），凡解析为 0 一律改为 1
        def _nonzero(v):
            try:
                if int(v) == 0:
                    return "1"
            except (ValueError, TypeError):
                pass
            return v
        x = self._resolve_crop_coord(crop_x)
        y = self._resolve_crop_coord(crop_y)
        w = self._resolve_crop_coord(crop_w)
        h = self._resolve_crop_coord(crop_h)
        # delogo 区域必须四周留 ≥1px 边界（x/y=0 贴边或右/下越界 → 滤镜失败）。
        # 框选整画面 (0,0,720,405) 会被缩进为 (1,1,718,403)；数字与 iw/ih 表达式统一处理。
        if self.type_var.get() == "delogo":
            app = getattr(self.filter_frame, "app", None)
            file_path = ""
            if app is not None:
                inp = getattr(app, "input_file", None)
                if inp is not None:
                    file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
                if not file_path:
                    file_path = getattr(self.filter_frame, "current_file", "") or ""
            if file_path and os.path.exists(file_path) and app is not None:
                try:
                    ow, oh = app._get_video_dimensions_cached(file_path)
                except Exception:
                    ow = oh = None
                if ow and oh:
                    try:
                        xi, yi, wi, hi = int(x), int(y), int(w), int(h)
                    except (ValueError, TypeError):
                        pass  # 含无法求值的表达式 → 保持原样
                    else:
                        xi, yi, wi, hi = self._delogo_safe(xi, yi, wi, hi, ow, oh)
                        x, y, w, h = str(xi), str(yi), str(wi), str(hi)
        self.x_var.set(_nonzero(x))
        self.y_var.set(_nonzero(y))
        self.w_var.set(_nonzero(w))
        self.h_var.set(_nonzero(h))
        if not self.enabled_var.get():
            self.enabled_var.set(True)
        # 已开启局部模糊时保持当前模糊类型，不再强制切回 delogo
        switched = False
        if self.type_var.get() != "delogo" and not self.region_var.get():
            self.type_var.set("delogo")
            self.on_type_change()
            switched = True
        else:
            self.update_coord_state()
        if not silent and getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                "已从裁剪复制坐标，并自动切换到 delogo 模式" if switched else "已从裁剪复制坐标")
    
    # ---------- 多区域列表 ----------
    def _refresh_blur_tree(self):
        sel = None
        if self.tree.selection():
            sel = self.tree.selection()[0]
        self.tree.delete(*self.tree.get_children())
        for i, it in enumerate(self.items):
            _en = "☑" if it.get("enabled", True) else "☐"
            _t = it.get("type", "delogo")
            if it.get("full_frame", False) and _t in self._REGION_EFFECTS:
                _sum = "全帧"
            else:
                _sum = f"({it.get('x','0')},{it.get('y','0')}) {it.get('w','100')}x{it.get('h','100')}"
            _s = it.get("strength", "")
            if _s and _t in self._STRENGTH_SPEC:
                _sum += f" r={_s}"
            self.tree.insert("", "end", iid=str(i), values=(_en, _t, _sum))
        if sel is not None and self.tree.exists(sel):
            self.tree.selection_set(sel)

    def _sync_current_to_tree(self, *args):
        """表单变量 trace 回调：把当前选中项表单值写回列表并刷新（实时联动）。

        2026-08-26 修复「新加 delogo 填完坐标列表数值不变」：坐标/类型/强度/
        启用任一变化即时更新当前项的列表行。加载表单期间由 _loading_form 守卫
        跳过（避免 set() → trace → 刷新 → selection 事件 → set() 死循环）。"""
        if getattr(self, "_loading_form", False):
            return
        idx = self._current_item_idx()
        if idx is None or not (0 <= idx < len(self.items)):
            return
        self._collect_form_to_item(idx)
        # ⚠️ 不再额外 selection_set：_refresh_blur_tree 已把选中行还原，
        # 再设一次只是多派发一轮 <<TreeviewSelect>>（白白多一次表单回读）。
        self._refresh_blur_tree()

    def _current_item_idx(self):
        s = self.tree.selection()
        if not s:
            return None
        try:
            return int(s[0])
        except (ValueError, TypeError):
            return None

    def _load_item_to_form(self, idx):
        """把第 idx 项读进表单。

        ⚠️ 2026-09-02 修复「半径 / sigma 输入框打字错乱」（回灌统一尝试版）：
        这里**绝不能**调 on_type_change()——那个方法会把 strength_var 无条件重置成
        类型默认值（boxblur→5、gblur→2.0）。用户敲一个键就会走
        「trace → _sync_current_to_tree → 刷列表 → selection_set → 选中事件
          → 本函数 → on_type_change → set(默认值)」，
        于是框里的值被冲回 5 / 2.0、光标跑到末尾，下一个字符追加到后面 →
        列表出现 51、2.01 这类怪值。加载表单只该同步**控件状态**，不该改数据。
        """
        # 加载期间置守卫，避免 var.set() → trace(_sync_current_to_tree) → 刷新 → 死循环
        self._loading_form = True
        try:
            it = self.items[idx]
            # ⚠️ enabled_var 是「启用去水印/模糊」总开关，单项启用由列表「启用」列点击管理——
            # 加载项时绝不覆盖总开关，否则点过启用列的项会被表单值覆盖回 True。
            # ⚠️ 一律走 _tk_setv：值没变就不写，避免把用户正在敲的框冲掉、光标跳到末尾。
            _tk_setv(self.type_var, it.get("type", "delogo"))
            _tk_setv(self.strength_var, it.get("strength", ""))
            _tk_setv(self.x_var, it.get("x", "0"))
            _tk_setv(self.y_var, it.get("y", "0"))
            _tk_setv(self.w_var, it.get("w", "100"))
            _tk_setv(self.h_var, it.get("h", "100"))
            if it.get("type", "delogo") in self._REGION_EFFECTS:
                # 区域效果：勾=局部（旧行为，full_frame 缺省/False），不勾=全帧（full_frame=True）
                _tk_setv(self.region_var, not bool(it.get("full_frame", False)))
            else:
                _tk_setv(self.region_var, it.get("region_only", False))
            _tk_setv(self.enable_start_var, it.get("enable_start", ""))
            _tk_setv(self.enable_end_var, it.get("enable_end", ""))
            _tk_setv(self.enable_cycle_var, it.get("enable_cycle", ""))
            _tk_setv(self.enable_show_var, it.get("enable_show", ""))
            # 不再调 on_type_change()：它只负责「类型下拉变动」时的联动，加载表单不该改数据
            self.update_strength_state()
            self.update_coord_state()
        finally:
            self._loading_form = False

    def _collect_form_to_item(self, idx):
        it = self.items[idx]
        # enabled 不收集：单项启用只由列表「启用」列点击切换（_on_tree_click），
        # 表单保存（apply）不得用总开关覆盖它——这正是「取消启用后保存又恢复」的根因。
        it["type"] = self.type_var.get()
        it["strength"] = self.strength_var.get()
        it["x"] = self.x_var.get()
        it["y"] = self.y_var.get()
        it["w"] = self.w_var.get()
        it["h"] = self.h_var.get()
        # 存储映射：区域效果类型用 full_frame 表达（不勾局部=全帧）；其余类型恒 False
        _ftype = self.type_var.get()
        it["region_only"] = self.region_var.get()
        it["full_frame"] = (not self.region_var.get()) if _ftype in self._REGION_EFFECTS else False
        # 显示时段 / 循环（起始/结束/周期/单次）
        it["enable_start"] = self.enable_start_var.get().strip()
        it["enable_end"] = self.enable_end_var.get().strip()
        it["enable_cycle"] = self.enable_cycle_var.get().strip()
        it["enable_show"] = self.enable_show_var.get().strip()

    def _on_tree_select(self, ev):
        idx = self._current_item_idx()
        if idx is None:
            return
        # ⚠️ 回环保卫：_refresh_blur_tree 重建行后会把选中行重新设回去，于是再派发一次
        # 本事件。若选中的还是同一行，说明这只是「刷新回声」——表单本来就是这行的数据，
        # 再回读一次会把用户正在敲的字符冲掉（radius 敲 1→1、再敲 1→51 的元凶之一）。
        if idx == self._last_sel:
            return
        # 先写回上一个选中项的表单值，再加载新选中项
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        self._load_item_to_form(idx)
        self._last_sel = idx

    def _on_tree_click(self, ev):
        with suppress(Exception):
            if self.tree.identify_column(ev.x) == "#1":
                iid = self.tree.identify_row(ev.y)
                if iid:
                    idx = int(iid)
                    self.items[idx]["enabled"] = not self.items[idx].get("enabled", True)
                    self._refresh_blur_tree()
                    self.tree.selection_set(iid)

    def _add_blur_item(self):
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        self.items.append({"enabled": True, "type": "delogo", "x": "100", "y": "100",
                           "w": "200", "h": "100", "strength": "", "region_only": False,
                           "full_frame": False,
                           "enable_start": "", "enable_end": "", "enable_cycle": "",
                           "enable_show": ""})
        self._refresh_blur_tree()
        self.tree.selection_set(str(len(self.items) - 1))
        self._last_sel = len(self.items) - 1
        self._load_item_to_form(self._last_sel)

    def _del_blur_item(self):
        idx = self._current_item_idx()
        if idx is None or not self.items:
            return
        del self.items[idx]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(False)
            self.type_var.set("delogo")
            self.x_var.set("0"); self.y_var.set("0")
            self.w_var.set("100"); self.h_var.set("100")
            self.strength_var.set(""); self.region_var.set(False)
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.on_type_change()
            self.update_strength_state()
            self.update_coord_state()

    def _move_blur_item(self, d):
        idx = self._current_item_idx()
        if idx is None:
            return
        if 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        ni = idx + d
        if ni < 0 or ni >= len(self.items):
            return
        self.items[idx], self.items[ni] = self.items[ni], self.items[idx]
        self._refresh_blur_tree()
        self.tree.selection_set(str(ni))
        self._last_sel = ni
        self._load_item_to_form(ni)

    def load_settings(self):
        # 多区域列表：优先 filter_frame._blur_items，无则旧键迁移
        items = list(getattr(self.filter_frame, "_blur_items", None) or [])
        if not items:
            _fe = self.filter_frame._blur_enabled.get()
            _fx = self.filter_frame._blur_x.get()
            _fw = self.filter_frame._blur_w.get()
            if _fe or _fx or _fw:
                items = [{
                    "enabled": _fe,
                    "type": self.filter_frame._blur_type.get() or "delogo",
                    "strength": self.filter_frame._blur_strength.get(),
                    "x": _fx,
                    "y": self.filter_frame._blur_y.get(),
                    "w": _fw,
                    "h": self.filter_frame._blur_h.get(),
                    "region_only": self.filter_frame._blur_region_only.get(),
                    "full_frame": False,
                    "enable_start": "", "enable_end": "", "enable_cycle": "",
                    "enable_show": "",
                }]
        self.items = [dict(i) for i in items]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(self.filter_frame._blur_enabled.get())
            self.type_var.set(self.filter_frame._blur_type.get())
            self.x_var.set(self.filter_frame._blur_x.get())
            self.y_var.set(self.filter_frame._blur_y.get())
            self.w_var.set(self.filter_frame._blur_w.get())
            self.h_var.set(self.filter_frame._blur_h.get())
            self.strength_var.set(self.filter_frame._blur_strength.get())
            self.region_var.set(self.filter_frame._blur_region_only.get())
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.update_strength_state()
            self.update_coord_state()

    def apply(self):
        # 当前选中项表单写回列表
        idx = self._current_item_idx()
        if idx is not None and 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        # 校验所有启用项
        for it in self.items:
            if not it.get("enabled", True):
                continue
            ftype = it.get("type", "delogo")
            region = it.get("region_only", False)
            # 全帧仅对区域效果类型有效；勾了全帧不需要坐标
            full = bool(it.get("full_frame", False)) and ftype in self._REGION_EFFECTS
            if not full and (ftype == "delogo" or ftype in self._REGION_EFFECTS or region):
                if ftype == "delogo":
                    label = "delogo"
                elif region:
                    label = "局部滤镜"
                else:
                    label = ftype
                for nm in ("x", "y", "w", "h"):
                    if alert_if(not (str(it.get(nm, "")).strip()), "错误", f"{label} 需要完整的区域坐标，{nm.upper()} 不能为空", 'error'):
                        return
            _spec = self._STRENGTH_SPEC.get(ftype)
            if _spec and not str(it.get("strength", "")).strip():
                it["strength"] = _spec[1]
        # 写回
        self.filter_frame._blur_items = [dict(i) for i in self.items]
        self.filter_frame._blur_enabled.set(self.enabled_var.get())  # 总开关
        # 兼容：旧单键同步第一项（旧版读取路径/预览仍可用）
        if self.items:
            it0 = self.items[0]
            self.filter_frame._blur_type.set(it0.get("type", "delogo"))
            self.filter_frame._blur_strength.set(it0.get("strength", ""))
            self.filter_frame._blur_x.set(it0.get("x", "0"))
            self.filter_frame._blur_y.set(it0.get("y", "0"))
            self.filter_frame._blur_w.set(it0.get("w", "100"))
            self.filter_frame._blur_h.set(it0.get("h", "100"))
            self.filter_frame._blur_region_only.set(it0.get("region_only", False))
        if self.enabled_var.get() and getattr(self.filter_frame, "app", None):
            _n = len([i for i in self.items if i.get("enabled", True)])
            if _n:
                self.filter_frame.app._append_info_ui(
                    f"[去水印/模糊] 已启用 {_n} 个区域（{'、'.join(i.get('type','') for i in self.items if i.get('enabled', True))}）")
        if hasattr(self.filter_frame, 'app') and self.filter_frame.app:
            self.filter_frame.app.update_command_preview()
        self.destroy()


# ================== 音频组件 ==================
# ================== 音频分段效果（公共件：转换页与封装页共用） ==================
# 机制：FFmpeg 滤镜的通用 timeline 选项 enable='表达式'，表达式里的 t = 该滤镜入口处的时间。
# 分段滤镜统一追加在所有音频滤镜的最末尾 → t 恒等于「输出时间线」（atrim / adelay / atempo /
# areverse 都已经在它前面生效），用户填的时间就是听到的第几秒，不需要做任何换算。
#
# 硬约束（2026-09-04 本机 ffmpeg n9.0.1 实测，改动前必读）：
#  1. T 标志闸门：只有 `ffmpeg -filters` 里带 T(Timeline support) 的滤镜才接受 enable，
#     否则 ffmpeg 直接硬报错「Timeline ('enable' option) not supported with filter 'xxx'」
#     导致整条命令失败。因此下表只收录带 T 的滤镜。
#     已实测不可用：acompressor / aecho / chorus / flanger / pan / atempo / loudnorm /
#     rubberband / asetrate / aphaser（段内压限·回声·消人声·变声·响度标准化均做不了）。
#  2. afade 串联做软边缘是死路：fade out 的包络结束后恒为 0，串联其后的 fade in 乘上去
#     永远回不来（实测整段静音）。软边缘只能用 volume=eval=frame:volume='表达式'，
#     且 eval=frame 必须写（漏写则表达式只在首帧求值一次、完全无效，同 scale 的 eval=init 陷阱）。
#  3. 该表达式按「帧」求值，软边缘的过渡精度约为一个音频帧（1024 采样 ≈ 23ms @44.1kHz）。

AUDIO_SEGMENT_TYPES = {
    "mute": {
        "label": "静音",
        "params": [],
        "tip": "段内音量归零，音频总时长不变（不是删除片段）。可勾柔化做淡入淡出过渡。",
    },
    "volume": {
        "label": "局部音量",
        "params": [("倍数", "0.5")],
        "tip": "段内音量按倍数缩放：1.0=原音量，0.5=减半，>1 会放大（可能破音）。",
    },
    "fade_in": {
        "label": "段首淡入",
        "params": [("时长(秒)", "0.5")],
        "tip": "从段首起音量由 0 渐升到原音量。每段生成独立 afade 实例，不与其他段合并。",
    },
    "fade_out": {
        "label": "段尾淡出",
        "params": [("时长(秒)", "0.5")],
        "tip": "在段尾前 N 秒内音量渐降到 0。每段生成独立 afade 实例，不与其他段合并。",
    },
    "denoise": {
        "label": "降噪",
        "params": [("强度 nr", "12"), ("门限 nf", "-30")],
        "tip": "仅段内做 FFT 降噪（afftdn）。nr 越大降噪越狠，nf 越低保留越多。",
    },
    "highpass": {
        "label": "高通",
        "params": [("频率(Hz)", "200")],
        "tip": "切除段内低于该频率的声音，常用于去风声、空调隆隆声。",
    },
    "lowpass": {
        "label": "低通",
        "params": [("频率(Hz)", "3000")],
        "tip": "切除段内高于该频率的声音，常用于去嘶声、电流高频噪声。",
    },
    "eq_low": {
        "label": "低音 EQ",
        "params": [("增益(dB)", "6")],
        "tip": "段内低音（bass）增益，正数增强、负数衰减。",
    },
    "eq_mid": {
        "label": "中音 EQ",
        "params": [("增益(dB)", "0")],
        "tip": "段内中音（1kHz 峰均）增益，主要影响人声清晰度。",
    },
    "eq_high": {
        "label": "高音 EQ",
        "params": [("增益(dB)", "6")],
        "tip": "段内高音（treble）增益，正数增强、负数衰减。",
    },
}

# 走 volume 滤镜的类型才支持软边缘（表达式包络）
_ASEG_SOFT_TYPES = ("mute", "volume")


def aseg_type_label(t):
    """效果类型 key → 中文显示名（未登记类型原样返回，避免 KeyError）。"""
    d = AUDIO_SEGMENT_TYPES.get(t)
    return d["label"] if d else str(t)


# 下拉框显示中文名，内部数据一律存 key；反查表 = 显示映射函数，调用时求值（禁写成模块级常量，
# 否则 multi 侧 _() 冻在导入时中文 ⇒ 英文界面下拉值查不到，见 multi 同名函数 docstring）
def aseg_label_to_key():
    """显示名 → 内部 token（英文 key，稳定）。

    ⚠️ 必须是函数：下拉 values 与此处 key 必须同源求值，写成模块级常量会让
    后续追加的显示映射（multi 版）对不上（multi 那侧是同款雷）。
    """
    return {_s["label"]: k for k, _s in AUDIO_SEGMENT_TYPES.items()}


def aseg_key_from_label(label):
    """中文显示名 → 效果类型 key（未登记的原样返回，兼容老数据）。"""
    return aseg_label_to_key().get(label, label)


def _aseg_num(x):
    """滤镜参数/表达式里的数字：定宽 4 位小数并去掉无意义的尾巴（1.0000→1，1000 不会被截）。"""
    try:
        s = f"{float(x):.4f}"
    except (TypeError, ValueError):
        return "0"
    return s.rstrip("0").rstrip(".") if "." in s else s


def _aseg_filter_body(t, p1, p2):
    """效果类型 + 参数 → 滤镜主体串（不含 enable）。"""
    if t == "mute":
        return "volume=0"
    if t == "volume":
        return f"volume={_aseg_num(_opt_float(p1, 1.0))}"
    if t == "denoise":
        return (f"afftdn=nr={_aseg_num(_opt_float(p1, 12.0))}"
                f":nf={_aseg_num(_opt_float(p2, -30.0))}")
    if t == "highpass":
        return f"highpass=f={_aseg_num(_opt_float(p1, 200.0))}"
    if t == "lowpass":
        return f"lowpass=f={_aseg_num(_opt_float(p1, 3000.0))}"
    if t == "eq_low":
        return f"bass=g={_aseg_num(_opt_float(p1, 0.0))}"
    if t == "eq_mid":
        return f"equalizer=f=1000:width_type=h:width=200:g={_aseg_num(_opt_float(p1, 0.0))}"
    if t == "eq_high":
        return f"treble=g={_aseg_num(_opt_float(p1, 0.0))}"
    return ""


def _aseg_soft_expr(ranges, target, r):
    """生成多段软边缘音量包络（clip/max/min，规避 ffmpeg 嵌套 if 解析失败）。

    单段 [a,b]、目标音量 v、柔化半径 r(秒)：
      t<a-r → 1；[a-r,a] → 1 线性降到 v；[a,b] → v；[b,b+r] → v 线性升回 1；t>b+r → 1。
    多段取 min（最「静」的一层）；每段只加一层 max，线性增长不指数膨胀，段重叠语义正确。
    说明：ffmpeg 表达式解析器不支持 if 嵌套在 if 的第三参数（报 too many args），
    故改用 clip(钳制)+max+min 的纯算术形式。
    """
    envs = []
    for a, b in ranges:
        ar = a - r
        rd = f"1+({_aseg_num(target)}-1)*clip((t-{_aseg_num(ar)})/{_aseg_num(r)},0,1)"
        ru = f"{_aseg_num(target)}+({_aseg_num(1.0 - target)})*clip((t-{_aseg_num(b)})/{_aseg_num(r)},0,1)"
        envs.append(f"max({rd},{ru})")
    if not envs:
        return "1"
    # ffmpeg 的 min/max 仅接受固定个数参数（多段并排 min(a,b,c,...) 会初始化失败），
    # 利用结合律改为两两嵌套 min，每个 min 恒为 2 参数，与段数无关。
    expr = "1"
    for e in reversed(envs):
        expr = f"min({e},{expr})"
    return expr


def build_audio_segment_filters(segments, trim_start=0.0, speed_factor=1.0, offset=0.0):
    """把分段列表编译成 ffmpeg 音频滤镜串列表（调用方 join 后接到 -af 链尾）。

    - 过滤：未启用 / 时间非数字 / end<=start / start<0 的段直接跳过
      （校验与提示由 UI 层负责，这里只做兜底，绝不抛异常）。
    - **时间基准换算（2026-09-04 修复）**：用户填的分段时间是「源时间线」（听见第几秒
      即源文件第几秒），但滤镜链在 atrim+asetpts 之后 t 已归零到输出时间线，故每段
      必须按 trim_start/speed_factor 换算：a_out=max(0,(a-trim_start)/speed)、
      b_out=(b-trim_start)/speed；b_out<=a_out（整段落在 trim 之前）的段直接丢弃。
      与视频 _timeline_convert 同公式，conversion 页传视频 trim 起点、merge 页传每轨
      trim_start，做到「音频跟随截取」。不传（默认 0/1）即源=输出，零影响。
    - **offset（2026-09-04 增）**：封装页 adelay 在分段滤镜之前 → 输出 t 被推后
      offset 秒（且随 atempo 缩放），换算须把 offset 加回内容位置：
      a_out=max(0,((a-trim_start)+offset)/speed)。转换页无音频偏移，传默认 0。
    - 合并：同 (type, p1, p2, soft) 的段合成单个滤镜实例，enable 用
      between(t,a,b)+between(t,c,d) 相加表达「或」→ 滤镜链长度不随段数膨胀。
    - 软边缘：mute/volume 且柔化>0 时改用 volume=eval=frame:volume='包络表达式'。
    - 淡入淡出：afade 的 st 是硬参数，每段独立实例，不合并、也不加 enable。
    """
    if not segments:
        return []
    _ts = _opt_float(trim_start or 0.0, 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _off = _opt_float(offset or 0.0, 0.0)
    items = []
    for seg in segments:
        if not isinstance(seg, dict) or not seg.get("enabled", True):
            continue
        try:
            a = float(seg.get("start", 0))
            b = float(seg.get("end", 0))
        except (TypeError, ValueError):
            continue
        if b <= a or a < 0:
            continue
        # 换算到 atrim+asetpts 之后的输出时间线（与视频 _timeline_convert 同公式）。
        # offset：封装页 adelay 在分段之前 → 输出 t 被推后 off 秒（且随 atempo 缩放），
        # 故换算须把 off 加回内容位置：(src - trim_start + offset) / speed。
        a = max(0.0, ((a - _ts) + _off) / _sp)
        b = ((b - _ts) + _off) / _sp
        if b <= a:
            continue
        items.append((a, b, seg))
    if not items:
        return []
    items.sort(key=lambda x: (x[0], x[1]))

    out = []
    # 1) 淡入淡出：每段独立 afade 实例
    for a, b, seg in items:
        t = seg.get("type", "mute")
        if t == "fade_in":
            d = _opt_float(seg.get("p1", ""), 0.5)
            if d > 0:
                out.append(f"afade=t=in:st={_aseg_num(a)}:d={_aseg_num(d)}")
        elif t == "fade_out":
            d = _opt_float(seg.get("p1", ""), 0.5)
            if d > 0:
                out.append(f"afade=t=out:st={_aseg_num(max(0.0, b - d))}:d={_aseg_num(d)}")

    # 2) 其余效果：按 (type, p1, p2, soft) 分组，同组共用一个滤镜实例
    groups = {}
    order = []
    for a, b, seg in items:
        t = seg.get("type", "mute")
        if t in ("fade_in", "fade_out"):
            continue
        soft = 0
        if t in _ASEG_SOFT_TYPES:
            soft = int(_opt_float(seg.get("soft", 0), 0))
            if soft < 0:
                soft = 0
        p1 = str(seg.get("p1", ""))
        p2 = str(seg.get("p2", ""))
        key = (t, p1, p2, soft)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append((a, b))

    for key in order:
        t, p1, p2, soft = key
        ranges = groups[key]
        # 静音 / 局部音量：走 volume 表达式（eval=frame 每帧求值，绕开 enable 段首瞬态，
        # 且与柔化共用同一滤镜形式；硬切=if(enable,target,1)，柔化=clip/max/min 包络）。
        if t in _ASEG_SOFT_TYPES:
            target = 0.0 if t == "mute" else _opt_float(p1, 1.0)
            if soft > 0:
                out.append(f"volume=eval=frame:volume='{_aseg_soft_expr(ranges, target, soft / 1000.0)}'")
            else:
                enable = "+".join(f"between(t,{_aseg_num(a)},{_aseg_num(b)})" for a, b in ranges)
                out.append(f"volume=eval=frame:volume='if({enable},{_aseg_num(target)},1)'")
            continue
        # 其余效果（降噪/滤波/EQ 等）：沿用 enable 表达式（频率类切换无静音式爆音，瞬态可忽略）
        body = _aseg_filter_body(t, p1, p2)
        if not body:
            continue
        expr = "+".join(f"between(t,{_aseg_num(a)},{_aseg_num(b)})" for a, b in ranges)
        out.append(f"{body}:enable='{expr}'")
    if out:
        # ⚠️ 2026-09-04 实测：atempo 输出的帧 PTS 是 AV_NOPTS（无效值），
        # 其后 volume=eval=frame / enable 表达式里的 t 全部失效（分段静音静默失效）。
        # 分段组前统一 asetpts=PTS-STARTPTS 重置时间轴（幂等：无 atempo 时首帧本就 pts=0，
        # adelay 头部静音的内容/t 映射不受影响）。
        out.insert(0, "asetpts=PTS-STARTPTS")
    return out


class AudioSegmentDialog:
    """音频分段效果编辑器（列表式）。

    转换页（self.audio_segments）与封装页（track.enc_settings["audio_segments"]）共用同一份实现，
    调用方只负责传入/取回列表；滤镜编译统一走 build_audio_segment_filters()。
    """

    _TREE_H = 9

    def __init__(self, parent, segments, title="音频分段效果", app=None, file_source=None):
        self.parent = parent
        self.title_text = title
        self.segments = [dict(s) for s in (segments or []) if isinstance(s, dict)]
        self.result = None
        self._loading = False
        self._last_sel = None
        # 时间预览入口（2026-09-05）：app=主程序引用（ffmpeg/ffplay 路径），
        # file_source=返回当前音频源文件路径的回调（None 则不显示「时间预览」按钮）
        self.app = app
        self.file_source = file_source

    # ---------- 列表渲染 ----------
    def _fill_tree(self):
        tv = self.tree
        for iid in tv.get_children():
            tv.delete(iid)
        for i, seg in enumerate(self.segments):
            try:
                a = float(seg.get("start", 0))
                b = float(seg.get("end", 0))
            except (TypeError, ValueError):
                a = b = 0.0
            t = seg.get("type", "mute")
            spec = AUDIO_SEGMENT_TYPES.get(t, {})
            labels = [lb for lb, _dv in spec.get("params", [])]
            vals = [str(seg.get("p1", "")), str(seg.get("p2", ""))]
            pv = "  ".join(f"{lb}={v}" for lb, v in zip(labels, vals) if v != "")
            soft = int(_opt_float(seg.get("soft", 0), 0))
            if soft > 0 and t in _ASEG_SOFT_TYPES:
                pv = (pv + f"  柔化{soft}ms").strip()
            tv.insert("", "end", iid=str(i), values=(
                "√" if seg.get("enabled", True) else "",
                seconds_to_time(a, short=True),
                seconds_to_time(b, short=True),
                f"{b - a:.3f}s" if b > a else "-",
                aseg_type_label(t),
                pv,
            ))
        self._update_count()

    def _update_count(self):
        n = len(self.segments)
        on = sum(1 for s in self.segments if s.get("enabled", True))
        if hasattr(self, "count_label"):
            self.count_label.config(text=f"共 {n} 段（启用 {on} 段）")

    # ---------- 选中 / 编辑区同步（三守卫：_loading 内、_last_sel 同项短路） ----------
    def _sel_index(self):
        sel = self.tree.selection()
        if not sel:
            return None
        try:
            return int(sel[0])
        except (TypeError, ValueError):
            return None

    def _on_select(self, _evt=None):
        if self._loading:
            return
        idx = self._sel_index()
        if idx == self._last_sel:
            return
        # 切换前先把编辑区写回「正在离开的段」（防止直接点列表导致本段改动丢失/串到下一
        # 段）。与视频列表的「_setv 同值不写 / _loading 内 / _last_sel 同项短路」三守卫一致。
        self._commit_form_to(self._last_sel)
        self._last_sel = idx
        self._load_to_form(idx)

    def _load_to_form(self, idx):
        self._loading = True
        try:
            if idx is None or idx >= len(self.segments):
                self.start_var.set("")
                self.end_var.set("")
                self.type_var.set(aseg_type_label("mute"))
                self.p1_var.set("")
                self.p2_var.set("")
                self.soft_var.set("0")
                self._sync_param_fields()
                return
            seg = self.segments[idx]
            try:
                a = float(seg.get("start", 0))
                b = float(seg.get("end", 0))
            except (TypeError, ValueError):
                a = b = 0.0
            self.start_var.set(seconds_to_time(a, short=True))
            self.end_var.set(seconds_to_time(b, short=True))
            self.type_var.set(aseg_type_label(seg.get("type", "mute")))
            self.p1_var.set(str(seg.get("p1", "")))
            self.p2_var.set(str(seg.get("p2", "")))
            self.soft_var.set(str(int(_opt_float(seg.get("soft", 0), 0))))
            self._sync_param_fields()
        finally:
            self._loading = False

    def _sync_param_fields(self):
        """按当前效果类型显示/隐藏参数框（ttk 禁用用 state(["disabled"])）。"""
        key = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(key, {})
        params = spec.get("params", [])
        for i, (lbl, ent, var) in enumerate(self._param_widgets):
            if i < len(params):
                name, dflt = params[i]
                lbl.config(text=f"{name}:")
                if not var.get():
                    var.set(dflt)
                lbl.state(["!disabled"])
                ent.state(["!disabled"])
            else:
                lbl.config(text="—:")
                var.set("")
                lbl.state(["disabled"])
                ent.state(["disabled"])
        # 软边缘只对 mute / volume 有意义（其余滤镜不走 volume 包络）
        if key in _ASEG_SOFT_TYPES:
            self.soft_label.state(["!disabled"])
            self.soft_entry.state(["!disabled"])
        else:
            self.soft_label.state(["disabled"])
            self.soft_entry.state(["disabled"])

    def _commit_form_to(self, idx):
        """把编辑区当前内容写回第 idx 段（仅写数据 + 单行刷新，不碰选择、不触发回环）。"""
        if self._loading:
            return
        if idx is None or idx < 0 or idx >= len(self.segments):
            return
        seg = self.segments[idx]
        s = time_to_seconds(self.start_var.get().strip())
        e = time_to_seconds(self.end_var.get().strip())
        if s is None:
            s = float(seg.get("start", 0) or 0)
        if e is None:
            e = float(seg.get("end", 0) or 0)
        seg["start"] = s
        seg["end"] = e
        seg["type"] = aseg_key_from_label(self.type_var.get())
        seg["p1"] = self.p1_var.get().strip()
        seg["p2"] = self.p2_var.get().strip()
        seg["soft"] = int(_opt_float(self.soft_var.get(), 0))
        self._refresh_row(idx)
        self._update_count()

    def _refresh_row(self, idx):
        """只更新第 idx 行显示（tree.item 不删除子项 → 不丢选择、不派发 <<TreeviewSelect>>）。"""
        if idx is None or idx < 0 or idx >= len(self.segments):
            return
        try:
            tv = self.tree
        except Exception:
            return
        seg = self.segments[idx]
        try:
            a = float(seg.get("start", 0))
            b = float(seg.get("end", 0))
        except (TypeError, ValueError):
            a = b = 0.0
        t = seg.get("type", "mute")
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        labels = [lb for lb, _dv in spec.get("params", [])]
        vals = [str(seg.get("p1", "")), str(seg.get("p2", ""))]
        pv = "  ".join(f"{lb}={v}" for lb, v in zip(labels, vals) if v != "")
        soft = int(_opt_float(seg.get("soft", 0), 0))
        if soft > 0 and t in _ASEG_SOFT_TYPES:
            pv = (pv + f"  柔化{soft}ms").strip()
        try:
            tv.item(str(idx), values=(
                "√" if seg.get("enabled", True) else "",
                seconds_to_time(a, short=True),
                seconds_to_time(b, short=True),
                f"{b - a:.3f}s" if b > a else "-",
                aseg_type_label(t),
                pv,
            ))
        except Exception:
            # 行不存在（极少数并发）时退回整表刷新
            self._fill_tree()

    def _apply_form_to_sel(self, *args):
        """编辑区改动 → 写回「最后一次加载进编辑区的段」(_last_sel)。

        *args 兼容两种回调：<Return>/<FocusOut> 传 event；StringVar write trace
        传 (name, index, mode) 三参（与视频列表原型 _sync_current_to_tree 同款）。
        ⚠️ 提交目标必须锁定 _last_sel，不能取“当前选中行”：
        用户「输入完马上点下一段」时，Entry 的 <FocusOut> 与 Treeview 的
        <<TreeviewSelect>> 触发先后顺序不可靠，若按当前选中提交，迟到的 FocusOut
        会把正在编辑的内容写进新选中的段（两段同时变成新时间）。
        锁定 _last_sel 后任何时序都只落回正在编辑的那段；配合 show() 里挂的
        write trace（击键当下即落盘），编辑内容不存在“未提交残留”，串段不可能发生。
        """
        self._commit_form_to(self._last_sel)

    def _on_type_changed(self, _evt=None):
        """切换效果类型：参数默认值跟着换，空参数自动填上默认值。"""
        spec = AUDIO_SEGMENT_TYPES.get(aseg_key_from_label(self.type_var.get()), {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        if len(defaults) > 0 and not self.p1_var.get().strip():
            self.p1_var.set(defaults[0])
        if len(defaults) > 1 and not self.p2_var.get().strip():
            self.p2_var.set(defaults[1])
        self._sync_param_fields()
        self._apply_form_to_sel()

    # ---------- 列表操作 ----------
    def _add(self):
        # 先保存正在编辑的段（防点「添加」时本段改动丢失/串段）
        self._commit_form_to(self._last_sel)
        seg = {"enabled": True, "start": 0.0, "end": 1.0, "type": "mute",
               "p1": "", "p2": "", "soft": 0}
        if self.segments:
            try:
                last_end = max(float(x.get("end", 0) or 0) for x in self.segments)
            except (TypeError, ValueError):
                last_end = 0.0
            seg["start"] = last_end
            seg["end"] = last_end + 1.0
        self.segments.append(seg)
        self._fill_tree()
        self._select(len(self.segments) - 1)

    def _delete(self):
        # 先保存正在编辑的段
        self._commit_form_to(self._last_sel)
        idx = self._sel_index()
        if idx is None:
            return
        del self.segments[idx]
        self._fill_tree()
        self._select(min(idx, len(self.segments) - 1))

    def _move(self, delta):
        # 先保存正在编辑的段
        self._commit_form_to(self._last_sel)
        idx = self._sel_index()
        if idx is None:
            return
        j = idx + delta
        if j < 0 or j >= len(self.segments):
            return
        self.segments[idx], self.segments[j] = self.segments[j], self.segments[idx]
        self._fill_tree()
        self._select(j)

    def _clear(self):
        if not self.segments:
            return
        self.segments = []
        self._fill_tree()
        self._load_to_form(None)

    def _import_time(self):
        """从剪贴板读 `-ss S -to E` 行批量建段（与音频截取的「导入时间」同格式）。"""
        # 先保存正在编辑的段（防导入时本段改动丢失）
        self._commit_form_to(self._last_sel)
        # ⚠️ 非阻塞读（2026-09-16）：同步 clipboard_get 在预览窗口持有剪贴板时会死锁，
        # 主线程全程不阻塞、读毕再建段。
        read_clipboard_safe(self.win, self._import_time_apply)

    def _import_time_apply(self, text):
        text = (text or "").strip()
        pairs = parse_ss_to_commands(text)
        if alert_if(not pairs, "提示", "剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）", 'info', parent=self.win):
            return
        t = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        for s, e in pairs:
            self.segments.append({
                "enabled": True, "start": float(s), "end": float(e), "type": t,
                "p1": defaults[0] if len(defaults) > 0 else "",
                "p2": defaults[1] if len(defaults) > 1 else "",
                "soft": 0,
            })
        self._fill_tree()
        self._select(len(self.segments) - 1)

    def _select(self, idx):
        if idx is None or idx < 0 or not self.segments:
            self._last_sel = None
            self._load_to_form(None)
            return
        self._last_sel = idx
        self.tree.selection_set(str(idx))
        self.tree.see(str(idx))
        self._load_to_form(idx)

    # ---------- 时间预览入口（2026-09-05 方案B：简易时间预览音频引擎形态） ----------
    def _open_time_preview(self):
        """打开简易时间预览（打开即音频引擎：ffplay 直读+内存波形+段落条打标）。
        「发送到列表」把标记段按编辑区当前效果类型追加到本对话框分段列表，
        时间=源文件时间线（启用截取/变速后由 build_audio_segment_filters 自动换算）。"""
        try:
            path = self.file_source()
        except Exception:
            path = None
        if alert_if(not path or not os.path.exists(path), "提示", "未找到音频/视频源文件，无法打开时间预览", 'info', parent=self.win):
            return
        app = self.app
        if alert_if(app is None or not getattr(app, "ffmpeg_cmd", None), "提示", "未找到 ffmpeg，无法预览", 'info', parent=self.win):
            return
        # ⚠️ 释放宿主弹窗的模态 grab（与其它时间预览入口同一问题）——否则预览窗口
        # 被 grab 锁住焦点（点击/拖拽无效），预览窗口自身置顶可交互。
        release_grab(app.root)
        # 已有分段回溯为标记段显示在段落条上（可直接在此基础上增删改再发回）
        init_marks = [(s.get("start"), s.get("end")) for s in self.segments]
        app.show_time_picker(self.win, path,
                             on_send_segments=self._receive_preview_marks,
                             initial_marks=init_marks,
                             use_output_context=False,   # 纯源时间线，不显示成片时间
                             start_mode="audio")

    def _receive_preview_marks(self, pairs):
        """简易时间预览「发送到列表」回调：标记段按编辑区当前效果类型追加为分段。
        落点结构与「导入时间」完全一致（enabled/start/end/type/p1/p2/soft）。"""
        with suppress(Exception):
            self._commit_form_to(self._last_sel)   # 先落盘正在编辑的段，防改动丢失
        t = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        added = 0
        for s, e in pairs:
            try:
                a, b = float(s), float(e)
            except (TypeError, ValueError):
                continue
            if b <= a:
                continue
            self.segments.append({
                "enabled": True, "start": a, "end": b, "type": t,
                "p1": defaults[0] if len(defaults) > 0 else "",
                "p2": defaults[1] if len(defaults) > 1 else "",
                "soft": 0,
            })
            added += 1
        if added:
            self._fill_tree()
            self._select(len(self.segments) - 1)

    # ---------- 构建 ----------
    def show(self):
        win = self.win = tk.Toplevel(self.parent)
        win.withdraw()
        win.title(self.title_text)

        main = ttk.Frame(win, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        tip = ttk.Label(main,
                        text="在指定时间区间内施加音频效果，音频总时长不变。"
                             "时间填源文件里听到第几秒，工具会自动按截取/变速换算到输出时间线。",
                        wraplength=860, justify=tk.LEFT, foreground="#555555")
        tip.pack(fill=tk.X, pady=(0, 6))

        # ---- 列表 ----
        cols = ("on", "start", "end", "dur", "type", "param")
        tree = self.tree = ttk.Treeview(main, columns=cols, show="headings",
                                        height=self._TREE_H, selectmode="browse")
        for cid, head, w in (("on", "启用", 42), ("start", "开始", 96), ("end", "结束", 96),
                             ("dur", "时长", 76), ("type", "效果", 88), ("param", "参数", 190)):
            tree.heading(cid, text=head)
            tree.column(cid, width=w, anchor=tk.W if cid in ("type", "param") else tk.CENTER)
        sb = ttk.Scrollbar(main, orient=tk.VERTICAL, command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb.pack(side=tk.LEFT, fill=tk.Y)
        tree.bind("<<TreeviewSelect>>", self._on_select)

        right = ttk.Frame(main)
        right.pack(side=tk.LEFT, fill=tk.BOTH, padx=(8, 0))

        # 双击切换启用（单行刷新：整表重建会丢选择并派发 TreeviewSelect 回环）
        def _toggle_enabled(_evt=None):
            idx = self._sel_index()
            if idx is None:
                return
            self.segments[idx]["enabled"] = not self.segments[idx].get("enabled", True)
            self._refresh_row(idx)
            self._update_count()
        tree.bind("<Double-1>", _toggle_enabled)

        # ---- 编辑区 ----
        ed = ttk.LabelFrame(right, text="编辑选中段", padding="6")
        ed.pack(fill=tk.X)

        self.start_var = tk.StringVar()
        self.end_var = tk.StringVar()
        self.type_var = tk.StringVar(value=aseg_type_label("mute"))
        self.p1_var = tk.StringVar()
        self.p2_var = tk.StringVar()
        self.soft_var = tk.StringVar(value="0")

        r = 0
        _lbltt16 = ttk.Label(ed, text="开始:")
        _lbltt16.grid(row=r, column=0, sticky="w", pady=3)
        e_s = ttk.Entry(ed, textvariable=self.start_var, width=12)
        e_s.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(_lbltt16, "开始时间，支持 12.5 或 00:00:12.500")

        r += 1
        _lbltt17 = ttk.Label(ed, text="结束:")
        _lbltt17.grid(row=r, column=0, sticky="w", pady=3)
        e_e = ttk.Entry(ed, textvariable=self.end_var, width=12)
        e_e.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(_lbltt17, "结束时间，必须大于开始时间")

        r += 1
        _lbltt18 = ttk.Label(ed, text="效果:")
        _lbltt18.grid(row=r, column=0, sticky="w", pady=3)
        # 下拉显示中文名，内部数据一律存 key（aseg_key_from_label / aseg_type_label 互转）
        cb = ttk.Combobox(ed, textvariable=self.type_var, state="readonly", width=11,
                          values=[spec["label"] for spec in AUDIO_SEGMENT_TYPES.values()])
        cb.grid(row=r, column=1, sticky="w", pady=3)
        self._type_combo = cb
        ToolTip(_lbltt18, "选择该时间段内要施加的音频效果，下方参数框会随效果类型自动切换。",
                wraplength=380)

        r += 1
        self._param_widgets = []
        for i in range(2):
            lbl = ttk.Label(ed, text="—:")
            lbl.grid(row=r + i, column=0, sticky="w", pady=3)
            var = tk.StringVar()
            ent = ttk.Entry(ed, textvariable=var, width=10)
            ent.grid(row=r + i, column=1, sticky="w", pady=3)
            self._param_widgets.append((lbl, ent, var))
        self.p1_var = self._param_widgets[0][2]
        self.p2_var = self._param_widgets[1][2]

        r += 2
        self.soft_label = ttk.Label(ed, text="柔化(ms):")
        self.soft_label.grid(row=r, column=0, sticky="w", pady=3)
        self.soft_entry = ttk.Entry(ed, textvariable=self.soft_var, width=10)
        self.soft_entry.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(self.soft_label,
                "静音/局部音量的边缘过渡时长（毫秒），0=硬切。\n"
                "30~50ms 可明显减轻静音起止点的爆音；段数较多时表达式会变长，建议不超过 20 段。")

        # 时间与数值框绑 <Return>/<FocusOut>，另挂 write trace 实时提交到 _last_sel：
        # 用户「输入完马上点下一段」时，FocusOut 与 TreeviewSelect 的先后不可靠，单靠失焦
        # 提交会把上一段输入写进新段；trace 在击键当下即落盘，消除“未提交残留”。
        # （trace 回调只读变量 → 写内存 → tree.item 单行刷新，绝不做 .set 回填，
        #   故不触发“同值写入回环 / set 推光标”铁律场景；_load_to_form 内由 _loading 短路。）
        for w in (e_s, e_e, self.soft_entry,
                  self._param_widgets[0][1], self._param_widgets[1][1]):
            w.bind("<Return>", self._apply_form_to_sel)
            w.bind("<FocusOut>", self._apply_form_to_sel)
        for _v in (self.start_var, self.end_var, self.soft_var,
                   self._param_widgets[0][2], self._param_widgets[1][2]):
            with suppress(Exception):
                _v.trace_add("write", self._apply_form_to_sel)
        cb.bind("<<ComboboxSelected>>", self._on_type_changed)

        # ---- 操作按钮 ----
        btns = ttk.Frame(right)
        btns.pack(fill=tk.X, pady=(8, 0))
        ttk.Button(btns, text="添加", width=8, command=self._add).grid(row=0, column=0, padx=2, pady=2)
        ttk.Button(btns, text="删除", width=8, command=self._delete).grid(row=0, column=1, padx=2, pady=2)
        ttk.Button(btns, text="上移", width=8, command=lambda: self._move(-1)).grid(row=1, column=0, padx=2, pady=2)
        ttk.Button(btns, text="下移", width=8, command=lambda: self._move(1)).grid(row=1, column=1, padx=2, pady=2)
        ttk.Button(btns, text="清空", width=8, command=self._clear).grid(row=2, column=0, padx=2, pady=2)
        _btn_import_time = ttk.Button(btns, text="导入时间", width=8, command=self._import_time)
        _btn_import_time.grid(row=2, column=1, padx=2, pady=2)
        # tooltip 绑在「导入时间」按钮本体上（不能绑 btns 整块，会盖住相邻控件悬停提示）
        ToolTip(_btn_import_time,
                "导入时间：从剪贴板读取多行 `-ss 开始 -to 结束`，一次性建成多段，\n"
                "效果类型取编辑区当前所选。格式与音频截取的「导入时间」一致。",
                wraplength=380)
        # 时间预览（2026-09-05）：6 个操作按钮下面第 7 个入口——打开即简易时间预览
        # 音频引擎（ffplay 直读+波形），「发送到列表」直达本对话框分段列表
        if self.file_source is not None:
            _btn_time_preview = ttk.Button(btns, text="时间预览", width=8,
                                           command=self._open_time_preview)
            _btn_time_preview.grid(row=3, column=0, columnspan=2, sticky="we",
                                   padx=2, pady=(4, 0))
            ToolTip(_btn_time_preview,
                    "打开简易时间预览（音频引擎形态）：ffplay 直读播放 + 内存波形 + 段落条打标。\n"
                    "听杂音/鼓点打标成段后点「发送到列表」，按编辑区当前效果类型追加到本分段列表。\n"
                    "时间=源文件时间线，启用截取/变速后由工具自动换算。\n"
                    "打开即音频形态：不显示画面、没有逐帧步进——音轨没有「帧」的概念，\n"
                    "定位靠波形 + 反复听（与 Shotcut 等剪辑软件一致，非本工具缺陷）。\n"
                    "要帧级定位：在预览窗口内点「画面模式」按钮切回帧浏览器。",
                    wraplength=380)

        self.count_label = ttk.Label(right, text="", foreground="#555555")
        self.count_label.pack(anchor="w", pady=(8, 0))

        # ---- 底部：确定 col0 / 取消 col1 ----
        bottom = ttk.Frame(win, padding=(10, 0, 10, 10))
        bottom.pack(fill=tk.X)
        btn_row = ttk.Frame(bottom)
        btn_row.pack()

        def _ok():
            self.result = [dict(s) for s in self.segments]
            win.destroy()

        ttk.Button(btn_row, text="确定", width=10, command=_ok).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_row, text="取消", width=10, command=win.destroy).pack(side=tk.LEFT, padx=5)

        self._fill_tree()
        if self.segments:
            self._select(0)
        else:
            self._load_to_form(None)

        try:
            center_window(win, 920, 470)
        except Exception:
            win.geometry("920x470")
            win.deiconify()
        win.transient(self.parent.winfo_toplevel())
        win.wait_window()
        return self.result


class AudioFrame(ttk.LabelFrame):
    def __init__(self, parent, enable_checkbox=False, refresh_cb=None,
                 app=None, file_source=None, **kwargs):
        super().__init__(parent, text="音频", padding="5", **kwargs)
        # app/file_source：时间预览入口上下文（显式参数，绝不进 **kwargs——ttk 不认识）
        self.app = app
        self.file_source = file_source
        self.enable_checkbox = enable_checkbox
        self.refresh_cb = refresh_cb    # 分段等延迟到弹窗确定才生效的设置 → 确定后回调刷新命令预览
        self.audio_segments = []
        self.create_widgets()

    def create_widgets(self):
        inner = ttk.Frame(self)
        inner.pack(fill=tk.X, expand=True)
    
        top_row = ttk.Frame(inner)
        top_row.pack(fill=tk.X, pady=(0,5))

        if self.enable_checkbox:
            self.audio_enabled = tk.BooleanVar(value=True)
            chk = ttk.Checkbutton(top_row, text="保留音频", variable=self.audio_enabled)
            chk.pack(side=tk.LEFT)

        self.only_audio = tk.BooleanVar(value=False)
