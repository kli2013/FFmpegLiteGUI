        btn = ttk.Button(preset_frame, text="🎨 可视化编辑坐标", command=open_visual)
        btn.pack(side=tk.LEFT, padx=5, pady=2)
        self._controls.append(btn)

        # 持续旋转（绕中心动态旋转）——仅子视频（水印/画中画）
