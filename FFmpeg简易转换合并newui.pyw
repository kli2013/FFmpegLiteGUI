        ttk.Label(row1, text="宽:").pack(side=tk.LEFT, padx=(10,0))
        self.w_var = tk.StringVar(value=self.filter_frame._blur_w.get())
        w_entry = ttk.Entry(row1, textvariable=self.w_var, width=6)
