}

def resolve_cn_font_path(font_name: str) -> str:
    """将字体名解析为系统字体文件完整路径（先查中文字体表，再查英文字体表），找不到返回空串。

    2026-09-04：英文表在 CN_FONT_MAP 未命中时兜底，故下拉里中/英文字体可混选，
    无需为此改动任何调用点（3437 / 3693 / 9186 / 9475 均走本函数）。"""
    fname = CN_FONT_MAP.get(font_name) or EN_FONT_MAP.get(font_name, "")
    if not fname:
        return ""
    fonts_dir = os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
    return os.path.join(fonts_dir, fname)

def resolve_ext_font_path(settings: dict) -> str:
    """取「用户显式指定的外部字体路径」，仅用于回填 UI 控件。

    ⚠️ 与 font_path 的语义区别（2026-09-04 修 bug）：
      - ext_font_path：用户手填或用「浏览」选的字体文件；空 = 没用外部字体。
      - font_path    ：滤镜侧消费的「最终结果」= ext_font_path or 系统字体解析结果。
    早期版本只存 font_path，且 _collect_tw_form 把「外部字体 or 系统字体解析结果」
    一并写进去，回填时又把 font_path 当成「用户外部字体」塞回编辑框 —— 于是
    「选一次下拉 → 确定 → 再打开」后，编辑框被系统字体路径填满且非空，
    导致后续所有下拉选择都被这个路径覆盖（外部字体优先级高于下拉）。

    本函数负责把两者分开：优先读新字段 ext_font_path；老数据则反推 ——
    若 font_path 恰等于 font_name 的解析结果，说明它是系统字体的解析结果，
    不是用户外部字体，返回空串。
    """
    v = (settings.get("ext_font_path") or "").strip()
    if v:
        return v
    fp = (settings.get("font_path") or "").strip()
    if not fp:
        return ""
    resolved = resolve_cn_font_path(settings.get("font_name", "")) or ""
    if not resolved:
        # font_name 不在内置表中，无法反推；此时 font_path 很可能就是用户外部字体
        return fp
    with suppress(Exception):
        if os.path.normcase(os.path.abspath(fp)) == os.path.normcase(os.path.abspath(resolved)):
            return ""      # 是系统字体的解析结果 → 不算外部字体
    return fp


# ==================== 系统字体扫描（2026-09-04）====================
# 「检测本地」按钮与启动时兜底扫描共用。直接枚举 C:\Windows\Fonts 目录并解析
# 字体文件内部的 name table 取显示名（简体中文名优先）。
# ⚠️ 绝不读注册表 HKLM\...\Fonts：用户会刻意改写其中的名称映射（例如把
# 「微软雅黑」指向 tahoma.ttf 以回避雅黑字体），注册表不是「系统有哪些字体」的事实。
_FONT_ZH_LANGS = (0x0804, 0x0404, 0x0C04, 0x1004, 0x1404, 0x7C04)
_FONT_EN_LANGS = (0x0409, 0x0000, 0x0C09, 0x0809, 0x1009, 0x1409, 0x1809, 0x1C09,
                  0x2009, 0x2409, 0x2809, 0x2C09, 0x3009, 0x3409)
_FONT_SFNT_TAGS = (b"\x00\x01\x00\x00", b"OTTO", b"true")
_FONT_EXTS = (".ttf", ".ttc", ".otf")


def _font_names_from_file(path: str) -> Optional[dict]:
    """解析单个字体文件的 name table，返回 {'zh_full','zh_fam','en_full','en_fam'}。

    采用精确 seek：先读 sfnt 头 + table 目录找到 name table 的偏移，再只读那一段，
    因此对 msyh.ttc(22MB) 这类大文件也只读几百字节（实测全量 151 个字体共 ~0.01s）。
    ⚠️ 不能按字节数截断整文件读取——CJK 字体的 name table 常位于文件后段，
    截断 1MB 会漏掉全部中文字体（2026-09-04 实测踩坑）。
    支持 TTF/OTF/TTC；TTC 只读第一个 face，与 ffmpeg drawtext 行为一致。
    解析失败返回 None。
    """
    try:
        with open(path, "rb") as fh:
            tag = fh.read(4)
            base = 0
            if tag == b"ttcf":
                fh.seek(8)
                n = struct.unpack(">I", fh.read(4))[0]
                if n < 1:
                    return None
                fh.seek(12)
                base = struct.unpack(">I", fh.read(4))[0]
                if base <= 0:
                    return None
            fh.seek(base)
            hdr = fh.read(12)
            if len(hdr) < 12 or hdr[:4] not in _FONT_SFNT_TAGS:
                return None
            num_tables = struct.unpack(">H", hdr[4:6])[0]
            if not 0 < num_tables <= 4096:
                return None
            tdir = fh.read(num_tables * 16)
            if len(tdir) < num_tables * 16:
                return None
            name_off = None
            for i in range(num_tables):
                rec = tdir[i * 16:i * 16 + 16]
                if rec[:4] == b"name":
                    name_off = struct.unpack(">I", rec[8:12])[0]
                    break
            if name_off is None:
                return None
            fh.seek(name_off)
            nb = fh.read(512 * 1024)   # name table 段，足够容纳全部语言记录
            if len(nb) < 6:
                return None
            fmt, count, str_off = struct.unpack(">HHH", nb[:6])
            if count == 0 or count > 2048:
                return None
            recs = []
            q = 6
            for _unused in range(count):
                if q + 12 > len(nb):
                    break
                recs.append(struct.unpack(">HHHHHH", nb[q:q + 12]))
                q += 12

            def pick(langs, nids):
                """严格匹配：语言必须命中（否则英文名会被误当中文名，2026-09-04 踩坑）。"""
                found = []
                for plat, enc, lang, nid, ln, off in recs:
                    if nid not in nids or lang not in langs:
                        continue
                    s = str_off + off
                    if s + ln > len(nb):
                        continue
                    raw = nb[s:s + ln]
                    if plat == 3 or (plat == 0 and enc in (4, 6)):
                        try:
                            txt = raw.decode("utf-16-be")
                        except Exception:
                            continue
                    elif plat == 1:
                        try:
                            txt = raw.decode("latin-1")
                        except Exception:
                            continue
                    else:
                        continue
                    txt = txt.strip("\x00").strip()
                    if txt:
                        found.append((nid, txt))
                if not found:
                    return None
                # nids 内部有序（full 在前），优先返回靠前的 nameID 命中项
                for nid in nids:
                    for n, t in found:
                        if n == nid:
                            return t
                return found[0][1]

            return {
                "zh_full": pick(_FONT_ZH_LANGS, (4,)),
                "zh_fam": pick(_FONT_ZH_LANGS, (1, 16)),
                "en_full": pick(_FONT_EN_LANGS, (4,)),
                "en_fam": pick(_FONT_EN_LANGS, (1, 16)),
            }
    except Exception:
        return None


def scan_system_fonts(fonts_dir: Optional[str] = None) -> list:
    """枚举系统字体目录内全部 TTF/TTC/OTF，解析显示名（中文优先）。

    返回按显示名排序的 [{'name','file','path'}, ...]；
    fonts_dir 默认 C:\\Windows\\Fonts。.fon 位图字体（drawtext 不支持）与
    .compositefont/.xml 等非字体文件被跳过。解析失败的文件用文件名主干兜底，
    保证不漏字体。同名只保留第一个。
    """
    fonts_dir = fonts_dir or os.path.join(
        os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
    try:
        entries = sorted(os.listdir(fonts_dir))
    except OSError:
        return []
    out, seen = [], set()
    for fn in entries:
        if os.path.splitext(fn)[1].lower() not in _FONT_EXTS:
            continue
        full = os.path.join(fonts_dir, fn)
        try:
            if not os.path.isfile(full):
                continue
        except OSError:
            continue
        r = _font_names_from_file(full)
        if r:
            name = (r.get("zh_full") or r.get("zh_fam")
                    or r.get("en_full") or r.get("en_fam")
                    or os.path.splitext(fn)[0])
        else:
            name = os.path.splitext(fn)[0]
        if name in seen:
            continue
        seen.add(name)
        out.append({"name": name, "file": fn, "path": full})
    out.sort(key=lambda x: x["name"].lower())
    return out


# ==================== 字体缓存 fonts_cache.json（2026-09-04）====================
# 与 ffmpeg_presets.json / quick_cmds.json 同级（get_script_dir()）。
# 结构：{version, scanned_at, fonts_dir_mtime, system_fonts:[{name,file,path}],
#        recent_external:[用户最近用过的外部字体路径, 最新在前, 至多 20 条]}
# 作用：① 免每次启动重扫 151 个字体文件；② 记住用户用过哪些外部字体，
#       在文字水印窗口的「外部字体」下拉里直接选，不用再每次浏览。
# 新鲜度判定：json 记录的 fonts_dir_mtime ≠ 当前 C:\Windows\Fonts 目录 mtime 即过期
# （任何字体的增删都会改目录 mtime，不必逐个文件比对）。
FONTS_CACHE_FILE = "fonts_cache.json"
FONTS_CACHE_MAX_RECENT = 20
_fonts_state = {"list": None, "dir_mtime": None, "recent": []}   # 模块级缓存


def _fonts_dir_path() -> str:
    return os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")


def _fonts_dir_mtime() -> float:
    try:
        return os.path.getmtime(_fonts_dir_path())
    except OSError:
        return 0.0


def _fonts_cache_path() -> str:
    return os.path.join(get_script_dir(), FONTS_CACHE_FILE)


def _fonts_save_state() -> None:
    """把 _fonts_state 落盘。写失败静默（缓存只是优化，不是关键数据）。"""
    with suppress(Exception):
        with open(_fonts_cache_path(), "w", encoding="utf-8") as f:
            json.dump({
                "version": 1,
                "scanned_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                "fonts_dir_mtime": _fonts_state.get("dir_mtime") or 0.0,
                "system_fonts": _fonts_state.get("list") or [],
                "recent_external": _fonts_state.get("recent") or [],
            }, f, ensure_ascii=False, indent=1)


def _fonts_load_state() -> bool:
    """从磁盘加载缓存到 _fonts_state。返回 True=加载成功且未过期（可直接用）。"""
    try:
        with open(_fonts_cache_path(), encoding="utf-8") as f:
            d = json.load(f)
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("version") != 1:
        return False
    cur_mtime = _fonts_dir_mtime()
    if not cur_mtime or abs((d.get("fonts_dir_mtime") or 0.0) - cur_mtime) > 1e-3:
        return False          # 目录已变 → 缓存过期
    lst = d.get("system_fonts") or []
    if not isinstance(lst, list) or not all(isinstance(x, dict) and x.get("path") for x in lst):
        return False
    rec = d.get("recent_external") or []
    _fonts_state["list"] = lst
    _fonts_state["dir_mtime"] = cur_mtime
    _fonts_state["recent"] = [p for p in rec if isinstance(p, str)] if isinstance(rec, list) else []
    return True


def ensure_fonts_cached() -> list:
    """返回系统字体列表 [{'name','file','path'},...]（模块级缓存）。

    磁盘缓存新鲜 → 直接用；缺失/过期 → 全量扫描并落盘。
    全量扫描实测 ~30ms，故启动可同步调用，无需后台线程。
    """
    if _fonts_state.get("list"):
        cur = _fonts_dir_mtime()
        if _fonts_state.get("dir_mtime") and abs(_fonts_state["dir_mtime"] - cur) < 1e-3:
            return _fonts_state["list"]
    if _fonts_load_state():
        return _fonts_state["list"]
    _fonts_state["list"] = scan_system_fonts(_fonts_dir_path())
    _fonts_state["dir_mtime"] = _fonts_dir_mtime()
    _fonts_save_state()
    return _fonts_state["list"]


def force_rescan_fonts() -> list:
    """「检测本地」按钮强制重扫（不信任任何缓存），返回新列表。"""
    _fonts_state["list"] = scan_system_fonts(_fonts_dir_path())
    _fonts_state["dir_mtime"] = _fonts_dir_mtime()
    _fonts_save_state()
    return _fonts_state["list"]


def get_recent_external_fonts() -> list:
    """用户最近用过的外部字体路径（最新在前，至多 FONTS_CACHE_MAX_RECENT 条）。"""
    ensure_fonts_cached()
    return list(_fonts_state.get("recent") or [])


def merged_font_names() -> list:
    """字体下拉的显示名列表：内置中/英文字体在前（快捷入口），随后接系统扫描字体，
    按显示名去重（内置优先）。不含 .fon（drawtext 不支持）。"""
    names = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
    seen = set(names)
    for f in ensure_fonts_cached():
        nm = (f.get("name") or "").strip()
        if nm and nm not in seen:
            seen.add(nm)
            names.append(nm)
    return names


def record_external_font(path: str) -> None:
    """记录一次「用户显式指定」的外部字体路径（on_ok 时调用）。

    只记录仍存在的文件（路径失效了留着没意义）；已存在则移到最前；
    超过上限裁尾后落盘。
    """
    p = (path or "").strip()
    if not p or not os.path.isfile(p):
        return
    rec = _fonts_state.get("recent") or []
    try:
        rec = [x for x in rec if x != p and os.path.isfile(x)]
    except OSError:
        rec = [x for x in rec if x != p]
    rec.insert(0, p)
    _fonts_state["recent"] = rec[:_GLOBAL_SETTINGS["fonts_recent_max"]]
    _fonts_save_state()


def escape_drawtext_text(text: str) -> str:
    """转义 drawtext 的 text 参数中的特殊字符（: \\ ' , %）。
    不使用单引号包裹，纯靠 \\ 转义，FFmpeg filtergraph 和 mpv 都能正确解析。"""
    text = text.replace("\\", "\\\\")
    text = text.replace(":", "\\:")
    text = text.replace("'", "\\'")
    text = text.replace(",", "\\,")
    text = text.replace("%", "\\%")
    return text

def escape_drawtext_path(path: str) -> str:
    """
    转义 fontfile 路径中的特殊字符。
    - 统一为正斜杠。
    - 将冒号转义
    """
    path = path.replace("\\", "/")
    path = path.replace(":", "\\\\:")   # 双反斜杠 + 冒号，经测试 ffplay 和 mpv 均有效
    return path

def _build_drawtext_enable(s: dict, trim_start=0.0, speed_factor=1.0):
    """
    根据文字水印的显示时段 / 循环设置构建 drawtext 的 enable 表达式。
    返回空字符串表示始终显示。
    2026-08-29：段时间=主视频原始时间 → 换算输出时间线（滤镜 t）：
    绝对时间点(start/end)减 trim 再除 speed；周期/时长(cycle/show)只除 speed。
    预览 settings 已禁用 trim → 不换算。
    """
    _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    start = _f(s.get("enable_start"))
    end = _f(s.get("enable_end"))
    cycle = _f(s.get("enable_cycle"))
    show = _f(s.get("enable_show"))
    if _ts != 0.0 or _sp != 1.0:
        # 绝对时间点：统一换算（减 trim、除 speed、clamp≥0）；周期/时长只除 speed
        if start is not None:
            start, _du = _timeline_convert(start, 0.0, _ts, _sp)
        if end is not None:
            end, _du = _timeline_convert(end, 0.0, _ts, _sp)
        if cycle is not None:
            cycle = cycle / _sp
        if show is not None:
            show = show / _sp
    if start is not None and end is not None and end > start:
        return f"between(t,{_ffsec(start)},{_ffsec(end)})"
    if cycle is not None and show is not None and cycle > 0 and show > 0:
        return f"lt(mod(t,{_ffsec(cycle)}),{_ffsec(show)})"
    if start is not None:
        return f"gte(t,{_ffsec(start)})"
    if end is not None:
        return f"lte(t,{_ffsec(end)})"
    return ""


def _build_enh_seg_enable(s, speed_factor=1.0):
    """主增强链统一时间段：用户填「输出时间线」秒数，换算到 speed(setpts) 之前的滤镜入口时间。

    为什么乘 speed_factor（而非像 _build_drawtext_enable 那样除）：
    增强块位于 setpts=1/factor*PTS 之前 → 出口(输出)t = 入口t / factor → 入口t = 输出t × factor。
    故把用户填的输出时间窗口常数全部乘 speed_factor，即得滤镜入口时间。
    trim 已在入口 t 起点归零（trim setpts=PTS-STARTPTS），输出时间线同样从 0 起 → 无需再减 trim。
    机制与 crop_pos/build_crop_pos_expr、_build_drawtext_enable 同套 trim/speed 换算，方向相反。

    返回空串 = 始终生效（未启用时间段 / 未填任何时间）。
    循环模式（enh_seg_loop 真）用 lt(mod(t,周期),单次) 表达「每隔周期生效单次秒」。
    """
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _f = _opt_float
    start = _f(s.get("enh_seg_start"))
    end = _f(s.get("enh_seg_end"))
    cycle = _f(s.get("enh_seg_cycle"))
    show = _f(s.get("enh_seg_once"))
    if _sp != 1.0:
        # 输出时间 → 入口时间：常数乘 speed_factor
        if start is not None:
            start *= _sp
        if end is not None:
            end *= _sp
        if cycle is not None:
            cycle *= _sp
        if show is not None:
            show *= _sp
    if s.get("enh_seg_loop") and cycle is not None and show is not None and cycle > 0 and show > 0:
        return f"lt(mod(t,{_ffsec(cycle)}),{_ffsec(show)})"
    if start is not None and end is not None and end > start:
        return f"between(t,{_ffsec(start)},{_ffsec(end)})"
    if start is not None:
        return f"gte(t,{_ffsec(start)})"
    if end is not None:
        return f"lte(t,{_ffsec(end)})"
    return ""

def enh_seg_probe_time(s, t, speed_factor=1.0):
    """判定「预览取帧时刻 t」是否落在增强时间段的生效窗口内 —— 供预览面板提示用。

    时间口径（别搞混，否则提示会指错地方）：
    - 用户填的起始/结束/周期/单次是**输出时间线**秒数（见 _build_enh_seg_enable）；
    - 预览命令走输入级 -ss 直 seek 源素材、且 include_trim/include_speed 全关 →
      此刻 t 就是**滤镜入口时间**，同时也是屏幕上那一帧的画面时间。
    故这里照搬 _build_enh_seg_enable 的换算（× speed_factor）把窗口搬到入口轴上再比。

    返回 (covered, suggest)：
      covered —— t 是否落在生效窗口内；未启用 / 未填任何时间 = True（始终生效）
      suggest —— 落在窗口内则为 None；否则给一个「建议取帧秒数」（已站在同一条入口
                 时间轴上，可直接填进预览的「取帧(秒)」框）；算不出建议则为 None

    存在理由：默认取帧 3s，而时间段往往是 1~2s 之类的早段 —— 用户看到预览毫无变化
    会误判「设置没生效」，其实只是取帧点在窗口外（2026-10-03 用户反馈）。
    """
    if not s or not s.get("enh_seg_enabled", False):
        return True, None
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    def _mv(v):
        _n = _opt_float(v)
        return None if _n is None else _n * _sp
    start, end = _mv(s.get("enh_seg_start")), _mv(s.get("enh_seg_end"))
    cycle, show = _mv(s.get("enh_seg_cycle")), _mv(s.get("enh_seg_once"))
    if s.get("enh_seg_loop") and cycle and show and cycle > 0 and show > 0:
        # 每隔 cycle 秒生效 show 秒 → 任一个周期的中点都行，取第一个
        if (t % cycle) < show:
            return True, None
        return False, show / 2.0
    if start is not None and end is not None and end > start:
        if start <= t <= end:
            return True, None
        return False, (start + end) / 2.0
    if start is not None:
        if t >= start:
            return True, None
        return False, start + 1.0        # 只填了起点：给起点后 1 秒
    if end is not None:
        if t <= end:
            return True, None
        return False, max(0.0, end / 2.0)  # 只填了终点：给终点前半程
    return True, None


def _tw_multiline_on(tw_settings) -> bool:
    """文字水印「多行（竖排）」开关：tw['multiline'] 真值判定（容忍 JSON 里的字符串形式）。"""
    v = (tw_settings or {}).get("multiline", False)
    if isinstance(v, str):
        return v.strip().lower() in ("1", "true", "yes", "on")
    return bool(v)


def _tw_effective_text(tw_settings) -> str:
    """文字水印「有效渲染文本」——编辑器矩形估算与 drawtext 共用的唯一真相源。

    - `multiline` 开：保留换行（富文本 / @字体式竖排，drawtext 逐行渲染）。
      真实 0x0A 在 ffmpeg n9 / n71 / 4.3 三版本 drawtext 均渲染多行
      （研究档案 research/vertical-countdown 结论 1）；且**不加引号**的写法同样成立
      （tests/_verify_tw_multiline.py 实测 bands=3）→ 转义链与 mpv 路径无需改动。
    - `multiline` 关：沿用旧行为，多行拼成一行（空格分隔）。

    2026-09-25：编辑器 wm_w/wm_h 与渲染端 crop 盒都取自本函数，二者必须同源，
    否则「编辑器按多行画高框、渲染却压成单行」→ 用户报「设置与显示不符 / 文字没当富文本」。
    """
    raw = str((tw_settings or {}).get("text", "") or "")
    raw = raw.replace("\r\n", "\n").replace("\r", "\n")
    if _tw_multiline_on(tw_settings):
        return raw.strip("\n")
    return " ".join(countdown_lines(raw))


def _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor, tag, wpr=None):
    """文字水印列表轨迹 x/y 的 sendcmd 接入（共用 helper，2026-10-01）。

    两处消费（改一处必查另一处）：build_drawtext_filter（-vf 链/twm/twc）与
    build_text_watermark_filtergraph 非旋转分支（filter_complex 链——封装页多轨
    merge 即此路；此前该分支自拼 drawtext 漏接 sendcmd，用户实测发现）。

    行数 > sendcmd 行数阈值 → x/y 改命令文件驱动（target=drawtext@{tag}），
    返回 (首命令值x, 首命令值y, "sendcmd=f='…',", "drawtext@{tag}", wpr)；
    未超阈/写文件失败 → (表达式x, 表达式y, "", "drawtext", wpr)（逐字节旧行为）。
    wpr（build_waypoint_expr 5 元组）可由调用方传入复用避免重算；
    zoom/alpha/自旋转仍走表达式。返回 None = wpr 无效（调用方维持原回退行为）。

    ⚠️ 命令形态随 ffmpeg 版本切换（2026-10-04 改，见 research/ffmpeg-95-seg-limit §21）：
      >= 7     → "xy"：`x '值', y '值'` 命令（7.1 / 9 实测生效）
      < 7（4.3）→ "reinit"：`reinit x=值:y=值` 命令（4.3 实测生效；x/y 会被**静默丢弃**）
      探测失败  → None：回退表达式路（4.3 上 flat 无 97 段墙，安全）
    即 **4.3 现在也能用 sendcmd 驱动文字水印轨迹**，不再一律回退。
    """
    _style = _ffmpeg_xy_cmd_style()
    if _style is None:      # 版本未探测/探测失败 → 不支持，回退表达式路（不静默失效）
        return None
    if wpr is None:
        wpr = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                  trim_start=trim_start, speed_factor=speed_factor)
    if wpr is None or wpr[0] is None:
        return None
    x_expr, y_expr = wpr[0], wpr[1]
    _sc_pre, _dt_name = "", "drawtext"
    _tw_wps = [w for w in (tw_settings.get("move_waypoints") or []) if isinstance(w, dict)]
    if len(_tw_wps) > _wp_sc_rows_limit():
        _tw_iv = build_waypoint_position_intervals(
            tw_settings.get("move_waypoints"), trim_start=trim_start, speed_factor=speed_factor)
        if _tw_iv:
            _tw_sc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                _tw_iv, tag, target=f"drawtext@{tag}", cmd_style=_style)
            if _tw_sc is not None:
                _sc_pre = f"sendcmd=f='{_tw_sc}',"
                _dt_name = f"drawtext@{tag}"
                x_expr = f"{_tw_iv[0][3]:g}"
                y_expr = f"{_tw_iv[0][4]:g}"
    return x_expr, y_expr, _sc_pre, _dt_name, wpr


def build_drawtext_filter(tw_settings: dict, trim_start=0.0, speed_factor=1.0, tag="tw"):
    """
    根据文字水印设置构建 drawtext 滤镜字符串。
    返回空字符串表示无需添加。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    2026-10-01：列表航点行数 > sendcmd 行数阈值时，x/y 改用 sendcmd 命令文件驱动
    （机制探针实测：drawtext x/y 支持 t 变量、别名定向、首命令值占位全可行）；
    返回串变为 `sendcmd=…,drawtext@{tag}=…`（调用方按逗号链内联，语义不变）。
    tag 供别名去重（多文字水印循环调用方传序号）。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    # 有效文本（2026-09-25 统一）：multiline 开 → 保留换行（竖排）；关 → 拼成一行。
    # 旧注释「必须拼成一行」已作废：真实换行在 n9/n71/4.3 三版本均能渲染，且不加引号
    # 也成立（tests/_verify_tw_multiline.py），故不再强制压平。
    text = _tw_effective_text(tw_settings)
    if not text:
        return ""
    font_name = tw_settings.get("font_name", "微软雅黑")
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    font_size = _opt_int(tw_settings.get("font_size", 48), 48)
    color = tw_settings.get("font_color", "#FFFFFF")
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    x_expr = tw_settings.get("overlay_x", "10").strip() or "10"
    y_expr = tw_settings.get("overlay_y", "10").strip() or "10"
    # 动态轨迹（与图片/视频水印同套逻辑；文字尺寸用 tw/th，主画布用 main_w/main_h）
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    _wpr = None
    _sc_pre = ""       # sendcmd 前缀（列表航点行数 > 阈值时非空）
    _dt_name = "drawtext"
    if _mv == "waypoints":
        # 列表轨迹：画布绝对像素（数字），drawtext x/y 表达式含 t 每帧求值；
        # 行数 > 阈值 → sendcmd 命令文件驱动（共用 helper，见函数 docstring）
        _r = _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor, tag or "tw")
        if _r is not None:
            x_expr, y_expr, _sc_pre, _dt_name, _wpr = _r
    elif _mv:
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
        if _mx is not None:
            # drawtext 表达式环境不提供 W/H 别名，用 main_w/main_h 表示主画布
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    border_w = _opt_int(tw_settings.get("border_w", 0), 0)
    border_color = tw_settings.get("border_color", "#000000")

    fc = color.lstrip("#")
    fontcolor = f"0x{fc}@{opacity:.2f}"

    parts = [
        f"fontfile={escape_drawtext_path(font_path)}",
        f"text={escape_drawtext_text(text)}",
        f"fontsize={font_size}",
        f"fontcolor={fontcolor}",
        f"x='{x_expr.replace(chr(39), chr(92)+chr(39))}'",
        f"y='{y_expr.replace(chr(39), chr(92)+chr(39))}'",
    ]
    if border_w > 0:
        bc = border_color.lstrip("#")
        parts.append(f"borderw={border_w}")
        parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
    # 显示时段 / 循环控制 (enable 表达式)
    enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                         speed_factor=speed_factor)
    if enable_expr:
        parts.append(f"enable='{enable_expr}'")
    # 列表轨迹透明度（oa→ob 段内线性插值）：与 fontcolor@opacity 相乘（drawtext alpha × 颜色透明度）
    if _wpr is not None and _wpr[4] is not None:
        parts.append(f"alpha='{_wpr[4].replace(chr(39), chr(92) + chr(39))}'")
    return _sc_pre + _dt_name + "=" + ":".join(parts)


def build_drawtext_chain_vf(tw_settings, tw_items=None, trim_start=0.0, speed_factor=1.0) -> str:
    """构建 -vf 可用的多条 drawtext 逗号串（仅非旋转项）。

    2026-08-26：普通预览（ffplay/SimplePreviewer 的 -vf 链）此前只渲染第一条文字水印。
    多条 drawtext 在 -vf 里可以用逗号链式串联（ffmpeg 支持），旋转/spin 项需要
    filter_complex 子图（color 源 + rotate + overlay），-vf 无法表达 → 跳过（完整合成
    与 mpv 实时预览仍走 build_text_watermark_chain，旋转项不受影响）。
    2026-08-29：trim_start/speed_factor 透传给 build_drawtext_filter（显示时段/轨迹时间
    =主视频原始时间，生成时换算输出时间线）。"""
    if tw_items is None:
        tw_items = [tw_settings]
    elif isinstance(tw_items, list) and not tw_items:
        tw_items = [tw_settings]
    parts = []
    for _tw_i, it in enumerate(tw_items):
        if not it.get("enabled", True):
            continue
        if not str(it.get("text", "") or "").strip():
            continue
        if text_watermark_needs_subgraph(it):
            continue  # 旋转/spin 无法进 -vf → 跳过
        d = build_drawtext_filter(it, trim_start=trim_start, speed_factor=speed_factor,
                                  tag=f"tw{_tw_i}")
        if d:
            parts.append(d)
    return ",".join(parts)


def estimate_text_size(text: str, font_path: str, font_size: int) -> Tuple[int, int]:
    """
    估算文字水印的像素宽高 (tw, th)，用于旋转时裁剪出贴合文字的透明层。
    纯 Python 标准库实现（不依赖 PIL）：
    - 全角区（CJK 等，U+2E80 起）按 1.0 × font_size 计宽；
    - ASCII 可打印按 0.6 × font_size 计宽（略偏大，宁可裁大不裁字）；
    - 其余半角扩展（拉丁扩展/希腊/西里尔等）按 0.9 × font_size 计宽；
    - 行高 = font_size × 1.2；多行取最大行宽。
    估算偏保守（偏大），旋转时 crop 包围盒还含 ±8px 内边距，实际不会裁到字。
    """
    fs = _opt_int(font_size, 48)
    if fs <= 0:
        fs = 48
    lines = (text or "").split("\n")
    th = int(fs * 1.2) * max(1, len(lines))
    tw = 0
    for line in lines:
        w = 0.0
        for ch in (line or " "):
            o = ord(ch)
            if o >= 0x2E80:          # CJK 及全角区（含中文/日韩/注音等）
                w += fs * 1.0
            elif o <= 0x7E:          # ASCII 可打印（含空格）
                w += fs * 0.6
            else:                    # 其余半角扩展字符
                w += fs * 0.9
        if int(w) > tw:
            tw = int(w)
    return max(tw, fs), th


def build_preview_border_frag(eh) -> str:
    """末端边框 → pad 滤镜片段（预览路径共用，iw/ih 表达式，无需知道绝对尺寸）。
    返回 'pad=trunc((iw+L+R+1)/2)*2:trunc((ih+T+B+1)/2)*2:L:T:color=C' 或 ''（未启用/全 0 边距）。
    与正式命令 _apply_end_handling_cmd 的 pad 注入同构（#RRGGBB→0xRRGGBB、颜色名透传、trunc 偶数化）。
    播放预览（-vf/lavfi-complex）、快照（filter_complex）、封装实时预览（lavfi-complex）三处共用。"""
    if not eh:
        return ""
    if not eh.get("border_enabled", False):
        return ""
    try:
        t = max(0, int(eh.get("border_top", 0) or 0))
        b = max(0, int(eh.get("border_bottom", 0) or 0))
        l = max(0, int(eh.get("border_left", 0) or 0))
        r = max(0, int(eh.get("border_right", 0) or 0))
    except (ValueError, TypeError):
        return ""
    if t + b + l + r <= 0:
        return ""
    _bc = (eh.get("border_color", "") or "").strip()
    if re.fullmatch(r"#[0-9a-fA-F]{6}", _bc):
        _pad_c = "0x" + _bc[1:].upper()
    else:
        _pad_c = _bc if _bc else "black"
    return (f"pad=trunc((iw+{l}+{r}+1)/2)*2:trunc((ih+{t}+{b}+1)/2)*2:"
            f"{l}:{t}:color={_pad_c}")


def build_end_split_filters(rows: int, cols: int, in_label: str = "[v_in]", out_label: str = "[v_out]") -> str:
    """
    末端多画面拼接滤镜：把输入视频流 split 成 rows×cols 份拼接成网格。
    返回 filter_complex 片段字符串（以 in_label 开头、out_label 结尾），总格数 = rows*cols（限制 2-5）。

    - 行=1（列>1）→ 横排：split=N + hstack=inputs=N
    - 列=1（行>1）→ 竖排：split=N + vstack=inputs=N
    - 行>1 且列>1 → 网格：每行先 hstack，再把各行 vstack
      例 2×2：split=4[v1][v2][v3][v4];[v1][v2]hstack=inputs=2[top];[v3][v4]hstack=inputs=2[bottom];[top][bottom]vstack=inputs=2[vo]
    """
    rows = max(1, int(rows or 1))
    cols = max(1, int(cols or 1))
    n = rows * cols
    if n < 2 or n > 5:
        n = max(2, min(5, n))
        # 重新折算：若行=1 保持 n 列；列=1 保持 n 行；否则 2×2
        if rows == 1:
            cols = n
        elif cols == 1:
            rows = n
        else:
            rows, cols = 2, 2
            n = 4
    # 标签用独特前缀（sp/sr）避免与调用方既有 filtergraph 标签冲突
    labels = [f"[sp{i}]" for i in range(n)]
    parts = [f"{in_label}split={n}{''.join(labels)}"]
    if rows == 1:
        # 横排
        parts.append(f"{''.join(labels)}hstack=inputs={n}{out_label}")
    elif cols == 1:
        # 竖排
        parts.append(f"{''.join(labels)}vstack=inputs={n}{out_label}")
    else:
        # 网格：每行 hstack 再整体 vstack
        row_labels = []
        for r in range(rows):
            row_lbl = f"[sr{r}]"
            row_in = "".join(labels[r * cols:(r + 1) * cols])
            parts.append(f"{row_in}hstack=inputs={cols}{row_lbl}")
            row_labels.append(row_lbl)
        parts.append(f"{''.join(row_labels)}vstack=inputs={rows}{out_label}")
    return ";".join(parts)


def build_end_concat_filters(tail_path: str, tail_sec: float,
                             in_label: str = "[v_in]", tail_label: str = "[tail]",
                             out_label: str = "[v_out]",
                             main_w: int = 1280, main_h: int = 720, fps: float = 30.0,
                             main_dur: float = 0.0) -> str:
    """
    末端 concat 图片/视频滤镜：把一段图片（显示 tail_sec 秒）或视频接到主视频末尾。

    - 图片：输入是 `-loop 1 -framerate {fps} -t {tail_sec} -i {tail_path}`（有限时长流），
      滤镜：scale 保持比例适配 main_w×main_h（不足则 pad 黑底居中）+ fps 对齐 + format + setpts 归零。
    - 视频：输入是 `-i {tail_path}`，同样 scale/pad 适配输出尺寸后 concat。

    tail_label：尾部素材在 filter_complex 中的输入标签（调用方指定，如 [1:v]）。
    main_dur > 0 时：在 concat 前给主链强制 trim=0:{main_dur} 收尾——
      解决画中画 overlay 默认 eof_action=repeat 导致主视频结束后定格、子视频无限循环、
      concat 永远等不到主链结束的问题（主链必须显式结束才能切换到尾部素材）。
    返回 filter_complex 片段（以 tail 链开头、out_label 结尾）：
      [tail_label]scale=...pad=...[v_tail];[in_label]trim=0:D,setpts=PTS-STARTPTS[v_main_trim];[v_main_trim][v_tail]concat=n=2:v=1:a=0[out]
    注意：调用方负责在命令里为 tail 流添加额外输入（-loop 1 ... -i 或 -i）。
    """
    if not tail_path or not os.path.exists(tail_path):
        return ""
    # 图片/视频统一走 scale 保持比例 + pad 黑底居中（图片小或用户 scale 后仍小于输出尺寸时自动黑边居中）
    tail_chain = (
        f"{tail_label}scale={main_w}:{main_h}:force_original_aspect_ratio=decrease,"
        f"pad={main_w}:{main_h}:(ow-iw)/2:(oh-ih)/2:black,"
        f"setsar=1,fps={fps:.6f}".rstrip('0').rstrip('.') + ","
        f"format=yuv420p,setpts=PTS-STARTPTS[v_tail]"
    )
    # 主链强制收尾：overlay 默认 eof_action=repeat（主视频结束后定格最后一帧、子视频继续循环），
    # 不加 trim 时主链永不结束，concat 永远不切换到尾部素材（只能靠 -t 截断 = 定格+子视频循环）。
    if main_dur and main_dur > 0:
        main_trim = f"{in_label}trim=0:{_ffsec(main_dur)},setpts=PTS-STARTPTS[v_main_trim];"
        concat_in = "[v_main_trim]"
    else:
        main_trim = ""
        concat_in = in_label
    # concat 只拼视频（v=1:a=0），音频保持主视频原样；尾部图片段无音频（静音），
    # 视频段自带音频会被 concat 丢弃（与"只拼视频"语义一致）。
    return f"{tail_chain};{main_trim}{concat_in}[v_tail]concat=n=2:v=1:a=0{out_label}"


def build_text_watermark_filtergraph(tw_settings: dict, main_label: str = "", out_label: str = "[v_tw]",
                                     trim_start=0.0, speed_factor=1.0, tag: str = ""):
    """
    构建文字水印的 filter_complex 片段（或单节点 drawtext）。

    - 未启用/无效 → 返回 ""
    - 启用倒计时(countdown_enabled) → 返回「画布 + 滚动 crop 窗口 + overlay」子图
      （2026-09-19 新增；倒计时独占，同时间里的旋转/spin/轨迹不再叠加）
    - 未启用旋转与持续旋转 → 返回 f"{main_label}drawtext=...{out_label}"
      （等价于原 build_drawtext_filter 直接作用于主视频；main_label 为空则用隐式输入）
    - 启用旋转（rotate≠0）或持续旋转（spin_enabled）→ 返回「透明层(color来自主视频alpha清零)
      + drawtext(居中) + rotate(静态角度，可选) + rotate(持续旋转 angle=转速*PI/180*t，可选) + overlay」
      的子图，主视频输入用 main_label（为空则隐式输入，适用预览 lavfi/-filter_complex），
      以 out_label 结尾。调用方负责把该片段接入总 filter_complex（用 ; 分隔，并把 out_label 作为后续视频标签）。

    设计要点：FFmpeg drawtext 原生不支持旋转，故旋转时把文字画到一块透明层上、
    用 rotate 绕文字自身中心旋转、再 overlay 回主视频（与图片/视频水印 rotate 思路一致）。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    # 有效文本（2026-09-25 统一）：multiline 开 → 保留换行（富文本 / @字体式竖排，
    # drawtext 逐行渲染）；关 → 拼成一行（历史行为，旧工程兼容）。
    text = _tw_effective_text(tw_settings)
    if not text:
        return ""
    # 倒计时（滚动小窗）：独占表现形式，优先于旋转/spin/轨迹返回自己的子图。
    # 参数算不出来（无字体等）时由它内部退回普通 drawtext，保证 chain 标签不断链。
    if tw_settings.get("countdown_enabled"):
        _cd = build_tw_countdown_subgraph(tw_settings, main_label=main_label, out_label=out_label,
                                          trim_start=trim_start, speed_factor=speed_factor, tag=tag)
        if _cd:
            return _cd
    font_name = tw_settings.get("font_name", "微软雅黑")
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    font_size = _opt_int(tw_settings.get("font_size", 48), 48)
    color = tw_settings.get("font_color", "#FFFFFF")
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    x_expr = (tw_settings.get("overlay_x", "10") or "10").strip() or "10"
    y_expr = (tw_settings.get("overlay_y", "10") or "10").strip() or "10"

    def _dt_parts(xv, yv, alpha_expr=None):
        parts = [
            f"fontfile={escape_drawtext_path(font_path)}",
            f"text={escape_drawtext_text(text)}",
            f"fontsize={font_size}",
            f"fontcolor=0x{color.lstrip('#')}@{opacity:.2f}",
            f"x='{xv.replace(chr(39), chr(92) + chr(39))}'",
            f"y='{yv.replace(chr(39), chr(92) + chr(39))}'",
        ]
        bw = _opt_int(tw_settings.get("border_w", 0), 0)
        if bw > 0:
            bc = (tw_settings.get("border_color", "#000000") or "#000000").lstrip("#")
            parts.append(f"borderw={bw}")
            parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
        enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                             speed_factor=speed_factor)
        if enable_expr:
            parts.append(f"enable='{enable_expr}'")
        # 列表轨迹透明度（oa→ob 段内线性插值）：与 fontcolor@opacity 相乘（drawtext alpha × 颜色透明度）
        if alpha_expr is not None:
            parts.append(f"alpha='{alpha_expr.replace(chr(39), chr(92) + chr(39))}'")
        return ":".join(parts)

    rotate = tw_settings.get("rotate", 0)
    rotate = _opt_float(rotate, 0.0)

    # 持续旋转（spin）：绕中心匀速转（angle=转速*PI/180*t），与图片/视频水印同款；
    # 静态旋转（rotate）与 spin 可叠加：先静态转，再持续转。
    spin_on = bool(tw_settings.get("spin_enabled", False))
    sp = tw_settings.get("spin_speed", 60.0)
    sp = _opt_float(sp, 60.0)
    # 列表轨迹（waypoints）：x/y + 分段自旋转 + 到期行为统一由 build_waypoint_expr 生成；
    # 列表存在自旋转段 → needs_rot=True（走旋转子图），且列表自旋转覆盖全局 spin。
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    _wp_res_tw = None
    _wp_rot_tw = False
    # 列表轨迹透明度（oa→ob）：默认 None（仅 waypoints 模式赋值）；非 waypoints 时
    # 必须在外层先初始化，否则下方非旋转分支 _dt_parts(..., _tw_alpha_expr_tw) 会触发
    # UnboundLocalError（画中画模式简单单条水印即命中，导致整条命令崩掉、不出命令）。
    _tw_alpha_expr_tw = None
    if _mv == "waypoints":
        _wp_res_tw = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                         spin_speed=sp,
                                         trim_start=trim_start, speed_factor=speed_factor)
        _wp_rot_tw = (_wp_res_tw is not None and _wp_res_tw[2] is not None)
        # 列表轨迹透明度（oa→ob）：与静态 opacity 相乘（drawtext alpha × fontcolor@opacity）
        _tw_alpha_expr_tw = (_wp_res_tw[4] if (_wp_res_tw is not None and _wp_res_tw[4] is not None) else None)
    needs_rot = rotate != 0 or (spin_on and sp != 0) or _wp_rot_tw

    # 动态轨迹（move）：旋转时子层尺寸用裁剪后的文字包围盒（含 padding）做钳制；
    # 非旋转时沿用 drawtext 的 tw/th 变量（与原 build_drawtext_filter 行为一致）。
    if not needs_rot:
        if _mv == "waypoints":
            if _wp_res_tw is not None and _wp_res_tw[0] is not None:
                # sendcmd 接入（> 阈值）：与 build_drawtext_filter 共用 helper——
                # 此前该分支自拼 drawtext 漏接 sendcmd（封装页多轨 merge 即此路，
                # 2026-10-01 用户实测 20 行轨迹未切 sendcmd 发现）
                _r = _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor,
                                             tag or "tw", wpr=_wp_res_tw)
                if _r is not None:
                    dt = _r[2] + _r[3] + "=" + _dt_parts(_r[0], _r[1], _tw_alpha_expr_tw)
                    return f"{main_label}{dt}{out_label}" if main_label else f"{dt}{out_label}"
                x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
        elif _mv:
            _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
            if _mx is not None:
                x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
                y_expr = _my.replace("W", "main_w").replace("H", "main_h")
        dt = "drawtext=" + _dt_parts(x_expr, y_expr, _tw_alpha_expr_tw)
        return f"{main_label}{dt}{out_label}" if main_label else f"{dt}{out_label}"

    # ---- 旋转：透明层 + drawtext(居中) + rotate(静态/spin) + overlay ----
    tw, th = estimate_text_size(text, font_path, font_size)
    pad = 8
    tw2 = tw + 2 * pad
    th2 = th + 2 * pad
    # 实际挂了几道 rotate（静态角 与 自旋转/列表自旋转 各算一道）→ 包装盒按 √2 逐级放大。
    # ⚠️ 必须按实际道数求：两道时盒子是 hypot(hypot(w,h),hypot(w,h))，不是 hypot(w,h)。
    # 先算在这里，供下方 _clamp（运动钳制上界）与 _content_box_shift（中心对齐）共用。
    _n_rot_stages = (1 if rotate != 0 else 0) + \
                    (1 if (_wp_rot_tw or (spin_on and sp != 0)) else 0)
    # 持续旋转时 overlay 画布 = 对角线正方形（rotate ow/oh=hypot），钳制用该边长；
    # 仅静态旋转时钳制用 crop 包围盒尺寸（有意：静态旋转越界属用户预期，按内容盒定位）。
    # ⚠️ 2026-09-17：持续旋转分支必须按**实际道数**求盒，不能一律按一道 hypot——
    # 两道时实际占位 707（实测 400x300）却按 500 钳制 → 允许 x 走到 W-505，右边缘落到
    # W+202，水印真跑出画面，与 build_move_xy_expr「钳制到画面内」的意图相悖。
    # stages=0/1 时取值与旧逻辑逐值相同，仅「静态角+自旋转」这一组合有变。
    if (spin_on and sp != 0) or _wp_rot_tw:
        _clamp = int(rotate_box_size(tw2, th2, _n_rot_stages)[0])
    else:
        _clamp = tw2
    if _mv == "waypoints":
        if _wp_res_tw is not None and _wp_res_tw[0] is not None:
            x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
    elif _mv:
        # 用裁剪后的包围盒尺寸（字面量）做钳制，避免旋转后越界
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw=str(_clamp), sh=str(_clamp))
        if _mx is not None:
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    ml = main_label if main_label else ""
    # 透明层用独立 color 源（按 crop 尺寸 tw2×th2），不再 fork ml。
    # ⚠️ 关键：原先用 {ml}format=rgba,colorchannelmixer=aa=0[tw_bg] 时，ml（带图片水印的画布）被
    # format=rgba 强制全局转 rgba，最终 overlay 把图片水印内容弄丢。
    # 改用独立 color 源后，ml 只在最终 overlay 作为背景出现，画布内容完整保留。
    base_node = f"color=c=black@0:s={tw2}x{th2}:d=999999"
    dt_core = "drawtext=" + _dt_parts(str(pad), str(pad))
    crop_node = f"crop={tw2}:{th2}:0:0"
    rot_parts = []
    _cur = "[tw_crop]"
    if rotate != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{rotate}*PI/180':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_r1]")
        _cur = "[tw_r1]"
    if _wp_rot_tw:
        # 列表自旋转覆盖全局 spin（仅列表标记的自旋转时段旋转，边移边转）
        rot_parts.append(
            f"{_cur}rotate=angle='({_wp_res_tw[2]})':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    elif spin_on and sp != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{sp}*PI/180*t':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    # 中心对齐（2026-09-03 问题①修复）：rotate 输出 d×d（hypot）正方形画布，
    # 而 overlay_x/y 语义=内容盒（tw2×th2，含 pad）左上角（2026-08-26 铁律）→
    # 叠加盒左上角 = 内容盒左上角 − (d−tw2)/2、(d−th2)/2。缺失该减量时整块被向右下
    # 推移 (d−tw2)/2、(d−th2)/2，自旋转中心比预期低很多（与子视频 _content_box_shift
    # 中心对齐、图片水印 L18879 同源）。静态 rotate/spin/列表自旋转共用此 overlay。
    # ⚠️ 2026-09-17 修正：这里可能是**两道** rotate（静态角 + 自旋转/列表自旋转）→
    # 盒子按 √2 逐级放大，必须按实际道数求（见 rotate_box_size），否则少补 ~103px。
    _box_w, _box_h = rotate_box_size(tw2, th2, _n_rot_stages)
    _ov_dx, _ov_dy = _content_box_shift(tw2, th2, _box_w, _box_h)
    ov_node = f"overlay=x='({x_expr}) - {_ov_dx:.6g}':y='({y_expr}) - {_ov_dy:.6g}':format=auto"
    frag = ";".join([
        f"{base_node}[tw_bg]",
        f"[tw_bg]{dt_core}[tw_full]",
        f"[tw_full]{crop_node}[tw_crop]",
    ] + rot_parts + [f"{ml}{_cur}{ov_node}{out_label}"])
    return frag


# ================== 文字水印：倒计时（滚动小窗） ==================
# 「倒计时」只是形容词，不是真的计时。做法是——
#   ① 把富文本里的多行文字按行/列排到一块透明画布上（每行一个 drawtext，各自居中）；
#   ② 在画布上开一个自由矩形「显示窗口」(crop)，窗口按「每 N 秒移动 M 像素」沿某方向滑动；
#   ③ 把这个小窗 overlay 到主视频的 X/Y 位置。
# 视觉上就是倒计时翻牌 / 滚轮；文字可以是任何内容，不要求非得是数字。
# 四个方向只换坐标轴与正负号，其余参数（步长/间隔/窗口/字号/颜色）完全共用。
# ⚠️ 2026-09-19：filter 内的定位一律用「显式逐行像素」，不要用 text_h/line_spacing 做
#    多行居中——研究实测 text_h 在 n9 与 4.3 上口径不一致（一个顶出画布、一个偏下）。
#    另外 4.3 的 overlay 在「次输入远大于主输入 + 负 y 滚动」时取景错乱，故窗口必须用
#    crop 实现（crop 的 x/y 本身就是每帧求值表达式），不要用「大画布 + overlay 负偏移」。
# 研究档案（含三版本实测证据）：research/vertical-countdown/README.md

# ⚠️ 内部比较键 → 恒为英文 token（与 multi 同形态）；显示名只经 countdown_direction_display() 出。
#    绝不拿中文做比较键（模块级调 _() 会冻在导入时中文 ⇒ 英文界面反查恒 miss）。
COUNTDOWN_DIRECTIONS = ("top_bottom", "bottom_top", "left_right", "right_left")
_CD_DIR_IDS = list(COUNTDOWN_DIRECTIONS)


def countdown_direction_display():
    """内部 token（英文，稳定）→ 中文显示名。

    ⚠️ 必须是函数、调用时求值（base 纯中文无雷；但 multi 侧模块级 _() 会冻在导入时中文，
    写成模块级元组会让反查表永远对不上译文 → 必须同形态，便于 port）。
    """
    return {"top_bottom": "上→下", "bottom_top": "下→上",
            "left_right": "左→右", "right_left": "右→左"}
_CD_AXIS = {"top_bottom": "y", "bottom_top": "y", "left_right": "x", "right_left": "x"}
_CD_REVERSE = {"bottom_top": True, "right_left": True}
COUNTDOWN_PAD = 8      # 画布内边距（给描边/字形溢出留余量，与旋转子图 pad=8 同惯例）


def countdown_direction(tw_settings) -> str:
    """倒计时方向 id（空/非法值回退 top_bottom）。"""
    d = str((tw_settings or {}).get("countdown_direction", "") or "").strip()
    return d if d in _CD_DIR_IDS else "top_bottom"


def countdown_lines(text):
    """富文本 → 参与滚动的行列表：按换行拆分，去掉首尾空行与纯空白行。"""
    raw = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    lines = [ln.strip() for ln in raw.split("\n")]
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return lines


def _cd_num(v, default, lo=None, hi=None):
    """读数值型倒计时设置：空/非法 → default；lo/hi 为 None 表示不限制该侧。"""
    if v is None or str(v).strip() == "":
        return default
    try:
        f = float(v)
    except (ValueError, TypeError):
        return default
    if lo is not None and f < lo:
        f = lo
    if hi is not None and f > hi:
        f = hi
    return f


def countdown_layout(tw_settings, font_path, font_size):
    """倒计时画布布局（纯计算：无 IO、不碰 ffmpeg）。返回 None 表示无法布局。

    返回 dict：
      lines       参与滚动的文本行
      horizontal  横排（左→右/右→左）还是竖排（上→下/下→上）
      canvas_w/h  画布像素尺寸（已含 COUNTDOWN_PAD 内边距）
      pos         每行 drawtext 的左上角 [(x, y)...]
      pitch       相邻行/列步进（= 单行自然尺寸 + 行距）
      t0/t1       匀速滚动的开始/结束时间（秒）；留空自动 = 0 ~ 行数−1（每秒滑过一格）
      win         显示窗口 (x, y, w, h)，已夹紧到画布内
      limit       窗口在该轴上能走到的最大坐标（停在最后一项完整入窗处）

    窗口四个值缺省（空/0）时按方向自动给：尺寸=单行/单列满幅，起点=首项（反向则是末项）。
    """
    fs = _opt_int(font_size, 48)
    if fs <= 0:
        fs = 48
    lines = countdown_lines((tw_settings or {}).get("text", ""))
    if not lines or not font_path or not os.path.exists(font_path):
        return None
    sizes = [estimate_text_size(ln, font_path, fs) for ln in lines]
    item_w = max(w for w, _h in sizes) or fs
    item_h = max(h for _w, h in sizes) or fs
    raw_gap = (tw_settings or {}).get("countdown_gap")
    gap = int(_cd_num(raw_gap, 0, lo=0, hi=2000))
    if raw_gap is None or str(raw_gap).strip() == "":
        gap = max(2, int(round(fs * 0.2)))     # 没设过 → 按字号给个舒服的默认间距
    _dir = countdown_direction(tw_settings)
    horizontal = _CD_AXIS[_dir] == "x"
    reverse = _CD_REVERSE.get(_dir, False)
    n = len(lines)
    if horizontal:
        pitch = item_w + gap
        canvas_w = (n - 1) * pitch + item_w + 2 * COUNTDOWN_PAD
        canvas_h = item_h + 2 * COUNTDOWN_PAD
        pos = [(COUNTDOWN_PAD + i * pitch + (item_w - w) // 2, (canvas_h - h) // 2)
               for i, (w, h) in enumerate(sizes)]
        win_dw, win_dh = item_w, canvas_h
    else:
        pitch = item_h + gap
        canvas_w = item_w + 2 * COUNTDOWN_PAD
        canvas_h = (n - 1) * pitch + item_h + 2 * COUNTDOWN_PAD
        pos = [((canvas_w - w) // 2, COUNTDOWN_PAD + i * pitch)
               for i, (w, h) in enumerate(sizes)]
        win_dw, win_dh = canvas_w, item_h
    def _win_val(key, auto):
        raw = (tw_settings or {}).get(key)
        if raw is None or str(raw).strip() == "":
            return int(auto)
        try:
            return int(float(raw))
        except (ValueError, TypeError):
            return int(auto)

    # 窗口未设置时的默认尺寸 = 单行 / 单列（另一轴铺满画布）
    ww = _win_val("countdown_win_w", win_dw)
    wh = _win_val("countdown_win_h", win_dh)
    # 窗口夹紧到画布内：越界的 crop 会让 ffmpeg 直接报错/拉黑，归到合法区间更稳
    ww = max(2, min(ww, canvas_w))
    wh = max(2, min(wh, canvas_h))
    # 运动边界：停在「最后一项刚好完整入窗」处（= 内容末端 − 窗口尺寸），而不是画布底。
    # ⚠️ 用画布底的话最后一格会滑出窗口、片尾变成空白块 —— 「到底停住」要的是停在最后一项。
    # 窗口比内容还长时该值会小于起点，再夹回 COUNTDOWN_PAD（此时本来也无处可滚）。
    _item_axis = item_h if not horizontal else item_w
    _canvas_axis = canvas_h if not horizontal else canvas_w
    _win_axis = wh if not horizontal else ww
    _content_end = COUNTDOWN_PAD + (n - 1) * pitch + _item_axis
    far = max(COUNTDOWN_PAD, min(_content_end - _win_axis, _canvas_axis - _win_axis))
    # 起点默认：正向=画布首项处，反向=末项处（用户手填的 win_x/win_y 优先）
    start = far if reverse else COUNTDOWN_PAD
    wx = _win_val("countdown_win_x", start if horizontal else 0)
    wy = _win_val("countdown_win_y", 0 if horizontal else start)
    wx = max(0, min(wx, canvas_w - ww))
    wy = max(0, min(wy, canvas_h - wh))
    return {
        "lines": lines, "horizontal": horizontal, "reverse": reverse,
        "canvas_w": canvas_w, "canvas_h": canvas_h, "pos": pos,
        "pitch": pitch, "start": (far if reverse else COUNTDOWN_PAD),
        "t0": _cd_num((tw_settings or {}).get("countdown_t0"), 0.0, lo=0.0, hi=360000),
        "t1": _cd_num((tw_settings or {}).get("countdown_t1"),
                      max(1.0, float(n - 1)), lo=0.001, hi=360000),
        "win": (wx, wy, ww, wh),
        "limit": far,
    }


def build_tw_countdown_subgraph(tw_settings, main_label: str = "", out_label: str = "[v_tw]",
                                trim_start=0.0, speed_factor=1.0, tag: str = ""):
    """倒计时（滚动小窗）文字水印的 filter_complex 片段。

    与「旋转子图」同级：吃 main_label（主视频）输出 out_label；graph 形如
        color=c=black@0:s=CWxCH:d=999999[cd_bg0];
        [cd_bg0]drawtext=…,drawtext=…,…[cd_strip0];
        [cd_strip0]crop=w=WW:h=WH:x=0:y='8+(601-8)*min(max((t-1)/4,0),1)'[cd_win0];
        [主][cd_win0]overlay=x='(X)':y='(Y)':format=auto[out]

    ⚠️ 基础源必须写成 color=c=black@0 —— _ensure_tw_duration_limit 靠这个子串识别
    「命令里有无限时长源」，从而自动补 -shortest / -t（否则输出被拉到 999999 秒）。
    tag：同图多条时的标签后缀（由 build_text_watermark_chain 按下标传入），防标签重名。
    2026-09-19：显示时段起点作为计时零点（第 5 秒才出现时窗口不该已经滑走）；
    2026-09-19 二稿：运动模型=「开始~结束时间内匀速线性滚动」（弃跳格 floor(t/T)*STEP）——
    开始前钳在起点、结束后钳在终点；t0/t1 是秒（随变速/trim 换算），像素坐标不受变速影响。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    fs = _opt_int(tw_settings.get("font_size", 48), 48)
    font_name = tw_settings.get("font_name", "微软雅黑")
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    lay = countdown_layout(tw_settings, font_path, fs)
    if not lay:
        return ""
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    bw = _opt_int(tw_settings.get("border_w", 0), 0)
    _bc = (tw_settings.get("border_color", "#000000") or "#000000").lstrip("#")
    _fc = (tw_settings.get("font_color", "#FFFFFF") or "#FFFFFF").lstrip("#")
    _fp = escape_drawtext_path(font_path)

    # ---- ① 画布：每行一个 drawtext 显式定位（绝不用 text_h 做多行居中）----
    dt_nodes = []
    for i, ln in enumerate(lay["lines"]):
        px, py = lay["pos"][i]
        p = [f"fontfile={_fp}", f"text={escape_drawtext_text(ln)}",
             f"fontsize={fs}", f"fontcolor=0x{_fc}@{opacity:.2f}",
             f"x={px}", f"y={py}"]
        if bw > 0:
            p += [f"borderw={bw}", f"bordercolor=0x{_bc}@{opacity:.2f}"]
        dt_nodes.append("drawtext=" + ":".join(p))

    # ---- ② 滚动时段换算（同 _build_drawtext_enable 口径：秒随 trim 平移、除 speed）----
    _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _e0 = _f(tw_settings.get("enable_start")) or 0.0   # 显示时段起点 = 计时零点
    _a = _e0 + float(lay["t0"])
    _b = _e0 + max(float(lay["t1"]), float(lay["t0"]) + 0.001)
    if _b <= _a:
        _b = _a + 0.001          # 结束≤开始 → 按最小时长兜底（窗口等于不动）
    if _ts != 0.0 or _sp != 1.0:
        # 区间两端都换算（_timeline_convert 是线性映射，端点各自变换即区间变换）
        _a, _du = _timeline_convert(_a, 0.0, _ts, _sp)
        _b, _du = _timeline_convert(_b, 0.0, _ts, _sp)
        if _b <= _a:
            _b = _a + 0.001
    _a = max(0.0, float(_a))
    _b = max(_a + 0.001, float(_b))
    _den = _ffsec(_b - _a)
    _prog = (f"(t/{_den})" if _a <= 0
             else f"((t-{_ffsec(_a)})/{_den})")
    _prog = f"min(max({_prog},0),1)"   # 开始前=0 停在起点；结束后=1 停在终点

    # ---- ③ 显示窗口沿轴匀速滚动：pos = 起点 + (终点−起点)×进度 ----
    # 反向的终点是「首项所在位置」(COUNTDOWN_PAD) 而不是 0 —— 要停在第一个字上，
    # 滑到 0 会多吃掉一个 COUNTDOWN_PAD 的边距，边上的字会偏。
    wx, wy, ww, wh = lay["win"]
    if lay["horizontal"]:
        _end = float(lay["limit"]) if not lay["reverse"] else float(min(wx, COUNTDOWN_PAD))
        _d = _end - float(wx)
        x_expr = f"({wx})+({_d:g})*{_prog}"
        y_expr = str(wy)
    else:
        _end = float(lay["limit"]) if not lay["reverse"] else float(min(wy, COUNTDOWN_PAD))
        _d = _end - float(wy)
        y_expr = f"({wy})+({_d:g})*{_prog}"
        x_expr = str(wx)
    crop_node = f"crop=w={ww}:h={wh}:x='{x_expr}':y='{y_expr}'"

    # ---- ④ 叠加回主视频：X/Y 沿用普通文字水印语义（= 小窗左上角）----
    _q = lambda s: str(s).replace(chr(39), chr(92) + chr(39))
    ov_x = (tw_settings.get("overlay_x", "10") or "10").strip() or "10"
    ov_y = (tw_settings.get("overlay_y", "10") or "10").strip() or "10"
    ov_node = f"overlay=x='{_q(ov_x)}':y='{_q(ov_y)}':format=auto"
    _en = _build_drawtext_enable(tw_settings, trim_start=trim_start, speed_factor=speed_factor)
    if _en:
        ov_node += f":enable='{_q(_en)}'"

    _t = tag or ""
    ml = main_label if main_label else ""
    return ";".join([
        f"color=c=black@0:s={lay['canvas_w']}x{lay['canvas_h']}:d=999999[cd_bg{_t}]",
        f"[cd_bg{_t}]" + ",".join(dt_nodes) + f"[cd_strip{_t}]",
        f"[cd_strip{_t}]{crop_node}[cd_win{_t}]",
        f"{ml}[cd_win{_t}]{ov_node}{out_label}",
    ])


def wrap_image_static_timed_complex(lavfi_complex_str, base_vf, w, h, dur,
                                    vin="[VIN]", prefix="", fps=30, out="v0"):
    """图片主视频 + 带时间滤镜（倒计时/轨迹/旋转）的 mpv 动画修复（纯函数，2026-09-19）。

    2026-09-22 参数化（A5 收敛）：原先只有 `[VIN]` + `[v0]` 一种形态，导致封装页画中画
    （`[vid1]` 且带 loop/trim 前缀）只能内联手抄一遍。现补 4 个可选参数，默认值与旧调用
    逐字等价，故既有调用方零行为变化：
      · vin    主输入标签（画中画传 "[vid1]"）；
      · prefix 主输入标签后的前置滤镜串（画中画传 loop/trim 前缀，需带尾逗号）；
      · fps    基源帧率（默认 30，与旧硬编码一致）；
      · out    输出标签名（不含方括号，默认 "v0"）。

    静态图片在 mpv 里只被解码成「单帧」：若 lavfi-complex 最终输出的主输入是图片
    ([VIN])，整张滤镜图只在该单帧上求值一次，时间变量 t 卡死 → 倒计时/轨迹不动。
    修复 = 前置一个连续 color 基源、把图片作为「被保持的次输入」叠上去（overlay 默认
    eof_action=repeat 保持图片），使 [v0] 变连续流。这精确镜像用户已验证可用的 fade 写法
    （连续 color 作主时间轴驱动，图片作被保持的次输入）。

    仅对 mpv 的 lavfi-complex 路径生效；ffplay 走 -loop 1 天然连续，不走此函数。
    :param base_vf: 主视频前置滤镜链（如 'format=yuv420p' 或 ''/'null'）；
                    与 lavfi_complex_str 首节点 '[VIN]{base_vf}[v0]' 保持一致。
    :param w,h,dur: 图片尺寸与显示时长（秒）；基源 s=WxH、r=30、d=dur。
    :return: 改写后的 lavfi-complex 字符串（首节点变为
             '[VIN]{base_vf}[cd_v0];[cd_base][cd_v0]overlay=format=auto[v0]'，
             前置 'color=c=black@0:s=WxH:r=30:d=dur[cd_base];'）；
             注意 [cd_base] 只能作为 overlay 的主输入，绝不能前置到 format 这类单输入滤镜前
             （否则 filtergraph 报「输入数不符」→ mpv 无画面）；[VIN] 经 format 后只产生 [cd_v0]，
             再由 overlay 叠到连续基源上。若首节点形态不匹配则原样返回（如画布图，其首节点
             不是 [VIN]{base_vf}[v0]）。
    """
    if not lavfi_complex_str:
        return lavfi_complex_str
    try:
        _w = int(w); _h = int(h); _d = float(dur)
    except (ValueError, TypeError):
        return lavfi_complex_str
    if _w <= 0 or _h <= 0 or _d <= 0:
        return lavfi_complex_str
    _bf = base_vf if (base_vf and base_vf != "null") else "format=yuv420p"
    _old = f"{vin}{prefix}{_bf}[{out}]"
    if _old not in lavfi_complex_str:
        return lavfi_complex_str
    _new = (f"{vin}{prefix}{_bf}[cd_v0];"
            f"[cd_base][cd_v0]overlay=format=auto[{out}]")
    _pre = f"color=c=black@0:s={_w}x{_h}:r={fps:g}:d={_ffsec(_d)}[cd_base];"
    return _pre + lavfi_complex_str.replace(_old, _new, 1)


def ffplay_image_main_vf(vf, dur):
    """图片主视频的 ffplay `-vf` 图改写：让单帧图片变成「可循环 + 到点收尾」的连续流（2026-09-21）。

    为什么必须改写（真机实测 ffplay n9.0.1，SDL dummy 无头）：
      - `-loop 1 -i img.jpg` 在 ffplay 下**不循环** ⇒ 1 帧读完即退窗（实测 0.64s）；
      - `-autoexit` 盯的是**主输入 EOF**，图片输入只有 1 帧 ⇒ 立刻 EOF 退窗；
      - 只前置 color 连续基源（mpv 的 wrap）也救不了退窗（实测仍 0.64s）——它解决的是
        「时间变量 t 卡死」（倒计时/轨迹/旋转不动），不是输入 EOF。

    ✅ 破法（与封装页画中画 ffplay 路线同款、已实测）：图首给主输入注入
    `loop=loop=-1:size=1:start=0,setpts=PTS-STARTPTS,` 把主分支变**无限流**，图尾
    `trim=0:N,setpts=PTS-STARTPTS` 收尾 ⇒ `-autoexit` 转而等【输出】结束，窗口在 N 秒正常关。
    实测 6s 图：0.64s → 6.63s（存活 = 图长）。

    :param vf:  ffplay 的 -vf 字符串。两种形态都支持：
                · 分号多段图（含 `[in]`/`[out]` 显式标签，如复杂图改写结果）；
                · 纯逗号链（无标签，如普通滤镜链）。
    :param dur: 图片显示时长（秒）；无效/<=0 时原样返回（调用方保持旧行为）。
    :return: 改写后的 -vf 字符串。
    """
    try:
        _d = float(dur)
    except (ValueError, TypeError):
        return vf
    if not vf or _d <= 0:
        return vf
    _pfx = "loop=loop=-1:size=1:start=0,setpts=PTS-STARTPTS,"
    _tail = f"trim=0:{_ffsec(_d)},setpts=PTS-STARTPTS"
    if "[in]" in vf:
        g = vf.replace("[in]", "[in]" + _pfx, 1)
        if "[out]" in g:
            g = g.replace("[out]", "[v_img_loop]", 1)
        else:
            # 图的末标签不是 [out]（异常形态）→ 取最后一个输出标签接尾
            _tags = re.findall(r"\[([^\]]+)\](?=\s*(?:;|$))", g)
            if not _tags:
                return vf
            g = g.replace(f"[{_tags[-1]}]", "[v_img_loop]", 1)
        return f"{g};[v_img_loop]{_tail}[out]"
    # 分号多段图却拿不到 [in]（异常形态：调用方未用 [VIN]/[vid1] 占位）→ 前缀无处可插，
    # 原样返回（调用方另打日志）。绝不能退化成拼逗号链：`loop=..,<段1>;<段2>,trim=..`
    # 是坏图，ffplay 只会给黑窗 + stderr 噪声。
    if ";" in vf:
        return vf
    # 纯逗号链：直接首尾相接（loop 前缀 + 末端 trim）
    return f"{_pfx}{vf},{_tail}"


def build_text_watermark_chain(tw_input, main_label: str = "", out_label: str = "[v_tw]") -> str:
    """多个文字水印链式生成（2026-08-26）。

    tw_input: 完整 settings（含 text_watermark_items / text_watermark）或单条 tw dict。
    - 完整 settings 且有 text_watermark_items → 遍历启用项逐个调用 build_text_watermark_filtergraph，
      out_label 逐级串联（第 k 项输出接第 k+1 项输入）；
    - 无 items → 退化为单条（text_watermark 或 tw_input 本身），行为与旧版一致。
    """
    if isinstance(tw_input, dict) and ("text_watermark_items" in tw_input or "text_watermark" in tw_input):
        items = tw_input.get("text_watermark_items")
        if not items:
            items = [tw_input.get("text_watermark") or {}]
    else:
        items = [tw_input or {}]
    active = [i for i in items
              if i.get("enabled", True) and str(i.get("text", "")).strip()]
    if not active:
        return ""
    # 2026-08-29：tw_input=完整主视频 settings 时取 trim/speed 换算输出时间线
    # （文字水印显示时段/列表轨迹时间=主视频原始时间）；预览 settings 已禁用 trim → 不换算
    _ts, _sp = _trim_speed_from_settings(tw_input)
    cur_in = main_label
    frags = []
    for k, tw in enumerate(active):
        out = out_label if k == len(active) - 1 else f"[v_tw{k}]"
        f = build_text_watermark_filtergraph(tw, main_label=cur_in, out_label=out,
                                             trim_start=_ts, speed_factor=_sp, tag=str(k))
        if f:
            frags.append(f)
            cur_in = out
    return ";".join(frags)


def text_watermark_needs_subgraph(tw_settings) -> bool:
    """文字水印是否需要 filter_complex 子图：倒计时 / 静态旋转(rotate≠0) / 持续旋转(spin)任一启用。
    ⚠️ 必须与 build_text_watermark_filtergraph 内部的 needs_rot 判定逐字一致——
    各调用点用它决定走 -filter_complex 子图还是普通 -vf drawtext。
    曾因漏查 spin_enabled，导致「只开自旋转、旋转角度=0」时走了普通 drawtext 路径而不转。
    2026-09-19：倒计时=「画布 + 滚动 crop 窗口 + overlay」三段图，-vf 表达不了 → 同样返回 True。"""
    if not tw_settings:
        return False
    if tw_settings.get("countdown_enabled"):
        return True
    try:
        rot = float(tw_settings.get("rotate", 0) or 0) != 0
    except (ValueError, TypeError):
        rot = False
    spin = bool(tw_settings.get("spin_enabled", False))
    sp = _opt_float(tw_settings.get("spin_speed", 0) or 0, 0.0)
    if rot or (spin and sp != 0):
        return True
    # 列表轨迹：存在自旋转段 → 需要旋转子图（判定须与 build_text_watermark_filtergraph 一致）
    if (tw_settings.get("move_mode") or "") == "waypoints":
        try:
            _wpr = build_waypoint_expr(tw_settings.get("move_waypoints"), spin_speed=sp)
            if _wpr is not None and _wpr[2] is not None:
                return True
        except Exception:
            pass
    return False


def text_watermark_active(tw_settings) -> tuple:
    """文字水印是否生效 + 是否需要走旋转子图。返回 (enabled, needs_subgraph)。

    - enabled         = 开启且文字非空
    - needs_subgraph  = enabled 且 (静态旋转 rotate≠0 或 持续旋转 spin_enabled)

    ⚠️ 各命令生成点用它一次性算出 _tw_enabled / _tw_rotate，避免「启用判定」
    与 text_watermark_needs_subgraph 在各处重复书写而漂移。"""
    enabled = bool(tw_settings.get("enabled")) and bool((tw_settings.get("text", "") or "").strip())
    return enabled, (enabled and text_watermark_needs_subgraph(tw_settings))


def _cmd_has_output_option(cmd_list, *opts):
    u"""命令的【输出侧】是否已含指定选项（如 -t / -to / -shortest）。

    ffmpeg 的 -t/-to/-shortest 是位置相关选项：出现在最后一个 -i 之前的是【输入级】，
    只作用于该输入（例如图片素材烘焙出的 "-loop 1 -framerate 30 -t 16 -i img" 只让这张图
    读 16 秒），并不能限制整体输出。所以判断「输出已有时长限制」必须只看最后一个 -i
    之后的部分——否则输入级 -t 会让输出级限制被误判成已存在而漏加，无限源（文字水印旋转
    画布 color=c=black@0）就再也没人截断。
    同口径先例见 _adjust_end_concat_duration 的 last_i 写法。"""
    last_i = -1
    for idx, a in enumerate(cmd_list):
        if a == "-i":
            last_i = idx
    tail = cmd_list[last_i + 1:]
    return any(o in tail for o in opts)


def _ensure_tw_duration_limit(app, cmd_list, *, input_path=None, main_duration=None,
                              audio_enabled=True, tag="[文字水印]",
                              image_display_duration=None):
    """文字水印旋转/持续旋转(spin)时，build_text_watermark_filtergraph 使用
    color=c=black@0:s=WxH:d=999999 的无限时长透明源；若命令尚未加任何时长限制，
    必须补上时长限制，否则输出会被无限拉长到 999999s（甚至卡死）。

    时长限制策略（经真实 ffmpeg 验证）：
    - 主视频【有音频】且音频输出启用 → 用 -shortest（音频为有限流，可正确截断；
      实测无音频时 -shortest 对 color 无限源会卡死/不截断，故无音频绝不用 -shortest）。
    - 主视频【无音频】或音频禁用 → 必须用 -t 精确截断：优先用调用方传入的 main_duration，
      否则尝试探测主视频时长；两者皆无才无奈回退 -shortest（可能卡，但总比无限输出好）。

    非旋转文字水印（drawtext）不带无限源，命令里不含 color=c=black@0 标记会自动跳过，
    不影响正常有界输出。模块级辅助，app 传入调用方实例（需 _get_cached_stream_info /
    _get_media_duration / _append_info_ui）。只就地 append 到 cmd_list。"""
    # 仅当命令确实包含文字水印的无限透明源时才需要限制
    if not any("color=c=black@0" in str(a) for a in cmd_list):
        return
    # 输出侧已有限制（别处已加输出级 -t / -shortest）则跳过，避免重复。
    # 注意只看输出侧：输入级 -t（图片素材烘焙时长 -loop 1 -t N -i img）不能截断无限源画布。
    if _cmd_has_output_option(cmd_list, "-shortest", "-t"):
        return
    has_audio_stream = False
    if input_path and os.path.exists(input_path):
        info = app._get_cached_stream_info(input_path)
        if info and any(s.get("codec_type") == "audio"
                        for s in info.get("streams", [])):
            has_audio_stream = True
    # 有音频：优先 -shortest（音频有限流可正确截断）
    if audio_enabled and has_audio_stream:
        cmd_list.append("-shortest")
        return
    # 无音频 / 音频禁用：必须用 -t 精确截断，避免 -shortest 对 color 无限源卡死
    eff = main_duration
    # 静态图片主视频：无真实时长概念（ffprobe 对图片常返回 N/A 或 0.04 等小值），
    # 统一按默认 10s 处理（与 merge_build_cmd_list 的图片默认时长逻辑一致），
    # 避免文字水印旋转/spin 触发的时长限制把 -t 干扰成 -t 0.040。
    if input_path and os.path.exists(input_path) and \
            os.path.splitext(input_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
        # 图片主视频：优先用用户设定的「显示时长」(img_duration)，否则回退 10s
        eff = image_display_duration if (image_display_duration and image_display_duration > 0) else 10.0
    elif not (eff and eff > 0) and input_path and os.path.exists(input_path):
        try:
            eff = app._get_media_duration(input_path)
        except Exception:
            eff = None
    if eff and eff > 0:
        cmd_list.extend(["-t", f"{eff:.3f}"])
    else:
        # 兜底：连时长都算不出，退 -shortest（可能卡，但总比无限输出好）
        cmd_list.append("-shortest")
        with suppress(Exception):
            app._append_info_ui(
                f"{tag} 警告：无法计算主视频时长，使用 -shortest 控制输出。")


def _eff_image_display_duration(settings, default=10.0):
    u"""图片素材的「显示时长(秒)」：优先取用户设置的 img_duration，否则回退 default。

    图片文件本身无时长概念（ffprobe 对图片常返回 N/A 或 0.04s 小值），
    显示时长完全由用户在「截取」面板设定，不依赖文件探测值。"""
    if not settings:
        return default
    d = settings.get("img_duration", "")
    if d:
        try:
            s = time_to_seconds(str(d))
            if s and s > 0:
                return s
        except Exception:
            pass
    return default


def _merge_output_total_duration(app, enabled_tracks):
    u"""串行合并多素材时，整条时间轴的总时长 = 各启用视频轨道有效时长之和。

    图片素材取其「显示时长」(img_duration)；真实视频取探测时长（尊重截取）。
    不含转场重叠扣减——转场由用户后续作为独立文件处理（与 NLE「每张图=自带时长的 clip」一致）。"""
    total = 0.0
    for t in enabled_tracks:
        if getattr(t, "type", "video") != "video":
            continue
        st = getattr(t, "enc_settings", None) or {}
        p = normalize_path(getattr(t, "file_path", "") or "")
        if app._is_static_image(p):
            total += _eff_image_display_duration(st)
        else:
            d = app._get_media_duration(p) if p else None
            if d:
                if st.get("trim_enabled"):
                    try:
                        ss = time_to_seconds(str(st.get("trim_start", "")).strip() or "0") or 0.0
                        es = time_to_seconds(str(st.get("trim_end", "")).strip() or "")
                        if es is not None:
                            d = max(0.0, es - ss)
                    except Exception:
                        pass
                total += d
    return total


# ================== 视频尺寸计算 ==================
def get_video_dimensions(ffprobe_cmd: str, file_path: str) -> Tuple[Optional[int], Optional[int]]:
    """获取视频原始宽高（不考虑旋转）"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None, None
    cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
           "-show_entries", "stream=width,height", "-of", "csv=p=0", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
        if result.returncode == 0 and ',' in result.stdout.strip():
            w_str, h_str = result.stdout.strip().split(',')
            return int(w_str), int(h_str)
    except:
        pass
    return None, None

def get_video_pixel_aspect(ffprobe_cmd: str, file_path: str) -> Optional[Tuple[int, int]]:
    """获取像素宽高比 SAR（sample aspect ratio），如 (9, 16)；方形像素/读取失败返回 None。

    背景（2026-09-07）：HandBrake 默认 Loose anamorphic 会在 crop 后写 SAR 保住源显示
    比例，出现「编码 1080x1080、播放器按 9:16 拉伸成 1080x1920」的文件。ffmpeg 滤镜
    坐标始终按编码像素网格（不受 SAR 影响），但 ffprobe width/height 不含此信息，
    可视化裁剪等「所见即所得」界面需要单独读取来做显示拉伸。
    """
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None
    cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
           "-show_entries", "stream=sample_aspect_ratio", "-of", "csv=p=0", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
        lines = (result.stdout or "").strip().splitlines()
        if not lines:
            return None
        parts = lines[0].strip().split(":")
        if len(parts) != 2:
            return None  # "N/A" 等非 num:den 形式
        num, den = int(parts[0]), int(parts[1])
        if num <= 0 or den <= 0 or num == den:
            return None
        return num, den
    except:
        return None

def _sar_effective_after_prefilter(sar_pair, pre_filter):
    """背景预处理滤镜含奇数个 transpose（90°/270° 旋转）时交换 SAR 拉伸轴。

    实测 n9.0.1：crop 保留 SAR（裁出区域照样按源方向拉伸显示）；
    transpose=1/2 交换 SAR（9:16→16:9，像素转了 90° 拉伸轴必随之转）；
    180° = transpose 两次（偶数）不换轴；hflip/vflip 不改 SAR。
    位置编辑器画布是旋转后坐标空间（compute_rendered_size 已交换宽高），
    拉伸轴必须随旋转交换，否则竖拉/横拉方向与播放器显示相反。
    """
    if not sar_pair:
        return sar_pair
    try:
        _nt = len(re.findall(r"transpose=[12]", pre_filter or ""))
        if _nt % 2 == 1:
            return (sar_pair[1], sar_pair[0])
    except Exception:
        pass
    return sar_pair

def get_video_display_geometry(ffprobe_cmd: str, file_path: str):
    """编码尺寸 + 播放显示几何（SAR 拉伸后）。

    返回 (w, h, full_w, full_h, sar_num, sar_den)；方形像素/读取失败时
    full == w/h、sar 两个 None。坐标空间恒为编码像素，full 只用于「显示」：
    可视化编辑器按 full 等比缩放入屏幕，坐标用 x/y 独立因子反算回编码网格
    （所见即所得：预览拉伸 → 裁剪/选区落在编码网格 → 转出继承 SAR → 播放器同样拉伸）。
    """
    w, h = get_video_dimensions(ffprobe_cmd, file_path)
    if w is None or h is None:
        return None, None, None, None, None, None
    fw, fh = w, h
    sn = sd = None
    sar = get_video_pixel_aspect(ffprobe_cmd, file_path)
    if sar is not None:
        sn, sd = sar
        if sd > sn:
            # 竖向拉伸（如 9:16）：播放器保持宽度、拉高
            fh = max(1, int(round(h * sd / sn)))
        else:
            # 横向拉伸：播放器保持高度、拉宽
            fw = max(1, int(round(w * sn / sd)))
    return w, h, fw, fh, sn, sd

# --- 探测缓存（2026-09-24）----------------------------------------------------
# get_video_rotated_dimensions 原本每次调用要起 2 个 ffprobe 子进程（尺寸 + 元数据旋转），
# 而预览路径（_preview_with_settings）单次会对同一个水印文件重复调用 4 次 ⇒ 这里按
# (路径, mtime) 缓存，源文件一改自动失效。与 FFmpegBatchGUI._get_video_dimensions_cached
# 同口径（都是 path+mtime）。
# ⚠ 失败不进缓存（超时 / rc≠0 / 解析失败下次仍重试），避免把「这次没探到」固化成「没有旋转」。
_PROBE_CACHE_MAX = 256
_PROBE_DIM_CACHE = {}      # (path, mtime) -> (w, h)
_PROBE_ROT_CACHE = {}      # (path, mtime) -> Optional[int] 元数据旋转角

def _probe_cache_key(file_path):
    """取不到 mtime 时返回 None（= 本次不缓存）"""
    try:
        return (file_path, os.path.getmtime(file_path))
    except OSError:
        return None

def _probe_cache_put(cache, key, value):
    if key is None:
        return
    if len(cache) >= _PROBE_CACHE_MAX:
        cache.clear()
    cache[key] = value

def get_video_rotated_dimensions(ffprobe_cmd: str, file_path: str, settings: Dict[str, Any]) -> Tuple[Optional[int], Optional[int]]:
    """获取考虑元数据旋转和用户旋转后的尺寸

    尺寸与元数据旋转各带一层缓存（见上方 _PROBE_*）：重复调用不再重复起 ffprobe。
    用户旋转（settings["rotate"]）**不进**缓存 key —— 它是在返回值上临时叠加的。
    """
    _ckey = _probe_cache_key(file_path)
    if _ckey is not None and _ckey in _PROBE_DIM_CACHE:
        w, h = _PROBE_DIM_CACHE[_ckey]
    else:
        w, h = get_video_dimensions(ffprobe_cmd, file_path)
        if w is not None and h is not None:
            _probe_cache_put(_PROBE_DIM_CACHE, _ckey, (w, h))
    if w is None:
        return None, None
    # 检测元数据旋转
    if ffprobe_cmd:
        rot = None
        if _ckey is not None and _ckey in _PROBE_ROT_CACHE:
            rot = _PROBE_ROT_CACHE[_ckey]
        else:
            cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
                   "-show_entries", "stream=side_data_list", "-of", "json", file_path]
            try:
                flags = _ffmpeg_spawn_flags()
                result = subprocess.run(cmd, capture_output=True, text=True,
                                        timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
                if result.returncode == 0:
                    data = json.loads(result.stdout)
                    streams = data.get("streams", [])
                    if streams:
                        side_data = streams[0].get("side_data_list", [])
                        for sd in side_data:
                            if sd.get("rotation") is not None:
                                rot = int(sd.get("rotation"))
                                break
                    # 只有 rc==0 才写入缓存（失败留给下次重试）
                    _probe_cache_put(_PROBE_ROT_CACHE, _ckey, rot)
            except:
                pass
        if rot is not None and rot % 180 == 90:
            w, h = h, w
    # 用户旋转
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    return w, h

def compute_rendered_size(original_w: int, original_h: int, settings: Dict[str, Any]) -> Tuple[int, int]:
    """根据设置（裁剪、旋转、缩放）计算最终渲染尺寸"""
    w, h = original_w, original_h

    # --- 防御性检查，避免除零 ---
    if w == 0 or h == 0:
        return 0, 0

    # 裁剪
    if settings.get("crop_enabled", False):
        crop_w = settings.get("crop_width", "").strip()
        crop_h = settings.get("crop_height", "").strip()
        if crop_w and crop_h:
            def eval_crop(expr):
                if not expr:
                    return None
                expr2 = expr.replace('iw', str(w)).replace('ih', str(h))
                result = safe_eval_expr(expr2, {})
                return result if result is not None else None
            cw = eval_crop(crop_w)
            ch = eval_crop(crop_h)
            if cw and ch and cw > 0 and ch > 0:
                w, h = cw, ch
    # 用户旋转（2026-08-29 补：rotate 90/270 交换宽高，与 compute_final_size_with_order
    # 的 crop→rotate→scale 顺序一致——原版漏 rotate，主视频旋转时文字水印画布宽高
    # 不交换=「编辑框尺寸没旋转但背景帧(transpose)转了」错位）
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    # 缩放
    if settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        sw = settings.get("scale_width", "").strip()
        sh = settings.get("scale_height", "").strip()
        try:
            if method == "width" and sw:
                target_w = int(float(sw))
                target_h = int(round(target_w * h / w))
                w, h = target_w, target_h
            elif method == "height" and sh:
                target_h = int(float(sh))
                target_w = int(round(target_h * w / h))
                w, h = target_w, target_h
            elif method == "exact" and sw and sh:
                w, h = int(float(sw)), int(float(sh))
        except:
            pass
    return w, h


def _blend_move_exprs(mode, move_settings=None, sw="w", sh="h"):
    """为 blend 动态区域构造【双轴】轨迹表达式（overlay 版 W/H/w/h；crop 版由调用方 W/H→iw/ih）。

    ⚠️ 2026-08-24 实测纠错：crop 的 x/y 表达式【支持】逗号函数与状态变量
    （min/max/mod/lt/gte/st/ld/分号全可用，ffmpeg 8.1 六项实验全过）——旧认知
    "crop 不支持逗号函数"是当年实测误判。因此 h/v/diamond/corners 所有轨迹均可
    blend 动态跟随（"走到哪混到哪"），不再有仅 h/v 的限制。
    表达式基于 build_move_xy_expr（含 min/max 夹紧到画布内），sw/sh 传区域尺寸数字。
    返回 (x_expr, y_expr)；mode 不支持返回 (None, None)。"""
    ms = move_settings or {}
    if mode not in ("h", "v", "diamond", "corners"):
        return None, None
    x0 = str(ms.get("overlay_x", "0") or "0")
    y0 = str(ms.get("overlay_y", "0") or "0")
    return build_move_xy_expr(mode, x0, y0, ms, sw=str(sw), sh=str(sh))


def _blend_crop_exprs(x_expr, y_expr, bw, bh):
    """动态轨迹 blend 的 crop 版表达式：W/H→iw/ih + 独立 w/h→区域尺寸数字。
    crop 表达式环境只有 iw/ih（无 W/H/w/h 变量）；overlay_x/y 基准可能含 "W-w-10" 等。
    正则 \bw\b/\bh\b 只匹配独立变量，不会误伤 iw/ih 里的 w/h（前接 i 非单词边界）。
    返回 (x_crop, y_crop)。正式命令 / 合并页预览 / 转换页预览 三处共用，勿复制粘贴。"""
    def _conv(e):
        e = e.replace("W", "iw").replace("H", "ih")
        e = re.sub(r"\bw\b", str(bw), e)
        e = re.sub(r"\bh\b", str(bh), e)
        return e
    return _conv(x_expr), _conv(y_expr)


def _blend_region_size(w, h, rotated):
    """blend 区域尺寸：旋转（自旋转/静态角度）时用对角线 d=round(hypot(w,h))（需求2：
    不切旋转内容，与正式命令 _overlay_sub_size 一致）；非旋转用渲染尺寸。偶数化 + min 2。
    正式命令 / 合并页预览 / 转换页预览 三处共用，勿复制粘贴。"""
    if rotated:
        d = int(round(((w * w + h * h) ** 0.5)))
        bw = bh = d
    else:
        bw, bh = int(w), int(h)
    if bw % 2:
        bw -= 1
    if bh % 2:
        bh -= 1
    return max(2, bw), max(2, bh)


def _content_box_expr(expr, w, h):
    """把位置表达式里的独立 \bw\b/\bh\b 替换为内容盒尺寸数字。

    旋转时 overlay 的 w/h 变量 = 旋转画布 d×d（overlay 输入尺寸），而 overlay_x/y
    （如 "W-w-10"）的语义是**内容盒**（未旋转 w×h）→ 求值前必须替换，否则内容整体
    偏移 (d-w)/2。正则 \bw\b 不会误伤 iw/ih/ow/oh 里的 w/h（前接 i/o 非单词边界）。
    与 _blend_crop_exprs 的 _conv 同一策略，勿复制粘贴。"""
    e = re.sub(r"\bw\b", str(w), str(expr))
    e = re.sub(r"\bh\b", str(h), e)
    return e


def rotate_box_size(w, h, stages=1):
    """连续 n 道 rotate(ow/oh=hypot(iw,ih)) 之后的包装盒尺寸（正方形，逐级 √2 放大）。

    ⚠️ 必须按「实际挂了几道 rotate」求，不能一律按一道 hypot(w,h) 算：
    第二道 rotate 的输入已是第一道的输出 d1×d1 → 输出 d2=hypot(d1,d1)=d1*√2。
    实测（ffmpeg，内容 400x300）：一道 500x500，两道 707x707 —— 按一道补偿会少补
    (d2-d1)/2 ≈ 103px，内容整体偏右下（预览与导出同错，但用户看到的是「位置不对」）。
    触发场景：文字水印「静态角 rotate≠0 + 自旋转/spin 或列表自旋转」= 两道
    （图片/视频水印把三种角度合并进**单道** rotate，不受影响）。
    """
    bw, bh = float(w), float(h)
    for _unused in range(max(0, int(stages))):
        bw = bh = (bw * bw + bh * bh) ** 0.5
    return bw, bh


def _content_box_shift(content_w, content_h, box_w, box_h):
    """旋转中心对齐偏移：内容盒（未旋转 w×h）→ 叠加盒（旋转画布 d×d 或 clamp 后区域）
    的定位偏移。叠加盒与内容盒中心重合 → 叠加盒左上角 = 内容盒左上角 - (box-w)/2。
    非旋转时 box=内容盒 → 返回 (0,0)。"""
    return (box_w - content_w) / 2.0, (box_h - content_h) / 2.0


def overlay_rotation_active(settings, wp_rot=None):
    """叠加层（子视频 / 图片水印）是否**真的**产出了 rotate 包装盒（d×d 对角线正方形）。

    ⚠️ 唯一真相源（2026-09-17）：所有「是否旋转」的判定必须调本函数，禁就地手写
    `spin or rotate_angle != 0`。此前 9 处手写判定互相漂移，最严重的一条：
    正式命令的包装盒尺寸 `_overlay_sub_size` 只认 spin/静态角度，**不认列表轨迹旋转**；
    而封装页预览（37100）算了列表轨迹 → 同一套参数「预览已做中心补偿、导出没做」
    → 开角度后预览与导出错开 (d-w)/2、(d-h)/2（对角线越大越明显）。
    判定口径必须与「是否真的 append 了 rotate 滤镜」逐字一致。

    - spin：spin_enabled **且** spin_speed != 0（项目铁律：spin=spin_enabled and spin_speed!=0）
    - 静态角：rotate_angle != 0
    - 列表轨迹：move_mode=="waypoints" 且 build_waypoint_expr 产出了非空角度表达式
    - wp_rot：调用方已算过 build_waypoint_expr 时直接传入（避免重复解析），None=自行判定
    """
    if not settings:
        return False
    _ra = _opt_float(settings.get("rotate_angle", 0) or 0, 0.0)
    if _ra != 0:
        return True
    # ⚠️ 只在「取值失败」时回落 60，绝不能写 `get(...) or 60.0`——
    # 显式的 spin_speed=0 会被 `or` 当成「没填」而变成 60，谓词误判为旋转
    # （项目口径：spin = spin_enabled and spin_speed != 0）。
    _spv = _opt_float(settings.get("spin_speed", 60.0), 60.0)
    if bool(settings.get("spin_enabled", False)) and _spv != 0:
        return True
    if (settings.get("move_mode") or "") == "waypoints":
        if wp_rot is not None:
            return bool(wp_rot)
        try:
            _r = build_waypoint_expr(settings.get("move_waypoints"), spin_speed=_spv)
            return bool(_r is not None and len(_r) > 2 and _r[2] is not None)
        except Exception:
            return False
    return False


def _pipe_scale_abs_coord(expr, factor):
    """管道预览「工作分辨率上限」下，把**原始画面空间**的绝对像素坐标换算到缩小后的空间。

    背景（2026-09-21 用户实测）：上限把帧整体乘 f=上限/帧宽 缩小后，设置里写死的绝对像素
    （简易位置/水印的数字、列表轨迹航点、四角边距）不会跟着变 → 子视频在缩小后的画布里相对
    更靠右下，表现为「主视频与子视频之间很大空隙」。mpv/ffplay 不做降采样，故只在管道预览出现；
    f = 上限/原始宽 → 原始越大偏得越多（用户实测「原始尺寸越大，空隙越大」）。
    含画布/子视频尺寸变量（W/H/w/h 等）或函数名的表达式由 ffmpeg 在图内按**当前（已缩小的）**
    空间求值，不需要也不应再缩放 → 原样返回。factor>=1 时原样返回（零行为变化）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return expr
    if f == 1.0 or expr is None:
        return expr
    s = str(expr).strip()
    if not s or re.search(r"[A-Za-z_]", s):
        return expr
    try:
        return "%g" % (float(s) * f)
    except (ValueError, TypeError):
        return expr


def _pipe_scale_pos_settings(settings, factor):
    """把定位类设置的**绝对像素坐标**从「原始画面空间」换算到「工作分辨率上限缩小后的空间」。

    覆盖键：overlay_x / overlay_y（简易位置基准；纯数值才换算）、move_margin（四角边距）、
    move_waypoints[].x / y（列表轨迹航点，画布绝对像素）。含画布/子尺寸变量（W/H/w/h）的表达式
    由 ffmpeg 在图内按**当前（已缩小的）空间**求值 → 原样保留。factor>=1（含非数值）时
    **原样返回同一对象**：零拷贝、零行为变化。

    三处共用（画中画预览子视频 / 转换页图片水印 / 转换页文字水印）——同一换算只留一份实现，
    避免多处漂移。原 dict 不会被修改（f<1 时先浅拷贝）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return settings
    if f == 1.0 or not settings:
        return settings
    out = dict(settings)
    for _k in ("overlay_x", "overlay_y", "move_margin"):
        if _k in out:
            out[_k] = _pipe_scale_abs_coord(out.get(_k), f)
    _wps = out.get("move_waypoints")
    if isinstance(_wps, list) and _wps:
        _sw = []
        for _w in _wps:
            if not isinstance(_w, dict):
                _sw.append(_w)
                continue
            _w2 = dict(_w)
            for _ax in ("x", "y"):
                if _ax in _w2:
                    _w2[_ax] = _pipe_scale_abs_coord(_w2.get(_ax), f)
            _sw.append(_w2)
        out["move_waypoints"] = _sw
    return out


def _pad_canvas_geometry(main_settings) -> Optional[Tuple[int, int, str, str]]:
    """提取 pad 画布几何：返回 (pad_w, pad_h, offset_x, offset_y) 或 None（未启用/无效）。
    正式命令 + 转换页预览 + 合并页预览三处共用，避免 pad 判定分叉。"""
    if not main_settings.get("pad_enabled", False):
        return None
    pw = (main_settings.get("pad_width", "") or "").strip()
    ph = (main_settings.get("pad_height", "") or "").strip()
    if not pw or not ph:
        return None
    try:
        cw, ch = int(float(pw)), int(float(ph))
        if cw <= 0 or ch <= 0:
            return None
    except (ValueError, TypeError):
        return None
    ox = (main_settings.get("offset_x", "0") or "0").strip() or "0"
    oy = (main_settings.get("offset_y", "0") or "0").strip() or "0"
    return cw, ch, ox, oy

# ================== 子进程执行封装 ==================
def run_ffmpeg_command(cmd: List[str], on_output_line: Optional[Callable] = None, timeout: Optional[float] = None) -> Tuple[int, str]:
    """
    执行 FFmpeg 命令，实时输出行。返回 (返回码, 完整stderr文本)
    cmd: 列表形式的命令参数
    """
    full_output = []
    try:
        proc = subprocess.Popen(cmd, shell=False, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=_ffmpeg_spawn_flags())
        for line in proc.stdout:
            full_output.append(line)
            if on_output_line:
                on_output_line(line)
        proc.wait(timeout=timeout)
        return proc.returncode, "".join(full_output)
    except subprocess.TimeoutExpired:
        proc.kill()
        return -1, "进程超时被终止"
    except Exception as e:
        return -1, str(e)

def ffprobe_json(ffprobe_cmd: str, file_path: str, proc_sink=None) -> Optional[Dict[str, Any]]:
    """调用 ffprobe 获取媒体信息的 JSON 格式。
    proc_sink（可选）：list 容器，创建的 Popen 会追加进去，供调用方 close() 时 kill
    （大文件元数据读取可能比窗口寿命长，不杀会残留 ffprobe 进程）。"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None
    cmd = [ffprobe_cmd, "-v", "error", "-print_format", "json", "-show_streams", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        if proc_sink is None:
            res = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8', errors='replace', creationflags=flags, timeout=10)
            if res.returncode != 0:
                return None
            data = json.loads(res.stdout)
        else:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    creationflags=flags)
            proc_sink.append(proc)
            try:
                out, _err = proc.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                with suppress(Exception):
                    proc.kill()
                with suppress(Exception):
                    proc.communicate()
                return None
            if proc.returncode != 0:
                return None
            data = json.loads(out.decode("utf-8", errors="replace"))
        if "streams" not in data:
            return None
        return data
    except:
        return None

# ================== 入队预检规则 ==================
def _precheck_parse_fps(text):
    """解析 "30000/1001" 形式的帧率为 float；无法解析返回 None"""
    try:
        text = (text or "").strip()
        if not text or text in ("0/0", "N/A"):
            return None
        if "/" in text:
            num, den = text.split("/", 1)
            num, den = float(num), float(den)
            if den == 0:
                return None
            return num / den
        return float(text)
    except Exception:
        return None

def precheck_task_rules(probe, settings, output_path):
    """入队预检（纯函数）：基于 ffprobe streams 信息 + 任务设置，返回风险列表 [(级别, 文案)]。
    级别: "bad"(红/⛔ 硬伤) / "warn"(黄/⚠ 兼容性风险) / "info"(仅详情展示，不计数)。
    probe 为 ffprobe_json() 的返回值（None = 探测失败）；本函数不调用 ffprobe、不碰 UI。
    规则口径（2026-09-08 与用户对齐，6+1 条）：
      🔴 opus/flac 音频 copy 进 MP4/MOV（兼容性差；opus 运行时已自动回退 aac）
      🔴 ffprobe 探测失败 / 时长为 0
      🟡 VFR 源 + 视频流复制（r_frame_rate 与 avg_frame_rate 相差 >5%）
      🟡 SAR≠1 且叠加裁剪/缩放（易拉伸变形）
      🟡 源带旋转元数据 + 手动旋转叠加
      🟡 多音轨（默认仅处理第 1 条）
      ⚪ 输出文件已存在（覆盖策略下将覆盖旧文件）"""
    results = []
    if not probe or not isinstance(probe.get("streams"), list):
        return [("bad", "无法读取媒体信息（ffprobe 失败或文件损坏）")]

    streams = probe["streams"]
    settings = settings or {}
    vstream = next((s for s in streams if s.get("codec_type") == "video"
                    and s.get("disposition", {}).get("attached_pic", 0) != 1), None)
    astreams = [s for s in streams if s.get("codec_type") == "audio"]
    video_copy = settings.get("encoder", "copy") == "copy"
    audio_copy = settings.get("audio_codec", "copy") == "copy"
    only_audio = bool(settings.get("only_audio", False))

    # 🔴 音频编码器 copy 进 MP4/MOV 的硬伤组合（容器以最终输出扩展名为准）
    container = os.path.splitext(output_path or "")[1].lstrip(".").lower()
    if container in ("mp4", "mov") and audio_copy:
        src_codecs = {(s.get("codec_name") or "").lower() for s in astreams}
        if "opus" in src_codecs:
            results.append(("bad", "opus 音频 copy 进 MP4/MOV 兼容性差（转换时将自动回退 aac）"))
        if "flac" in src_codecs:
            results.append(("bad", "flac 音频 copy 进 MP4/MOV，部分播放器不支持"))

    # 🔴 时长为 0（所有流都没有可解析的 duration 时无法判定，不误报，如 mpegts/"N/A"）
    dur_values = []
    for s in streams:
        try:
            dur_values.append(float(s.get("duration")))
        except (TypeError, ValueError):
            pass
    if dur_values and max(dur_values) <= 0:
        results.append(("bad", "媒体时长为 0，文件可能不完整或损坏"))

    # 🟡 VFR + 视频流复制：流复制不改时间戳，VFR 源在部分播放器可能卡顿/音画不同步
    if vstream and not only_audio and video_copy:
        r_fps = _precheck_parse_fps(vstream.get("r_frame_rate"))
        avg_fps = _precheck_parse_fps(vstream.get("avg_frame_rate"))
        if r_fps and avg_fps and abs(r_fps - avg_fps) / avg_fps > 0.05:
            results.append((
                "warn",
                f"源为可变帧率 VFR（r_frame_rate={r_fps:.2f} avg_frame_rate={avg_fps:.2f}），"
                "流复制在部分播放器可能卡顿或音画不同步"
            ))

    # 🟡 非方形像素 SAR≠1 + 裁剪/缩放：crop/scale 按像素数运算，易产生拉伸变形
    if vstream and not only_audio and (settings.get("crop_enabled") or settings.get("scale_enabled")):
        sar = (vstream.get("sample_aspect_ratio") or "").strip()
        if sar and sar not in ("1:1", "0:1", "N/A"):
            results.append(("warn", f"非方形像素 SAR={sar}，叠加裁剪/缩放可能引起拉伸变形"))

    # 🟡 源旋转元数据 + 手动旋转叠加：两处旋转会叠加，最终方向可能与预期不符
    if vstream and not only_audio and settings.get("rotate_enabled") \
            and settings.get("rotate", "none") != "none":
        src_rot = 0
        for sd in (vstream.get("side_data_list") or []):
            try:
                src_rot = int(float(sd.get("rotation") or 0))
                break
            except (TypeError, ValueError):
                continue
        if src_rot % 360 != 0:
            results.append(("warn", f"源自带旋转元数据 {src_rot}°，又叠加手动旋转，最终方向可能与预期不符"))

    # 🟡 多音轨：默认仅处理第 1 条（用户已选「全部」模式则不再警告）
    if len(astreams) > 1 and settings.get("audio_track_mode", "first") == "first":
        results.append(("warn", f"{len(astreams)} 条音轨，默认仅处理第 1 条（其余不保留）"))

    # 🟡 仅音频：编码器×容器不兼容（转码时会自动改容器，提前预告避免困惑）
    if only_audio:
        _ac = settings.get("audio_codec", "aac")
        _pref = settings.get("audio_format", "m4a")
        _safe = compatible_audio_container(_ac, _pref)
        if _safe != _pref:
            results.append((
                "warn",
                f"仅音频：容器 «{_pref}» 与编码器 «{_ac}» 不兼容，转换时将自动改用 «{_safe}»"
            ))

    # ⚪ 输出已存在（rename 策略下路径已去重，命中即意味着会覆盖）
    if output_path and os.path.exists(output_path):
        results.append(("info", "输出文件已存在，转换完成后将覆盖旧文件"))

    return results

def _parse_kbps(text):
    """解析 "5000k"/"128k"/"5M"/"128000" 为 kbps（千比特/秒）；无法解析返回 None。
    裸数字按 ffmpeg 语义视为 bps（-b:v 5000000 = 5Mbps）。"""
    try:
        s = str(text or "").strip().lower()
        if not s:
            return None
        if s.endswith("kbps"):
            return float(s[:-4])
        if s.endswith("k"):
            return float(s[:-1])
        if s.endswith("m"):
            return float(s[:-1]) * 1000.0
        if s.endswith("bps"):
            return float(s[:-3]) / 1000.0
        return float(s) / 1000.0
    except (TypeError, ValueError):
        return None

def _human_size(n_bytes):
    """字节数 → 人类可读（SI 单位：1MB=1e6，1GB=1e9）"""
    if n_bytes >= 1e9:
        return f"{n_bytes / 1e9:.2f}GB"
    if n_bytes >= 1e6:
        return f"{n_bytes / 1e6:.0f}MB"
    return f"{max(1, int(n_bytes / 1e3))}KB"

def estimate_output_size_text(settings, probe):
    """大小预估（#4，纯算术）：视频参与编码时仅限码率模式（rate_control_type=bitrate 且
    encoder 非 copy），计视频项（settings["bitrate_video"]，键名与视频面板 get_settings 一致，
    注意不是 "bitrate"——那是轨道级音频 enc_settings 的键）；crf/cq/视频 copy 码率未知，
    整体不预估。only_audio 模式输出纯音频文件，音频项可单独估算。audio_codec 非 copy 计
    音频项（settings["audio_bitrate"]）。时长取 probe 各流可解析 duration 的最大值。
    返回 "约123MB" 形式文本；算不出一律返回 ""（静默不预估）。
    纯算术不含容器开销，误差通常 ±10% 内。"""
    settings = settings or {}
    vb = 0.0
    if not settings.get("only_audio", False):
        if settings.get("encoder", "copy") == "copy":
            return ""  # 视频流复制：无 -b:v 可算，超出码率预估口径
        if settings.get("rate_control_type", "crf") != "bitrate":
            return ""  # crf/cq/global_quality：码率未知，不预估（2026-09-08 定稿）
        vb = _parse_kbps(settings.get("bitrate_video")) or 0.0
        if vb <= 0:
            return ""  # 码率模式下视频项解析失败 → 预估无意义
    ab = 0.0
    if settings.get("audio_codec", "copy") != "copy":
        ab = _parse_kbps(settings.get("audio_bitrate")) or 0.0
    kbps = vb + ab
    if kbps <= 0 or not isinstance(probe, dict):
        return ""
    dur = 0.0
    for s in probe.get("streams") or []:
        try:
            d = float(s.get("duration"))
            if d > dur:
                dur = d
        except (TypeError, ValueError):
            continue
    if dur <= 0:
        return ""
    return "约" + _human_size(kbps * 1000.0 / 8.0 * dur)

def _deep_scan_decode_errors(ffmpeg_cmd, path, timeout):
    """全解码深扫：`-v error -i x -f null -`，返回去重后的错误行（最多 3 条）。
    只在轻量校验命中疑似后才调用（2026-09-08 与用户对齐的深度档）。"""
    if not ffmpeg_cmd or not os.path.exists(path):
        return []
    cmd = [ffmpeg_cmd, "-v", "error", "-i", path, "-f", "null", "-"]
    try:
        flags = _ffmpeg_spawn_flags()
        res = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8",
                             errors="replace", creationflags=flags, timeout=timeout)
    except subprocess.TimeoutExpired:
        return ["深度扫描超时（文件过大或解码过慢）"]
    except Exception:
        return []
    lines = []
    for ln in (res.stderr or "").splitlines():
        ln = re.sub(r'^\[[^\]]*\]\s*', '', ln.strip())
        if ln and ln not in lines:
            lines.append(ln)
    return lines[:3]

def verify_output_file(ffmpeg_cmd, ffprobe_cmd, output_path, expected_sec):
    """转后校验（#2，轻量档）：输出文件存在/可解析/时长 vs 预期；
    命中疑似才追加全解码深扫。返回疑似原因列表（空 = 通过）。不碰 UI。
    expected_sec 为执行期记录的预期输出时长（task.total_sec，已含变速/分段）；
    0/None 表示无预期，跳过时长比对。"""
    if not output_path or not os.path.exists(output_path):
        return ["输出文件缺失（返回码 0 但没有产物）"]
    try:
        if os.path.getsize(output_path) <= 0:
            return ["输出文件为 0 字节（返回码 0 但没有有效产物）"]
    except OSError:
        return ["输出文件无法读取"]

    probe = ffprobe_json(ffprobe_cmd, output_path)
    if not probe or not isinstance(probe.get("streams"), list):
        return ["输出无法解析（ffprobe 失败，可能不是有效媒体文件）"]

    out_dur = 0.0
    for s in probe["streams"]:
        try:
            d = float(s.get("duration"))
            if d > out_dur:
                out_dur = d
        except (TypeError, ValueError):
            continue
    expected = _opt_float(expected_sec or 0, 0.0)
    issues = []
    if expected > 0 and out_dur > 0:
        if out_dur < expected * 0.98:
            issues.append(f"输出时长 {out_dur:.1f}s 低于预期 {expected:.1f}s（可能截断）")
        elif out_dur > expected * 1.10:
            issues.append(f"输出时长 {out_dur:.1f}s 超出预期 {expected:.1f}s")
    if issues:
        timeout = int(min(900, max(90, expected * 3 + 60)))
        errs = _deep_scan_decode_errors(ffmpeg_cmd, output_path, timeout)
        if errs:
            issues.append(f"深度扫描发现解码错误: {errs[0]}"
                          + (f" 等{len(errs)}处" if len(errs) > 1 else ""))
        else:
            issues.append("时长/元数据异常，深度扫描未发现解码错误")
    return issues

def detect_crop(ffmpeg_cmd: str, input_file: str, timeout: float = 15) -> Optional[Tuple[int, int, int, int]]:
    """自动检测黑边，返回 (w, h, x, y) 或 None"""
    if not ffmpeg_cmd or not os.path.exists(input_file):
        return None
    cmd = [
        ffmpeg_cmd, "-i", input_file,
        "-t", "5",
        "-vf", "cropdetect=limit=0.1:round=2",
        "-f", "null", "-"
    ]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=_ffmpeg_spawn_flags())
        _unused, stderr = proc.communicate(timeout=timeout)
        pattern = re.compile(r'crop=(\d+):(\d+):(\d+):(\d+)')
        matches = pattern.findall(stderr)
        if not matches:
            return None
        w, h, x, y = map(int, matches[-1])
        return w, h, x, y
    except:
        return None

# ================== 播放器预览 ==================
def launch_player(file_path: str, filters: str = "", audio_only: bool = False, volume: int = 10,
                  extra_args: Optional[List[str]] = None,
                  use_mpv: bool = False, mpv_path: str = "mpv", ffplay_path: Optional[str] = None):
    """安全启动播放器预览，列表模式 + 等号参数（兼容 mpv）"""
    file_path = normalize_path(file_path)
    extra_args = extra_args or []

    if audio_only:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-nodisp", "-autoexit", "-volume", str(volume), file_path]
    else:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
            if filters and filters.strip():
                # 与预览分支一致：mpv 用 lavfi=[...] 解析 libavfilter 滤镜图，不再用 lavfi=graph 或裸 --vf
                cmd.append(f"--vf=lavfi=[{filters}]")
            if extra_args:
                cmd.extend(extra_args)
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-i", file_path]
            if filters and filters.strip():
                cmd.extend(["-vf", filters])
            cmd.extend(["-volume", str(volume)])
            if extra_args:
                cmd.extend(extra_args)
            if "-window_title" not in cmd:
                cmd.extend(["-window_title", f"预览: {os.path.basename(file_path)}"])

    flags = _ffmpeg_spawn_flags()
    try:
        _p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=flags)
        _register_preview_proc(_p)
    except Exception as e:
        print(f"预览失败: {e}")

