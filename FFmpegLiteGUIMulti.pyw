        def _clamp(v, lo, hi):
            """Spinbox 允许手输越界值，写回前统一钳制（与 _sync_global_settings 同口径）。"""
            try:
                return max(lo, min(hi, int(v)))
            except (TypeError, ValueError):
                return lo

        def _ok():
            self.ffprobe_parallel.set(_clamp(_fp.get(), 1, 32))
            self.preview_max_w.set(_clamp(_pw.get(), 320, 1280))
            self.preview_max_h.set(_clamp(_ph.get(), 240, 960))
            self.ffprobe_timeout.set(_clamp(_ft.get(), 2, 60))
            self.preview_margin.set(_clamp(_pm.get(), 20, 400))
            self.preview_volume.set(_clamp(_pv.get(), 0, 100))
            # 2026-08-30：上限 / 预览选项（_sync_global_settings 内会再 clamp；互斥由 trace 兜底）
            self.sub_video_preview_max.set(_clamp(_sv.get(), 1, 30))
            self.waypoint_max_rows.set(_clamp(_wr.get(), 1, 9999))
            self.crop_pos_max_rows.set(_clamp(_cr.get(), 1, 9999))
            self.canvas_max_rows.set(_clamp(_cm.get(), 1, 9999))
            self.wp_sendcmd_min_rows.set(_clamp(_ws.get(), 1, 9999))
            self.preview_realtime_speed.set(bool(_rt_speed.get()))
            self.preview_realtime_reverse.set(bool(_rt_rev.get()))
            self.preview_filter_speed.set(bool(_ft_speed.get()))
            # 2026-10-05：位置编辑器「框内真实帧」总开关（下次打开位置编辑器时生效）
            self.editor_real_frame.set(bool(_rf.get()))
            # 2026-10-13：外部播放器预览「原始大小」（下次预览即生效）
            self.preview_original_size.set(bool(_os.get()))
            self.save_output_history_enabled.set(bool(_soh.get()))
            # 2026-09-17：进程优先级 / -threads / 看门狗
            self.proc_priority.set(_prio.get())
            self.threads_count.set(_clamp(_th.get(), 0, 64))
            self.watchdog_minutes.set(_clamp(_wd.get(), 0, 120))
            self.watchdog_autokill.set(bool(_wdk.get()))
            # 2026-09-18：第二批可调项
            self.preview_win_min_w.set(_clamp(_wmw.get(), 600, 2560))
            self.preview_audio_win_min_w.set(_clamp(_waw.get(), 600, 2560))
            self.wave_buckets.set(_clamp(_wb.get(), 500, 8000))
            self.wave_sr.set(_clamp(_wsr.get(), 2000, 48000))
            self.frame_cache_max.set(_clamp(_fc.get(), 0, 64))
            self.fonts_recent_max.set(_clamp(_fr.get(), 0, 100))
            self.stop_grace_q.set(_clamp(_sgq.get(), 1, 120))
            self.stop_grace_term.set(_clamp(_sgt.get(), 1, 60))
            self.info_max_lines.set(_clamp(_iml.get(), 500, 200000))
            self.detail_max_lines.set(_clamp(_dml.get(), 500, 200000))
            self.output_history_max.set(_clamp(_ohm.get(), 1, 100))
            self.sync_max_tracks.set(_clamp(_smt.get(), 2, 16))
            # 2026-10-07：「指定」像素格式的启动默认（trace 自动存盘；下次打开才生效）
            self.pix_fmt_enabled_default.set(bool(_pfmt.get()))
            # 2026-10-17：全局唤回快捷键 → 存盘 + 关窗后重注册（旧组合被停、新组合生效；
            # 新组合被占用则自动回滚旧的，日志给结论）
            self.wake_hotkey_ctrl.set(bool(_hkc.get()))
            self.wake_hotkey_shift.set(bool(_hks.get()))
            self.wake_hotkey_alt.set(bool(_hka.get()))
            self.wake_hotkey_key.set(((_hkk.get() or "").strip().upper()) or "W")
            win.destroy()
            self._more_dlg = None
            self._apply_wake_hotkey()

        def _close():
            win.destroy()
            self._more_dlg = None

        ttk.Button(_btn_row, text=_("取消"), command=_close, width=8).pack(side=tk.RIGHT)
        ttk.Button(_btn_row, text=_("确定"), command=_ok, width=8).pack(side=tk.RIGHT, padx=(0, 6))

        win.protocol("WM_DELETE_WINDOW", _close)
        # 高分屏/低分屏都按实际内容尺寸开窗（不再写死 460x480 导致新项被裁掉）
        win.update_idletasks()
        _sh = win.winfo_screenheight()
        center_window(win, win.winfo_reqwidth(),
                      min(win.winfo_reqheight(), max(320, _sh - 80)))

    def _cleanup_preview_links(self):
        """程序退出时统一清理本次会话创建的临时硬链接（ffmpeg_preview*_cache*，只删链接不删数据）。"""
        for _src, _target in list(_PREVIEW_LINKS.items()):
            with suppress(Exception):
                if os.path.exists(_target):
                    os.unlink(_target)
        _PREVIEW_LINKS.clear()


    def _preview_sub_loop_size(self, s, file_path):
        """预览子视频循环帧数：movie 层只载入（无 loop 参数），由 build_video_filter_chain 的
        loop_size 统一循环。返回 int|None：
        - 未启用截取：全片帧数（整段无限循环显示，替代原来 movie 层 loop=0 的循环）
        - 截取 + once：None（单次截取不循环，chain 内 trim 单次处理）
        - 截取 + 循环：片段帧数（trim 后循环片段，先 trim 再无限 loop）
        - 拿不到帧率/时长 → None（不循环）
        - 静态图片：**恒为 1**（整段就是 1 帧）
        与正式命令 _build_overlay_filter_complex 的循环语义对齐（先 trim 后 loop）。"""
        # 循环模式 once：单次显示，不循环
        if s.get("loop_enabled", False) and s.get("loop_mode") == "once":
            return None
        # 静态图片子视频：整段只有 1 帧 → 循环帧数恒为 1（封装页 / 封面预览同款 size=1 口径）。
        # 为什么必须显式短路：图片的 fps / 时长探测都不可靠（avg_frame_rate 可能是 0/0，
        # format=duration 可能是 N/A / 0.04）→ 探测失败就返回 None = 不循环 → 子视频只出
        # 1 帧「瞬间消失」（用户报的现象）。图片永远有 1 帧可循环，不必探测。
        if self._is_static_image(file_path):
            return 1
        try:
            fps = self._get_video_framerate(file_path)
        except Exception:
            fps = None
        if fps is None or fps <= 0:
            return None
        # 截取时长（trim 片段）或全片时长
        ts = str(s.get("trim_start", "") or "").strip()
        te = str(s.get("trim_end", "") or "").strip()
        ssec = time_to_seconds(ts) if ts else None
        esec = time_to_seconds(te) if te else None
        if s.get("trim_enabled", False) and (ssec is not None or esec is not None):
            d = (esec - ssec) if (esec is not None and ssec is not None and esec > ssec) else None
            if d is None:
                try:
                    # 帧对齐（floor 到源帧格）：loop 缓冲=真实帧数，防回放泄漏闪首帧
                    rd = self._get_media_duration(file_path, frame_align_fps=fps)
                except Exception:
                    rd = None
                if rd is not None:
                    d = rd - (ssec or 0.0)
        else:
            try:
                d = self._get_media_duration(file_path, frame_align_fps=fps)
            except Exception:
                d = None
        if d is None or d <= 0:
            return None
        size = int(round(d * fps))
        if size <= 0:
            return None
        return size

    @staticmethod
    def _is_static_image(path) -> bool:
        """判断是否为静态图片（薄包装，委派给模块级 _is_static_image_file）。"""
        return _is_static_image_file(path)

    def _movie_path_safe(self, path, idx=0):
        """movie 滤镜路径安全化：ffmpeg filtergraph 语法层不支持 [ ] ' , ; 等字符
        （实测无法转义），含特殊字符时在源文件**同目录**创建临时硬链接
        （同盘必成功，不复制；失败则返回原路径）。文件名 ffmpeg_preview{h}_cache{idx}{ext}，
        缓存按源路径复用（重复预览不重复建）；程序退出统一清理。"""
        if not path or not os.path.exists(path):
            return path
        if not re.search(r"[\[\]',;]", path):
            return path
        if path in _PREVIEW_LINKS and os.path.exists(_PREVIEW_LINKS[path]):
            return _PREVIEW_LINKS[path]
        h = hashlib.md5(path.encode("utf-8")).hexdigest()[:12]
        ext = os.path.splitext(path)[1] or ".mp4"
        target = os.path.join(os.path.dirname(path), f"ffmpeg_preview{h}_cache{idx}{ext}")
        try:
            os.link(path, target)
        except OSError:
            return path
        _PREVIEW_LINKS[path] = target
        return target

    def _check_mpv_usable(self) -> bool:
        """检测 mpv 二进制是否真正可用（存在 + 能启动 --version）。

        为什么不用 os.path.isfile/os.access(X_OK)：Windows 下 .exe 的 X_OK 恒真，
        且文件在但缺 DLL/运行库（mpv 同目录 dll 或 VC 运行时）时照样启动失败——
        这类「文件在但用不了」只有实际跑一次才知道。--version 是「mpv 无法使用」
        的最可靠判据（~几十 ms，惰性化后仅在首次预览或路径变更后的首次预览各跑一次）。

        注意边界：这里只判「二进制可用性」。滤镜图错误（--lavfi-complex 报错）是
        mpv 起来之后才发生的运行期错误（进程退出码非零、Popen 不抛异常），
        永远不会走到回退——回退仅由「Popen 抛 OSError（进程起不来）」触发。"""
        raw = self.mpv_path.get().strip()
        if not raw:
            return False
        exe = raw
        if not os.path.isabs(exe):
            # "mpv" 这类裸名按 PATH/PATHEXT 解析（找 mpv.exe）
            found = find_executable(exe) or shutil.which(exe)
            if not found:
                return False
            exe = found
        if not os.path.isfile(exe):
            return False
        try:
            flags = _ffmpeg_spawn_flags()
            r = subprocess.run([exe, "--version"], capture_output=True,
                               timeout=5, creationflags=flags)
            return r.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False

    def _refresh_mpv_flag(self, *args):
        """重算 mpv 可用标志（静态）：启动时 + use_mpv/mpv_path 变更时（trace）调用。
        只做路径级检查（不启动子进程），子进程验证由 _mpv_ready 在首次预览时补齐，
        避免启动时无谓启动 mpv 进程。"""
        if not self.use_mpv.get():
            self._mpv_usable = False
            self._mpv_verified = True    # 关闭状态无需再做子进程验证
        else:
            self._mpv_usable = self._static_mpv_check()
            self._mpv_verified = False   # 路径可能变了，下次预览需重新验证

    def _static_mpv_check(self) -> bool:
        """静态检查 mpv 路径是否可解析（PATH/绝对路径 + 文件存在），不启动进程。"""
        raw = self.mpv_path.get().strip()
        if not raw:
            return False
        exe = raw
        if not os.path.isabs(exe):
            found = find_executable(exe) or shutil.which(exe)
            if not found:
                return False
            exe = found
        return os.path.isfile(exe)

    def _mpv_ready(self, log=True) -> bool:
        """统一入口：use_mpv 开启 且 mpv 二进制可用 → True。
        False 时按需打一条「回退」日志（调用方决定场景：可回退的走 ffplay，
        不可回退的（lavfi-complex 复杂图）自行提示）。
        首次调用（或路径变更后）在此补做子进程级验证——mpv --version 约 100ms，
        只付一次，避免启动时拖慢。"""
        if not self.use_mpv.get():
            return False
        if self._mpv_usable is None or not self._mpv_verified:
            self._mpv_usable = self._check_mpv_usable()
            self._mpv_verified = True
        if not self._mpv_usable and log:
            raw = self.mpv_path.get().strip()
            self._append_info_ui(
                _("[预览] mpv 不可用（{0} 无法启动），已回退 ffplay").format(raw or '未设置'))
        return bool(self._mpv_usable)

    def _retarget_lavfi_labels(self, lavfi_complex, in_label, out_label,
                               drop_amovie=False, require_out=False):
        """mpv --lavfi-complex 图（占位 [VIN]/[VOUT]/[vid1]/[vo]）→ 目标标签体系的重定向。

        2026-09-22 合并：原 `_lavfi_complex_to_ffplay` 与 `_lavfi_complex_to_ffmpeg_pipe`
        是**逐行同构的两份实现**，只差三件事 —— 输入标签名、输出标签名、是否连 amovie=
        混音段一起删（外加管道版要校验输出标签确实存在）。差异全部收成本方法的参数，两处
        调用方只剩一行委托，避免改一处漏一处。

        :param in_label:   主视频输入标签（ffplay "[in]" / ffmpeg 管道 "[0:v]"）
        :param out_label:  末段输出标签（ffplay "[out]" / 管道 "[pv_src]" 等临时标签）
        :param drop_amovie: True 时连含 amovie= 的混音段一并删除（管道只出画面时用）
        :param require_out: True 时输出标签不在结果里就返回 ''（管道靠它判「图不可用」）
        """
        if not lavfi_complex:
            return ""
        g = lavfi_complex.replace("[VIN]", in_label).replace("[vid1]", in_label)
        g = g.replace("[VOUT]", out_label).replace("[vo]", out_label)
        # 音频段整体删除：目标侧的主音轨不在这张视频图里引用（ffplay 随 -i 自动播放、
        # 管道由 SimplePreviewer 的 ffplay 引擎按原文件放）。
        # [amain_pv]/[asw]/[asub]：画中画预览的混音/替换子声段（amovie 源 + amix），
        # ffplay 路线一并删除——子声混音仅 mpv 预览合成，ffplay 退回主音频直放。
        segs = g.split(";")
        kept = [s for s in segs
                if not ("[AIN]" in s or "[AOUT]" in s or "[aid1]" in s or "[ao]" in s
                        or "[amain_pv]" in s or "[asw" in s or "[asub" in s
                        or "[afw" in s or "[afsub" in s
                        or (drop_amovie and "amovie=" in s))]
        g = ";".join(kept)
        if require_out and out_label not in g:
            return ""
        return g

    def _lavfi_complex_to_ffplay(self, lavfi_complex):
        """mpv --lavfi-complex 图（占位 [VIN]/[VOUT]/[vid1]/[vo] 等）→ ffplay -vf 图。

        依据 research/ffplay-preview 真机实测（n9.0.1）：ffplay 的 -vf 就是一条完整 filtergraph，
        支持分号多段图 + [in]/[out] 显式标签 + movie=/amovie= 任意数量额外输入。所以画布、PiP
        （多子视频）、xfade 转场、concat 串行合并、BGM 混音 ffplay 全能出画面，无需 mpv。

        转换规则（README §3 映射表 + §4 机制）：
          - [VIN] 或 [vid1] → [in]（主视频；ffplay 的 -i 输入，固定标签）
          - [VOUT] 或 [vo]  → [out]
          - [AIN]/[AOUT]/[aid1]/[ao] 音频 passthrough 段整体删除：ffplay 主音频由 -i 直接播放，
            无需在 -vf 内引用（删掉后主音轨自动透传；若图内含 amovie= 混音则另行走 -af）。
          - 图内不得出现输入序号标签（[0:v] 等）：ffplay 无 -map，主输入固定 [in]，调用方
            构建时须已用 [VIN]/[vid1] 占位（本文件各预览函数均遵守）。
          - movie=/amovie= 路径沿用调用方已做的盘符冒号转义（C\\:/...，复用 base 5273 口径），
            ffplay 与 mpv 同款转义，无需再处理。
        返回 ffplay 可直接 -vf 的字符串；若转换后为空则返回 ''（调用方应回退普通路径或报错）。
        """
        return self._retarget_lavfi_labels(lavfi_complex, "[in]", "[out]")

    def _lavfi_mix_audio_to_ffplay_af(self, graph):
        """画中画预览图的混音段 → ffplay -af 图（[aid1]→[in]、[ao]→[out]）。

        ffplay 的 -af 与 -vf 同一机制（完整 filtergraph，research/ffplay-preview 实测）。
        此前 ffplay 一律删除混音段、退回主音频直放；真时间轴下子声段占时间轴后半，
        直放 = 用户实测「ffplay 只有第一段声音」。把 [aid1] 主声床 + [asub/asw] amovie
        子声段整体搬进 -af，与 mpv --lavfi-complex 同口径出声。
        返回 '' 表示图内无混音段（调用方走原直放/裁切口径）。"""
        if not graph or "[amain_pv]" not in graph:
            return ""
        _segs = [s for s in graph.split(";")
                 if ("[aid1]" in s or "[amain_pv]" in s
                     or "[asub" in s or "[asw" in s or "[ao]" in s
                     or "[afsub" in s or "[afw" in s)]
        _g = ";".join(_segs).replace("[aid1]", "[in]").replace("[ao]", "[out]")
        if "[in]" not in _g or "[out]" not in _g:
            return ""
        return _g

    def _lavfi_mix_audio_standalone(self, graph, main_file):
        """画中画预览图的混音段 → 独立 lavfi 音频图（管道时间预览引擎用）。

        管道引擎的合成音频走 ffplay -f lavfi（SimplePreviewer._a_start 的 _pipe_audio_graph
        分支），该模式**没有任何外部输入** → 与 _lavfi_mix_audio_to_ffplay_af（ffplay -af，
        主输入 [in]）不同：[aid1] 主声床必须改成 amovie=主文件 自供；子声段本就是 amovie 源，
        原样保留。末标签固定 [ao]，由调用方作 pipe_audio_map 传引擎（引擎在其后接
        atrim=start=at 精定位，与串行合并管道音频同口径）。
        返回 '' 表示图内无音频段（调用方不传，引擎回退直读主文件音轨）。"""
        if not graph or ("[amain_pv]" not in graph and "[aid1]" not in graph):
            return ""
        _segs = [s for s in graph.split(";")
                 if ("[aid1]" in s or "[amain_pv]" in s
                     or "[asub" in s or "[asw" in s or "[ao]" in s
                     or "[afsub" in s or "[afw" in s)]
        if not _segs:
            return ""
        _esc = self._movie_path_safe(main_file).replace("\\", "/").replace(":", "\\\\:")
        _out = []
        for _s in _segs:
            if "[aid1]" in _s:
                _out.append(f"amovie={_esc}[pv_amsrc]")
                _out.append(_s.replace("[aid1]", "[pv_amsrc]"))
            else:
                _out.append(_s)
        _g = ";".join(_out)
        if "[ao]" not in _g:
            return ""
        return _g

    def _lavfi_complex_to_ffmpeg_pipe(self, lavfi_complex, src_label="pv_src"):
        """预览复杂图（[VIN]/[VOUT]/[vid1]/[vo] 占位）→ SimplePreviewer 管道用 -filter_complex 图。

        与 _lavfi_complex_to_ffplay 的区别：ffplay 用 -vf（主输入是固定标签 [in]/[out]），
        而 ffmpeg 管道用 -filter_complex + -map，主输入标签是 [0:v]，末段输出改成一个临时
        标签（默认 [pv_src]），由调用方（SimplePreviewer._launch_video_pipe）追加预览缩放
        后再映射。转换规则：
          - [VIN] / [vid1] → [0:v]（外部 -i 主输入，ffmpeg 的输入流标签）
          - [VOUT] / [vo]  → [src_label]（占位，调用方接 scale/pad/fps 后 -map）
          - 音频段整体删除：含 [AIN]/[AOUT]/[aid1]/[ao] 的段，以及 amovie= 混音段——
            管道只输出画面，音频由 SimplePreviewer 的 ffplay 引擎按原文件播放。
          - ⚠️ 本函数【不做 seek 对齐】：图内 movie= 子输入不吃命令行 -ss，多输入图 seek 后
            会与主输入错位（见 research/preview/README1.md 修正表 #2）→ 调用方必须在**【单输入】
            场景**才启用本管道（转换页水印/裁剪/变速/旋转/画布、合并页单视频轨）。
        返回可直接 -filter_complex 的字符串；'' 表示不可用（图内无视频输出段）。"""
        return self._retarget_lavfi_labels(
            lavfi_complex, "[0:v]", "[%s]" % src_label,
            drop_amovie=True, require_out=True)

    def preview_with_player(self, input_path, filters=None, audio_only=False, volume=None,
                            extra_args=None, start_time=None, duration=None,
                            lavfi_complex=None, mpv_only_args=None,
                            image_duration=None, lavfi_input=None, precise_seek=False):
        """
        启动播放器预览
        :param start_time: 起始时间（秒或时间字符串），仅 ffplay 使用，mpv 通过 extra_args 传递 --start
        :param duration: 播放时长（秒），仅 ffplay 使用
        :param filters: 普通 -vf 链（mpv 用 --vf=lavfi=[...] 包装，ffplay 直接 -vf）。
        :param lavfi_complex: mpv 复杂图（如文字水印旋转/轨迹/画布/PiP），用 --lavfi-complex= 传递
               （与 -vf 互斥）。占位标签：[VIN]/[vid1]=视频输入 [AIN]/[aid1]=音频输入(可选)
               [VOUT]/[vo]=视频输出 [AOUT]/[ao]=音频输出(可选)。mpv 不可用（本机常无 mpv）时，
               经 _lavfi_complex_to_ffplay 改写成 ffplay -vf 分号多段图（[VIN]→[in]、[VOUT]→[out]、
               音频 passthrough 段删除），ffplay 同样能出合成画面——不再是「只播原始画面」。
               实测参见 research/ffplay-preview：ffplay 的 -vf 即为完整 filtergraph。
        :param mpv_only_args: 仅 mpv 生效的播放器参数（如 --speed / --play-direction=backward，
               实时变速/倒放预览用）。回退 ffplay 时自动丢弃并打一条提示日志。
        :param precise_seek: 精确优先（2026-10-13 用户拍板）。**只给「图内没有绝对 trim 可吸收
               关键帧偏移」的调用方用**（转换页普通预览 / 封装页单体预览）：mpv 强制
               `--hr-seek=yes --hr-seek-framedrop=no`；ffplay 因 `-ss` 本身就只落关键帧，改为把
               偏移交给**图内绝对 `trim=start=S`** 吸收（帧戳不归零 ⇒ 滤镜 t 仍是原始时间，
               语义不变）。默认 False = 完全旧行为（封装页实时预览 lavfi 图不可传）。
        """
        # 精确优先分流（2026-10-13）：**唯一决策源 = 统一 Seek 模型**（research/seek-model）。
        # 「player_preview」场景 = 外部播放器 seek：图内已有绝对 trim 的（封装页实时预览）
        # 偏移天然被吸收，保持旧口径（P-）；没有的必须走精确口径（P+），否则预览从**最近的
        # 关键帧**起播（实测：目标 21.0 落 20.0；ffplay 的 -ss 是单一全局选项，-i 前后等价、
        # 双 -ss 不成立 ⇒ 只能靠图内 trim 吸收）。判据收进 `_pv_seek_plan`，本处不再自写 if。
        _pv_plan = _pv_seek_plan("player_preview", start_time,
                                 {"graphs": (lavfi_complex, filters), "precise": precise_seek})
        _precise_seek = _pv_plan.precise
        # 音量：单一参数（更多设置 → 预览音量，默认 10）。调用方不再各自写死 10/30 ——
        # 传 None 即用当前设置值（2026-09-21 统一）。
        if volume is None:
            try:
                volume = int(self.preview_volume.get())
            except Exception:
                volume = 10
        volume = max(0, min(100, int(volume)))
        file_path = normalize_path(input_path)
        # 2026-10-09：颜色虚拟源按**正常输入**接入默认预览路径（与普通视频轨共用同一套
        # mpv/ffplay 选择、屏幕自适应缩放、占位框）。转换只发生在此一处（真正的「源头」），
        # 各调用方不必再各自特判：
        #   · mpv    → 位置输入 `av://lavfi:<spec>`（见 _virtual_mpv_input 真机实测说明）；
        #   · ffplay → `-f lavfi -i <spec>`（下方 lavfi_input 分支，既有路径）。
        _color_in = (not audio_only) and _is_virtual_source(file_path)
        if _color_in and not lavfi_input:
            lavfi_input = _virtual_lavfi_spec(file_path) or None
        # 【mpv/ffplay 回退路径】复杂图内视频 movie= 子输入注入各自 trim 起点的 seek_point
        # （与管道引擎同效、纯解码跳过优化、输出逐字节不变）。仅当图含 `movie=X[L];[L]trim=start=S`
        # 才生效，图片/无 trim 子输入自动跳过，零回归。mpv(--lavfi-complex) 与 ffplay(-vf) 共用
        # 同一 lavfi_complex，注入一次即两路同时受益。
        if lavfi_complex:
            lavfi_complex = SimplePreviewer._inject_movie_seek_point_per_sub(lavfi_complex)
        extra_args = extra_args or []
        used_mpv = False  # 记录本次实际走了 mpv（Popen 异常兜底回退时用）

        def _build_mpv():
            player = self.mpv_path.get().strip() or "mpv"
            # 颜色虚拟源：位置输入改 av://lavfi:<spec>（真机实测可播且保 alpha；裸哨兵 /
            # lavfi: / ffmpeg://lavfi: 一律 exit 1）。解析失败退回原串（让 mpv 自己报错，
            # 至少不再静默错播）。
            c = [player, (_virtual_mpv_input(file_path) or file_path) if _color_in else file_path]
            if not audio_only:
                _fit_vf = ""
                if lavfi_complex:
                    # 复杂图（文字水印旋转等）：占位标签 → mpv 约定标签（音频输入是 aid1）
                    lc = lavfi_complex.replace("[VIN]", "[vid1]").replace("[AIN]", "[aid1]")
                    lc = lc.replace("[VOUT]", "[vo]").replace("[AOUT]", "[ao]")
                    c.append(f"--lavfi-complex={lc}")
                elif filters:
                    # 使用 lavfi=[...] 语法（mpv 官方推荐），不再需要 graph= 与额外的引号转义；
                    # mpv 会直接解析 [...] 内的滤镜图，filters 本身无需再做 shell/转义处理。
                    c.append(f"--vf=lavfi=[{filters}]")
                else:
                    # 纯净源（分段预览/段落条外部播放/时间分配预览等，无滤镜图）：屏幕适配 ——
                    # 与带图预览经 _append_fit_scale 注入 scale 同口径、同 --vf=lavfi=[...] 形式
                    # （margin=100，超屏则保比例缩到屏幕内、只缩不放）。取缓存源尺寸算偶数化
                    # tw:th，并加 format=yuv420p 与带图预览一致（如 --vf=lavfi=[format=yuv420p,scale=562:1000]）。
                    # 2026-10-13：勾选「原始大小」⇒ 跳过屏幕适配，mpv 窗口按原始尺寸开。
                    _sw = self.root.winfo_screenwidth()
                    _sh = self.root.winfo_screenheight()
                    _mw, _mh = _sw - 100, _sh - 100
                    _vw, _vh = self._get_video_dimensions_cached(file_path)
                    if self._preview_fit_enabled() and _vw and _vh and (_vw > _mw or _vh > _mh):
                        _sc = min(_mw / _vw, _mh / _vh)
                        _tw = int(_vw * _sc); _th = int(_vh * _sc)
                        _tw = _tw if _tw % 2 == 0 else _tw - 1
                        _th = _th if _th % 2 == 0 else _th - 1
                        _tw = max(_tw, 2); _th = max(_th, 2)
                        _fit_vf = f"format=yuv420p,scale={_tw}:{_th}"
                if _fit_vf:
                    c.append(f"--vf=lavfi=[{_fit_vf}]")
            if start_time is not None:
                c.append(f"--start={start_time}")
                if (lavfi_complex or filters) and not _precise_seek:
                    # 【秒开】关掉 hr-seek（mpv 精确 seek）。原因（research/mpv-seek §8 实测）：
                    # 预览图是「主/子各经 trim=start=S,setpts=PTS-STARTPTS 归零」的 0 基模型，
                    # 而 mpv --start=S 的时钟仍从 S 起 ⇒ 输出与时钟错位，mpv 必须**先把 S 秒的
                    # 滤镜输出消耗掉**才显示首帧（实测 S=285：1.97s；且首帧画面本身是错的——
                    # 主链先 EOF 定格段末、子画面被拉到素材第 285 秒）。
                    # 关掉 hr-seek 后 mpv 落到关键帧即出画、不再等精确时刻，而图内 trim 会精确
                    # 裁掉「关键帧→S」⇒ **画面仍准**：首帧 1.97s→0.29s，且与「不 seek 的正确
                    # 渲染」首帧 MD5 完全相同。仅随 --start 一起加（不 seek 的预览零变化）。
                    c.append("--hr-seek=no")
                else:
                    # 纯净源 seek（分段预览等：不带滤镜图、无图内 trim 兜底）：必须精确 seek，
                    # 否则 mpv 落到关键帧、相邻片段全从同一关键帧起播（最多偏一个 GOP）。
                    # 与 _preview_segments_edl 同口径（那里也已用 --hr-seek=yes）。
                    c.append("--hr-seek=yes")
                    c.append("--hr-seek-framedrop=no")
            if duration is not None:
                c.append(f"--length={duration}")
            if image_duration is not None and _is_static_image_file(file_path):
                # 图片主视频：按用户「显示时长」停留 N 秒。
                # 关键分支：若 lavfi_complex 已被 wrap_image_static_timed_complex 改写
                # （含 [cd_base] 连续基源，使 [v0] 变连续流），则必须用 --length 驱动播放，
                # 绝不能再用 --image-display-duration —— 后者只让单帧停留 N 秒，复杂图时间变量
                # t 仍卡死，倒计时/轨迹/旋转不动（即用户最初报告的现象）。这精确镜像用户
                # 已验证可用的 fade 命令：color r=d + --length，连续基源作主时间轴。
                # 未改写的图片+复杂图（如画布图，首节点非 [VIN]{base_vf}[v0]）保持原行为。
                if lavfi_complex and "[cd_base]" in lavfi_complex:
                    c.append(f"--length={image_duration:g}")
                else:
                    c.append(f"--image-display-duration={image_duration:g}")
            if mpv_only_args:
                c.extend(mpv_only_args)
            if extra_args:
                c.extend(extra_args)
            return c

        def _build_ffplay():
            if not self.ffplay_cmd:
                return None
            if audio_only:
                c = [self.ffplay_cmd, "-nodisp", "-autoexit", "-volume", str(volume)]
                if start_time is not None:
                    c.extend(["-ss", str(start_time)])
                if duration is not None:
                    c.extend(["-t", str(duration)])
                if image_duration is not None and _is_static_image_file(file_path):
                    # 图片（无音轨）按显示时长限输入时长，纯防御（图片不会走 audio_only 预览）
                    c.extend(["-t", f"{image_duration:g}"])
                c.append(file_path)
            else:
                c = [self.ffplay_cmd]
                # 图片主视频：无时间轴可言 —— -ss 只会取到空帧（图片素材 seek 无意义），
                # 截取派生时长也不能拿来限输入时长（图片 ffprobe 只有 ~0.04s / N/A）。
                # 时长统一由「图片显示时长」走下面的 -t + 图内 trim 收尾（对齐 mpv --image-display-duration）。
                _img_main = image_duration is not None and _is_static_image_file(file_path)
                _has_graph = bool(lavfi_complex or filters)
                _fit_vf = ""
                if not _img_main and not _has_graph:
                    # 纯净源（分段预览等，无滤镜图）：屏幕适配 —— 与 _append_fit_scale 同口径。
                    # 取缓存源尺寸（带缓存、零额外开销），超屏则保比例缩到屏幕内、偶数化、只缩不放。
                    # 2026-10-13：勾选「原始大小」⇒ 跳过屏幕适配，ffplay 窗口按原始尺寸开。
                    _sw = self.root.winfo_screenwidth()
                    _sh = self.root.winfo_screenheight()
                    _mw, _mh = _sw - 100, _sh - 100
                    _vw, _vh = self._get_video_dimensions_cached(file_path)
                    if self._preview_fit_enabled() and _vw and _vh and (_vw > _mw or _vh > _mh):
                        _sc = min(_mw / _vw, _mh / _vh)
                        _tw = int(_vw * _sc); _th = int(_vh * _sc)
                        _tw = _tw if _tw % 2 == 0 else _tw - 1
                        _th = _th if _th % 2 == 0 else _th - 1
                        _tw = max(_tw, 2); _th = max(_th, 2)
                        _fit_vf = f"format=yuv420p,scale={_tw}:{_th}"
                if start_time is not None and not _img_main and _has_graph:
                    c.extend(["-ss", str(start_time)])   # 滤镜图：输入级 -ss（图内 trim 兜底）
                if duration is not None and not _img_main and _has_graph:
                    c.extend(["-t", str(duration)])      # 滤镜图：输入级 -t
                if _img_main:
                    # 循环交给【图内 loop 滤镜】（下方 ffplay_image_main_vf）：
                    # ffplay 的 -loop 1 对 image2 实测无效（1 帧即退，0.64s）。
                    c.append("-autoexit")
                if lavfi_input:
                    c.extend(["-f", "lavfi", "-i", lavfi_input])
                else:
                    c.extend(["-i", file_path])
                if start_time is not None and not _img_main and not _has_graph:
                    # 纯净源精确 seek：输出级 -ss（解码丢弃到目标帧，帧级精确，不靠关键帧对齐）。
                    # 分段预览相邻片段不会再落到同一关键帧；输入级 -ss 无图内 trim 兜底会偏一个 GOP。
                    c.extend(["-ss", str(start_time)])
                if duration is not None and not _img_main and not _has_graph:
                    c.extend(["-t", str(duration)])      # 输出级时长（从 seek 点起算）
                if _img_main:
                    # 输出级 -t 限制播放时长（N 秒后 EOF → autoexit 关窗）
                    c.extend(["-t", f"{image_duration:g}"])
                _vf_val = ""
                if lavfi_complex:
                    # mpv 不可用时的复杂图回退：转 ffplay -vf 分号多段图。
                    # 研究 ffplay-preview 实证：画布/文字水印旋转/图片水印真实合成/PiP/串行合并
                    # 全都能出合成画面，不再是「只播原始画面」。
                    _vf_val = self._lavfi_complex_to_ffplay(lavfi_complex)
                    if _vf_val:
                        self._append_info_ui(
                            _("[预览] 复杂图经 ffplay -vf 回退渲染（合成画面，非原始画面）"))
                    else:
                        self._append_info_ui(
                            _("[预览] 复杂图转 ffplay -vf 失败，已回退原始画面"))
                        _vf_val = filters or ""
                elif filters:
                    _vf_val = filters
                elif _fit_vf:
                    _vf_val = _fit_vf
                if _precise_seek and start_time is not None:
                    # 精确优先（ffplay）：ffplay 的 -ss **只落关键帧**（实测目标 21.0 → 20.0），
                    # 且 -ss 是单一全局选项（-i 前后等价、双 -ss 不成立）⇒ 唯一精确手段 = 把
                    # 偏移交给**图内绝对 trim=start=S** 吸收。**不加 setpts**：帧戳保持绝对值
                    # ⇒ 下游滤镜的 t 仍是原始时间（与旧「无 trim/setpts」预览同语义，crop 的
                    # t 表达式/enable 窗口不受影响）。放在链首 ⇒ 关键帧→S 的帧先被丢掉、不空跑。
                    _vf_val = ("trim=start=%s" % _ffsec(float(start_time))
                               + (("," + _vf_val) if _vf_val else ""))
                if _vf_val:
                    if _img_main:
                        # 图片主视频：图首注入 loop=loop=-1:size=1（无限流）+ 图尾 trim=0:N 收尾
                        # → -autoexit 转为等【输出】结束，窗口不再 1 帧就消失。见函数 docstring。
                        _looped = ffplay_image_main_vf(_vf_val, image_duration)
                        if _looped != _vf_val:
                            self._append_info_ui(
                                _('[预览] 图片主视频：图内 loop 单帧 + 末端 trim=0:{0:g} 收尾（ffplay 的 -loop 1 对图片无效）').format(image_duration))
                        else:
                            self._append_info_ui(
                                _("[预览] 图片主视频：滤镜图无 [in] 占位，无法注入 loop 前缀"
                                "（可能只显示 1 帧）"))
                        _vf_val = _looped
                    c.extend(["-vf", _vf_val])
                c.extend(["-volume", str(volume)])
                _extra = list(extra_args) if extra_args else []
                if _precise_seek and start_time is not None:
                    # 音频同步精确起点：图内 trim 只裁视频，音频不同步裁会把 A/V 起点拉开
                    # (S−K)（K=原生 seek 落的关键帧）⇒ 开头 (S−K) 秒只闻声不见画。
                    # 合并进既有 -af（不能新加一条：后一条会顶掉前一条，如音频变速 atempo）。
                    _at = "atrim=start=%s" % _ffsec(float(start_time))
                    _merged = False
                    for _i in range(len(_extra) - 1):
                        if _extra[_i] == "-af":
                            _extra[_i + 1] = ((_at + "," + _extra[_i + 1])
                                              if _extra[_i + 1] else _at)
                            _merged = True
                            break
                    if not _merged:
                        _extra = ["-af", _at] + _extra
                if _extra:
                    c.extend(_extra)
                if "-window_title" not in c:
                    if lavfi_input:
                        c.extend(["-window_title", _("预览: 颜色虚拟源")])
                    else:
                        c.extend(["-window_title", _('预览: {0}').format(os.path.basename(file_path))])
            return c

        # 颜色源虽设了 lavfi_input（给 ffplay 用 -f lavfi -i），但 mpv 侧走 av://lavfi: 位置
        # 输入完全可用 ⇒ 不因 lavfi_input 就禁用 mpv（否则又变成「颜色只能 ffplay」）。
        if self._mpv_ready() and (not lavfi_input or _color_in):
            cmd = _build_mpv()
            used_mpv = True
        else:
            cmd = _build_ffplay()
            if cmd is None:
                self._append_info_ui(_("未找到 ffplay，无法预览。"))
                return
            if mpv_only_args:
                self._append_info_ui(_("[预览] 实时变速/倒放预览仅 mpv 支持，当前用 ffplay，已忽略。"))

        self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
        # 研究 §4.7：ffplay 滤镜图（复杂图/-vf）出错 rc 仍 0，Popen 不抛异常、拿不到失败信号，
        # 故 _spawn_player_stderr_scan 落 stderr 到临时文件、进程退出后回读扫错。
        # 仅 ffplay 路径（非 mpv）需要扫；mpv 走 lavfi-complex 保留原行为（stderr 丢弃）。
        _has_vf = lavfi_complex is not None or filters is not None
        _proc = self._spawn_player_stderr_scan(cmd, scan_ffplay=(not used_mpv and _has_vf))
        if _proc is None and used_mpv:
            # 兜底：标志检测后 mpv 仍可能被删/移动（竞态）——Popen 抛 OSError 说明
            # 进程根本起不来（=mpv 不可用），置标志并回退 ffplay。
            # 注意：滤镜图错误时 mpv 进程能启动、只是退出码非零，Popen 不抛异常，
            # 永远不会进到这里（滤镜错误绝不回退）。
            self._mpv_usable = False
            self._mpv_verified = True   # 已实测失败，后续预览直接回退不再重试子进程
            raw = self.mpv_path.get().strip()
            _e = getattr(self, "_last_spawn_err", None)
            self._append_info_ui(_('[预览] mpv 启动失败（{0}）：{1}，已回退 ffplay').format(raw, _e))
            fb = _build_ffplay()
            if fb is None:
                self._append_info_ui(_("未找到 ffplay，无法预览。"))
                return
            if lavfi_complex and not audio_only:
                self._append_info_ui(_("[预览] 提示：原预览为 mpv 复杂图（lavfi-complex），"
                                     "已改写为 ffplay -vf 渲染合成画面（ffplay 的 -vf 即完整 filtergraph，"
                                     "实测支持画布/PiP/串行合并/水印合成）。"))
            if mpv_only_args and not audio_only:
                self._append_info_ui(_("[预览] 实时变速/倒放预览仅 mpv 支持，回退后已忽略。"))
            self._append_info_ui(_("执行命令: ") + format_cmd_for_display(fb))
            self._spawn_player_stderr_scan(fb, scan_ffplay=_has_vf)

    def _reap_prev_preview_player(self):
        """结束「上一次预览启动的」播放器进程（mpv / ffplay）。

        为什么需要（2026-09-20 用户报「重音」）：视频预览的 ffplay 不带 -autoexit
        （播完停在末帧、窗口常开由用户自行关闭），mpv 同理 —— 窗口会一直留着。
        此时再点一次预览就变成**两个播放器同时出声** → 听到重音。画布/画中画这类
        需要反复调参的场景会连点多次，最明显。

        ⚠️ 只结束本程序上一次预览自己启动的进程：绝不按进程名全量 taskkill
        （用户可能另外开着独立播放器）。进程可能已自然退出/句柄失效 → 静默忽略。
        """
        _p = getattr(self, "_preview_player_proc", None)
        self._preview_player_proc = None
        if _p is None:
            return
        with suppress(Exception):
            if _p.poll() is None:
                _p.terminate()

    def _spawn_player_stderr_scan(self, cmd, scan_ffplay=False):
        """启动播放器并（按需）捕获 stderr 回读扫错。

        研究 ffplay-preview §4.7：ffplay 的滤镜图（复杂图 / -vf）出错时**进程退出码仍为 0**
        （mpv 同样静默），subprocess.Popen 永不抛异常、也拿不到失败信号——单看 rc 会误判成功。
        所以必须落 stderr 到临时文件、等进程退出后回读扫错，才能发现「合成画面实际没渲染出来」。

          - 正常播放（无错）：进程随窗口关闭而退，守护线程自然结束，无提示。
          - 滤镜图错误：ffplay 立即退出（rc=0），线程读回 stderr 命中错误标记 → 打提示日志。
          - 守护线程：长播放下挂起无害，不阻塞主线程、不拦窗口。
          - 临时文件（非 PIPE）：Windows 跨进程安全，避免 PIPE 缓冲撑爆导致子进程卡死。

        :param scan_ffplay: True 时扫 stderr 命中即提示（仅 ffplay 走 -vf 的复杂图风险路径需要）；
                            mpv lavfi-complex 分支不扫（保留原行为，stderr 直接丢弃）。
        :return: Popen 对象；进程根本起不来（OSError）时返回 None 并记 self._last_spawn_err。
        """
        flags = _ffmpeg_spawn_flags()
        self._last_spawn_err = None
        # 开新预览前先关掉上一次预览的播放器（防两个播放器同时出声 = 用户报的「重音」）。
        self._reap_prev_preview_player()

        def _spawn(_cmd, **_kw):
            """Popen 后登记句柄：下一次预览启动前由 _reap_prev_preview_player 关闭。"""
            _p = subprocess.Popen(_cmd, creationflags=flags, **_kw)
            self._preview_player_proc = _p
            _register_preview_proc(_p)
            return _p

        if not scan_ffplay:
            try:
                return _spawn(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                self._last_spawn_err = e
                self._append_info_ui(_('预览失败: {0}').format(e))
                return None
        # 需要扫 stderr：落临时文件（Windows 跨进程安全）
        try:
            _fh = tempfile.NamedTemporaryFile(
                mode="w", suffix=".ffplay.err", delete=False,
                encoding="utf-8", errors="replace")
            _path = _fh.name
            _fh.close()
        except Exception:
            try:
                return _spawn(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                self._last_spawn_err = e
                self._append_info_ui(_('预览失败: {0}').format(e))
                return None
        try:
            _stderr_fh = open(_path, "w", encoding="utf-8", errors="replace")
            proc = _spawn(cmd, stdout=subprocess.DEVNULL, stderr=_stderr_fh)
            _stderr_fh.close()   # 父本句柄关闭；子进程已继承自身 fd，不受影响
        except Exception as e:
            self._last_spawn_err = e
            self._append_info_ui(_('预览失败: {0}').format(e))
            return None
        _markers = ("Error processing filtergraph", "No such filter",
                    "Error reinitializing filters", "Failed to configure",
                    "Cannot find a matching stream", "Option not found",
                    "Invalid argument")
        _pp = _path

        def _watch():
            with suppress(Exception):
                proc.wait()
            try:
                with open(_pp, "r", encoding="utf-8", errors="replace") as fh:
                    _txt = fh.read()
            except Exception:
                return
            if any(m in _txt for m in _markers):
                _snip = _txt.strip()
                if _snip:
                    _snip = _snip[-800:]
                self._append_info_ui(
                    _("[预览] ffplay 滤镜图可能出错（进程退出码为 0，但 stderr 含错误，"
                    "合成画面可能未渲染，请改用 mpv 或检查滤镜参数）：\n") + _snip)
            with suppress(Exception):
                os.remove(_pp)
        threading.Thread(target=_watch, daemon=True).start()
        return proc

    def _preview_fit_enabled(self):
        """外部播放器预览的「屏幕适应缩放」总开关（2026-10-13，更多设置 → 预览窗口 → 原始大小）。

        返回 True = 做屏幕适配（默认，现状行为）：画面超过屏幕可用区（屏幕 − 预览屏幕边距）
        时按比例缩小到屏幕内；返回 False = 勾选了「原始大小」，不做任何屏幕适配缩小。

        ⚠️ 作用域＝**外部播放器（mpv / ffplay）预览窗口**，共 5 处直接调用点（4 组路线）：
          ① _preview_with_settings 的 scale_expr（_fit_on；管道分支恒 True，走内置窗口不受影响）
          ② _canvas_fit_scale（画布模式预览，由 ① 把 _fit_on 当 fit= 传进来，不在本函数内读开关）
          ③ merge_preview_track 的 scale_filter（合并页单轨预览，末端喂 preview_with_player）
          ④ preview_with_player 纯净源：mpv --vf 适配 + ffplay -vf 适配（各一处）
          ⑤ _ffplay_fit_scale 的 -x/-y（合并页实时预览的 ffplay 窗口尺寸）
        ⛔ 不归它管的（都是「窗口内部」尺寸，不是屏幕适配）：
          · 内置时间预览窗口 —— 按 preview_max_w/h 与管道工作分辨率上限 _PIPE_WORK_MAX_W 缩放；
          · 快照窗口 —— _append_fit_scale（画中画/水印/拼图）。
        """
        try:
            return not bool(self.preview_original_size.get())
        except Exception:
            return True

    def _canvas_fit_scale(self, cw, ch, fit=True):
        """画布预览屏幕自适应缩放（保持比例、偶数化），返回 scale=W:H 或 ''。

        fit=False（更多设置勾选「原始大小」，仅外部播放器预览路线传 False）＝ 直接返回 ''，
        画布图不追加屏幕适配 scale，窗口按画布原始尺寸打开。
        """
        if not fit:
            return ""
        try:
            cw = int(round(float(cw))); ch = int(round(float(ch)))
        except (ValueError, TypeError):
            return ""
        if cw <= 0 or ch <= 0:
            return ""
        try:
            margin = self.preview_margin.get()
        except Exception:
            margin = 80
        max_w = self.root.winfo_screenwidth() - margin
        max_h = self.root.winfo_screenheight() - margin
        if max_w <= 0 or max_h <= 0:
            return ""
        if cw <= max_w and ch <= max_h:
            return ""
        scale = min(max_w / cw, max_h / ch)
        tw = int(cw * scale); th = int(ch * scale)
        tw = tw if tw % 2 == 0 else tw - 1
        th = th if th % 2 == 0 else th - 1
        if tw < 2: tw = 2
        if th < 2: th = 2
        return f"scale={tw}:{th}"

    def _open_pipe_time_preview(self, file_path, settings, lavfi_complex_str,
                                filter_chain, start_sec=None, duration=None,
                                aspect=None, out_dur=None, out_start=0.0,
                                pipe_audio_graph=None, pipe_audio_map=None,
                                extra_kw=None, pipe_alpha=None):
        """「时间预览引擎」入口（2026-09-20 Phase 1）：把预览合成图喂给内置时间预览窗口。

        与其它预览入口的区别：不启动 mpv/ffplay，而是用 ffmpeg -filter_complex 渲染合成画面
        → rawvideo 管道 → SimplePreviewer 显示。因此**保留标记 / 波形 / 逐帧步进 / 循环预览 /
        A-V 仲裁**这些内置交互，且零外部播放器依赖。

        多输入口径（2026-09-20 Phase 2 开放 + 当日二次修正）：图内 movie= 子输入不吃命令行 -ss，
        故 _launch_video_pipe 按「子视频时间 = 主视频时间 − pipe_start」处理每个视频类 movie=：
        **优先改写成外部 `-ss -i` 输入**（`_rewrite_movie_inputs`）→ 子输入也吃输入级 `-ss`，
        与主输入同为帧精确；只有改不到的（静态图片 / 路径还原失败 / `[N:v]` 标签撞车）才退回
        `seek_point` 近似（`_inject_movie_seek_point`，向后关键帧 seek、误差可达一个 GOP）。
        两者都与正式导出口径一致（成片里主从 pipe_start 起算、子从 0 起算）。

        aspect：合成图【真实输出】画面比（宽/高）。不传时预览框按源文件比例算 —— 而 split
        平铺网格 / 画布 / 裁剪的合成尺寸常≠源尺寸 → 画面框比例错，图被 letterbox 后看着
        「没铺满」（用户实测：2 格平铺时最明显）。故多输入路径必须下传真实比例。

        out_dur / out_start：**输出时间轴**模式的时长与起点（目前仅串行合并用）。串行合并的图是
        「输出时间轴」（多段 + xfade），与素材时间轴锚点不同，不能用素材时间轴 seek，故走
        「输出侧 trim」：拖动时从头解码到目标点再显示（正确但 seek 慢）。

        extra_kw（2026-10-08，#1 列表轨迹时间预览接管道入口）：调用方（列表轨迹弹窗经宿主
        `pipe_preview_cb`）下传的**额外 show_time_picker 参数**（标记段 / mark_rows /
        on_mark_edit / on_coord_request / on_send_waypoints / on_set_start / on_set_end）。
        合并顺序 = extra_kw 先行、本函数的管道参数覆盖 —— 保证图/通道语义不被调用方误改，
        调用方只补「窗口交互」类参数。缺省 None ⇒ 与旧行为逐字节一致。
        其中 `_parent_win`（列表轨迹场景专有）= 预览窗父窗（轨迹弹窗），本函数 pop 出去当
        show_time_picker 的第一参数；缺省回 `self.root` —— 其余入口（右键实时预览 / 时间
        预览引擎）不带此键，行为逐字节不变。
        pipe_alpha（2026-10-12）：**None = 自动判**（推荐）——按 `settings`（主视频设置）是否
        产生 alpha ⇒ `_settings_needs_alpha`（绿幕抠像 / 遮罩 / 描边 / 透明度<1.0），另加虚拟源
        自带透明底（`_virtual_output_info`，口径同 `build_seek_frame_cmd` 的 main_alpha）。
        ⛔ 子视频自身的 alpha 不算（它叠在不透明主画布上，最终合成不透明 ⇒ 透出的该是主画面
        而非棋盘）。给 True/False = 调用方显式覆盖「设置口径」的结论。
        ⚠️ 自动判是「**主视频设置**」口径 —— 只有**主视频决定合成是否透明**的模式（转换页 / 普通
        画中画）适用。以下两个入口**显式下传**（判据更宽，见各自 docstring）：
          · **串行合并**：各段并列 ⇒ 任一段透明都成立 ⇒ `_merge_needs_alpha(video_tracks)`。
          · **画中画**：主视频透明 **或**「主视频之后那段」里显示的子视频带透明 ⇒
            `_pip_needs_alpha(video_tracks)`（那段没有主视频垫底，子视频的透明该保留）。
        🩹 2026-10-14：以上所有判据（含两个显式下传的）**都只看 settings / 轨道**，而
        「视频节点」里挂的遮罩住在 app 级 `self.node_fx`（不进 settings）⇒ 节点遮罩在管道
        预览里永远没有透明指示（用户实测：正常设置的遮罩能看见棋盘、节点里插入的看不见，
        但 mpv/ffplay 路径能看见）。故本函数末尾**无条件**把 `_node_fx_needs_alpha()` OR 进来 ——
        它是三个调用方的唯一咽喉点，放这里才不会漏。"""

        if alert_if(not self.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        if lavfi_complex_str:
            _graph = self._lavfi_complex_to_ffmpeg_pipe(lavfi_complex_str)
            if not _graph:
                self._append_info_ui(_("[时间预览] 合成图无法转为 ffmpeg 管道图，已取消"))
                return
        else:
            _chain = (filter_chain or "").strip().strip(",")
            _graph = "[0:v]%s[pv_src]" % (_chain if _chain else "null")
        # 图片主视频：输出时长必须按「图片显示时长」封顶 —— ffprobe 给图片的时长只有 ~0.04s，
        # 用它做输出级 -t 会导致预览只出一帧。
        _pdur = out_dur
        if _pdur is None and _is_static_image_file(file_path):
            try:
                _pdur = _eff_image_display_duration(settings)
            except Exception:
                _pdur = 10.0
        if pipe_alpha is None:
            _vs = _virtual_output_info(file_path) or (None, False)
            pipe_alpha = (bool(self._settings_needs_alpha(settings))
                          or bool(_vs[1]))
        # 🩹 2026-10-14（用户实测：「管道预览没有节点里插入的遮罩的透明」）：
        # 节点效果存在 app 级 `self.node_fx`，**根本不进 settings** ⇒ 上面所有判据
        # （以及调用方**显式下传**的 `_pip_needs_alpha` / `_merge_needs_alpha`）都只看
        # 设置与轨道，永远看不到挂在节点上的遮罩 ⇒ 透明指示恒缺失。
        # 故此处**无条件** OR 进来：调用方传值只代表「设置口径」的结论，不代表节点效果；
        # 这里是唯一的咽喉点（3 个调用方全走这里）⇒ 放在这里才不会漏。
        if not pipe_alpha:
            pipe_alpha = bool(self._node_fx_needs_alpha())
        if pipe_alpha:
            self._append_info_ui(
                _("[时间预览] 已启用透明指示（棋盘格底）：仅预览用，成片/导出当前帧不带格子"))
        self._append_info_ui(
            _("[时间预览] 管道合成预览启动：ffmpeg -filter_complex → rawvideo（无需 mpv；"
            "保留标记 / 波形 / 逐帧步进）"))
        # 释放调用方弹窗的模态 grab（与 _open_simple_preview 同款，否则预览窗点击被吞）
        release_grab(self.root)
        # 调用方额外参数（列表轨迹窗口交互）先行，管道参数覆盖（语义保护，见 docstring）
        _sp_kw = dict(extra_kw) if isinstance(extra_kw, dict) else {}
        # 父窗（2026-10-08）：列表轨迹场景由 _waypoints_panel 经 `_parent_win` 下传**轨迹弹窗**
        # —— 预览窗必须是它的子窗，否则轨迹窗的模态 grab 会把它压到最下面。其余入口（右键
        # 实时预览 / 时间预览引擎）不带此键 ⇒ 缺省回主窗口，与旧行为逐字节一致。
        _parent = _sp_kw.pop("_parent_win", None) or self.root
        # #5（2026-10-08）：`_wp_source`（未提交航点源）与 `_wp_target`（目标身份）只给**图构建**
        # 用，已在 `_preview_with_settings` / `merge_preview_pip_live` 里消费；此处必须摘掉，
        # 否则会作为未知 kwargs 传进 show_time_picker 报 TypeError。其余入口不带这两个键 ⇒ 零变化。
        _sp_kw.pop("_wp_source", None)
        _sp_kw.pop("_wp_target", None)
        # #3（2026-10-08）：图构建阶段回报的「未保存航点处置状态」——同一理由必须摘掉，
        # 改走显式参数 wp_mark 传给预览窗（标题 + 顶部横幅）。其余入口不带此键 ⇒ 零变化。
        _wp_mark = _sp_kw.pop("_wp_status", None)
        _sp_kw.update(
            use_output_context=False,   # 时间轴 = 窗口自身时间（单文件=素材原始时间；串行合并=成片时间）
            lavfi_complex=_graph,
            pipe_aspect=aspect,
            pipe_duration=_pdur,
            pipe_start=(out_start if out_dur is not None else start_sec),
            pipe_out_mode=(out_dur is not None),
            pipe_audio_graph=pipe_audio_graph,
            pipe_audio_map=pipe_audio_map,
            # 透明指示棋盘底（2026-10-12）：由 settings 自动判，见 docstring
            pipe_alpha=pipe_alpha,
            wp_mark=_wp_mark)
        self.show_time_picker(_parent, file_path, **_sp_kw)

    def _preview_base_chain(self, settings, pipe_engine=False, trim_enabled=None,
                            trim_start=""):
        """预览基础视频滤镜链（2026-10-13 从 `_preview_with_settings` 抽出）。

        为什么抽：命令编辑器（S2）要把树里的滤镜段对齐/注入核心预览图，需要**同一份
        构建口径**的基础链做基准 —— 编辑器自己复刻一遍构建参数必然漂移（flags 一改
        对齐全错），故收敛到这一个方法，两边共用。

        :param trim_enabled/trim_start: 调用方保存的**覆盖前**截取参数
            （`_preview_with_settings` 已把 settings["trim_enabled"] 置 False，
            直接读副本会永不跳转；命令编辑器传未变动的快照，缺省读 settings 原值）。
        :return: build_video_filter_chain 的串（可能含 `;` 子图）；空串 = 无基础滤镜。
        """
        _ft_speed = bool(self.preview_filter_speed.get())
        if trim_enabled is None:
            trim_enabled = bool(settings.get("trim_enabled", False))
        if trim_start is None:
            trim_start = str(settings.get("trim_start", "") or "").strip()
        # 管道模式时间基准（2026-09-21 修「管道预览里简易位置时段整体偏 pipe_start」）：
        # 管道图内 t 已被 _launch_video_pipe 桥接成「0 基 from pipe_start」（素材 τ → τ−pipe_start），
        # 而 crop_pos（简易位置）/delogo/mask/文字水印 的时段表达式按**素材原始时间**书写，只在链内
        # 含 trim 时才由 _trim_speed_from_settings 换算 st−trim_start。预览已把 trim_enabled 置 False
        # （截取起点改由管道 seek 承担）⇒ 换算基准退化为 0 ⇒ 表达式不换算，与 0 基时间轴整体错位
        # pipe_start 秒（用户实测：简易位置该动的时候不动、前后 seek 也找不到）。
        # 故管道路径把基准显式设为 pipe_start（= 截取起点 start_sec；未截取=0），并**同步 speed 因子**
        # （build_video_filter_chain 一旦收到 motion_trim_start，就不再自取 _trim_speed_from_settings，
        # 而改读 motion_speed_factor，缺省当 1.0 —— 不一起传会把变速换算打成 1.0）。
        # GPU 路线（mpv/ffplay）滤镜 t = 素材原始时间、不吃管道桥接 ⇒ 不传，行为逐字节不变。
        _pipe_ts = None
        _pipe_sp = None
        if pipe_engine and trim_enabled and trim_start:
            _pipe_ts = time_to_seconds(trim_start)
            if _pipe_ts:
                _pipe_sp = _trim_speed_from_settings(settings)[1]
            else:
                _pipe_ts = None
        return build_video_filter_chain(
            settings,
            include_subtitle=True,
            include_speed=_ft_speed,
            include_trim=False,
            enhance_settings=settings.get("enhance", {}),
            reverse=False,
            motion_trim_start=_pipe_ts,
            motion_speed_factor=_pipe_sp,
            # 2026-10-09：主视频绿幕抠像也要进预览（用户报「效果预览/单体预览/实时预览
            # 都没接入主视频的绿幕抠图」）。settings 即本语境主视频设置（转换页
            # get_current_settings / 封装页主轨 enc_settings）→ 直接喂 chroma。
            # 未启用时 None，行为与旧调用方逐字节一致（负控）。
            chroma_settings=settings if settings.get("chroma_enabled", False) else None,
            # 2026-10-10：主视频透明度同样进预览（与绿幕抠图同款接法）。
            # include_alpha 仅当 alpha_enabled 且值<1.0 才生效，未启用逐字节旧行为。
            include_alpha=True,
        )

    def _preview_with_settings(self, file_path: str, settings: dict, with_snapshot: bool = False,
                               pipe_engine: bool = False, extra_kw=None,
                               base_chain_hook=None):
        """
        预览（2026-08-30）：滤镜变速 setpts（preview_filter_speed，与转换一致）与
        mpv 整体变速 --speed / 整体倒放 --play-direction=backward（preview_realtime_*，
        播放器层，mpv 独有）同类型互斥；滤镜倒放 reverse 预览已取消（强制不含 reverse）。
        视频自适应缩放，截取通过播放器原生跳转参数（-ss/--start）实现。

        base_chain_hook（2026-10-13，命令编辑器 S2）：None = 完全旧行为。给一个
        `f(base_vf) -> base_vf'` 时，基础滤镜链构建完、进入水印/画布/缩放等下游
        **之前**被调用 —— 命令编辑器用它把「用户在树里对滤镜段的编辑」注入核心图
        （编辑器只做 diff，核心仍是唯一的图构建者，不存在第二套管道模式）。
        """
        # 虚拟/生成源（color:/gen: 哨兵串）非磁盘文件，os.path.exists 恒 False —— 放行
        if not file_path or (not _is_virtual_source(file_path) and not os.path.exists(file_path)):
            self._append_info_ui(f"文件不存在: {file_path}")
            return

        # ---- 快照模式：只弹合成快照窗口，不启动播放器预览 ----
        if with_snapshot:
            wm_settings = settings.get("watermark", {})
            tw_settings = settings.get("text_watermark", {})
            wm_active = wm_settings.get("enabled", False) and (wm_settings.get("file_path", "") or "").strip()
            tw_active = bool(tw_settings.get("enabled")) and bool((tw_settings.get("text", "") or "").strip())
            if wm_active:
                self._show_watermark_snapshot_async(file_path, settings)
            elif tw_active:
                # 仅文字水印（无图片水印）也支持快照
                self._show_text_watermark_snapshot_async(file_path, settings)
            else:
                self._append_info_ui(_("[预览] 未设置水印，无法生成快照"))
            return
    
        # ---- 预览强制走软件滤镜路径 ----
        # 原先把原始 settings（可能含 hw_filter_mode=QSV/CUDA/vaapi）直接交给 build_video_filter_chain，
        # 生成的滤镜链含有 vpp_qsv / scale_cuda 等硬件滤镜，而后面又追加一个软件 scale 做屏幕自适应，
        # 形成「硬件滤镜 + 软件滤镜」混用却缺少 hwdownload/hwupload 包裹的非法链路（mpv/ffplay 报错）。
        # 这里统一强制 cpu，与 build_preview_filter_chain 的设计意图一致：预览/外部播放器走软件。
        settings = dict(settings)
        # #5（2026-10-08）：列表轨迹面板「重开本管道」时下传了弹窗里**未提交**的航点 →
        # 临时覆盖**宿主声明的那个目标**的设置（判据见 _preview_inject_live_wp / _live_wp_target）。
        # 无 `_wp_source` / `_wp_target` 的调用方（mpv/ffplay 预览、转换页普通预览）返回同一对象
        # ⇒ 零行为变化。
        _prev_wp_settings = settings
        settings = _preview_inject_live_wp(self, settings, extra_kw)
        # #3（2026-10-08）：回报「本次图里到底有没有用上未保存航点」→ 预览窗标题 + 顶部横幅。
        # 判据 = 注入是否换了对象（`_preview_inject_live_wp` 未注入时返回入参同一对象）。
        # 无未保存航点（`_wp_source` 空）⇒ 不写该键 ⇒ 预览窗零变化。
        if _live_wp_override(extra_kw) is not None:
            _wp_mark_status(extra_kw,
                            "live" if settings is not _prev_wp_settings else "stale")
        settings["hw_filter_mode"] = "cpu"
        # 2026-08-29：预览用播放器原生 --start 跳转（无 trim/setpts），滤镜 t=**原始时间戳**；
        # 简易位置等段时间=原始时间语义 → 预览的 crop 表达式**不换算**（阈值=原始时间，直接匹配）。
        # 转换命令 trim+setpts 后 t=输出时间线，由 build_crop_pos_expr 自动换算（st-trim_start）。
        # ⚠️ 覆盖前先保存原始截取参数：start_sec 计算（下方第 5 步）必须读它，否则
        # trim_enabled 被置 False 后 --start 永不生成（=预览不跳截取起点，与封装页不一致）。
        _preview_trim_enabled = bool(settings.get("trim_enabled", False))
        _preview_trim_start = str(settings.get("trim_start", "") or "").strip()
        _preview_trim_end = str(settings.get("trim_end", "") or "").strip()
        settings["trim_enabled"] = False

        # ---- 变速/倒放预览（更多设置 4 个开关，同类型互斥，2026-08-30） ----
        # 滤镜开关开启 → 保留 speed/reverse 设置，build 链生成 setpts/reverse（与转换一致）；
        # mpv 整体开关 → 播放器层 --speed / --play-direction=backward（整个画面，mpv 独有命令）。
        _orig_speed_enabled = bool(settings.get("speed_enabled", False))
        _orig_reverse_enabled = bool(settings.get('reverse_enabled', False))
        _ft_speed = bool(self.preview_filter_speed.get())
        _rt_speed = bool(self.preview_realtime_speed.get())
        _rt_rev = bool(self.preview_realtime_reverse.get())
        if not (_ft_speed and _orig_speed_enabled):
            settings["speed_enabled"] = False
        # 滤镜倒放预览已取消（2026-08-30）：预览滤镜链强制不含 reverse
        settings['reverse_enabled'] = False
        mpv_only_args = []
        if _rt_speed and _orig_speed_enabled:
            try:
                _sf = float(str(settings.get("speed_factor", "1.0") or "1.0"))
                if _sf > 0 and abs(_sf - 1.0) > 1e-6:
                    mpv_only_args.append(f"--speed={_sf:g}")
            except (ValueError, TypeError):
                pass
        if _rt_rev and _orig_reverse_enabled:
            mpv_only_args.append("--play-direction=backward")
        elif _orig_reverse_enabled:
            self._append_info_ui(_("[预览] 预览不支持倒放，已忽略 reverse。"))
    
        # ---- 尺寸基准（帧尺寸）与管道引擎工作分辨率上限 ----
        # 基准统一用「帧尺寸」= 链内 crop→rotate→scale / pad 画布 / 画布模式之后的真实产出
        # （用户设了「分辨率」就是那个尺寸），与正式命令 / 可视化编辑器
        # （compute_final_size_with_order）同源。
        # ⚠️ 绝不能用原始探测尺寸当定位基准：链内已把画面缩到目标尺寸，下游 overlay 定位与播放器
        # 窗口比例若仍按原尺寸算 → 水印/子视频错位、播放器窗口按原尺寸开（用户实测「主视频很大
        # 没缩放、只显示一半（约 2 倍大小、只看到左上 1/4）」，mpv/ffplay/内置管道三条路都在内）。
        _md0 = self._get_video_dimensions_cached(file_path)
        _mw0 = (_md0[0] if _md0 and _md0[0] else 1280)
        _mh0 = (_md0[1] if _md0 and _md0[1] else 720)
        _rend_w, _rend_h = self.compute_final_size_with_order(_mw0, _mh0, settings)
        _canvas_mode = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
        _pg0 = _pad_canvas_geometry(settings)
        if _canvas_mode:
            _frame_w, _frame_h = _mw0, _mh0        # 画布帧 = 原始尺寸（内容缩放由画布段按 settings 自算）
        elif _pg0:
            _frame_w, _frame_h = _pg0[0], _pg0[1]  # pad 画布帧 = pad 尺寸
        else:
            _frame_w, _frame_h = _rend_w, _rend_h
        # 工作分辨率上限（_PIPE_WORK_MAX_W，仅 pipe_engine；GPU 路线 mpv/ffplay 全分辨率由硬件跑，
        # 不动）：帧宽 > 上限时把帧整体乘 f，并**改写链内分辨率**为降采样尺寸（精确模式）→ 图里
        # 真实产出即降采样尺寸，下游定位基准同步乘 f → 布局逐像素一致、仅像素变少（图计算量按
        # f² 下降）。**不能改成在图首另插一个 scale**：链内自带用户「分辨率」scale，插在图首会被
        # 它整段顶回去（图按原分辨率产出、几何按降采样算）。实测收益见 _PIPE_WORK_MAX_W 注释。
        _pwf = 1.0
        # 画布模式（canvas_mode）不降采样（2026-09-21）：与画中画预览同源——画布段由
        # build_canvas_filtergraph 按 canvas_segments 的**绝对像素**生成，输出尺寸无法跟着 f 缩
        # → 只缩内容基准会让画布与内容互相错位（同款「很大空隙」，且随原始尺寸变大）。
        if (not _canvas_mode) and pipe_engine and _frame_w > _PIPE_WORK_MAX_W and _frame_h > 0:
            _pwf = _PIPE_WORK_MAX_W / float(_frame_w)
            _frame_w, _frame_h = (max(2, int(_frame_w * _pwf) // 2 * 2),
                                  max(2, int(_frame_h * _pwf) // 2 * 2))
            settings["scale_enabled"] = True
            settings["scale_method"] = "exact"
            settings["scale_width"] = str(max(2, int(_rend_w * _pwf) // 2 * 2))
            settings["scale_height"] = str(max(2, int(_rend_h * _pwf) // 2 * 2))
        # ----- 1. 构建基础视频滤镜（变速按上方滤镜开关决定） -----
        # 2026-10-13：抽成 `_preview_base_chain` —— 命令编辑器要用**同一份口径**把树里
        # 的滤镜段对齐到核心图（编辑器自己复刻一遍构建参数必漂移，见其 docstring）。
        # trim_enabled 已在上面被置 False，故截取起点/时长必须显式传保存下来的原值。
        base_vf = self._preview_base_chain(settings, pipe_engine=pipe_engine,
                                           trim_enabled=_preview_trim_enabled,
                                           trim_start=_preview_trim_start)
        if base_chain_hook is not None:
            try:
                _hooked = base_chain_hook(base_vf)
                if _hooked:
                    base_vf = _hooked
            except Exception as e:
                self._append_info_ui(_("[命令编辑器] 段覆盖注入失败（本次按原图预览）: %s") % e)
        filter_parts = []
        if base_vf and base_vf != "null":
            filter_parts.append(base_vf)

        # ----- 2. 水印虚拟框 -----
        wm_settings = settings.get("watermark", {})
        drawbox_expr = None
        if wm_settings.get("enabled", False) and wm_settings.get("file_path", "").strip():
            wm_file = wm_settings.get("file_path", "").strip()
            main_w, main_h = _frame_w, _frame_h
            if main_w is None or main_h is None:
                self._append_info_ui(_("[预览] 无法获取视频尺寸，跳过水印虚拟框"))
            else:
                # 提前探测水印原始尺寸（自适应表达式求值需要，用原始设置）
                wm_orig_w, wm_orig_h = get_video_rotated_dimensions(self.ffprobe_cmd, wm_file, wm_settings)
                if wm_settings.get("adaptive", False):
                    adapted_wm = self._adapt_sub_settings(wm_settings, main_w, main_h, wm_orig_w, wm_orig_h)
                else:
                    adapted_wm = wm_settings
                # 注意：自适应后尺寸可能变了，重新探测（带旋转）
                orig_w, orig_h = get_video_rotated_dimensions(self.ffprobe_cmd, wm_file, adapted_wm)
                if orig_w is None or orig_h is None:
                    orig_w, orig_h = 320, 240
                wm_w, wm_h = compute_rendered_size(orig_w, orig_h, adapted_wm)
                if wm_w <= 0 or wm_h <= 0:
                    wm_w, wm_h = orig_w, orig_h
                # 旋转后：蓝色正方形占位 + 红色原始内容矩形（都以旋转中心为中心，两个 drawbox 同时存在）
                _wm_ra = _opt_float(adapted_wm.get("rotate_angle", 0) or 0, 0.0)
                _wm_spin = bool(adapted_wm.get("spin_enabled", False))
                _rot_ph = overlay_rotation_active(adapted_wm)
                # 定位语义（2026-08-25 理顺）：overlay_x/y 的 w/h = 内容盒（wm_w/wm_h）。
                # 旋转时蓝色 d×d 正方形中心与内容盒中心对齐 → 正方形位置 = 内容盒位置 - (d-w)/2。
                # clamp 仅当内容盒 ≤ 画布时启用（防丢）；内容盒 > 画布时放开（开放边界可拉出）。
                ctx = {"W": main_w, "H": main_h, "w": wm_w, "h": wm_h}
                x_expr = adapted_wm.get("overlay_x", DEFAULT_OVERLAY_X)
                y_expr = adapted_wm.get("overlay_y", DEFAULT_OVERLAY_Y)
                x_val = safe_eval_expr(x_expr, ctx)
                y_val = safe_eval_expr(y_expr, ctx)
                if x_val is None:
                    x_val = main_w - wm_w - RK_PLACE_INSET
                if y_val is None:
                    y_val = main_h - wm_h - RK_PLACE_INSET
                if wm_w <= main_w:
                    x_val = max(0, min(x_val, main_w - wm_w))
                if wm_h <= main_h:
                    y_val = max(0, min(y_val, main_h - wm_h))
                eff_w, eff_h = wm_w, wm_h
                if _rot_ph:
                    # 旋转：eff_w/eff_h 记蓝色 d×d 外接正方形尺寸（仅下方日志用），红框仍按 wm_w/wm_h 画
                    d = int(round(((wm_w * wm_w + wm_h * wm_h) ** 0.5)))
                    eff_w = eff_h = d
                    x_val = x_val - (d - wm_w) / 2.0
                    y_val = y_val - (d - wm_h) / 2.0
                    self._append_info_ui(f"[预览] 水印启用了旋转，蓝色正方形占位 {d}x{d} 与红色原始矩形同时显示")
                    cx = x_val + d / 2.0
                    cy = y_val + d / 2.0
                    # 蓝色正方形占位 + 红色斜矩形；仅 spin 时红框轴对齐
                    parts = [f"x={x_val:.1f}:y={y_val:.1f}:w={d}:h={d}:color=blue@0.5:t=3"]
                    if _wm_ra != 0:
                        parts.extend(build_rotated_rect_drawboxes(
                            cx - wm_w / 2.0, cy - wm_h / 2.0, wm_w, wm_h, _wm_ra,
                            color="red@0.3", t=3, n=5))
                    else:
                        parts.append(f"drawbox=x={cx - wm_w / 2.0:.1f}:y={cy - wm_h / 2.0:.1f}:w={wm_w}:h={wm_h}:color=red@0.3:t=3")
                    drawbox_expr = ",".join(parts)
                else:
                    drawbox_expr = f"x={x_val:.1f}:y={y_val:.1f}:w={wm_w}:h={wm_h}:color=red@0.3:t=3"
                self._append_info_ui(f"[预览] 水印虚拟框: 位置({x_val:.1f}, {y_val:.1f}) 尺寸{eff_w}x{eff_h}")
    
        # ----- 3. 文字水印判定：旋转/spin/轨迹需复杂图，普通 drawtext 走 -vf 链 -----
        # 2026-08-26 多实例：_tw_rotate = 任一启用项需要旋转子图（不只看首条）；
        # 普通 -vf 路径由 build_drawtext_chain_vf 渲染所有非旋转项。
        tw_settings = settings.get("text_watermark", {})
        _tw_items = settings.get("text_watermark_items") or []
        _tw_active = [i for i in _tw_items
                      if i.get("enabled", True) and str(i.get("text", "") or "").strip()]
        if not _tw_active:
            _tw_active = [tw_settings] if (tw_settings.get("enabled", False)
                                           and str(tw_settings.get("text", "") or "").strip()) else []
        _tw_enabled = bool(_tw_active)
        _tw_rotate = any(text_watermark_needs_subgraph(i) for i in _tw_active)

        # ----- 4. 自适应缩放参数（旋转路径并入复杂图；普通路径追加 vf） -----
        orig_w, orig_h = get_video_rotated_dimensions(self.ffprobe_cmd, file_path, settings)
        if orig_w is None or orig_h is None:
            orig_w, orig_h = self._get_video_dimensions_cached(file_path)
            if orig_w is None or orig_h is None:
                orig_w, orig_h = 1280, 720
        
        final_w, final_h = compute_rendered_size(orig_w, orig_h, settings)
        
        screen_w = self.root.winfo_screenwidth()
        screen_h = self.root.winfo_screenheight()
        margin = self.preview_margin.get()  # 播放预览屏幕边距（更多设置，默认 80）
        max_w = screen_w - margin
        max_h = screen_h - margin
        # 2026-10-13：外部播放器预览「屏幕适应缩放」总开关（更多设置 → 预览窗口 → 原始大小）。
        # 勾选「原始大小」⇒ 本函数【非管道分支】不再按屏幕缩小；管道分支走内置时间预览窗口
        # （自带 preview_max_w/h 与 _PIPE_WORK_MAX_W 上限），是「窗口内部」尺寸，保持原样。
        _fit_on = self._preview_fit_enabled() or pipe_engine
        scale_expr = ""
        # 缩放基准计入末端（边框边距 / split 网格）：pad 加在 scale 之后，若不把边距算进
        # 缩放目标，输出 = 缩放后 + 边距 > 屏幕（边框预览会把标题栏挤出窗口）。2026-08-27 修复。
        # mpv 可用性/水印活性提前（4b 分支也用，避免重复探测）：
        use_mpv = bool(self.use_mpv.get()) and self._mpv_ready(log=False)
        wm_active = bool(wm_settings.get("enabled", False)) and bool((wm_settings.get("file_path", "") or "").strip())
        _eh_scale = settings.get("end_handling") or {}
        _sc_w = _sc_h = 0
        if _eh_scale.get("border_enabled", False):
            try:
                _sc_w = int(_eh_scale.get("border_left", 0) or 0) + int(_eh_scale.get("border_right", 0) or 0)
                _sc_h = int(_eh_scale.get("border_top", 0) or 0) + int(_eh_scale.get("border_bottom", 0) or 0)
            except (ValueError, TypeError):
                _sc_w = _sc_h = 0
        try:
            _sp_rows = max(1, int(_eh_scale.get("split_rows", 1) or 1))
            _sp_cols = max(1, int(_eh_scale.get("split_cols", 1) or 1))
        except (ValueError, TypeError):
            _sp_rows = _sp_cols = 1
        _sp_on = bool(_eh_scale.get("split_enabled", False)) and (2 <= _sp_rows * _sp_cols <= 5)
        # ---- 末端处理参数提前算（复杂图进入条件要用，下方 5b 注入处直接复用，避免两处口径不一致）----
        # ⚠️ 2026-10-06 边框随预览缩放等比缩小（用户实测「管道预览边框很粗」）：
        #   `pad` 是**绝对像素**且加在 scale 之后，而预览把画面缩小了（屏幕适配 scale_expr
        #   + 管道工作分辨率上限 _pwf）⇒ 同一个 12px 边框在缩小的画面上相对宽度翻倍，
        #   而成片不做屏幕缩放、始终 12px 相对原始尺寸（用户实测成片是「细的」）。
        #   口径 = 成片：边框 × (预览尺寸/成片尺寸)。两个倍数此刻都已知（_pwf 在更早算完，
        #   _eh_bfactor 在下方缩放决策后回填），故先用 1.0 占位、下面回填。
        _eh_bfactor = 1.0
        _eh_p = scale_preview_border_px(_eh_scale, _eh_bfactor)
        _psr, _psc = _sp_rows, _sp_cols
        _bp = build_preview_border_frag(_eh_p)
        # 边框位置（2026-08-27）：True=split 之后（网格外框）；False=split 之前（每格带框）
        _bp_after_split = bool(_eh_p.get("border_after_split", True))
        _split_ok = _sp_on
        _bp_before = bool(_bp) and _split_ok and (not _bp_after_split)
        # split 仅在实际渲染的路径计入缩放（2026-08-27 实测修正，2026-10-06 随判据恢复分情况）：
        # - 走复杂图（4b 分支真进：canvas / 文字水印旋转 / 图片水印 / 多级网格 / before 等宽边框）
        #   → 完整网格渲染，计行列；
        # - 走普通 -vf 逗号链 → 仅单级网格（rows==1 横排 / cols==1 竖排，split=N,hstack/vstack=inputs=N
        #   纯逗号链，实测可行）；多级网格需 filter_complex 标签，普通路径放弃；
        # 不渲染的网格不计入，否则画面被按网格基准过度缩小。
        # ⚠️ `_eh_need_complex` 与下方 4b 分支的进入条件**必须逐字同口径**，否则
        #    「以为渲染了却没渲染」/「没渲染却按网格缩小」两类静默错画面。
        #    2026-10-06 曾把本行简化成 `_sp_on_scale = _sp_on`（配合当时的 `if True:` 恒复杂图），
        #    判据恢复分情况后必须一起恢复，否则单级网格会按未渲染的基准缩小。
        _eh_need_complex_scale = _split_ok and ((_psr > 1 and _psc > 1) or _bp_before)
        _sp_on_scale = _sp_on and (
            (use_mpv and (wm_active or _tw_rotate)) or _eh_need_complex_scale
            or _sp_rows == 1 or _sp_cols == 1
        )
        # before 模式（间隙模型）：外围只加一次 + 格间 (cols-1) 条缝隙，≠ 旧口径的「每格都 +四边距」
        _bp_before_scale = (_sp_on_scale and (_sc_w > 0 or _sc_h > 0)
                            and not bool(_eh_scale.get("border_after_split", True)))
        if _bp_before_scale:
            _total_w, _total_h = build_split_grid_size(
                _sp_rows, _sp_cols, final_w, final_h,
                int(_eh_scale.get("border_left", 0) or 0), int(_eh_scale.get("border_right", 0) or 0),
                int(_eh_scale.get("border_top", 0) or 0), int(_eh_scale.get("border_bottom", 0) or 0))
        else:
            _total_w = final_w * (_sp_cols if _sp_on_scale else 1) + _sc_w
            _total_h = final_h * (_sp_rows if _sp_on_scale else 1) + _sc_h
        if _fit_on and (_total_w > max_w or _total_h > max_h):
            scale = min(max_w / _total_w, max_h / _total_h)
            target_w = int(final_w * scale)
            target_h = int(final_h * scale)
            target_w = target_w if target_w % 2 == 0 else target_w - 1
            target_h = target_h if target_h % 2 == 0 else target_h - 1
            if target_w < 2: target_w = 2
            if target_h < 2: target_h = 2
            scale_expr = f"scale={target_w}:{target_h}"
            self._append_info_ui(f"[预览] 视频总尺寸 {_total_w}x{_total_h} 超出屏幕，单份缩放到 {target_w}x{target_h}")
        elif _fit_on:
            self._append_info_ui(f"[预览] 视频尺寸 {_total_w}x{_total_h} 适合屏幕，保持原始")
        else:
            self._append_info_ui(
                f"[预览] 已勾选「原始大小」：视频尺寸 {_total_w}x{_total_h} 保持原始，不做屏幕适配")
        # ---- 边框随预览缩放等比缩小（2026-10-06，紧接缩放决策之后）----
        # 缩放倍数 = 屏幕适配 × 管道工作分辨率上限（_pwf 在本函数更早已定）。两者都 ≤1，
        # 乘起来仍是「预览尺寸 / 成片尺寸」的总倍数，正是 scale_preview_border_px 要的口径。
        # ⚠️ 必须在这里（缩放决策之后）回填并**重算 _eh_p / _bp**：上面算 _total_w 时用的是
        #    未缩放边距（用于「是否超屏」判定，正确），但真正进链的 pad 片段要按缩放后边距。
        #    _sc_w/_sc_h 保持未缩放值——它只喂 _total_w（超屏判定）与 _par（输出比例），
        #    那两处要的是「成片口径」的边距总量，见下方 build_split_grid_size 调用处的说明。
        try:
            _eh_screen_scale = (float(target_w) / float(final_w)) if scale_expr else 1.0
        except (TypeError, ValueError, ZeroDivisionError):
            _eh_screen_scale = 1.0
        _eh_bfactor = _eh_screen_scale * float(_pwf)
        _eh_p = scale_preview_border_px(_eh_scale, _eh_bfactor)
        _bp = build_preview_border_frag(_eh_p)
        # 缩放后的边距总量（喂预览框比例 _par；_sc_w/_sc_h 是未缩放口径，只用于超屏判定）
        _bsw = _bsh = 0
        try:
            _bsw = (int(_eh_p.get("border_left", 0) or 0)
                    + int(_eh_p.get("border_right", 0) or 0))
            _bsh = (int(_eh_p.get("border_top", 0) or 0)
                    + int(_eh_p.get("border_bottom", 0) or 0))
        except (TypeError, ValueError):
            _bsw = _bsh = 0
        # 边框边距非空性不受缩放影响（helper 钳到 ≥2px），故 _bp_before 无需重算。
        if _eh_bfactor < 1.0 and _eh_scale.get("border_enabled", False):
            self._append_info_ui(
                f"[预览] 末端边框按预览缩放等比缩小（×{_eh_bfactor:.3f}），取整后与成片有细微出入，以成片为准")
        # 管道预览画面框基准（2026-09-20）：末端处理前的【单格】输出尺寸——超屏时 scale 已把
        # tile 缩到 target_w×target_h，未超屏就是 final 尺寸。画布模式会在下方画布分支覆盖成
        # 画布尺寸（比例与源不同）。管道分支用它 × 网格行列 + 边框边距算真实输出比例。
        _pipe_base_w, _pipe_base_h = (target_w, target_h) if scale_expr else (final_w, final_h)
        
        # ----- 4b. 复杂预览：mpv --lavfi-complex（文字水印旋转/图片水印真实合成），
        #            ffplay -vf 分号图（文字水印旋转，用户实测格式：-vf 直接支持分号多段图）；
        #            其余场景走普通 -vf 链（图片水印占位框） ----
        filter_chain = ""
        lavfi_complex_str = None
        filter_complex = None
        # mpv 不可用时走非 mpv 滤镜分支（ffplay 播带滤镜/占位框画面），而非构建 lavfi-complex
        # 后再由 preview_with_player 回退（那样 ffplay 只能播原始画面，滤镜全丢）
        # （use_mpv / wm_active 已在第 4 步缩放前定义，此处沿用）
        # 手动时长：从自定义参数解析 -t（如 -t 10），复杂预览时水印 overlay enable 用 lt(t,T) 且去掉 shortest
        manual_t = None
        try:
            _mt = re.search(r"(?:^|\s)-t\s+(\d+(?:\.\d+)?)", settings.get("custom_args", "") or "")
            if _mt:
                manual_t = float(_mt.group(1))
        except Exception:
            manual_t = None

        # 转换页预览的挂载判据（2026-10-06 修正，用户拍板）：
        # 【形状必须与成片命令一致】—— 成片 _generate_ffmpeg_command_core 的分支规则是
        #   ① -c:v copy → 零滤镜  ② canvas → 复杂图  ③ 文字水印旋转 → 复杂图
        #   ④ 图片水印 → 整个命令换 _generate_command_with_watermark（其内部也是复杂图）  ⑤ 其余 → -vf 逗号链
        # 预览的 if 条件与它逐条对应：命中 ②③④ 任一才走复杂图，其余走 -vf 逗号链。
        # ⛔ 别改回 `if True:`（73252ea 曾经这么干，2026-10-06 已被上面这段判据取代）：
        #   恒复杂图会让「命令框里这条长什么样」不再携带任何信息 —— 用户排查靠的就是
        #   「命令形状即索引」：扫一眼 -vf / 复杂图就知道链断在哪一段。恒真等于把索引抹掉。
        # ⚠️ 本判据只用「逗号链能否表达」判，不用「mpv 是否可用」判（ffplay 的 -vf 即完整
        #   filtergraph，ffplay 也能渲染复杂图，见 research/ffplay-preview 实证）。
        # ⚠️ _sp_on_scale（第 4 步）必须与本判据同口径：只有本判据真走复杂图渲染网格时，
        #   多级网格才计入缩放基准，否则画面被按网格尺寸过度缩小。
        # 末端网格的复杂图/逗号链两套实现在下方 5b 段分派（_split_ok or _bp → 内部分支），
        # 本判据只决定「进入 4b 复杂图段」还是「进入 5 普通路径段」。
        _eh_need_complex = _split_ok and ((_psr > 1 and _psc > 1) or _bp_before)
        if (bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))) \
                or _tw_rotate or wm_active or _eh_need_complex:
            # ================= 复杂图（mpv --lavfi-complex / ffplay -vf 共用，[VIN]/[VOUT] 占位） =================
            # 研究 ffplay-preview 实证：ffplay 的 -vf 即完整 filtergraph，故同一张图 mpv 与 ffplay
            # 都能渲染合成画面。preview_with_player 按 mpv 可用性选播放器：mpv 走 --lavfi-complex，
            # ffplay 走 _lavfi_complex_to_ffplay 改写（[VIN]→[in]、[VOUT]→[out]、删音频 passthrough 段）。
            fg = FilterGraph("[VIN]")
            if base_vf and base_vf != "null":
                fg.chain(base_vf, "v0")
            else:
                # 2026-10-06：无基础滤镜时的占位段必须与正式导出命令同口径 —— 正式命令走
                # build_video_filter_chain(include_format)，只有「指定像素格式」勾选时才加 format=。
                # 以前这里无条件 format=yuv420p：复杂图路径下 10bit / HDR / yuv444p 素材的
                # 原画预览被压成 8bit（实测 showinfo：p10le → yuv420p），与导出设置脱节。
                # 现改为：勾选 → format=<设置值>；未勾选（或值为空/非法）→ null 占位，零像素格式改写。
                # （判据恢复分情况后本段并非恒进，但口径仍要与成片一致，故保留此修正。）
                _pv_on = bool(settings.get("pix_fmt_enabled", False))
                _pv = str(settings.get("pix_fmt", "yuv420p") or "yuv420p").strip()
                if _pv_on and re.fullmatch(r"[A-Za-z0-9_]+", _pv):
                    fg.chain(f"format={_pv}", "v0")
                else:
                    fg.chain("null", "v0")
            # ---- 图片水印：movie 源 + 子视频滤镜链（裁剪/缩放 base_vf + 绿幕 + 透明度 + 旋转）----
            if wm_active:
                wm_file = wm_settings.get("file_path", "").strip()
                # 探测子视频渲染尺寸（与正式命令同套逻辑）
                try:
                    _wm_ow, _wm_oh = get_video_rotated_dimensions(self.ffprobe_cmd, wm_file, wm_settings)
                    if _wm_ow is None or _wm_oh is None:
                        _wm_ow, _wm_oh = 320, 240
                    _mdim = self._get_video_dimensions_cached(file_path)
                    # 定位基准 = 帧尺寸（渲染尺寸；上限触发时为降采样后尺寸）——不能用原始探测
                    # 尺寸，链内「分辨率」已把画面缩小，按原尺寸算会错位（见本函数开头说明）。
                    _main_w, _main_h = _frame_w, _frame_h
                    # 源尺寸副本：自适应按主视频内容缩放，不随 pad 画布变（用户拍板 2026-08-25）
                    _src_main_w, _src_main_h = _main_w, _main_h
                    adapted_wm2 = self._adapt_sub_settings(wm_settings, _src_main_w, _src_main_h,
                                                           _wm_ow, _wm_oh) if wm_settings.get("adaptive", False) else wm_settings
                    _ow2, _oh2 = get_video_rotated_dimensions(self.ffprobe_cmd, wm_file, adapted_wm2)
                    if _ow2 is None or _oh2 is None:
                        _ow2, _oh2 = _wm_ow, _wm_oh
                    wm_w2, wm_h2 = compute_rendered_size(_ow2, _oh2, adapted_wm2)
                    if wm_w2 <= 0 or wm_h2 <= 0:
                        wm_w2, wm_h2 = _ow2, _oh2
                except Exception:
                    adapted_wm2 = wm_settings
                    wm_w2, wm_h2 = 320, 240
                    _main_w, _main_h = 1280, 720
                    _src_main_w, _src_main_h = _main_w, _main_h
                # 画布模式（2026-08-31 两段式）：定位/对角线基准 = 内容盒（画布尺寸 × 用户缩放），
                # 与不开画布时的叠加尺寸完全等价 → 下游定位 / blend 区域零改动。
                # 绝对像素坐标同步换算（2026-09-21）：与画中画预览同源——上限把帧乘 f 缩小后，
                # 水印定位里写死的数字（简易位置）不会跟着缩 → 水印相对更靠右下（越界被裁）。
                # 含 W/H/w/h 的表达式在图内按当前空间求值，不缩放；f=1 时同一对象、零行为变化。
                if _pwf != 1.0:
                    adapted_wm2 = _pipe_scale_pos_settings(adapted_wm2, _pwf)
                _wm_cv_on = self._sub_canvas_on(adapted_wm2)
                if _wm_cv_on:
                    wm_w2, wm_h2 = self._overlay_content_size(wm_file, adapted_wm2)
                # ---- 主视频画布偏移（pad）：复杂图分支补渲染（与成片/合并页预览一致）+ 画布基准 ----
                _pg = _pad_canvas_geometry(settings)
                if _pg:
                    _pwc, _phc, _pox, _poy = _pg
                    # 管道引擎工作分辨率上限：主视频画布几何（尺寸 + 偏移）等比降到降采样尺寸，
                    # 否则主视频（已图首降采样）与原始画布错位。
                    if _pwf != 1.0:
                        _pwc = max(2, int(_pwc * _pwf) // 2 * 2)
                        _phc = max(2, int(_phc * _pwf) // 2 * 2)
                        _pox = int(round(_pox * _pwf))
                        _poy = int(round(_poy * _pwf))
                    # 画布限时防无限延长：manual_t（用户 -t）优先，否则主视频时长；都没有 → shortest=1
                    _pad_dur2 = ""
                    if manual_t is not None:
                        _pad_dur2 = f":duration={_ffsec(manual_t)}"
                    else:
                        try:
                            # 图片主视频：ffprobe 只给 ~0.04s / N/A ⇒ 画布 0.04s 就结束，
                            # 画布之上的子视频/文字水印跟着「瞬间消失」。图片按「显示时长」算
                            # （与封装页 _IMAGE_PREVIEW_SEC / merge_preview_pip_live 同口径）。
                            if _is_static_image_file(file_path):
                                _main_dur2 = _eff_image_display_duration(settings)
                            else:
                                _main_dur2 = self._get_media_duration(file_path)
                            if _main_dur2 and _main_dur2 > 0:
                                _pad_dur2 = f":duration={_ffsec(_main_dur2)}"
                        except Exception:
                            pass
                    fg.source(f"color=c=black:s={_pwc}x{_phc}{_pad_dur2}", "canvas")
                    if _pad_dur2:
                        fg.combine("[canvas]", f"overlay={_pox}:{_poy}", "v_main_pad")
                    else:
                        fg.combine("[canvas]", f"overlay={_pox}:{_poy}:shortest=1", "v_main_pad")
                    # 画布基准更新：blend clamp/基准求值按 pad 画布（overlay 目标流=v_main_pad）
                    _main_w, _main_h = _pwc, _phc
                    self._append_info_ui(f"[预览] 主视频画布偏移：{_pwc}x{_phc} @ ({_pox},{_poy})")
                # movie 源：路径统一正斜杠 + 冒号转义 \\:（movie 滤镜参数解析中 \ 是转义符，
                # Windows 反斜杠路径必须转成正斜杠，否则 \U \A 等会被当作无效转义）；
                # 含 [ ] ' , ; 等 filtergraph 特殊字符的路径先用临时硬链接/副本规避
                # （实测这些字符无法转义，全报错）。
                path_esc = self._movie_path_safe(wm_file).replace("\\", "/").replace(":", "\\\\:")
                # 子视频滤镜链：直接复用主滤镜构建函数（排除倒放/加速/字幕/像素格式等 mpv 预览不支持的），
                # trim/loop/裁剪/缩放/绿幕/颜色校正/反色 全在 chain 内（movie 层只载入，chain 统一循环）；
                # 链外仅保留透明度/自旋转。
                _loop_size = self._preview_sub_loop_size(adapted_wm2, wm_file)
                # 画布模式：裁剪/旋转/缩放交给画布段 → 前置链三者全关（缩放挪到画布之后，防缩两次）
                _wm_base_settings = dict(adapted_wm2, hw_filter_mode="cpu", precise_trim=True)
                if _wm_cv_on:
                    _wm_base_settings["crop_enabled"] = False
                    _wm_base_settings["rotate"] = "none"
                    _wm_base_settings["scale_enabled"] = False
                _sub_base = build_video_filter_chain(
                    _wm_base_settings,
                    include_subtitle=False,
                    include_speed=False,
                    include_trim=True,          # trim 由 chain 内处理（precise_trim + trim_enabled）
                    include_format=False,
                    include_scale=False,
                    enhance_settings=adapted_wm2.get("enhance", {}),
                    reverse=False,
                    chroma_settings=adapted_wm2 if adapted_wm2.get("chroma_enabled", False) else None,
                    loop_size=_loop_size,
                    force_scale=None if _wm_cv_on else (wm_w2, wm_h2),  # 画布模式交给第 2 段缩放
                )
                if _sub_base and _sub_base != "null":
                    sub_vf_parts = [_sub_base]
                else:
                    sub_vf_parts = []
                _alpha2 = bool(adapted_wm2.get("alpha_enabled", False))
                # 注意：enc_settings["rotate"] 是「视频滤镜」的方向字符串（"90"/"180"/"270"），
                # 已由 build_video_filter_chain 处理成 transpose——**不要**在这里再当角度追加 rotate
                # （否则 rotate="270" 会 transpose 一次 + rotate 270° 一次 = 双重旋转）。
                # 子视频只有 spin 持续旋转需要显式 rotate（与正式命令 _build_overlay_filter_complex 一致）。
                _spin2 = bool(adapted_wm2.get("spin_enabled", False))
                _sp2 = _opt_float(adapted_wm2.get("spin_speed", 60.0) or 60.0, 60.0)
                _ra2 = _opt_float(adapted_wm2.get("rotate_angle", 0) or 0, 0.0)
                _mv2 = (adapted_wm2.get("move_mode", "") or "").strip()
                # 🔴 画布 vs 列表轨迹 缩放共存提示（2026-10-07 复核：互锁已取消，仅提示；
                #    两个缩放都原样生效并相乘。与正式命令/实时预览同款）。
                self._sub_canvas_scale_notice(adapted_wm2, wm_file, where="wm_preview")
                _wp2 = None
                _wp_rot2 = False
                if _mv2 == "waypoints":
                    _wp2 = build_waypoint_expr(adapted_wm2.get("move_waypoints"),
                                               sw=str(wm_w2), sh=str(wm_h2), spin_speed=_sp2)
                    _wp_rot2 = (_wp2 is not None and _wp2[2] is not None)
                if _alpha2 or (_spin2 and _sp2 != 0) or _ra2 != 0 or _wp_rot2 or \
                   (_wp2 is not None and _wp2[4] is not None):
                    sub_vf_parts.append("format=rgba")
                if _alpha2:
                    _av = _opt_float(adapted_wm2.get("alpha_value", 1.0), 1.0)
                    # 静态透明度：轨迹透明度存在时跳过——由下方 geq 一并折入。
                    if 0.0 <= _av <= 1.0 and not (_wp2 is not None and _wp2[4] is not None):
                        sub_vf_parts.append(f"colorchannelmixer=aa={_av:.2f}")
                # 列表轨迹透明度（oa→ob）：与静态 alpha_value 串联合成（相乘）；全 1.0 时 _wp2[4] 为 None 跳过。
                # ⚠️ colorchannelmixer=aa 在本构建为 init 模式（拒绝 t/max 时变表达式），改用 geq 承载：
                #    时间戳变量为 T（独立 t 用 re.sub 换 T），上游已挂 format=rgba，静态 _av 折入 a='(_av*255)*(traj_T)'。
                #    geq 表达式取 0~255 平面值（非 0~1），alpha 须 ×255 缩放（见子视频处说明）。
                #    已知限制：geq 读不到输入 alpha，不乘源素材自带 alpha（见子视频处说明）。
                if _wp2 is not None and _wp2[4] is not None:
                    _traj_T2 = re.sub(r'\bt\b', 'T', _wp2[4])
                    _sa2 = _av if (_alpha2 and 0.0 <= _av <= 1.0) else 1.0
                    sub_vf_parts.append(f"geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':a='{_sa2*255:.0f}*({_traj_T2})'")
                # 🔴🔴 铁律（2026-10-08，与封装页 _pv_build_layer（53978）同一条）：
                # 画布模式下旋转节点**必须延后到画布段之后**（与正式命令
                # _build_sub_layer_node 同序：画布 → 第2段 scale → 透明度 → 旋转 → 列表缩放）。
                # 留在前置链（画布之前）→ 画布段的 scale（基准=内容原始尺寸）会把 hypot
                # 正方形盒非等比缩回 → 画面变扁；画布 overlay 的 (main_w-overlay_w)/2 又用 d
                # 顶替 w → 整体偏左 (d-w)/2。
                _wm_rot_seg = None
                if (_spin2 and _sp2 != 0) or _ra2 != 0 or _wp_rot2:
                    _angle_expr2 = ""
                    if _ra2 != 0:
                        _angle_expr2 = f"{_ra2}*PI/180"
                    if _wp_rot2:
                        # 列表自旋转覆盖全局 spin
                        if _angle_expr2:
                            _angle_expr2 += " + "
                        _angle_expr2 += f"({_wp2[2]})"
                    elif _spin2 and _sp2 != 0:
                        if _angle_expr2:
                            _angle_expr2 += " + "
                        _angle_expr2 += f"{_sp2}*PI/180*t"
                    _wm_rot_seg = (f"rotate=angle='{_angle_expr2}'"
                                   f":ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0")
                    if not _wm_cv_on:
                        sub_vf_parts.append(_wm_rot_seg)
                # 列表轨迹缩放（2026-09-04）：必须排在 rotate 之后（变尺寸 scale 在前会把
                # rotate 的 ow/oh 锁死在首帧 → 放大内容被裁）。用 iw/ih 相对表达 → 与旋转画布
                # d×d / 画布模式解耦。max(2,...) 防 round 成 0；setsar=1 防 SAR 逐帧漂移。
                _wp_zoom2 = bool(_wp2 is not None and _wp2[3] is not None)
                # blend 同样支持缩放（方案 A 静态包围盒模型，见 _make_blend_region）：
                # 旧「窗口固定 = 基准内容盒」的前提已随 crop 窗口改为静态包围盒而消失。
                # 🔴⚠️ 铁律（真机 2026-10-07 像素级实证）：blend 路径下**必须把 format=rgba 提到
                #    逐帧 scale 之前**。format=rgba 若作为独立段排在 scale 之后（同一 -vf 串里
                #    顺序即执行序），overlay 副输入会走「带 α 的尺寸协商」→ 逐帧变尺寸 scale
                #    失效、z(t) 锁死在首帧值 ⇒ 缩放永不缩回（用户报「整体都变大、没有缩回」）。
                if _wp_zoom2 and not _wm_cv_on and (str(adapted_wm2.get('blend_mode', 'normal')
                                                    or 'normal')).strip().lower() != 'normal':
                    sub_vf_parts.append("format=rgba")
                # 🔴🔴 画布模式下列表缩放必须**延后到画布合成之后**（真机实证，同 _preview
                # 路径铁律）：逐帧 scale 之后紧跟画布段的独立 format=rgba 段 → z(t) 锁死首帧。
                _wm_zoom_seg = None
                if _wp_zoom2:
                    # 列表轨迹缩放 sendcmd 驱动（长列表突破表达式段数墙，2026-10-08）：与预览 px/py
                    # 同阈值（_wp_sc_rows_limit）；值 = max(2,2*round(iw*(s)/2))，s 为倍率区间表。
                    # 阈值内 / 无缩放变化保持原表达式路（max(2,2*round(iw*(zoom)/2))）。
                    _wm_scale_sc = None
                    _wm_wp_rows = len([w for w in (adapted_wm2.get("move_waypoints") or [])
                                       if isinstance(w, dict)])
                    if _wm_wp_rows > _wp_sc_rows_limit():
                        try:
                            _wm_sc_iv = build_waypoint_scale_intervals(
                                adapted_wm2.get("move_waypoints"))
                            if _wm_sc_iv:
                                _wm_scale_sc = self._write_waypoint_sendcmd_file(
                                    _wm_sc_iv, tag="slrW", cmd_style="scale",
                                    target="scale@slrW", scale_base_w="iw",
                                    scale_base_h="ih", scale_min=2)
                        except Exception:
                            _wm_scale_sc = None
                    if _wm_scale_sc is not None:
                        _wz0 = _wm_sc_iv[0][3]
                        # ⚠️ 值含逗号（max(2,...)）必须整体单引号包裹，否则 filtergraph
                        # 把逗号当滤镜分隔符 → "No option name near 'max(2'"（与正式命令同款）
                        _wm_seg = (f"sendcmd=f='{_wm_scale_sc}',"
                                   f"scale@slrW=w='max(2,2*round(iw*({_wz0:g})/2))'"
                                   f":h='max(2,2*round(ih*({_wz0:g})/2))':eval=frame,setsar=1")
                    else:
                        _wm_seg = (f"scale=w='max(2,2*round(iw*({_wp2[3]})/2))'"
                                   f":h='max(2,2*round(ih*({_wp2[3]})/2))':eval=frame,setsar=1")
                    if _wm_cv_on:
                        _wm_zoom_seg = _wm_seg        # 延后到画布之后
                    else:
                        sub_vf_parts.append(_wm_seg)
                sub_chain = ",".join(sub_vf_parts) if sub_vf_parts else "null"
                # movie 层只载入（无 loop 参数=默认播一次）；循环统一由 chain 的 loop_size 处理
                fg.source(f"movie={path_esc}", "sub")
                if _wm_cv_on:
                    # 第 1 段：前置链 → 透明画布合成 → 独立数据流；
                    # 第 2 段：当独立文件自由缩放。最终落回 [sub_rot]，下游零改动。
                    fg.link("[sub]", sub_chain, "sub_pre")
                    _tsc, _spc = _trim_speed_from_settings(adapted_wm2)
                    _scg = self._build_sub_canvas_graph(
                        adapted_wm2, wm_file, "p0", "[sub_pre]", "v_sc_wm",
                        trim_start=_tsc, speed_factor=_spc)
                    _cur_lbl = "[sub_pre]"
                    if _scg:
                        fg.raw(_scg)
                        _cur_lbl = "[v_sc_wm]"
                    _scw, _sch = self._sub_canvas_size(adapted_wm2, wm_file)[2:4]
                    if (wm_w2, wm_h2) != (_scw, _sch):
                        fg.link(_cur_lbl, f"scale={wm_w2}:{wm_h2}", "sub_scs2")
                        _cur_lbl = "[sub_scs2]"
                    # 旋转：画布 + 第 2 段之后再挂（与正式命令同序；见 38251 铁律注释）
                    if _wm_rot_seg is not None:
                        fg.link(_cur_lbl, _wm_rot_seg, "sub_wrot")
                        _cur_lbl = "[sub_wrot]"
                    if _wm_zoom_seg is not None:
                        # 列表轨迹缩放：画布 + 第 2 段之后再挂（与正式命令同序 → 不锁死）
                        fg.link(_cur_lbl, _wm_zoom_seg, "sub_wzr")
                        _cur_lbl = "[sub_wzr]"
                    fg.link(_cur_lbl, "null", "sub_rot")
                else:
                    fg.link("[sub]", sub_chain, "sub_rot")
                x_expr = str(adapted_wm2.get("overlay_x", DEFAULT_OVERLAY_X) or DEFAULT_OVERLAY_X)
                y_expr = str(adapted_wm2.get("overlay_y", DEFAULT_OVERLAY_Y) or DEFAULT_OVERLAY_Y)
                # 定位语义（2026-08-25 理顺）：overlay_x/y 的 w/h = 内容盒（wm_w2/wm_h2）；
                # 旋转时叠加盒 d×d 中心与内容盒中心对齐 → 位置减 (d-w)/2（与正式命令一致）。
                _rot2v = overlay_rotation_active(adapted_wm2, wp_rot=_wp_rot2)
                if _rot2v:
                    _ed2v = int(round(((wm_w2 * wm_w2 + wm_h2 * wm_h2) ** 0.5)))
                    _off2x, _off2y = _content_box_shift(wm_w2, wm_h2, _ed2v, _ed2v)
                else:
                    _off2x = _off2y = 0.0
                if _mv2 == "waypoints":
                    # 列表轨迹：画布绝对像素（数字），直接使用；无效时回退基准位置
                    if _wp2 is not None and _wp2[0] is not None:
                        x_expr, y_expr = _wp2[0], _wp2[1]
                    else:
                        x_expr = _content_box_expr(x_expr, wm_w2, wm_h2)
                        y_expr = _content_box_expr(y_expr, wm_w2, wm_h2)
                elif _mv2:
                    # 轨迹范围/基准按内容盒（sw/sh=内容盒数字，x0/y0 的 w/h 内容盒化）
                    _mx2, _my2 = build_move_xy_expr(
                        _mv2, _content_box_expr(x_expr, wm_w2, wm_h2),
                        _content_box_expr(y_expr, wm_w2, wm_h2),
                        adapted_wm2, sw=str(wm_w2), sh=str(wm_h2))
                    if _mx2 is not None:
                        x_expr = _mx2.replace("W", "main_w").replace("H", "main_h")
                        y_expr = _my2.replace("W", "main_w").replace("H", "main_h")
                    else:
                        x_expr = _content_box_expr(x_expr, wm_w2, wm_h2)
                        y_expr = _content_box_expr(y_expr, wm_w2, wm_h2)
                else:
                    # 基准位置必须求值成数字：mpv overlay 只认数值/原生变量，
                    # 字符串替换残留（如 main_720-720-10）会让 mpv 只出进程无画面。
                    # w/h 用内容盒（wm_w2/wm_h2）；旋转偏移统一在下面减。
                    _ctx2 = {"W": _main_w, "H": _main_h, "w": wm_w2, "h": wm_h2}
                    _xv2 = safe_eval_expr(x_expr, _ctx2)
                    _yv2 = safe_eval_expr(y_expr, _ctx2)
                    x_expr = str(_xv2) if _xv2 is not None else str(_main_w - wm_w2 - 10)
                    y_expr = str(_yv2) if _yv2 is not None else str(_main_h - wm_h2 - 10)
                if _rot2v:
                    if _wp_zoom2:
                        # 轨迹缩放把叠加盒整体放大 z(t) 倍 → 中心对齐偏移同乘 z(t)
                        x_expr = f"({x_expr}) - ({_wp2[3]})*{_off2x:.6g}"
                        y_expr = f"({y_expr}) - ({_wp2[3]})*{_off2y:.6g}"
                    else:
                        x_expr = f"({x_expr}) - {_off2x:.6g}"
                        y_expr = f"({y_expr}) - {_off2y:.6g}"
                # enable 表达式：显示时段/循环控制（起始/结束/周期/单次）优先——与正式命令同一套
                # _calc_enable_expr；未设显示控制时：手动 -t 优先，否则自动取主视频时长 →
                # enable='lt(t,T)' + eof_action=pass（movie 源自带的音频不再被 shortest 截断输出）。
                try:
                    _wm_dur = self._get_media_duration(wm_file)
                except Exception:
                    _wm_dur = None
                _ov_expr = self._calc_enable_expr(adapted_wm2, _wm_dur)
                if _ov_expr == "1":
                    if manual_t is not None:
                        _ov_expr = f"lt(t,{_ffsec(manual_t)})"
                    else:
                        try:
                            # 图片主视频：时长探测只有 ~0.04s ⇒ enable=lt(t,0.04) 会让子视频
                            # 只显示 0.04 秒（用户报的「瞬间消失」）。图片按「显示时长」算。
                            if _is_static_image_file(file_path):
                                _main_dur = _eff_image_display_duration(settings)
                            else:
                                _main_dur = self._get_media_duration(file_path)
                        except Exception:
                            _main_dur = None
                        if _main_dur and _main_dur > 0:
                            _ov_expr = f"lt(t,{_ffsec(_main_dur)})"
                _blend2 = (str(adapted_wm2.get('blend_mode', 'normal') or 'normal')).strip().lower()
                if _blend2 != 'normal':
                    # 降级判定（用户拍板）：pad 画布大于主视频渲染尺寸 → blend 脱离主视频
                    # 像素、与黑混合无意义 → 强制普通叠加（走下方 normal 分支，W/H=pad 画布）
                    _dgp = self._blend_downgrade_pad(settings, file_path)
                    if _dgp:
                        self._append_info_ui(
                            f"[混合模式] pad 画布 {_dgp[0]}x{_dgp[1]} 大于主视频渲染尺寸，"
                            f"blend({_blend2}) 已降级为普通叠加（脱离主视频像素的混合无意义）")
                        _blend2 = 'normal'
                if _blend2 != 'normal':
                    # 区域化 blend（与正式命令/合并页预览共用 _make_blend_region）：
                    # 旋转（自旋转/静态角度）时区域=对角线 d（需求2：不切旋转内容）；
                    # 轨迹动态跟随（方案C：h/v/diamond/corners 全支持，crop 窗口跟动效）。
                    _rot2 = overlay_rotation_active(adapted_wm2, wp_rot=_wp_rot2)
                    _bw2, _bh2 = _blend_region_size(wm_w2, wm_h2, _rot2)
                    _dx2 = _dy2 = None
                    if _mv2:
                        # ⚠️ 盒尺寸**不 clamp 到画布、不偶数化**（2026-10-08 修正，与封装页实时
                        # 预览/正式命令同口径）：越界裁剪与偶数对齐由下游统一收尾
                        # （_blend_region_bbox / _blend_static_geometry 都自带「夹进画布 + 只缩不增」）
                        # —— 它们只属于 **crop 区域**；先 clamp 会连**中心对齐偏移 (d-w)/2**
                        # 一起算小 → 旋转水印的 blend 区域比成片小、落位整体偏下。
                        # 定位语义：轨迹范围/基准按内容盒（x0/y0 的 w/h 内容盒化，sw/sh=内容盒），
                        # 区域位置 = 内容盒位置 - 中心对齐偏移，再 clamp 到画布内（crop 不越界）。
                        _ms2b = dict(adapted_wm2)
                        _ms2b["overlay_x"] = _content_box_expr(
                            _ms2b.get("overlay_x", DEFAULT_OVERLAY_X), wm_w2, wm_h2)
                        _ms2b["overlay_y"] = _content_box_expr(
                            _ms2b.get("overlay_y", DEFAULT_OVERLAY_Y), wm_w2, wm_h2)
                        if _mv2 == "waypoints":
                            # 列表轨迹：x/y 为画布绝对像素（数字）表达式，直接作动态区域位置
                            # （与转换页图片水印普通叠加的 waypoints 分支同源；旋转中心偏移由下方
                            # _content_box_shift 统一处理，zoom 跟随在下方随 z(t) 缩放）。
                            if _wp2 is not None and _wp2[0] is not None:
                                _dx2, _dy2 = _wp2[0], _wp2[1]
                            else:
                                _dx2, _dy2 = _blend_move_exprs(_mv2, _ms2b, wm_w2, wm_h2)
                        else:
                            _dx2, _dy2 = _blend_move_exprs(_mv2, _ms2b, wm_w2, wm_h2)
                    # ---- 包围盒模型（方案 A，2026-10-07）：bbox 静态，落位 overlay 动态 ----
                    # 旧模型用 crop 从主视频裁一个动态窗口再 blend，而 crop 的 w/h 只在 init 求值
                    # 一次 ⇒ 窗口尺寸无法逐帧跟随缩放 z(t)（列表轨迹缩放必崩）。新模型：包围盒
                    # 静态（覆盖轨迹全程扫掠），动的是「落位 overlay」（place_x/y 相对包围盒原点），
                    # 缩放/旋转/轨迹随便动；隔离由透明画布 α 自动锁死（Cairo bounded blend 语义）。
                    _blend_sc2 = None
                    _pl_name2 = None
                    _bx02 = _by02 = "0"
                    _bbox2 = None
                    if _dx2 is not None:
                        # 1) 静态包围盒：waypoints 走 _blend_wp_bbox；表达式轨迹走
                        #    _blend_move_envelope + _blend_region_bbox。
                        if _mv2 == "waypoints":
                            _off2bs, _off2cs = _content_box_shift(wm_w2, wm_h2, _bw2, _bh2)
                            _bbox2 = _blend_wp_bbox(_main_w, _main_h, _bw2, _bh2,
                                                   adapted_wm2.get("move_waypoints"),
                                                   _off2bs, _off2cs)
                        else:
                            _ctx2b = {"W": _main_w, "H": _main_h, "w": wm_w2, "h": wm_h2}
                            _bxb2 = safe_eval_expr(_content_box_expr(
                                str(adapted_wm2.get("overlay_x", DEFAULT_OVERLAY_X)),
                                wm_w2, wm_h2), _ctx2b)
                            _byb2 = safe_eval_expr(_content_box_expr(
                                str(adapted_wm2.get("overlay_y", DEFAULT_OVERLAY_Y)),
                                wm_w2, wm_h2), _ctx2b)
                            _bxb2 = int(round(float(_bxb2))) if _bxb2 is not None else 0
                            _byb2 = int(round(float(_byb2))) if _byb2 is not None else 0
                            if _rot2:
                                _off2d, _off2e = _content_box_shift(wm_w2, wm_h2, _bw2, _bh2)
                                _bxb2 -= int(round(_off2d)); _byb2 -= int(round(_off2e))
                            _bbox2 = _blend_region_bbox(
                                _blend_move_envelope(_mv2, _main_w, _main_h, _bw2, _bh2,
                                                     _bxb2, _byb2), _main_w, _main_h)
                        if _bbox2 is not None:
                            _bx2, _by2, _bbw2, _bbh2 = _bbox2
                            # 2) 落位坐标（相对包围盒原点）：内容盒左上（画布绝对） - 包围盒原点。
                            #    waypoints 的 xa/ya 是中心基准，需先减中心对齐偏移；表达式轨迹
                            #    _blend_move_exprs 直接给左上基准，无需再减。
                            _px2, _py2 = _dx2, _dy2
                            if _mv2 == "waypoints":
                                # 中心对齐偏移随 z(t) 同乘（_blend_place_off_exprs）
                                _sx2e, _sy2e = _blend_place_off_exprs(
                                    wm_w2, wm_h2, _bw2, _bh2, _wp2)
                                _px2 = f"({_px2}) {_sx2e}"
                                _py2 = f"({_py2}) {_sy2e}"
                            _place_x2 = f"({_px2}) - {_bx2}"
                            _place_y2 = f"({_py2}) - {_by2}"
                        else:
                            _dx2 = _dy2 = None
                    # blend 区域 sendcmd 驱动（长列表突破表达式段数墙）：列表 > 阈值时位置改用
                    # 命令文件驱动「落位 overlay 单节点」（新模型包围盒静态、只有落位 overlay
                    # 要跟随，故 targets 仅 overlay@plW；后缀在中心对齐偏移之上再减包围盒原点
                    # bx/by，把画布绝对位置换算成相对包围盒原点的落位坐标）。base 用首区间常量。
                    if (_wp2 is not None and _mv2 == "waypoints" and _bbox2 is not None
                            and len([w for w in (adapted_wm2.get("move_waypoints") or [])
                                      if isinstance(w, dict)]) > _wp_sc_rows_limit()):
                        # 落位区间 = position + zoom 合并（2026-10-08）：zoom 折进区间值，
                        # filtergraph 不再含 max(0.01,Z(t))。offset 与包围盒原点同 _blend_place_off_exprs。
                        _offx2, _offy2 = _content_box_shift(wm_w2, wm_h2, _bw2, _bh2)
                        _wp2_iv = build_waypoint_placement_intervals(
                            adapted_wm2.get("move_waypoints"), _offx2, _offy2, _bx2, _by2)
                        if _wp2_iv:
                            _pl_name2 = "plW"
                            _blend_sc2 = self._write_waypoint_sendcmd_file(
                                _wp2_iv, tag="blendWM", targets=["overlay@plW"])
                            if _blend_sc2 is not None:
                                if _wp2_iv[0][2] == "hide":
                                    _bx02 = _by02 = "-100000"
                                else:
                                    # ⚠️ 首帧基值 = 合并区间首段端点值（已含 zoom*off - bx），
                                    # 与命令值同语义，见正式命令同款
                                    _bx02 = f"{_wp2_iv[0][3]:g}"
                                    _by02 = f"{_wp2_iv[0][4]:g}"
                    if _dx2 is not None:
                        # 动态轨迹 blend：落位 overlay 跟随动效表达式 / sendcmd
                        if _blend_sc2 is not None:
                            # sendcmd 驱动落位：base 用首区间常量（sendcmd 覆盖其余帧）
                            _place_x2 = f"{_bx02}"
                            _place_y2 = f"{_by02}"
                        # 单水印：cur 只出现一次 → split=2 出区域来源/合成目标（防同一 label 双消费）
                        fg.split(2, "[cur_cr2][cur_ov2]")
                        fg.extend(self._make_blend_region(
                            "cur_cr2", "sub_rot", "cur_ov2", _bx2, _by2, _bbw2, _bbh2,
                            _place_x2, _place_y2, _blend2, "v_wm", "wm", ":eof_action=pass",
                            place_name=_pl_name2, sc_file=_blend_sc2,
                            # ⚠️ 带逐帧缩放时必须前置 format=rgba（见 _make_blend_region 第3步铁律）
                            slr_scale_before=bool(_wp2 is not None and _wp2[3] is not None)))
                    else:
                        # 静态位置 blend：基准坐标独立求值（内容盒语义），旋转时叠加盒
                        # 中心对齐内容盒（减偏移）；区域尺寸由 _blend_static_geometry clamp。
                        _ctx2b = {"W": _main_w, "H": _main_h, "w": wm_w2, "h": wm_h2}
                        _tb = safe_eval_expr(_content_box_expr(
                            str(adapted_wm2.get("overlay_x", DEFAULT_OVERLAY_X)), wm_w2, wm_h2), _ctx2b)
                        _bxv2 = int(round(float(_tb))) if _tb is not None else _main_w - wm_w2 - 10
                        _tb = safe_eval_expr(_content_box_expr(
                            str(adapted_wm2.get("overlay_y", DEFAULT_OVERLAY_Y)), wm_w2, wm_h2), _ctx2b)
                        _byv2 = int(round(float(_tb))) if _tb is not None else _main_h - wm_h2 - 10
                        if _rot2:
                            _off2d, _off2e = _content_box_shift(wm_w2, wm_h2, _bw2, _bh2)
                            _bxv2 -= int(round(_off2d))
                            _byv2 -= int(round(_off2e))
                        _bbx2, _bby2, _bbw2, _bbh2, _bsx2, _bsy2 = self._blend_static_geometry(
                            _bxv2, _byv2, _bw2, _bh2, _main_w, _main_h)
                        if _bbw2 >= 2 and _bbh2 >= 2:
                            fg.split(2, "[cur_cr2][cur_ov2]")
                            fg.extend(self._make_blend_region(
                                "cur_cr2", "sub_rot", "cur_ov2", _bbx2, _bby2, _bbw2, _bbh2,
                                str(_bsx2), str(_bsy2), _blend2, "v_wm", "wm", ":eof_action=pass"))
                        else:
                            # 水印完全在画布外，跳过混合（保持主画面）
                            fg.chain("null", "v_wm")
                    self._append_info_ui(f"[预览] 图片水印：mpv 区域化 blend 真实合成（{_blend2}）")
                else:
                    if _ov_expr != "1":
                        fg.combine("[sub_rot]", f"overlay=x='{x_expr}':y='{y_expr}':enable='{_ov_expr}':eof_action=pass", "v_wm")
                    else:
                        # 兜底：拿不到任何时长信息退回 shortest=1
                        fg.combine("[sub_rot]", f"overlay=x='{x_expr}':y='{y_expr}':enable='1':shortest=1", "v_wm")
                self._append_info_ui(f"[预览] 图片水印：mpv movie 真实合成（{wm_w2}x{wm_h2}）")
            # ---- 文字水印：普通 drawtext（含显示时段/循环 enable）或旋转子图都接入 ----
            # 旋转时走透明层子图（eof_action=pass）；非旋转直接 drawtext 片段（enable 由
            # _build_drawtext_enable 生成：显示时段 between / 循环 lt(mod(t,L),D)）。
            if _tw_enabled:
                # 文字水印定位同含「原始画面空间」的绝对像素（overlay_x/y 默认 "10"、列表
                # 轨迹航点）→ 与图片水印同款换算（用 settings 副本，不改原 dict）。
                _tw_in = settings
                if _pwf != 1.0:
                    _tw_in = dict(settings)
                    _tw_in["text_watermark_items"] = [
                        _pipe_scale_pos_settings(_i, _pwf) if isinstance(_i, dict) else _i
                        for _i in (settings.get("text_watermark_items") or [])]
                    if isinstance(settings.get("text_watermark"), dict):
                        _tw_in["text_watermark"] = _pipe_scale_pos_settings(
                            settings["text_watermark"], _pwf)
                tw_frag = build_text_watermark_chain(_tw_in, main_label=fg.cur, out_label="[v_tw]")
                if tw_frag:
                    if manual_t is not None:
                        tw_frag = tw_frag.replace(":format=auto",
                                                  f":format=auto:eof_action=pass:enable='lt(t,{_ffsec(manual_t)})'")
                    elif _tw_rotate:
                        tw_frag = tw_frag.replace(":format=auto", ":format=auto:eof_action=pass")
                    fg.raw(tw_frag, advance_to="v_tw")
                    self._append_info_ui(_("[预览] 文字水印：mpv lavfi-complex 预览"))
            # ---- 屏幕缩放 / 兜底 null 输出 ----
            fg.chain(scale_expr, "VOUT") if scale_expr else fg.chain("null", "VOUT")
            # ---- 音频 passthrough（仅当源含音频流；无音频不引用 [AIN]，避免 mpv 报错） ----
            has_audio = False
            info = self._get_cached_stream_info(file_path)
            if info:
                has_audio = any(s.get("codec_type") == "audio" for s in info.get("streams", []))
            if has_audio:
                fg.link("[AIN]", "anull", "AOUT")
            lavfi_complex_str = fg.build()

        # ----- 5. 普通路径：文字水印 drawtext + 图片水印占位框 + 缩放 -----
        # 注：文字水印旋转/图片水印真实合成统一走上方复杂图分支（[VIN]/[VOUT] 占位），
        # ffplay 不可用时间接经 _lavfi_complex_to_ffplay 出合成画面；此处仅处理普通 drawtext + 占位框。
        #
        # ✅ 2026-10-06 本块【已恢复可达】：上方 4b 分支判据恢复成
        #    `canvas / 文字水印旋转 / 图片水印 / 多级网格 / before 等宽边框` 判据后，
        #    无上述开关的设置会走本块 ⇒ 预览形状与成片命令一致（成片此时也是 -vf 逗号链）。
        # 📌 本块与成片 `_generate_ffmpeg_command_core` 的 else 分支**同源同口径**：
        #    两边都是 `build_video_filter_chain` 链主体 + `build_drawtext_chain_vf` 追加 + scale。
        #    若日后在本块加功能，注意成片对应位置也要同步改，否则又变成两套实现。
        if not lavfi_complex_str and not filter_chain:
            if drawbox_expr:
                filter_parts.append(f"drawbox={drawbox_expr}")
            _ts0, _sp0 = _trim_speed_from_settings(settings)
            dt = build_drawtext_chain_vf(tw_settings, _tw_items,
                 trim_start=_ts0, speed_factor=_sp0)
            if dt:
                filter_parts.append(dt)
                self._append_info_ui(_("[预览] 已添加文字水印 drawtext"))
            if scale_expr:
                filter_parts.append(scale_expr)
            filter_chain = ",".join(filter_parts) if filter_parts else ""
    
        # ----- 4. 音频滤镜（变速 / 音量 / EQ / 降噪） -----
        extra_args = []
        af_filters = []
        if settings.get("audio_speed_enabled", False):
            try:
                factor = float(settings.get("audio_speed_factor", "1.0"))
                if factor != 1.0 and factor > 0:
                    atempo = build_atempo_chain(factor)
                    if atempo:
                        af_filters.append(atempo)
            except ValueError:
                pass
        if settings.get("volume_enabled", False):
            try:
                vol = float(settings.get("volume", 1.0))
                if vol != 1.0:
                    af_filters.append(f"volume={vol:.2f}")
            except (ValueError, TypeError):
                pass
        if settings.get("eq_enabled", False):
            try:
                eq_low = float(settings.get("eq_low", 0) or 0)
                eq_mid = float(settings.get("eq_mid", 0) or 0)
                eq_high = float(settings.get("eq_high", 0) or 0)
                if eq_low != 0:
                    af_filters.append(f"bass=g={eq_low:.1f}")
                if eq_mid != 0:
                    af_filters.append(f"equalizer=f=1000:width_type=h:width=200:g={eq_mid:.1f}")
                if eq_high != 0:
                    af_filters.append(f"treble=g={eq_high:.1f}")
            except (ValueError, TypeError):
                pass
        if settings.get("denoise_enabled", False):
            if settings.get("denoise_method") == "arnndn":
                af_filters.append("arnndn")
            else:
                af_filters.append("afftdn=nr=12:nf=-30")
        if af_filters:
            af_chain = ",".join(af_filters)
            extra_args.extend(["-af", af_chain])
    
        # ----- 5. 截取参数 -----
        start_sec = None
        duration = None
        # 实时倒放时跳过 --start/--length：backward 模式的跳转语义是"从某位置倒着播"，
        # 与正向截取起点不符 → 直接整段从末尾倒放（小文件实时预览即可）。
        _rev_active = "--play-direction=backward" in mpv_only_args
        # 读覆盖前保存的原始截取参数（16132 已把副本 trim_enabled 置 False，直接读副本会永不跳转）
        if _preview_trim_enabled and not _rev_active:
            start_sec = time_to_seconds(_preview_trim_start) if _preview_trim_start else None
            end_sec = time_to_seconds(_preview_trim_end) if _preview_trim_end else None
            if start_sec is not None and end_sec is not None and end_sec > start_sec:
                duration = end_sec - start_sec
            # 只有开始时间，播放到末尾
        if _rev_active:
            self._append_info_ui(_("[预览] 实时倒放预览：整段从末尾向前播放（忽略截取起点跳转）。"))
    
        # ===== 画布模式（位置、尺寸、旋转）预览：画布滤镜图完全接管视频链 =====
        # 预览 = 播放器原生 --start 跳转（无 trim/setpts）→ 滤镜 t = 原始时间戳 →
        # 段 start/dur 不换算（与转换命令 _timeline_convert 换算形成刻意差异，见 MEMORY 铁律）。
        # 故 build_canvas_filtergraph 传 trim_start=0 / speed=1。
        _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
        if _canvas_on:
            _cw, _ch = self._get_video_dimensions_cached(file_path)
            if not _cw or not _ch:
                _cw, _ch = 1280, 720
            # 工作分辨率上限（2026-09-21）：画布尺寸等比降到降采样尺寸（画布图把主视频缩放进
            # 内容盒，画布小了主视频跟着小 → 图计算量按 f² 下降；GPU 路线不动）。
            if _pwf != 1.0:
                _cw = max(2, int(_cw * _pwf) // 2 * 2)
                _ch = max(2, int(_ch * _pwf) // 2 * 2)
            _cg = build_canvas_filtergraph(settings, _cw, _ch, 0.0, 1.0)
            if _cg:
                # 第 2 段（2026-09-02 修复）：主视频画布尊重「缩放」，与正式命令/封装页预览一致
                _canvas_scale = ""
                try:
                    _mcw, _mch = _resolve_crop_size(settings, _cw, _ch) or (_cw, _ch)
                    _mbbw, _mbbh = compute_rendered_size(
                        _mcw, _mch, {**settings, "crop_enabled": False, "rotate": "none"})
                    _mbbw, _mbbh = max(2, int(_mbbw)), max(2, int(_mbbh))
                    if (_mbbw, _mbbh) != (_mcw, _mch):
                        _canvas_scale = f"scale={_mbbw}:{_mbbh}"
                        _cw, _ch = _mbbw, _mbbh
                except Exception:
                    _canvas_scale = ""
                # 画布图（color 源 + overlay 多输入）mpv/ffplay 都能渲染：mpv 走 --lavfi-complex，
                # ffplay 走 _lavfi_complex_to_ffplay（[VIN]→[in]、[VOUT]→[out]）。不再因
                # 「ffplay 无 -filter_complex」而回退原始画面（研究 ffplay-preview 实证 -vf 即完整 filtergraph）。
                _lc = _cg.replace("[0:v]", "[VIN]")
                # 先把唯一终端标签 [v_canvas] 改名，避免下方插入屏幕缩放后出现标签重复冲突
                _lc = _lc.replace("[v_canvas]", "[v_cvs]")
                if _canvas_scale:
                    _lc = _lc + f";[v_cvs]{_canvas_scale}[v_cvs_s]"
                    _term = "[v_cvs_s]"
                else:
                    _term = "[v_cvs]"
                _sc = self._canvas_fit_scale(_cw, _ch, fit=_fit_on)
                if _sc:
                    _lc = _lc + f";{_term}{_sc}[VOUT]"
                else:
                    _lc = _lc.replace(_term, "[VOUT]")
                lavfi_complex_str = _lc
                # 画布图输出 = 画布尺寸（比例可与源不同）→ 管道预览框按画布比例算（2026-09-20）
                _pipe_base_w, _pipe_base_h = _cw, _ch
                filter_chain = ""
                self._append_info_ui(_("[预览] 画布模式预览（mpv/ffplay 共用复杂图，ffplay 无 mpv 时改写 -vf 渲染）"))
            else:
                self._append_info_ui(_("[预览] 画布模式段数据无效，已忽略画布预览"))

        # ----- 5b. 末端处理预览接入（2026-08-27）：split 网格 + 边框 pad，链尾最外层 ----
        # ⚠️ 2026-08-27 实测修正：mpv 的 --vf=lavfi=[...] 不认 [0:v] 前缀、不支持分号多段图
        # （报 "Trailing garbage after a filter" / "not connected to any source"）→ 普通 -vf 路径
        # 不能用 [0:v] 包装/分号段：边框用逗号链末尾追加；split 仅 ffplay（-vf 分号图可用，
        # 第一段无前缀自动接输入）与 lavfi 复杂图（--lavfi-complex=[VOUT] 占位）支持。
        # （_eh_p / _bp / _psr / _psc / _split_ok / _bp_after_split / _bp_before 已在第 4 步缩放前
        #  统一算好 —— 复杂图进入条件要用，这里直接复用，避免两处口径不一致。2026-10-06）
        if _split_ok or _bp:
            if lavfi_complex_str:
                # mpv 复杂图：[VOUT] 段前插 split，[VOUT] 段内加 pad（占位必须保留，映射 [vo]）
                if _split_ok:
                    # before（间隙模型）：网格段内部自带逐格非对称 pad（外围独占、内缝各半），
                    # 不再在 split 之前统一 pad 一圈（旧做法会让格间边框背靠背 = 外围的 2 倍）。
                    _sf = build_end_split_filters(
                        _psr, _psc, in_label="[v_split_in]", out_label="[v_split_out]",
                        border=(build_split_border_cfg(_eh_p) if _bp_before else None))
                    if "null[VOUT]" in lavfi_complex_str:
                        # split 段直接接在 null 段后（去掉 in_label 占位），收尾回 null[VOUT]
                        _insert = _sf.replace("[v_split_in]", "")
                        lavfi_complex_str = lavfi_complex_str.replace(
                            "null[VOUT]", _insert + ";[v_split_out]null[VOUT]")
                    elif scale_expr and f"{scale_expr}[VOUT]" in lavfi_complex_str:
                        # scale 输出先接 [v_pb]，再进 split 网格，最后回 null[VOUT]
                        _insert = _sf.replace("[v_split_in]", "[v_pb]")
                        lavfi_complex_str = lavfi_complex_str.replace(
                            f"{scale_expr}[VOUT]",
                            f"{scale_expr}[v_pb];{_insert};[v_split_out]null[VOUT]")
                if _bp and not _bp_before:
                    if "null[VOUT]" in lavfi_complex_str:
                        lavfi_complex_str = lavfi_complex_str.replace("null[VOUT]", f"null,{_bp}[VOUT]")
                    elif scale_expr and f"{scale_expr}[VOUT]" in lavfi_complex_str:
                        lavfi_complex_str = lavfi_complex_str.replace(
                            f"{scale_expr}[VOUT]", f"{scale_expr},{_bp}[VOUT]")
                    else:
                        # 兜底：仅在字符串末的 [VOUT] 前插入（理论上不会走到）
                        lavfi_complex_str = lavfi_complex_str.replace("[VOUT]", f",{_bp}[VOUT]")
            else:
                # 普通 -vf（mpv --vf=lavfi=[...] / ffplay -vf）：纯逗号链。
                # ⚠️ 2026-08-27 用户实测 + 复验：ffmpeg 链式隐式连接——split=N 的 N 个输出按序接
                # hstack/vstack 的 N 个输入（无需标签），`...,split=N,hstack=inputs=N,pad=...` 在
                # ffplay -vf 与 mpv --vf=lavfi 均可用（T1/T5 实测）→ 单级网格（rows==1 横排 /
                # cols==1 竖排，N=2..5）直接逗号链；多级网格（rows>1 且 cols>1）需 filter_complex
                # 标签，普通路径放弃并提示（复杂预览/实时预览完整支持）。
                #
                # 📌 2026-10-06：本块自判据恢复分情况后**只处理单级网格 + after 边框**。
                #    下方 `_bp_before` 降级段（「先统一 pad 一圈再切网格」⇒ 格间 = 外围 2 倍）已
                #    **恒不可达**：新判据 `_eh_need_complex` 把 `_bp_before` 全部导向复杂图，
                #    与成片间隙模型一致（预览与成片同口径）。保留仅作历史参照，勿改。
                _bp_split_simple = _split_ok and (_psr == 1 or _psc == 1)
                if _split_ok and not _bp_split_simple:
                    self._append_info_ui(
                        _("[预览] 多行网格（split 行×列）在普通预览不支持（需 filter_complex），"
                        "复杂预览/实时预览可用"))
                _tail_comma = []
                if _bp_split_simple:
                    _n = _psr * _psc
                    _seg_split = (f"split={_n},hstack=inputs={_n}" if _psr == 1
                                  else f"split={_n},vstack=inputs={_n}")
                    if _bp_before:
                        # ⚠️ 旧口径降级：普通 -vf 是纯逗号链，表达不了「split 之后逐格分别 pad」——
                        # split 的 N 个输出在逗号链里无法各自接不同的 pad（实测 ffmpeg 报
                        # "expected to have exactly 1 input and 1 output. However, it had 3 input(s)
                        #  and 3 output(s)"）⇒ 这里仍走「先统一 pad 一圈再切网格」（格间 = 外围 2 倍）。
                        # 等宽效果请看复杂预览（mpv lavfi 图）与正式导出，两者均为间隙模型。
                        self._append_info_ui(
                            _("[预览] 多画面拼接的等宽边框需复杂图，普通预览暂用旧口径（格间 2×边框）"))
                        _tail_comma.append(_bp)
                        _tail_comma.append(_seg_split)
                    else:
                        _tail_comma.append(_seg_split)
                if _bp and not _bp_before:
                    _tail_comma.append(_bp)
                if _tail_comma:
                    if filter_chain:
                        filter_chain = filter_chain + "," + ",".join(_tail_comma)
                    else:
                        filter_chain = ",".join(_tail_comma)

        # ===== 图片主视频 + 带时间滤镜的动画修复（2026-09-19，2026-09-21 起 mpv/ffplay 共用）=====
        # 静态图片只解码单帧：最终输出主输入是图片([VIN])时，滤镜图只求值一次，
        # 时间变量 t 卡死（倒计时/轨迹不动）。前置连续 color 基源、图片作被保持次输入，
        # 使 [v0] 变连续流（精确镜像用户验证可用的 fade 写法：连续 color 作主时间轴驱动）。
        # ⚠️ 2026-09-21：此前仅 use_mpv 时 wrap（旧注释称「ffplay 走 -loop 1 天然连续」），
        # 但 ffplay 的 -loop 1 对 image2 实测无效 ⇒ ffplay 图片主既没画面也没有动画。
        # 现 mpv / ffplay 共用同一张图（ffplay 另由图内 loop 前缀续命，见 ffplay_image_main_vf）；
        # 仍不含管道合成模式（pipe_engine 有自己的时长口径，behavior 保持不变）。
        if lavfi_complex_str and _is_static_image_file(file_path) and not pipe_engine:
            try:
                _md = self._get_video_dimensions_cached(file_path)
                _iw = int(_md[0]) if _md and _md[0] else 0
                _ih = int(_md[1]) if _md and _md[1] else 0
            except Exception:
                _iw = _ih = 0
            if _iw <= 0 or _ih <= 0:
                _iw, _ih = 1280, 720
            _img_dur = _eff_image_display_duration(settings)
            lavfi_complex_str = wrap_image_static_timed_complex(
                lavfi_complex_str, base_vf, _iw, _ih, _img_dur)
            self._append_info_ui(
                f"[预览] 图片主视频含时间滤镜：前置连续基源驱动动画"
                f"（color r=30 d={_img_dur:g}，图片作被保持次输入）")

        # ----- 6. 调用播放器（或：管道合成模式走内置时间预览引擎） -----
        if pipe_engine:
            # 「时间预览引擎」（2026-09-20 Phase 1）：同一张合成图改喂 ffmpeg -filter_complex
            # → rawvideo 管道（内置 SimplePreviewer 渲染），零 mpv 依赖 + 保留标记/波形/步进。
            # 仅单输入安全：转换页是单文件，图内除图片水印（movie=）外无其它子输入。
            #
            # aspect（2026-09-20 末端处理修复，照抄封装页画中画分支的口径）：预览框必须按
            # 【末端处理后的真实输出比例】算——split 网格把输出放大 cols×/rows×、边框 pad
            # 再加边距，按源比例算框会被 letterbox（用户实测：转换页平铺拼接 2 格 → 画面缩小
            # 且四周黑边；封装页画中画传了网格比例所以铺满）。网格/边框是否真渲染以插入结果
            # 为准（字符串里查得到才算），与实际渲染路径严格一致：
            #   · 复杂图（lavfi_complex_str）：完整 rows×cols 网格（插入锚点 [v_split_out]）；
            #   · 普通链（filter_chain）：仅单级网格（rows==1 横排 / cols==1 竖排，
            #     split=N,hstack/vstack 纯逗号链）；多级网格普通链不渲染（既有限制）；
            #   · 边框 before（每格带框）仅在网格真渲染时生效；after/无网格 = 加在整体。
            _pe_rows, _pe_cols = 1, 1
            if _split_ok:
                if lavfi_complex_str and "[v_split_out]" in lavfi_complex_str:
                    _pe_rows, _pe_cols = _psr, _psc
                elif ("split=" in (filter_chain or "")
                      and ("hstack=" in filter_chain or "vstack=" in filter_chain)):
                    if _psr == 1:
                        _pe_cols = _psc
                    elif _psc == 1:
                        _pe_rows = _psr
            _pe_ok = (_pe_rows > 1 or _pe_cols > 1)
            # before 模式（间隙模型）：边框已内嵌成网格段的逐格 pad，不再以 _bp 片段出现在图里，
            # 故不能再用「_bp 是否在图中」判定 —— 只要网格真渲染且开了 before 边框就算生效。
            _bp_applied = bool(_bp) and (
                (_bp in (lavfi_complex_str or "") or _bp in (filter_chain or ""))
                or (_bp_before and _pe_ok))
            _pow, _poh = _pipe_base_w * _pe_cols, _pipe_base_h * _pe_rows
            if _bp_applied:
                if _split_ok and _bp_before and _pe_ok:
                    # 间隙模型：外围只加一次，格间由相邻两格各出一半（≠ 每格都 +四边距）
                    _pow, _poh = build_split_grid_size(
                        _pe_rows, _pe_cols, _pipe_base_w, _pipe_base_h,
                        int(_eh_p.get("border_left", 0) or 0),
                        int(_eh_p.get("border_right", 0) or 0),
                        int(_eh_p.get("border_top", 0) or 0),
                        int(_eh_p.get("border_bottom", 0) or 0))
                else:
                    # ⚠️ 用【缩放后】的边距总量（_bsw/_bsh），不能直接用 _sc_w/_sc_h：
                    #   _pipe_base_w/h 已是缩放后的单格尺寸，配未缩放边距 = 单位不一致，
                    #   会让预览框比例算错（画面被 letterbox / 拉伸）。
                    _pow, _poh = _pow + _bsw, _poh + _bsh
            _par = (float(_pow) / _poh) if _poh > 0 else None
            self._open_pipe_time_preview(file_path, settings, lavfi_complex_str,
                                         filter_chain, start_sec, duration, aspect=_par,
                                         extra_kw=extra_kw)
            return
        self.preview_with_player(
            file_path,
            filter_chain,
            extra_args=extra_args,
            start_time=start_sec,
            duration=duration,
            lavfi_complex=lavfi_complex_str,
            mpv_only_args=mpv_only_args,
            image_duration=_eff_image_display_duration(settings),
            precise_seek=True,   # 转换页普通预览：图内无 trim 兜底 ⇒ 精确优先（2026-10-13）
        )

    # ---------- 输出路径生成与命令构建 ----------
    def _sanitize_filename(self, filename: str) -> str:
        """移除 Windows 非法字符，替换为下划线"""
        # Windows 非法字符: \ / : * ? " < > |
        illegal_chars = r'[\\/:*?"<>|]'
        return re.sub(illegal_chars, '_', filename)
    
    def generate_output_path(self, input_path, settings):
        dir_path = settings.get("output_dir") or os.path.dirname(input_path)
        dir_path = normalize_path(dir_path)
        base_name = os.path.basename(input_path)
        name, _unused = os.path.splitext(base_name)
        if settings.get("only_audio", False):
            container = settings.get("audio_format", "m4a")
            _ac = settings.get("audio_codec", "aac")
            _safe = compatible_audio_container(_ac, container)
            if _safe != container:
                self._append_info_ui(
                    _('[仅音频] 容器 «{0}» 与编码器 «{1}» 不兼容，已自动改用 «{2}»（否则 ffmpeg 会因找不到标签而失败）').format(container, _ac, _safe))
                container = _safe
        else:
            container = settings.get("output_container", "mp4")
        custom_name = settings.get("custom_output_name", "").strip()
        if custom_name:
            custom_name = os.path.basename(custom_name)
            # --- 清理非法字符 ---
            custom_name = self._sanitize_filename(custom_name)
            forbidden = {'.', '..', 'CON', 'PRN', 'AUX', 'NUL',
                         'COM1', 'COM2', 'COM3', 'COM4', 'COM5', 'COM6', 'COM7', 'COM8', 'COM9',
                         'LPT1', 'LPT2', 'LPT3', 'LPT4', 'LPT5', 'LPT6', 'LPT7', 'LPT8', 'LPT9'}
            if not custom_name or custom_name in forbidden or (sys.platform == "win32" and custom_name.upper() in forbidden):
                self._append_info_ui(_("警告：自定义文件名无效（空或保留名），已忽略"))
                custom_name = ""
        if custom_name:
            out_name = custom_name
            if not os.path.splitext(out_name)[1]:
                out_name += f".{container}"
        else:
            suffix = settings.get("output_suffix", "").strip()
            in_dir = os.path.dirname(os.path.abspath(input_path))
            out_dir = os.path.abspath(dir_path)
            if not suffix and in_dir == out_dir:
                suffix = "_new"
            out_name = f"{name}{suffix}.{container}"

        # GIF 强制扩展名
        if settings.get("encoder") == "gif":
            base, ext = os.path.splitext(out_name)
            if ext.lower() != ".gif":
                out_name = base + ".gif"

        # WebP 强制扩展名
        if settings.get("encoder") == "libwebp":
            base, ext = os.path.splitext(out_name)
            if ext.lower() != ".webp":
                out_name = base + ".webp"

        # 透明输出（2026-10-09）：绿幕抠像/遮罩/描边/透明度<1.0 → 容器须支持 alpha。
        # 统一走 ProRes 4444 / .mov（唯一被验证「导出后能被本程序重新正确读回 alpha」的路；
        # VP9/WebM 透明路线已删除，见 _ALPHA_CAPABLE_ENCODERS 注释）。
        # ⚠️ 在**输出路径生成**这一层改，是为了让 task.output / 冲突检测 / 「删除源文件」
        #    认到的就是真实文件名（命令内 _generate_ffmpeg_command_core 那处同源升级只是
        #    兜底，幂等）。gif / libwebp 各有透明语义（webp 容器原生带 alpha）→ 排除。
        if (not settings.get("only_audio", False)
                and settings.get("encoder") not in ("gif", "libwebp")
                and self._settings_needs_alpha(settings)):
            base, ext = os.path.splitext(out_name)
            if ext.lower() in (".mp4", ".webm", ".avi", ".flv", ".ts", ".m2ts", ".wmv", ".3gp"):
                out_name = base + ".mov"
                self._log_alpha_once(
                    "conv_mov",
                    _("[转码] 检测到透明需求，输出容器自动升级为 .mov（支持 alpha），已改扩展名"))

        return os.path.join(dir_path, out_name).replace('\\', '/')

    def _generate_gif_command(self, input_path, output_path, settings, verbose=None):
        """
        生成 GIF 编码的 FFmpeg 命令（使用 filter_complex）。
        帧率控制改用 fps 滤镜，而非 -r 选项。

        verbose=None（默认）保持静默，与 _merge_custom_filters_into_cmd 同纪律：
        命令预览每次输入都刷新，无条件打印会刷爆信息区。
        """
        cmd_list = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]
    
        # 快速截取（非精准）在命令行添加 -ss/-to
        if not settings.get("precise_trim", False):
            self._add_trim_params(cmd_list, settings)
    
        # 硬件解码（一般不用于 GIF，但保留）
        self._add_hwaccel_params(cmd_list, settings)
    
        # 输入文件
        cmd_list.extend(["-i", input_path])
    
        # ---- 读取帧率设置 ----
        fps_type = settings.get("frame_rate_type", "keep")
        fps_value = settings.get("frame_rate_custom", "30")
        fps_filter = f"fps={fps_value}" if fps_type == "custom" else ""
        enhance_settings = settings.get("enhance", {})
    
        # 构建预处理滤镜（不含 format 和 subtitle）；GIF 走 filter_complex，强制软件滤镜
        gif_settings = dict(settings); gif_settings["hw_filter_mode"] = "cpu"
        vf = build_video_filter_chain(gif_settings, include_subtitle=False, include_speed=True,reverse=settings.get('reverse_enabled', False),enhance_settings=enhance_settings)
        if vf and vf != "null":
            filters = [f.strip() for f in vf.split(",") if f.strip() and not f.startswith("format=")]
            if fps_filter:
                filters.insert(0, fps_filter)
            pre_vf = ",".join(filters) if filters else ""
        else:
            pre_vf = fps_filter  # 只有帧率滤镜

        # ---- 自定义参数：视频滤镜并进调色板之前的预处理链 ----
        # GIF 的 -filter_complex 是 palettegen/paletteuse 流水线。若走通用路径
        # 「并入末尾链」，滤镜会落到 paletteuse 之后、作用在已量化的 pal8 帧上
        # （调色板等于白算一遍，且 subtitles/drawtext 这类要真彩输入的滤镜会失效）。
        # 故这里先把用户视频滤镜并进 pre_vf，再让其余部分走通用合并。
        custom = settings.get("custom_args", "").strip()
        parsed = self._parse_custom_args(custom)
        if parsed["ok"]:
            if parsed["vf"]:
                pre_vf = self._merge_filter_chains(pre_vf or "null", parsed["vf"], is_audio=False)
            if parsed["af"]:
                # GIF 输出强制 -an，音频滤镜无处可去，留着只会生成无用 -af
                parsed["af"] = []
                if verbose:
                    self._append_info_ui(_("[自定义参数] GIF 输出无音频（-an），音频滤镜已忽略。"))

        # ---- 读取 GIF 参数 ----
        loop = settings.get("gif_loop", 0)          # 0=无限循环
        dither = settings.get("gif_dither", "bayer")
        bayer_scale = settings.get("gif_bayer_scale", 2)
        max_colors = settings.get("gif_max_colors", 256)
    
        # 构建 dither 选项
        if dither == "none":
            dither_opt = "none"
        elif dither == "bayer":
            dither_opt = f"bayer:bayer_scale={bayer_scale}"
        else:
            dither_opt = dither
    
        # ---- 构建 filter_complex（增加 RGB 转换） ----
        if pre_vf:
            complex_filter = (
                f"[0:v]{pre_vf}[v];"
                f"[v]split[v1][v2];"
                f"[v2]format=rgb24[v2_rgb];"
                f"[v1]palettegen=max_colors={max_colors}[palette];"
                f"[v2_rgb][palette]paletteuse=dither={dither_opt}[out]"
            )
        else:
            complex_filter = (
                f"[0:v]split[v1][v2];"
                f"[v2]format=rgb24[v2_rgb];"
                f"[v1]palettegen=max_colors={max_colors}[palette];"
                f"[v2_rgb][palette]paletteuse=dither={dither_opt}[out]"
            )
    
        cmd_list.extend(["-filter_complex", complex_filter])
        cmd_list.extend(["-map", "[out]"])
        cmd_list.extend(["-c:v", "gif"])
    
        # 循环设置（如果 loop != 0，则添加 -loop，否则默认无限循环）
        if loop != 0:
            cmd_list.extend(["-loop", str(loop)])
    
        # 忽略音频
        cmd_list.append("-an")

        # 其余自定义参数（-filter_complex 子图、纯选项等）走通用合并；
        # 视频滤镜已在 pre_vf 里并过，这里跳过避免重复。
        if parsed["ok"]:
            cmd_list = self._apply_custom_args(cmd_list, parsed, verbose=verbose, skip_vf=True)

        # 输出文件
        cmd_list.append(output_path)

        return cmd_list

    def _safe_delete_file(self, path: str):
        """安全删除文件"""
        with suppress(Exception):
            if os.path.exists(path):
                os.unlink(path)

    def _write_temp_script(self, content: str) -> str:
        fd, path = tempfile.mkstemp(suffix='.txt', prefix='ffscript_', text=True)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(content)
        return path
    
    def _shorten_long_filters(self, cmd_list: List[str], threshold: int = 25000, force: bool = False):
#        print(f"[DEBUG] _shorten_long_filters called, force={force}, cmd_list length={len(cmd_list)}")
        # 打印所有参数，看看是否有 -filter_complex
#         for idx, arg in enumerate(cmd_list):
#             if arg in ("-vf", "-af", "-filter_complex"):
#                print(f"[DEBUG] Found {arg} at index {idx}, value length: {len(cmd_list[idx+1]) if idx+1 < len(cmd_list) else 'missing'}")

        # 长滤镜改走「滤镜文件」时用哪个选项名（2026-09-16 实测修正）：
        #   旧名族（4.3~8.x）：-filter_complex_script / -filter_script:v / -filter_script:a
        #   新名族（9.0+，旧名已删）：-/filter_complex / -/vf / -/af（「-/」文件语法 6.1+）
        # ⚠️ 实测坑：4.3 里【没有】-vf_script / -af_script，只有带流选择符的
        #    -filter_script:v / :a —— 之前的映射在 4.3 上必挂。
        # ⚠️ 实测坑2：-filter_complex_script 与 -filter_script 在 9.0 上同时消失，
        #    但二者区间未必永远一致，故分别探测而不是共用一个判断。
        _has_fcs = ffmpeg_has_option(self.ffmpeg_cmd, "-filter_complex_script")
        _has_fs = ffmpeg_has_option(self.ffmpeg_cmd, "-filter_script")
        script_map = {
            "-vf": "-filter_script:v" if _has_fs else "-/vf",
            "-af": "-filter_script:a" if _has_fs else "-/af",
            "-filter_complex": "-filter_complex_script" if _has_fcs else "-/filter_complex",
        }
        new_cmd = []
        temp_files = []
        i = 0
        while i < len(cmd_list):
            arg = cmd_list[i]
            if arg in script_map and i + 1 < len(cmd_list):
                filter_str = cmd_list[i + 1]
                if force or len(filter_str) > threshold:
                    script_path = self._write_temp_script(filter_str)
                    temp_files.append(script_path)
                    new_cmd.append(script_map[arg])
                    new_cmd.append(script_path)
                    i += 2
                    continue
            new_cmd.append(arg)
            i += 1
        return new_cmd, temp_files
    
    def _cleanup_temp_files(self, file_list):
        for f in file_list:
            with suppress(Exception):
                if os.path.exists(f):
                    os.unlink(f)

    # ========== 自定义滤镜自动合并系统 ==========
    # 视频滤镜优先级表（数值越小越靠前，与 build_video_filter_chain 顺序一致）
    _VF_PRIORITY = {
        "trim": 1, "delogo": 2, "boxblur": 2, "gblur": 2,
        "crop": 3, "transpose": 4, "vflip": 4, "hflip": 4,
        "scale": 5, "fieldmatch": 6, "decimate": 6,
        "yadif": 7, "bwdif": 7, "deblock": 8, "hqdn3d": 9,
        "unsharp": 10, "colormatrix": 11, "eq": 12, "hue": 12,
        "fps": 13, "format": 14,
        "subtitles": 16, "drawtext": 16, "overlay": 16,
        "reverse": 17,
    }
    # 允许叠加的滤镜（不会替换已有同类型，而是追加）
    _VF_CUMULATIVE = {"subtitles", "drawtext", "overlay"}
    # 音频滤镜优先级表（与 _build_audio_encoding_params 顺序一致）
    _AF_PRIORITY = {
        "volume": 1, "atempo": 2, "afftdn": 3, "loudnorm": 4,
        "pan": 5, "bass": 6, "equalizer": 6, "treble": 6,
        "afade": 7, "areverse": 8,
    }
    # 裸（非引号内）反斜杠后接这些字符时属转义语义，_unbackslash_for_shlex 原样保留。
    # filtergraph 里 '\:' 转义冒号、'\,' 转义逗号、'\[' 转义标签，都不能动。
    _BS_ESCAPE_NEXT = ":\"'\\,;[]"
    # 无参数滤镜白名单：这类滤镜串里没有 '='，无法靠 '=' 判定是不是滤镜，
    # 不列入就会被当成输出文件名追加到命令末尾（ffmpeg 报 "Unable to find a suitable output format"）。
    _VF_NOARG = {"hflip", "vflip", "null", "copy", "reverse", "negate", "gray", "histeq"}
    _AF_NOARG = {"anull", "acopy", "areverse", "asplit"}
    # 布尔开关（**不带值**的 ffmpeg 选项）：做「选项+值」配对时必须排除，
    # 否则它们会把后面紧跟的 token 误吞成自己的值（如 `-vn scale=1280:720`
    # 会被拼成 `-vn scale=1280:720` 这种非法组合）。
    _FFMPEG_BOOLEAN_OPTS = frozenset((
        "-y", "-n", "-nostdin", "-hide_banner", "-nostats", "-shortest",
        "-vn", "-an", "-sn", "-dn", "-copyts", "-accurate_seek", "-seek2any",
        "-ignore_unknown", "-copy_unknown", "-benchmark", "-dump", "-hex", "-re",
    ))

    def _unbackslash_for_shlex(self, s: str) -> str:
        """把「非转义用」的裸反斜杠换成正斜杠，避免 shlex 吃掉 Windows 路径。

        shlex.split 在 posix 模式下把反斜杠当转义符，会直接吞掉路径分隔符：
            'subtitles=D:\\a\\b.srt'  →  'subtitles=D:ab.srt'
        单/双引号内的反斜杠 shlex 会原样保留，故只处理**裸状态**下的反斜杠；
        后接 : " ' \\ , ; [ ] 时是转义语义，保持不动（如 drawtext 的 '\\:'）。
        ffmpeg 在 Windows 上原生接受 '/' 作路径分隔符，转换后语义不变。
        """
        if "\\" not in s and not re.search(r"[A-Za-z]:[\\/]", s):
            return s
        out = []
        in_single = False
        in_double = False
        i = 0
        n = len(s)
        while i < n:
            ch = s[i]
            if ch == "'" and not in_double:
                in_single = not in_single
                out.append(ch)
            elif ch == '"' and not in_single:
                in_double = not in_double
                out.append(ch)
            elif ch == "\\" and not in_single and not in_double:
                nxt = s[i + 1] if i + 1 < n else ""
                if nxt and nxt in self._BS_ESCAPE_NEXT:
                    # 裸转义要叠到 4 层反斜杠：shlex 吃掉一半 → '\\:' →
                    # ffmpeg filtergraph 再吃掉一半 → 字面 ':'。
                    # 只叠 2 层实测不够：真机报 "No option name near '/nope/x.ttf'"，
                    # 说明 '\:' 只过了一层解析，冒号仍被当选项分隔符。
                    out.append("\\\\\\\\:" if nxt == ":" else "\\" + nxt)
                    i += 1
                else:
                    out.append("/")
            elif (ch == ":" and not in_single and not in_double
                  and i + 1 < n and s[i + 1] in "\\/"
                  and self._drive_colon_at(s, i) and self._has_more_sep(s, i + 1)):
                # 盘符冒号（C:/ C:\）：'\' 转 '/' 后冒号仍在，同样要叠到 4 层。
                out.append("\\\\\\\\:")
            else:
                out.append(ch)
            i += 1
        return "".join(out)

    @staticmethod
    def _drive_colon_at(s, i):
        """s[i] 是 ':' 或 '\\' 时，判断它前面的字母是不是盘符（D: 而非 a\\:b 这种键名）。"""
        return (i >= 1 and s[i - 1].isascii() and s[i - 1].isalpha()
                and (i == 1 or not s[i - 2].isalnum()))

    @staticmethod
    def _has_more_sep(s, j):
        """从 j 往后（遇到空白/引号为止）是否还有路径分隔符，用来区分 C:\\a\\b 与 a\\:b。"""
        for k in range(j, len(s)):
            c = s[k]
            if c in " \t'\"":
                return False
            if c in "\\/":
                return True
        return False

    @staticmethod
    def _parse_filter_list(filter_str):
        """智能拆分逗号分隔的滤镜链，正确处理引号和括号内的逗号。
        含 ';' 的子图块整体保留为一个元素。返回滤镜字符串列表。"""
        if not filter_str or filter_str == "null":
            return []
        if ";" in filter_str:
            return [filter_str]
        filters = []
        current = []
        depth = 0
        in_single = False
        in_double = False
        for ch in filter_str:
            if ch == "'" and not in_double:
                in_single = not in_single
                current.append(ch)
            elif ch == '"' and not in_single:
                in_double = not in_double
                current.append(ch)
            elif ch == "(" and not in_single and not in_double:
                depth += 1
                current.append(ch)
            elif ch == ")" and not in_single and not in_double:
                depth -= 1
                current.append(ch)
            elif ch == "," and depth == 0 and not in_single and not in_double:
                f = "".join(current).strip()
                if f:
                    filters.append(f)
                current = []
            else:
                current.append(ch)
        f = "".join(current).strip()
        if f:
            filters.append(f)
        return filters

    @staticmethod
    def _get_filter_name(filter_str):
        """提取滤镜基名。如 'scale=1280:-2' → 'scale'"""
        if not filter_str:
            return ""
        eq_idx = filter_str.find("=")
        return filter_str[:eq_idx] if eq_idx >= 0 else filter_str

    def _get_vf_priority(self, filter_str):
        """获取视频滤镜优先级。setpts 含 STARTPTS→1(截取)，否则→15(变速)。"""
        name = self._get_filter_name(filter_str)
        if name == "setpts":
            return 1 if "STARTPTS" in filter_str else 15
        return self._VF_PRIORITY.get(name, 50)

    def _get_af_priority(self, filter_str):
        """获取音频滤镜优先级。"""
        name = self._get_filter_name(filter_str)
        return self._AF_PRIORITY.get(name, 50)

    def _merge_filter_chains(self, existing_str, new_filters, is_audio=False):
        """将 new_filters 合并到 existing_str 滤镜链中。
        同名滤镜默认替换（叠加白名单除外），不同名按优先级插入。"""
        existing = self._parse_filter_list(existing_str)
        if not existing:
            return ",".join(new_filters)
        if ";" in existing_str:
            return existing_str + ("," + ",".join(new_filters) if new_filters else "")

        for nf in new_filters:
            nf_name = self._get_filter_name(nf)
            nf_pri = self._get_af_priority(nf) if is_audio else self._get_vf_priority(nf)
            cumulative = self._VF_CUMULATIVE if not is_audio else set()

            replaced = False
            if nf_name and nf_name not in cumulative:
                for idx, ef in enumerate(existing):
                    if self._get_filter_name(ef) == nf_name:
                        existing[idx] = nf
                        replaced = True
                        break

            if not replaced:
                insert_idx = len(existing)
                for idx, ef in enumerate(existing):
                    ep = self._get_af_priority(ef) if is_audio else self._get_vf_priority(ef)
                    if ep > nf_pri:
                        insert_idx = idx
                        break
                existing.insert(insert_idx, nf)

        return ",".join(existing) if existing else "null"

    def _replace_cmd_flag(self, cmd_list, flag, new_value):
        """在 cmd_list 中查找 flag 并替换其后一个参数的值。不存在则追加。"""
        for j, arg in enumerate(cmd_list):
            if arg == flag and j + 1 < len(cmd_list):
                cmd_list[j + 1] = new_value
                return
        cmd_list.extend([flag, new_value])

    def _merge_into_filtergraph(self, existing, new_filters):
        """把 new_filters 并入一条 filtergraph 串（-filter_complex 的值），末尾输出标签保持不变。

        三种输入分别处理：
        • 含 '[' 的项（用户写的带标签子图）→ 用 ';' 作为独立子图追加，不能塞进已有链
          （'body,[0:v]xxx[v]' 语法非法）。
        • 纯滤镜 → 并入末尾那条链，走 _merge_filter_chains（同名替换 + 按优先级插入）。
        • 空图 → 直接建链。
        """
        if not existing:
            return ",".join(new_filters)
        s = existing.rstrip()
        graphs = [f for f in new_filters if "[" in f]
        chained = [f for f in new_filters if "[" not in f]
        m = re.search(r"\[([^\]\s]+)\]\s*$", s)
        body, tail = (s[:m.start()], m.group(1)) if m else (s, None)
        if chained:
            # 只动最后一条 ';' 之后的链；链首的输入标签（[0:v] 等）必须先摘出来，
            # 否则合并后输入标签会被挤到链中间 → filtergraph 语法错误。
            semi = body.rfind(";")
            head, last = (body[:semi + 1], body[semi + 1:]) if semi >= 0 else ("", body)
            inlabs = ""
            nlab = 0
            while last.startswith("["):
                k = last.find("]")
                if k < 0:
                    break
                inlabs += last[:k + 1]
                nlab += 1
                last = last[k + 1:].lstrip(",")
            if nlab >= 2:
                # 多输入链（overlay / concat …）：新滤镜只能接在链尾。
                # 插到链首会让单输入滤镜（scale 等）收到 2 个输入标签 →
                # ffmpeg 报 "More input link labels ... than it has inputs"。
                merged = head + inlabs + (last + "," + ",".join(chained) if last else ",".join(chained))
            else:
                merged = head + inlabs + self._merge_filter_chains(last, chained, is_audio=False)
        else:
            merged = body
        out = (merged + f"[{tail}]") if tail else merged
        if graphs:
            out = out + ";" + ";".join(graphs)
        return out

    def _merge_fc_into_cmd(self, cmd_list, new_filters):
        """把 new_filters 合并到 cmd_list 的 -filter_complex（没有则新建）。
        保留界面已生成的子图与 -map 标签，不整体覆盖。"""
        for j, arg in enumerate(cmd_list):
            if arg == "-filter_complex" and j + 1 < len(cmd_list):
                cmd_list[j + 1] = self._merge_into_filtergraph(cmd_list[j + 1], new_filters)
                return
        cmd_list.extend(["-filter_complex", ",".join(new_filters)])

    def _merge_vf_into_cmd(self, cmd_list, new_filters):
        """找到 cmd_list 中的 -vf/-filter_complex 并合并 new_filters 进去。
        优先合并到 -vf；若只有 -filter_complex，走 _merge_into_filtergraph 并入末尾链。"""
        for j, arg in enumerate(cmd_list):
            if arg == "-vf" and j + 1 < len(cmd_list):
                existing = cmd_list[j + 1]
                cmd_list[j + 1] = self._merge_filter_chains(existing, new_filters, is_audio=False)
                return
        # 回退：如果有 -filter_complex ，并入其末尾链（画布/旋转文字水印路径只有它）
        for j, arg in enumerate(cmd_list):
            if arg == "-filter_complex" and j + 1 < len(cmd_list):
                cmd_list[j + 1] = self._merge_into_filtergraph(cmd_list[j + 1], new_filters)
                return
        cmd_list.extend(["-vf", ",".join(new_filters)])

    def _merge_af_into_cmd(self, cmd_list, new_filters):
        """找到 cmd_list 中的音频滤镜选项（-af，或转换页按轨的 -filter:a:N）并合并进去。"""
        for j, arg in enumerate(cmd_list):
            if (arg == "-af" or arg.startswith("-filter:a")) and j + 1 < len(cmd_list):
                existing = cmd_list[j + 1]
                cmd_list[j + 1] = self._merge_filter_chains(existing, new_filters, is_audio=True)
                return
        cmd_list.extend(["-af", ",".join(new_filters)])

    def _parse_custom_args(self, custom_str):
        """把 custom_args 拆成四类，只做词法分析、不碰命令。

        返回 dict：{"ok", "error", "vf", "af", "fc", "remaining"}。
        ok=False 表示「没内容」或「引号没闭合，shlex 解析失败」，调用方据此决定是否继续。

        单独抽出是为了给 GIF 分支复用：GIF 的 -filter_complex 是调色板流水线，
        用户视频滤镜必须并进调色板**之前**的预处理链，不能走通用的「并入末尾链」。
        """
        empty = {"ok": False, "error": None, "vf": [], "af": [], "fc": [], "remaining": []}
        if not custom_str:
            return empty
        try:
            tokens = shlex.split(self._unbackslash_for_shlex(custom_str))
        except ValueError as e:
            return {"ok": False, "error": e, "vf": [], "af": [], "fc": [], "remaining": []}

        custom_vf = []
        custom_af = []
        fc_custom = []
        remaining = []

        i = 0
        while i < len(tokens):
            t = tokens[i]
            if t in ("-vf", "-filter:v") and i + 1 < len(tokens):
                custom_vf.extend(self._parse_filter_list(tokens[i + 1]))
                i += 2
            elif (t == "-af" or t.startswith("-filter:a")) and i + 1 < len(tokens):
                custom_af.extend(self._parse_filter_list(tokens[i + 1]))
                i += 2
            elif t in ("-filter_complex", "-lavfi") and i + 1 < len(tokens):
                fc_custom.extend(self._parse_filter_list(tokens[i + 1]))
                i += 2
            elif (t.startswith("-") and t not in self._FFMPEG_BOOLEAN_OPTS
                  and i + 1 < len(tokens) and not tokens[i + 1].startswith("-")):
                # ⚠️ 「选项 + 值」必须**配对消费**：旧代码逐 token 处理 ⇒ 值 token 会掉到
                #    下面「裸 key=value 当滤镜」那条分支被吞进 -vf。典型受害：
                #    自定义参数写 `-x265-params bframes=8` ⇒ 旧行为 -vf 里凭空多出
                #    bframes=8（ffmpeg: No such filter），而 -x265-params 自己成了没值的
                #    裸选项（2026-10-08 用户实测 BUG）。
                #    配对条件：下一个 token 不以 '-' 开头（布尔选项后面跟的仍是选项，不能吃）。
                remaining.append(t)
                remaining.append(tokens[i + 1])
                i += 2
            elif not t.startswith("-") and "=" in t:
                fname = self._get_filter_name(t)
                if fname in self._AF_PRIORITY:
                    custom_af.append(t)
                else:
                    custom_vf.append(t)
                i += 1
            elif not t.startswith("-") and t in self._VF_NOARG:
                custom_vf.append(t)
                i += 1
            elif not t.startswith("-") and t in self._AF_NOARG:
                custom_af.append(t)
                i += 1
            else:
                remaining.append(t)
                i += 1
        return {"ok": True, "error": None, "vf": custom_vf, "af": custom_af,
                "fc": fc_custom, "remaining": remaining}

    def _apply_custom_args(self, cmd_list, parsed, verbose=None, skip_vf=False):
        """把 _parse_custom_args 的结果落到 cmd_list 上。

        skip_vf=True 用于 GIF 分支：用户视频滤镜已被并进调色板之前的预处理链，
        这里不能再并一次（否则会落到 paletteuse 之后、作用在已量化的 pal8 帧上）。
        """
        custom_vf = parsed["vf"]
        custom_af = parsed["af"]
        fc_custom = parsed["fc"]
        remaining = parsed["remaining"]

        fc_mode = None
        if fc_custom:
            if any("[" in f for f in fc_custom):
                # 写了 [标签] 的完整滤镜图 = 接管意图：它的输出标签未必被界面 -map 引用，
                # 合并会留下悬空输出（ffmpeg 报 "has output unconnected"）。
                # 这种情况保留整体替换，并把代价明确告诉用户。
                self._replace_cmd_flag(cmd_list, "-filter_complex", ",".join(fc_custom))
                fc_mode = "replace"
            else:
                # 纯滤镜串 → 合并进界面已生成的滤镜图（兑现 tooltip 的"智能合并"）
                self._merge_fc_into_cmd(cmd_list, fc_custom)
                fc_mode = "merge"
        if custom_vf and not skip_vf:
            self._merge_vf_into_cmd(cmd_list, custom_vf)
        if custom_af:
            self._merge_af_into_cmd(cmd_list, custom_af)
        if remaining:
            # 编码器私有参数必须合并、不能直接 extend：ffmpeg「后覆盖前」会把界面
            # 生成的颜色标记 / HDR10 元数据整条吃掉（rc=0 静默，见 merge_private_encoder_params）。
            remaining = self._absorb_private_params(cmd_list, remaining)
            cmd_list.extend(remaining)

        if verbose:
            parts = []
            if fc_mode == "merge":
                parts.append(_('-filter_complex 滤镜图 {0} 项已合并进界面生成的滤镜图').format(len(fc_custom)))
            elif fc_mode == "replace":
                parts.append(_("-filter_complex 已整体替换（界面生成的画布/水印滤镜图不再生效）"))
            if custom_vf and not skip_vf:
                parts.append(_('视频滤镜 {0} 个已合并进 -vf').format(len(custom_vf)))
            if custom_af:
                parts.append(_('音频滤镜 {0} 个已合并进 -af').format(len(custom_af)))
            if remaining:
                parts.append(_('其余 {0} 项参数追加到命令末尾').format(len(remaining)))
            if parts:
                self._append_info_ui(_("[自定义参数] ") + _("；").join(parts) + _("。"))
            if fc_mode == "replace":
                self._append_info_ui(
                    _("[自定义参数] 警告：带 [标签] 的 -filter_complex 会整体替换界面滤镜图，"
                    "原 -map 引用的输出标签可能已不存在；请确保新图里有同名输出标签，"
                    "或改用不带标签的纯滤镜串以走智能合并。"))
            _risky = [t for t in remaining if t in ("-map", "-i")]
            if _risky:
                self._append_info_ui(
                    _("[自定义参数] 警告：") + _("、").join(_risky) +
                    _(" 会与界面已生成的映射/输入叠加（不是替换），多流需求请到「封装」页面处理。"))
        return cmd_list

    def _absorb_private_params(self, cmd_list, remaining):
        """把 remaining 里的 -x264-params / -x265-params / -svtav1-params 合并进 cmd_list。

        这三个参数是「整体一条」语义：ffmpeg 只认最后一条，写两条 = 前一条作废。
        用户在「自定义参数」里写 `-x265-params bframes=8` 时，界面生成的
        `colorprim=bt2020:transfer=smpte2084:master-display=...` 会被整条冲掉且不报错
        （本机实跑坐实，见 merge_private_encoder_params 的注释）⇒ 这里按 key 合并。

        返回剔除已合并项之后的 remaining（剩下的照常追加到命令末尾）。
        """
        if not remaining:
            return remaining
        out = []
        i = 0
        while i < len(remaining):
            t = remaining[i]
            if t in _MERGEABLE_PRIVATE_PARAM_OPTS and i + 1 < len(remaining):
                opt, val = t, remaining[i + 1]
                i += 2
                overridden = merge_private_encoder_params(cmd_list, opt, val)
                if overridden:
                    self._warn_private_params_overridden(opt, overridden)
                continue
            out.append(t)
            i += 1
        return out

    def _warn_private_params_overridden(self, opt, keys):
        """合并冲突提示（去重键防刷屏：命令预览每敲一键就刷新一次）。

        不去重的话，用户每敲一个字符都会往「关键信息」灌一条同样的提示。
        去重键取 (参数名, 被覆盖的 key 集合)，与 _warn_bitdepth_break 同一手法。
        """
        key = (opt, ",".join(sorted(set(keys))))
        if getattr(self, "_pp_warn_key", None) == key:
            return
        self._pp_warn_key = key
        self._append_info_ui(
            _("[自定义参数] ") + opt + _(" 已与界面生成的设置合并——同一参数在 ffmpeg 里写两次会"
            "「后覆盖前」，直接追加会把界面的设置整条冲掉；其中 ") + _("、").join(sorted(set(keys))) +
            _(" 以你填写的值为准。"))

    def _merge_custom_filters_into_cmd(self, cmd_list, custom_str, verbose=None):
        """解析 custom_args 中的滤镜指令，智能合并到现有命令的 -vf/-af/-filter_complex 中。
        识别：裸滤镜串（自动判断视频/音频）、-vf X、-af X、-filter_complex X。

        verbose=None（默认）保持静默：输入框每敲一键都会刷新一次命令预览，
        无条件打印会把信息区刷爆；仅真正执行转换时由调用方传 True 打一次。"""
        parsed = self._parse_custom_args(custom_str)
        if not parsed["ok"]:
            if parsed["error"] is not None:
                self._append_info_ui(_("警告：自定义参数格式错误，已忽略：{0}").format(parsed["error"]))
            return cmd_list
        return self._apply_custom_args(cmd_list, parsed, verbose=verbose)

    def generate_ffmpeg_command(self, input_path: str, output_path: str, settings: dict, task=None, preview=False) -> List[str]:
        """转码命令构建入口（转码页单文件/队列/队列编辑共用，6 处调用点零改动）。
        构建后统一注入末端处理：settings["end_handling"] 各自独立（转换页 _trans_end_handling /
        队列 task.settings 快照 / 队列编辑 task.settings["end_handling"]），互不干扰。
        only_audio 与 GIF 不注入（末端处理是视频语义）。注入失败仅日志提示，不阻塞转码。"""
        cmd_list = self._generate_ffmpeg_command_core(input_path, output_path, settings, task, preview)
        # 2026-08-29（方向B/C）：时间线换算摘要 + 截取终点越界警告。
        # 仅转换命令触发（预览 settings 已禁用 trim → _ts0=0 不打印，te=None 不校验）。
        try:
            _ts0, _sp0 = _main_trim_speed(self, override_settings=settings)
            if _ts0 > 0 or _sp0 != 1.0:
                self._append_info_ui(
                    _('[时间线] 主视频已截取(起点 {0}:.3fs)/变速(×{1}:g)：子功能时间按原始时间填、已自动换算输出时间线（st_out=(st−{2}:.3f)/{3}:g）').format(_ts0, _sp0, _ts0, _sp0)

)
            self._warn_sub_times_oob(settings)
        except Exception:
            pass
        try:
            eh = settings.get("end_handling") or {}
            if eh and not settings.get("only_audio", False) and settings.get("encoder") != "gif":
                if (eh.get("split_enabled", False) or eh.get("concat_enabled", False)
                        or eh.get("border_enabled", False)):
                    mw, mh, fps, dur = self._probe_end_handling_dims(input_path, settings)
                    cmd_list = self._apply_end_handling_cmd(cmd_list, eh, mw, mh, fps, dur)
        except Exception as e:
            self._append_info_ui(_("[末端] 末端处理注入失败: {0}").format(e))
        # 2026-09-17：可选 -threads（设置项，0=不注入，由 ffmpeg 自适应）
        try:
            _th = self.threads_count.get()
            if not preview and _th and _th > 0 and isinstance(cmd_list, list) and cmd_list:
                cmd_list[1:1] = ["-threads", str(int(_th))]
        except Exception:
            pass
        return cmd_list

    def _warn_sub_times_oob(self, settings):
        """2026-08-29（方向C）：主视频截取终点参与换算 → 子功能时间越界警告。

        子功能时间（简易位置/文字水印/图片水印+轨迹）按输出时间线换算后的结束点
        若超出成片总时长 ((trim_end−trim_start)/speed)，对应内容会在片尾被截掉。
        命中时信息区 + 弹窗一次；无 trim_end 或未截取/变速时静默返回。"""
        try:
            ts, te, sp = _main_trim_range(self, override_settings=settings)
            if te is None or sp <= 0:
                return
            out_dur = (te - ts) / sp
            if out_dur <= 0:
                return
            hits = []
            for label, tend in self._collect_sub_time_ends(settings):
                if tend is None:
                    continue
                t_out = (tend - ts) / sp
                if t_out > out_dur + 1e-6:
                    hits.append(_('{0}：结束 {1:.3f}s → 成片 {2:.3f}s（超出 {3:.3f}s）').format(label, tend, t_out, out_dur))
            if hits:
                head = hits[:6]
                tail = _('\n…等 {0} 处').format(len(hits)) if len(hits) > 6 else ""
                msg = (_("主视频截取终点早于以下子功能时间结束，这部分会被截掉：\n")
                       + "\n".join(head) + tail
                       + _("\n\n请缩短时间或延后截取终点。"))
                self._append_info_ui(_("[时间线] ⚠ ") + msg.replace("\n", "；"))
                with suppress(Exception):
                    messagebox.showwarning(_("时间超出成片时长"), msg)
        except Exception:
            pass

    @staticmethod
    def _collect_sub_time_ends(settings):
        """聚合子功能时间段结束点（原始时间线）：[(label, end_sec), ...]。

        源：简易位置 crop_pos_segments、文字水印 text_watermark（含 items）、
        图片水印 watermark（含 items 与列表轨迹 waypoints）。各源独立容错。"""
        out = []

        def _from_enable(label, d):
            try:
                s = (d.get("enable_start") or "").strip()
                e = (d.get("enable_end") or "").strip()
                sv = float(s) if s else None
                ev = float(e) if e else None
                if sv is not None and ev is not None:
                    out.append((label, max(sv, ev)))
                elif ev is not None:
                    out.append((label, ev))
                elif sv is not None:
                    out.append((label, sv))
            except (ValueError, TypeError):
                pass

        def _from_segments(label, segs):
            try:
                for sg in segs or []:
                    if not isinstance(sg, dict):
                        continue
                    st = float(sg.get("start", 0) or 0)
                    du = float(sg.get("dur", 0) or 0)
                    if du <= 0:
                        du = float(sg.get("duration", 0) or 0)
                    out.append((label, st + du))
            except (ValueError, TypeError):
                pass

        with suppress(Exception):
            _from_segments(_("简易位置"), settings.get("crop_pos_segments"))
        try:
            tw = settings.get("text_watermark") or {}
            if isinstance(tw, dict):
                items = tw.get("items")
                if isinstance(items, list) and items:
                    for i, it in enumerate(items):
                        if isinstance(it, dict):
                            _from_enable(_('文字水印#{0}').format(i + 1), it)
                else:
                    _from_enable(_("文字水印"), tw)
        except Exception:
            pass
        try:
            wm = settings.get("watermark") or {}
            if isinstance(wm, dict):
                items = wm.get("items")
                if isinstance(items, list) and items:
                    for i, it in enumerate(items):
                        if not isinstance(it, dict):
                            continue
                        _from_enable(_('图片水印#{0}').format(i + 1), it)
                        _from_segments(_('图片水印#{0}轨迹').format(i + 1), it.get("waypoints"))
                else:
                    _from_enable(_("图片水印"), wm)
                    _from_segments(_("图片水印轨迹"), wm.get("waypoints"))
        except Exception:
            pass
        return out


    def _warn_bitdepth_break(self, settings, input_path):
        """位深断裂提示（2026-10-07）：10bit 源被「指定」成 8bit 像素格式 → 日志一行。

        为什么是必修：程序默认「指定 yuv420p」，于是 HDR/10bit 源会被静默压成 8bit，
        而输出颜色标记**仍然保留** bt2020/smpte2084 ⇒ 播放器按 PQ 曲线解 8bit 数据
        （实测最坏组合：色带 + 暗部发糊），全程无任何提示。
        用户 2026-10-07 拍板：不改默认值、不新增「随源」下拉项，只在右上日志里提示。

        判据只看「勾了『指定』」的情况——未勾选 = 跟随源位深，本就无风险、不该提示。
        HDR→SDR 色调映射开启时输出本来就该是 8bit，故一并跳过。仅视频路径触发。

        2026-10-07（当日追加）：**预览路径也要提示**。用户原话「能不能转换页主转码路径 +
        10bit 源 + 8bit 选项就提示啊? 现在要转换才提示」⇒ 不再要 `if not preview` 门控。
        但预览每敲一键都会重算（update_command_preview），无条件打印会把信息区刷爆，
        故用 `self._bitdepth_warn_key` 去重：键 = (源路径, 源位深, 目标位深)，
        **只在结论变化的那一次**打一行；真实执行复用同一把键 ⇒ 预览已提示过就不再重复。
        任一判据不成立（未勾指定 / 已选 10bit / 开色调映射 / 换回 8bit 源 / 仅音频 /
        文件不存在）时清空键，这样条件恢复后能重新提示。
        「清空日志」按钮也会重置该键（见 _clear_info_log），避免清空后不再提示。

        覆盖面（2026-10-07 实测）：本函数只被 `_generate_ffmpeg_command_core` 调用，
        即**转换页主转码路径**（开始转换 / 添加到任务列表 / 队列执行）。
        封装页（_build_normal_cmd / _build_pip_cmd / _build_concat_reencode_mode）与
        分段拼接（_generate_segment_concat_command，core 里提前 return）走各自构建器，
        目前**不触发**本提示。
        """
        _pf = str(settings.get("pix_fmt", "") or "").strip()
        _src = None
        _ok = True
        if settings.get("only_audio", False):
            _ok = False
        elif not settings.get("pix_fmt_enabled", False):
            _ok = False
        elif not _pf or _is_10bit_pix_fmt(_pf):
            _ok = False
        elif (settings.get("enhance") or {}).get("tonemap_enabled", False):
            _ok = False
        elif not input_path or not os.path.exists(input_path):
            # 预览在未选素材时用占位串 "{input}" 走一遍；此时直接跳过，
            # 否则会对不存在路径反复 spawn ffprobe（_get_cached_stream_info
            # 探不到结果时不写缓存 ⇒ 每次预览都重探）。
            _ok = False
        else:
            try:
                _src = self._get_video_pix_fmt(input_path)
            except Exception:
                _src = None
            if not _is_10bit_pix_fmt(_src):
                _ok = False
        if not _ok:
            self._bitdepth_warn_key = None
            return
        _key = (normalize_path(input_path), _src, _pf)
        if self._bitdepth_warn_key == _key:
            return                      # 同一结论 → 不重复刷屏
        self._bitdepth_warn_key = _key
        self._append_info_ui(
            _("[像素格式] 源是 {0}（10bit），当前「指定」为 {1} 会把它压成 8bit，"
              "而色彩标记仍会写进输出 —— 播放器可能按 HDR 曲线解 8bit 数据（色带/发暗）。"
              "要保持位深请改选 10bit 像素格式，或取消勾选「指定」以跟随源位深。").format(_src, _pf))

    def _generate_ffmpeg_command_core(self, input_path: str, output_path: str, settings: dict, task=None, preview=False) -> List[str]:
        if settings.get("segment_enabled", False) and settings.get("segments", []):
            return self._generate_segment_concat_command(input_path, output_path, settings, verbose=not preview)
        if not self.ffmpeg_cmd:
            raise ValueError(_("未找到 ffmpeg 可执行文件。"))
        errors = ParamValidator.validate_settings(settings)
        if errors:
            raise ValueError(_("参数错误:\n") + "\n".join(errors))
    
        input_path = normalize_path(input_path)
        output_path = normalize_path(output_path)
        only_audio = settings.get("only_audio", False)
        precise_trim = settings.get("precise_trim", False)

        # 位深断裂提示（2026-10-07）：**预览与真实执行都调用**。
        # 原先是 `if not preview` 门控 → 用户反馈「要转换才提示」，故改为无条件调用；
        # 刷屏由 _warn_bitdepth_break 内部的 _bitdepth_warn_key 去重兜住
        # （同一「源位深+目标位深+源路径」只打一行，结论变化才重打）。
        self._warn_bitdepth_break(settings, input_path)
    
        # ----- 组合跳转设置（仅用于普通视频转码，水印/GIF 单独处理） -----
        combo_seek = False
        combo_threshold = 30
        if not only_audio and not settings.get("watermark", {}).get("enabled", False) and settings.get("encoder") != "gif":
            combo_seek = settings.get("combo_seek", False)
            combo_threshold = settings.get("combo_threshold", 30)
            # 互斥：组合跳转时强制禁用精准模式
            if combo_seek:
                precise_trim = False
                settings["precise_trim"] = False
    
        # 精准模式下强制重新编码（视频）
        self._enforce_reencode_for_precise_trim(settings, only_audio)
    
        # ---------- IVTC 与反交错冲突检测 ----------
        enhance_settings = settings.get("enhance", {})
        if enhance_settings.get("ivtc_enabled", False) and settings.get("deinterlace_filter", "none") != "none":
            self._append_info_ui(_("已启用 IVTC，反交错滤镜将被忽略（IVTC 本身包含反交错功能）。"))
    
        # ---------- 检查水印 ----------
        wm_settings = settings.get("watermark", {})
        wm_enabled = wm_settings.get("enabled", False) and wm_settings.get("file_path", "").strip()
        wm_file = wm_settings.get("file_path", "").strip() if wm_enabled else None
    
        if wm_file and not only_audio:
            # 水印模式强制禁用组合跳转
            settings["combo_seek"] = False
            cmd_list = self._generate_command_with_watermark(input_path, output_path, settings, wm_settings, verbose=not preview)
            # 统一处理长滤镜
            if not preview:
                total_len = len(' '.join(cmd_list))
                if total_len > 25000:
                    cmd_list, temp_files = self._shorten_long_filters(cmd_list, force=True)
                else:
                    cmd_list, temp_files = self._shorten_long_filters(cmd_list)
                if task is not None:
                    if not hasattr(task, 'temp_files'):
                        task.temp_files = []
                    task.temp_files.extend(temp_files)
            return cmd_list
    
        # 检查是否 GIF 编码（且非仅音频）
        if settings.get("encoder") == "gif" and not only_audio:
            cmd_list = self._generate_gif_command(input_path, output_path, settings, verbose=not preview)
            # 统一处理长滤镜
            if not preview:
                total_len = len(' '.join(cmd_list))
                if total_len > 25000:
                    cmd_list, temp_files = self._shorten_long_filters(cmd_list, force=True)
                else:
                    cmd_list, temp_files = self._shorten_long_filters(cmd_list)
                if task is not None:
                    if not hasattr(task, 'temp_files'):
                        task.temp_files = []
                    task.temp_files.extend(temp_files)
            return cmd_list
    
        # ---------- 普通模式（无复杂水印） ----------
        # 2026-10-09：转换页主视频透明输出 → 容器须支持 alpha。判据＝本页主视频设置是否
        # 产生 alpha（绿幕抠像 / 遮罩 / 描边 / 透明度<1.0，见 _settings_needs_alpha）。
        # ⚠️ 必须放在此处（水印 / GIF / 分段拼接三个早期 return 之后）：那些分支走各自
        # 构建器、本就不产 alpha，绝不能把它们的输出也改扩展名。
        # 统一走 ProRes 4444 / .mov（VP9/WebM 透明路线已删除，见 _ALPHA_CAPABLE_ENCODERS）。
        # 两处都幂等：已是目标扩展名时不改路径，重复调用不叠加。
        if (not only_audio
                and settings.get("encoder") not in ("gif", "libwebp")
                and self._settings_needs_alpha(settings)):
            _bn, _ex = os.path.splitext(output_path)
            _ex = _ex.lower()
            # 容器名要钉住（扩展名可能已被 generate_output_path 提前算成 .mov ⇒ 不进 if，
            # 容器名会残留 mp4）。
            # ⚠️ 只有「本来不承载 alpha 的容器」才升 .mov —— .mkv 本就支持 alpha，
            #    保持不动（否则会把 mkv 的输出悄悄改名/改容器语义）。
            if _ex in (".mp4", ".webm", ".avi", ".flv", ".ts", ".m2ts", ".wmv",
                       ".3gp", ".mov"):
                settings["output_container"] = "mov"
                if _ex != ".mov":
                    output_path = _bn + ".mov"
                    self._log_alpha_once(
                        "conv_mov",
                        _("[转码] 检测到透明需求，输出容器自动升级为 .mov（支持 alpha），已改扩展名"))

        cmd_list = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]
    
        # ----- 计算截取时长（仅在精准模式或组合跳转时需要） -----
        start_sec = None
        duration_for_audio = None
        if precise_trim or combo_seek:
            start_sec, duration_for_audio = self._calculate_trim_duration(settings, input_path)
    
        used_combo = False

        # ---------- 组合跳转分支 ----------
        if combo_seek and settings.get("trim_enabled", False) and start_sec is not None and start_sec > 0:
            threshold = combo_threshold
            pre_seek = max(0, start_sec - threshold)
            post_seek = start_sec - pre_seek  # 即 min(start_sec, threshold)
            # 前置跳转
            cmd_list.extend(["-ss", _ffsec(pre_seek)])
            # 硬件解码（放在 -i 之前）
            if not only_audio:
                self._add_hwaccel_params(cmd_list, settings)
            # 输入文件
            if self._is_static_image(input_path):
                # 图片主视频：image2 单帧，必须 -loop 1 无限源，否则输出仅 1 帧。
                # ⚠️ 此处【刻意不烘焙输入级 -t】，勿"统一"成下面普通分支的写法：
                # 组合跳转靠输出侧 -ss(post_seek) + -t 从无限源里裁段；输入若被限成 N 秒，
                # 输出 -ss 会越过流尾，实际时长变成 N-post_seek 而非 duration_for_audio。
                # （图片素材 trim_active() 恒 False，组合跳转对图片本就不进本分支，保留仅为兜底。）
                _img_fps = settings.get("frame_rate_custom", "30") if settings.get("frame_rate_type") == "custom" else "30"
                cmd_list.extend(["-loop", "1", "-framerate", _img_fps])
            cmd_list.extend(["-i", input_path])
            # 后置微调
            cmd_list.extend(["-ss", _ffsec(post_seek)])
            # 输出时长
            if duration_for_audio is not None and duration_for_audio > 0:
                cmd_list.extend(["-t", f"{duration_for_audio:.3f}"])
            used_combo = True
            # 2026-08-30 用户拍板：双-ss 下运动表达式的时间基准是「前面新的 -ss」
            # （即 pre_seek），而不是原始截取起点；后置的 -ss 已经由 ffmpeg 吃进。
            # pre_seek 由下方 _motion_trim_base 统一汇总为 _motion_ts 供所有表达式引用。
        else:
            # ---------- 非组合跳转（正常模式） ----------
            # 快速模式（非精准）才在命令行添加 -ss/-to
            if not precise_trim:
                self._add_trim_params(cmd_list, settings)

            if not only_audio:
                self._add_hwaccel_params(cmd_list, settings)

            if self._is_static_image(input_path):
                # 图片主视频：image2 单帧，必须 -loop 1 无限源，否则输出仅 1 帧。
                # 「显示时长」(「截取」面板) 一并烘焙进本输入 —— 与「主图+水印图」路径、
                # 封装页图片输入同款：图片 = 自带时长的有限长素材标签（-t 在 -i 之前 = 输入级）。
                # 末尾仍会补一个输出级 -t（取同一时长），两条路径的命令形态保持一致。
                _img_fps = settings.get("frame_rate_custom", "30") if settings.get("frame_rate_type") == "custom" else "30"
                cmd_list.extend(["-loop", "1", "-framerate", _img_fps])
                cmd_list.extend(["-t", f"{_eff_image_display_duration(settings):.3f}"])

            cmd_list.extend(["-i", input_path])

        # ----- 运动表达式换算基准（统一入口，2026-08-30）-----
        # 双-ss(组合跳转)=前面新的 -ss(pre_seek)；否则=原始 trim_start。
        # 所有 crop/画布/轨迹/drawtext 运动表达式统一引用，改一处全链路生效。
        _motion_ts, _motion_sp = _motion_trim_base(
            settings, used_combo, pre_seek if used_combo else 0.0)

        # ----- 音频多音轨模式（供下方视频/音频映射共用）-----
        atm = settings.get("audio_track_mode", "first")
        used_filter_complex = False

        # ----- 视频处理 -----
        if only_audio:
            cmd_list.append("-vn")
        else:
            vcodec = settings.get("encoder", "libx265")
            # 2026-10-09：转换页主视频透明输出（绿幕抠像/遮罩/描边/透明度<1.0）——H.264/H.265
            # 静默丢弃 alpha（导出后透明变实色），容器升 .mov 也不够，必须换成承载 alpha 的
            # 编码器（prores_ks 4444）+ 强制 yuva420p（走 format 滤镜锁住 alpha 平面）。
            # ⚠️ 未启用透明时本块零动作，普通转码逐字不变（负控）。copy 模式先落 libx264 再换。
            # ⚠️ gif / libwebp 排除：webp 容器原生带 alpha、走自己的 -loop 0 语义，不换编码器。
            if (settings.get("encoder") not in ("gif", "libwebp")
                    and self._settings_needs_alpha(settings)):
                if vcodec == "copy":
                    vcodec = "libx264"
                settings["pix_fmt_enabled"] = True
                settings["pix_fmt"] = "yuva420p"
                vcodec, _alpha_s = self._merge_alpha_encoder(vcodec, settings, _("[转码]"))
                settings.update(_alpha_s)
                settings["encoder"] = vcodec
                self._log_alpha_once(
                    "conv_prores",
                    _("[转码] 检测到透明需求，视频输出强制 yuva420p 以保留 alpha"))
            # 2026-08-26 多实例（2026-08-27 回溯补齐）：任一启用项有文字即需重编码（不只看首条 enabled）。
            # ⚠️ 与 multi 转换页判定、base 封装页 copy 模式判定（_tw_any_c）逐字一致，
            # 否则 copy 编码 + 首条 disabled 的多条文字水印会被误判"无水印"→ 不强制重编码 → 水印丢失。
            _tw_items = settings.get("text_watermark_items") or []
            _tw_any_c = any(i.get("enabled", True) and str(i.get("text", "") or "").strip()
                            for i in _tw_items) or bool(
                settings.get("text_watermark", {}).get("enabled", False))
            if vcodec == "copy" and _tw_any_c:
                vcodec = "libx265"
                settings["encoder"] = vcodec
                self._append_info_ui(_("文字水印需要重新编码，已自动改为 libx265。"))
            if vcodec == "copy" and not precise_trim and not used_combo:
                # 纯流复制，忽略所有视频处理
                cmd_list.extend(["-c:v", "copy"])
            else:
                # 构建视频滤镜（包含字幕、变速等），组合跳转时跳过 trim
                enhance_settings = settings.get("enhance", {})
                vf = build_video_filter_chain(
                    settings,
                    include_subtitle=True,
                    include_speed=True,
                    include_trim=(not used_combo),   # 组合跳转时不加 trim
                    enhance_settings=enhance_settings,
                    reverse=settings.get('reverse_enabled', False),
                    motion_trim_start=_motion_ts, motion_speed_factor=_motion_sp,
                    # 2026-10-09：转换页主视频也支持绿幕抠像（抠图 → 导出透明素材）。
                    # 未启用时 None，行为与旧调用方逐字一致。
                    chroma_settings=settings if settings.get("chroma_enabled", False) else None,
                    include_alpha=True,   # 转换页主视频透明度
                )
                # 文字水印（旋转时走透明层+rotate+overlay，需 filter_complex）
                # 2026-08-26 多实例：_tw_rotate = 任一启用项需旋转；-vf 路径渲染全部非旋转项
                tw_settings = settings.get("text_watermark", {})
                _tw_items = settings.get("text_watermark_items") or []
                _tw_active = [i for i in _tw_items
                              if i.get("enabled", True) and str(i.get("text", "") or "").strip()]
                if not _tw_active:
                    _tw_active = [tw_settings] if (tw_settings.get("enabled", False)
                                                   and str(tw_settings.get("text", "") or "").strip()) else []
                _tw_enabled = bool(_tw_active)
                _tw_rotate = any(text_watermark_needs_subgraph(i) for i in _tw_active)

                # ---- 画布模式（位置、尺寸、旋转）----
                # 主视频作为内容在固定黑画布上移动+缩放+旋转；接管位置/尺寸/旋转
                # （static scale/crop/transpose 在 build_canvas_filtergraph 内关闭）。
                # 画布尺寸 = 主视频原始尺寸（无 transpose 交换，画布模式忽略 transpose）。
                _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
                _canvas_cg = None
                if _canvas_on:
                    try:
                        _cw, _ch = get_video_dimensions(self.ffprobe_cmd, input_path)
                        if not _cw or not _ch:
                            _cw, _ch = 1280, 720
                        # 运动时间换算基准统一由 _motion_ts 提供（双-ss=pre_seek，否则=原始 trim_start）
                        _canvas_ts0 = _motion_ts
                        # filter_trim_start / trim_duration：
                        # 组合跳转(双-ss) 输入已 -ss 定位 + 用 -t 限制时长 → 滤镜直接用原始 [0:v]，
                        # 不注入 trim/setpts（用户实测：双-ss 下 filter t = 原始时间 - 前面新的 -ss，
                        # 用运动基准 pre_seek 即可对齐；注入 trim 反而把时间线归零导致错位）；
                        # 精确截取输入未 seek → filter 从原始 trim_start 起 trim 并 setpts 归零。
                        _fts = None if used_combo else (start_sec or 0.0)
                        _tdur = None if used_combo else duration_for_audio
                        _canvas_cg = build_canvas_filtergraph(
                            settings, _cw, _ch, _canvas_ts0, _motion_sp,
                            filter_trim_start=_fts, trim_duration=_tdur)
                    except Exception:
                        _canvas_cg = None
                if _canvas_cg:
                    # 画布滤镜图已含主视频处理；文字水印叠加在 [v_canvas] 之上
                    if _tw_rotate:
                        fc = (f"{_canvas_cg};[v_canvas]"
                              + build_text_watermark_chain(settings, main_label="[v_canvas]", out_label="[v_out]"))
                    else:
                        dt = build_drawtext_chain_vf(tw_settings, _tw_items,
                                                     trim_start=_motion_ts, speed_factor=_motion_sp)
                        if dt:
                            fc = f"{_canvas_cg};[v_canvas]{dt}[v_out]"
                        else:
                            fc = f"{_canvas_cg};[v_canvas]null[v_out]"
                    cmd_list.extend(["-filter_complex", fc])
                    used_filter_complex = True
                    cmd_list.extend(["-map", "[v_out]"])
                    if settings.get("audio_enabled", True):
                        cmd_list.extend(["-map", "0:a?" if atm == "first" else "0:a"])
                        cmd_list.extend(["-map", "0:s?"])
                else:
                    if _tw_rotate:
                        base_vf = vf if (vf and vf != "null") else "null"
                        fc = f"[0:v]{base_vf}[v_tw_base];" + build_text_watermark_chain(
                            settings, main_label="[v_tw_base]", out_label="[v_tw]")
                        cmd_list.extend(["-filter_complex", fc])
                        used_filter_complex = True
                        cmd_list.extend(["-map", "[v_tw]"])
                        if settings.get("audio_enabled", True):
                            cmd_list.extend(["-map", "0:a?" if atm == "first" else "0:a"])
                            cmd_list.extend(["-map", "0:s?"])
                    else:
                        dt = build_drawtext_chain_vf(tw_settings, _tw_items,
                             trim_start=_motion_ts, speed_factor=_motion_sp)
                        if dt:
                            vf = f"{vf},{dt}" if vf != "null" else dt
                        if vf != "null":
                            cmd_list.extend(["-vf", vf])

                cmd_list = self._build_video_encoding_params(cmd_list, settings)
    
        # ----- 音频处理（含多音轨模式）-----
        audio_on = settings.get("audio_enabled", True)
        if not audio_on:
            cmd_list.append("-an")
        else:
            # 1) 音轨映射
            if only_audio:
                # 仅音频：视频已 -vn，只映射音频
                cmd_list.extend(["-map", "0:a?" if atm == "first" else "0:a"])
            elif used_filter_complex:
                # 视频已由上方 -filter_complex 显式映射，这里只补音频（字幕已在视频段映射）
                cmd_list.extend(["-map", "0:a?" if atm == "first" else "0:a"])
            else:
                # 普通路径：任何显式 -map 都会关闭自动映射，需把视频/字幕也显式映射
                if atm == "first":
                    cmd_list.extend(["-map", "0:v?", "-map", "0:a?", "-map", "0:s?"])
                else:
                    cmd_list.extend(["-map", "0:v?", "-map", "0:a", "-map", "0:s?"])
            # 2) 编码
            if atm == "all_copy":
                # 全部·原样保留：所有源音轨直接 copy（忽略滤镜）
                cmd_list.extend(["-c:a", "copy"])
            elif used_combo:
                # 组合跳转已用 -ss 截取整个流，音频直接编码（不使用 atrim）
                cmd_list = self._build_audio_encoding_params(cmd_list, settings, input_path)
            elif precise_trim and settings.get("trim_enabled", False) and duration_for_audio is not None and duration_for_audio > 0:
                self._apply_audio_trim_and_encode(cmd_list, settings, input_path, start_sec, duration_for_audio, map_audio=False)
            else:
                cmd_list = self._build_audio_encoding_params(cmd_list, settings, input_path)
    
        # 帧同步（2026-09-16「帧设置」）：默认「自动」= 交给 ffmpeg 决定。
        # ⚠️ 必须放在自定义参数【之前】：ffmpeg 同一输出选项「后写覆盖前写」，
        # 用户在「自定义参数」里显式写的 -vsync / -fps_mode 才能生效。
        # ⚠️ 仅音频输出不加（无视频帧，无意义）。
        if not only_audio:
            cmd_list.extend(frame_sync_to_ffmpeg(
                settings.get("frame_sync", "auto"), self.ffmpeg_cmd))

        custom = settings.get("custom_args", "").strip()
        self._merge_custom_filters_into_cmd(cmd_list, custom, verbose=not preview)
    
        if not only_audio:
            container = settings.get("output_container", "mp4").lower()
            if container in ("mp4", "mov") and _faststart_on(settings):
                cmd_list.extend(["-movflags", "+faststart"])
            cmd_list = append_apple_compat_tag(cmd_list, settings, container)
    
        # 文字水印（旋转/spin）无限源时长限制：优先 -shortest，无音频用 -t
        _ensure_tw_duration_limit(
            self, cmd_list, input_path=input_path,
            main_duration=self._get_media_duration(input_path) if input_path else None,
            audio_enabled=settings.get("audio_enabled", True),
            image_display_duration=_eff_image_display_duration(settings))

        # 图片主视频：image2 单帧 + -loop 1 无限源，必须显式 -t 收尾，
        # 否则输出仅 1 帧（无 loop）或无限输出（有 loop 但靠 -shortest 不终止）。
        # ⚠️ 只判【输出侧】（_cmd_has_output_option）：图片输入已自带输入级 -t
        # （-loop 1 -framerate 30 -t 16 -i img），裸判会让这个收尾 -t 被误判成已存在而漏加。
        # 已有的组合跳转/trim 输出级 -t 仍会正确跳过（不叠加）。
        if self._is_static_image(input_path) and not _cmd_has_output_option(cmd_list, "-t", "-to"):
            # 图片主视频：用「截取」面板设定的「显示时长」(img_duration)，不再硬编码 10 秒
            cmd_list.extend(["-t", f"{_eff_image_display_duration(settings):.3f}"])

        cmd_list.append(output_path)

        # 普通模式处理长滤镜
        if not preview:
            total_len = len(' '.join(cmd_list))
            if total_len > 25000:
                cmd_list, temp_files = self._shorten_long_filters(cmd_list, force=True)
            else:
                cmd_list, temp_files = self._shorten_long_filters(cmd_list)
            if task is not None:
                if not hasattr(task, 'temp_files'):
                    task.temp_files = []
                task.temp_files.extend(temp_files)
        return cmd_list



    def _add_infinite_loop_params(self, cmd_list: List[str], file_path: str, is_sub_video: bool = True, framerate: str = "30"):
        """
        为输入文件添加无限循环参数（用于子视频/水印）。
        视频：-stream_loop -1
        图片：-loop 1 -framerate <fps>
        
        :param cmd_list: 命令列表（会被修改）
        :param file_path: 文件路径
        :param is_sub_video: 是否仅为子视频（True）或水印（True），实际上逻辑相同，保留参数供扩展
        :param framerate: 图片帧率，默认30
        """
        ext = os.path.splitext(file_path)[1].lower()
        is_image = ext in ('.png', '.jpg', '.jpeg', '.bmp', '.webp')   # 不包括 .gif
        is_gif = ext == '.gif'
        
        if is_gif:
            cmd_list.extend(["-stream_loop", "-1"])
        elif is_image:
            cmd_list.extend(["-loop", "1", "-framerate", framerate])
        else:
            # 普通视频
            cmd_list.extend(["-stream_loop", "-1"])


    def _generate_command_with_watermark(self, input_path: str, output_path: str, settings: dict, wm_settings: dict, verbose=None) -> List[str]:
        main_w, main_h = self._get_video_dimensions_cached(input_path)
        # 强制禁用组合跳转
        settings["combo_seek"] = False
        vcodec = settings.get("encoder", "libx265")
        if vcodec == "copy":
            settings["encoder"] = "libx265"
            self._append_info_ui(_("水印模式必须重新编码，已将编码器自动改为 libx265。"))
        # 提前探测水印原始尺寸（自适应表达式求值需要）
        wm_file_raw = wm_settings.get("file_path", "").strip()
        wm_orig_w, wm_orig_h = None, None
        if wm_file_raw and os.path.exists(wm_file_raw):
            # 注意：水印尺寸必须取「旋转后」尺寸（元数据 rotation + 用户 rotate），
            # 与 get_video_rotated_dimensions 语义一致；切勿改用不旋转的
            # _cached_video_dimensions / get_video_dimensions，否则水印忽略旋转，
            # 会造成命令预览与实际转换结果不一致。
            wm_orig_w, wm_orig_h = self._cached_video_rotated_dimensions(wm_file_raw, wm_settings)
        if main_w is not None and main_h is not None:
            if wm_settings.get("adaptive", False):
                adapted_wm = self._adapt_sub_settings(wm_settings, main_w, main_h, wm_orig_w, wm_orig_h)
            else:
                adapted_wm = wm_settings.copy()
        else:
            adapted_wm = copy.deepcopy(wm_settings)
    
        # ---- 开始构建命令 ----
        cmd_list = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]
    
        wm_file = adapted_wm.get("file_path", "").strip()
        ext = os.path.splitext(wm_file)[1].lower()
        is_image = ext in ('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')
        loop_mode = adapted_wm.get("loop_mode", "infinite")
        loop_count = adapted_wm.get("loop_count", 3)
        loop_enabled = adapted_wm.get("loop_enabled", False)
    
        # ---------- 强制精准截取（水印模式） ----------
        settings["precise_trim"] = True
        
        # --- 检测源文件是否有音频流（走缓存）---
        has_input_audio = False
        info = self._get_cached_stream_info(input_path)
        if info:
            has_input_audio = any(s.get("codec_type") == "audio" for s in info.get("streams", []))
        
        # --- 强制音频编码 ---
        if settings.get("audio_enabled", True):
            if settings.get("audio_codec") == "copy":
                if has_input_audio:
                    settings["audio_codec"] = "aac"
                    self._append_info_ui(_("水印模式下为确保同步，音频编码器已自动设为 aac"))
                else:
                    # 源文件无音频，禁用音频
                    settings["audio_enabled"] = False
                    self._append_info_ui(_("源文件无音频流，已自动禁用音频输出"))
        
        self._enforce_reencode_for_precise_trim(settings, only_audio=False)
    

        self._add_hwaccel_params(cmd_list, settings)
    
        # 主视频输入
        if self._is_static_image(input_path):
            # 图片主视频：image2 单帧，必须 -loop 1 无限源，否则输出仅 1 帧。
            # 「显示时长」(「截取」面板) 同时烘焙进本输入：该图成为有限长的素材标签
            # （与封装页图片输入、转换页普通路径同款），时长不再只靠末尾那个输出级 -t。
            _img_fps = settings.get("frame_rate_custom", "30") if settings.get("frame_rate_type") == "custom" else "30"
            cmd_list.extend(["-loop", "1", "-framerate", _img_fps])
            cmd_list.extend(["-t", f"{_eff_image_display_duration(settings):.3f}"])
        cmd_list.extend(["-i", input_path])
    
        # ----- 计算主视频有效时长（截取或总时长） -----
        start_sec, duration_for_sub = self._calculate_trim_duration(settings, input_path)
        main_duration = None
        if settings.get("trim_enabled", False):
            if settings.get("precise_trim", False):  # 强制为 True
                main_duration = duration_for_sub if duration_for_sub is not None else None
            else:
                start = settings.get("trim_start", "").strip()
                end = settings.get("trim_end", "").strip()
                start_sec_calc = time_to_seconds(start) if start else 0.0
                end_sec_calc = time_to_seconds(end) if end else None
                if end_sec_calc is not None:
                    main_duration = end_sec_calc - start_sec_calc
                else:
                    total_dur = self._get_media_duration(input_path)
                    if total_dur is not None:
                        main_duration = total_dur - start_sec_calc
        else:
            total_dur = self._get_media_duration(input_path)
            if total_dur is not None:
                main_duration = total_dur
    
        # ---- 水印普通截取（非精准） ----
        # 注：水印自身的截取由 wm_trim_enabled 控制，不影响主视频
        wm_trim_enabled = adapted_wm.get("trim_enabled", False)
        wm_precise = adapted_wm.get("precise_trim", False)

    
        # ---- 判断是否在滤镜中使用 loop ----
        use_loop_in_filter = wm_trim_enabled  # 只要截取了，就用 loop 滤镜
    
        # ---- 添加水印输入（及循环参数） ----
        if not is_image:
            if use_loop_in_filter:
                # 循环由滤镜中的 loop 处理，不添加 -stream_loop
                cmd_list.extend(["-i", wm_file])
            else:
                # 根据循环控制决定循环次数（不启用=无限循环）
                if loop_enabled and str(loop_count).isdigit() and int(loop_count) > 0:
                    cmd_list.extend(["-stream_loop", str(int(loop_count))])
                else:
                    cmd_list.extend(["-stream_loop", "-1"])
                cmd_list.extend(["-i", wm_file])
        else:
            # 图片水印（静态图片或 GIF）
            ext = os.path.splitext(wm_file)[1].lower()
            if ext == '.gif':
                # GIF 本身是动画，不能使用 -loop，用 -stream_loop -1 确保循环
                cmd_list.extend(["-stream_loop", "-1"])
            else:
                fps = settings.get("frame_rate_custom", "30") if settings.get("frame_rate_type") == "custom" else "30"
                cmd_list.extend(["-loop", "1", "-framerate", fps])
                # 水印图片自己的「显示时长」也烘焙进它的输入（在「水印参数编辑 → 截取片段」
                # 里设置，键 img_duration）：这张图同样是一个有限长的素材标签。
                # 静态图超出该时长后 overlay 会保持末帧（eof_action=repeat），画面不变。
                cmd_list.extend(["-t", f"{_eff_image_display_duration(adapted_wm):.3f}"])
            cmd_list.extend(["-i", wm_file])
    
        # ---- 构建叠加滤镜 ----
        sub_infos = [(1, wm_file, adapted_wm)]
        enhance_settings = settings.get("enhance", {})
        complex_filter, final_v_label = self._build_overlay_filter_complex(
            0, settings, sub_infos, include_subtitle_main=True,
            enhance_settings=enhance_settings,
            # ⚠️ 必须传（2026-10-07 修，与 base 同款）：不传则默认空串 → blend 分支的
            # _compute_output_canvas 拿不到真实画布 → 兜底 1280x720 →
            # 「表达式轨迹(h/v/diamond/corners)」的包围盒按 1280 宽算，
            # crop=<比主视频宽的尺寸> → "Invalid too big or non positive size"
            # → rc=-22 整图零帧（用户侧表现为「转换报错」）。其余 4 处调用点均已传。
            main_file_path=input_path,
        )
        # 追加文字水印（在 overlay 之后；旋转时走透明层+rotate+overlay 子图）
        tw_settings = settings.get("text_watermark", {})
        tw_frag = build_text_watermark_chain(settings, main_label=final_v_label, out_label="[v_dtext]")
        if tw_frag:
            complex_filter = f"{complex_filter};{tw_frag}"
            final_v_label = "[v_dtext]"
        cmd_list.extend(["-filter_complex", complex_filter])
        cmd_list.extend(["-map", final_v_label])
    
        # ---- 视频编码参数 ----
        cmd_list = self._build_video_encoding_params(cmd_list, settings)
        # 帧同步（2026-09-16）：原为无条件写死的 cfr，现改由「帧设置」控制，
        # 默认「自动」。选项名按能力探测二选一（9.0 删了 -vsync，4.3/4.4 没有 -fps_mode）。
        # ⚠️ 同普通路径：放在自定义参数之前，用户显式写的优先级更高。
        cmd_list.extend(frame_sync_to_ffmpeg(
            settings.get("frame_sync", "auto"), self.ffmpeg_cmd))
    
        # ---- 音频处理 ----
        # 检测主视频是否有音频流（走缓存）
        info = self._get_cached_stream_info(input_path)
        has_audio = info and any(s.get("codec_type") == "audio" for s in info.get("streams", []))

        if not has_audio:
            if settings.get("audio_enabled", True):
                self._append_info_ui(_("[水印] 主视频无音频流，已自动禁用音频输出。"))
                settings["audio_enabled"] = False
            cmd_list.append("-an")
        elif settings.get("audio_enabled", True):
            if settings.get("precise_trim", False) and settings.get("trim_enabled", False) and duration_for_sub is not None and duration_for_sub > 0:
                self._apply_audio_trim_and_encode(cmd_list, settings, input_path, start_sec, duration_for_sub, map_audio=True)
            else:
                cmd_list.extend(["-map", "0:a:0"])
                cmd_list = self._build_audio_encoding_params(cmd_list, settings, input_path)
        else:
            cmd_list.append("-an")
    
        # ---- 自定义参数（含滤镜智能合并） ----
        custom = settings.get("custom_args", "").strip()
        self._merge_custom_filters_into_cmd(cmd_list, custom, verbose=verbose)
    
        container = settings.get("output_container", "mp4").lower()
        if container in ("mp4", "mov") and _faststart_on(settings):
            cmd_list.extend(["-movflags", "+faststart"])
        # HEVC 苹果兼容标记（2026-10-07）：必须用本地的 container 判据
        cmd_list = append_apple_compat_tag(cmd_list, settings, container)
    
        # ---- 时长控制：有音频时用 -shortest，无音频时用 -t ----
        # 检查主视频是否包含音频流（走缓存）
        has_audio_stream = False
        if input_path and os.path.exists(input_path):
            info = self._get_cached_stream_info(input_path)
            if info and any(s.get("codec_type") == "audio" for s in info.get("streams", [])):
                has_audio_stream = True
    
        # 用户在「自定义参数」里显式写了输出级 -t / -to（如 -t 10 试片）时，这里不再补时长：
        # ffmpeg 同一输出选项是「后写覆盖前写」，此处补的 -t 会让用户的时长限制静默失效。
        # ⚠️ 只认【输出级】：图片素材已把「显示时长」烘焙成输入级 -t
        # （-loop 1 -framerate 30 -t 16 -i img），裸判 "-t" in cmd_list 会把它误当成
        # 输出已有限制而漏加收尾 -t。与 _ensure_tw_duration_limit(6131) 同一纪律。
        _user_t = _cmd_has_output_option(cmd_list, "-t", "-to")
        # 旋转文字水印的无限透明画布（color=c=black@0）先交给统一兜底处理：
        # 它会自己探测时长并按「有音频 -shortest / 无音频 -t」决策，比这里内联重抄
        # 一遍更完整（旧实现漏了这一步，且 -shortest 对无限源不终止）。
        _n_before = len(cmd_list)
        with suppress(Exception):
            _ensure_tw_duration_limit(
                self, cmd_list, input_path=input_path,
                main_duration=main_duration,
                audio_enabled=settings.get("audio_enabled", True),
                image_display_duration=_eff_image_display_duration(settings),
                tag=_("[水印]"))
        if len(cmd_list) == _n_before:
            # 兜底没动手（命令里没有无限画布、或已存在时长限制）→ 走原有逻辑
            if settings.get("audio_enabled", True) and has_audio_stream:
                cmd_list.append("-shortest")
            elif _user_t:
                self._append_info_ui(_("[水印] 检测到自定义参数已指定时长限制，跳过自动时长控制。"))
            else:
                if self._is_static_image(input_path):
                    # 图片主视频：-loop 1 无限源，无音频时 -shortest 不终止 → 必须用 -t 收尾。
                    # 长度取「截取」面板的「显示时长」(img_duration)，不再硬编码 10 秒；
                    # ffprobe 对图片返回的 0.04 之类小值绝不能当真实时长用。
                    _img_dur = _eff_image_display_duration(settings)
                    cmd_list.extend(["-t", f"{_img_dur:.3f}"])
                elif main_duration and main_duration > 0:
                    cmd_list.extend(["-t", f"{main_duration:.3f}"])
                else:
                    cmd_list.append("-shortest")
                    self._append_info_ui(_("[水印] 警告：无法计算主视频时长，使用 -shortest 控制输出。"))
    
        cmd_list.append(output_path)

        return cmd_list




    def get_current_settings(self):
        settings = {}
        settings.update(self.video_encoder.get_settings())
        settings.update(self.video_filter.get_settings())
        settings.update(self.audio_frame.get_settings())
        settings.update(self.trim_frame.get_settings())
        settings.update(self.adv_frame.get_settings())
        # 绿幕/抠像（转换页主视频，2026-10-09）：抠像/透明度/遮罩/描边（循环/音频已在
        # get_settings 内按 main_video_mode 剔除，不会写进主视频设置）。
        _pr = getattr(self, "convert_loop_chroma", None)
        if _pr is not None:
            settings.update(_pr.get_settings())
        settings["output_dir"] = self.output_dir.get()
        settings["output_suffix"] = self.output_suffix.get()
        settings["custom_output_name"] = self.custom_output_name.get()
        settings["output_container"] = self.output_container.get()
        settings["pip_enabled"] = self.pip_enabled.get()
        settings["segment_enabled"] = self.segment_enabled.get()
        settings["segments"] = copy.deepcopy(self.segments)
        # 音频独立截取（不分段）
        settings["audio_trim_enabled"] = self.audio_trim_enabled
        settings["audio_trim_start"] = self.audio_trim_start
        settings["audio_trim_end"] = self.audio_trim_end
        # 说明：watermark / text_watermark 是「命令生成」的必需输入，必须保留在
        # settings 中；但 load_settings_into_ui 不恢复它们（水印由独立「水印预设」
        # 管理，主预设加载不覆盖水印设置）。二者职责分离，切勿因"主预设不保存
        # 水印"而删除这两个键，否则命令生成将拿不到水印导致水印整体失效。
        # 添加水印设置（深拷贝）
        wm = copy.deepcopy(self.watermark_settings)
        if "adaptive" not in wm:
            wm["adaptive"] = False
        settings["watermark"] = wm
        # 记录当前输入文件的尺寸作为水印基准
        input_file = self.input_file.get().strip()
        if input_file and os.path.exists(input_file):
            w, h = self._get_video_dimensions_cached(input_file)
            if w is not None and h is not None:
                settings["watermark"]["base_width"] = w
                settings["watermark"]["base_height"] = h
        settings["enhance"] = self.video_filter.get_enhance_settings()
        # 添加文字水印设置（深拷贝）
        settings["text_watermark"] = copy.deepcopy(self.text_watermark_settings)
        # 多文字水印列表（2026-08-26）：优先列表，空则迁移单条（旧预设兼容）
        if getattr(self, "text_watermark_items", None):
            settings["text_watermark_items"] = copy.deepcopy(self.text_watermark_items)
        elif self.text_watermark_settings.get("enabled") or self.text_watermark_settings.get("text"):
            settings["text_watermark_items"] = [copy.deepcopy(self.text_watermark_settings)]
        else:
            settings["text_watermark_items"] = []
        # 添加末端处理设置（深拷贝；转换页/队列各自独立，队列 add_task 快照此值）
        settings["end_handling"] = copy.deepcopy(self._trans_end_handling)
        return settings


    def load_settings_into_ui(self, settings):
        self._loading_preset = True
        try:
            self.output_dir.set(settings.get("output_dir", ""))
            self.output_suffix.set(settings.get("output_suffix", ""))
            self.custom_output_name.set(settings.get("custom_output_name", ""))
            self.output_container.set(settings.get("output_container", "mp4"))
            self.video_encoder.set_settings(settings)
            self.video_filter.set_settings(settings)
            self.audio_frame.set_settings(settings)
            self.trim_frame.set_settings(settings)
            self.adv_frame.set_settings(settings)
            _pr = getattr(self, "convert_loop_chroma", None)
            if _pr is not None:
                _pr.set_settings(settings)   # 绿幕/抠像（转换页主视频）
            self.pip_enabled.set(settings.get("pip_enabled", False))
            self.segment_enabled.set(settings.get("segment_enabled", False))
            self.segments = copy.deepcopy(settings.get("segments", []))
            # 音频独立截取
            self.audio_trim_enabled = settings.get("audio_trim_enabled", False)
            self.audio_trim_start = settings.get("audio_trim_start", "")
            self.audio_trim_end = settings.get("audio_trim_end", "")
            # 恢复末端处理（主预设持久化 end_handling；与封装页 _merge_end_handling 无关）
            _eh = settings.get("end_handling")
            if isinstance(_eh, dict):
                self._trans_end_handling = copy.deepcopy(_eh)
#             # 恢复水印设置
#             if "watermark" in settings:
#                 self.watermark_settings = copy.deepcopy(settings["watermark"])
#             else:
#                 # 保持默认值（已在 __init__ 中定义）
#                 pass
            self.toggle_only_audio_mode()
            if "enhance" in settings:
                self.video_filter.set_enhance_settings(settings["enhance"])
            # 注意：水印（图片/视频、文字）由独立「水印预设」统一管理，
            # 主预设不恢复水印，避免覆盖水印预设的当前状态。
        finally:
            self._loading_preset = False
            self.update_command_preview()  # 最后统一刷新一次

    # ---------- 可视化编辑器公共辅助方法（用于合并模块）----------
    def _get_enabled_video_tracks(self):
        return [t for t in self.merge_tracks if t.enabled and t.type == "video"]
    
    def compute_final_size_with_order(self, orig_w: int, orig_h: int, settings: dict) -> Tuple[int, int]:
        """
        按滤镜链顺序（crop -> rotate -> scale）计算最终输出尺寸。
        orig_w, orig_h: 原始视频宽高（不含任何旋转）。
        settings: 包含 crop、rotate、scale 等设置的字典。
        """
        w, h = orig_w, orig_h
    
        # 1. 裁剪（基于原始尺寸）
        if settings.get("crop_enabled", False):
            crop_w = settings.get("crop_width", "").strip()
            crop_h = settings.get("crop_height", "").strip()
            crop_left = settings.get("crop_left", "0").strip()
            crop_top = settings.get("crop_top", "0").strip()
            if crop_w and crop_h:
                # 支持 iw/ih 表达式
                cw = safe_eval_expr(crop_w, {"iw": w, "ih": h})
                ch = safe_eval_expr(crop_h, {"iw": w, "ih": h})
                if cw and ch and cw > 0 and ch > 0:
                    w, h = cw, ch
    
        # 2. 用户旋转（交换宽高）
        rotate = settings.get("rotate", "none")
        if rotate in ("90", "270"):
            w, h = h, w
    
        # 3. 缩放
        if settings.get("scale_enabled", False):
            method = settings.get("scale_method", "width")
            sw = settings.get("scale_width", "").strip()
            sh = settings.get("scale_height", "").strip()
            try:
                if method == "width" and sw:
                    target_w = int(float(sw))
                    target_h = int(round(target_w * h / w))
                    w, h = target_w, target_h
                elif method == "height" and sh:
                    target_h = int(float(sh))
                    target_w = int(round(target_h * w / h))
                    w, h = target_w, target_h
                elif method == "exact" and sw and sh:
                    w, h = int(float(sw)), int(float(sh))
            except:
                pass
    
        return max(1, w), max(1, h)

    def _node_canvas_space_size(self, filt_frame, orig_size):
        """节点语境下，**像素域编辑器**（裁剪 / delogo / 画布 / 遮罩）的坐标空间尺寸。

        🔴 2026-10-16（用户实测：「他显示的画面是正确的, 但是选框的比例是和原始包装盒大小
        的比例, 所以选的位置被放大后就会超出位置」）：`node_frame_orig_size` 是**未缩放**
        的包装盒（`_open_node_effect_editor` 传的 `orig_size`），而 `_node_fx_excl` 渲染
        背景帧时**保留 scale**（只刨 crop/rotate/flip）⇒ 编辑器里看到的画面是**缩放后**
        的。两者不同域 ⇒ 复选框按未缩放盒比例画、浮在缩放后的画面上，选出的区域一放大
        就跑到框外（delogo 一旦越界就 `Error reinitializing filters!` ⇒ 管道预览永远
        「正在加载预览」）。

        ⇒ 坐标空间必须与**渲染帧严格同尺寸**：口径与遮罩蓝框
        （`open_watermark_overlay_editor` 的 `_cw/_ch` 计算）**完全一致** ——
        「包装盒作底 + 只套 scale」→ `compute_final_size_with_order`。

        orig_size 为空 / 非节点语境 ⇒ 原样返回（调用方行为逐字节不变）。
        """
        if not orig_size:
            return orig_size
        try:
            _bw0, _bh0 = int(orig_size[0]), int(orig_size[1])
        except (ValueError, TypeError, IndexError):
            return orig_size
        try:
            _ff = filt_frame
            if _ff is None:
                return (_bw0, _bh0)
            _rs_set = {
                "crop_enabled": False,
                "scale_enabled": _ff.scale_enabled.get(),
                "scale_method": _ff.scale_method.get(),
                "scale_width": _ff.scale_width.get(),
                "scale_height": _ff.scale_height.get(),
                "rotate": 0,
            }
            _sw, _sh = self.compute_final_size_with_order(_bw0, _bh0, _rs_set)
            if _sw and _sh and int(_sw) >= 2 and int(_sh) >= 2:
                return (int(_sw), int(_sh))
        except (AttributeError, ValueError, TypeError):
            pass
        return (_bw0, _bh0)

    def resolve_material_ctx(self, filt_frame, *, force=False):
        """**素材语境唯一解析器** —— 「我是谁 / 我的画面帧在哪 / 我的尺寸是多少」。

        🔴 2026-10-16 用户拍板收敛（原话：「修了这么久的问题都是各种组内合成尺寸和组内合成帧
        传递的问题 … 是不是需要抽取收敛出一个模型，专门来转发更方便一些」）：
        此前仓库里有 **59 处**素材源出口，各自写死 `filt_frame.current_file` /
        `track_obj.file_path` / `_resolve_source()` —— 这三者在**组父行语境下全都等于
        「组内主」**（`_node_label_track` 对组节点返回组内主轨道）⇒ 每条既有路径都要单独补
        一遍 `if group_box_edit:` 分支，漏一处就复发一次同类 bug（本轮已修 4 处同根因）。
        ⇒ 收敛到本函数：**判据只写一次**，所有出口统一问它。

        返回 `MaterialCtx(...)`（`namedtuple`，不可变，可解包可属性访问）；异常/无过滤帧
        ⇒ 返回 `None`（调用方回落旧行为，绝不抛）。

        字段与**唯一出处**（勿在别处另算，否则必然漂移）：
          · `kind`          'plain' | 'group_box' | 'node'
          · `src_file`      素材文件（给「重新获取画面 / ffprobe 兜底」用）。
                            plain = `filt_frame.current_file`（或 `track_obj.file_path` 兜底）；
                            group_box / node = **仍回组内主文件**（真实路径，可当时长上限用），
                            但调用方若需要「素材身份」应看 `label` 而不是它。
          · `label`         节点指纹/标签（组父行 = 组最终输出标签；plain = None）。
                            判定「是不是独立素材」用 `is_material`。
          · `frame_png`     画面帧来源①：**一次性合成 PNG 路径**（仅 group_box，惰性生成，
                            同一语境 + 同一 box 尺寸缓存）；失败 None。
          · `frame_extract` 画面帧来源②：**节点时间轴取帧器** callable
                            （= `filt_frame.node_frame_extractor`，plain/node 通用）。
          · `size`          坐标空间尺寸 (w, h)：
                            · plain = (None, None)（调用方自算，保持旧行为）；
                            · node  = `_node_canvas_space_size`（同源，已过 scale）；
                            · group = **包装盒尺寸**（`_group_composite_box` 的 w,h）。
          · `box`           包装盒 (x, y, w, h)（仅 group_box，已含组级落位）；其余 None。
          · `is_composite`  画面帧是**已合成**的（抠像/叠加都算完）⇒ 调用方**不得**再传
                            chroma（否则二次抠像）；`content_alpha` 该开。
          · `orig_size`     `filt_frame.node_frame_orig_size`（未缩放盒/节点输出），
                            给需要「未缩放基准」的调用方（如 `_node_canvas_space_size` 入参）。

        ⚠️ 本函数**只读**，绝不写 `filt_frame` / 轨道 / node_fx。
        ⚠️ `force=True` 时即使 `filt_frame` 上没挂任何节点钩子，也按 `group_box_edit` 判组。
        """
        MaterialCtx = self._MATERIAL_CTX
        if filt_frame is None:
            return None
        try:
            _gid = ""
            _label = None
            _box = None
            # 组最终输出标签（独立素材身份）＝ `group_label_edit`（**真正的 label**，
            # 形如 `v_grp_g1_1`，由 `edit_video_settings` 从 `overlay_group_label` 挂上）。
            # 🔴 2026-10-16（用户第 3 条）修正：**不能用 `group_fx_key_edit` 当 label** ——
            #   那是**节点指纹 key**（形如 `#9:overlay`），而下面反查组 id 靠
            #   `_merge_group_row_label(...) == _label` 比对（形如 `v_grp_g1_1`）⇒ 恒不中
            #   ⇒ `_gid` 空 ⇒ 包装盒几何求不出 ⇒ `size`/`frame_png` 双双落 None ⇒ 调用方
            #   回落「组内主」的画面与尺寸（正是用户报的「还是组内主视频大小和帧」）。
            #   `_fx_key` 只作**兜底**（老调用方可能只挂了它）。
            _fx_key = getattr(filt_frame, "group_fx_key_edit", None)
            # 🔴 2026-10-16（用户第 2 条）：通用素材标签（命令编辑器手写图的链左标签）。
            #   与 `group_label_edit` 同域（都是「我是谁」），但**不置 `_want_group`** ——
            #   见 `edit_video_settings` 里 `material_label` 的注释：身份 ≠ 分组主张。
            _mat_lab = getattr(filt_frame, "material_label_edit", None)
            _label = (getattr(filt_frame, "group_label_edit", None) or _mat_lab
                      or _fx_key or None)
            _want_group = (bool(getattr(filt_frame, "group_box_edit", False))
                           or bool(_fx_key)
                           or bool(getattr(filt_frame, "group_label_edit", None)))
            # 轨道对象（组指纹载体）：VideoFilterFrame.set_track 灌的是 current_track；
            # OverlayPositionFrame 另有 track_obj。两者取到谁算谁。
            _gt = getattr(filt_frame, "track_obj", None) or getattr(
                filt_frame, "current_track", None)
            if _gt is not None:
                _gid = str(((getattr(_gt, "enc_settings", None) or {}).get("grp") or "")).strip()
            # 🔴 组语境判定（**唯一真源**）：`group_box_edit` / `group_fx_key_edit` 标记
            #   （由 `edit_video_settings` 从 `overlay_group_box` / `overlay_group_fx_key`
            #   挂到 filt_frame 上）**或** 轨道自带 `grp`。
            #   ⚠️ `filt_frame` 对节点/组入口**不调 set_track** ⇒ `_gt` 常为 None ⇒ 必须靠
            #      标记 + 标签现查组，不能只依赖 track。这样遮罩 / delogo / 简易位置 / 裁剪
            #      这些「像素域编辑器」无需各自判断是否成组。
            _evs_all = None
            if _want_group or _gid:
                with suppress(Exception):
                    _evs_all = self._get_enabled_video_tracks()
            # 🔴 2026-10-16（用户第 3 条）：**组最终标签自带组 id** ⇒ 直接正则解析，
            #   不依赖 `_last_group_label_map` 的时序（与 `_group_output_label_for_tap`
            #   同一口径，那份注释已说明「少一处时序依赖」）。命中后 `_gt` 取组内主。
            if not _gid and _label and _evs_all:
                _ml = re.match(r"^v_grp_(.+)_\d+$", str(_label))
                if _ml:
                    with suppress(Exception):
                        _gid_m = _ml.group(1)
                        _mems_m = [t for t in _evs_all
                                   if str((t.enc_settings or {}).get("grp") or "").strip() == _gid_m]
                        if len(_mems_m) >= 2:
                            _gid = _gid_m
                            _gt = (self._merge_group_base_track(_mems_m[0], _evs_all)
                                   or _mems_m[0])
            if not _gid and _want_group and _evs_all:
                # 用「组最终输出标签」反查：哪一组的 `_merge_group_row_label` == _label
                # （父行标签 = 组内合成链末环，`_merge_group_row_label` 是唯一出处）
                with suppress(Exception):
                    for _t in _evs_all[1:]:
                        _g = str(((_t.enc_settings or {}).get("grp") or "")).strip()
                        if not _g:
                            continue
                        _mems_g = [x for x in _evs_all
                                   if str((x.enc_settings or {}).get("grp") or "").strip() == _g]
                        if len(_mems_g) < 2:
                            continue
                        if _label is None or self._merge_group_row_label(_g, _mems_g) == _label:
                            _gid = _g
                            _gt = self._merge_group_base_track(_t, _evs_all) or _mems_g[0]
                            break
            if _box is None and _gid and _gt is not None and not force:
                with suppress(Exception):
                    _box = self._group_composite_box(_gt, _evs_all or self._get_enabled_video_tracks())
            # 没有 _fx_key 但已知组 ⇒ 现算 label（`_merge_group_row_label` 唯一出处）
            if _label is None and _gid and _evs_all:
                with suppress(Exception):
                    _mems_l = [t for t in _evs_all
                               if str((t.enc_settings or {}).get("grp") or "").strip() == _gid]
                    if len(_mems_l) >= 2:
                        _label = self._merge_group_row_label(_gid, _mems_l)
            # ---- 画面帧来源②：节点时间轴取帧器（plain / node / group 通用钩子）----
            _extract = getattr(filt_frame, "node_frame_extractor", None)
            _orig_sz = getattr(filt_frame, "node_frame_orig_size", None)
            # ---- 素材文件（组内主真实路径；plain = 本文件）----
            _src = ""
            with suppress(Exception):
                _src = (getattr(filt_frame, "current_file", "") or "").strip()
            if not _src and _gt is not None:
                with suppress(Exception):
                    _src = (getattr(_gt, "file_path", "") or "").strip()
            # ---- kind 判定（判据唯一出处）----
            # ⚠️ 组语境**不依赖 `_box` 是否求得出**：几何算不出（成员 <2 / 主画布无效）时
            #   也要报 `group_box`（`is_composite=True`、size 落 None），否则调用方会误判成
            #   普通节点 / plain 而拿组内主文件当素材（正是本轮要根治的错）。
            if _box is not None:
                kind = "group_box"
            elif _want_group and (_gid or _label):
                kind = "group_box"
            elif _orig_sz is not None or _extract is not None:
                kind = "node"
            else:
                kind = "plain"
            # ---- size（坐标空间）：group = 包装盒；node = 节点画布空间；plain = 不表态 ----
            # 🔴 2026-10-17 修回归：`_ppmb` 原先**只在 group_box 分支里绑定**，而末尾
            #   `MaterialCtx(..., frame_ppm=_ppmb)` 对三种 kind 一律求值 ⇒ plain / node
            #   语境抛 `UnboundLocalError`，被函数外层 `except: return None` 静默吞掉 ⇒
            #   **所有非组语境的 resolve_material_ctx 恒返回 None**（探针
            #   `tests/_verify_material_ctx.py` 场景 1「plain」直接红；编辑器侧表现为
            #   「真实帧参数取不到」）。两个变量统一在这里前置初始化。
            _png = None
            _ppmb = None
            if kind == "group_box":
                if _box is not None:
                    size = (int(_box[2]), int(_box[3]))
                    # 尺寸域：包装盒（w,h）；盒本身（含落位）单独放 box
                    _box4 = (float(_box[0]), float(_box[1]),
                             float(_box[2]), float(_box[3]))
                else:
                    # 几何求不出但仍知是组：尺寸留空（调用方回落），但身份/合成标记保留
                    size = (None, None)
                    _box4 = None
                # 组语境画面帧①：惰性生成合成帧（缓存 key = 语境 + 盒尺寸 + 状态签名）
                # 🔴 2026-10-17（用户：「除了文字水印，其它一律别落盘」）：主体给 **PPM 字节**
                #   （`frame_ppm`），`frame_png` 留 None —— 全部消费方已改走 `content_ppm`
                #   （字节直接喂 ffmpeg 管道），**这条路径零磁盘写**。
                #   （`_png` / `_ppmb` 已在 kind 判定前统一置 None —— 见上方注释。）
                if _box is not None:
                    with suppress(Exception):
                        _ppmb = self._material_ctx_group_png(
                            filt_frame, _gt, _box, as_bytes=True)
                        if not isinstance(_ppmb, (bytes, bytearray)):
                            _ppmb = None
            elif kind == "node":
                size = self._node_canvas_space_size(filt_frame, _orig_sz) \
                    if _orig_sz is not None else (None, None)
                _box4 = None
                _png = None
            else:
                size = (None, None)
                _box4 = None
                _png = None
            if size and (not size[0] or not size[1]):
                size = (None, None)
            return MaterialCtx(
                kind=kind,
                src_file=_src or None,
                label=_label,
                frame_png=_png,
                frame_extract=_extract,
                size=size,
                box=_box4,
                is_composite=bool(kind == "group_box"),
                orig_size=_orig_sz,
                frame_ppm=_ppmb,
            )
        except Exception:
            return None

    def _material_ctx_frame_sig(self):
        """组合成帧的**状态签名**（`_material_ctx_group_png` 缓存 key 的一部分）。

        🔴 2026-10-16 第七轮（用户实测 bug：**「上一次保存启用的画布模式，本次取消勾选后
        没有立即生效，其他位置编辑器显示的画面还是画布模式改变过的画面，保存后重新打开
        才正确」**）：合成帧 PNG 的缓存 key 原来只有 `(组 id, 盒宽, 盒高)`，而**盒尺寸不随
        父行的效果变** —— 取消画布模式后盒一字不差 ⇒ 缓存命中 ⇒ 返回的还是旧图。
        探针 `tests/_dbg_ctx_png_stale.py` 实测（同一条路径对同一只组取两次合成帧）：
          · 画布开 → 成员区 local(85,60) = 黑（内容被缩到盒中心）
          · 取消画布（缓存路径）→ **仍是黑**（陈旧）✗；手动清缓存 → 恢复 (0,127,0) 绿 ✓
          · 再挂回画布 → 又拿到灰绿帧（旧图被新状态覆写后的反向陈旧）✗

        ⇒ key 必须带上「会改变这一帧的**一切**设置」，本函数就是那份签名的唯一出处：
          · 媒体 / 组 / 模式（`_graph_media_signature` 同口径：含文件、grp、is_grp_base、模式）；
          · 每条**启用视频轨**的 `enc_settings`（成员落位/裁剪/缩放…全在里面）；
          · `node_fx`（**画布模式就住在这里**，也是本轮 bug 的直接变量）。

        代价 = 每开一次编辑器算一次 repr（几 KB 级），换来「绝不给陈旧画面」。
        异常（脏数据等）⇒ 抛给调用方；`_material_ctx_group_png` 拿不到签名时**放弃缓存**
        （每次重生成），宁可再生一次，也不给一张可能过期的画面。
        """
        _parts = [repr(self._graph_media_signature())]
        for _t in (self._get_enabled_video_tracks() or []):
            _es = getattr(_t, "enc_settings", None)
            _parts.append(repr(sorted((_es if isinstance(_es, dict) else {}).items())))
        _fx = getattr(self, "node_fx", None)
        _parts.append(repr(sorted((_fx if isinstance(_fx, dict) else {}).items())))
        return hash(tuple(_parts))

    def _material_ctx_dump_ppm(self, gid, sig, data):
        """**内存 PPM 字节 → 文件**（只给「必须要一条路径」的调用方，见调用处说明）。

        🔴 2026-10-17：缓存主体在内存（`_material_ctx_png_cache` 存字节），落盘只剩这一
        步 —— 位置编辑器 `open_watermark_overlay_editor` 的 `content_file` 契约要路径
        （7 处消费：起 ffmpeg 抽帧、`os.path.exists`、拼 `-i`）⇒ 只能给一个真文件。
        · 文件名**按状态分名**（`grp_box_<gid>_<sig>.ppm`）—— 与老 PNG 版同口径，绝不让
          两个状态共用一个文件（「A→B→A」反向陈旧）。
        · 扩展名 `.ppm`：ffmpeg 按内容嗅探即可，但扩展名对的字段外调用方（拖拽 / 预览）
          也能直接吃。
        · **只在文件缺失/尺寸不符时写**；写失败返回 None ⇒ 调用方回落旧行为，绝不阻塞。
        """
        try:
            _tag = re.sub(r"\W", "_", str(gid or ""))
            _p = os.path.join(tempfile.gettempdir(),
                              "grp_box_%s_%s.ppm" % (_tag, sig if sig is not None else "nc"))
            if not os.path.exists(_p) or os.path.getsize(_p) != len(data):
                with open(_p, "wb") as _f:
                    _f.write(data)
            return _p
        except Exception:
            return None

    def _material_ctx_group_png(self, filt_frame, base_track, box, as_bytes=False):
        """组语境的**合成帧**（`resolve_material_ctx` 内部用，带缓存）。

        as_bytes=False（旧口径）：返回**文件路径**（本函数现 famous=… 已基本不使用，
          只留给真的一定要路径的调用方 —— 见下）；
        as_bytes=True（2026-10-17 用户定案「除了文字水印，其它一律不落盘」）：
          返回 **PPM 字节**，全程零磁盘写。

        缓存 key = (组 id, 盒宽, 盒高, **状态签名** `_material_ctx_frame_sig()`) —— 盒尺寸
        不变但设置变了（典型：取消/勾上父行「画布模式」）也**必然失效**；盒尺寸变了自然失效。
        🔴 合成帧**不按尺寸缓存**：原来 key 只有 (组 id, 盒宽, 盒高)，而盒尺寸不随效果变
        ⇒「换效果、盒不变」会命中陈旧条目。状态签名进来后，不同状态一律强制重生成。
        ⚠️ 生成失败返回 None（调用方落回节点取帧器 / 组内主文件，绝不阻塞）。

        🔴 2026-10-17（用户：「父行标签的取帧有落盘行为吗？我希望的是全内存缓存」）：
          缓存条目直接存 **PPM 字节**（`_group_box_snapshot_png(pipe_ppm=True)`），
          命中即**不重跑 ffmpeg**（贵的是 ffmpeg，不是文件）。
          · 全部消费方（位置编辑器 / 轨迹起始·结尾坐标 / delogo / 遮罩）已改走
            `content_ppm`（位图字节直接喂 ffmpeg 管道，**连临时文件都不写**）
            ⇒ `as_bytes=True` 是**默认路径**；
          · **淘汰条目只丢内存、绝不删文件**（老写法 `os.remove(_old)` 会把别的调用方
            正拿着的文件删掉 ⇒ 编辑器静默回落「组内主画面」）；
          · 仍保留 `_material_ctx_dump_ppm`（`as_bytes=False` 时落一份）—— 只给**真的要
            一条路径**的场景（文字水印真实帧那种必须 `-i <文件>` 的旧契约）。
        """
        try:
            _gid = str(((getattr(base_track, "enc_settings", None) or {}).get("grp") or "")).strip()
            if not _gid or base_track is None:
                return None
            try:
                _sig = self._material_ctx_frame_sig()
            except Exception:
                _sig = None
            _cache = getattr(self, "_material_ctx_png_cache", None)
            if not isinstance(_cache, dict):
                _cache = {}
                self._material_ctx_png_cache = _cache
            if _sig is None:
                # 签名取不到 ⇒ **不读不写缓存**（每次重生成 + 独立文件名），绝不给陈旧图。
                _key = None
            else:
                _key = "%s|%d|%d|%s" % (_gid, int(box[2]), int(box[3]), _sig)
                _hit = _cache.get(_key)
                if isinstance(_hit, (bytes, bytearray)) and len(_hit) > 16:
                    # 内存命中 ⇒ **不再启动 ffmpeg**
                    _hitb = bytes(_hit)
                    return _hitb if as_bytes else self._material_ctx_dump_ppm(
                        _gid, _sig, _hitb)
            _evs = self._get_enabled_video_tracks()
            _ppmb = self._group_box_snapshot_png(_evs[0] if _evs else None, _evs, base_track,
                                                 pipe_ppm=True)
            if not _ppmb:
                return None
            if _key is not None:
                _cache[_key] = _ppmb
                # 只留最近 8 条，防长会话堆内存；⚠️ **只丢内存条目，绝不删文件** ——
                # 见本函数 docstring（编辑器可能正拿着那条路径）。
                while len(_cache) > 8:
                    _cache.pop(next(iter(_cache)), None)
            return _ppmb if as_bytes else self._material_ctx_dump_ppm(_gid, _sig, _ppmb)
        except Exception:
            return None

    def _get_canvas_size(self, main_track):
        """
        获取主视频最终画布尺寸（考虑 pad 或 裁剪/旋转/缩放后的实际尺寸）。
        """
        # 检查是否启用画布偏移（pad）
        pad_enabled = main_track.enc_settings.get('pad_enabled', False)
        if pad_enabled:
            try:
                w = int(main_track.enc_settings.get('pad_width', '').strip())
                h = int(main_track.enc_settings.get('pad_height', '').strip())
                if w > 0 and h > 0:
                    return w, h
            except (ValueError, TypeError):
                pass
    
        # 未启用 pad 或 pad 尺寸无效，使用主视频实际渲染尺寸（按正确顺序计算）
        # 先获取原始尺寸（不含旋转）
        w, h = self._cached_video_dimensions(main_track.file_path)
        if w is None or h is None:
            w, h = 1280, 720  # 降级默认值
    
        # 使用新函数按 crop -> rotate -> scale 顺序计算
        return self.compute_final_size_with_order(w, h, main_track.enc_settings)
    
    def _get_video_render_size(self, track, filt_frame=None):
        """
        获取视频轨道在应用了裁剪、旋转、缩放后的最终渲染尺寸。
        若提供了 filt_frame，则从该控件读取设置，否则从 track.enc_settings 读取。
        """
        if filt_frame is not None:
            settings = {
                "crop_enabled": filt_frame.crop_enabled.get(),
                "crop_width": filt_frame.crop_width.get(),
                "crop_height": filt_frame.crop_height.get(),
                "scale_enabled": filt_frame.scale_enabled.get(),
                "scale_method": filt_frame.scale_method.get(),
                "scale_width": filt_frame.scale_width.get(),
                "scale_height": filt_frame.scale_height.get(),
                "rotate": filt_frame.rotate.get()
            }
        else:
            settings = track.enc_settings
    
        # 获取原始尺寸（不含任何旋转，直接从 ffprobe 获取）
        w, h = self._cached_video_dimensions(track.file_path)
        if w is None or h is None:
            return 320, 240  # 返回安全默认值
    
        # 使用统一顺序计算（crop -> rotate -> scale）
        return self.compute_final_size_with_order(w, h, settings)
    
    def _to_canvas_coords(self, x, y, scale, scale_y=None):
        # scale_y：SAR 拉伸预览时 y 轴独立因子（2026-09-07）；None=与 x 同（正常文件不变）
        return int(x * scale), int(y * (scale if scale_y is None else scale_y))

    def _to_real_coords(self, cx, cy, scale, scale_y=None):
        _sy = scale if scale_y is None else scale_y
        return int(round(cx / scale)), int(round(cy / _sy))
    
    def _draw_background(self, canvas, canvas_w, canvas_h, scale, main_track, sub_tracks,
                         offset_x, offset_y, main_render_size, current_edit_track=None, tag="bg",
                         scale_y=None, group_box=None):
        canvas.delete(tag)
        if main_render_size:
            main_w, main_h = main_render_size
        else:
            main_w, main_h = canvas_w, canvas_h
        left = offset_x
        top = offset_y
        right = offset_x + main_w
        bottom = offset_y + main_h
        vis_left = max(0, left)
        vis_top = max(0, top)
        vis_right = min(canvas_w, right)
        vis_bottom = min(canvas_h, bottom)
        if vis_right > vis_left and vis_bottom > vis_top:
            cx1, cy1 = self._to_canvas_coords(vis_left, vis_top, scale, scale_y)
            cx2, cy2 = self._to_canvas_coords(vis_right, vis_bottom, scale, scale_y)
            canvas.create_rectangle(cx1, cy1, cx2, cy2, outline="deepskyblue", width=2, dash=(4, 4), fill="", tags=tag)
            canvas.create_text(cx1 + 5, cy1 + 5, anchor="nw", text=_("主视频"), fill="deepskyblue", font=("Arial", 9), tags=tag)
        sub_order = {sub: idx+1 for idx, sub in enumerate(sub_tracks)}
        for sub in sub_tracks:
            if current_edit_track and sub == current_edit_track:
                continue
            # 从 enc_settings 读取 overlay 状态
            if not sub.enc_settings.get('overlay_enabled', True):
                continue
            size = self.get_rendered_size(sub)
            if not size:
                continue
            sw, sh = size
            # 定位语义（2026-08-26 统一）：overlay_x/y 的 w/h 恒为内容盒（sw/sh）；
            # 旋转时 d×d 正方形自动居中（锚点=内容盒左上角），虚线框=内容矩形本身
            _ra_sub = _opt_float(sub.enc_settings.get("rotate_angle", 0) or 0, 0.0)
            x_expr = sub.enc_settings.get('overlay_x', '0')
            y_expr = sub.enc_settings.get('overlay_y', '0')
            x_val = safe_eval_expr(x_expr, {"W": canvas_w, "H": canvas_h, "w": sw, "h": sh})
            y_val = safe_eval_expr(y_expr, {"W": canvas_w, "H": canvas_h, "w": sw, "h": sh})
            if x_val is None or y_val is None:
                continue
            x_val = max(0, min(x_val, canvas_w - sw))
            y_val = max(0, min(y_val, canvas_h - sh))
            if _ra_sub != 0:
                # 画旋转后的内容多边形（内容矩形以内容中心=旋转正方形中心为中心绕 rotate_angle 旋转）
                cx, cy = x_val + sw / 2.0, y_val + sh / 2.0
                pts = rotate_rect_polygon(cx - sw / 2.0, cy - sh / 2.0, sw, sh, _ra_sub)
                cpts = [tuple(self._to_canvas_coords(px, py, scale, scale_y)) for px, py in pts]
                canvas.create_polygon(cpts, outline="lightgreen", width=2, dash=(4, 4), fill="", tags=tag)
                _sx0 = min(p[0] for p in cpts)
                _sy0 = min(p[1] for p in cpts)
                _sy1 = max(p[1] for p in cpts)
            else:
                cx1, cy1 = self._to_canvas_coords(x_val, y_val, scale, scale_y)
                cx2, cy2 = self._to_canvas_coords(x_val + sw, y_val + sh, scale, scale_y)
                canvas.create_rectangle(cx1, cy1, cx2, cy2, outline="lightgreen", width=2, dash=(4, 4), fill="", tags=tag)
                _sx0, _sy0, _sy1 = cx1, cy1, cy2
            # ⚠️ 2026-10-12：序号由「框内左上角」改挂**框外侧**（上方；贴顶时下方）——
            #   子视频缩放较小时框内那 1~2 位红色编号同样会压住框内容，与活动框的
            #   "当前子视频" label 同一诉求、同一处理（判据与 _generic_overlay_editor 一致）。
            _s_up = _sy0 > 20
            canvas.create_text(max(0, _sx0), (_sy0 - 3) if _s_up else (_sy1 + 2),
                               anchor="sw" if _s_up else "nw", text=str(sub_order[sub]),
                               fill="red", font=("Arial", 10, "bold"), tags=tag)
        # 组范围虚线框（2026-10-15，用户要求）：编辑组内成员时把**组的组合包围盒**画出来，
        # 让用户看清"这一组总共占主画布哪一块"。纯显示 —— 位置编辑器仍拖**本轨自己**，
        # 组的整体落位请到「视频节点」拖组合框（该框的坐标已含组内相对偏移）。
        if group_box:
            _gx0, _gy0, _gw0, _gh0 = group_box
            _gc1 = self._to_canvas_coords(_gx0, _gy0, scale, scale_y)
            _gc2 = self._to_canvas_coords(_gx0 + _gw0, _gy0 + _gh0, scale, scale_y)
            canvas.create_rectangle(_gc1[0], _gc1[1], _gc2[0], _gc2[1],
                                    outline="#FF8C00", width=2, dash=(6, 3), fill="", tags=tag)
            canvas.create_text(_gc1[0] + 5, _gc1[1] + 5, anchor="nw", text=_("组"),
                               fill="#FF8C00", font=("Arial", 9, "bold"), tags=tag)




    # ---------- 通用公共位置可视化编辑器函数 ----------
