_CHAIN_NOOP = ("null", "anull", "copy", "acopy")


def _chain_filter_names(chain):
    """滤镜串 → 去重保序的滤镜名列表（只取每段 `=` 前的名字）。

    ⚠️ 必须滤掉 no-op：`build_video_filter_chain` 在**没有任何效果**时返回 `null`
    （ffmpeg 的空操作滤镜），不过滤的话列表里会显示「插入效果：null」。
    """
    out = []
    for _p in (chain or "").split(","):
        _nm = _p.split("=", 1)[0].strip()
        if _nm and _nm not in _CHAIN_NOOP and _nm not in out:
            out.append(_nm)
    return out


def node_effect_summary(settings, chain=None):
    """节点已挂效果的**短摘要**（纯显示，给列表「插入效果」列用）。

    2026-10-02 L1「自由顺序」：一个节点可挂 N 个效果，摘要按**生效顺序**把各项的滤镜名
    拼起来（" · " 连接，最多 3 个 + …）。
    ⇒ 顺带解决「把插入的那条链隐藏了」：旧版单项自定义只显示一个笼统的「自定义命令」，
      现在列表列直接看得到这条链到底是什么（drawbox · unsharp …）。

    chain=None 时按视频节点口径自己算**合并串**；音频节点请把合并串传进来
    （它走 `node_audio_effect_chain_multi`，是方法不是模块级函数）。
    """
    if chain is None:
        # 2026-10-09：**逐效果项**取名，而不是把合并串拆成滤镜名。
        # 遮罩段是 5~8 段带标签的子图（format · split · drawbox · alphaextract · blend ·
        # alphamerge …），按滤镜名拆会得到一串看不懂的内部名，`_chain_filter_names`
        # 又认不出它是一个「遮罩」⇒ 列表列显示不出来。改按项取：勾了遮罩的那一项
        # 直接记一个专用名 "mask"（显示层查 node_fx_display 得「遮罩」）。
        _names = []
        for _it in node_fx_items(settings):
            _cu = (_it.get(NODE_FX_CUSTOM_KEY) or "").strip()
            if _cu:
                _add = _chain_filter_names(_cu)
            elif _it.get("mask_enabled"):
                _add = ["mask"]
            else:
                try:
                    _add = _chain_filter_names(node_effect_chain(_it))
                except Exception:
                    _add = []
            for _n in _add:
                if _n not in _names:
                    _names.append(_n)
    else:
        _names = _chain_filter_names(chain)
    if not _names:
        return ""
    _disp = [node_fx_display().get(n, n) for n in _names]
    # 2026-10-03：该节点挂着自定义命令 ⇒ 摘要里第一个名字前标「自定义 · 」，
    # 这样「参数面板的 delogo」和「自己敲的那条」一眼能分开（见 node_custom_prefix）。
    if _disp and any((_it.get(NODE_FX_CUSTOM_KEY) or "").strip()
                     for _it in node_fx_items(settings)):
        _disp[0] = node_custom_prefix() + _disp[0]
    if len(_disp) > 3:
        return " · ".join(_disp[:3]) + " …"
    return " · ".join(_disp)


def orphan_node_fx_keys(available_keys, fx):
    """已存的效果里**在当前图找不到落点**的那些 key（孤儿）→ list[key]（保序）。

    为什么要专门有这个概念（2026-09-28）：`_apply_node_fx` 碰到找不到的 key 只日志
    提示并跳过 —— 条目本身**一直留在项目里**，于是每次保存/载入都刷同一条提示，
    而用户根本不知道去哪儿删。给它们一个可列举、可清理的出口才是根治。

    ⚠️ 判据必须基于**「应用效果前」的干净图**算出的指纹集合：插入效果会让图多出
    一段、其后段序号整体漂移 ⇒ 拿成品图算会把正常效果误判成孤儿（2026-09-28 实测）。

    available_keys：当前图里真实存在的指纹集合（调用方从干净图算出）。
    fx：self.node_fx / self.node_audio_fx。空 dict 返回 []。
    """
    if not fx:
        return []
    _have = set(available_keys or ())
    return [k for k in fx if k not in _have]


def validate_node_custom_chain(text):
    """校验用户在节点窗写的自由命令串。返回 **(ok, 值或错误原因, 提示列表)**。

    2026-10-03 起：`[ 标签 ]` 与 `;` 从「禁用」改为**放行 + 提示**（方案 B —— 保留用户写的
    标签，撞名/悬空只提示、不拦、不改名）。

    ⚠️ 为什么当初要禁 `[` `]` 和 `;`：不是校验本身，是**插入手法**——`insert_after_at`
    只接得住「单段、零标签」。手法补上（`insert_effect_subgraph`）之后这层禁令就成了
    无意义的挡箭牌。纯逗号链（99% 需求）老写法照跑、且比带标签更省事，所以放行 ≠ 推荐：
    提示里会点出容易踩的坑，但绝不替用户决定。

    - ok=False：值里是**硬错误**（命令空 / 方括号不配对 / 空标签名）→ 调用方拦下；
    - ok=True：值是归一化后的串，提示列表是**警告**（可继续），例如：
      - 末段没写输出标签（运行时自动收口接回主链）；
      - 标签含特殊字符（ffmpeg 标签只认字母/数字/下划线）；
      - 前向引用（第 N 段引用了排在后面的段才产出的标签 → 这条支线会断）。
    ⚠️ **重名不在这里查**：得有当前图才知道哪些标签已被占用，那一步在
    `insert_effect_subgraph` 里做（那时图在手），与运行时提示共用一套文案。
    """
    v = (text or "").strip()
    if not v:
        return False, _("命令为空"), []
    if v.count("[") != v.count("]"):
        return False, _("方括号不配对（写了几个 [ 就得有几个 ] ）"), []
    _segs = graph_split(v)
    _hints = []
    _future_outs = set()
    for _i in range(len(_segs) - 1, -1, -1):
        _ins, _body, _outs = graph_parse_chain(_segs[_i])
        for _n in _ins:
            if _n in _future_outs:
                _hints.append(_("第 %d 段引用了 [%s]，但产出它的段排在第 %d 段之后（前向引用）"
                              " → 这条支线会断。") % (_i + 1, _n, _i + 1))
        for _n in _outs:
            if not _n:
                return False, _("第 %d 段有空的方括号（[] 里要写标签名）") % (_i + 1), []
            if not all(_c.isalnum() or _c == "_" for _c in _n):
                _hints.append(_("第 %d 段的标签 [%s] 含特殊字符（建议只用字母/数字/下划线），"
                              "ffmpeg 可能认不出来。") % (_i + 1, _n))
            _future_outs.add(_n)
    # ⚠️ 只在**真的分了段**时提示末段缺输出：单段纯逗号链（99% 的老写法）本来就
    # 没有输出标签，提示它只会变成每写一条都挨一句废话。
    if len(_segs) > 1 and not graph_parse_chain(_segs[-1])[2]:
        _hints.append(_("末段没写输出标签，运行时会自动收口接回本节点下游；"
                      "想让它流向别处请自己补一个输出标签。"))
    return True, v, _hints


def node_custom_tip():
    """节点「自定义命令」窗的**说明文案**（纯显示层，三处弹窗共用一份）。

    2026-10-03 起带标签的写法（`delogo…[uc1];[uc1]unsharp…`）被放行，这里就是唯一一处
    对外解释「带标签怎么写才对」的文案 —— 放成函数（而不是模块级常量）是为了让 multi
    版能直接在里面套 `_()`；打印/日志一律不引用本函数。
    ⚠️ 双版同构：base 不装 gettext 恒等返回中文，multi 返回英文；改这一处务必同步另一版。
    """
    return (
        _("直接写 ffmpeg 滤镜串，插在这个节点之后（多个滤镜用逗号分隔）。\n"
        "用分号 ; 分段时可以写 [标签]，让下一段接着上一段处理：\n"
        "  例：delogo=x=10:y=10:w=200:h=60[uc1];[uc1]unsharp=5:5:1.0\n"
        "要点：\n"
        " · 末段写不写输出标签都能跑 —— 不写就自动接回本节点下游，"
        "写了就流向该标签（想并进别的支线就用它）。\n"
        " · 标签只认字母 / 数字 / 下划线，[12313] 这种纯数字也好使。\n"
        " · 标签别跟别的阶段重名（撞名 ffmpeg 会拒掉整条链）；重名或断链时，"
        "日志会点名是哪个标签出问题。\n"
        " · 分叉合流（split → 两路各处理 → blend）也能写，一样用标签串起来。\n"
        "⚠️ 自定义命令是高级用法：写错 ffmpeg 会直接报错，按报错指到的标签改即可。")
    )


def node_custom_prefix():
    """自定义命令条目在「插入效果」列的**显示前缀**（纯显示层，multi 版套 `_()`）。

    2026-10-03：自定义命令能带标签了，同一节点上可能同时挂着「参数面板的 delogo」和
    「自己敲的 delogo=…[123];[123]…」两条，摘要长得一模一样 —— 用户根本分不出哪条是
    自己写的（实测困惑）。前缀只贴在第一个滤镜名上，够认就行。
    ⚠️ 双版同构：base 恒等返回中文，multi 走 _()；只用于显示，不参与比较/查表。
    """
    return _("自定义 · ")


def node_effect_chain(settings, graph_id=None):
    """设置 dict → 可插入到节点后面的**纯效果**滤镜串。

    刻意关掉 trim / subtild / speed / scale / format / fade —— 那些是「素材出口」
    层面的事，挂到中间节点上语义不对（且会改变节点流向的时间轴）。保留：裁剪 / 旋转 /
    翻转 / 去水印 delogo / 增强 / IVTC / 去块 / 降噪 / 锐化 / 色彩 / 抠像 / **遮罩**。

    遮罩（2026-10-09 起开放，此前 include_mask=False）：
    - 症状：节点窗里勾了遮罩 → 存进去的效果串恒为 `null`（ffmpeg 空操作滤镜），
      列表「插入效果」列显示空 ⇒ 等于**根本插不进去**（用户实测）。
    - 为什么可以开：遮罩是**纯几何 + alpha**，不消费 trim/speed/时间轴，与上面那批
      「出口层面」不是一回事；坐标基准在节点语境下由**节点取帧器**给
      （`_open_node_tap_dialog` 的 frame_orig_size = 该节点输出真实尺寸），所见即所得。
    - ⚠️ 遮罩段**自带 [标签] 且跨多段**（split=3 → drawbox → alphaextract → blend →
      alphamerge）⇒ graph_id **必须每个节点唯一**，否则两个节点都挂遮罩会撞名
      （ffmpeg 拒整条链 "multiple outputs with the name"）。调用方传
      `node_fx_graph_id(key)`；缺省 None = 旧常量 "nodefx"（仅供摘要/显示，不参与构图）。
    """
    s = dict(settings or {})
    # 自定义命令优先（2026-09-27「节点自由插入命令」）：用户在节点窗直接写的滤镜串，
    # 原样插回。校验在入口做（validate_node_custom_chain），这里只认钥匙。
    _custom = (s.get(NODE_FX_CUSTOM_KEY) or "").strip()
    if _custom:
        return _custom
    return build_video_filter_chain(
        s,
        include_subtitle=False, include_speed=False, include_trim=False,
        include_format=False, include_scale=False, include_fade=False,
        include_mask=True,
        enhance_settings=s.get("enhance"),
        graph_id=(graph_id or "nodefx"),
    )


def _canvas_graph_as_chain(graph, src_label="[0:v]"):
    """把「**图级**」画布产物改写成本项目其它链统一的「**链级**」片段形态。

    🔴 为什么必须改写（2026-10-16 真机实测，不是推测）：`build_canvas_filtergraph` 产的是
    **一整张图** —— 它的第一段就是自带源 `color=c=…[bg0]`（**0 个输入**），而
    `insert_effect_subgraph` 的「入口注入」假定**第一段就是本链的入口**：

        · 第一段**有**入口标签 → 把它改写成上游标签；
        · 第一段**没有**入口标签 → 给第一段**补**一个上游标签。

    于是把原样画布图交给它，`color` 被补上一个输入标签 ⇒ ffmpeg 直接拒：

        More input link labels specified for filter 'color' than it has inputs: 1 > 0
        Error linking filters
        Error : Invalid argument

    ⇒ 唯一需要的改写：把**消费 src_label 的那一段**（内容腿）挪到最前，并摘掉它的入口
    标签 —— 让它变成「隐式首输入」，与 `node_effect_chain` / `build_video_filter_chain`
    产出的老形状**完全同形**，注入逻辑自会把它接上去。
    其余段**相对顺序一字不动**（画布底 2 段在前、overlay 收口在后、遮罩段仍在最末）；
    ffmpeg 按**标签**连线、不按出现顺序 ⇒ 文本顺序变化不改变任何语义（真机像素级回归锁
    `tests/_verify_group_material_canvas.py` 第 ③ 段就是为此）。

    形态不符（找不到 src_label / 已经在最前 / 异常）⇒ **原样返回**，绝不猜。
    """
    try:
        _label = str(src_label)
        _parts = [p for p in str(graph).split(";") if p.strip()]
        if not _parts:
            return graph
        _k = None
        for _i, _p in enumerate(_parts):
            if _p.lstrip().startswith(_label):
                _k = _i
                break
        if _k is None:
            return graph
        _entry = _parts[_k].lstrip()[len(_label):]
        if not _entry.strip():
            return graph
        return ";".join([_entry] + _parts[:_k] + _parts[_k + 1:])
    except Exception:
        return graph


def node_material_chain(settings, graph_id=None, material_size=None):
    """设置 dict → **「独立素材」口径**的效果链（2026-10-16 用户心智模型）。

    与 `node_effect_chain` 的区别只有一个：**这个节点被当成一条完整素材，而不是「链中间
    的一段像素处理」**。目前唯一的使用者是**组的最终输出标签** `[v_grp_<g>_<n-1>]`
    （列表里的虚拟父行）—— 用户定案：

        「针对这个组内最终标签 [xxx]，要完全当成一个独立的视频对待……应用一切子视频
          滤镜……设置窗里的缩放和旋转也不应该有新规则，就把这个标签当成一个为组内
          包装盒大小的独立素材。」

    ⇒ 于是这里**多开** 4 个开关，让父行窗口里那些控件真的生效：

    | 开关 | 为什么这里可以开（普通中间节点为什么不能） |
    |---|---|
    | `include_scale` | 缩放只改**本支路**的分辨率。组节点往下只剩「组变换 + 一次 overlay 到主画布」，overlay 的 `w`/`h` 会自动跟着缩放后的尺寸走 ⇒ 与「普通子视频缩放」完全同构。中间节点不行：下游还有别的代码按插入前的画布/坐标假设算。 |
    | `include_fade` | 淡入淡出用绝对流时间 `st`。组画布是 `color=…:d=<组内主显示窗口>`，**它自己就是从 t=0 起的一条流** ⇒ `st=0` 语义正确。中间节点不行：上游已被 trim/偏移过，从 0 淡入会淡错位置。 |
    | `include_alpha` | 整组透明度。组画布底是 `color=c=black@0`（带 alpha），overlay 也吃 alpha ⇒ 安全。 |
    | `chroma` | 绿幕/纯色抠像。整组画面抠像与子视频抠像同构（取样对象就是这张合成画面）。 |

    **仍然关**的 4 个（不是"新规则"，是它们对**任何**中间节点都不成立，父行也不豁免）：
    - `include_trim` / `include_speed`：都写 `setpts`，会改时间戳。组画布时长 = 组内主
      显示窗口、组的出现时段由 `enable=` 表达式承载 ⇒ 再插一层时间变换会双重语义打架
      （音频同步 / 其它节点定位全错）。
    - `include_format`：中途改像素格式会打断下游标签继承的格式假设。
    - `include_subtitle`：字幕必须在**最终画布尺寸**上烧录；插在组节点会被后续叠加层盖住。

    ⚠️ 零回归：4 个新开关**只在用户真的勾了对应控件时才产出滤镜**（scale_enabled /
    fade / alpha / chroma_enabled 默认全关）⇒ 没勾 = 与 `node_effect_chain` 逐字节一致。

    🔴 2026-10-16（用户第六轮实测：「画布模式 … 没接入，不支持」）——**画布模式必须真的产图**：
      此前本函数只转发 `build_video_filter_chain`，而**画布图只由 `build_canvas_filtergraph`
      产出**（它的调用点全在「主视频 / 子视频 / 预览」路径）⇒ 素材节点勾了画布模式、存了
      `canvas_segments`，却一个滤镜都不产生（探针实测 `node_material_chain(...) == 'null'`）。
      ⇒ 与主视频/子视频**收敛到同一个生成器**（唯一出处，绝不另写一套画布实现）：
        · `W,H` = **该素材自己的尺寸**（= 包装盒，与编辑器 `_open_canvas_editor` 看到的
          `pic_w/pic_h` 同源；由调用方经 `material_size` 传进来 —— 模块级函数没有 app 上下文，
          尺寸只能由调用方给）；
        · `canvas_color="black@0"`，**透明底**：素材节点是一条**被叠加的层**，
          黑底会盖死主视频（与子视频画布同一条已验证路线）；
        · `crop_enabled=False`：画布模式接管位置/尺寸/旋转 ⇒ 与该标签自己的裁剪互斥
          （编辑器在节点语境本就不叠加裁剪框，见 `_open_canvas_editor` 的 `node_src` 分支）；
        · `src_label="[0:v]"`：入口标签会被 `insert_effect_subgraph` 换成节点的上游标签
          （它的第 1 步「入口注入」就是这么做的），故这里写什么都不影响接线；
        · **形态改写**（`_canvas_graph_as_chain`）：生成器产的是**图级**产物（第一段是自带源
          `color=…`），而本函数必须返回**链级**片段 ⇒ 把内容腿挪到最前、摘掉它的入口标签
          （不改写会被「入口注入」给 `color` 补一个输入标签 ⇒ ffmpeg 拒整条链）。
      尺寸未知 / 生成失败 ⇒ **回落普通素材链**（宁可不生效，也绝不产出坏图）。

    `material_size` 缺省 None ⇒ 行为与改动前逐字节一致（老调用方零回归）。
    """
    s = dict(settings or {})
    _custom = (s.get(NODE_FX_CUSTOM_KEY) or "").strip()
    if _custom:
        return _custom
    # ---- 画布模式（canvas_mode + canvas_segments）：走画布图，取代普通素材链 ----
    #     取代而非追加：画布模式接管 位置/尺寸/旋转 ⇒ 普通链里的 scale 必须让位
    #     （`build_canvas_filtergraph` 内部重建内容腿时本就关掉 crop/scale/rotate，
    #      与主视频/子视频路径同一口径）。
    if bool(s.get("canvas_mode")) and bool(s.get("canvas_segments")) and material_size:
        try:
            _mw = int(round(float(material_size[0])))
            _mh = int(round(float(material_size[1])))
        except (TypeError, ValueError, IndexError):
            _mw = _mh = 0
        if _mw > 0 and _mh > 0:
            _g = str(graph_id or "nodefx")
            _cv_s = dict(s)
            _cv_s["crop_enabled"] = False
            try:
                _cg = build_canvas_filtergraph(
                    _cv_s, _mw, _mh,
                    src_label="[0:v]", out_label="v_mcv_%s" % _g,
                    canvas_color="black@0", base_vf=None, tag="m%s" % _g)
            except Exception:
                _cg = None
            if _cg:
                return _canvas_graph_as_chain(_cg, src_label="[0:v]")
    return build_video_filter_chain(
        s,
        include_subtitle=False, include_speed=False, include_trim=False,
        include_format=False,
        include_scale=True, include_fade=True, include_alpha=True,
        include_mask=True,
        enhance_settings=s.get("enhance"),
        chroma_settings=(s if s.get("chroma_enabled", False) else None),
        graph_id=(graph_id or "nodefx"),
    )


def png_size(path):
    """读 PNG 头部拿 (宽, 高) —— 纯 stdlib（本项目禁 PIL）。

    为什么不用 PIL/ImageTk：铁律「绝不引入 PIL 及除 dnd2 外任何第三方库」。
    PNG IHDR 布局固定：8 字节签名 + 4 长度 + 4 "IHDR" + 4 宽 + 4 高（大端）。
    """
    try:
        with open(path, "rb") as f:
            _h = f.read(26)
        if len(_h) < 24 or _h[:8] != b"\x89PNG\r\n\x1a\n":
            return None
        _w, _hh = struct.unpack(">II", _h[16:24])
        return (_w, _hh) if (_w and _hh) else None
    except Exception:
        return None


def _ppm_parse_header(data):
    """解析内存 PPM(P6) 头 → (宽, 高, 像素起点偏移)；解析失败返回 None。

    与 png_size 同口径，但针对**管道内存帧**（image2pipe -vcodec ppm 输出的字节），
    不碰磁盘。ffmpeg ppm 复用器头固定为 `P6\\n<W> <H>\\n<maxval>\\n`（maxval 恒 255）。
    """
    try:
        if not data or data[:2] != b"P6":
            return None
        _k = 2
        _L = len(data)
        while _k < _L and data[_k] in b" \t\r\n":
            _k += 1
        _vals = []
        _cur = bytearray()
        while _k < _L and len(_vals) < 3:
            _c = data[_k]
            if _c in b" \t\r\n":
                if _cur:
                    _vals.append(int(_cur))
                    _cur = bytearray()
            else:
                _cur.append(_c)
            _k += 1
        if len(_vals) < 3:
            return None
        _w, _h, _maxv = _vals
        while _k < _L and data[_k] in b" \t\r\n":
            _k += 1
        return (_w, _h, _k)
    except Exception:
        return None


def ppm_size(data):
    """读内存 PPM(P6) 字节头拿 (宽, 高) —— 零磁盘，与 png_size 对应（管道内存帧版）。"""
    _h = _ppm_parse_header(data)
    if not _h:
        return None
    _w, _h2, _ = _h
    return (_w, _h2) if (_w and _h2) else None


def split_ppm_frames(data, n):
    """把**拼接**的 PPM(P6) 字节流按序拆成 n 个独立帧（image2pipe 多 -map 单管道输出）。

    返回 list[bytes]，长度 ≤ n（不足按实际；某帧越界/坏头即停）。顺序与 -map 顺序一致
    （已实测：单输出 + 多 -map + 一个 pipe:1，ffmpeg 按 -map 顺序写出）。
    用于「节点窗预览」的批量取帧：一趟解码、N 帧全在内存、零落盘。
    """
    _out = []
    _i = 0
    _L = len(data)
    while len(_out) < n and _i < _L:
        if data[_i:_i + 2] != b"P6":
            _j = data.find(b"P6", _i + 1)
            if _j == -1:
                break
            _i = _j
            continue
        _hdr = _ppm_parse_header(data[_i:])
        if not _hdr:
            break
        _w, _h, _start = _hdr
        _size = _w * _h * 3
        if _start + _size > _L - _i:
            break
        _out.append(data[_i:_i + _start + _size])
        _i = _i + _start + _size
    return _out


# ==================== -print_graphs 图分析（2026-09-28）====================
# ffmpeg 自带 `-print_graphs`（7.x+）能把**已初始化**的滤镜图导成 JSON：每个滤镜实例、
# 每条边的真实 pix_fmt / 宽高 / 声道 / 采样率 / 上下游。本项目据此拿到纯字符串解析
# **猜不到**的信息 —— 「这一节点此刻到底是什么格式、多大、能不能挂 alpha 滤镜」。
#
# ★ 标签 → JSON 边 的映射关系（tests/_verify_print_graphs_map.py 37/37 实证，
#   改这里前必须先跑那个探针）：
#   ① 图内滤镜实例按**全局顺序**编号，id 形如 `G0_Parsed_<name>_<k>`，
#      k = filter_complex 按 ';' 切段、段内再按顶层 ',' 切滤镜后的**全局实例序号**。
#      ⚠️ 不是段序号：逗号链一段含多个实例，序号跨逗号累加（已实测证伪）。
#   ② 标签 L 由「所在段的最后一个实例」的第 j 个输出 pad 产出
#      ⇒ L 的真实属性 = 该实例 filter_outputs[j]。
#   ③ ffmpeg **自动插入**的转换滤镜叫 `auto_*` / `G0_format`，**不占** Parsed_ 序号
#      ⇒ 不会挤乱对齐（异格式 overlay 实测）。
#   ④ 对齐不上（数量/名字不符、图串与 JSON 不匹配）一律返回失败，绝不猜、绝不静默错映射。
# ⚠️ 老 ffmpeg（4.x/5.x）没有 -print_graphs ⇒ 必须能力探测 + 静默回落，绝不阻塞用户。


def top_comma_split(body):
    """按顶层逗号切分，感知单引号（drawtext=text='a,b' 里的逗号不是分隔符）。

    与 graph_split 同款引号/转义规则 —— 两者合起来才能把 filter_complex 还原成
    ffmpeg 眼里的「滤镜实例序列」。
    """
    parts, buf, q, esc = [], [], False, False
    for ch in (body or ""):
        if esc:
            buf.append(ch); esc = False; continue
        if ch == "\\":
            buf.append(ch); esc = True; continue
        if ch == "'":
            q = not q; buf.append(ch); continue
        if ch == "," and not q:
            parts.append("".join(buf)); buf = []; continue
        buf.append(ch)
    parts.append("".join(buf))
    return [p for p in parts if p.strip()]


def graph_filter_instances(graph):
    """把 filter_complex 展开成 ffmpeg 的滤镜实例序列 → [(段序号, 滤镜名), ...]。

    顺序必须与 ffmpeg 建图顺序一致：`;` 分段 → 段内顶层 `,` 分滤镜。
    movie=/color= 这类**源滤镜也占一个实例序号**（实测）。
    """
    out = []
    for i, seg in enumerate(graph_split(graph)):
        _ins, body, _outs = graph_parse_chain(seg)
        for p in top_comma_split(body):
            nm = p.strip().split("=", 1)[0].strip().lstrip("-")
            if nm:
                out.append((i, nm))
    return out


def pg_filter_id(f):
    """取 filter 自身的 id —— JSON 里它**不在**顶层，只出现在 filter_inputs/outputs 中。"""
    for io in (f.get("filter_inputs") or []):
        if io.get("filter_id"):
            return io["filter_id"]
    for io in (f.get("filter_outputs") or []):
        if io.get("filter_id"):
            return io["filter_id"]
    return ""


def pg_inst_index(fid):
    """`G0_Parsed_scale_0` → 0；非用户滤镜（auto_* / G0_format / buffer / sink）→ None。"""
    if "_Parsed_" not in fid:
        return None
    try:
        return int(fid.rsplit("_", 1)[1])
    except Exception:
        return None


def pg_pick_graph(data, graph_str):
    """挑出对应的那张图：优先 description 精确匹配，否则唯一含 Parsed_ 实例的图。

    一张命令可能有多张图（-vf 与 -filter_complex 各一张），取错图等于全错。
    """
    graphs = (data or {}).get("graphs") or []
    gs = (graph_str or "").strip()
    for g in graphs:
        if ((g.get("description") or "").strip()) == gs:
            return g
    cand = [g for g in graphs
            if any(pg_inst_index(pg_filter_id(f)) is not None
                   for f in (g.get("filters") or []))]
    return cand[0] if len(cand) == 1 else None


def pg_map_labels(data, graph_str):
    """JSON + 原始图串 → (ok, {标签: 边属性})。

    边属性 = {"media","fmt","w","h","sar","ch","sr","inst","fid","dest"}；
    视频边给 fmt/w/h/sar，音频边给 ch/sr（音频边**没有** sample_fmt 字段，实测）。
    ⚠️ 任何一步对不上都返回 (False, {})：宁可让界面显示「—」，也绝不给出错位的格式。
    """
    g = pg_pick_graph(data, graph_str)
    if g is None:
        return False, {}
    insts = {}
    for f in (g.get("filters") or []):
        fid = pg_filter_id(f)
        idx = pg_inst_index(fid)
        if idx is not None:
            insts[idx] = (f.get("filter_name"), fid, f)
    mine = graph_filter_instances(graph_str)
    if not insts or len(mine) != len(insts):
        return False, {}
    for k, (_seg, name) in enumerate(mine):
        if k not in insts or insts[k][0] != name:
            return False, {}
    seg_last = {}
    for k, (seg, _nm) in enumerate(mine):
        seg_last[seg] = k          # 段 → 其最后一个实例的全局序号
    res = {}
    for i, seg in enumerate(graph_split(graph_str)):
        _ins, _body, outs = graph_parse_chain(seg)
        if not outs or i not in seg_last:
            continue
        _nm, fid, f = insts[seg_last[i]]
        edges = sorted(f.get("filter_outputs") or [],
                       key=lambda e: e.get("output_index", 0))
        for j, lab in enumerate(outs):
            if j >= len(edges):
                continue
            e = edges[j]
            res[lab] = {"media": e.get("media_type"), "fmt": e.get("format"),
                        "w": e.get("width"), "h": e.get("height"), "sar": e.get("sar"),
                        "ch": e.get("channels"), "sr": e.get("sample_rate"),
                        "inst": seg_last[i], "fid": fid, "dest": e.get("dest_filter_id")}
    return True, res


def pg_node_brief(info):
    """边属性 → 节点列表里那一格显示的短串；测不到返回 ""（调用方显示「—」）。"""
    if not info:
        return ""
    if info.get("media") == "audio":
        _ch = info.get("ch")
        _hz = ""
        if info.get("sr"):
            try:
                # 音频边的 sample_rate 是 AVRational 字符串 "1/44100"
                _hz = "%dHz" % round(1.0 / float(info["sr"]))
            except Exception:
                _hz = str(info["sr"])
        return " ".join(x for x in (((_("%s声道") % _ch) if _ch else ""), _hz) if x)
    _w, _h = info.get("w"), info.get("h")
    _sz = ("%d×%d" % (_w, _h)) if (_w and _h) else ""
    return " ".join(x for x in ((info.get("fmt") or ""), _sz) if x)


def probe_tap_graph(graph, labels):
    """给每个探测标签接一个 **split 旁路出口**，一次命令就能拿到全部节点的帧。

    返回 (新图, {原标签: 可 -map 的标签})；一个都挂不上时返回 (原图, {})。

    ⚠️ 为什么不能直接 `-map` 中间标签（2026-09-27 实测）：
        ffmpeg 对「已被下游消费」的标签直接报错
        `Output with label 'a' does not exist in any defined filter graph,
         or was already used elsewhere`
        （节点取帧旧做法因此必须先 truncate_at 截断、一次只能取一个节点）。
    做法：把定义段的输出改到临时名 → `split=2` 分出「原名（原链继续用，一字不改）」
    和「probe 出口（没人消费 → 可 -map）」。整图只多几段 split，解码仍然只有一次，
    于是 N 个节点的尺寸 / 画面可以一趟跑完（旧做法要 N 趟）。
    末段输出（无人消费）不需要 split，直接 map 原名。
    """
    segs = graph_split(graph)
    if not segs or not labels:
        return graph, {}
    _used, _ins_all, _outs_all = set(), set(), set()
    for _s in segs:
        _i, _b, _o = graph_parse_chain(_s)
        _ins_all.update(_i)
        _outs_all.update(_o)
        _used.update(_i)
        _used.update(_o)

    def _uniq(base):
        _n = 0
        while True:
            _cand = "%s%s" % (base, ("%d" % _n) if _n else "")
            if _cand not in _used:
                _used.add(_cand)
                return _cand
            _n += 1

    _rename, _extra, _map = {}, [], {}
    for _L in labels:
        if _L in _map or not _L:
            continue
        if _L not in _outs_all:
            # 图里根本没有这个输出 → 必须跳过。不能落到下面「无人消费」分支：
            # 那会凭空 map 一个不存在的标签，ffmpeg 直接报
            # "Output with label 'x' does not exist in any defined filter graph"。
            continue
        if _L not in _ins_all:          # 无人消费（通常是图的出口）→ 直接 map 原名
            _map[_L] = _L
            continue
        if _L in _rename:
            continue
        for _i, _s in enumerate(segs):
            _ins, _body, _outs = graph_parse_chain(_s)
            if len(_outs) == 1 and _outs[0] == _L:
                _t = _uniq(_L + "__psrc")
                segs[_i] = "%s%s[%s]" % ("".join("[%s]" % x for x in _ins), _body, _t)
                _p = _uniq(_L + "__probe")
                _extra.append("[%s]split=2[%s][%s]" % (_t, _L, _p))
                _map[_L] = _p
                break
    if not _map:
        return graph, {}
    return ";".join(segs + _extra), _map


# 「收尾」类末滤镜：出现在图上就当它是收尾环节（尺寸/帧率归一、字幕烧录、画布…）
_NODE_TAIL_FILTERS = ("format", "fps", "pad", "setsar", "setdar", "colorspace",
                      "subtitles", "ass", "drawtext", "scale2ref")


def node_group_of(name, last_filter, is_last=False):
    """节点 → 分组 token（两级树的第一级；纯显示层，不翻译）。

    顺序：transition(xfade) → sub(子视频预处理) → main(主视频/画布基底) → overlay(叠加)
    → tail(图末段或收尾类滤镜) → other。漏匹配落 other，绝不硬塞进错组。
    显示名经 node_group_display() 翻译，这里只出 token。
    """
    _n = (name or "").strip().lower()
    _f = (last_filter or "").strip().lower()
    # ⚠️ 分组名是**内部比较键**，一律返回英文 token（与 NODE_GROUP_ORDER 逐字比对来路由分组），
    #    翻译只在显示处做（_rebuild_tree 里经 node_group_display()）。英文界面若返回译文
    #    就永远命中不了常量 ⇒ 整组 `continue` ⇒ 节点窗一个节点都不显示
    #    （2026-10-02 实测复现，证据 tests/_repro_node_group_empty.py）。
    if "xfade" in _f:
        return "transition"
    if _n.startswith("v_temp_") or _n.startswith("v_crop_"):
        return "sub"
    if _n in ("v_main_proc", "v_main_base", "v_base", "v1") or \
            _n.startswith("v_base") or _n.startswith("vt"):
        return "main"
    if _n.startswith("v_out_") or "overlay" in _f:
        return "overlay"
    if is_last or _f in _NODE_TAIL_FILTERS:
        return "tail"
    return "other"


# ⚠️ 分组名是**内部比较键**，恒为英文 token（稳定、与界面语言无关）；显示名只经
#    node_group_display() 在显示处翻译。绝不拿中文/译文做比较键 —— 模块级调 _() 会冻在
#    「导入时的中文」上（启动后 load_language() 才装 TRANS），运行时返回译文就永远对不上
#    ⇒ 英文界面节点窗整组落空、0 个节点（repro: tests/_repro_node_group_empty.py）。
NODE_GROUP_ORDER = ("transition", "sub", "main", "overlay", "tail", "other")


def node_group_display():
    """内部 token（英文，稳定）→ 当前语言显示名。

    ⚠️ 必须是函数、在开窗时求值：multi 的 _() 依赖启动后装载的 TRANS，写成模块级常量会被
    冻在导入时的中文上（同 corner_dir_display_map() 铁律，L373）。
    """
    return {"transition": _("转场"), "sub": _("子链"), "main": _("主链"),
            "overlay": _("叠加"), "tail": _("收尾"), "other": _("其它")}


# token -> (显示名, 满载滤镜链字符串)
# 数值取自成熟开源调色配方（GitHub: 0xDarkMatter/claude-mods look-recipes.md 的命名 look 具体 filter 数值；
# 文献标注为 Rec.709 正常曝光起点，需 ±30% 微调，且部分 look 会压深肤色细节）。
# 强度 i 通过 _scale_look_chain 在「满载」与「恒等」间整体缩放（i=1 满载，i=0 调用处跳过）。
# 研究见 research/color-style-presets/README.md §16。
def _scale_look_chain(chain, i):
    """按强度 i(0..1) 把满载链整体向恒等缩放：各参数向其中性值线性插值。"""
    if i >= 1.0:
        return chain
    if i <= 0.0:
        return ""   # 强度 0 = 恒等/关闭；调用方以 if _chain: 跳过；同时规避 vignette 分支除以 i 的除零
    out = []
    for part in chain.split(','):
        if '=' not in part:
            out.append(part)
            continue
        name, opts = part.split('=', 1)
        name = name.strip()
        if name == "format":
            out.append(part)
            continue
        out.append(f"{name}={_scale_opts(name, opts, i)}")
    return ','.join(out)


def _scale_opts(name, opts, i):
    if name == "eq":
        return _scale_kv(opts, {"brightness": 0.0, "contrast": 1.0, "saturation": 1.0, "gamma": 1.0}, i)
    if name == "colorbalance":
        return _scale_kv(opts, {"rs": 0.0, "gs": 0.0, "bs": 0.0, "rm": 0.0, "gm": 0.0, "bm": 0.0,
                                "rh": 0.0, "gh": 0.0, "bh": 0.0}, i)
    if name == "vibrance":
        return _scale_kv(opts, {"intensity": 0.0, "rbal": 1.0, "gbal": 1.0, "bbal": 1.0}, i)
    if name == "colorchannelmixer":
        return _scale_kv(opts, {"rr": 1.0, "rg": 0.0, "rb": 0.0, "gr": 0.0, "gg": 1.0, "gb": 0.0,
                                "br": 0.0, "bg": 0.0, "bb": 1.0}, i)
    if name == "hue":
        return _scale_kv(opts, {"s": 1.0, "b": 0.0}, i)
    if name == "colortemperature":
        return _scale_kv(opts, {"temperature": 6500.0}, i)
    if name == "gblur":
        return _scale_kv(opts, {"sigma": 0.0}, i)
    if name == "noise":
        return _scale_kv(opts, {"alls": 0.0, "allf": None}, i)
    if name == "unsharp":
        segs = opts.split(':')
        if len(segs) == 3:
            try:
                a = float(segs[2])
                segs[2] = f"{a * i:.4f}"
            except ValueError:
                pass
        return ':'.join(segs)
    if name == "vignette":
        segs = opts.split(':')
        new = []
        for s in segs:
            if '=' in s:
                k, v = s.split('=', 1)
                try:
                    new.append(f"{k}={float(v) / i:.4f}")
                except ValueError:
                    new.append(s)
            else:
                try:
                    new.append(f"{float(s) / i:.4f}")
                except ValueError:
                    new.append(s)
        return ':'.join(new)
    if name == "curves":
        return _scale_curves(opts, i)
    return opts


def _scale_kv(opts, neutral, i):
    out = []
    for kv in opts.split(':'):
        if '=' not in kv:
            out.append(kv)
            continue
        k, v = kv.split('=', 1)
        n = neutral.get(k)
        if n is None:
            out.append(kv)
            continue
        try:
            val = float(v)
        except ValueError:
            out.append(kv)
            continue
        val = n + (val - n) * i
        out.append(f"{k}={val:.4f}")
    return ':'.join(out)


def _scale_curves(opts, i):
    out = []
    for kv in opts.split(':'):
        if '=' not in kv:
            out.append(kv)
            continue
        k, v = kv.split('=', 1)
        if v and v[0] in ("'", '"'):
            q = v[0]
            inner = v[1:-1] if len(v) > 1 and v[-1] == q else v[1:]
            v = q + _scale_curve_points(inner, i) + q
        else:
            v = _scale_curve_points(v, i)
        out.append(f"{k}={v}")
    return ':'.join(out)


def _scale_curve_points(s, i):
    out = []
    for pt in s.split():
        if '/' in pt:
            x, y = pt.split('/', 1)
            try:
                xf, yf = float(x), float(y)
                yf = xf + (yf - xf) * i
                out.append(f"{x}/{yf:.4f}")
            except ValueError:
                out.append(pt)
        else:
            out.append(pt)
    return ' '.join(out)


