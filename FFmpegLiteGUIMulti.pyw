            _chain = STYLE_PRESETS[_tok][1]
            # 与导出/预览走同一个修正（补 pl=1），否则标签上显示的参数和真跑的命令对不上
            _scaled = _preserve_colorbalance_lightness(_scale_look_chain(_chain, _i))
            # 逗号后补空格，便于 Label 自动换行；等宽字体对齐参数
