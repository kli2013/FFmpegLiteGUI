    def _fit_window(self):
        """窗口尺寸按屏幕自适应 + 居中：画面 + 控件区，保证不超出屏幕（按钮始终可见）。
        窗口宽度至少容纳整行控件（竖屏视频画面窄时不被裁掉）。矮屏/高 DPI 下自动缩小。"""
        try:
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
        except Exception:
            sw, sh = 1920, 1080
        try:
            # 必须先 update_idletasks 让布局完成，否则 reqheight 返回小值 → 窗口高度算少 → 按钮被裁
            self.win.update_idletasks()
            ctl_h = self.ctl_frame.winfo_reqheight()
            ctl_w = self.ctl_frame.winfo_reqwidth()
        except Exception:
            ctl_h = ctl_w = 0
        if ctl_h < 24:
            ctl_h = 40  # 兜底：按钮行最小高度（ttk 按钮约 28px + 边距）
        # 第二行（关键帧按钮 + 状态提示）高度/宽度也计入，否则换行后按钮被窗口下缘裁掉
        try:
            kf_h = getattr(self, "kf_row", None).winfo_reqheight() if getattr(self, "kf_row", None) else 0
            kf_w = getattr(self, "kf_row", None).winfo_reqwidth() if getattr(self, "kf_row", None) else 0
        except Exception:
            kf_h = kf_w = 0
        if kf_h < 24:
            kf_h = 28  # 兜底：关键帧按钮行最小高度
        # 第三行（标记按钮）+ 第四行（段落条 + 选择信息）也计入，否则新按钮被窗口下缘裁掉
        try:
            mark_h = self.mark_row.winfo_reqheight() if getattr(self, "mark_row", None) else 0
            mark_w = self.mark_row.winfo_reqwidth() if getattr(self, "mark_row", None) else 0
            seg_h = self.seg_row.winfo_reqheight() if getattr(self, "seg_row", None) else 0
            seg_w = self.seg_row.winfo_reqwidth() if getattr(self, "seg_row", None) else 0
            stat_h = self.status_row.winfo_reqheight() if getattr(self, "status_row", None) else 0
            stat_w = self.status_row.winfo_reqwidth() if getattr(self, "status_row", None) else 0
            close_h = self.close_row.winfo_reqheight() if getattr(self, "close_row", None) else 0
            close_w = self.close_row.winfo_reqwidth() if getattr(self, "close_row", None) else 0
        except Exception:
            mark_h = mark_w = seg_h = seg_w = stat_h = stat_w = close_h = close_w = 0
        if mark_h < 24:
            mark_h = 28
        if seg_h < 56:
            seg_h = 56  # 段落条 34 + 选择信息行 ≈ 56
        if stat_h < 20:
            stat_h = 22  # 标记状态单独一行
        if close_h < 24:
            close_h = 28  # 关闭按钮行最小高度
        # 宽度 = max(画面宽, 各行控件所需宽) + 边距 → 竖屏视频控件也完整可见
        # 音频模式画面区=波形画布（固定 180px），不再占视频画面高度
        view_h = 200 if getattr(self, "_audio_mode", False) else self._vh
        # 微调行与波形条行高度计入（2026-09-06 内核移植新增两行），否则按钮被窗口下缘裁掉
        try:
            nudge_h = self.nudge_row.winfo_reqheight() if getattr(self, "nudge_row", None) else 0
            nudge_w = self.nudge_row.winfo_reqwidth() if getattr(self, "nudge_row", None) else 0
        except Exception:
            nudge_h = nudge_w = 0
        if nudge_h < 24:
            nudge_h = 30
        if getattr(self, "_audio_mode", False):
            strip_h = 0   # 音频模式波形条隐藏（大波形已是全长），高度不计
        else:
            try:
                strip_h = self.strip_row.winfo_reqheight() if getattr(self, "strip_row", None) else 0
            except Exception:
                strip_h = 0
            if strip_h < 76:
                strip_h = 76  # 波形条画布 72 + 边距
        win_w = min(max(self._vw + 24, ctl_w + 12, kf_w + 12, mark_w + 12, seg_w + 12,
                        stat_w + 12, close_w + 12, nudge_w + 12), sw - 60)
        # 窗口宽度下限（2026-09-09）：时间轴类控件（段落条/波形条/大波形）都是 fill=X，
        # 窗口越宽 → 1px 代表的秒数越少 → 打点/拖段/点选越精细。画面尺寸不受影响
        # （_vw/_vh 由 preview_max_w/h 定，画面在加宽后的窗口内居中），故零解码开销。
        # 下限而非叠加：两个下限互斥取其一，画面↔音频切换不会累加成过宽窗口。
        _min_w = (_GLOBAL_SETTINGS["preview_audio_win_min_w"]
                  if getattr(self, "_audio_mode", False)
                  else _GLOBAL_SETTINGS["preview_win_min_w"])
        win_w = min(max(win_w, _min_w), sw - 60)
        win_h = min(view_h + ctl_h + kf_h + nudge_h + mark_h + seg_h + strip_h
                    + stat_h + close_h + 24 + 16,
                    sh - 120)
        if win_w < 260:
            win_w = 260
        if win_h < 220:
            win_h = 220
        x = max(0, (sw - win_w) // 2)
        y = max(0, (sh - win_h) // 2 - 40)  # 略偏上，避开任务栏
        with suppress(Exception):
            self.win.geometry(f"{win_w}x{win_h}+{x}+{y}")

    def _run_probe(self):
        """后台线程：ffprobe 探测时长/帧率/比例（不碰 tk 控件，线程安全）。
        结果存属性，再调度 _apply_probe_ui 在主线程更新控件。任何异常都保证
        _apply_probe_ui 被调度，使 previewer 永不卡在"探测中"（主线程也绝不被阻塞）。"""
        # 虚拟/生成源（color:/gen:）：哨兵串非磁盘文件，ffprobe 必败 → 跳过探测，直接由
        # 哨兵解析注入尺寸/帧率(30，与 _virtual_lavfi_spec 的 r=30 同构)/时长/比例。
        _virtual = _is_virtual_source(self.file)
        if _virtual:
            _vp = _parse_color_source(self.file) or _parse_gen_source(self.file)
            if _vp:
                # color: 返回 (hex8, w, h, dur)；gen: 返回 (type, w, h, dur) —— 索引同构
                self._dur = float(_vp[3])
                self._fps = 30.0
                self._aspect = float(_vp[1]) / float(_vp[2])
                self.has_video = True
                self.has_audio = False
            info = None
        else:
            info = ffprobe_json(self.ffprobe, self.file, proc_sink=self._probe_sink)
        try:
            if info and info.get("format"):
                d = info["format"].get("duration")
                if d:
                    try:
                        self._dur = float(d)
                    except (ValueError, TypeError):
                        pass
            if info:
                self.has_video = False   # 探测成功 → 以真实流为准（失败保持默认 True 兜底）
                self.has_audio = False
                for s in info.get("streams", []):
                    if s.get("codec_type") == "audio":
                        self.has_audio = True  # A/V 内核：决定是否起 ffplay/波形
                    elif s.get("codec_type") == "video" and not self.has_video:
                        # 注意不能 break：流顺序 video 在前、audio 在后，原 break
                        # 会让音频流永远扫不到（has_audio 恒 False → 不起 ffplay/波形）
                        self.has_video = True
                        w, h = s.get("width"), s.get("height")
                        if w and h:
                            self._aspect = float(w) / float(h)
                        if self._dur is None:
                            d = s.get("duration")  # 流级时长（ffprobe_json 只带 streams）
                            if d:
                                try:
                                    self._dur = float(d)
                                except (ValueError, TypeError):
                                    pass
                        afr = s.get("avg_frame_rate")
                        if afr and "/" in str(afr):
                            try:
                                a, b = str(afr).split("/", 1)
                                b = float(b) or 1.0
                                self._fps = float(a) / b
                            except (ValueError, ZeroDivisionError):
                                pass
        except Exception:
            pass
        if self._dur is None:
            # ffprobe_json 只带 streams，容器级时长（format.duration）拿不到 →
            # 单独查一次 format 段（长视频/部分 mp4 流级 duration 缺失，
            # 否则时间轴会停留在默认 100 秒=1:40 的 bug）
            try:
                _cmd = [self.ffprobe, "-v", "error", "-show_entries",
                        "format=duration", "-of", "json", self.file]
                _flags = _ffmpeg_spawn_flags()
                _res = subprocess.run(_cmd, capture_output=True, text=True,
                                      encoding="utf-8", errors="replace",
                                      creationflags=_flags, timeout=10)
                if _res.returncode == 0:
                    _d = json.loads(_res.stdout).get("format", {}).get("duration")
                    if _d:
                        self._dur = float(_d)
            except Exception:
                pass
        # 管道合成模式覆盖（2026-09-20）：串行合并的主文件=第一段 → 探测到的时长/音轨与
        # 合成图口径不符。pipe_duration（=总时长）优先作时间轴长度；给了合成音频图 ⇒
        # has_audio 恒真（首段无音轨但后续段有时也要起 ffplay 播合成音频）。
        # 🔴 进度条口径（串行合并 out_mode，2026-10-13 定案）：时间轴 = **成片时间轴**，
        #    `_dur` = pipe_duration（成片总长）⇒ 打开时光标/数字**故意从 0 开始**。
        #    为什么不能改素材轴（含「单段两轴只差常量 S0」这种看似等价的场景）：
        #      · 多段拼接后成品必须 0 基 —— 第 2 段之后的画面不在首段的素材轴上，混用必错；
        #      · 单段虽两轴等价（成片 T ↔ 素材 S0+T），但**声音不同轴**：`_pipe_audio_graph`
        #        是 0 基成片轴，`_a_start` 把位置读数直接当 `atrim=start=` ⇒ 相差 S0 ⇒
        #        落错段落 + 到 EOF 反复重启（用户实测「声音炸、一会有一会没」）。
        #    2026-10-13 的「素材轴呈现」A 案已于同日**整体回退**，勿再引入。
        #    研究依据 + 物证（9850.592−4454.533416=5396.058584）：research/seek-model/README.md §4.1。
        try:
            if self._pipe_dur and float(self._pipe_dur) > 0:
                self._dur = float(self._pipe_dur)
        except (TypeError, ValueError):
            pass
        if self._pipe_audio_graph:
            self.has_audio = True
        if self._fps <= 0 or self._fps > 240:
            self._fps = 25.0
        if self._aspect <= 0:
            self._aspect = 16.0 / 9.0
        # 管道合成模式：合成图画面比可能与源文件不同（pad 画布 / split 网格）→ 调用方给的值优先，
        # 用于画面框计算（合成图由 _launch_video_pipe 的 pad 兜住实际尺寸，恒定输出 WxH）。
        try:
            if self._pipe_aspect and float(self._pipe_aspect) > 0:
                self._aspect = float(self._pipe_aspect)
        except (TypeError, ValueError):
            pass
        # 调度主线程更新控件（tk 非线程安全，所有控件操作必须回主线程）
        try:
            self.root.after(0, self._apply_probe_ui)
        except Exception:
            # root 已销毁等极端情况：直接标记完成，避免 worker 永久阻塞
            self._probe_done.set()

    @staticmethod
    def _parse_sec(v):
        """把回溯时间解析为秒：None/空 → None；数字 → float；
        字符串走模块级 time_to_seconds（HH:MM:SS / MM:SS / 纯数字，
        兼容 seconds_to_time 短格式 MM:SS.ms）。"""
        if v is None:
            return None
        if isinstance(v, (int, float)):
            return float(v)
        return time_to_seconds(str(v))

    def _normalize_marks(self, pairs):
        """[(s,e),...]（可含 str/None）→ 有效闭合段 [[s,e],...]：
        容错解析 + clamp 到 [0, dur] + 塌缩段跳过。注入与导入共用。"""
        return self._normalize_marks_rows(pairs, None)[0]

    def _normalize_marks_rows(self, pairs, rows):
        """同 _normalize_marks，但返回 (marks, row_out)：row_out 与 marks 一一对应，
        元素 = 该段来源行号（rows 缺省/越界 → None）。

        ⚠️ 过滤会丢段（无效/塌缩），故行号必须与 marks **同步产出**，不能事后按下标配对
        （否则一丢段就整段错位）——用原输入下标 k 取 rows[k] 保证对齐。"""
        dur = self._dur or 0.0
        out, out_rows = [], []
        for k, (s_raw, e_raw) in enumerate(pairs):
            s = self._parse_sec(s_raw)
            e = self._parse_sec(e_raw)
            if s is None or e is None or e <= s:
                continue  # 只认有效闭合段（同「发送」逻辑）
            if dur > 0:
                s = max(0.0, min(s, dur))
                e = max(s, min(e, dur))
            if e <= s:
                continue  # clamp 后塌缩（整段超出视频时长）无意义，跳过
            out.append([s, e])
            out_rows.append(rows[k] if (rows is not None and k < len(rows)) else None)
        return out, out_rows

    def _inject_initial_marks(self):
        """探测完成后把调用方回溯的时间重建为标记段（只执行一次）：
        容错解析、只取有效闭合段、clamp 到 [0, dur]；注入后直接可
        「复制时间」粘到别处（如无简易预览的音频窗口）。"""
        if self._initial_injected or not self._initial_marks:
            self._initial_injected = True
            return
        self._initial_injected = True
        marks, rows = self._normalize_marks_rows(self._initial_marks, self._initial_mark_rows)
        if not marks:
            return
        self._marks = marks
        self._mark_rows = rows
        with suppress(Exception):
            self.mark_status.config(
                text=_('已回溯 {0} 段（来源当前窗口已有时间），可直接复制；清除全部后重新标记').format(len(marks)))
        self._update_mark_buttons()
        self._draw_segments()

    def _apply_probe_ui(self):
        """主线程：根据探测到的比例计算画面尺寸、更新进度条与窗口布局。
        末尾（finally）置 _probe_done，唤醒等待中的 worker。"""
        try:
            if not self.win.winfo_exists():
                return
            # 画面尺寸上限 = 更多设置值（填多少就是多少，与弹窗显示一一对应）；
            # 窗口不超屏由 _fit_window 兜底（min(sw-60) 等），这里不再二次减余量
            # （旧逻辑 min(设置值, sw-100) 导致"填 700 实际 600"的数值不一致，2026-08-28 修复）。
            max_w = _GLOBAL_SETTINGS["preview_max_w"]
            max_h = _GLOBAL_SETTINGS["preview_max_h"]
            if self._aspect >= 1:
                self._vw = int(min(max_w, max_h * self._aspect))
                self._vh = int(self._vw / self._aspect)
            else:
                self._vh = int(min(max_h, max_w / self._aspect))
                self._vw = int(self._vh * self._aspect)
            self._vw = max(64, self._vw)
            self._vh = max(64, self._vh)
            self._frame_bytes = self._vw * self._vh * 3
            if self._dur:
                self.scale.config(to=self._dur)
            self._fit_window()
            # A/V 内核启动（2026-09-06）：主线程轮询（仲裁/UI）+ 取帧节奏 + 波形后台生成
            self._v_pos = 0.0
            self._a_pos = 0.0
            self._current_us = 0
            # 管道合成模式：从调用方指定起点开播（等价旧路径把截取起点交给播放器 --start）。
            # 必须在首次自动开播（_poll_av 读 _current_us）之前落值。clamp 到 [0, dur]。
            if self._pipe_start:
                try:
                    _ps = float(self._pipe_start)
                    if self._dur:
                        _ps = max(0.0, min(_ps, float(self._dur)))
                    self._current_us = int(_ps * 1e6)
                except (TypeError, ValueError):
                    pass
            # #5（2026-10-08）：列表轨迹面板「重开本管道」→ 回到用户原来那个素材时刻。
            # 放在 _pipe_start 之后 = 优先级更高（pipe_start 是窗口起点语义，不能拿来当 seek 目标）。
            if self._initial_time is not None:
                try:
                    _it = float(self._initial_time)
                    if self._dur:
                        _it = max(0.0, min(_it, float(self._dur)))
                    self._current_us = int(max(0.0, _it) * 1e6)
                except (TypeError, ValueError):
                    pass
            if self._poll_job is None:
                self._poll_job = self.win.after(_AV_POLL_MS, self._poll)
            if self._pump_job is None:
                self._pump_job = self.win.after(_AV_PUMP_MS, self._pump)
            if self.has_audio:
                self._wave_token += 1
                threading.Thread(target=self._gen_wave,
                                 args=(self._wave_token,), daemon=True).start()
            # 回溯调用方已有时间 → 标记段（探测完成、dur 已知后注入）
            self._inject_initial_marks()
            # 段落条初绘（窗口未映射时 winfo_width 可能为 1，故 deiconify 后再补一次）
            self._draw_segments()
            # 探测完成、尺寸算好、窗口已居中 → 显示窗口（之前 withdraw 隐藏，
            # 避免黑窗闪一下）。方向B加固：lift + 抢焦点（不置顶，置顶会挡 ToolTip，
            # 见 _build_ui 注释），避免模态父窗仍持 grab 时点击被吞（表现为"卡死"）。
            try:
                self.win.deiconify()
                self.win.lift()
                self.win.focus_force()
            except Exception:
                pass
            with suppress(Exception):
                self.win.after(60, self._draw_segments)  # 窗口映射后宽度正确，重绘段落条
            # 音频形态入口（音频分段效果「时间预览」start_mode="audio"）：
            # 探测完成后直接进入音频引擎（ffplay 直读+波形），跳过视频画面
            if not self._audio_mode and (self._start_mode == "audio" or not self.has_video):
                with suppress(Exception):
                    self.win.after(80, self._enter_audio_mode)
            # 纯音频文件（无视频流，如外部背景音乐 BGM）：画面模式无意义，禁用「画面模式」
            # 切换按钮，避免用户切到视频引擎后因无视频流报错/空白（BGM 时间预览入口即此场景）。
            if not self.has_video:
                with suppress(Exception):
                    self.mode_btn.config(state=tk.DISABLED)
        except Exception:
            pass
        finally:
            self._probe_done.set()

    # ---------- 控制（2026-09-06 内核移植自 tests/_audit_av_sync_player.py） ----------
    def toggle_play(self):
        if self._audio_mode:
            self._audio_toggle_play()
            return
        if self._playing:
            self.pause()
        else:
            self.play()

    def play(self):
        if self._at_eof:
            self.request_seek(0.0, play=True)
        else:
            self.request_seek(self._v_pos, play=True)

    def pause(self):
        """暂停=kill ffmpeg+ffplay（画面保留在 canvas、时间固定）。管道缓冲写满会
        死锁，绝不"停读管道挂起"；恢复=从当前位置重新双 -ss seek（与步进同路径）。"""
        self._a_pending = None
        self._playing = False
        self.btn_play.config(text=_("播放"))
        self._v_stop_proc()
        self._a_kill()
        self._loop_active = False  # 暂停即退出循环预览
        with suppress(Exception):
            self.mark_status.config(text=_("已退出循环预览"))

    def request_step(self, d):
        self._loop_active = False  # 步进=手动定位，退出循环预览
        with suppress(Exception):
            self.mark_status.config(text=_("已退出循环预览"))
        if self._audio_mode:
            # 音频引擎无帧步进 → 语义切换为 ±0.05s 微调（按钮文案已随模式改）
            self._audio_nudge(0.05 if d > 0 else -0.05)
            return
        t = self._v_pos + d / max(self._fps, 1.0)
        if self._dur:
            t = max(0.0, min(t, self._dur))
        self.request_seek(t, play=False, one=True)
        if self.step_with_audio and self.has_audio and self.audio_enabled:
            self.win.after(30, lambda: self._a_start(t + self.latency))

    def _nudge(self, dt):
        """微调按钮（±0.5/±0.1/±0.05）：保持播放/暂停态的精确 seek。
        位置真源=帧网格（25fps 帧距 40ms）：单次微调的显示增量必被取整到帧
        （0.04/0.08 交替属正常物理现象，Shotcut 的帧步进同理）。本方法用
        _nudge_accum 记「未取整目标」→ 连点累计零漂移：20 次 +0.05 恰为 +1.00±1帧。"""
        self._loop_active = False  # 手动定位，退出循环预览
        if self._audio_mode:
            self._audio_nudge(dt)
            return
        base = self._nudge_accum if self._nudge_accum is not None else self._current_us / 1e6
        t = base + dt
        if self._dur:
            t = min(t, max(0.0, self._dur - 0.5))
        t = max(0.0, t)
        self._nudge_accum = t
        self.request_seek(t, play=self._playing, keep_accum=True)

    def _on_scale(self, val):
        # 程序自己 scale.set（播放跟随）会触发 command → 必须抑制，否则自我 seek 死循环
        if self._updating_scale:
            return
        _atrace("on_scale val=%s seek_after=%s" % (val, self._seek_after))
        if self._seek_after:
            with suppress(Exception):
                self.win.after_cancel(self._seek_after)
        self._seek_after = self.win.after(250, lambda: self._do_seek(val))

    def _do_seek(self, sec):
        self._seek_after = None
        try:
            sec = float(sec)
        except (ValueError, TypeError):
            return
        _atrace("do_seek sec=%.2f mode=%s" % (sec, self._audio_mode))
        self._request_seek(max(0.0, sec))

    def _request_seek(self, sec, read_one=False):
        """SimplePreviewer 统一 seek 入口（标记/段落条/关键帧/滑块全走这里）。
        read_one=True=暂停态只读一帧（跳关键帧/点彩色条定位）；否则保持播放态重启。
        音频模式分派到 ffplay 重启式 seek（160ms 去抖）。"""
        if self._audio_mode:
            _atrace("request_seek(sec=%.2f read_one=%s) -> audio" % (sec, read_one))
            self._audio_request_seek(sec, read_one=read_one)
            return
        # 非循环内部 seek（用户手动拖/步进/跳段/选其它段）→ 退出循环预览
        if not self._loop_seek_pending:
            self._loop_active = False
        self.request_seek(sec, play=not read_one)

    def request_seek(self, t, play=None, one=False, keep_accum=False):
        """A/V 内核 seek：画面 kill+双 -ss 重启（锚点对齐真实帧 pts），音频待画面
        首帧到位后启动（+延迟补偿）。位置真源=画面帧号/fps。
        keep_accum=True：微调连点专用，不重置 _nudge_accum（其余任何 seek 都重置）。"""
        if self._stop:
            return
        if not keep_accum:
            self._nudge_accum = None
        if self._audio_mode:
            # 兜底分派（正常路径 _request_seek 已分派）：音频模式绝不重启 ffmpeg
            self._audio_request_seek(t, read_one=(play is False))
            return
        if self._dur:
            _max = max(0.0, self._dur - max(0.5, 2.0 / max(self._fps, 1.0)))
            t = max(0.0, min(t, _max))
        else:
            t = max(0.0, t)
        t = self._grid(t)      # 锚点=双 -ss 真实首帧 pts（逐帧步进零累积误差）
        if play is None:
            play = self._playing or not one
        if not play:
            one = True          # 暂停态永远只读一帧（否则缓冲会偷偷把画面往前推）
        self._at_eof = False
        self._v_pos = t
        self._a_pos = t
        self._current_us = int(t * 1e6)
        self._v_shown_idx = -1
        self._v_wall0 = None
        self._v_eof = False
        self._a_dead = False
        self._a_pending = None
        self._soft_since = None
        self._v_stop_proc()
        self._a_kill()
        if self.has_video:
            self._v_one = one
            self._v_target = t
        else:
            self._v_anchor = t
            self._v_wall0 = time.perf_counter()
        self._playing = bool(play)
        self.btn_play.config(text=_("暂停") if self._playing else _("播放"))
        if self._playing and self.has_audio and self.audio_enabled:
            if one:
                self._a_pos = t   # 暂停态定位：只挪读数、不出声
            elif self.has_video:
                self._a_pending = t   # 等画面首帧到位再起 ffplay（_pump 里启动）
            else:
                self._a_start(t + self.latency)

    def _grid(self, t):
        """把 seek 目标对齐到 ffmpeg 双 -ss 真正会输出的首帧 pts。
        实测（2026-09-06，9 个采样点）：双 -ss 首帧=第一个 pts>=t 的帧=ceil(t*fps)，
        非网格时刻会前进 1 帧（25fps 下 ≤40ms）。锚点若仍记成 t，逐帧步进会累积
        误差。用 round 而非 math.ceil：37.52*25=938.0000000000001，ceil 会错进一帧。"""
        if not self._fps:
            return t
        n = int(round(t * self._fps))
        if n / self._fps < t - 1e-9:
            n += 1
        return n / self._fps

    # ---------- 关键帧跳转（ffprobe 预扫描，2026-08-26） ----------
    def _scan_keyframes(self):
        """后台线程：ffprobe 预扫描关键帧 pts_time。
        快速模式（2026-09-06 用户反馈 4K/1h 文件太慢）：-show_packets 只解封装
        不解码，从容器包标志位（'K'）读关键帧——比旧 -skip_frame nokey（仍要
        逐帧解码 bitstream）快约两个数量级，1h 视频通常数秒内完成。
        结果去重排序存 self._keyframes；成功/失败都置 _kf_scan_done（主线程轮询
        据此启用按钮或提示失败）。全 I 帧/录屏（列表超 5000）或失败 → 不启用按钮，
        由 _poll_keyframes_ready 提示，用上一帧/下一帧逐帧兜底。"""
        try:
            # packet 级扫描：只读包头（demuxer 层），完全不解码视频帧
            cmd = [self.ffprobe, "-v", "error", "-select_streams", "v:0",
                   "-show_entries", "packet=pts_time,flags", "-of", "csv=p=0",
                   self.file]
            flags = _ffmpeg_spawn_flags()
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    creationflags=flags)
            self._kf_proc = proc   # 存句柄：close() 在扫描完成前也能杀掉
            # 审计 M4：communicate(timeout) 才真正受超时约束；read() 会一直阻塞到 EOF，
            # 后面的 wait(timeout) 形同虚设。超时则杀进程再收尾。
            try:
                out, _unused = proc.communicate(timeout=30)
            except subprocess.TimeoutExpired:
                proc.kill()
                out, _unused = proc.communicate()
            if proc.returncode != 0:
                return
            kfs = []
            for line in out.decode("utf-8", "replace").splitlines():
                # csv=p=0 输出形如 "12.000000,K__"（pts_time,flags；无 pts 的包首字段为空）
                parts = line.strip().split(",")
                if len(parts) < 2 or "K" not in parts[1]:
                    continue
                try:
                    kfs.append(float(parts[0]))
                except ValueError:
                    continue
            kfs = sorted(set(kfs))  # VFR 重复 pts 去重 + 升序（bisect 前提）
            if not kfs or len(kfs) > 5000:
                return  # 空 / 关键帧过密（全 I 帧录屏）→ 不启用按钮
            self._keyframes = kfs  # 只写普通属性；按钮启用由主线程 _poll_keyframes_ready 完成
        except Exception:
            pass
        finally:
            self._kf_proc = None
            self._kf_scan_done = True  # 无论成败都通知主线程轮询（成功/失败提示）

    def _poll_keyframes_ready(self):
        """主线程轮询（200ms）：扫描线程只写 self._keyframes/_kf_scan_done（普通 Python
        属性），这里负责启用「上一关键帧/下一关键帧」或提示解析失败——后台线程绝不碰
        tkinter（win.after 跨线程注册实测不触发，见 2026-08-26 冒烟测试）。"""
        try:
            if not self._kf_scan_done:
                if not self._stop:
                    self.win.after(200, self._poll_keyframes_ready)
                return
            if self._keyframes and not self._kf_buttons_enabled:
                self._kf_buttons_enabled = True
                self._enable_kf_buttons()
            elif not self._keyframes:
                # 扫描结束但无可用关键帧表 → 提示失败（RMVB/特殊封装/全 I 帧录屏等）
                self.status_label.config(
                    text=_("关键帧解析失败（RMVB/特殊格式可能不支持，或关键帧过密），"
                         "可用「上一帧/下一帧」逐帧定位"))
        except Exception:
            pass

    def _enable_kf_buttons(self):
        with suppress(Exception):
            if self._keyframes and not getattr(self, "_audio_mode", False):
                self.kf_prev_btn.config(state=tk.NORMAL)
                self.kf_next_btn.config(state=tk.NORMAL)
                self.status_label.config(
                    text=_('✓ 已扫描 {0} 个关键帧，可用「上一关键帧/下一关键帧」跳转').format(len(self._keyframes)))
                self._track_dirty = True   # 波形条关键帧刻度补画（内核波形条）
                self._draw_track()

    def _goto_prev_keyframe(self):
        self._goto_keyframe(-1)

    def _goto_next_keyframe(self):
        self._goto_keyframe(1)

    def _goto_keyframe(self, direction):
        """按预扫描的关键帧数组跳转（毫秒级）：direction -1=上一个、+1=下一个。
        容差 EPS=0.05s：当前帧正好压在关键帧上（±EPS 内）时跳到相邻帧，避免原地
        踏步；VFR 下 CFR 推算时间（_current_us=anchor+帧序号/fps）与 pts_time 有
        漂移，0.01 偏紧故取 0.05（关键帧间隔通常 ≥0.5s，不会误跳帧）。"""
        if not self._keyframes:
            return
        import bisect
        kfs = self._keyframes
        t = self._current_us / 1e6
        EPS = 0.05
        if direction < 0:
            idx = bisect.bisect_left(kfs, t - EPS) - 1
            if idx < 0:
                self.status_label.config(text=_("已在第一个关键帧"))
                return
        else:
            idx = bisect.bisect_right(kfs, t + EPS)
            if idx >= len(kfs):
                self.status_label.config(text=_("已在最后一个关键帧"))
                return
        kf = kfs[idx]
        self.status_label.config(text=_('已跳转到关键帧 {0}').format(_format_preview_time(kf)))
        # 暂停态跳关键帧：只读该帧显示并保持暂停（read_one=True），不自动播放——
        # 否则连续「上一关键帧/下一关键帧」会被播放打断，无法顺利逐关键帧核对。
        was_playing = self._playing
        self._request_seek(kf, read_one=not was_playing)
        if not was_playing:
            # _request_seek 内部会置 _playing=True（拖动 seek 语义），这里恢复暂停态
            self._playing = False
            with suppress(Exception):
                self.btn_play.config(text=_("播放"))

    # ---------- 标记 / 段落条 / 循环预览（2026-08-28） ----------
    def _mark_toggle(self):
        """交替标记：首次按=记起点；再次按=闭合终点成段（video_cut.lua 同款语义）。
        终点早于起点时提示并要求重标，避免误标整段反向。"""
        t = self._current_us / 1e6
        if self._open_start is None:
            self._open_start = t
            self.mark_status.config(text=_('已标起点 {0}，再按「标记」记终点').format(_format_preview_time(t)))
            return
        e = t
        if e <= self._open_start:
            self.mark_status.config(
                text=_('终点 {0} 须晚于起点 {1}，请移到后面再按「标记」或「撤销标记」').format(_format_preview_time(e), _format_preview_time(self._open_start)))
            return
        self._marks.append([self._open_start, e])
        self._mark_rows.append(None)   # 现场新标记：无来源行
        self._open_start = None
        self._update_mark_buttons()
        self._draw_segments()
        self.mark_status.config(
            text=_('✓ 已标第 {0} 段：{1} → {2}').format(len(self._marks), _format_preview_time(self._marks[-1][0]), _format_preview_time(self._marks[-1][1])))

    def _undo_mark(self):
        if self._open_start is not None:
            self._open_start = None
            self.mark_status.config(text=_("已撤销未闭合的起点"))
        elif self._marks:
            self._marks.pop()
            if self._mark_rows:
                self._mark_rows.pop()
            if self._selected_seg is not None and self._selected_seg >= len(self._marks):
                self._selected_seg = None
            self.mark_status.config(text=_("已撤销最后一段"))
        else:
            return
        self._update_mark_buttons()
        self._draw_segments()

    def _clear_marks(self):
        self._marks = []
        self._mark_rows = []
        self._open_start = None
        self._selected_seg = None
        self._loop_active = False
        self._update_mark_buttons()
        self._draw_segments()
        self.mark_status.config(text=_("已清除全部标记"))

    def _clear_current_mark(self):
        """只清除当前选中段（_selected_seg 指向的那一段），其余段不动。"""
        if self._selected_seg is None or not self._marks or self._selected_seg >= len(self._marks):
            self.mark_status.config(text=_("请先在下方段落条上点某个段的起点三角，选中要清除的标记段"))
            return
        idx = self._selected_seg
        s, e = self._marks.pop(idx)
        if idx < len(self._mark_rows):
            self._mark_rows.pop(idx)
        self._selected_seg = None
        self._loop_active = False
        self._update_mark_buttons()
        self._draw_segments()
        self.mark_status.config(text=_('已清除第 {0} 段（{1} → {2}），其余段不动').format(idx + 1, _format_preview_time(s), _format_preview_time(e)))

    def _update_mark_buttons(self):
        """按标记状态启用/禁用按钮。"""
        has = bool(self._marks) or self._open_start is not None
        st = tk.NORMAL if has else tk.DISABLED
        try:
            self.mark_undo_btn.config(state=st)
            self.mark_clear_btn.config(state=st)
            self.mark_prev_btn.config(state=st)
            self.mark_next_btn.config(state=st)
        except Exception:
            pass
        for _btn_name in ("send_marks_btn", "send_wp_btn", "send_tw_btn", "send_ch_btn"):
            _btn = getattr(self, _btn_name, None)
            if _btn is not None:
                with suppress(Exception):
                    _btn.config(state=tk.NORMAL if self._marks else tk.DISABLED)
        # 内部/外部播放按钮：按是否选中段启用（外部按钮所有入口都创建，app 已透传）
        en = tk.NORMAL if (self._selected_seg is not None and self._marks) else tk.DISABLED
        try:
            self.inner_play_btn.config(state=en)
            self.ext_play_btn.config(state=en)
            self.mark_cur_clear_btn.config(state=en)
        except Exception:
            pass
        # 坐标按钮：仅「选中段」且「该段有来源行」（来自列表轨迹）时可用
        _cb = getattr(self, "coord_btn", None)
        if _cb is not None:
            _sid = self._selected_seg
            _has_row = (_sid is not None and 0 <= _sid < len(self._mark_rows)
                        and self._mark_rows[_sid] is not None)
            with suppress(Exception):
                _cb.config(state=tk.NORMAL if _has_row else tk.DISABLED)
        # 波形条上的标记段同步（内核波形条与段落条共用 _marks）
        self._track_dirty = True
        with suppress(Exception):
            self._draw_track()

    def _goto_mark(self, direction):
        """跳到当前时间前后最近的标记点（起点+终点合并排序，精确值无需容差）。"""
        pts = []
        for s, e in self._marks:
            pts.append(s)
            pts.append(e)
        if self._open_start is not None:
            pts.append(self._open_start)
        if not pts:
            return
        import bisect
        pts = sorted(set(pts))
        t = self._current_us / 1e6
        if direction < 0:
            idx = bisect.bisect_left(pts, t) - 1
            if idx < 0:
                self.mark_status.config(text=_("已在第一个标记点"))
                return
        else:
            idx = bisect.bisect_right(pts, t)
            if idx >= len(pts):
                self.mark_status.config(text=_("已在最后一个标记点"))
                return
        p = pts[idx]
        self.mark_status.config(text=_('已跳转到标记点 {0}').format(_format_preview_time(p)))
        self._seek_no_autoplay(p)  # 手动跳转：保持播放/暂停态，不强行自动播放（同关键帧跳转）

    def _seek_no_autoplay(self, sec):
        """跳转定位（同「上一/下一关键帧」语义）：保持当前播放/暂停态，不强行自动播放。
        用于上一/下一标记跳转——与滑块拖动 seek（会播放）区分开。"""
        was_playing = self._playing
        self._request_seek(sec, read_one=not was_playing)
        if not was_playing:
            # _request_seek 内部会置 _playing=True（拖动 seek 语义），这里恢复暂停态
            self._playing = False
            with suppress(Exception):
                self.btn_play.config(text=_("播放"))

    def _seek_pause(self, sec):
        """彩色条点击定位：无论当前是否在播放，一律定位到该帧并保持暂停
        （主流播放器点时间轴即暂停核对画面的语义，与滑块拖动 seek 区分）。"""
        _atrace("seg_click _seek_pause t=%.2f mode=%s playing=%s" % (
            sec, self._audio_mode, self._playing))
        self._request_seek(sec, read_one=True)
        if self._audio_mode:
            # 音频引擎：真暂停=杀 ffplay（read_one 已把 _a_pos 钉在 t；
            # kill 后读数不再被旧进程状态行覆盖）。
            self._a_kill()
        self._playing = False
        with suppress(Exception):
            self.btn_play.config(text=_("播放"))

    def _blend_colors(self, hexes):
        """薄包装：复用模块级 _blend_colors（混色逻辑统一真源）。"""
        return _blend_colors(hexes)

    def _draw_segments(self):
        """重绘颜色段落条：横轴=真实视频时长。
        - 重叠区按各段调色板色做 RGB 均值混色（看出下层段）；
        - 每段起点画小三角标记（可点击切换选中）；
        - 选中段描红边；未闭合起点画竖线；当前播放位置画竖指示线+小三角（播放头）。
        无标记时画空底提示。"""
        try:
            cv = self.seg_cv
            cv.delete("all")
            w = cv.winfo_width() or 600
            h = cv.winfo_height() or 34
            cv.create_rectangle(0, 0, w, h, fill="#fafafa", outline="#cccccc")
            self._seg_tri = []  # [(x, idx), ...] 三角标记命中检测
            if not self._dur or self._dur <= 0:
                cv.create_text(w // 2, h // 2, text=_("等待视频时长解析…"), fill="#999999")
                return
            def x_of(sec):
                return max(0, min(w, int(sec / self._dur * w)))
            # ---- 混色分区：按所有边界点切片，每段区间填其覆盖段的均值色 ----
            bounds = sorted(set([s for s, e in self._marks] + [e for s, e in self._marks]))
            for k in range(len(bounds) - 1):
                a, b = bounds[k], bounds[k + 1]
                if b <= a:
                    continue
                mid = (a + b) / 2.0
                cover = [i for i, (s, e) in enumerate(self._marks) if s <= mid < e]
                if not cover:
                    continue
                color = self._blend_colors([self._mark_palette[i % len(self._mark_palette)] for i in cover])
                x0, x1 = x_of(a), x_of(b)
                cv.create_rectangle(x0, 2, max(x1, x0 + 2), h - 2, fill=color, outline="")
            # ---- 选中段描红边 ----
            if self._selected_seg is not None and 0 <= self._selected_seg < len(self._marks):
                s, e = self._marks[self._selected_seg]
                x0, x1 = x_of(s), x_of(e)
                cv.create_rectangle(x0, 2, max(x1, x0 + 2), h - 2,
                                    outline="#dd1111", width=2)
            # ---- 每段起点小三角标记（可点击切换选中）----
            for i, (s, e) in enumerate(self._marks):
                x0 = x_of(s)
                col = self._mark_palette[i % len(self._mark_palette)]
                cv.create_polygon(x0 - 5, h - 3, x0 + 5, h - 3, x0, h - 13,
                                  fill=col, outline="#333333", width=1)
                self._seg_tri.append((x0, i))
            # ---- 未闭合起点竖线 ----
            if self._open_start is not None:
                xo = x_of(self._open_start)
                cv.create_line(xo, 0, xo, h, fill="#dd1111", width=2)
            # ---- 播放头（竖指示线 + 顶部小三角）----
            self._draw_playhead(cv, w, h)
            # 标记 / 选中段的任何变化都会走重绘 → 端点输入框在这一个地方收口同步
            self._sync_mark_entries()
        except Exception:
            pass

    def _draw_playhead(self, cv, w, h):
        """在段落条画当前播放位置指示线（竖线+顶部小三角）。"""
        with suppress(Exception):
            cv.delete("playhead")
        if not self._dur or self._dur <= 0:
            self._ph_line = None
            self._ph_tri = None
            return
        x = max(0, min(w, int((self._current_us / 1e6) / self._dur * w)))
        self._ph_line = cv.create_line(x, 0, x, h, fill="#2222cc", width=2, tags="playhead")
        self._ph_tri = cv.create_polygon(x - 4, 0, x + 4, 0, x, 8,
                                         fill="#2222cc", tags="playhead")

    def _update_playhead(self):
        """播放中移动播放头（轻量：只移动现有图元，不重绘整条）。"""
        cv = self.seg_cv
        if not self._dur or self._dur <= 0:
            return
        w = cv.winfo_width() or 600
        h = cv.winfo_height() or 34
        x = max(0, min(w, int((self._current_us / 1e6) / self._dur * w)))
        if not getattr(self, "_ph_line", None):
            self._draw_playhead(cv, w, h)
            return
        try:
            cv.coords(self._ph_line, x, 0, x, h)
            cv.coords(self._ph_tri, x - 4, 0, x + 4, 0, x, 8)
        except Exception:
            self._draw_playhead(cv, w, h)

    def _on_seg_motion(self, event):
        """鼠标悬停彩色条：在指针上方画一个白色小气泡显示该处时间（轻量：先删旧的再画）。
        移出画布（<Leave>）时删除，不影响点击/选中。"""
        try:
            if self._dur is None or self._dur <= 0:
                return
            cv = self.seg_cv
            w = cv.winfo_width() or 600
            t = max(0.0, min(1.0, event.x / w)) * self._dur
            cv.delete("hover_time")
            bx = max(34, min(w - 34, event.x))
            cv.create_rectangle(bx - 30, 1, bx + 30, 13,
                                fill="#ffffff", outline="#888888", tags="hover_time")
            cv.create_text(bx, 7, text=_format_preview_time(t),
                           fill="#222222", font=("Microsoft YaHei", 8), tags="hover_time")
        except Exception:
            pass

    def _on_seg_leave(self, event):
        with suppress(Exception):
            self.seg_cv.delete("hover_time")

    def _on_seg_resize(self, event):
        """段落条画布尺寸变化 → 重绘（见 _build_ui 绑定处说明）。
        构造期 self._marks 尚未建立时 Configure 也会触发，故用 hasattr 守卫跳过。"""
        try:
            if not hasattr(self, "_marks"):
                return
            self._draw_segments()
        except Exception:
            pass

    def _on_seg_click(self, event):
        """单击段落条：与主流播放器一致——点时间轴任意位置=定位到该帧并暂停（read_one 只读一帧）；
        选中段落只靠点「段起点小三角」（±6px 命中），两者物理区域分离、互不冲突。"""
        if self._dur is None or self._dur <= 0:
            return
        w = self.seg_cv.winfo_width() or 1
        x = event.x
        # 1) 三角标记命中（优先）：点中某段起点三角=切换选中该段（再点取消）
        for tx, idx in reversed(getattr(self, "_seg_tri", [])):
            if abs(x - tx) <= 6:
                if self._selected_seg == idx:
                    self._selected_seg = None
                    self.seg_lab.config(text=_("已取消选中（可点起点三角重新选段）"))
                else:
                    self._selected_seg = idx
                    self.seg_lab.config(
                        text=_('选中第 {0} 段：{1} → {2}，长 {3}:.3fs').format(idx+1, _format_preview_time(self._marks[idx][0]), _format_preview_time(self._marks[idx][1]), self._marks[idx][1]-self._marks[idx][0])

)
                self._update_mark_buttons()
                self._draw_segments()
                return
        # 2) 色块内/空白一律=定位并暂停（主流播放器点时间轴语义）；不影响当前选中段
        t = max(0.0, min(1.0, x / w)) * self._dur
        self._seek_pause(t)
        sel_info = ""
        if self._selected_seg is not None and 0 <= self._selected_seg < len(self._marks):
            sel_info = _('（当前仍选中第 {0} 段，点起点三角可切换）').format(self._selected_seg+1)
        self.seg_lab.config(
            text=_('已定位并暂停 {0}{1}').format(_format_preview_time(t), sel_info))

    def _on_seg_double(self, event):
        """双击：点中色块=循环预览该段（重叠区取最上层，同单击选中语义）；点空白不动作。"""
        if self._dur is None or self._dur <= 0:
            return
        w = self.seg_cv.winfo_width() or 1
        t = max(0.0, min(1.0, event.x / w)) * self._dur
        hit = -1
        for i, (s, e) in enumerate(self._marks):
            if s <= t <= e:
                hit = i  # 保留最后一个（最上层）
        if hit >= 0:
            self._loop_segment(hit)

    def _loop_segment(self, idx):
        if idx < 0 or idx >= len(self._marks):
            return
        if self._loop_active and self._selected_seg == idx:
            self._loop_active = False
            self.mark_status.config(text=_("已退出循环预览"))
            self._draw_segments()
            return
        self._selected_seg = idx
        s, e = self._marks[idx]
        self._loop_active = True
        self._loop_s, self._loop_e = s, e
        self._loop_cooldown = 0.0
        self._loop_seek_pending = True
        self._request_seek(s)      # 初始 seek 走守卫，不立即被自身清掉循环
        self._loop_seek_pending = False
        self.mark_status.config(
            text=_('循环预览第 {0} 段：{1} → {2}（任意跳转/双击退出）').format(idx+1, _format_preview_time(s), _format_preview_time(e))
)
        self._draw_segments()

    def _copy_segments_clipboard(self):
        """复制所有已闭合段到剪贴板：逐行 `-ss S -to E`（秒，3 位小数）。
        该格式即分段拼接右栏解析格式，粘回即导入。"""
        if not self._marks:
            self.mark_status.config(text=_("暂无已闭合标记，无法复制"))
            return
        txt = "\n".join(f"-ss {_ffsec(s)} -to {_ffsec(e)}" for s, e in self._marks)
        try:
            write_clipboard_safe(self.win, txt)
            self.mark_status.config(
                text=_('已复制 {0} 段时间到剪贴板（粘到分段拼接右栏导入）').format(len(self._marks)))
        except Exception:
            self.mark_status.config(text=_("复制失败"))

    def _import_time_dialog(self):
        """「导入时间」弹窗：粘贴 `-ss S -to E` 逐行（「复制时间」/章节「外部时间」同款），
        解析后追加为标记段（不清空现有），用于把别处时间同步到水印/轨迹/分段等列表。"""
        win = tk.Toplevel(self.win)
        win.title(_("导入时间 - 粘贴时间命令"))
        win.transient(self.win)
        win.withdraw()
        win.resizable(False, False)
        with suppress(Exception):
            win.grab_set()
        tk.Label(win,
                 text=_("每行一条 `-ss 开始 -to 结束`（或 `-t 时长`），解析后追加为标记段：\n"
                 "如 `-ss 12.345 -to 20.000`；空行/# 注释/时间无效/结束早于开始 自动跳过。"),
                 foreground="#333333", anchor=tk.W).pack(fill=tk.X, padx=10, pady=(10, 4))
        txt = scrolledtext.ScrolledText(win, height=12, wrap=tk.NONE, font=("Consolas", 9))
        txt.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)
        bf = ttk.Frame(win)
        bf.pack(fill=tk.X, padx=10, pady=(0, 10))

        def _do():
            pairs = parse_ss_to_commands(txt.get(1.0, tk.END))
            if alert_if(not pairs, _("提示"), _("未解析到有效时间（格式：-ss 10.5 -to 20.3）"), 'info'):
                return
            marks = self._normalize_marks(pairs)
            if alert_if(not marks, _("提示"), _("解析出的时间段为空或超出视频时长，未导入"), 'info'):
                return
            self._marks.extend(marks)
            self._mark_rows.extend([None] * len(marks))   # 导入时间：无来源行
            self._update_mark_buttons()
            self._draw_segments()
            self.mark_status.config(
                text=_('已导入 {0} 段（共 {1} 段），可复制时间/发送到各列表').format(len(marks), len(self._marks)))
            win.destroy()

        ttk.Button(bf, text=_("解析并添加"), command=_do).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text=_("清空"), command=lambda: txt.delete(1.0, tk.END)).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text=_("关闭"), command=win.destroy).pack(side=tk.RIGHT, padx=2)
        center_window(win, 560, 360)
        win.deiconify()

    def _send_segments_to_list(self):
        """仅当 on_send_segments 有值时：把已闭合且 start<end 的段发给回调（追加）。"""
        if self._on_send_segments is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        n_open = 1 if self._open_start is not None else 0
        if not valid:
            self.mark_status.config(text=_("没有可发送的已闭合标记"))
            return
        self._on_send_segments(valid)
        msg = _('已发送 {0} 段到分段列表').format(len(valid))
        if n_open:
            msg += _("（忽略 1 个未闭合标记）")
        self.mark_status.config(text=msg)

    def _send_segments_to(self, callback_attr, dest_label):
        """把已闭合（start<end）的标记段发给指定回调（轨迹/文字水印/章节列表共用）。"""
        cb = getattr(self, callback_attr, None)
        if cb is None:
            return
        valid = [(s, e) for s, e in self._marks if e > s]
        if not valid:
            self.mark_status.config(text=_("没有可发送的已闭合标记"))
            return
        cb(valid)
        self.mark_status.config(text=_('已发送 {0} 段到{1}').format(len(valid), dest_label))

    def _play_segment_inner(self):
        """内部循环预览选中段：复用 _loop_segment（到段尾回跳段首，任意跳转退出）。
        替代双击入口（更直接，不依赖鼠标手势）。"""
        if self._selected_seg is None or not self._marks:
            self.mark_status.config(text=_("请先点段落条上的起点三角选中一段，再内部播放"))
            return
        self._loop_segment(self._selected_seg)

    def _play_segment_external(self):
        """外部播放器播选段：复用 app.preview_with_player（mpv↔ffplay 回退）。"""
        if self._app is None:
            self.mark_status.config(text=_("此预览入口未提供外部播放器"))
            return
        if self._selected_seg is None or not self._marks:
            self.mark_status.config(text=_("请先点段落条上的起点三角选中一段，再外部播放"))
            return
        s, e = self._marks[self._selected_seg]
        if e <= s:
            return
        try:
            self._app.preview_with_player(self.file, start_time=s, duration=e - s)
            self.mark_status.config(
                text=_('已用外部播放器播放第 {0} 段：{1} → {2}').format(self._selected_seg+1, _format_preview_time(s), _format_preview_time(e))
)
        except Exception as ex:
            self.mark_status.config(text=_('外部播放失败：{0}').format(ex))

    def _coord_for_segment(self):
        """点「坐标」：打开当前选中段来源航点行的位置编辑器（行号贯穿；见 _mark_rows）。

        仅从「列表轨迹」上下文打开本预览时才有该按钮（on_coord_request 非 None）；
        段有来源行才可用（现场新标记 / 导入的段无对应行）。"""
        idx = self._selected_seg
        if idx is None or not self._marks or idx >= len(self._marks):
            self.mark_status.config(text=_("请先点段落条上的起点三角选中一段，再点「坐标」"))
            return
        if self._on_coord_request is None:
            return
        row = self._mark_rows[idx] if idx < len(self._mark_rows) else None
        if row is None:
            self.mark_status.config(
                text=_("该段没有对应轨迹行（现场新标记 / 导入的段），无法打开位置编辑器"))
            return
        with suppress(Exception):
            # 第二参 = **本预览实例**（不是 self.win 顶层窗）：位置编辑器关掉后据它把本预览窗
            # 重新提到最前（否则会「返回」到轨迹控制窗，预览被压到下面），并且在 #5「本管道
            # 刷新」里据它取当前时刻、关旧窗、重开。面板侧对二者都用 `.win` 兜底兼容。
            self._on_coord_request(row, self)

    # ================== 音频引擎 / 波形 / 波形条 / A/V设置（2026-09-06 内核移植） ==================
    # 音频=ffplay 直读（粗 -ss 回退 + atrim 精修，落点采样级精确；ffplay 无 IPC，
    # 程序化 seek=kill+重启）。画面模式：音频从时钟、漂移仲裁自动重启；音频模式：
    # 音频时钟即真源。线程纪律：reader/波形 worker 绝不碰 Tk，只写共享属性/入队。
    def _toggle_audio_mode(self):
        if self._audio_mode:
            # 纯音频文件（无视频流，如外部背景音乐 BGM）不允许退出到画面模式：
            # 切到视频引擎会因无视频流报错/空白。mode_btn 在 _apply_probe_ui 已置灰，
            # 此处为双保险，防止任何路径误触发。
            if not self.has_video:
                return
            self._exit_audio_mode()
        else:
            self._enter_audio_mode()

    def _enter_audio_mode(self, autostart=True):
        """进入音频引擎：停视频引擎（内核 _v_target/_v_stop_proc）、画面区换大波形、
        ffplay 开播。当前时间从视频/上次的 _current_us 无缝接管。"""
        _atrace("enter_audio_mode autostart=%s cur_mode=%s" % (autostart, self._audio_mode))
        if self._audio_mode:
            return
        if not self._dur:
            self.status_label.config(text=_("时长未就绪，稍后再试"))
            return
        # 1) 停视频引擎（内核：作废在途 target/帧）
        self._v_target = None
        self._v_one = False
        self._v_stop_proc()
        self._a_pending = None
        pos = max(0.0, self._current_us / 1e6)
        self._audio_mode = True
        self._a_pos = pos
        self._a_parsed = False
        self._a_dead = False
        self._soft_since = None
        # 视图复位（上次音频模式若缩放过，本次从全长视图开始）
        self._wv_t0, self._wv_t1 = 0.0, None
        self._wv_attached = True
        # 2) UI 切换：画面 ↔ 大波形（before=ctl_frame 精确占回画面槽位）
        with suppress(Exception):
            self.canvas.pack_forget()
        with suppress(Exception):
            self.wave_cv.pack(fill=tk.BOTH, expand=True, padx=6, pady=6,
                              before=self.ctl_frame)
        try:
            # 波形条行隐藏（2026-09-06 用户反馈）：大波形已是横向全长，下方再放一条
            # 波形冗余且其播放头在音频模式不跟随（dyn 层只随画面轮询刷新）。
            self.strip_row.pack_forget()
        except Exception:
            pass
        self._nudge_accum = None   # 换引擎 → 微调基准从当前位置重新起算
        try:
            self.btn_step_prev.config(text="−0.05s")
            self.btn_step_next.config(text="+0.05s")
            self.btn_export_frame.config(state=tk.DISABLED)
            self.kf_prev_btn.config(state=tk.DISABLED)
            self.kf_next_btn.config(state=tk.DISABLED)
            self.mode_btn.config(text=_("画面模式"))
        except Exception:
            pass
        self._fit_window()
        self._wave_dirty = True
        with suppress(Exception):
            self.win.after(60, self._draw_wave)  # 窗口重排后宽度正确再绘
        if autostart:
            self._playing = True
            self.btn_play.config(text=_("暂停"))
            self._a_start(pos)
        else:
            self._playing = False
            self.btn_play.config(text=_("播放"))
        with suppress(Exception):
            self.mark_status.config(text=_("音频模式：ffplay 直读音轨（原始时间线），点/拖波形定位"))

    def _exit_audio_mode(self):
        """切回 A/V 画面引擎：停 ffplay，画面区恢复，定位到音频当前位置（暂停态取帧）。"""
        _atrace("exit_audio_mode (from playing=%s a_pos=%.2f)" % (self._playing, self._a_pos))
        self._playing = False
        self._cancel_a_seek_job()
        self._a_kill()
        self._audio_mode = False
        self._at_eof = False
        self._loop_active = False
        # 视图复位（对称：下次进入音频模式从全长视图开始）
        self._wv_t0, self._wv_t1 = 0.0, None
        self._wv_attached = True
        try:
            self.wave_cv.pack_forget()
            self.canvas.pack(fill=tk.BOTH, expand=True, padx=6, pady=6,
                             before=self.ctl_frame)
            # 波形条行恢复到原位（段落在 seg_row 与 status_row 之间）
            self.strip_row.pack(fill=tk.X, padx=6, pady=(0, 2), before=self.status_row)
        except Exception:
            pass
        self._nudge_accum = None
        try:
            self.btn_step_prev.config(text=_("上一帧"))
            self.btn_step_next.config(text=_("下一帧"))
            self.btn_export_frame.config(state=tk.NORMAL)
            self.mode_btn.config(text=_("音频模式"))
        except Exception:
            pass
        self._fit_window()
        self.btn_play.config(text=_("播放"))
        self._enable_kf_buttons()  # 关键帧表若已就绪则恢复按钮
        # 复用内核快路径：暂停态定位到音频当前位置的一帧（read_one）
        t = self._current_us / 1e6
        if self._dur and t < self._dur and self.has_video:
            self._request_seek(t, read_one=True)
        with suppress(Exception):
            self.mark_status.config(text=_("画面模式：已回到帧浏览器（定位到音频当前位置）"))

    # ---------- ffplay 播放核心（内核：粗 -ss + atrim 精修 + 状态行解析） ----------
    def _a_start(self, at):
        """启动 ffplay 直读（-nodisp -autoexit）。_a_gen+1 作废旧代 reader 事件。
        at=音频应出声的绝对源时间（A/V 模式调用方已 +latency 补偿启动延迟）。

        2026-09-20 串行合并管道预览：给了 _pipe_audio_graph 时不直读 self.file（那是第一段
        的文件，播完第一段就无声——用户实测），改播**合成音频图**：
          ffplay -f lavfi -i "<各段 amovie + concat/acrossfade/BGM 图>;[末标签]atrim=start=at,
          asetpts=PTS-STARTPTS"
        atrim 在拼接后的输出时间轴上裁（与视频 out_mode 同口径），落点精确；每帧图按需解码，
        不需要粗 seek。

        🔴 `at` **必须与视频位置读数同轴**（串行 out_mode = 成片轴，`_pipe_start` 恒 0）：
        本函数把 `at` **原样**交给 `atrim=start=`，而这张图是 0 基成片轴 —— 调用方若给了
        另一个坐标系（如 2026-10-13 试过的「素材轴呈现」A 案），音频整体错位 S0 并在 EOF 后
        反复重启（用户实测「声音炸、一会有一会没」）。改轴必须「图 + 位置读数」一起改。"""
        self._a_kill()
        # 音量以「更多设置 → 预览音量」为唯一来源（2026-09-21）：App 侧改过后也不会过期
        self.volume = max(0, min(100, int(_GLOBAL_SETTINGS.get("preview_volume", self.volume))))
        if not (self.has_audio and self.audio_enabled):
            return
        if self._dur:
            at = max(0.0, min(at, max(0.0, self._dur - 0.05)))
        _lavfi_graph = getattr(self, "_pipe_audio_graph", None)
        coarse = max(0.0, at - _AV_COARSE_BACK)   # ⚠️ 必须在分支前赋值： lavfi 分支不做粗
        # seek（图内 atrim 自带精定位），但分支汇合后的 _atrace 日志行引用 coarse——
        # 若只在此处定义，lavfi 分支走到 _atrace 必 NameError，且异常会沿调用链炸死
        # _pump 的 after 循环（画面冻结在首帧、音频被 _poll 仲裁每 0.7s 重启一次——
        # 2026-09-20 用户实测 concat 预览「画面不动+声音反复重播」的根因）。
        if _lavfi_graph:
            # 复合音频图（cmd_preview_target 自供 amovie=主文件；串行合并/多输入文本路径）
            # 没有输入级 -ss，否则 ffplay 会从 0 解码到 at（≈7-8s@1100s，用户实测「改 trim 后
            # 预览卡 7-8 秒」的根因：最终版用 amovie 复合图替代了中间版 self.file+ -ss 的「双-ss」
            # 快寻）。这里给每个 amovie= 源补源级 seek_point=coarse，等价于回退分支的 -ss coarse，
            # 复用 ffmpeg 关键帧快寻。⚠️ 只动 amovie=：核心合并预览走 movie= 且已各自带
            # seek_point（_inject_movie_seek_point_per_sub），勿重复注入。
            if coarse > 0.0 and "seek_point" not in _lavfi_graph:
                # 🔴 逐段 seek_point（2026-10-14，替代早期 blanket 注入）：
                # 旧版给「每个」amovie= 源都加同一个 coarse → concat 时间轴被压缩 N*coarse、
                # 图尾 atrim=start=at 越界变空（「只响第一声 / 第二段起静音」）。现按「单/多」分流：
                #  · 单 amovie（单文件直读）：图内无逐段 atrim ⇒ 退回原 coarse 快寻
                #    （≡ -ss coarse，深 seek 秒开，等价旧行为）。
                #  · 多 amovie（多输入/转场 concat 合成音频图）：逐段注入各源**自身段偏移**
                #    seek_point=S_k（取自该源下游 atrim=start=S_k），对齐无损、各段直接跳到段起点，
                #    既修「只响第一声」又治「一卡一卡」（不再从 0 空解 80 段）。
                #  两路都对「已含 seek_point」幂等（整段不变），无副作用。
                _n_amv = len(re.findall(r"amovie=[^,;\[\]]+", _lavfi_graph))
                if _n_amv <= 1:
                    _lavfi_graph = re.sub(
                        r"(amovie=[^,;\[\]]+)",
                        r"\1:seek_point=%.6f" % coarse, _lavfi_graph)
                else:
                    _lavfi_graph = self._inject_amovie_seek_point_per_sub(_lavfi_graph)
            cmd = [self._ffplay, "-nodisp", "-autoexit", "-vn", "-sn",
                   "-volume", str(max(0, min(100, self.volume))),
                   "-f", "lavfi", "-i",
                   "%s;%satrim=start=%s,asetpts=PTS-STARTPTS"
                   % (_lavfi_graph, getattr(self, "_pipe_audio_map", "[ao]"),
                      _ffsec(at))]
        else:
            # ffplay 的 -ss 是 demuxer 级 seek（默认流=视频），视频容器里寻址只能落在
            # 视频关键帧（实测 36.00→33.80）。修法=粗+精两段：-ss coarse 瞬间跳到目标前
            # 15s，atrim=start=at 把关键帧→目标之间解码后丢弃（音频无关键帧概念 →
            # 落点采样级精确），asetpts 归零 → 状态行时钟=距目标相对时间。
            cmd = [self._ffplay, "-nodisp", "-autoexit", "-vn", "-sn",
                   "-volume", str(max(0, min(100, self.volume))),
                   "-ss", _ffsec(coarse),
                   "-af", "atrim=start=" + _ffsec(at) + ",asetpts=PTS-STARTPTS",
                   self.file]
        flags = _ffmpeg_spawn_flags()
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.PIPE, creationflags=flags)
        except Exception as e:
            self._playing = False
            try:
                self.btn_play.config(text=_("播放"))
                self.mark_status.config(text=_('启动 ffplay 失败：{0}').format(e))
            except Exception:
                pass
            return
        self._a_proc = proc
        _register_preview_proc(proc)
        self._a_gen += 1
        self._a_anchor = at
        self._a_anchor_wall = time.perf_counter()
        self._a_spawn_wall = time.perf_counter()
        self._a_parsed = False
        self._a_pos = at
        self._a_dead = False
        self._a_last_restart = time.perf_counter()
        self._a_restarts += 1
        threading.Thread(target=self._a_reader, args=(proc, self._a_gen),
                         daemon=True).start()
        _atrace("a_START at=%.2f coarse=%.2f lat=%.2f restart#%d" % (
            at, coarse, self.latency, self._a_restarts))

    def _a_kill(self):
        """杀 ffplay 并作废当前代际（被杀进程的 eof 事件将被 _poll 丢弃）。"""
        self._cancel_a_seek_job()
        self._a_gen += 1
        p = self._a_proc
        self._a_proc = None
        if p is not None and p.poll() is None:
            with suppress(Exception):
                p.kill()
            with suppress(Exception):
                p.wait(timeout=2)

    def _a_reader(self, proc, gen):
        """读 ffplay stderr，按 \\r 刷行解析播放位置（ffplay 音频时钟=耳朵听到的）。
        线程纪律：不碰任何 Tk 控件；位置写共享变量（GIL 原子）；结束事件只入队。"""
        buf = b""
        try:
            fd = proc.stderr.fileno()
            if hasattr(os, "set_blocking"):  # 3.8 Windows 无此 API；管道本就阻塞读，跳过等价
                os.set_blocking(fd, False)
            while not self._stop:
                if gen != self._a_gen:
                    return
                try:
                    chunk = os.read(fd, 4096)
                except BlockingIOError:
                    time.sleep(0.01)
                    continue
                except OSError:
                    return
                if not chunk:
                    time.sleep(0.01)
                    if proc.poll() is not None:
                        break
                    continue
                buf += chunk
                buf = buf.replace(b"\n", b"\r")   # 横幅是 \n 行，统一按 \r 切
                parts = buf.split(b"\r")
                buf = parts[-1]
                for raw in parts[:-1]:
                    m = _AUDIO_STATUS_RE.match(raw.decode("utf-8", "replace"))
                    if m:
                        if not self._a_parsed:
                            self._a_parsed = True
                            self._nudge_accum = None  # 音频时钟已就绪 → 重新成为微调基准
                            d = time.perf_counter() - self._a_spawn_wall
                            if self.auto_latency:
                                # EMA 收敛（Popen→首条状态行 = 启动延迟实测）
                                self.latency = max(_AV_LAT_MIN, min(
                                    _AV_LAT_MAX, self.latency * 0.7 + d * 0.3))
                        self._a_pos = self._a_anchor + float(m.group(1))
        except Exception:
            pass
        self._a_events.put(("eof", gen))

    def _on_audio_toggle(self):
        """A/V设置 弹窗「启用音频」开关。"""
        self.audio_enabled = bool(self.aud_var.get())
        if self._audio_mode:
            if self.audio_enabled and self._playing:
                self._a_start(self._a_pos)
            else:
                self._a_kill()
        elif self.audio_enabled and self._playing:
            self._a_start(self._v_pos + self.latency)
        else:
            self._a_kill()

    def _on_vol_change(self):
        """A/V设置 弹窗音量改动：立即读参 + 去抖重启音频引擎。
        音量是 ffplay 启动参数（无运行中调节接口），不重启不生效——
        此前只能靠切「启用音频」带动，2026-09-06 改为改动即自动生效。"""
        self._read_params()
        if not (self._playing and self.has_audio and self.audio_enabled):
            return
        if self._vol_job is not None:
            with suppress(Exception):
                self.win.after_cancel(self._vol_job)
        try:
            self._vol_job = self.win.after(350, self._vol_apply)  # 连点/长按只生效最后一次
        except Exception:
            self._vol_job = None

    def _vol_apply(self):
        self._vol_job = None
        if self._stop or not (self._playing and self.has_audio and self.audio_enabled):
            return
        if self._audio_mode:
            self._a_start(self._a_pos)                    # 音频模式：ffplay 时钟=真源，不加延迟
        else:
            self._a_start(self._v_pos + self.latency)     # A/V 模式：保持延迟补偿

    def resync_audio(self):
        """强制重同步音频（A/V设置 弹窗按钮）。"""
        if self._audio_mode:
            if self._playing and self.has_audio:
                self._a_start(self._a_pos)
                self.status_label.config(text=_("已强制重同步音频"))
            return
        if self._playing and self.has_audio:
            self._a_start(self._v_pos + self.latency)
            self._soft_since = None
            self.status_label.config(text=_("已强制重同步音频"))

    def _audio_toggle_play(self):
        if self._playing:
            # 暂停=kill，pos 保留最后值（与视频引擎同构）
            _atrace("toggle_play -> PAUSE pos=%.2f" % self._a_pos)
            self._playing = False
            self._a_kill()
            self._loop_active = False
            with suppress(Exception):
                self.mark_status.config(text=_("已退出循环预览"))
            self.btn_play.config(text=_("播放"))
        else:
            start = 0.0 if self._at_eof else self._a_pos  # 末尾→回卷 0（短视频痛点）
            _atrace("toggle_play -> PLAY start=%.2f at_eof=%s" % (start, self._at_eof))
            self._at_eof = False
            self._playing = True
            self.btn_play.config(text=_("暂停"))
            self._a_start(start)

    def _audio_request_seek(self, sec, read_one=False, keep_accum=False):
        """音频引擎 seek：播放态=kill+重启 -ss（160ms 合并去抖，波形连点/拖动只
        执行最后一次）；read_one（暂停态定位）只更新读数不重启。
        keep_accum=True：微调连点专用，不重置 _nudge_accum。"""
        if not keep_accum:
            self._nudge_accum = None
        _atrace("a_request sec=%.2f read_one=%s playing=%s a_pos=%.2f job=%s" % (
            sec, read_one, self._playing, self._a_pos, self._a_seek_job is not None))
        if self._dur:
            sec = max(0.0, min(sec, max(0.0, self._dur - 0.05)))
        else:
            sec = max(0.0, sec)
        self._at_eof = False
        self._a_pos = sec
        self._current_us = int(sec * 1e6)
        if not self._loop_seek_pending:
            self._loop_active = False
        if read_one:
            self._cancel_a_seek_job()  # 暂停态定位：撤销挂起中的重启，不重启不出声
            return
        self._playing = True
        with suppress(Exception):
            self.btn_play.config(text=_("暂停"))
        self._a_want_t = sec
        if self._a_seek_job is None:   # 连续 seek 合并，最后一次生效
            self._a_seek_job = self.win.after(160, self._a_seek_fire)

    def _a_seek_fire(self):
        """去抖到期：真正 kill+重启 ffplay。仅播放态且仍在音频模式时执行。"""
        self._a_seek_job = None
        _atrace("a_FIRE want_t=%.2f playing=%s mode=%s" % (
            self._a_want_t, self._playing, self._audio_mode))
        if self._playing and self._audio_mode:
            self._a_start(self._a_want_t)   # 音频模式真源=ffplay 时钟，不加延迟

    def _cancel_a_seek_job(self):
        if self._a_seek_job is not None:
            with suppress(Exception):
                self.win.after_cancel(self._a_seek_job)
            self._a_seek_job = None

    def _audio_nudge(self, dt):
        """音频模式 ±微调：播放态=重启；暂停态=只挪读数。
        音频落点采样级精确，但读数来自 ffplay 时钟（约 30ms 一刷）——
        连点基准用 _nudge_accum 累计 → 每次恰为 ±dt，无读数取整带来的累计漂移。"""
        base = self._nudge_accum if self._nudge_accum is not None else self._current_us / 1e6
        t = base + dt
        if self._dur:
            t = max(0.0, min(t, self._dur))
        else:
            t = max(0.0, t)
        self._nudge_accum = t
        self._at_eof = False
        self._a_pos = t
        self._current_us = int(t * 1e6)
        if self._playing:
            self._audio_request_seek(t, keep_accum=True)
        else:
            self._cancel_a_seek_job()

    def _wave_click(self, evt):
        """大波形点击/拖动=定位并暂停（与彩色条 _seek_pause 同语义：音频模式卖点
        就是定位准，若 seek 后继续播，点的位置立刻跑掉）。缩放后按当前视图窗口
        (t0,t1) 换算，而非全长。拖动时重复触发也是安全路径：read_one 不重启引擎。"""
        if self._stop or not self._dur:
            return
        w = self.wave_cv.winfo_width()
        if w <= 1:
            return
        t0, t1 = self._wave_view()
        self._seek_pause(t0 + (evt.x / w) * (t1 - t0))

    _WV_MIN_SPAN = 0.5   # 最小视图跨度（秒）：500px 窗口下 1px≈1ms，足够细

    def _wave_view(self):
        """当前视图窗口 (t0, t1)；_wv_t1=None 表示全长。"""
        if self._wv_t1 is None or not self._dur:
            return 0.0, self._dur or 1.0
        return self._wv_t0, self._wv_t1

    def _wave_view_changed(self):
        """视图变化后的重绘入口：直接重画（含播放头视图换算）。
        同时刷新附着状态：用户缩放/平移把播放头挪出视野 → 解除跟随，
        直到播放头重新进入视野（点击视图内/播放推进到达）才恢复轻推。"""
        if not self._audio_mode or self._stop:
            return
        ph = self._current_us / 1e6
        t0, t1 = self._wave_view()
        self._wv_attached = (t0 <= ph <= t1)
        self._draw_wave()

    def _wave_zoom(self, evt):
        """滚轮缩放：以光标处时间为锚，视图跨度 ×0.8（放大）/ ÷0.8（缩小）。"""
        if self._stop or not self._dur:
            return
        w = self.wave_cv.winfo_width()
        if w <= 1:
            return
        t0, t1 = self._wave_view()
        span = t1 - t0
        f = 0.8 if evt.delta > 0 else 1.0 / 0.8
        new_span = span * f
        if new_span >= self._dur * 0.999:
            self._wave_view_reset()
            return
        new_span = max(self._WV_MIN_SPAN, new_span)
        if new_span >= self._dur:
            self._wave_view_reset()
            return
        f = new_span / span
        anchor = t0 + (evt.x / w) * span   # 光标处时间（缩放前后保持不动）
        n0 = anchor - (anchor - t0) * f
        n1 = anchor + (t1 - anchor) * f
        # 夹回 [0, dur]，保持跨度
        if n0 < 0:
            n1 -= n0
            n0 = 0.0
        if n1 > self._dur:
            n0 -= (n1 - self._dur)
            n1 = self._dur
            if n0 < 0:
                n0 = 0.0
        self._wv_t0, self._wv_t1 = n0, n1
        self._wave_view_changed()

    def _wave_pan_start(self, evt):
        self._wv_panning = True
        self._wv_pan_x = evt.x
        t0, t1 = self._wave_view()
        self._wv_pan_t0 = t0
        self._wv_pan_span = t1 - t0

    def _wave_pan_move(self, evt):
        if not self._wv_panning or self._stop or not self._dur:
            return
        w = self.wave_cv.winfo_width()
        if w <= 1:
            return
        dt = -(evt.x - self._wv_pan_x) / w * self._wv_pan_span
        n0 = self._wv_pan_t0 + dt
        n0 = max(0.0, min(n0, self._dur - self._wv_pan_span))
        self._wv_t0, self._wv_t1 = n0, n0 + self._wv_pan_span
        self._wave_view_changed()

    def _wave_pan_end(self, evt):
        self._wv_panning = False

    def _wave_view_reset(self):
        """右键/超范围缩放 → 复位全长视图。"""
        if self._wv_t1 is None:
            return
        self._wv_t0, self._wv_t1 = 0.0, None
        self._wave_view_changed()

    def _wave_view_follow(self, ph_t):
        """播放头出界轻推（Audacity 式，带附着语义）：播放头在视野内=附着，
        走出视野且处于附着态 → 视图整体跳到播放头左沿 15% 处（缩放级别不变）。
        用户缩放/平移主动把播放头挪出视野 → 解除附着，绝不强行拉回；
        播放头重新进入视野（点击视图内定位/播放推进到达）→ 恢复附着。
        返回 True=视图变了需要重画。"""
        if self._wv_t1 is None or not self._dur:
            return False
        t0, t1 = self._wv_t0, self._wv_t1
        span = t1 - t0
        if t0 <= ph_t <= t1:
            self._wv_attached = True
            return False
        if not getattr(self, "_wv_attached", False):
            return False   # 非附着态（用户在看别处）：不跟随
        n0 = max(0.0, min(ph_t - span * 0.15, self._dur - span))
        self._wv_t0, self._wv_t1 = n0, n0 + span
        return True

    def _gen_wave(self, token):
        """流式聚合成「更多设置→波形精度」个 min/max 包络桶（大波形画布与波形条共用）。
        线程纪律：只写 self._wave_peaks / 置 _wave_dirty，绝不碰 Tk（重绘全在 _poll）。"""
        path, dur = self.file, self._dur
        # 长素材解码成本 ≈ 线性于「采样率 × 时长」（纯 Python 逐样本分桶；ffmpeg 解码本身仅
        # ~1000x 实时，瓶颈在 Python 侧）。此前主波形固定用用户设定 SR，而同步波形 _sync_wave_sr
        # 早已按 2h 阈值降采样到 4000 —— 两份逻辑不一致。改为在用户设定 SR 基础上封顶总样本数
        # （_main_wave_sr，与同步波形 8000/4000 口径对齐）：短素材保持用户设定（细节不丢），
        # 长素材（如 2h）自动降到 ~4000 量级，解码耗时锁死。
        eff_sr = _main_wave_sr(dur)
        if not path or not dur:
            self._wave_done = True
            self._wave_dirty = True
            return
        _a_graph = getattr(self, "_pipe_audio_graph", None)
        if _a_graph:
            # 串行合并管道预览（2026-09-20）：self.file 是第一段的文件，直读只会画出
            # 第一段波形（用户实测「只绘制了第一段音频的波形」）。改从合成音频图解码
            # （各段 amovie + concat/acrossfade/BGM），出声来源与 _a_start 逐字一致——
            # 同样在图尾接一段**无标签**链（anull），产出单个输出 pad → 无需 -map。
            # -t 防御：万一图内混入无限源，避免 worker 永远解不完（桶越界会被钳到末桶）。
            args = [self.ff, "-v", "error", "-f", "lavfi", "-i",
                    "%s;%sanull" % (_a_graph, getattr(self, "_pipe_audio_map", "[ao]")),
                    "-t", "%.6f" % float(dur),
                    "-ac", "1", "-ar", str(eff_sr),
                    "-f", "s16le", "pipe:1"]
        else:
            args = [self.ff, "-v", "error", "-i", path, "-map", "0:a:0?",
                    # 2026-09-18：采样率改从「更多设置」读取（_GLOBAL_SETTINGS 由 _sync_global_settings 同步）
                    "-ac", "1", "-ar", str(eff_sr), "-f", "s16le", "pipe:1"]
        flags = _ffmpeg_spawn_flags()
        try:
            p = subprocess.Popen(args, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, creationflags=flags)
        except Exception:
            self._wave_done = True
            self._wave_dirty = True
            return
        peaks = [None] * _GLOBAL_SETTINGS["wave_buckets"]
        self._wave_peaks = peaks
        nb = len(peaks)
        total = 0
        spb = (dur * eff_sr) / nb   # 每桶采样数
        if spb <= 0:
            spb = 1.0
        with suppress(Exception):
            while not self._stop:
                chunk = p.stdout.read(65536)
                if not chunk:
                    break
                if token != self._wave_token:
                    return
                n = len(chunk) // 2
                if n:
                    for s in struct.unpack(f"<{n}h", chunk[:n * 2]):
                        idx = int(total / spb)
                        if idx >= nb:
                            idx = nb - 1
                        pk = peaks[idx]
                        if pk is None:
                            peaks[idx] = (s, s)
                        elif s < pk[0]:
                            peaks[idx] = (s, pk[1])
                        elif s > pk[1]:
                            peaks[idx] = (pk[0], s)
                        total += 1
                    self._wave_dirty = True
        with suppress(Exception):
            p.kill()
        if token == self._wave_token:
            self._wave_done = True
            self._wave_dirty = True

    def _on_wave_resize(self, event):
        """大波形画布尺寸变化 → 去抖 40ms 重绘（几何稳定后按新宽度重画，右侧不再空白）。"""
        if self._stop or not self._audio_mode:
            return
        if self._wave_resize_job is not None:
            with suppress(Exception):
                self.win.after_cancel(self._wave_resize_job)
        try:
            self._wave_resize_job = self.win.after(40, self._wave_resize_redraw)
        except Exception:
            self._wave_resize_job = None

    def _wave_resize_redraw(self):
        self._wave_resize_job = None
        if not self._stop and self._audio_mode and self.win.winfo_exists():
            self._draw_wave()

    def _draw_wave(self):
        """重绘大波形画布（音频模式，主线程）：min/max 包络填充多边形（连续无间隙）。
        支持视图窗口 (t0,t1)：只画可见桶段，放大后局部细节更清晰（不再出现离散竖条）。"""
        try:
            cv = self.wave_cv
            w = cv.winfo_width()
            h = cv.winfo_height()
            if w < 10 or h < 10 or not self._dur:
                return
            cv.delete("all")
            mid = h // 2
            amp = h / 2 - 8
            cv.create_line(0, mid, w, mid, fill="#e8e8e8")
            drawn = 0
            if self._wave_peaks:
                t0, t1 = self._wave_view()
                span = max(1e-9, t1 - t0)
                N = len(self._wave_peaks)   # 与生成时的实际桶数一致（中途改设置也不会错位）
                # 可见桶范围（桶 i 的中心时间 = (i+0.5)/N * dur）
                i0 = max(0, int(t0 / self._dur * N) - 1)
                i1 = min(N, int(t1 / self._dur * N) + 2)
                inv = w / span
                # 填充包络：上沿(max)左→右、下沿(min)右→左合成一个多边形，
                # 任意缩放都连续不断裂（取代原逐桶 1px 竖线 → 消除放大后的离散竖条）。
                top = []   # (x, y_top)
                bot = []   # (x, y_bottom)
                for i in range(i0, i1):
                    pk = self._wave_peaks[i]
                    if pk is None:
                        continue
                    mn, mx = pk
                    t = (i + 0.5) / N * self._dur
                    if t < t0 or t > t1:
                        continue
                    x = (t - t0) * inv
                    y1 = mid - max(-32768, min(32767, mx)) / 32768.0 * amp
                    y2 = mid - min(32767, max(-32768, mn)) / 32768.0 * amp
                    if y2 - y1 < 1:
                        y2 = y1 + 1
                    top.append((x, y1))
                    bot.append((x, y2))
                    drawn += 1
                if len(top) >= 2:
                    pts = []
                    for (x, y) in top:
                        pts.append(x); pts.append(y)
                    for (x, y) in reversed(bot):
                        pts.append(x); pts.append(y)
                    cv.create_polygon(pts, fill="#9ec5ff",
                                      outline="#1f6feb", width=1, tags="wave")
                elif top:
                    x, y1 = top[0]; _unused, y2 = bot[0]
                    cv.create_line(x, y1, x, y2, fill="#1f6feb", width=1, tags="wave")
            if drawn == 0:
                if self._wave_peaks is not None and not self._wave_done:
                    tip = _("波形生成中…（长文件需数秒到数十秒）")
                elif self._wave_peaks is not None:
                    tip = _("无音频轨（或波形不可用）")
                else:
                    tip = _("波形生成中…")
                cv.create_text(w / 2, mid, text=tip, fill="#888888")
            if self._wv_t1 is not None and self._wave_done and drawn > 0:
                # 缩放状态提示（右上角小字，避免用户迷失在局部视图里）
                cv.create_text(w - 6, 6, anchor=tk.NE,
                               text=_("%.2fs ~ %.2fs（右键复位）") % (t0, t1),
                               fill="#999999", font=("TkDefaultFont", 8))
            self._move_wave_playhead()
        except Exception:
            pass

    def _move_wave_playhead(self):
        """大波形画布播放头（轻量：只挪坐标不重建）。缩放视图中按视图换算，
        播放头走出视野时轻推视图跟上（保持缩放级别，Audacity 式）。"""
        try:
            cv = self.wave_cv
            w = cv.winfo_width()
            h = cv.winfo_height()
            if w <= 1 or h <= 1 or not self._dur or self._dur <= 0:
                return
            ph = self._current_us / 1e6
            if self._wave_view_follow(ph):
                # 视图变了：静态波形层已过期，整幅重画（本函数由 _draw_wave 末尾
                # 调用，重画后播放头仍在视野内 → 不会无限递归）
                self._draw_wave()
                return
            t0, t1 = self._wave_view()
            x = max(0, min(w, int((ph - t0) / max(1e-9, t1 - t0) * w)))
            if cv.find_withtag("waveph"):
                cv.coords("waveph", x, 0, x, h)
            else:
                cv.create_line(x, 0, x, h, fill="#1a73e8", width=2, tags="waveph")
        except Exception:
            pass

    def _draw_track(self, force_static=False):
        cv = self.track_cv
        try:
            w = cv.winfo_width()
            h = cv.winfo_height()
        except Exception:
            return
        if w < 10 or h < 10:
            return
        if force_static or self._track_dirty:
            self._draw_track_static(cv, w, h)
            self._track_dirty = False
        self._draw_track_dyn(cv, w, h)

    def _draw_track_static(self, cv, w, h):
        cv.delete("static")
        mid = h * 0.62
        amp = h * 0.5 - 6
        cv.create_line(0, mid, w, mid, fill="#e2e2e2", tags="static")
        if not self._dur:
            return
        t0, t1 = self._track_view()
        span = max(1e-9, t1 - t0)
        inv = w / span
        # 波形包络（背景；与音频模式大波形同一份 peaks；只画可见桶段）
        if self._wave_peaks:
            n = len(self._wave_peaks)
            i0 = max(0, int(t0 / self._dur * n) - 1)
            i1 = min(n, int(t1 / self._dur * n) + 2)
            # 填充包络（与大波形同款）：上沿左→右、下沿右→左合成多边形，连续无间隙。
            top = []   # (x, y_top=max)
            bot = []   # (x, y_bottom=min)
            for i in range(i0, i1):
                pk = self._wave_peaks[i]
                if pk is None:
                    continue
                mn, mx = pk
                t = (i + 0.5) / n * self._dur
                if t < t0 or t > t1:
                    continue
                x = (t - t0) * inv
                y1 = mid - max(-1.0, min(1.0, mx / 32768.0)) * amp
                y2 = mid - max(-1.0, min(1.0, mn / 32768.0)) * amp
                if y2 - y1 < 1:
                    y2 = y1 + 1
                top.append((x, y1))
                bot.append((x, y2))
            if len(top) >= 2:
                pts = []
                for (x, y) in top:
                    pts.append(x); pts.append(y)
                for (x, y) in reversed(bot):
                    pts.append(x); pts.append(y)
                cv.create_polygon(pts, fill="#cfe3ff",
                                  outline="#1f6feb", width=1, tags="static")
            elif top:
                x, y1 = top[0]; _unused, y2 = bot[0]
                cv.create_line(x, y1, x, y2, fill="#1f6feb", width=1, tags="static")
        # 关键帧刻度（复用关键帧模块的预扫描表；只画视野内）
        if self._keyframes:
            for kt in self._keyframes:
                if kt < t0 or kt > t1:
                    continue
                x = (kt - t0) * inv
                cv.create_line(x, 4, x, h - 2, fill="#c9c9c9", width=1, tags="static")
        # 标记段（与段落条同一份 _marks；顶部细色条；视野相交即画）
        if self._marks:
            for i, (s, e) in enumerate(self._marks):
                if e < t0 or s > t1:
                    continue
                x0 = max(0, (s - t0) * inv)
                x1 = min(w, (e - t0) * inv)
                col = self._mark_palette[i % len(self._mark_palette)]
                cv.create_rectangle(x0, 2, max(x1, x0 + 2), 7,
                                    fill=col, outline="", tags="static")
        if self._open_start is not None and t0 <= self._open_start <= t1:
            xo = (self._open_start - t0) * inv
            cv.create_line(xo, 2, xo, 9, fill="#dd1111", width=2, tags="static")
        if self._tv_t1 is not None:
            cv.create_text(w - 6, 6, anchor=tk.NE,
                           text=_("%.2fs ~ %.2fs（右键复位）") % (t0, t1),
                           fill="#999999", font=("TkDefaultFont", 8))

    def _draw_track_dyn(self, cv, w, h):
        cv.delete("dyn")
        if self._dur:
            ph = self._current_us / 1e6
            if self._track_view_follow(ph):
                # 播放头出界轻推 → 静态层过期，整条重画（推完播放头必在视野内，无递归）
                self._draw_track(force_static=True)
                return
            t0, t1 = self._track_view()
            x = max(0, min(w, int((ph - t0) / max(1e-9, t1 - t0) * w)))
            cv.create_line(x, 0, x, h, fill="#c00", width=2, tags="dyn")
        # 漂移叠层（顶部细带，画面=真源；时间序列与视图窗口无关，恒画满宽）
        hist = self.drift_hist
        if len(hist) >= 2 and self.has_audio and self.audio_enabled:
            band = 14
            peak = max(0.2, self.drift_peak * 1.15, self.hard_tol * 1.2)
            step = w / float(_AV_DRIFT_HISTORY - 1)
            for i in range(1, len(hist)):
                x0 = (i - 1) * step
                y0 = band / 2 - (hist[i - 1] / peak) * (band / 2 - 2)
                x1 = i * step
                y1 = band / 2 - (hist[i] / peak) * (band / 2 - 2)
                d = hist[i]
                col = "#c00" if abs(d) > self.hard_tol else (
                    "#c60" if abs(d) > self.soft_tol else "#06a")
                cv.create_line(x0, y0, x1, y1, fill=col, tags="dyn")

    def _track_click(self, event):
        """波形条点/拖=定位（250ms 去抖，连点只执行最后一次）。
        缩放后按当前视图窗口换算。"""
        if self._stop or not self._dur or self._dur <= 0:
            return
        w = self.track_cv.winfo_width()
        if w <= 1:
            return
        t0, t1 = self._track_view()
        self._track_click_t = max(0.0, min(self._dur,
                                           t0 + (event.x / w) * (t1 - t0)))
        if self._track_seek_after is None:
            self._track_seek_after = self.win.after(
                _AV_SEEK_DEBOUNCE_MS, self._track_seek_fire)

    def _track_seek_fire(self):
        self._track_seek_after = None
        self._request_seek(self._track_click_t, read_one=not self._playing)

    def _track_view(self):
        if self._tv_t1 is None or not self._dur:
            return 0.0, self._dur or 1.0
        return self._tv_t0, self._tv_t1

    def _track_view_changed(self):
        """波形条视图变化后：按新视图重算附着态（与大波形 _wave_view_changed 同理），
        再重画。缺此步时，全长视图（播放头在内=附着）缩放到别处会被 dyn 层
        立即轻推拽回播放头附近。"""
        ph = self._current_us / 1e6
        t0, t1 = self._track_view()
        self._tv_attached = (t0 <= ph <= t1)
        self._track_dirty = True
        self._draw_track()

    def _track_zoom(self, evt):
        if self._stop or not self._dur:
            return
        w = self.track_cv.winfo_width()
        if w <= 1:
            return
        t0, t1 = self._track_view()
        span = t1 - t0
        f = 0.8 if evt.delta > 0 else 1.0 / 0.8
        new_span = span * f
        if new_span >= self._dur * 0.999:
            self._track_view_reset()
            return
        new_span = max(self._WV_MIN_SPAN, new_span)
        f = new_span / span
        anchor = t0 + (evt.x / w) * span
        n0 = anchor - (anchor - t0) * f
        n1 = anchor + (t1 - anchor) * f
        if n0 < 0:
            n1 -= n0
            n0 = 0.0
        if n1 > self._dur:
            n0 -= (n1 - self._dur)
            n1 = self._dur
            if n0 < 0:
                n0 = 0.0
        self._tv_t0, self._tv_t1 = n0, n1
        self._track_view_changed()

    def _track_pan_start(self, evt):
        self._tv_panning = True
        self._tv_pan_x = evt.x
        t0, t1 = self._track_view()
        self._tv_pan_t0 = t0
        self._tv_pan_span = t1 - t0

    def _track_pan_move(self, evt):
        if not self._tv_panning or self._stop or not self._dur:
            return
        w = self.track_cv.winfo_width()
        if w <= 1:
            return
        dt = -(evt.x - self._tv_pan_x) / w * self._tv_pan_span
        n0 = max(0.0, min(self._tv_pan_t0 + dt, self._dur - self._tv_pan_span))
        self._tv_t0, self._tv_t1 = n0, n0 + self._tv_pan_span
        self._track_view_changed()

    def _track_pan_end(self, evt):
        self._tv_panning = False

    def _track_view_reset(self):
        if self._tv_t1 is None:
            return
        self._tv_t0, self._tv_t1 = 0.0, None
        self._track_view_changed()

    def _track_view_follow(self, ph_t):
        """波形条播放头出界轻推（附着语义与大波形一致）。"""
        if self._tv_t1 is None or not self._dur or self._audio_mode:
            return False
        t0, t1 = self._tv_t0, self._tv_t1
        span = t1 - t0
        if t0 <= ph_t <= t1:
            self._tv_attached = True
            return False
        if not getattr(self, "_tv_attached", False):
            return False
        n0 = max(0.0, min(ph_t - span * 0.15, self._dur - span))
        self._tv_t0, self._tv_t1 = n0, n0 + span
        return True

    def _sync_volume_var(self):
        """刷新 A/V 弹窗的音量变量 =「更多设置 → 预览音量」的当前值。

        2026-09-21：音量统一为单一参数（App.preview_volume，默认 10）——A/V 弹窗音量、
        内置时间预览的音频引擎（self.volume）、各预览播放器（ffplay -volume）共用同一个数。
        App 侧改过之后本类持有的 vol_var 可能过期 → 建/开弹窗时从 App 变量重取一次。
        """
        _v = int(_GLOBAL_SETTINGS.get("preview_volume", 10))
        _vapp = getattr(self, "_app", None)
        if _vapp is not None and hasattr(_vapp, "preview_volume"):
            with suppress(Exception):
                _v = int(_vapp.preview_volume.get())
        _v = max(0, min(100, _v))
        with suppress(Exception):
            self.vol_var.set(_v)
        self.volume = _v

    def _build_params_vars(self):
        self.hard_var = tk.DoubleVar(value=_AV_HARD_TOL)
        self.soft_var = tk.DoubleVar(value=_AV_SOFT_TOL)
        self.hold_var = tk.DoubleVar(value=_AV_SOFT_HOLD)
        self.gap_var = tk.DoubleVar(value=_AV_RESTART_GAP)
        self.lat_var = tk.DoubleVar(value=_AV_LATENCY)
        self.vol_var = tk.IntVar(value=30)
        self.volume = 30
        self._sync_volume_var()   # 音量由「更多设置 → 预览音量」提供（默认 10），建时对齐一次
        self.auto_lat_var = tk.BooleanVar(value=True)
        self.aud_var = tk.BooleanVar(value=True)
        self.step_aud_var = tk.BooleanVar(value=False)

    def _read_params(self):
        try:
            self.hard_tol = float(self.hard_var.get())
            self.soft_tol = float(self.soft_var.get())
            self.soft_hold = float(self.hold_var.get())
            self.restart_gap = float(self.gap_var.get())
            self.auto_latency = bool(self.auto_lat_var.get())
            self.step_with_audio = bool(self.step_aud_var.get())
            self.volume = max(0, min(100, int(self.vol_var.get())))
            # 音量是单一参数：写回全局 + App 的「更多设置 → 预览音量」（App 侧 trace 负责存盘）
            _GLOBAL_SETTINGS["preview_volume"] = self.volume
            _vapp = getattr(self, "_app", None)
            if _vapp is not None and hasattr(_vapp, "preview_volume"):
                _vapp.preview_volume.set(self.volume)
            self.audio_enabled = bool(self.aud_var.get())
            if not self.auto_latency:
                self.latency = max(_AV_LAT_MIN, min(_AV_LAT_MAX, float(self.lat_var.get())))
        except Exception:
            pass

    def _reset_stats(self):
        self.drift_peak = 0.0
        self.drift_sum = 0.0
        self.drift_n = 0
        self._a_restarts = 0
        self.drift_hist.clear()
        self.status_label.config(text=_("统计已重置"))

    def _open_av_settings(self):
        """非模态小弹窗：仲裁参数/音频开关/延迟补偿/音量 + 实时统计 + 强制重同步。"""
        if getattr(self, "_av_popup", None) and self._av_popup.winfo_exists():
            self._av_popup.lift()
            return
        win = tk.Toplevel(self.win)
        win.withdraw()   # center_window 前提（docstring）：先隐藏，定位好再显示，防左上角闪现
        self._sync_volume_var()   # 音量可能在「更多设置」里改过 → 打开时重取最新值
        win.title(_("A/V 设置 - ") + os.path.basename(self.file))
        win.transient(self.win)
        win.resizable(False, False)
        self._av_popup = win

        def _sp(parent, label, var, lo, hi, step, w=6, fmt="%.2f"):
            ttk.Label(parent, text=label).pack(side=tk.LEFT)
            b = tk.Spinbox(parent, from_=lo, to=hi, increment=step, width=w,
                           textvariable=var, format=fmt, command=self._read_params)
            b.pack(side=tk.LEFT, padx=(2, 8))
            b.bind("<Return>", lambda e: self._read_params())
            b.bind("<FocusOut>", lambda e: self._read_params())  # 手输后点别处也生效
            return b

        p1 = ttk.LabelFrame(win, text=_("同步仲裁（画面=真源，音频跟随）"))
        p1.pack(fill=tk.X, padx=8, pady=6)
        _sp(p1, _("硬容差"), self.hard_var, 0.05, 2.0, 0.05)
        _sp(p1, _("软容差"), self.soft_var, 0.02, 1.0, 0.02)
        _sp(p1, _("软持续"), self.hold_var, 0.2, 5.0, 0.2)
        _sp(p1, _("重启间隔"), self.gap_var, 0.2, 3.0, 0.1)
        self.lat_spin = _sp(p1, _("延迟补偿"), self.lat_var, _AV_LAT_MIN, _AV_LAT_MAX, 0.01)

        p2 = ttk.LabelFrame(win, text=_("音频 / 走带"))
        p2.pack(fill=tk.X, padx=8, pady=6)
        ttk.Checkbutton(p2, text=_("启用音频"), variable=self.aud_var,
                        command=self._on_audio_toggle).pack(side=tk.LEFT)
        ttk.Checkbutton(p2, text=_("自适应延迟"), variable=self.auto_lat_var,
                        command=self._read_params).pack(side=tk.LEFT, padx=(8, 0))
        ttk.Checkbutton(p2, text=_("步进带音频"), variable=self.step_aud_var,
                        command=self._read_params).pack(side=tk.LEFT, padx=(8, 0))
        ttk.Label(p2, text=_("音量")).pack(side=tk.LEFT, padx=(12, 0))
        _vol = tk.Spinbox(p2, from_=0, to=100, increment=10, width=4,
                          textvariable=self.vol_var,
                          command=self._on_vol_change)
        _vol.pack(side=tk.LEFT, padx=(2, 0))
        _vol.bind("<Return>", lambda e: self._on_vol_change())
        _vol.bind("<FocusOut>", lambda e: self._on_vol_change())

        p3 = ttk.LabelFrame(win, text=_("实时统计"))
        p3.pack(fill=tk.X, padx=8, pady=6)
        self._pop_drift = tk.StringVar(value="--")
        self._pop_peak = tk.StringVar(value="--")
        self._pop_avg = tk.StringVar(value="--")
        self._pop_restarts = tk.StringVar(value="0")
        self._pop_drop = tk.StringVar(value="0")
        self._pop_fps = tk.StringVar(value="--")
        self._pop_lat = tk.StringVar(value="--")
        mono = ("Consolas", 10)
        for lab, var in ((_("漂移"), self._pop_drift), (_("峰值"), self._pop_peak),
                         (_("均值"), self._pop_avg), (_("重启"), self._pop_restarts),
                         (_("丢帧"), self._pop_drop), ("fps", self._pop_fps),
                         (_("延迟"), self._pop_lat)):
            tk.Label(p3, text=lab + ":", width=5, anchor=tk.E).pack(side=tk.LEFT, padx=(4, 0))
            tk.Label(p3, textvariable=var, width=10, anchor=tk.W, font=mono).pack(side=tk.LEFT)

        p4 = ttk.Frame(win)
        p4.pack(fill=tk.X, padx=8, pady=(2, 8))
        ttk.Button(p4, text=_("强制重同步音频"), command=self.resync_audio).pack(side=tk.LEFT, padx=(0, 6))
        ttk.Button(p4, text=_("重置统计"), command=self._reset_stats).pack(side=tk.LEFT, padx=(0, 6))
        ttk.Button(p4, text=_("关闭"), command=win.destroy).pack(side=tk.LEFT)
        win.bind("<Escape>", lambda e: win.destroy())
        center_window(win, 570, 360)   # +100（2026-09-06）：控件行宽松些，统计行不被挤

    # ---------- 主线程轮询（仲裁 / EOF / UI 跟随，_AV_POLL_MS 周期） ----------
    def _poll(self):
        if self._stop:
            return
        try:
            if not self.win.winfo_exists():
                return
        except Exception:
            return
        now = time.perf_counter()
        if self._audio_mode:
            self._poll_audio_only(now)
        else:
            self._poll_av(now)
        # 波形渐进重绘（worker 只置脏标记，绘制全在主线程；节流 _WAVE_REDRAW_GAP）
        if self._wave_dirty and (time.perf_counter() - self._wave_last_draw) >= _WAVE_REDRAW_GAP:
            self._wave_last_draw = time.perf_counter()
            self._wave_dirty = not self._wave_done
            # peaks 新到/推进 → 波形条静态层（包络）也必须重画。原先两条脏标记独立，
            # 大文件首开时波形条已在 peaks=None 时画过静态层，此后 peaks 到达只刷大波形，
            # 波形条永远停在"无线条"状态（切一次音频模式靠 <Configure> 才补画）。
            self._track_dirty = True
            if self._audio_mode:
                self._draw_wave()
            self._draw_track()
        self._poll_job = self.win.after(_AV_POLL_MS, self._poll)

    def _poll_av(self, now):
        """画面模式（A/V 双引擎）：首次自动开播 / EOF 裁决 / 音频补位 / 漂移仲裁 / UI 跟随。"""
        # 首次自动开播（构造即 _playing=True；_v_worker 只认 _v_target；带冷却防空转）
        if (self._playing and self.has_video and self._v_target is None
                and self._v_proc is None and self._v_wall0 is None
                and self._v_shown_idx == -1 and not self._v_eof
                and (now - self._autostart_ts) >= 1.0):
            self._autostart_ts = now
            self.request_seek(self._current_us / 1e6, play=True)
        # 1) 音频 EOF 裁决：只认当前代际（stale=被 kill 的旧进程，忽略）
        try:
            while True:
                ev, gen = self._a_events.get_nowait()
                if ev == "eof" and gen == self._a_gen and self._playing:
                    if self.has_video:
                        # 音频先播完（音视频时长不等）→ 不打断画面，也别再纠正
                        self._a_pos = self._dur or self._v_pos
                        self._a_dead = True
                    else:
                        self._playing = False
                        self._at_eof = True
                        self.btn_play.config(text=_("播放"))
        except queue.Empty:
            pass
        # 2) 画面 EOF：停双引擎，等下次播放（从头）
        if self._playing and self.has_video and self._v_eof and not self._v_frames:
            self._playing = False
            self._at_eof = True
            self._v_stop_proc()
            self._a_kill()
            self.btn_play.config(text=_("播放"))
        # 3) 音频位置：有状态行用状态行，否则 anchor+墙钟估算（扣掉未出声的启动延迟）
        if self.has_audio and self._a_proc is not None:
            if not self._a_parsed:
                el = (now - self._a_anchor_wall) - self.latency
                self._a_pos = self._a_anchor + (el if el > 0 else 0.0)
            a_pos = self._a_pos
        else:
            a_pos = self._v_pos
        v_pos = self._v_pos
        self._current_us = int(max(0.0, v_pos) * 1e6)
        # 4) 漂移统计
        if not (self.has_audio and self.audio_enabled) or self._a_dead:
            drift = 0.0        # 单端模式 / 音频已到尾：不参与仲裁
        else:
            # 音频 ffplay 被有意从 (v_pos+latency) 起播（补偿启动延迟），其状态行时钟
            # = 相对起播点的 elapsed；稳态 a_pos = v_pos+latency+elapsed ≈ v_pos+latency。
            # 漂移基准须对齐到 (v_pos+latency)，否则把正常启动延迟误判成永久漂移 →
            # 重图 ffplay 起播慢、latency 大 → 每 restart_gap 反复重启（用户实测 80 段工程
            # 音频一卡一卡、ffplay 反复重启）。仅在状态行已解析（_a_parsed）时减 latency；
            # 起播后首条状态行到达前的墙钟估算窗口保持原基准（≈0），避免慢图起播即误重启。
            # 真漂移（音频卡顿/抢跑）仍会在此拉开 → 照常重启（不掩盖）。
            if self._a_proc is not None and self._a_parsed:
                drift = a_pos - (v_pos + self.latency)
            else:
                drift = a_pos - v_pos
        self.drift = drift
        ad = abs(drift)
        self.drift_hist.append(drift)
        if self._playing:
            self.drift_sum += ad
            self.drift_n += 1
            if ad > self.drift_peak:
                self.drift_peak = ad
        # 5) 容错仲裁：画面是主，音频只有被重启的份
        if (self._playing and self.has_audio and self.audio_enabled
                and self._a_pending is None and not self._a_dead):
            gap_ok = (now - self._a_last_restart) >= self.restart_gap
            if ad > self.hard_tol and gap_ok:
                self._a_start(v_pos + self.latency)
                self._soft_since = None
            elif self.soft_tol < ad <= self.hard_tol:
                if self._soft_since is None:
                    self._soft_since = now
                elif (now - self._soft_since) >= self.soft_hold and gap_ok:
                    self._a_start(v_pos + self.latency)
                    self._soft_since = None
            else:
                self._soft_since = None
        self._ui_tick()
        self._draw_track()
        self._update_popup_stats(drift)

    def _poll_audio_only(self, now):
        """音频模式：ffplay 时钟即真源（EOF 裁决/补位/安全网/UI 跟随）。"""
        try:
            while True:
                ev, gen = self._a_events.get_nowait()
                if (ev == "eof" and gen == self._a_gen and self._playing
                        and self._a_seek_job is None):
                    # 自然播完（-autoexit）：钉在末尾；再按播放自动回卷 0
                    self._playing = False
                    self._at_eof = True
                    if self._dur:
                        self._a_pos = self._dur
                    self.btn_play.config(text=_("播放"))
        except queue.Empty:
            pass
        # 自启/续播安全网（兜 ffplay 意外退出后的恢复）
        if self._playing and self._a_proc is None and not self._at_eof:
            self._a_start(self._a_pos)
        # 首条状态行前用 anchor+墙钟补位（快速暂停不回旧位）
        if self._playing and not self._a_parsed and self._a_proc is not None:
            self._a_pos = self._a_anchor + (now - self._a_anchor_wall)
        pos = self._a_pos
        if self._dur:
            pos = max(0.0, min(pos, self._dur))
        self._current_us = int(pos * 1e6)
        self._ui_tick()
        self._move_wave_playhead()
        self._update_popup_stats(0.0)

    def _update_popup_stats(self, drift):
        """A/V设置 弹窗实时统计（弹窗未开则空转）。"""
        if not (getattr(self, "_av_popup", None) and self._av_popup.winfo_exists()):
            return
        avg = (self.drift_sum / self.drift_n) if self.drift_n else 0.0

        def _ms(x):
            return "%+5dms" % int(round(x * 1000))
        self._pop_drift.set(_ms(drift))
        self._pop_peak.set(_ms(self.drift_peak))
        self._pop_avg.set(_ms(avg))
        self._pop_restarts.set(str(self._a_restarts))
        self._pop_drop.set(str(self._v_drop))
        self._pop_fps.set("%.1f" % self._v_shown_fps if self._v_shown_fps else "--")
        self._pop_lat.set("%.2f" % self.latency)
        if not self.auto_latency:
            with suppress(Exception):
                self.lat_var.set(round(self.latency, 3))

    # ---------- 视频引擎（内核：唯一断点 worker + 帧队列 + 墙钟节奏 _pump） ----------
    def _v_worker(self):
        """唯一断点：只按 _v_target 启停 ffmpeg，读帧塞缓冲，绝不碰 Tk。"""
        while not self._stop:
            # 等待后台探测完成（探测在独立线程；窗口关闭靠 _stop 及时退出）
            if not self._probe_done.is_set():
                self._probe_done.wait(0.5)
                continue
            if self._v_target is None:
                time.sleep(0.02)
                continue
            t = self._v_target
            self._v_target = None
            one = self._v_one
            self._v_one = False
            gen = self._v_gen
            self._run_video(t, one, gen)

    def _run_video(self, start, one, gen):
        if not self.has_video or self._stop:
            return
        proc = self._launch_video(start)
        if self._stop or proc is None:
            return
        self._v_proc = proc
        self._v_anchor = self._grid(start)   # 幂等：request_seek 已 grid 过
        self._v_eof = False
        idx = 0
        fb = self._frame_bytes
        fd = proc.stdout.fileno()
        if hasattr(os, "set_blocking"):  # 3.8 Windows 无此 API；管道本就阻塞读，跳过等价
            os.set_blocking(fd, False)
        buf = b""
        # 无数据放弃时限（2026-10-13 修）：out_mode 是「**成片时间轴**定位」的慢路径 —— 深拖时
        # 必须先把图内 trim 之前的帧全解出来丢掉才产出首帧（实测 1280x720 / 拖到 49 分钟
        # ≈40s+ 才出首帧，见统一 Seek 模型 §6）。固定 20s 会在出帧前就 return + kill 掉管道
        # ⇒ 表现「拖了完全没反应」，且 _v_proc 归 None 后「首次自动开播」反复重试（每 20s 一轮）。
        # 与日志里的「⏳ 慢路径，非卡死」同口径：慢路径必须给足耐心。非管道路径行为不变。
        deadline = time.perf_counter() + (180.0 if self._pipe_out_mode else 20.0)
        try:
            while not self._stop:
                if gen != self._v_gen or self._v_target is not None:
                    return
                if one and idx >= 1:
                    return
                # 背压：缓冲满就等（同时不丢 gen 检查）
                if len(self._v_frames) >= _AV_FRAME_BUF:
                    time.sleep(0.004)
                    continue
                try:
                    chunk = os.read(fd, 1 << 20)
                except BlockingIOError:
                    time.sleep(0.002)
                    if time.perf_counter() > deadline and not buf:
                        return
                    continue
                except OSError:
                    return
                if not chunk:
                    if buf:
                        return
                    # 2026-10-13：EOF 只认「**当前代际**」——被新 seek 杀掉的上一个 reader 也会
                    # 读到空（proc.kill 后管道立刻 EOF），照写 _v_eof 会让 _poll_av 判「画面已到
                    # 尾」→ kill 掉**刚启动的新管道** + 停播（_playing=False / _at_eof=True），
                    # 表现就是「拖动后没画面、没声；再按播放还跳回 0」（_at_eof ⇒ play() 回卷 0）。
                    if gen == self._v_gen and self._v_target is None:
                        self._v_eof = True
                    return
                buf += chunk
                deadline = time.perf_counter() + 20.0
                while len(buf) >= fb:
                    if gen != self._v_gen or self._v_target is not None:
                        return      # 拆包中途被 kill → 立刻止损，别把旧帧塞进新进程的缓冲
                    with self._v_lock:
                        self._v_frames.append((idx, buf[:fb]))
                    buf = buf[fb:]
                    idx += 1
                    if one:
                        return
        finally:
            with suppress(Exception):
                proc.kill()
            if self._v_proc is proc:
                self._v_proc = None

    def _launch_video(self, sec):
        """双 -ss：输入粗 seek（关键帧对齐，快）+ 输出精 seek（解码丢弃，B 帧重排正确）
        → 首帧=目标网格帧。stderr 必须 DEVNULL（4KB 块缓冲写满会锁死 ffmpeg）。"""
        flags = _ffmpeg_spawn_flags()
        if self._pipe_graph:
            # 管道合成模式（时间预览引擎）：走 -filter_complex 完整合成图，见 _launch_video_pipe
            return self._launch_video_pipe(sec, flags)
        if _is_static_image_file(self.file):
            # 静态图片：单帧、无时间轴。-loop 1 持续流式输出（图片无法 seek，
            # 不要任何 -ss）。等价「直接用图片」预览。
            cmd = [self.ff, "-hide_banner", "-nostdin",
                   "-loop", "1", "-i", self.file,
                   "-vf", "scale=%d:%d" % (self._vw, self._vh),
                   "-f", "rawvideo", "-pix_fmt", "rgb24", "-an", "-sn", "pipe:1"]
        else:
            pre = max(0.0, sec - 2.0 / max(self._fps, 1.0))
            post = max(0.0, sec - pre)
            cmd = [self.ff, "-hide_banner", "-nostdin",
                   "-ss", "%.6f" % pre, "-i", self.file,
                   "-ss", "%.6f" % post,
                   "-vf", "scale=%d:%d" % (self._vw, self._vh),
                   "-f", "rawvideo", "-pix_fmt", "rgb24", "-an", "-sn", "pipe:1"]
        try:
            return subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, creationflags=flags)
        except Exception:
            return None

    # 静态图片扩展名（movie= 子输入 seek_point 注入时跳过 —— 图片没有时间轴）
    _MOVIE_IMG_EXT = (".jpg", ".jpeg", ".jpe", ".jfif", ".png", ".bmp", ".webp",
                      ".tif", ".tiff", ".gif", ".ico", ".avif", ".heic")

    @staticmethod
    def _inject_seek_point_into_spec(spec, sec):
        r"""给 movie= 子句「spec」部分（不含 `movie=` 前缀、不含 `[label]`）按整段转义口径注入
        `:seek_point=sec`。已含 :seek_point / sec 非法 → 原样返回 spec。

        插入点 = 文件名之后、第一个未转义 `,` 或 `:` 之前。若文件名后紧跟流选择器 `:s=`
        （音频 movie=path:s=a），把 :seek_point 放到 `:s=` 之后
        （`movie=path:s=a:seek_point=S`），顺序不可反（反了会先按默认视频流 seek 再切音频流
        → 音频分支错位/空 → 整张复杂滤镜失败「不出画面」）。

        ⚠️ 整段转义扫描（2026-09-21 修，用户实测报错）：生产口径 `.replace(":", "\\\\:")` 是
        **两个**反斜杠 + 冒号，扫描见到反斜杠必须把「连续反斜杠串 + 其后被转义的那一个字符」一起吃掉，
        否则会落在盘符冒号上把它当选项分隔符 → 注入点跑进盘符
        （`movie=C\\:seek_point=S:/dir/a.mp4` ⇒ ffmpeg `Failed to avformat_open_input 'C:seek_point=…'`、
        整张图失败）。兼容单反斜杠 `\:`（另一处 helper 口径）与双反斜杠 `\\:`（生产口径）。

        被 `_inject_movie_seek_point`（uniform 兜底）与 `_inject_movie_seek_point_per_sub`（逐子）
        共用，消灭两处重复的插入点扫描逻辑。
        """
        if not spec or ":seek_point" in spec:
            return spec
        try:
            _off_s = "%.6f" % float(sec)
        except (TypeError, ValueError):
            return spec
        _fn_end = len(spec)
        i = 0
        while i < len(spec):
            _c = spec[i]
            if _c == "\\":
                while i < len(spec) and spec[i] == "\\":
                    i += 1
                i += 1
                continue
            if _c == "," or _c == ":":
                _fn_end = i
                break
            i += 1
        if spec[_fn_end:_fn_end + 3] == ":s=":
            j = _fn_end + 3
            while j < len(spec):
                _c2 = spec[j]
                if _c2 == "\\":
                    while j < len(spec) and spec[j] == "\\":
                        j += 1
                    j += 1
                    continue
                if _c2 == "," or _c2 == ":":
                    break
                j += 1
            _fn_end = j
        return spec[:_fn_end] + ":seek_point=" + _off_s + spec[_fn_end:]

    # ⚠️ 本方法必须是 @classmethod（首参 cls），与 base 同名方法一致。
    # port 工具整段替换方法体时若起点落在 def 行会**丢掉这行装饰器** → cls 错位。
    # 审计：tests/_audit_port_decorators.py
    @classmethod
    def _inject_movie_seek_point(cls, graph, offset, pts_bridge=None):
        """给图内**视频** movie= 子输入注入 seek_point（管道预览 seek 同步，2026-09-20）。

        ⚠️ 2026-09-20 二次修正：本方法已降级为**兜底**。首选是 `_rewrite_movie_inputs`
        （把视频类 movie= 改写成外部 `-ss -i` 输入 = 帧精确）。原因见该方法 docstring：
        `seek_point` 是**向后关键帧 seek**，不做解码丢弃 → 误差上限一个 GOP（默认可达 10s），
        而主输入是帧精确的输入级 `-ss`，两路口径不同 ⇒ 子视频永远差一截（用户实测）。
        只有在「静态图片 / 路径还原失败 / `[N:v]` 标签撞车」时才走到这里。

        pts_bridge：非 None 时在 seek_point 后追加 `,setpts=PTS+<pts_bridge>/TB` —— 主输入
        已被图头桥接平移回素材时间轴，movie= 子输入（pts=子素材时间）必须同幅平移才能与
        主输入 pts 配对（framesync 按 pts 取帧，不平移则子流被立即耗尽 → 子画面冻结）。

        为什么需要：管道预览的 seek 走命令行 `-ss`，它**只作用于外部 -i 主输入**；图内
        movie= 子输入完全不受影响（各自从自己文件的 0 起）。于是拖动进度条后，主的画面跳了、
        子视频还在原地 —— 播到后面主已播完、子还在播（用户实测）。

        偏移口径（与正式导出一致）：成片里主视频从 pipe_start 起算、子视频从 0 起算，输出时刻
        T 时主 = pipe_start+T、子 = T ⇒ **子视频时间 = 主视频时间 − pipe_start**。预览窗口的时间轴
        就是素材原始时间，故此处注入 `seek_point = sec − pipe_start`（≤0 不注入）。

        静态图片的 movie= 跳过：单帧无时间轴，注入了也无意义（gif 等已归入图片）。
        offset <= 0 或图为空 → 原样返回（零行为变化）。
        """
        try:
            off = float(offset or 0.0)
        except (TypeError, ValueError):
            return graph
        if not graph or off <= 0:
            return graph
        _img = cls._MOVIE_IMG_EXT

        def _rep(m):
            raw = m.group(1)
            if raw.lower().endswith(_img):
                return m.group(0)
            _new = cls._inject_seek_point_into_spec(raw, off)
            if pts_bridge and ":seek_point" in _new:
                _new += ",setpts=PTS+%s/TB" % pts_bridge
            return "movie=%s" % _new
        # 扫描器口径：路径 `:` 已按 filtergraph 语法转义，`movie=((?:\\.|[^,;\[\]\\])+)`
        # 遇转义对/非分隔符吞掉路径，遇 , ; [ ] 收尾（插入点整段转义口径见 _inject_seek_point_into_spec）。
        try:
            return re.sub(r"movie=((?:\\.|[^,;\[\]\\])+)", _rep, graph)
        except Exception:
            return graph

    @classmethod
    def _inject_movie_seek_point_per_sub(cls, graph):
        """回退播放器（mpv/ffplay）路径：给图内每个 movie= 子输入（视频 / 音频 :s=a）注入其各自
        trim/atrim 起点的 seek_point（2026-09-21，concat 串行合并预览提速核心）。

        与 `_inject_movie_seek_point`（管道引擎 uniform 注入）的区别：回退路径每个子输入的 trim
        起点 S_sub 各不相同（PiP 多子、画布多 cell、concat 多轨、轨迹多预设），必须「一个 movie= 一个 S_sub」。

        对齐无损（tests/kli_ffplay_seek_probe.py 实证）：子链 `[L]trim=start=S,setpts=PTS-STARTPTS`
        （视频）或 `[L]atrim=start=S,...`（音频）已把子 pts 归零到「0 基 from S」。给 `movie=X`
        注入 `:seek_point=S` 后跳到 ≤S 的最近 I 帧开始解码、`trim/atrim=start=S` 再丢弃 [0,S)
        → 输出帧与「未注入 seek_point」逐字节相同（md5 一致）。⇒ 纯解码跳过优化、零画质/对齐变化，
        可安全用于任何含 movie= 子输入的图；远起点子输入「秒开」而非从 0 空解到 S_sub。

        覆盖三种 movie 形态（同一正则，按插入点自适应）：
          · `movie=path[0:v]`（PiP/画布子视频，无后缀）
          · `movie=path:s=a[am0]`（concat 音频源）
          · `movie=path,format=yuv420p[1:v]`（concat 视频源，带滤镜后缀）

        🔴 起点判据（2026-10-13 修）：**同一条子链（到 `;` 前）内第一个 `(a)trim=start=`**，
        不再要求「紧跟标签」—— 串行合并 **≥2 段**时 `_build_audio_normalize()` 非空，链首恒是
        `[amN]aresample=…,aformat=…,atrim=start=S`，旧的「紧跟标签」判据会让**每一段音频**都
        静默跳过 ⇒ 每个 `movie=:s=a` 从素材 0 空解到段起点（用户实测：30+ 段、2K 素材时管道预览
        「声音一卡一卡、画面流畅」，切音频模式即好）。紧跟标签时第一个就是它 ⇒ 单段工程行为不变。
        插入点 = 文件名之后、第一个未转义 `,`/`:` 之前。⚠️ 判据是「**整段转义**」而非「两个字符」：
        Windows 盘符冒号按生产口径写成 `F\\\\:`（**两**个反斜杠 + 冒号），扫描时必须把
        「连续反斜杠串 + 其后被转义的那一个字符」一起吃掉，否则会落在冒号上、把它误当选项分隔符 →
        注入点跑进盘符 ⇒ ffmpeg `Failed to avformat_open_input 'F:seek_point=…'`、整张图失败
        （2026-09-21 用户报「画中画预览 mpv/ffplay 都报错」，真机探针
        `tests/_verify_pip_seekpoint_drive.py` A/B 锁定：未注入 PASS / 旧扫描 FAIL / 新扫描 PASS）。
        已含 `:seek_point` 幂等跳过；S<=0 / 静态图片 / 异常 → 原样返回。
        """
        if not graph:
            return graph
        _img = cls._MOVIE_IMG_EXT
        try:
            # 每个 movie= 子句：捕获 spec（到 [label] 之前）与 label
            _re_mv = re.compile(r"movie=((?:\\.|[^\[])*?)\[([A-Za-z0-9_]+)\]")
            _lbl_s = {}
            for _m in _re_mv.finditer(graph):
                _lbl = _m.group(2)
                if _lbl in _lbl_s:
                    continue  # 一个 movie 定义只认领一处
                # 本段子链：先找到**消费该标签**的那条链（`movie=…[lbl]` 之后的第一个 `[lbl]`，
                # 即 `…[lbl];[lbl]滤镜…` 里的第二个），再取到该链的 `;` 为止。
                _rest = graph[_m.end():]
                _lm = re.search(r"\[" + re.escape(_lbl) + r"\]", _rest)
                if not _lm:
                    continue
                _seg = _rest[_lm.end():].split(";", 1)[0]
                # 🔴 2026-10-13 修（用户实测：**30+ 段、2K 素材** ⇒ 管道预览「声音一卡一卡、
                #    画面流畅」，而切「音频模式」就不卡）：旧判据要求 `trim/atrim` **紧跟标签**，
                #    于是「链首带归一」的段**全部静默跳过** —— 而串行合并 ≥2 段时
                #    `_build_audio_normalize()` 非空（`len(params) >= 2` 就返回非空），链首恒是
                #    `[amN]aresample=…,aformat=…,atrim=start=S` ⇒ **每一段音频都不注入** ⇒
                #    每个 `movie=:s=a` 都从素材 0 空解到段起点（2K 码率高 ⇒ 要读的字节多 ⇒ 卡）。
                #    ⚠️ 这也让 2026-10-13 那条「管道预览补 _inject_movie_seek_point_per_sub」的
                #    修复对**多段工程实际是空操作**（只有单段/无归一才命中；回归锁见
                #    `tests/_verify_pip_seekpoint_drive.py` 用例 H —— 本轮已随之升级为「必须注入」）。
                # 放宽为「**同一条链内**第一个 `(a)trim=start=`」：紧跟标签时它就是第一个 ⇒ 与
                # 旧判据等价（单段工程逐字节不变）；插入点仍由 `_inject_seek_point_into_spec`
                # 按整段转义口径算，不受影响。视频 `[i:v]` 仍因标签含冒号不被 `[A-Za-z0-9_]+` 认领。
                _tm = re.search(r"(?:^|,)(?:a)?trim=start=([0-9]+(?:\.[0-9]+)?)", _seg)
                if not _tm:
                    continue
                try:
                    _s = float(_tm.group(1))
                except (TypeError, ValueError):
                    continue
                _spec = _m.group(1)
                if _s <= 0 or _spec.lower().endswith(_img) or ":seek_point" in _spec:
                    continue
                _lbl_s[_lbl] = _s

            if not _lbl_s:
                return graph

            def _rep(m):
                _lbl = m.group(2)
                if _lbl not in _lbl_s:
                    return m.group(0)
                _spec = m.group(1)
                return "movie=%s[%s]" % (cls._inject_seek_point_into_spec(_spec, _lbl_s[_lbl]), _lbl)

            return _re_mv.sub(_rep, graph)
        except Exception:
            return graph

    @classmethod
    def _inject_amovie_seek_point_per_sub(cls, graph):
        """amovie= 源的逐段 seek_point 注入（2026-10-14）：与 `_inject_movie_seek_point_per_sub`
        同口径，但匹配 `amovie=`（多输入 / 转场 PiP 合成音频图用 amovie= 而非 movie=；
        `amovie=` 含 `movie=` 子串 ⇒ 旧正则会把 spec 误抓成 `=PATH...`，故必须独立正则）。

        从每条 amovie 子链内**第一个** `(a)trim=start=S` 取该源在 concat 时间轴的段起点，
        注入 `seek_point=S`；下游 `trim/atrim=start=S` 保留做归零（与 movie= 版对齐无损、各段秒开）。
        S<=0 / 静态图片 / 已含 seek_point ⇒ 跳过。异常原样返回（不炸图）。

        修复对象：80 段多输入 concat 合成音频图。旧 blanket 注入（每个 amovie 都加同一个
        coarse）把时间轴压缩 N*coarse ⇒ 「只响第一声」；「不注入」又退回 0→at 慢解码（「一卡一卡」）。
        逐段注入各源自身段偏移 ⇒ 既正确又秒开。"""
        if not graph:
            return graph
        _img = cls._MOVIE_IMG_EXT
        try:
            # 独立正则：`amovie=` 前缀（含 movie= 子串，旧正则会误抓）
            _re_am = re.compile(r"amovie=((?:\\.|[^\[])*?)\[([A-Za-z0-9_]+)\]")
            _lbl_s = {}
            for _m in _re_am.finditer(graph):
                _lbl = _m.group(2)
                if _lbl in _lbl_s:
                    continue  # 一个 amovie 定义只认领一处
                _rest = graph[_m.end():]
                _lm = re.search(r"\[" + re.escape(_lbl) + r"\]", _rest)
                if not _lm:
                    continue
                _seg = _rest[_lm.end():].split(";", 1)[0]
                _tm = re.search(r"(?:^|,)(?:a)?trim=start=([0-9]+(?:\.[0-9]+)?)", _seg)
                if not _tm:
                    continue
                try:
                    _s = float(_tm.group(1))
                except (TypeError, ValueError):
                    continue
                _spec = _m.group(1)
                if _s <= 0 or _spec.lower().endswith(_img) or ":seek_point" in _spec:
                    continue
                _lbl_s[_lbl] = _s

            if not _lbl_s:
                return graph

            def _rep(m):
                _lbl = m.group(2)
                if _lbl not in _lbl_s:
                    return m.group(0)
                _spec = m.group(1)
                return "amovie=%s[%s]" % (
                    cls._inject_seek_point_into_spec(_spec, _lbl_s[_lbl]), _lbl)

            return _re_am.sub(_rep, graph)
        except Exception:
            return graph

    @staticmethod
    def _unescape_movie_path(raw):
        """movie= 里的转义路径 → 真实文件路径（改写外部 -i 输入用）。

        生成端口径（全部调用点一致，含 PiP 子视频 39588 / 画布 / 水印）：
        `_movie_path_safe(p).replace("\\", "/").replace(":", "\\\\:")`
        → 先把反斜杠全变正斜杠，再把盘符冒号写成 `\\\\:`（**两个**反斜杠，因为该字符串要过
        filtergraph + filter-args **两层**转义解析）。

        实测（tests/_probe_movie_escape_roundtrip.py）这个逆变换对普通英文 / 含空格 / 含中文 /
        含 `[ ] ' , ;`（走 `_movie_path_safe` 硬链接分支）**全部无损**，且还原出的路径
        `ffmpeg -i` 直接 rc=0；`movie=<转义串>` 建图同样 rc=0。故「转义串 → 真实路径」不需要
        把文件表从生成端透传下来，可完全收敛在管道启动处。
        """
        if not raw:
            return None
        s = raw.replace("\\\\:", ":")
        if "\\" in s:
            # 兜底：还有别的转义形态 → 逐字符剥一层（生成端口径下本不会走到这里）
            out = []
            i = 0
            while i < len(s):
                if s[i] == "\\" and i + 1 < len(s):
                    out.append(s[i + 1])
                    i += 2
                else:
                    out.append(s[i])
                    i += 1
            s = "".join(out)
        return s

    @classmethod
    def _rewrite_movie_inputs(cls, graph, offset, pts_bridge=None):
        """把图内**视频类** `movie=` 子输入改写成外部 `-i` 输入，让子输入也走输入级 `-ss`。

        返回 `(新图, 输入路径列表, 未改写数)`；输入路径列表下标 i ↔ ffmpeg 输入序号 i+1
        （0 恒为主输入）。`未改写数 > 0` 时调用方应退回 `_inject_movie_seek_point` 近似兜底。

        为什么必须这么改（2026-09-20 实测，推翻了原先的 seek_point 方案）：
        命令行 `-ss` 只作用于外部 `-i` 主输入，图内 `movie=` 只能用 `seek_point`，而
        `seek_point` 是**向后关键帧 seek**（跳到「不晚于目标时间的最近 I 帧」，不做解码丢弃）
        → 误差上限一整个 GOP（x264 默认 25fps 下 10 秒）。主输入却是帧精确的输入级 `-ss`
        （关键帧定位 + 解码丢弃）。两路口径不同 ⇒ 拖进度条后子视频永远差一截，且差值随目标
        时间跳动（用户实测「有时候慢一点、有时候快一点」）。
        改写后主/子都走输入级 `-ss`：帧精确，且 seek 依然快（不退化成像输出侧 trim 那样从 0 解码）。

        子输入 -ss（2026-09-20 方案A 终版）：固定取 **0**（子素材从 0 解码，与旧 `movie=`
        解码口径一致）。原因：图内子链 `trim=start=S_sub,setpts=PTS-STARTPTS` 已把子 pts 归零
        到「0 基 from S_sub」，与父预览「0 基 from pipe_start」的主视频按 pts 帧同步配对
        （见 _launch_video_pipe 0 基模型注释）。旧 三次修正把子 -ss 取成 scrub 偏移
        back=sec−pipe_start，导致子素材被整体平移 back−S_sub → 拖进度条后子画面「漂」= 子
        seek 错位（用户实测）。固定 0 则子 pts 恒为 s−S_sub，与 scrub 无关 → 子画面钉死正确
        素材位置。pts_bridge 参数保留为接口兼容，但本方法不再注入桥接（0 基模型下子链自带
        STARTPTS 归零，注入量会被 STARTPTS 吸收，无意义）。
        ⚠️ 2026-09-21 补正：本方法返回的 `-ss` 只是**默认值 0**；调用方随后用
        `_split_sub_trims` 把带「绝对 trim」的子链各自算成 `-ss = S_sub + T`（并同步把 trim
        改相对、`setpts=PTS-STARTPTS` 换成 `setpts=PTS+T/TB`），这才是真正生效的 seek。
        保留 0 作为无 trim 子链（如视频水印整条播放）的语义 = 从 0 解码，与旧行为一致。
        安全边界（任一不满足 → **不改写**，
        由调用方兜底，保证零回归）：
          · 静态图片扩展名 → 单帧无时间轴，注入 `-ss` 无意义（gif 等已归入图片）；
          · 还原出的真实路径不存在 → 不改写（`_movie_path_safe` 建链接失败时会原样返回带
            `[ ] ' , ;` 的路径，这种串本身也无法作为 `-i` 参数）；
          · 图内已存在同名 `[N:v]` 标签 → **整图放弃**改写（外部输入流标签是 ffmpeg 固定的，
            不能改名，撞车会让图引用到错流）。
          · 图为空 → 原样返回（零行为变化）。
            ⚠️ 2026-09-21 修正：旧判据是 `offset <= 0`，会在**刚好打开预览、还没拖进度条**
            （back = sec − pipe_start = 0）时整段跳过改写 ⇒ 子输入退回图内 `movie=` 且**不带
            任何 seek** ⇒ 必须从 0 一秒一秒解码到 S_sub。用户 10 分钟起点的项目实测「等到死
            都不出画面」正是这条（诊断行 back=0.000000）。back=0 恰恰是最常见的入口，
            必须改写；新判据 `offset < 0`（实际不会发生，_back 已 max(0.0, …)）。
        """
        try:
            off = float(offset or 0.0)
        except (TypeError, ValueError):
            return graph, [], 0
        if not graph or off < 0:
            return graph, [], 0
        _img = cls._MOVIE_IMG_EXT
        _re_mv = re.compile(r"movie=((?:\\.|[^,;\[\]\\])+)")
        # ⚠️ 2026-09-21 修正：**一处 movie= 一个输入，禁止任何形式的去重**（旧实现按「转义串」
        # 和「真实路径」两级去重）。同一素材的多条子链位于**不同素材起点**，共用一个 [N:v]
        # 输入就共用一个 -ss，必然只有第一条是对的：
        #   · _split_sub_trims 一个输入序号只认领一处 trim ⇒ 第二条子链保留绝对
        #     trim=start=181.141，却挂在 -ss 93.848 的输入上 ⇒ 实际显示素材
        #     93.848+181.141 = 274.99s（用户实测「第 3 个画面不准」）；
        #   · 且它要额外空解 181 秒才产出第一帧 ⇒ 又是 overlay 的一层 ⇒ 复合图长时间停摆。
        # 按下标位置建索引，天然支持同一转义串在图中多次出现。
        _plan = {}      # 出现处起点下标 → 输入序号（1 起）
        _subs = []      # (真实路径, 子内容起点S_sub=0.0)，顺序 = 输入序号 1,2,3…
        try:
            for m in _re_mv.finditer(graph):
                raw = m.group(1)
                if raw.lower().endswith(_img):
                    continue
                real = cls._unescape_movie_path(raw)
                if not real or not os.path.exists(real):
                    continue
                _subs.append((real, 0.0))
                _plan[m.start()] = len(_subs)
            if not _plan:
                return graph, [], 0
            # 标签撞车检查：图内已用 [N:v] 就不能再占用（外部输入流标签不可改名）
            for _n in range(1, len(_subs) + 1):
                if ("[%d:v]" % _n) in graph:
                    return graph, [], 0

            def _rep(m):
                # 按出现位置取序号（同串多次出现 → 各自一个输入，见上方 2026-09-21 修正）
                _i = _plan.get(m.start())
                # ⚠️ 必须带 `null`：movie= 是「源滤镜」，后面通常跟着它自己的输出标签
                # （`movie=X[sub0]`）或逗号续链（`movie=X,format=…[i1]`）。只替换成 `[N:v]`
                # 会产出 `[1:v][sub0]` —— 裸相邻标签不是合法 filtergraph（空滤镜名），
                # ffmpeg 直接 parse error → 管道出不了帧（用户实测「正在加载预览」卡死）。
                # `[N:v]null` 把输入流直通进原链，两种形态都成立。0 基模型下不再注入 pts 桥接。
                if _i is None:
                    return m.group(0)
                return "[%d:v]null" % _i

            _new = _re_mv.sub(_rep, graph)
        except Exception:
            return graph, [], 0
        _left = sum(1 for m in _re_mv.finditer(_new)
                    if not m.group(1).lower().endswith(_img))
        return _new, _subs, _left

    @classmethod
    def _rewrite_abs_trims(cls, graph, t_off, jobs):
        """方案A「绝对 trim → 相对 trim + 输入级 -ss + setpts 桥接」重写核心。

        `_split_zero_branches`（主输入多分支消费 [0:v]）与 `_split_sub_trims`（movie= 子链）
        算法同款，仅"命中点怎么收集"与"end 口径"不同 —— 抽出本函数统一重写，两处只留收集器。

        jobs: [(seg_start, seg_end, idx, x, end_abs, new_label)]，每个 job 描述一处命中：
          · seg_start/seg_end —— graph 中待替换片段 [seg_start:seg_end]（零分支含前导
            `[0:v]setpts=PTS-STARTPTS`，子链仅 `trim=…,setpts=PTS-STARTPTS`，由收集器按各自
            正则截取）；
          · idx —— 该处对应输入序号（零分支 = 0 或新分配；子链 = idx_list 中的序号）；
          · x —— 命中 `trim=start` 的绝对素材秒；end_abs —— 命中 `trim=end` 的绝对秒（无则 None）；
          · new_label —— 零分支传新输入标签 `[<idx>:v]`（替换前导 `[0:v]`），子链传 None
            （标签不动，只重写 trim 段）。
        ⚠️ end 口径差异（不可抹平）：子链版 end 额外减 t（窗口 [S+T, E]），零分支版不减
        （窗口 [S, E]）。本函数按 new_label 是否为 None 决定减 t —— 与两版历史行为一致。
        返回 (新图, [(idx, seek), …])；seek = max(0, x + t)。
        """
        t = _opt_float(t_off or 0.0, 0.0)
        _out = []
        _last = 0
        _seeks = []
        for (seg_start, seg_end, idx, x, end_abs, new_label) in jobs:
            _x = _opt_float(x, 0.0)
            _seeks.append((idx, max(0.0, _x + t)))
            if end_abs is None:
                _trim = "trim=start=0"
            else:
                # 子链版（new_label=None）end 额外减 t；零分支版不减 —— 见 docstring 口径说明
                _sub = t if new_label is None else 0.0
                _d = max(0.001, float(end_abs) - _x - _sub)
                _trim = "trim=start=0:end=%.6f" % _d
            if new_label is None:
                # 子链：只重写 trim 段本身（前导 [<i>:v]… 不动）
                _rep = "%s,setpts=PTS+%.6f/TB" % (_trim, t)
            else:
                # 零分支：把前导 `[0:v]setpts=PTS-STARTPTS` 换成新标签的同款，再接相对 trim + 桥接
                _rep = "%ssetpts=PTS-STARTPTS,%s,setpts=PTS+%.6f/TB" % (new_label, _trim, t)
            _out.append(graph[_last:seg_start])
            _out.append(_rep)
            _last = seg_end
        _out.append(graph[_last:])
        return "".join(_out), _seeks

    # ⚠️ 本方法必须是 @classmethod（首参 cls），与 base 同名方法一致。
    # port 工具整段替换方法体时若起点落在 def 行会**丢掉这行装饰器** → cls 错位。
    # 审计：tests/_audit_port_decorators.py
    @classmethod
    def _split_zero_branches(cls, graph, t_off, first_idx):
        """把图内多条消费 [0:v] 的「绝对 trim」分支拆成独立输入，各自 -ss（方案A）。

        为什么必须拆（2026-09-21 实测，推翻「单输入 -ss + 常量桥接」旧模型）：
        导出图每条分支写成
            [0:v]setpts=PTS-STARTPTS,trim=start=<X>:end=<Y>,setpts=PTS-STARTPTS,…
        X/Y 是**素材绝对秒**。管道给主输入加 -ss 后，分支开头的 `setpts=PTS-STARTPTS`
        会把任何常量桥接**精确抵消**（实测：桥 +pre 与桥 +pre−pipe_start 抽出的帧 md5
        完全相同 ⇒ 桥接对分支是 no-op）⇒ `trim=start=X` 变成「从 seek 点再向前走 X
        秒」，两条后果：
          ① 内容整体平移 pre 秒（用户实测「子画面不准」，其实主画面同样错了 pre 秒）；
          ② 每条分支必须先解码 X 秒才产出第一帧，总解码量 = pre + max(X) —— 4K + 远
             片段要几分钟；且 pre+X 越过文件尾时该分支**永远不出帧** ⇒ overlay 缺层
             ⇒ 复合图死锁 ⇒ 永久「正在加载预览」（用户实测）。
        单输入 -ss 无法同时服务位于不同素材位置的分支，故**一分支一输入**。

        拆法：分支 k 改用独立输入，`-ss = X_k + T`（T = 预览合成时间 = sec−pipe_start），
        分支内 trim 改相对 `start=0:end=Y−X`，第 2 个 `setpts=PTS-STARTPTS` 换成
        `setpts=PTS+T/TB` —— 各分支输出 pts 统一为【合成时间 τ】：
            pts_in = 素材 − (X_k+T) ； τ = 素材 − X_k  ⇒ 补偿量恒为 T（与 X_k 无关）。
        于是 framesync 按 τ 对齐各分支，enable 表达式也直接读到 τ（delogo 等不再偏移）。

        返回 (新图, [(输入序号, ss), ...])：分支 0 复用输入 0，其余从 first_idx 起。
        无匹配分支 / 目标标签已被占用 / 时长非正 ⇒ 原样返回 (graph, None)，
        调用方退回旧桥接路径（零行为变化）。
        """
        if not graph:
            return graph, None
        try:
            t = float(t_off or 0.0)
        except (TypeError, ValueError):
            return graph, None
        _re = re.compile(
            r"\[0:v\]setpts=PTS-STARTPTS,trim=start=([0-9.]+)"
            r"(?::end=([0-9.]+))?,setpts=PTS-STARTPTS")
        _hits = list(_re.finditer(graph))
        if not _hits:
            return graph, None
        # 目标标签撞车检查（外部输入流标签不可改名）→ 整图放弃，退回旧路径
        for _k in range(len(_hits) - 1):
            if ("[%d:v]" % (first_idx + _k)) in graph:
                return graph, None
        _jobs = []
        _n = 0
        for m in _hits:
            try:
                x = float(m.group(1))
            except (TypeError, ValueError):
                return graph, None
            end_abs = None
            if m.group(2):
                end_abs = _opt_float(m.group(2), None)
                if end_abs is not None and end_abs - x <= 0:
                    return graph, None
            _idx = 0 if _n == 0 else first_idx + _n - 1
            # 零分支版：前导 [0:v] 换成新输入标签（n==0 时即 [0:v]，等价不变），end 不减 t
            _jobs.append((m.start(), m.end(), _idx, x, end_abs, "[%d:v]" % _idx))
            _n += 1
        return cls._rewrite_abs_trims(graph, t, _jobs)

    @classmethod
    def _split_sub_trims(cls, graph, t_off, idx_list):
        """movie= 改写出来的**子输入链**里的「绝对 trim」也改成各自 seek（方案A 补完）。

        为什么必须做（2026-09-21 用户真实命令实测，2K/4K 项目「等到死都不出画面」）：
        子素材链形如
            [1:v]null[sub0];[sub0]trim=start=<绝对素材秒>:end=<绝对秒>,setpts=PTS-STARTPTS,…
        · 旧「三次修正」在子链头注入 `setpts=PTS+sec/TB`，把 trim 门限**抵消掉 sec 秒**
          ⇒ 只需解码 `S_sub − sec` 秒（本例 221.2−143.2 = 78s，4K 实测约 16s 出画面），
          代价是**子画面内容是错的**（显示的是第 78s 的画面 = 用户实测「子画面不准」）；
        · 6d7c867 改 0 基后不再注入桥接 ⇒ 子链必须**从头解码到 S_sub**（本例 221s 的 4K）
          才产出第一帧；而它是 overlay 的一层，framesync 要等两路都有帧 ⇒ **整个复合图
          停摆** ⇒ 永久「正在加载预览」（用户实测）。解码量 78s→221s 正是「旧版 16s 能出、
          新版等到死」的量化解释。

        修法与 _split_zero_branches 同款：子输入 `-ss = S_sub + T`，链内 trim 改相对
        （start=0, end=E−S−T），`setpts=PTS-STARTPTS` 换成 `setpts=PTS+T/TB`
        ⇒ 输出 pts 统一为【合成时间 τ】，且**解码量≈0**（直接从 S_sub 开解）。
        数学：pts_in = m − (S_sub+T)，τ 应为 m − S_sub ⇒ 补偿量恒为 T（与 S_sub 无关）。

        返回 (新图, {输入序号: ss})。子链无 trim / 解析异常 ⇒ 该子不入字典，保持 -ss 0
        （旧行为，零回归）。

        ⚠️ 2026-10-11 修正（管道预览「丢失第一个子视频」）：`_re.search` **必须限定在本子链内**
        （下界 = `[i:v]`；上界 = 下一个子输入标签 `[j:v]`，未被改写的图片类子链另按 `movie=` 收口）。
        旧写法 `_re.search(graph, _pos)` 一路搜到全图末尾 —— 本子链没有 trim 时会**抓走后一个
        子链的 trim** ⇒ 该输入拿到别人的 `-ss`（越界则一个帧都出不来 → overlay 整层消失 =
        用户实测「第一个子视频看不到」），而真正的主人被 `_used` 跳过、链内 trim 却被相对化
        ⇒ 保留 `-ss 0` = 子画面内容前移。
        """
        if not graph:
            return graph, {}
        try:
            t = float(t_off or 0.0)
        except (TypeError, ValueError):
            return graph, {}
        _re = re.compile(r"trim=start=([0-9.]+)(?::end=([0-9.]+))?,setpts=PTS-STARTPTS")
        _jobs = []          # 传给 _rewrite_abs_trims 的命中（标签不动 → new_label=None，end 减 t）
        _used = set()       # 同一处 trim 不许被两个输入重复认领
        for _i in idx_list:
            _pos = graph.find("[%d:v]" % _i)
            if _pos < 0:
                continue
            # 子链边界（2026-10-11）：不能搜到全图末尾，否则本子链无 trim 时会抓走后面子链的
            # trim（见上方修正说明）。本方法跑在 `_rewrite_movie_inputs` **之后** ⇒ 视频类子链
            # 已被换成 `[j:v]null[…]`，故上界按**下一个子输入标签**取（`movie=` 只剩未被改写的
            # 图片类子链，一并收口）。该子链的 trim 必然在 `[i:v]` 之后、下一个子链起点之前。
            _end = len(graph)
            _nxt = graph.find("movie=", _pos + 1)
            if 0 <= _nxt < _end:
                _end = _nxt
            for _j in idx_list:
                if _j == _i:
                    continue
                _p = graph.find("[%d:v]" % _j, _pos + 1)
                if 0 <= _p < _end:
                    _end = _p
            m = _re.search(graph, _pos, _end)
            if not m or m.start() in _used:
                continue
            try:
                x = float(m.group(1))
            except (TypeError, ValueError):
                continue
            e = None
            if m.group(2):
                e = _opt_float(m.group(2), None)
            _used.add(m.start())
            _jobs.append((m.start(), m.end(), _i, x, e, None))
        if not _jobs:
            return graph, {}
        _new_graph, _seeks = cls._rewrite_abs_trims(graph, t, _jobs)
        return _new_graph, {_idx: _s for (_idx, _s) in _seeks}

    @classmethod
    def build_pipe_checker_underlay(cls, vw, vh, gid="pvck"):
        """管道合成预览的「透明指示」棋盘底接线（返回 str，可整段塞进 -filter_complex）。

        用法：把原尾链 `<前链>,format=rgb24[pv_out]` 换成
              `<前链>,<本段>,format=rgb24[pv_out]`
        本段内部：`split=2[f][b]` → `[b]` 生成棋盘当底 → `[bg][f]overlay`（合成图盖在上面）
        ⇒ 不透明处完全遮住棋盘（视觉零变化），只有 alpha<255 处透出格子。

        与 `build_seek_frame_cmd`（61345 起）是**同一款**：16px 格、两档灰 200/150、同相位；
        差别只在「怎么画」——那里是 ≤320px 成帧上全尺寸 geq；这里是 25fps 实时帧流，全尺寸
        geq 在 1080p 要 1.62x realtime（跟不上）⇒ 改在 **1/16 小画布**上按「1 像素 = 1 格」
        生成，再 neighbor 放大回 16px 格（research/pipe-preview-alpha §4 实测 0.03~0.13x）。

        ⛔ 四条实测约束（别改）：
        1. 必须接在 `scale+pad` **之后**（放在之前 ⇒ 等比缩放拿不到合成帧原始宽高，信箱条消失）；
        2. 必须接在 `format=rgb24` **之前**（之后 alpha 已丢，棋盘永不透出）；
        3. `geq` 只能跑小画布 + `format=gbrp`（捡其余画布 geq 慢一个量级，不能省）；
        4. 尺寸用 **ceil 后 ×16** 的编译期常量：`iw/16` 向下取整 ⇒ 放大后可能小于目标
           （640×360 → 40×22 → 640×352）⇒ `crop=640:360` 当场失败。
        🔴 三个 geq 通道必须写**同一个**表达式才成灰阶；各写一个值 = 一块纯色（历史教训）。
        🔴 段首必须有 **`format=rgba`（形状锚）**——2026-10-12 用户实测「预览完全不出帧」：
        当 `scale(decrease)` 的输出恰好等于 `pad` 目标（pad 沦为 no-op，如合成 562x1000 →
        预览 281x500）时，后面的 `split → overlay` 汇合会让 ffmpeg 把 pad 上游的 shape **反推成
        合成原始尺寸** ⇒ pad 收到 562x1000 ⇒ "Padded dimensions cannot be smaller than input
        dimensions" ⇒  filtergraph 初始化失败 ⇒ **一帧都出不来**。矩阵实测（5 合成 × 5 预览）：
        无锚 10/25 失败（含用户这次的 281x500）；插一个不改尺寸的 `format=rgba` 后 25/25 通过
        （`scale=W:H` 硬缩同样有效，但每帧多一次像素缩放，不必）。
        """
        _vw, _vh = int(vw), int(vh)
        _sw, _sh = -(-_vw // 16), -(-_vh // 16)
        _bw, _bh = _sw * 16, _sh * 16
        _e = "if(eq(mod(X+Y,2),0),200,150)"
        _f, _b, _bg = gid + "f", gid + "b", gid + "bg"
        return ("format=rgba,"          # ← 形状锚，别删（见 docstring 最后一条）
                + "split=2[%s][%s];" % (_f, _b)
                + "[%s]scale=%d:%d:flags=area,format=gbrp,"
                  "geq=r='%s':g='%s':b='%s':a=255,"
                  "format=rgba,scale=%d:%d:flags=neighbor,crop=%d:%d[%s];"
                  % (_b, _sw, _sh, _e, _e, _e, _bw, _bh, _vw, _vh, _bg)
                # 🔴 `overlay` 必须显式指定 **format=rgb**（= RGBA，全分辨率、带 alpha）。
                #    默认 format=yuv420 会把整支链降成 yuva420p ⇒ 色度抽样 ⇒ **宽度被抹成偶数**
                #    （用户 281x500 预览实测：`crop=281` 出来变 280）⇒ 输出帧字节 ≠ `_frame_bytes`
                #    ⇒ 读帧逐帧错位 ⇒ 画面被剪切（看着「斜」）+ 相位累积（看着「一格一格往上抖」）。
                #    `format=gbrp`（GBRAP）等效可用；⛔ 别省这个参数、也别写 format=auto。
                #    顺带：走 yuv 还会把色彩范围从 full/gbr 拽成 tv/bt709，棋盘灰度被改。
                # `setsar=1`：小画布 `scale` 会把 SAR 改成 1124/1125（保 DAR），归一回去。
                + "[%s][%s]overlay=format=rgb,setsar=1" % (_bg, _f))

    def _launch_video_pipe(self, sec, flags):
        """管道合成模式启动（时间预览引擎，2026-09-20 Phase 1）：

        ffmpeg -ss pre -i 主文件 -ss post -filter_complex <合成图;[pv_src]缩放[pv_out]>
               -map [pv_out] -t <上限> -an -sn -f rawvideo -pix_fmt rgb24 pipe:1
        （主输入是静态图片时改为 `-loop 1 -i <图>`、不加任何 -ss —— 图片不能 seek，
          靠 -loop 1 造连续流，管道里这个参数是有效的。）

        与普通路径的三处关键差别（研究 research/preview/README1.md §四）：
        1. 末尾不是裸 scale=W:H —— 合成图尺寸常≠源（pad 画布/split 网格），直接 scale 会拉伸
           变形。改用 `scale=...:force_original_aspect_ratio=decrease` + `pad=W:H`（letterbox），
           保证输出【恰好】WxH ⇒ 帧字节恒定 = _frame_bytes，_pump 节奏模型不被破坏。
        2. 必须补 `fps=<源帧率>` —— 位置模型 = anchor + 帧号/fps；图内若含 fps=/变速滤镜会改
           输出帧率，不加则时间显示系统性偏移。
        3. 必须加【输出级】-t 封顶 —— 图内可能有 color=c=black@0 无限源（旋转水印/倒计时/画布）。
           管道里 -t 有效（与 ffplay 的 -autoexit 按主输入 EOF 退窗正好相反）。上限取值：
           pipe_duration（调用方已知）→ 主输入时长（探测）→ 图内有 =999999 时 1h 兜底。
        4. 素材时间轴模式下，图内**视频类** `movie=` 子输入会先被改写成外部 `-ss -i` 输入
           （`_rewrite_movie_inputs`），让子输入也吃到输入级 `-ss` = 帧精确；改不到的才退回
           `seek_point` 近似。详见该方法 docstring。
        """
        _fps_s = "%.6f" % max(self._fps, 1.0)
        _tail = ("[pv_src]scale=%d:%d:force_original_aspect_ratio=decrease:flags=fast_bilinear,"
                 "pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=black,"
                 "fps=%s,setsar=1,format=rgb24[pv_out]"
                 % (self._vw, self._vh, self._vw, self._vh, _fps_s))
        _pstart = _opt_float(self._pipe_start or 0.0, 0.0)
        _back = max(0.0, sec - _pstart)
        _out_mode = bool(getattr(self, "_pipe_out_mode", False))
        _sub_inputs = []      # 从图内 movie= 改写出来的子输入路径（仅素材时间轴模式用）
        _branch_inputs = []   # 方案A：[0:v] 分支拆分出的额外输入 [(输入序号, -ss), ...]
        _bridge_tail = ""     # 桥接模式的图尾钳制段（trim=start=sec:end=..），非桥接为空
        _bridge = False       # pts 桥接开关（仅素材时间轴 + 视频主文件 + sec>0 时为 True）
        _pre = 0.0            # 主输入 -ss 值（= 图头桥接量；out_mode 下不使用）
        _out_seek = 0.0       # out_mode 首段输入级 -ss（方向A）；0 = 不 seek（旧行为）
        _pv_plan = None       # 统一 Seek 模型计划（仅 out_mode 计算，供诊断留痕）
        # 下方仅在 bridge 分支内赋值；先给默认值，保证「诊断留痕」在非桥接场景也能取到
        # （否则取用时 NameError，会被 try/except 吞掉 → 临时文件整个不写 = 丢了线索）。
        _lim_pre = None       # 时长上限（pipe_dur → _dur → 无限源兜底）
        _remain = 0.0         # 图尾 trim 的窗口长度 = 上限 − sec
        if _out_mode:
            # 输出时间轴模式（串行合并）：图 = 多段 xfade 的成片时间轴。
            # 【方向A · 首段深 trim 提速（2026-10-13）】各段链自带**素材绝对** trim：
            #   · 首段（主输入 [0:v]）：输入级 -ss S0 + 该 trim 相对化 start=0(:end=E−S0)
            #     ⇒ 从关键帧直接开到 S0，不再从素材 0 空解（单段 76 分钟处起点 = 打开等到死）；
            #     输出内容与旧版逐帧一致（-ss 丢弃 [K,S0)，相对化后段链 pts 结构不变）。
            #   · 其余段（movie= 子输入）：逐子注入各自 trim 起点的 seek_point（纯解码跳过，
            #     零内容变化 —— md5 一致，见 _inject_movie_seek_point_per_sub）。
            #   相对化不成立（首段是图片 / 无绝对 trim）⇒ 不 seek，退回旧行为（零回归）。
            #   虚拟源主输入（color:/gen:）不可输入级 seek ⇒ 不相对化（其段无深 trim）。
            # 其余 seek 仍靠**输出侧裁剪**（末标签后 trim=start=sec）。
            _pipe_graph = self._pipe_graph
            _a7 = False          # A7：把「成片 back」吃进输入级 -ss（2026-10-14）
            if not _is_virtual_source(self.file):
                # 【A7 · 重新 seek 提速（2026-10-14，research/seek-model-v2）】
                # back>0 时优先把「成片 back」吃进输入级：`-ss (S0+back)` + 图头 setpts 加回
                # + 首段 trim **保持原值** + 图尾定位 trim **整个删掉** ⇒ O(1)
                # （用户工程实测：成片 3600 s 处 57 s → 0.7 s，输出帧 md5 一致）。
                # 守卫不通过（跨段 / 首段无绝对 trim / 段链无 setpts 归零）⇒ None ⇒ 退回现状。
                if _back > 1e-6:
                    _pg_a7, _ss_a7 = _pv_outmode_a7_seek(_pipe_graph, _back)
                    if _ss_a7 is not None:
                        # 【A7 同步修复】图尾「统一裁剪」被换成主输入单独 -ss 前移后，
                        # 并行 movie 子链必须**同样推进** back，否则主子不同步（2026-10-14）。
                        # 推不动（子链无起点 / 无归零）⇒ ok=False ⇒ 禁用 A7，退回同步但慢的现状。
                        _pg_a7, _ok_a7 = _pv_a7_advance_parallel_subs(_pg_a7, _back)
                        if _ok_a7:
                            _pipe_graph, _out_seek, _a7 = _pg_a7, _ss_a7, True
                if not _a7:
                    _pipe_graph, _out_seek = _pv_outmode_head_seek(_pipe_graph)
                if _out_seek > 0:
                    _pipe_graph = self._inject_movie_seek_point_per_sub(_pipe_graph)
            # 统一 Seek 模型（唯一决策源，research/seek-model）：本场景 = 成片时间轴。
            # A7 生效 ⇒ 手段纯 A（-ss 已含 back，无图尾定位 trim）；否则仍 A+C。
            # 锚点恒 = sec（红线 4，任何相对化不得改）；slow = 是否走「从头解码丢弃」（A7 ⇒ False）。
            _pv_plan = _pv_seek_plan("pipe_output", sec,
                                     {"s0": _out_seek, "pipe_start": _pstart, "a7": _a7})
            if _back > 1e-6:
                _t2 = _tail.replace("[pv_src]", "[pv_sk]", 1)
                # A7：输入已落在素材 S0+back ⇒ 图尾**只归零**、不再 trim（O(1)，不再从头解码）。
                _pipe_graph = (_pipe_graph
                               + (";[pv_src]setpts=PTS-STARTPTS[pv_sk]" if _a7 else
                                  ";[pv_src]trim=start=%.6f,setpts=PTS-STARTPTS[pv_sk]" % _back))
                _tail = _t2
        else:
            # 素材时间轴模式：图内视频 movie= 子输入跟随 seek（2026-09-20）—— 命令行 -ss 只管
            # 外部 -i 主输入，图内 movie= 完全不受影响，否则拖进度条后「主的画面跳了、子还在
            # 原地」→ 主播完子还在播（用户实测）。
            # ⚠️ 二次修正：优先把视频类 movie= **改写成外部 -i 输入**（子输入也走输入级 -ss =
            # 帧精确）；改不到的（图片 / 路径还原失败 / 标签撞车）才退回 seek_point 近似兜底。
            # ⚠️ 方案A 终版（2026-09-20，修「delogo/enable 在管道预览里时间提前」）：
            # 图内 enable/轨迹/画布等时间表达式按项目铁律写的是【0 基 from motion_trim_start
            # = pipe_start】（导出主链自带 setpts=PTS-STARTPTS 归零；外部 mpv/ffplay 预览天然
            # 满足——它们不吃管道桥接、主链同样归零，故时间表达式直接对齐，见 27776/28419
            # 铁律注释）。管道里必须把各路 pts 平移到同一「0 基 from pipe_start」，而非旧
            # 三次修正的「绝对素材时间」——后者会让 delogo/drawtext/overlay 的 enable 整体右偏
            # pipe_start 秒（用户实测：该遮的画面前移 pipe_start 秒 = 提前显示）。
            #   · 主输入 -ss pre（pre = sec − 2帧）→ 图头 [0:v]setpts=PTS+(pre−pipe_start)/TB
            #     （输入级 -ss 把 pts 归零到「0 基 from pre」，再 +(pre−pipe_start) 平移到
            #     「0 基 from pipe_start」= 与外部预览/时间表达式同一基准）；
            #   · color=c= 源（画布基/旋转水印载体，pts 从 0 起代表段起点）→ 0 基模型下与主
            #     输入同基准，无需桥接（旧 +pre/TB 反而令画布 overlay 配对悬空，故移除）；
            #   · 子输入 -ss 固定取 0（子素材从 0 解码，子链 trim=start=S_sub,setpts=PTS-
            #     STARTPTS 已归零到「0 基 from S_sub」），与 scrub 无关 → 子画面钉死正确素材
            #     位置（旧 三次修正取 back=sec−pipe_start 会让子素材整体平移 back−S_sub = 子
            #     seek 错位，用户实测拖条后子画面漂）；子链 STARTPTS 已归零，桥接量被吸收故
            #     _pb_sub 恒 None。
            #   时长钳制从输出 -t 改为图尾 trim（0 基：start=_back、end=_back+剩余），-t 按输出
            #   ts 计会被误截；fps/trim 均保时间线，实测证实。
            #   sec≈0（无截取且未 seek）时不注入任何桥接 = 与旧管道行为逐字节一致。
            _sec_s = "%.6f" % max(0.0, sec)
            _back_s = "%.6f" % _back
            _pre = max(0.0, sec - 2.0 / max(self._fps, 1.0))
            # 虚拟/生成源（color:/gen:）是 lavfi 生成流，无法输入级 -ss seek → 强制非桥接，
            # 改走输出侧 -ss post 定位（下方 not _bridge 分支）。
            _bridge = (not _is_static_image_file(self.file)) and (not _is_virtual_source(self.file)) and sec > 1e-6
            # 0 基模型（方案A 终版）：_pb_sub 恒 None（子链 STARTPTS 归零吸收桥接量）。
            _pb_sub = None
            _pipe_graph, _sub_inputs, _left = self._rewrite_movie_inputs(
                self._pipe_graph, _back, pts_bridge=_pb_sub)
            if _left:
                _pipe_graph = self._inject_movie_seek_point(
                    _pipe_graph, _back, pts_bridge=_pb_sub)
            if _sub_inputs:
                # 方案A 补完（2026-09-21）：子输入链里的「绝对 trim」同样要各自 seek ——
                # 否则子素材得从头解码到 S_sub（用户 4K 项目实测 221s）才产出第一帧，而
                # 它是 overlay 的一层 ⇒ 整个复合图停摆 ⇒ 永久「正在加载预览」。
                # 旧版靠「子链头注入 +sec/TB」把门限抵消掉 sec 秒来偷懒（78s 就出画面，
                # 但子画面内容错），0 基模型不能再用这种抵消 ⇒ 改成真 seek。
                _pg3, _sseek = self._split_sub_trims(
                    _pipe_graph, _back, list(range(1, len(_sub_inputs) + 1)))
                if _sseek:
                    _pipe_graph = _pg3
                    _sub_inputs = [(_p, _sseek.get(_k + 1, _ss))
                                   for (_k, (_p, _ss)) in enumerate(_sub_inputs)]
            if _bridge:
                # 方案A（2026-09-21）：多条 [0:v] 分支各自独立 seek —— 单输入 -ss 服务不了
                # 位于不同素材位置的分支（根因见 _split_zero_branches docstring）。
                # 分支 0 复用输入 0 ⇒ 用它的 -ss 覆盖 _pre（下方桥接量 = _pre−pipe_start
                # 随之自动正确）；其余分支生成额外 -i 输入。拆分失败 ⇒ _branch_inputs 为空
                # = 与旧行为逐字一致（退回桥接路径，零回归）。
                _pg2, _sp = self._split_zero_branches(
                    _pipe_graph, _back, 1 + len(_sub_inputs))
                if _sp:
                    _pipe_graph = _pg2
                    _branch_inputs = _sp[1:]
                    _pre = _sp[0][1]
                    # 防死锁钳制（2026-09-21）：分支 seek 绝不能越过素材末尾 —— 越界的分支
                    # **永远产不出任何一帧**，而它是 overlay 的一层 ⇒ 整个复合图等不到输入
                    # ⇒ 永久「正在加载预览」（用户实测 2K 项目「等到死都不出画面」）。
                    # 已知素材时长时把 seek 钳到「末尾前 0.5s」：内容可能落在末尾帧（若时间
                    # 模型本身还有偏差，画面会不准），但**保证一定有帧、绝不卡死**——卡死比
                    # 不准更糟。必须放在下方桥接量计算之前（桥接量 = _pre − pipe_start 自动
                    # 跟随，主链保持自洽）。
                    _dk = _opt_float(self._dur or 0.0, 0.0)
                    if _dk > 0:
                        _cap = max(0.0, _dk - 0.5)
                        if _pre > _cap:
                            _pre = _cap
                        _branch_inputs = [(_i, min(_s, _cap))
                                          for (_i, _s) in _branch_inputs]
            if _bridge:
                # 主输入桥接：[0:v] 可能被 split 多路消费 → 全部改挂到桥接链输出 [pv_m0]。
                # 偏移量 = pre − pipe_start：输入级 -ss pre 把图内 pts 归零到「0 基 from pre」，
                # 再 +(pre − pipe_start) 平移到「0 基 from pipe_start」= 与外部预览/时间表达式
                # 同一基准。旧 三次修正用 +pre/TB（绝对素材时间）会把 enable 整体右偏 pipe_start
                # → 该遮的画面前移 pipe_start 秒（用户实测「提前」）。
                _pre_tbase = _pre - _pstart
                _pre_tbase_s = "%.6f" % _pre_tbase
                _pipe_graph = ("[0:v]setpts=PTS+%s/TB[pv_m0];" % _pre_tbase_s
                               + _pipe_graph.replace("[0:v]", "[pv_m0]"))
                # 【bridge 修复 2026-10-14】self._pipe_graph 主视频段自带 setpts=PTS-STARPTS
                # （段内归零到「0 基 from pre」），会抵消上方 bridge 的 +(pre-pipe_start) 平移，
                # 使主视频基准停在「0 基 from pre」而非方案A 终版要求的「0 基 from pipe_start」，
                # 与子视频（外部 -i 桥接、停在 pipe_start 基准、无此 STARPTS）错位 back 秒
                # （用户实测重新 seek 主子不同步；外部分析报告已定位真因）。bridge 模式下删掉
                # 主视频段链的 STARPTS，使其与子视频同基准（净偏移 = 刻意的 2 帧补偿，符合
                # pre = sec - 2帧；back=0 打开态 STARPTS 无害，故仅 bridge 生效时处理）。
                # 只删主视频段（[pv_m0] 起）的「段内」STARPTS（后接逗号、后续仍有滤镜），
                # 不动图尾归零（后接 [label]，格式不同）。
                _pipe_graph = re.sub(r'(\[pv_m0\][^;]*?)setpts=PTS-STARPTS,',
                                     r'\1', _pipe_graph, count=1)
                # 注：color=c= 源桥接已移除——0 基模型下 color 从 PTS 0 起代表段起点，本就与主
                # 输入同基准，无需桥接；旧 +pre/TB 反而会令画布 overlay 配对悬空，故不再注入。
            _bridge_tail = ""
            if _bridge:
                # 时长上限先算好（图尾 trim 需要）：语义与旧 -t 一致（剩余可播时长），但 trim
                # 起点/终点按 0 基（_back / _back+剩余），因输出 pts 已是 0 基 from pipe_start。
                _lim_pre = None
                try:
                    if self._pipe_dur and float(self._pipe_dur) > 0:
                        _lim_pre = float(self._pipe_dur)
                except (TypeError, ValueError):
                    _lim_pre = None
                if _lim_pre is None and self._dur and self._dur > 0:
                    _lim_pre = float(self._dur)
                if _lim_pre is None and "=999999" in _pipe_graph:
                    _lim_pre = 3600.0   # 图内有无限源且时长未知 → 兜底防跑飞（关窗即 kill）
                if _lim_pre:
                    # ⚠️ 口径修正（2026-09-21 实测复现）：这里必须用 **_back**（0 基段内偏移），
                    # 不能减 sec（素材绝对秒）。_lim_pre 首选 self._pipe_dur = **成片时长**（0 基
                    # 长度，如 50s），而 sec 是素材绝对秒（如 205s）⇒ 两者相减恒为负 → 被
                    # max(0.5,…) 兜成 0.5s ⇒ 图尾 trim 窗口只剩 0.5 秒 ⇒ **预览出半秒帧就 EOF**
                    # （用户实测「画面一闪就没 / 加载不出来」）。非桥接路径的 -t 用的正是
                    # `_lim - _back`，此处保持同口径；_lim_pre 退化为素材总长时也只是放宽上限
                    # （上限偏大无害，偏小才会截断）。
                    _remain = max(0.5, _lim_pre - _back)
                    _bridge_tail = ("trim=start=%s:end=%.6f,setpts=PTS-STARTPTS,"
                                    % (_back_s, _back + _remain))
        if _bridge_tail:
            # 桥接模式：图尾钳制插在 fps 之后（fps/trim 均保时间线，实测 pts 走查证实），
            # 丢弃 seek 点前的 2 帧回退帧并封顶剩余时长（承担旧输出侧 -ss post + -t 的职责）
            _tail = _tail.replace("fps=%s,setsar=1" % _fps_s,
                                  "fps=%s,%ssetsar=1" % (_fps_s, _bridge_tail), 1)
        if self._pipe_alpha:
            # 透明指示棋盘底（2026-10-12）：垫一层 16px 棋盘，见 build_pipe_checker_underlay。
            # 必须卡在 setsar 之后、format=rgb24 之前（此刻尾链已含 bridge_tail，顺序天然正确）。
            _tail = _tail.replace(
                ",format=rgb24[pv_out]",
                "," + self.build_pipe_checker_underlay(self._vw, self._vh)
                + ",format=rgb24[pv_out]", 1)
        # 性能优化（2026-09-20 实测 4K 同文件「主+子」两段预览很卡）：
        #  · -probesize/-analyzeduration 缩减：本地已知文件无需全量探测，每次 spawn（含同文件
        #    两段各一次）启动更快；取值保守，避免 TS/MKV 误判流。
        # ⚠️ 已移除 -hwaccel auto（2026-09-21 实测为**负优化**，勿再加回）：
        #    本管道滤镜链 100% 是**软件滤镜**（setpts/trim/crop/overlay/delogo/scale/pad/
        #    format=rgb24），硬件解出的帧在显存里必须先 hwdownload 回内存才能进图，一来一回
        #    比直接软解更贵 —— 实测 320x240：带 0.44s / 不带 0.12s（慢 3.7 倍）；
        #    4K：带 1.08s / 不带 0.51s（慢 2 倍）。且 Windows 任务管理器通常**不把硬件解码
        #    计入 GPU 占用率**，表现就是「GPU 没动静、ffmpeg 还是 60% CPU」—— 那是滤镜在
        #    CPU 上跑，属预期，不是没生效。
        _probe_opts = ["-probesize", "500000", "-analyzeduration", "200000"]
        cmd = [self.ff, "-hide_banner", "-nostdin"] + _probe_opts
        if _is_static_image_file(self.file):
            # 静态图片：不能 seek，用 -loop 1 让单帧变成连续流（ffmpeg 管道里 -loop 1 有效，
            # 与 ffplay 下无效正好相反）；时长由输出侧 -t = pipe_duration(图片显示时长) 封顶。
            cmd.extend(["-loop", "1"] + _probe_opts + ["-i", self.file])
            # 图内视频 movie= 若已被改写成外部输入（图片主 + 视频水印等场景），同样必须补上
            # 这批 -i —— 否则图里引用的 [N:v] 标签没有对应输入，ffmpeg 直接报 Stream map 错。
            for (_p, _ss) in _sub_inputs:
                cmd.extend(["-ss", "%.6f" % _ss] + _probe_opts + ["-i", _p])
        elif _out_mode:
            # 输出时间轴模式：首段带深 trim 时给主输入加输入级 -ss（方向A，见上）；无则照旧不 seek
            # （图内绝对 trim 保持原样 = 旧行为逐字节一致）。
            # 2026-10-12：虚拟源（color:/gen:）不是磁盘文件 —— `-i <哨兵>` 只会得到「打不开」。
            # 与下方素材时间轴分支同款换 `-f lavfi -i <spec>`：lavfi 流本来就不可输入级 seek，
            # 而本分支恰恰不 seek（定位靠图尾 trim），语义天然吻合。串行合并首轨为颜色/图案源
            # 走的就是这条（此前被上游门控挡掉，见 merge_preview_concat_lavfi 的 pipe_engine 分支）。
            if _is_virtual_source(self.file):
                cmd.extend(_probe_opts + ["-f", "lavfi", "-i",
                                          _virtual_lavfi_spec(self.file)])
            elif _out_seek > 0:
                cmd.extend(["-ss", "%.6f" % _out_seek] + _probe_opts + ["-i", self.file])
            else:
                cmd.extend(_probe_opts + ["-i", self.file])
        else:
            pre = _pre
            if _is_virtual_source(self.file):
                # 虚拟源（color:/gen:）：lavfi 生成流，输入级 -ss 无意义；主输入换
                # `-f lavfi -i <spec>`，定位交给下方 not _bridge 分支的输出侧 -ss post。
                cmd.extend(_probe_opts + ["-f", "lavfi", "-i", _virtual_lavfi_spec(self.file)])
            else:
                cmd.extend(["-ss", "%.6f" % pre] + _probe_opts + ["-i", self.file])
            # 子输入（原图内 movie=）各带一份 -ss：0 基模型下固定取 0（子素材从 0 解码，
            # 子链自带 trim=start=S_sub+STARTPTS 归零，与 scrub 无关，见 _rewrite_movie_inputs）。
            for (_p, _ss) in _sub_inputs:
                cmd.extend(["-ss", "%.6f" % _ss] + _probe_opts + ["-i", _p])
            # 方案A 拆出来的分支输入：与主输入同一文件，各带自己的 -ss(=X_k+T)，
            # 每条分支只解码自己那几帧 ⇒ 不再从 seek 点向前空解 X_k 秒（4K 秒开）。
            for (_bi, _bss) in _branch_inputs:
                cmd.extend(["-ss", "%.6f" % _bss] + _probe_opts + ["-i", self.file])
            if not _bridge:
                # 旧两段式精定位：输出侧 -ss post 丢弃 2 帧回退。桥接模式下输出侧 -ss 会
                # 撞上素材口径 pts（全部被误丢）→ 改由图尾 trim=start=sec 承担同样的丢弃。
                post = max(0.0, sec - pre)
                cmd.extend(["-ss", "%.6f" % post])
        cmd.extend(["-filter_complex", _pipe_graph + ";" + _tail,
                    "-map", "[pv_out]"])
        # 输出级时长上限（必须在输出文件名 pipe:1 之前）；seek 后按剩余时长收敛。
        # 桥接模式已改用图尾 trim=end 钳制（pts 是素材口径，-t 会误截），跳过 -t。
        _lim = None
        if not _bridge:
            try:
                if self._pipe_dur and float(self._pipe_dur) > 0:
                    _lim = float(self._pipe_dur)
            except (TypeError, ValueError):
                _lim = None
            if _lim is None and self._dur and self._dur > 0:
                _lim = float(self._dur)
            if _lim is None and "=999999" in _pipe_graph:
                _lim = 3600.0      # 图内有无限源且时长未知 → 兜底防跑飞（用户关窗即 kill）
            if _lim:
                _lim = max(0.5, _lim - _back)
                cmd.extend(["-t", "%.6f" % _lim])
        cmd.extend(["-an", "-sn", "-f", "rawvideo", "-pix_fmt", "rgb24", "pipe:1"])
        # ── 诊断留痕（2026-09-21）───────────────────────────────────────────────
        # 管道 ffmpeg 的 stderr 走 DEVNULL：一旦图/seek 有问题，ffmpeg 立即退出而我们
        # 一条线索都没有，表现就是「正在加载预览」永久卡住（用户实测 4K/2K 项目）。
        # 故每次 spawn 把【完整命令 + 关键时间量】写进主界面右上「关键信息」日志 ——
        # 与其它预览工具（mpv / ffplay 回退）的 `执行命令: …` 落在同一处、同一口径：
        #   · 命令是一整行，可直接在日志框里选中复制进 cmd 复跑；
        #   · 时间量（sec/pipe_start/back/pre/各分支 seek/时长上限）是判「时间轴对不对」
        #     的核心依据 —— 用户多次反馈「管道引擎看不到命令、没法验证时间」。
        # ⚠️ 2026-09-21 用户要求：**不再落盘** %TEMP%\kli_pipe_cmd.txt（"保存到文件里不好"）。
        # 同一组参数只记一次（_pipe_diag_last 去重）：循环预览 / 重复 seek 不刷屏。
        # 诊断脚本要原始明细可自带落盘，程序端不给文件。
        # 需要 ffmpeg 报错原文时：在 %TEMP% 放一个空文件 kli_pipe_debug.on，stderr 即
        # 改写到 %TEMP%\kli_pipe_err.txt（默认仍 DEVNULL，避免进度行把文件撑爆）。
        try:
            # 2026-10-13：补「预览窗侧」状态 —— 进度条不对时，要在**同一行**里同时看到
            # 「本次命令的 sec」与「预览窗此刻的位置真源」，才能分清是命令层还是 UI 锚点。
            # ⚠️ 这里的 prev_anchor 是**上一次** seek 落下的锚点（_run_video 在
            # _launch_video_pipe 返回**之后**才覆盖它）⇒ 若它恒 0 而 sec>0，即「拖完锚点没跟上」。
            # 只读普通属性（无 Tk 调用）⇒ worker 线程安全。
            _diag = (_("[管道预览] sec=%.6f pipe_start=%.6f back=%.6f pre=%.6f out_seek=%.6f "
                     "bridge=%s out_mode=%s | plan=%s slow=%s anchor=%.6f | "
                     "sub=%s branch=%s | lim_pre=%s remain=%s dur=%s pipe_dur=%s "
                     "| win: prev_anchor=%.6f cur_us=%.6f fps=%.6f has_v=%.0f audio=%s")
                     % (sec, _pstart, _back, _pre, _out_seek, _bridge, _out_mode,
                        (_pv_plan.mode if _pv_plan else "-"),
                        (_pv_plan.slow if _pv_plan else "-"),
                        (_pv_plan.anchor if _pv_plan else sec),
                        _sub_inputs, _branch_inputs,
                        _lim_pre, _remain, self._dur, self._pipe_dur,
                        float(self._v_anchor or 0.0), float(self._current_us or 0) / 1e6,
                        float(self._fps or 0.0), 1.0 if self.has_video else 0.0,
                        bool(getattr(self, "_pipe_out_mode", False))))
            if _diag != getattr(self, "_pipe_diag_last", None):
                self._pipe_diag_last = _diag
                if self._app is not None:
                    self._app._append_info_ui(_diag)
                    self._app._append_info_ui(
                        _("[管道预览] 执行命令: ") + format_cmd_for_display(cmd))
                    if _pv_plan is not None and _pv_plan.slow:
                        # 统一模型把「这条定位会很慢」显式标出 → 不再像卡死/坏掉（用户实测困惑点）
                        self._app._append_info_ui(
                            _("[管道预览] ⏳ 本次是成片时间轴定位，须从头解码丢弃到目标点"
                              "（目标越大越久）—— 慢路径，非卡死；根因见统一 Seek 模型 §6。"))
        except Exception:
            pass
        _td = ""
        try:
            _td = tempfile.gettempdir()
        except Exception:
            _td = ""
        _err = subprocess.DEVNULL
        if _td and os.path.exists(os.path.join(_td, "kli_pipe_debug.on")):
            try:
                _err = open(os.path.join(_td, "kli_pipe_err.txt"), "wb")
            except Exception:
                _err = subprocess.DEVNULL
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                 stderr=_err, creationflags=flags)
        except Exception:
            return None
        return p

    def _v_stop_proc(self):
        """kill 当前 ffmpeg + 清空缓冲 + 递增代际（防孤儿/防旧帧串入）。"""
        self._v_gen += 1
        with self._v_lock:
            self._v_frames.clear()
        p = self._v_proc
        self._v_proc = None
        if p is not None and p.poll() is None:
            with suppress(Exception):
                p.kill()

    def _pump(self):
        """主线程取帧（_AV_PUMP_MS 周期）：按墙钟节奏显示，位置=anchor+已显示帧号/fps。
        解码落后则等（画面卡但位置与画面严格一致），领先则丢帧追赶——这就是「丝滑」的
        来源：显示的每一帧都与位置严格对应，绝不出现「位置走了画面没走」。"""
        if self._stop:
            return
        try:
            if not self.win.winfo_exists():
                return
        except Exception:
            return
        if self.has_video and not self._audio_mode:
            now = time.perf_counter()
            target = None
            dropped = 0
            with self._v_lock:
                fr = self._v_frames
                if fr:
                    if not self._playing:
                        # 暂停态：立即消化（步进/定位只读一帧），取最新那帧即可
                        target = fr[-1]
                        fr.clear()
                    elif self._v_wall0 is None:
                        # 首帧到达 → 建立节奏基准（此后按墙钟排帧）。
                        # 队首不是第 0 帧 = 旧进程残帧（kill 与 append 的竞态窗）→ 整批丢弃。
                        if fr[0][0] == 0:
                            target = fr.popleft()
                        else:
                            fr.clear()
                    else:
                        expect = int((now - self._v_wall0) * self._fps)
                        if expect < 0:
                            expect = 0
                        while fr and fr[0][0] <= expect:
                            if target is not None:
                                dropped += 1      # 解码跟不上 → 丢帧追赶
                            target = fr.popleft()
            if target is not None:
                idx, data = target
                if self._playing and self._v_wall0 is None:
                    self._v_wall0 = now
                self._v_drop += dropped
                self._v_shown_idx = idx
                self._show_frame(data)
                self._v_pos = self._v_anchor + idx / self._fps
                self._current_us = int(self._v_pos * 1e6)
                if self._playing:
                    self._nudge_accum = None  # 播放中新帧已显示 → 位置重新成为微调基准
                self._v_fps_n += 1
                if self._v_fps_t0 is None:
                    self._v_fps_t0 = now
                elif now - self._v_fps_t0 >= 1.0:
                    self._v_shown_fps = self._v_fps_n / (now - self._v_fps_t0)
                    self._v_fps_t0 = now
                    self._v_fps_n = 0
                if self._a_pending is not None:
                    # 画面首帧已到位 → 此刻启动音频（目标 + 启动延迟补偿）
                    tgt = self._a_pending
                    self._a_pending = None
                    self._a_start(tgt + self.latency)
        elif not self.has_video and self._playing and not self._audio_mode:
            # 纯音频文件（未切音频模式前）：位置靠墙钟推进
            if self._v_wall0 is None:
                self._v_wall0 = time.perf_counter()
            self._v_pos = self._v_anchor + (time.perf_counter() - self._v_wall0)
            self._current_us = int(self._v_pos * 1e6)
        self._pump_job = self.win.after(_AV_PUMP_MS, self._pump)

    def _show_frame(self, rgb):
        """主线程显示帧（PPM→PhotoImage 原地换数据，避免每帧新建 Tcl 对象）。"""
        try:
            self._last_rgb = rgb
            if self._ppm_header is None:
                # PPM 头只跟 _vw/_vh 有关（探测后固定），缓存复用
                self._ppm_header = b"P6\n%d %d\n255\n" % (self._vw, self._vh)
            ppm = self._ppm_header + rgb
            if self._img is None:
                self._img = tk.PhotoImage(data=ppm)
                self.canvas.config(image=self._img, text="")
            else:
                self._img.configure(data=ppm)
        except Exception:
            pass

    # ---------- 主线程 UI 更新 ----------
    def _ui_tick(self):
        with suppress(Exception):
            self._update_playhead()  # 播放头随播放位置移动（轻量，不重绘整条）
        try:
            self.time_label.config(text=_format_preview_time(self._current_us / 1e6))
            if self.disp_time_label is not None:
                _disp = (self._current_us / 1e6 - self.trim_start) / self.speed_factor
                if _disp < 0:
                    _disp = 0.0
                self.disp_time_label.config(text=_("成片 ") + _format_preview_time(_disp))
            if self._dur and not self._seek_after:
                # 播放中进度条跟随 100ms 节流：每帧 scale.set 会触发 ttk.Scale 重绘，
                # 成本常比 PhotoImage 还高；暂停/步进/拖动不节流（定位要即时精确，
                # 拖动路径已被 _updating_scale 挡掉自身回调，不会自我 seek 循环）。
                now = time.time()
                if self._playing and now - self._last_scale_tick < 0.1:
                    return
                t = self._current_us / 1e6
                v = float(self.scale.get())
                if abs(v - t) > 0.1:
                    self._updating_scale = True
                    try:
                        self.scale.set(t)  # 播放中进度条跟随（拖动时不抢）
                    finally:
                        self._updating_scale = False
                    self._last_scale_tick = now
            # 循环预览：到段尾回跳段首（循环内部 seek，不退出循环）；冷却防重复触发
            if (self._loop_active and self._playing and self._v_target is None
                    and (time.time() - self._loop_cooldown) > 0.15):
                t = self._current_us / 1e6
                if t >= self._loop_e - 0.03:
                    self._loop_cooldown = time.time()
                    self._loop_seek_pending = True
                    self._request_seek(self._loop_s)
                    self._loop_seek_pending = False
        except Exception:
            pass

    # ---------- 回填（2026-08-25：不关闭窗口，可连续设置起点/终点） ----------
    def _set_start(self):
        t = self._current_us / 1e6
        if self.on_set_start:
            self.on_set_start(t)
        self.status_label.config(text=_("✓ 起点已设 {0}（可继续设终点，完成后关闭窗口）").format(_format_preview_time(t)))

    def _goto_end(self):
        """跳到文件真正末尾：把位置直接置为 ffprobe 取得的真 _dur，用于『设为终点 /
        重标记终点』一键拿到完整文件结尾，不必再手动补时。显示帧不动，不改动既有
        0.5 秒 seek 余量（稳定性优先）。"""
        if not self._dur:
            return
        self._loop_active = False
        self._playing = False
        if getattr(self, "btn_play", None) is not None:
            with suppress(Exception):
                self.btn_play.config(text=_("播放"))
        self._at_eof = True
        self._v_pos = self._dur
        self._current_us = int(self._dur * 1e6)
        self._nudge_accum = None
        self._ui_tick()

    def _set_end(self):
        t = self._current_us / 1e6
        if self.on_set_end:
            self.on_set_end(t)
        self.status_label.config(text=_("✓ 终点已设 {0}（可继续设起点，完成后关闭窗口）").format(_format_preview_time(t)))

    # ---------- 选中标记段的端点改写（2026-09-15） ----------
    # 与 _set_start/_set_end 的区别：那两个回填给「调用方」（主界面的起止框），
    # 这两个直接改写「本窗口已打好的某一段」，是两回事，不要互相复用。
    def _remark_target(self):
        """取「当前选中标记段」的索引；不可用时写状态行并返回 None。"""
        idx = self._selected_seg
        if idx is None or not self._marks or idx >= len(self._marks):
            self.status_label.config(text=_("请先在下方段落条上点某个段的起点三角，选中要改的标记段"))
            return None
        return idx

    def _remark_start(self):
        """把当前播放位置写入选中标记段的起点（终点不动）。"""
        idx = self._remark_target()
        if idx is None:
            return
        t = self._current_us / 1e6
        _s, e = self._marks[idx]
        if t >= e:
            self.status_label.config(
                text=_('✗ {0} 不早于本段终点 {1}，未改动').format(_format_preview_time(t), _format_preview_time(e)))
            return
        self._marks[idx] = (t, e)
        self.mark_start_var.set(_format_preview_time(t))
        self._draw_segments()
        self._notify_mark_edit(idx)
        self.status_label.config(
            text=_('✓ 第 {0} 段起点已改为 {1}（终点 {2} 未动）').format(idx + 1, _format_preview_time(t), _format_preview_time(e)))

    def _remark_end(self):
        """把当前播放位置写入选中标记段的终点（起点不动）。"""
        idx = self._remark_target()
        if idx is None:
            return
        t = self._current_us / 1e6
        s, _e = self._marks[idx]
        if t <= s:
            self.status_label.config(
                text=_('✗ {0} 不晚于本段起点 {1}，未改动').format(_format_preview_time(t), _format_preview_time(s)))
            return
        self._marks[idx] = (s, t)
        self.mark_end_var.set(_format_preview_time(t))
        self._draw_segments()
        self._notify_mark_edit(idx)
        self.status_label.config(
            text=_('✓ 第 {0} 段终点已改为 {1}（起点 {2} 未动）').format(idx + 1, _format_preview_time(t), _format_preview_time(s)))

    def _apply_mark_entry(self, which):
        """两个端点框直接改数字后回车生效（which='start' / 'end'）。"""
        idx = self._remark_target()
        if idx is None:
            return
        raw = (self.mark_start_var.get() if which == "start" else self.mark_end_var.get()).strip()
        val = time_to_seconds(raw)
        if val is None:
            self.status_label.config(text=_('✗ 时间格式无效：{0}').format(raw))
            return
        s, e = self._marks[idx]
        if which == "start":
            if val >= e:
                self.status_label.config(text=_('✗ 起点需早于本段终点 {0}，未改动').format(_format_preview_time(e)))
                return
            self._marks[idx] = (val, e)
        else:
            if val <= s:
                self.status_label.config(text=_('✗ 终点需晚于本段起点 {0}，未改动').format(_format_preview_time(s)))
                return
            self._marks[idx] = (s, val)
        self._draw_segments()
        self._notify_mark_edit(idx)
        self.status_label.config(
            text=_('✓ 第 {0} 段{1}已改为 {2}').format(idx + 1, _('起点') if which == 'start' else _('终点'), _format_preview_time(val)))

    def _notify_mark_edit(self, idx):
        """段端点被改写后：若该段映射到来源轨迹行，回调通知回写原行（行号贯穿）。

        idx 越界 / 无映射（None）/ 未提供回调 → 静默返回（旧调用方零行为变化）。"""
        if self._on_mark_edit is None:
            return
        if idx is None or idx < 0 or idx >= len(self._marks):
            return
        row = self._mark_rows[idx] if idx < len(self._mark_rows) else None
        if row is None:
            return
        s, e = self._marks[idx]
        with suppress(Exception):
            self._on_mark_edit(row, s, e)

    def _sync_mark_entries(self):
        """把选中标记段的起止同步进两个端点框（由 _draw_segments 收口调用）。

        守卫：焦点正落在两个框里时不覆盖 —— 否则用户手改数字会被自己的输入冲掉。
        """
        try:
            if not hasattr(self, "mark_start_var"):
                return
            idx = self._selected_seg
            total = len(self._marks)
            sel_ok = idx is not None and 0 <= idx < total
            # 标题先更新：它说的是「这组控件作用在谁身上」，必须始终准确，不受输入焦点影响。
            # 扁平 Label（非 LabelFrame）动态改文字，用 config(text=...) 手动刷新。
            self._mark_frame.config(
                text=(_("标记端点微调 ● 第 {0}/{1} 段").format(idx + 1, total) if sel_ok
                      else _("标记端点微调（未选中段）")))
            # 两个输入框：焦点正落在里面时不覆盖 —— 否则用户手改数字会被自己的输入冲掉
            try:
                foc = self.win.focus_get()
            except Exception:
                foc = None
            if foc is not None and foc in (self.mark_start_entry, self.mark_end_entry):
                return
            if not sel_ok:
                self.mark_start_var.set("")
                self.mark_end_var.set("")
                return
            s, e = self._marks[idx]
            self.mark_start_var.set(_format_preview_time(s))
            self.mark_end_var.set(_format_preview_time(e))
        except Exception:
            pass

    def _pipe_frame_clean(self, sec, timeout=20.0):
        """为「导出当前帧」重渲一帧**不带透明棋盘**的 rgb24 字节；失败返回 None。

        管道开启 pipe_alpha 后 `_last_rgb` 是垫过格子的帧（棋盘是**画**上去的，字节里扒不掉）
        ⇒ 直接编码会把假格子烤进 PNG。故按当前时刻把 `self._pipe_alpha` 临时关掉重跑一次
        （research/pipe-preview-alpha §5.2），只读 1 帧就 kill。
        ⚠️ `self._pipe_alpha` 必须在 launch 返回后立刻还原 —— 线程只有 UI 线程会来这里，
        但省不了：万一 launch 抛异常，状态会永久停在 False（预览突然没棋盘）。
        """
        _fb = self._frame_bytes
        if _fb <= 0:
            return None
        _old = self._pipe_alpha
        self._pipe_alpha = False
        try:
            _p = self._launch_video_pipe(sec, _ffmpeg_spawn_flags())
        finally:
            self._pipe_alpha = _old
        if _p is None:
            return None
        # stdout.read 在 ffmpeg 迟迟不出帧时会永久阻塞（seek 慢的图可能几秒~几十秒）⇒
        # 放到线程里读、主线程 join(timeout)，超时 kill —— 不能让用户点在导出上卡死 UI。
        _box = []
        _t = threading.Thread(target=lambda: _box.append(_p.stdout.read(_fb)), daemon=True)
        _t.start()
        _t.join(timeout)
        with suppress(Exception):
            _p.kill()
        return _box[0] if (_box and len(_box[0]) == _fb) else None

    def save_current_frame_png(self):
        """导出当前预览帧为 PNG：用 ffmpeg 把已解码的 raw rgb24 字节编码，免 PIL 依赖。

        2026-10-12：开了透明指示（pipe_alpha）时 `_last_rgb` 带棋盘格 ⇒ 改为重渲一帧干净帧
        （见 `_pipe_frame_clean`），保证导出物不带假格子。
        """
        if alert_if(self._last_rgb is None, _("提示"), _("尚未加载画面，无法导出")):
            return
        if alert_if(not self.ff, _("错误"), _("未找到 ffmpeg，无法导出 PNG"), 'error'):
            return
        _rgb = self._last_rgb
        if self._pipe_alpha:
            _clean = self._pipe_frame_clean(self._current_us / 1e6)
            if _clean is None:
                messagebox.showerror(
                    _("导出失败"), _("干净帧重渲失败，已取消导出\n（避免把透明指示格子烤进 PNG）"))
                return
            _rgb = _clean
        from tkinter import filedialog
        base = os.path.splitext(os.path.basename(self.file))[0]
        ms = int(self._current_us / 1000)
        initial = f"{base}_{ms}ms.png"
        path = filedialog.asksaveasfilename(
            title=_("导出当前帧"),
            defaultextension=".png",
            filetypes=[(_("PNG 图片"), "*.png"), (_("所有文件"), "*.*")],
            initialfile=initial)
        if not path:
            return
        cmd = [self.ff, "-f", "rawvideo", "-pix_fmt", "rgb24",
               "-s", f"{self._vw}x{self._vh}", "-i", "-",
               "-frames:v", "1", "-y", path]
        try:
            subprocess.run(cmd, input=_rgb, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=30)
            messagebox.showinfo(_("已导出"), _('当前帧已保存：\n{0}').format(path))
        except Exception as e:
            messagebox.showerror(_("导出失败"), _('无法导出 PNG：\n{0}').format(e))

    def pipe_current_time(self):
        """当前预览的**素材时刻**（秒）；非管道合成模式返回 None（#5，2026-10-08）。

        列表轨迹面板「坐标」改完要重开本管道回原时间点，用它取回当前时刻。
        非管道（普通简易预览）没有重开语义 ⇒ None，调用方可据此跳过。
        """
        if not self._pipe_graph:
            return None
        with suppress(Exception):
            return self._current_us / 1e6
        return None

    def close(self):
        self._stop = True
        self._v_stop_proc()
        self._a_kill()
        self._wave_token += 1  # 作废进行中的波形生成
        # 杀掉在跑的 ffprobe（大文件关键帧扫描/元数据探测可能比窗口寿命长）
        with suppress(Exception):
            if self._kf_proc is not None:
                self._kf_proc.kill()
        for _p in list(self._probe_sink):
            with suppress(Exception):
                _p.kill()
        for _job in (self._poll_job, self._pump_job, self._seek_after,
                     self._track_seek_after, self._a_seek_job, self._vol_job):
            if _job is not None:
                with suppress(Exception):
                    self.win.after_cancel(_job)
        self._poll_job = None
        self._pump_job = None
        with suppress(Exception):
            if getattr(self, "_av_popup", None) and self._av_popup.winfo_exists():
                self._av_popup.destroy()
        with suppress(Exception):
            self.win.destroy()



# ================== 区域可视化编辑器（delogo / 遮罩独立选区） ==================
class RectSelectEditor:
    """统一矩形选区编辑器。

    实现借 FFmpegBatchGUI.open_crop_editor（同一套富 UI）。裁剪语境传完整参数；
    delogo / 局部滤镜语境只取坐标（show_simple_pos/show_black_border 关掉、
    safe_border 留边、helper_rect 显示裁剪辅助框）。
    """
    def __init__(self, app, file_path, x_var, y_var, w_var, h_var,
                 frame_extractor=None, helper_rect=None, helper_label=None,
                 safe_border=False, title=None, on_apply=None,
                 initial_time_override=None, show_simple_pos=False, simple_pos_cb=None,
                 show_black_border=False, black_border_cb=None,
                 allow_alt_move=True, preload_points=None,
                 apply_label=None, clear_label=None, info_extra=None, modal=False):
        # 默认文案调用时求值：写进签名默认参数会在模块导入时被求值一次，
        # 那时 load_language() 尚未执行 → 固化中文（2026-10-17 i18n 修复）
        if helper_label is None:
            helper_label = _("裁剪框")
        if apply_label is None:
            apply_label = _("应用")
        if clear_label is None:
            clear_label = _("清除选区")
        self.app = app
        if frame_extractor is None:
            frame_extractor = getattr(app, "extract_video_frame_scaled", None)
        # open_crop_editor 是定义在 VideoFilterFrame 上的富方法（依赖 self.crop_* 等
        # 滤镜帧自身属性）；传入的 app 若是 FFmpegBatchGUI（无此方法），
        # 回退到主转换页 filter frame（app.video_filter）。
        host = app
        if not hasattr(host, "open_crop_editor"):
            _vf = getattr(app, "video_filter", None)
            if _vf is not None and hasattr(_vf, "open_crop_editor"):
                host = _vf
        host.open_crop_editor(
            file_path=file_path, x_var=x_var, y_var=y_var, w_var=w_var, h_var=h_var,
            frame_extractor=frame_extractor, helper_rect=helper_rect, helper_label=helper_label,
            safe_border=safe_border, title=title, on_apply=on_apply,
            initial_time_override=initial_time_override, show_simple_pos=show_simple_pos,
            simple_pos_cb=simple_pos_cb, show_black_border=show_black_border,
            black_border_cb=black_border_cb, allow_alt_move=allow_alt_move,
            preload_points=preload_points, apply_label=apply_label, clear_label=clear_label,
            info_extra=info_extra, modal=modal,
        )


class LoopChromaFrame(ttk.LabelFrame):
    """循环播放与绿幕抠像设置组件 - 左右并排（grid布局）"""
    def __init__(self, master, filt_frame=None, page_scope="merge",
                 main_video_mode=False, compact_layout=False, **kwargs):
        self.compact_layout = bool(compact_layout)
        # 2026-10-12：compact_layout（转换页绿幕页专用）下，去掉外层「循环/绿幕控制」大框，
        # 循环块不显示，左列两行（透明度 / 描边+遮罩）、右列绿幕抠像，无时间预览/音频控件。
        if compact_layout:
            try:
                ttk.Style().configure("KliChromaCompact.TLabelFrame", relief="flat", borderwidth=0)
                super().__init__(master, text="", style="KliChromaCompact.TLabelFrame", padding="0", **kwargs)
            except Exception:
                super().__init__(master, text="", padding="0", **kwargs)
        else:
            super().__init__(master, text=_("循环/绿幕控制"), padding="5", **kwargs)
        self.filt_frame = filt_frame
        # 2026-10-09：主视频模式。主视频现在也开放本面板（绿幕抠像 → 可导出透明素材），
        # 但主视频是时间轴基准：左列「循环播放」与子视频专属的「音频模式」「简易时间预览」
        # 对主视频无意义 → 构造末尾递归置灰（见 __init__ 尾）。绿幕/透明度/遮罩/描边保持可用。
        self.main_video_mode = bool(main_video_mode)
        # 2026-09-23：主视频作用域（'merge'=封装页 / 'convert'=转换页水印编辑器）。
        # edit_video_settings 三处调用方（封装页轨道/转换页水印/队列任务）都会实例化本组件，
        # 遮罩可视化/轨迹弹窗的次级兜底帧按此作用域取「本页自己的主视频」，两页不互相兜底。
        self.page_scope = page_scope or "merge"
        # 控件构建已内联在下方（历史残留的 _create_widgets 调用无定义，已移除）
        # 使用 grid 布局，将窗口分为左右两列，权重相等
        self.columnconfigure(0, weight=1)
        self.columnconfigure(1, weight=1)

        # ----- 左侧：循环播放（列0） -----
        loop_frame = ttk.LabelFrame(self, text=_("循环播放"), padding="2")
        # compact_layout 下循环块不显示（变量仍随下方代码创建，供 get/set_settings 使用）
        if not compact_layout:
            loop_frame.grid(row=0, column=0, sticky="nsew", padx=(0, 2))
        loop_frame.columnconfigure(0, weight=1)

        self.loop_enabled = tk.BooleanVar(value=False)
        chk = ttk.Checkbutton(loop_frame, text=_("启用循环控制 (不启用=无限循环)"), variable=self.loop_enabled)
        chk.grid(row=0, column=0, sticky="w", pady=(0,3))
        ToolTip(chk, 
                _("勾选后可设置显示次数或仅显示一次。\n"
                "注意：图片文件时长就1帧，若选择“一次”会导致瞬间消失，\n"
                "您可复制生成的命令，手动修改 enable 表达式中的时间值以达到预期效果。"),
                wraplength=500)

        # 次数控制区域（始终显示，但默认禁用）
        self.count_frame = ttk.Frame(loop_frame)
        self.count_frame.grid(row=1, column=0, sticky="w", padx=10, pady=2)

        ttk.Label(self.count_frame, text=_("显示次数:")).pack(side=tk.LEFT)
        self.loop_count = tk.IntVar(value=3)
        self.count_spinbox = ttk.Spinbox(
            self.count_frame,
            from_=1, to=100,
            width=5,
            textvariable=self.loop_count,
            state="readonly"  # 初始为禁用（但实际禁用应设为 "disabled"）
        )
        # 初始禁用
        self.count_spinbox.config(state="disabled")
        self.count_spinbox.pack(side=tk.LEFT, padx=5)
        ttk.Label(self.count_frame, text=_("次")).pack(side=tk.LEFT)

        # 时长显示标签
        self.duration_label = ttk.Label(loop_frame, text="", foreground="gray")
        self.duration_label.grid(row=2, column=0, sticky="w", padx=10, pady=0)

        # ---- 显示时段 / 循环显示（enable 控制，与次数控制 AND 叠加）----
        self.show_start_var = tk.StringVar(value="")
        self.show_end_var = tk.StringVar(value="")
        self.show_cycle_var = tk.StringVar(value="")
        self.show_once_var = tk.StringVar(value="")

        seg_row = ttk.Frame(loop_frame)
        seg_row.grid(row=3, column=0, sticky="w", padx=10, pady=(2, 0))
        ttk.Label(seg_row, text=_("显示:")).pack(side=tk.LEFT)
        _lbltt25 = ttk.Label(seg_row, text=_("起始"))
        _lbltt25.pack(side=tk.LEFT, padx=(4, 1))
        es_entry = ttk.Entry(seg_row, textvariable=self.show_start_var, width=7)
        es_entry.pack(side=tk.LEFT, padx=(0, 2))
        ToolTip(_lbltt25,
                _("显示时段 - 起始时间（秒或 HH:MM:SS）：从该时刻起水印可见。\n"
                "与「结束」配合生成 enable='between(t,起始,结束)'；只填起始=gte(t,起始)。\n"
                "与循环次数/循环显示为叠加关系（AND），互不影响。"))
        _lbltt26 = ttk.Label(seg_row, text=_("结束"))
        _lbltt26.pack(side=tk.LEFT, padx=(4, 1))
        ee_entry = ttk.Entry(seg_row, textvariable=self.show_end_var, width=7)
        ee_entry.pack(side=tk.LEFT, padx=(0, 2))
        ToolTip(_lbltt26,
                _("显示时段 - 结束时间（秒或 HH:MM:SS）：到该时刻水印消失。\n"
                "只填结束=lte(t,结束)；起始/结束都填=between(t,起始,结束)。\n"
                "时段外画面完全隐藏（overlay 不渲染，非黑场/定格）。"))

        cyc_row = ttk.Frame(loop_frame)
        cyc_row.grid(row=4, column=0, sticky="w", padx=10, pady=(2, 0))
        ttk.Label(cyc_row, text=_("循环:")).pack(side=tk.LEFT)
        _lbltt27 = ttk.Label(cyc_row, text=_("周期"))
        _lbltt27.pack(side=tk.LEFT, padx=(4, 1))
        ec_entry = ttk.Entry(cyc_row, textvariable=self.show_cycle_var, width=7)
        ec_entry.pack(side=tk.LEFT, padx=(0, 2))
        ToolTip(_lbltt27,
                _("循环显示 - 周期（秒）：每隔该时长重复一次显示（enable='lt(mod(t,周期),单次)'）。\n"
                "需配合「单次」使用；周期须 ≥ 单次，否则画面一直显示。"))
        _lbltt28 = ttk.Label(cyc_row, text=_("单次"))
        _lbltt28.pack(side=tk.LEFT, padx=(4, 1))
        eo_entry = ttk.Entry(cyc_row, textvariable=self.show_once_var, width=7)
        eo_entry.pack(side=tk.LEFT, padx=(0, 2))
        ToolTip(_lbltt28,
                _("循环显示 - 单次显示时长（秒）：每个周期内仅显示前这么多秒。\n"
                "例：周 3 单 1 → 显示 1 秒、隐藏 2 秒，循环闪烁。\n"
                "间隔期完全隐藏（overlay 不渲染），非黑场/定格。"))

        # 初始化 loop_mode
        self.loop_mode = tk.StringVar(value="infinite")

        # 绑定事件
        def on_loop_enabled_changed(*args):
            if self.loop_enabled.get():
                # 启用循环 → 次数输入可修改，loop_mode 设为 count
                self.count_spinbox.config(state="readonly")
                self.loop_mode.set("count")
            else:
                # 未启用 → 次数输入禁用，loop_mode 设为 infinite
                self.count_spinbox.config(state="disabled")
                self.loop_mode.set("infinite")
        self.loop_enabled.trace_add("write", on_loop_enabled_changed)

        # ----- 右侧：绿幕抠像（列1） -----
        chroma_frame = ttk.LabelFrame(self, text=_("绿幕抠像 (色度键)"), padding="2")
