        _pw = tk.IntVar(value=self.preview_max_w.get())
        _ph = tk.IntVar(value=self.preview_max_h.get())
        _ft = tk.IntVar(value=self.ffprobe_timeout.get())
        _pm = tk.IntVar(value=self.preview_margin.get())
