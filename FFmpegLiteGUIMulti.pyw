    # ---------- 窗口唤回：「沉底无法唤醒」自救（说明见模块级同名注释块） ----------

    def _iter_toplevels(self):
        """本进程存活的 Toplevel 列表（不含 root；查两级，覆盖子窗的子窗）。"""
        _out = []

        def _walk(w, depth=0):
            try:
                _kids = w.winfo_children()
            except Exception:
                return
            for _c in _kids:
                if not isinstance(_c, tk.Toplevel):
                    continue
                try:
                    if not _c.winfo_exists():
                        continue
                except Exception:
                    continue
                _out.append(_c)
                if depth < 1:
                    _walk(_c, depth + 1)

        _walk(self.root, 0)
        return _out

    def _lift_children(self, on_top=None, only_transient=False):
        """把普通子窗提到主窗之上（只动本进程 z-order，不抢系统焦点）。

        on_top       : 最后再单独 lift 的窗口（一般是 grab 窗，保证它在最上）
        only_transient: True 时只 lift 挂在主窗上的 transient 子窗（无 grab 时的
                        保守模式：独立 Toplevel 有自己的任务栏入口，不代劳）
        跳过：置顶窗（「总在最前」）、overrideredirect 窗（ToolTip / 全屏取色）、不可见窗。
        """
        for _c in self._iter_toplevels():
            if _c is on_top:
                continue
            try:
                if not _c.winfo_viewable():
                    continue
                if bool(_c.attributes("-topmost")):
                    continue
                if _c.overrideredirect():
                    continue
                if only_transient and not _c.transient():
                    continue
                _c.lift()
            except Exception:
                continue
        if on_top is not None:
            with suppress(Exception):
                on_top.lift()

    def _flash_topmost(self, win):
        """瞬时置顶再撤销：只为把窗口拽到 z-order 最前，不改变持久置顶状态。

        用于前台锁抢不到焦点时的兜底 —— 先让它看得见，用户一点即可彻底激活。
        结束时按窗口**原本**的置顶值还原（不污染「总在最前」那类勾选）。
        """
        try:
            _was = bool(win.attributes("-topmost"))
        except Exception:
            _was = False
        try:
            win.attributes("-topmost", True)
        except Exception:
            return

        def _restore(_w=win, _v=_was):
            with suppress(Exception):
                if _w.winfo_exists():
                    _w.attributes("-topmost", _v)
                    _w.lift()

        # 🔴 `after_idle` 的 topmost 只活「一个空闲周期」≈ 0ms，Windows 还没来得及重排
        #    z-order 就被撤掉 ⇒ 视觉上等于没动（这正是「沉底后按热键毫无反应」的体感来源）。
        #    给 180ms：足够真正跳到最后前面并重绘一次，用户点一下即彻底激活。
        try:
            win.after(180, _restore)
        except Exception:
            _restore()

    # ---------- 模态防沉底（2026-10-18 定案：从源头杜绝「沉底后点不动」）----------
    # 根因（tests/_sim_minimize_probe.py 实测确证）：主窗被**系统级**最小化（Win+D /
    # 任务栏 / 别的程序调 ShowWindow(SW_MINIMIZE)）时，Windows 会自动清掉它所有
    # owned popup（= transient 子窗）的 WS_VISIBLE ⇒ 正在 grab 的二级窗**隐形**；
    # 而 Tk 层的 grab **并不会随之释放**（实测：owner 最小化 → CHILD1/CHILD2 全部
    # vis=0，但系统前台仍指着那个隐形窗）⇒ 主窗输入被一个看不见的窗拦截 ⇒ 彻底卡死。
    #   关键对照：命令编辑器同样 transient、同样会被连带隐藏，但它**不 grab_set()**
    #   ⇒ 主窗照常可点，用户感觉「不会沉底」。差别只在 grab —— 不是窗口关系的问题。
    # 对策（尊重用户最小化意图，只消除卡死）：主窗一进入最小化就**主动卸下 grab**
    #   （park），把「彻底卡死」降级成「子窗暂时不可见」；主窗一回来就把子窗带回并
    #   重装 grab。这样 Win+D 后程序不会自己弹回来打扰用户，但永不卡死。

    def _start_sink_guard(self):
        """低频轮询：只在存在 grab 窗时才做判定，其余时间零成本。"""
        if getattr(self, "_sink_guard_on", False):
            return
        self._sink_guard_on = True
        self._grab_parked = None

        def _tick():
            try:
                if not (self.root and self.root.winfo_exists()):
                    self._sink_guard_on = False
                    return
                self._sink_guard_tick()
            except Exception:
                pass
            try:
                self.root.after(_SINK_GUARD_POLL_MS, _tick)
            except Exception:
                self._sink_guard_on = False

        self.root.after(2000, _tick)      # 稍后起步，避开启动首帧

    def _sink_guard_tick(self):
        _grab = self.root.grab_current()
        if _grab is None:
            self._grab_parked = None
            return
        with suppress(Exception):
            if str(self.root.state()) != "iconic":
                return                     # 主窗没被最小化：一切正常，绝不干预
        # 主窗已最小化 ⇒ 子窗必已被连带隐藏，而 grab 还在 ⇒ 立刻卸下，交还主窗输入权
        self._grab_parked = _grab
        with suppress(Exception):
            _grab.grab_release()

    def _restore_from_sink(self):
        """从「已沉底」状态恢复：主窗回位 + 隐藏的 owned 子窗带回 + 重装停放中的 grab。

        返回 True 表示确实做过恢复（调用方据此判断是否需要再走常规唤回）。
        """
        _pk = getattr(self, "_grab_parked", None)
        if _pk is None:
            return False
        self._grab_parked = None
        with suppress(Exception):
            if str(self.root.state()) == "iconic":
                self.root.deiconify()
        # 🔴 Win32 层逐个 SW_RESTORE：Tk 的 deiconify() 对「Tk 认为 normal、系统已清
        #    WS_VISIBLE」的窗口无效（它觉得自己没被 withdraw，不会再 Show）。
        _rh = _win32_hwnd_of(self.root)
        if _rh:
            _win32_restore_hidden_owned(_rh)
        with suppress(Exception):
            if _pk.winfo_exists():
                if str(_pk.state()) == "iconic":
                    _pk.deiconify()
                _pk.grab_set()
        return True

    def _wake_windows(self):
        """把当前 grab 中的窗口（无 grab 则主窗）唤回最前。返回 True = 确实执行了唤回。

        2026-10-18：只由主窗 <Map>/<FocusIn> **显式信号**驱动（「用户刚把我们拉回来」）。
        原看门狗轮询路径（force=False + _need_wake 判据）已删 —— grab 期间 root 被禁用、
        前台永不落在 own_hwnds ⇒ 该判据恒不触发，自加入以来从未生效过。
        """
        try:
            if not (self.root and self.root.winfo_exists()):
                return False
            self._restore_from_sink()      # 沉底恢复必须优先：不能被下面的节流挡掉
            _now = time.time()
            if _now - getattr(self, "_last_wake_ts", 0.0) < _WIN_WAKE_FORCE_GAP:
                return False
            _grab = self.root.grab_current()
            _target = _grab if _grab is not None else self.root
            if _grab is None:
                # 无 grab：root 被激活 = 用户正常操作（FocusIn 就是证据），不是「沉底」。
                # ⚠️ 绝不把 root 提到 transient 子窗之上、不 focus_force root——
                # 否则三级模态窗关闭后的瞬间（模态链尚未恢复）会把二级设置窗
                # 永久压死在 root 后面 → 点不到「确定」→ 设置丢失（2026-10-01 实测）。
                # 只做保守兜底：把沉底的 transient 子窗捞到 root 之上，root 不动、不抢焦点。
                with suppress(Exception):
                    self._lift_children(on_top=None, only_transient=True)
                self._last_wake_ts = _now
                return True
            # 被单独最小化的先恢复（用户去任务管理器点的那一下「恢复」就是缺这步）
            with suppress(Exception):
                if str(_target.state()) == "iconic":
                    _target.deiconify()
            # 子窗也跟着浮上来：grab 场景下要全部（唯一可交互的那个可能压在最底）
            with suppress(Exception):
                self._lift_children(on_top=_target, only_transient=False)
            self._last_wake_ts = _now
            # 🔴 用「硬」抢前台（带 AttachThreadInput + LockSetForegroundWindow）：
            # 用户切去别处「久了」再切回时前台锁早已超时，弱版 SetForegroundWindow 必被拒，
            # 只剩 180ms 的 _flash_topmost 兜底又沉回去 —— 这正是「切不回来」的主因。
            if not _win32_force_foreground_hard(_win32_hwnd_of(_target)):
                self._flash_topmost(_target)      # 兜底：至少先让它看得见
            with suppress(Exception):
                _target.focus_force()
            return True
        except Exception:
            return False

    def _on_root_wake_signal(self, event=None):
        """主窗被激活 / 恢复显示：把压在后面的 grab 窗（或沉底的 transient 子窗）唤回来。"""
        try:
            if self.root.grab_current() is None and not self._iter_toplevels():
                return                    # 既无模态窗也无子窗：主窗自己就正常，绝不干预
        except Exception:
            return
        self.root.after(30, self._wake_windows)

    # 2026-10-18：_start_window_watchdog（低频轮询唤回）已整体删除 ——
    #   它只有存在 grab 窗时才调 _wake_windows(force=False)，而该路径被 _need_wake
    #   判据卡死（root 被禁用 ⇒ 前台永不落在 own_hwnds）⇒ 从未生效过（用户实测确认）。
    #   沉底唤回现只留两条：主窗 <Map>/<FocusIn> 显式信号 + 全局热键。
    def _hotkey_wake(self):
        """全局快捷键唤回：显式用户指令，允许把主窗本身抢到前台。

        区别于 _wake_windows 对 root 的保守（那里绝不 focus_force root，防抢 transient
        子窗焦点）；热键是用户主动喊醒，理应以「当前模态窗，无则以主窗」为目标抢到最前。
        """
        try:
            if not (self.root and self.root.winfo_exists()):
                return
            self._restore_from_sink()      # 沉底（主窗最小化 + grab 停放）先整体复位
            # 🔴 主窗最小化会**连带隐藏它所有 owned 子窗**（含正在 grab 的那个）⇒ 只
            #    restore 子窗没用，必须先把主窗拉回来。Process Explorer「窗口 → 恢复」
            #    每次都能救回来，靠的就是这一步（用户 2026-10-18 实测对照）。
            with suppress(Exception):
                if str(self.root.state()) == "iconic":
                    self.root.deiconify()
            _grab = self.root.grab_current()
            _target = _grab if _grab is not None else self.root
            with suppress(Exception):
                if str(_target.state()) == "iconic":
                    _target.deiconify()
            with suppress(Exception):
                self._lift_children(on_top=_target, only_transient=False)
            _fg_ok = _win32_force_foreground_hard(_win32_hwnd_of(_target))
            # 无论成败都留一行：否则「热键压根没送达」和「送达了但被系统拒」都是静默，
            # 用户无从分辨（2026-10-18 排查的主要代价）。
            with suppress(Exception):
                self._append_info_ui(
                    (_("[窗口唤回] 快捷键 %s：已唤回（%s）") if _fg_ok else
                     _("[窗口唤回] 快捷键 %s：前台抢夺被系统拒绝（已瞬时置顶，点一下窗口即可激活）"))
                    % (_hotkey_label(*getattr(self, "_hotkey_mod_vk_cur",
                                              (_HOTKEY_MOD, _HOTKEY_VK))),
                       getattr(_target, "title", lambda: "")() or _("主窗")))
            if not _fg_ok:
                self._flash_topmost(_target)      # 兜底：至少先让它看得见
            with suppress(Exception):
                _target.focus_force()
        except Exception:
            pass

    def _hotkey_mod_vk(self):
        """设置里的「Ctrl/Shift/Alt 勾选 + 键名」→ `(mod_mask, vk)`；非法返回 `(0, 0)`。

        规则：**至少一个修饰键** + 一个字母/数字（单字符）或 F1~F12。
        纯字母键全局注册会跟所有文本输入抢键，故不允许无修饰键。
        键名大小写不敏感（统一按大写 `ord()`）。
        """
        _mod = 0
        with suppress(Exception):
            if self.wake_hotkey_ctrl.get():
                _mod |= 0x0002        # MOD_CONTROL
            if self.wake_hotkey_shift.get():
                _mod |= 0x0004        # MOD_SHIFT
            if self.wake_hotkey_alt.get():
                _mod |= 0x0001        # MOD_ALT
        _k = ""
        with suppress(Exception):
            _k = (self.wake_hotkey_key.get() or "").strip().upper()
        if not _mod or not _k:
            return 0, 0
        if re.match(r"^F([1-9]|1[0-2])$", _k):
            return _mod, 0x6F + int(_k[1:])       # VK_F1 = 0x70
        if len(_k) == 1 and re.match(r"^[0-9A-Z]$", _k):
            return _mod, ord(_k)
        return 0, 0

    def _apply_wake_hotkey(self):
        """按当前设置重新注册全局唤回热键；返回是否**已用上新组合**。

        先停旧、再起新（RegisterHotKey 是独占资源，同组合不能并存）；新组合注册失败
        则把旧组合捞回来，保证「改坏了也不至于彻底没有快捷键」。
        """
        _mod, _vk = self._hotkey_mod_vk()
        if not _mod or not _vk:
            with suppress(Exception):
                self._append_info_ui(
                    _("[窗口唤回] 快捷键无效：需要至少一个修饰键 + 一个字母/数字/F1~F12，已保留原快捷键"))
            return False
        _cur = getattr(self, "_hotkey_mod_vk_cur", None)
        if _cur == (_mod, _vk) and getattr(self, "_global_hotkey", None) is not None \
                and bool(getattr(self._global_hotkey, "ok", False)):
            return True                      # 没变、且当前就在生效 → 不折腾
        _old = _cur
        self._stop_global_hotkey()
        with suppress(Exception):
            while True:                      # 丢掉旧队列里的残留信号
                self._hotkey_q.get_nowait()
        _hk = _GlobalHotkeyWake(self._hotkey_q, _mod, _vk,
                                on_hotkey=_hotkey_grab_foreground).start()
        if _hk.ok:
            self._global_hotkey = _hk
            self._hotkey_mod_vk_cur = (_mod, _vk)
            with suppress(Exception):
                self._global_hotkey.target_hwnd = _win32_hwnd_of(self.root)
            with suppress(Exception):
                self._append_info_ui(_("[窗口唤回] 快捷键已改为 %s") % _hotkey_label(_mod, _vk))
            return True
        _hk.stop()
        with suppress(Exception):
            self._append_info_ui(
                _("[窗口唤回] 快捷键 %s 注册失败（可能被其他程序占用），已回退")
                % _hotkey_label(_mod, _vk))
        if _old:
            _hk = _GlobalHotkeyWake(self._hotkey_q, _old[0], _old[1],
                                    on_hotkey=_hotkey_grab_foreground).start()
            self._global_hotkey = _hk
            if _hk.ok:
                with suppress(Exception):
                    self._global_hotkey.target_hwnd = _win32_hwnd_of(self.root)
        return False

    def _start_global_hotkey(self):
        """注册全局唤回快捷键（设置项，出厂默认 Ctrl+Shift+Alt+W）并起主线程 drain 轮询。

        注册失败（组合键被占用 / 非 Windows）只写一条日志、不弹窗——不影响既有
        <Map>/<FocusIn>/ 看门狗三条自救路径。
        """
        self._hotkey_q = queue.Queue()
        _mod, _vk = self._hotkey_mod_vk()
        if not _mod or not _vk:
            _mod, _vk = _HOTKEY_MOD, _HOTKEY_VK     # 设置非法（含旧版本无此项）→ 用出厂默认
        self._hotkey_mod_vk_cur = (_mod, _vk)
        # 🔴 抢前台必须在**热键线程收到 WM_HOTKEY 的那一刻**做（前台豁免只有那一瞬），
        #    Tk 侧轮询只负责 deiconify / lift / 日志这些必须主线程的动作。
        self._global_hotkey = _GlobalHotkeyWake(
            self._hotkey_q, _mod, _vk, on_hotkey=_hotkey_grab_foreground).start()
        with suppress(Exception):
            self._global_hotkey.target_hwnd = _win32_hwnd_of(self.root)
        # 🔴 只在**失败**时写日志：注册成功是常态，每次启动刷一条「已就绪」纯属噪音
        #    （用户 2026-10-17 明确不要）。失败以前是**完全静默**：按快捷键没反应且查不到
        #    原因（本次 bug 的一半代价）；Windows 的 RegisterHotKey 被别的程序占用时只返回
        #    False、GetLastError=1409，至少让「无效」有据可查。
        if not bool(getattr(self._global_hotkey, "ok", False)):
            with suppress(Exception):
                self._append_info_ui(
                    _("[窗口唤回] 全局快捷键 %s 注册失败（可能被其他程序占用，GetLastError=%d）—— 沉底后只能靠任务栏 / Alt+Tab 拉回")
                    % (_hotkey_label(_mod, _vk), ctypes.get_last_error()
                       if hasattr(ctypes, "get_last_error") else 0))
        self.root.after(1200, self._poll_hotkey)     # 稍后起步，避开启动首帧

    def _poll_hotkey(self):
        """主线程 drain 热键信号队列：有信号就唤回（跨线程只经此队列碰 Tk，安全）。"""
        try:
            # 预热「热键线程要抢的顶层窗口」：grab 窗可能随时变，150ms 粒度足够对得上；
            # 写的是 int，热键线程读它不需要锁（旧值最坏只是抢错一次）。
            _g = self.root.grab_current()
            with suppress(Exception):
                if getattr(self, "_global_hotkey", None) is not None:
                    self._global_hotkey.target_hwnd = _win32_hwnd_of(
                        _g if _g is not None else self.root)
            _hit = False
            while True:
                try:
                    self._hotkey_q.get_nowait()
                    _hit = True
                except queue.Empty:
                    break
            if _hit:
                self._hotkey_wake()
        except Exception:
            pass
        try:
            if self.root and self.root.winfo_exists():
                self.root.after(_HOTKEY_POLL_MS, self._poll_hotkey)
        except Exception:
            pass

    def _stop_global_hotkey(self):
        with suppress(Exception):
            if getattr(self, "_global_hotkey", None) is not None:
                self._global_hotkey.stop()

    # 注：原 _get_filter_param_keys 白名单已废弃，复制滤镜改由模块级
    # _COPY_FILTER_EXCLUDE_KEYS（默认全复制 + 显式排除）驱动，新增滤镜参数自动包含。

    def _delayed_init(self):
        """在后台线程中释放预设文件和命令模板，避免阻塞 UI"""
        def worker():
            # 1. 确保预设文件存在
            if not os.path.exists(self.preset_file_path):
                self.preset_manager._ensure_default_preset()
            
            # 2. 确保快速命令模板文件存在且有效
            if not os.path.exists(self.cmd_templates_path):
                # 文件不存在，创建默认模板
                self.cmd_templates = self._get_default_cmd_templates()
                self._save_cmd_templates()
            else:
                # 文件存在，尝试加载
                self._load_cmd_templates()
                # 如果加载后为空（可能文件损坏），则重建
                if not self.cmd_templates:
                    self._append_info_ui(_("快速命令模板文件损坏或为空，将重建默认模板"))
                    self.cmd_templates = self._get_default_cmd_templates()
                    self._save_cmd_templates()
                    self._load_cmd_templates()  # 重新加载
            
            # 3. 回到主线程更新 UI
            self.root.after(0, self._finish_delayed_init)
        
        threading.Thread(target=worker, daemon=True).start()
    
    def _finish_delayed_init(self):
        """延迟初始化完成后的 UI 更新"""
        self.load_preset_list()
        self._refresh_cmd_preset_list()
        self.update_player_status()      # 延迟显示状态检测信息
        # 字体缓存预加载（全量扫描实测 ~30ms，窗口已显示后执行无感知；
        # 对话框打开时还有 ensure_fonts_cached() 兜底，双保险）
        with suppress(Exception):
            ensure_fonts_cached()
        self._initialized = True
#        self._append_info_ui("预设和快速命令模板已就绪")


    def _ensure_main_video(self, disable_scale=False):
        """确保 self.merge_video 已设置：若未设置，则从列表中取第一个启用的视频轨道。
        如果 disable_scale=True，则将该主视频轨道的画中画水印残留（缩放+叠加）全部清回默认，
        使其作为底图不被缩放/叠加。无论主视频是刚刚自动设置还是早已设置都会清理。
        """
        main_track = None
        enabled_videos = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        if not enabled_videos:
            self.merge_video.set("")
            return False
        # 主视频字段优先指向「真实文件」轨道（颜色虚拟源不可作为主视频字段，
        # 否则 merge_load_video_info 会把整列轨道清空）；合成的「主层」仍是
        # 首个启用的视频轨（含颜色源，作为背景）。
        real_videos = [t for t in enabled_videos if not _is_virtual_source(t.file_path)]
        # 2026-10-09：首个启用视频是颜色虚拟源时，主视频字段必须保持空（合成主层取
        # video_tracks[0]），**绝不能**改写成子视频真实路径，否则子视频会「劫持」主视频
        # 输入名（用户报告：添加子视频后主输入变成子视频名）。
        if (not self.merge_video.get().strip() or _is_virtual_source(self.merge_video.get().strip())) \
                and not _is_virtual_source(enabled_videos[0].file_path):
            if real_videos:
                self._suppress_main_video_trace = True
                self.merge_video.set(normalize_path(real_videos[0].file_path))
                self._suppress_main_video_trace = False
                self._append_info_ui(_('[自动] 主视频未设置，自动设为: {0}').format(os.path.basename(real_videos[0].file_path)))
            # 纯颜色项目：merge_video 留空（合成主层取 video_tracks[0]）
        if _is_virtual_source(enabled_videos[0].file_path):
            main_track = enabled_videos[0]
        else:
            norm = normalize_path(self.merge_video.get())
            for t in self.merge_tracks:
                if t.enabled and t.type == "video" and normalize_path(t.file_path) == norm:
                    main_track = t
                    break
            if main_track is None:
                main_track = enabled_videos[0]

        if disable_scale and main_track is not None:
            # 主视频是底图，彻底清除画中画水印残留（与 Track 默认一致：12844/12855 行）
            main_track.enc_settings["scale_enabled"] = False
            main_track.enc_settings["scale_width"] = ""
            main_track.enc_settings["scale_height"] = ""
            main_track.enc_settings["overlay_enabled"] = False
            main_track.enc_settings["overlay_x"] = ""
            main_track.enc_settings["overlay_y"] = ""
            main_track.overlay_enabled = False
            self.merge_update_track_list()
        return True


    def _track_needs_alpha(self, t) -> bool:
        """单条视频轨是否**产生输出 alpha**（判据核；_merge_needs_alpha / _pip_needs_alpha 共用，
        避免同一套判据在多处各写一份而漂移）：

        - 透明虚拟源：颜色 alpha<255（半透明/全透明背景）/ 倒计时「无底」/ 图案 null·rgbtest
        - 抠像（chroma_enabled）/ 遮罩·描边（写 alpha）/ 透明度<1.0
        - 视频文件本身带 alpha 像素格式
        """
        fp = getattr(t, "file_path", "") or ""
        cs = t.enc_settings if isinstance(t.enc_settings, dict) else {}
        if _is_virtual_source(fp):
            # 统一判据（2026-10-10）：与输出名派生共用 _virtual_output_info —— color(alpha<255)
            # / 倒计时「无底」/ 图案 null·rgbtest 都算透明底；避免同一件事两处各写一份而漂移。
            # （此前这里只认 _parse_color_source ⇒ gen 的透明底漏判，不升级 alpha 编码器。）
            _v = _virtual_output_info(fp)
            return bool(_v and _v[1])
        if self._settings_needs_alpha(cs):
            return True
        try:
            _pf = self._get_video_pix_fmt(fp, 0)
            if _pf and self._pix_fmt_has_alpha(_pf):
                return True
        except Exception:
            pass
        return False

    def _pip_needs_alpha(self, video_tracks) -> bool:
        """画中画是否需要 alpha 输出（2026-10-12 新增）。

        画中画的输出 alpha 只可能来自**底**（主视频 + 主视频之后补的帧）。两个来源：

        ① **主视频本身透明**：抠像 / 遮罩 / 透明度<1.0 / 透明虚拟源 / 带 alpha 的文件。
        ② **时间轴延长段（主视频之后那段）里显示的子视频**：子素材被摆到主视频之后时，底用
           `tpad` 接长，**那段没有主视频垫底** ⇒ 若那里的子视频本身带透明，用户要的「该时间段
           透明」必须保留 ⇒ 输出要带 alpha（同时延长段的补帧要改成**透明**补，否则透明底下垫的
           是实心黑，.mov 白升 —— 见 `_build_overlay_filter_complex(tail_pad_alpha=…)`）。
           ⚠️ **落在主视频时段内的透明子视频仍不算**（那时有主视频垫底 ⇒ 合成不透明）：
              2026-10-09 用户拍板的口径不变，别顺手放宽成「任一子视频透明就升 prores」。
        无子视频 / 没有延长段 ⇒ 与旧口径（①）逐字节一致（零行为变化）。
        """
        vts = [t for t in video_tracks
               if getattr(t, "type", "video") == "video"
               and getattr(t, "enabled", True)]
        if not vts:
            return False
        if self._track_needs_alpha(vts[0]):
            return True                                  # ① 主视频
        subs = vts[1:]
        if not subs:
            return False
        try:
            _main_dur = self._pip_main_effective_duration(vts[0])
            _total = self._pip_timeline_extent(
                _main_dur, [(t.file_path, t.enc_settings) for t in subs])
        except Exception:
            return False
        if not _main_dur or not _total or _total <= _main_dur + 1e-6:
            return False                                 # 没有延长段 ⇒ ② 不成立
        for sv in subs:
            if not (sv.enc_settings or {}).get("overlay_enabled", True):
                continue
            _we = self._pip_sub_window_end(sv.enc_settings, sv.file_path)
            # 无界窗口（探不到结束）→ 一直显示到输出结束 ⇒ 必然覆盖延长段
            if _we is not None and _we <= _main_dur + 1e-6:
                continue                                 # 窗口结束在主视频之前 ⇒ 没落进延长段
            if self._track_needs_alpha(sv):
                return True
        return False

    def _merge_needs_alpha(self, enabled_tracks):
        """封装页是否需要透明（带 alpha）输出。**三种模式口径不同**（共用同一套轨级判据
        `_track_needs_alpha`）：

        - **串行合并**：各段**并列**拼成输出（无「叠在画布上」概念）⇒ **任一轨**命中即需 alpha。
        - **画中画**：主视频命中，**或**时间轴延长段（主视频之后）里显示的子视频命中
          （那段没有主视频垫底）⇒ 见 `_pip_needs_alpha`。
        - **普通封装**：只有**主视频**（首条启用视频轨 = 输出画布的底）决定。子视频（叠加层）
          带透明只是叠在主画布之上，输出仍不透明（2026-10-09 用户拍板：此前「任一轨命中即
          触发」会把「透明颜色只当子视频」也误升 prores_ks 4444 ——「太粗暴」）。
        """
        video_tracks = [t for t in enabled_tracks
                        if getattr(t, "type", "video") == "video"
                        and getattr(t, "enabled", True)]
        if not video_tracks:
            return False
        try:
            _concat = bool(self.concat_enabled.get())
        except Exception:
            _concat = False
        if not _concat:
            # 2026-10-12：画中画走自己的口径（含「主视频之后的子视频时段」），见 _pip_needs_alpha。
            try:
                _pip = bool(self.pip_enabled.get())
            except Exception:
                _pip = False
            if _pip:
                return self._pip_needs_alpha(video_tracks)
        candidates = video_tracks if _concat else video_tracks[:1]
        for t in candidates:
            if self._track_needs_alpha(t):
                return True
        return False

    def _settings_needs_alpha(self, cs) -> bool:
        """单份设置字典是否会产生 alpha（转换页主视频 / 任意轨的透明判据核）。

        命中任一即需要 alpha 输出：绿幕抠像 / 遮罩 / 描边 / 透明度<1.0。
        （子视频不适用本判据——子视频的透明由 overlay 合成，不决定输出容器。）
        """
        if not isinstance(cs, dict):
            return False
        if cs.get("chroma_enabled", False):
            return True
        if cs.get("mask_enabled", False) or cs.get("outline_enabled", False):
            return True
        if cs.get("alpha_enabled", False):
            try:
                return 0.0 <= float(cs.get("alpha_value", 1.0)) < 1.0
            except (ValueError, TypeError):
                pass
        return False

    def _node_fx_needs_alpha(self, node_fx=None) -> bool:
        """节点效果（self.node_fx / self.node_audio_fx 不含）里是否有**会产生 alpha** 的项。

        专供管道预览「透明指示（棋盘格底）」的自动判据（`_open_pipe_time_preview`）。

        为什么必须单列（2026-10-14 用户实测根因）：
          `_settings_needs_alpha(settings)` 只看**某一份轨道设置**（enc_settings），
          而「视频节点」里挂的效果存在 **app 级 `self.node_fx`**（按指纹挂在中段节点上，
          见 `_save_node_fx`），**根本不进 settings**。于是「给节点加遮罩 → 管道预览」
          时自动判 `pipe_alpha` 恒为 False ⇒ 预览里看不出透明。
          （用户原话：管道模式不支持这个节点里插入的遮罩的透明，外面的和命令编辑
            窗口的都是。）

        判据与 `_settings_needs_alpha` **同口径**，但遮罩额外要求「真的有几何」
        （`_mask_has_geometry`）—— 勾了开关却没形状时遮罩段根本不生成，不该误开棋盘。
        另认「自定义命令」串里手写的 alphamerge / alphaextract（抠图链）。

        ⚠️ 已知近似：本判据是 **app 级**，不校验该效果是否落在「本次预览的那张图」里
        ⇒ 极端情况下会多垫一层棋盘（纯观感，不影响成片）。宁可多垫，不可少垫。
        """
        _fx = node_fx if node_fx is not None else getattr(self, "node_fx", None)
        if not _fx:
            return False
        try:
            for _v in _fx.values():
                for _it in node_fx_items(_v):
                    if not isinstance(_it, dict):
                        continue
                    _cu = str(_it.get(NODE_FX_CUSTOM_KEY) or "").lower()
                    if _cu:
                        if "alphamerge" in _cu or "alphaextract" in _cu:
                            return True
                        continue
                    if _it.get("mask_enabled") and _mask_has_geometry(_it)[0]:
                        return True
                    if _it.get("chroma_enabled") or _it.get("outline_enabled"):
                        return True
                    if _it.get("alpha_enabled"):
                        try:
                            if 0.0 <= float(_it.get("alpha_value", 1.0)) < 1.0:
                                return True
                        except (ValueError, TypeError):
                            pass
        except Exception:
            return False
        return False

    def _graph_alpha_from_node_fx(self) -> bool:
        """**导出侧**判据：视频节点里挂的效果是否会给本次输出带来 alpha（2026-10-14 新增）。

        为什么必须单列（用户实测根因）：节点效果住在 **app 级 `self.node_fx`**
        （按指纹挂在中段节点上，见 `_save_node_fx`），**根本不进 settings / 轨道**
        ⇒ 所有「settings 口径」的 alpha 门控（容器升 .mov / 强制 yuva420p / 换
        prores_ks，见 L44887 / L44984 / L58844 / L57637）都看不见它
        ⇒ 用户必须自己手选输出容器与像素格式。用户原话：
        「节点里插入的遮罩没有检测透明度, 要自己选输出容器和像素格式」。

        ⚠️ 为什么不是直接 `return self._node_fx_needs_alpha()`（app 级一刀切）：
        那样只要**任何**工程里挂着一条会产 alpha 的节点效果，**别的**工程导出也会被
        悄悄升成 ProRes 4444 / .mov（体积暴涨）。故这里按指纹**核对它是否真落在本次的
        图里** —— `_apply_node_fx` 找不到 key 本来就只日志跳过、不生效，导出自然也不该升。

        核对基准取「应用节点效果**前**的干净图」`_last_graph_base`（与节点列表 / 指纹
        定位同一份，段序号稳定），并要求它与当前媒体签名同一代（否则段序号可能已漂移，
        拿它判指纹会误判）。**拿不到可信基准时宁可多升级** —— 用户要的是「自动检测」：
        多升级只是文件变大，漏升级是透明被静默丢弃（.mov alpha 全填 255）。

        ⛔ **调用范围：只许在画中画模式下用**（2026-10-14 自查钉死，别扩大）。
        「视频节点」是画中画专属能力：入口 `_open_node_tap_dialog` 明写需要
        `pip_enabled`（`_ensure_node_context` 同样要求），而全仓库 `_apply_node_fx`
        只有两处调用 —— `_build_overlay_filter_complex`（画中画构图，见 L40531）
        与预览路径（L61372）。**转码页**（44xxx–46xxx 无任何 node_fx 引用）与
        **串行合并**（L58815 注释明写「串行根本不应用视频节点效果」）都不插它。
        ⇒ 在那两条路上这个判据恒为**假阳性**：工程里挂着节点遮罩、切到转码/串行，
        整条命令会被白升成 ProRes 4444 / .mov（体积暴涨十倍、透明度零收益）。
        故 `merge_build_cmd_list` 那处调用额外带 `pip_enabled` 门控；转码页与串行
        **一律不接**（本函数仅供画中画路径调用）。
        """
        _fx = getattr(self, "node_fx", None)
        if not _fx or not self._node_fx_needs_alpha():
            return False
        try:
            _sig_ok = (getattr(self, "_last_graph_sig", None) == self._graph_media_signature()
                       and getattr(self, "_last_graph_gen", -1)
                       == getattr(self, "_last_graph_base_gen", -2)
                       and not getattr(self, "_graph_dirty", False))
        except Exception:
            _sig_ok = False
        _base = (getattr(self, "_last_graph_base", "")
                 or getattr(self, "_last_graph", "") or "")
        if not (_base and _sig_ok):
            return True         # 基准不可信 ⇒ 宁可多升级（见 docstring）
        try:
            _keys = set()
            for _i, _name, _lastf in graph_nodes(_base):
                _keys.add(node_fx_key_of_node(_i, _name, _lastf))
        except Exception:
            return True
        for _k, _v in _fx.items():
            if _k in _keys and self._node_fx_needs_alpha({_k: _v}):
                return True
        return False
    # 能真正承载 alpha 通道的编码器白名单。
    # ⚠️ 关键事实（2026-10-09 真机实测，n9.0.1）：**容器**（.mov/.mkv）只是「允许装 alpha」，
    #    真正决定有没有 alpha 的是**编码器**。libx264/libx265/mpeg4 等标准 H.264/H.265 不支持
    #    alpha，收到 yuva420p 会**静默降为 yuv420p 并把 alpha 全填 255**——
    #    源 RGBA(63,255,8,0) 导出后读回是 (63,255,8,255)，用户看到的就是「选了透明还是实色」。
    #    prores_ks(-profile:v 4444) / prores_aw(4444) / qtrle / ffv1 / png / utvideo 实测保留 alpha。
    # 2026-10-09：VP9/WebM 透明路线已删除（用户实测：透明 WebM 浏览器认、但**加载回本程序
    # 仍是原始底色**，须重新抠图 ⇒ 不如 .mov 通用）⇒ libvpx / libvpx-vp9 一并移出白名单，
    # 让任何透明导出都统一落到 prores_ks 4444 / .mov 这条唯一被验证兼容的路。
    _ALPHA_CAPABLE_ENCODERS = ("prores_ks", "prores_aw", "qtrle", "ffv1", "ffvhuff",
                               "huffyuv", "png", "utvideo")

    def _merge_alpha_encoder(self, vcodec, settings, _prefix=None):
        """透明输出时把「不承载 alpha」的编码器换成 prores_ks（-profile:v 4444）。

        返回 (vcodec, settings)：已在白名单内 → 原样返回；否则返回**副本**（不动调用方字典）
        + 新编码器名。调用方用返回的 vcodec 调 get_encoder_strategy、用返回的 settings 调
        build_params，两者必须成对使用。
        _prefix：日志前缀（封装页 "[封装]" / 转换页 "[转码]"）。
        """
        if _prefix is None:
            _prefix = _("[封装]")
        _codec = str(vcodec or "")
        if _codec in self._ALPHA_CAPABLE_ENCODERS:
            return vcodec, settings
        _s = dict(settings or {})
        _s["encoder"] = "prores_ks"
        _s["profile"] = "4444"
        _s["pix_fmt_enabled"] = True
        _s["pix_fmt"] = "yuva420p"
        self._log_alpha_once(
            "alpha_enc:%s:%s" % (_prefix, _codec or ""),
            _("%s 透明输出：编码器 %s 不承载 alpha（会静默丢弃透明），已自动切换为 "
            "prores_ks 4444（.mov）") % (_prefix, _codec or _("未设置")))
        return "prores_ks", _s

