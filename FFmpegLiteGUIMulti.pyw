        ttk.Button(btn_frame, text=_("确定"), command=self.on_ok, width=10).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_frame, text=_("取消"), command=self.on_cancel, width=10).pack(side=tk.LEFT, padx=5)

        # 2026-08-26 修复：文字内容/启用 实时同步到列表（原来只有 X/Y 挂了 trace，
        # 改文字/勾选启用后列表不刷新，要保存重开才看得到，以为没生效）。
        # 加载表单期间由 _tw_loading 守卫跳过（防 set→trace→刷新→set 死循环）。
        for _v in (self.text_var, self.enabled_var):
            with suppress(Exception):
                _v.trace_add("write", self._sync_tw_to_tree)

    def _sync_tw_to_tree(self, *args):
        """表单变量 trace 回调：把当前选中项实时收集并刷新列表行。

        2026-08-26 修复：文字内容/启用勾选即时反映到列表（不再需要保存重开）。
        加载表单期间由 _tw_loading 守卫跳过，防止 set→trace→刷新→selection→set 死循环。"""
        if getattr(self, "_tw_loading", False):
            return
        idx = self._current_tw_idx()
        if idx is None or not (0 <= idx < len(self.items)):
            return
        self._collect_tw_form(idx)
        self._refresh_tw_tree()

    def _refresh(self):
        """设置变化后刷新命令预览：优先用传入的回调（队列任务编辑），否则主界面 adv_frame。"""
        if self.tw_refresh is not None:
            try:
                self.tw_refresh()
                return
            except Exception:
                pass
        with suppress(Exception):
            if self.app.adv_frame and self.app.adv_frame.update_callback:
                self.app.adv_frame.update_callback()

    def _collect_tw_form(self, idx):
        """把当前表单所有值写入 self.items[idx]（含 font_path 解析与 X/Y/旋转兜底）。

        2026-08-26 修复：切换选中项/添加/删除/确定 前必须先把表单收集回当前项，
        否则编辑过的内容（文字/字体/字号/颜色等）在切换时被静默丢弃。"""
        s = self.items[idx]
        s["enabled"] = self.enabled_var.get()
        s["text"] = self.text_var.get().strip()
        s["font_name"] = self.font_var.get()
        # 外部字体优先：填了外部字体路径就以它为准，留空则回落到下拉所选的系统字体。
        # 必须与滤镜侧语义严格一致（build_drawtext_filter / _build_tw_filtergraph 均为
        # 「font_path = settings['font_path'] or resolve_cn_font_path(font_name)」）。
        # ⚠️ 旧代码无条件用 font_name 覆盖 font_path，会把用户选的外部字体路径清空。
        # 2026-09-04：再拆出 ext_font_path —— font_path 是「滤镜消费的最终结果」，
        # 直接回填 UI 会把系统字体路径误当成用户外部字体（见 resolve_ext_font_path 注释）。
        _ext_font = self.ext_font_var.get().strip() if hasattr(self, "ext_font_var") else ""
        s["ext_font_path"] = _ext_font                       # 仅用户显式值，供 UI 回填
        s["font_path"] = _ext_font or resolve_cn_font_path(self.font_var.get())
        s["font_size"] = self.size_var.get()
        s["font_color"] = self.color_var.get().strip() or "#FFFFFF"
        s["opacity"] = self.opacity_var.get() / 100.0
        s["border_w"] = self.border_w_var.get()
        s["border_color"] = self.border_color_var.get().strip() or "#000000"
        # 富文本换行（2026-09-25）：与「启用倒计时」互斥，由各自 trace 守卫。
        if hasattr(self, "multiline_var"):
            s["multiline"] = bool(self.multiline_var.get())
        s["enable_start"] = self.enable_start_var.get().strip()
        s["enable_end"] = self.enable_end_var.get().strip()
        s["enable_cycle"] = self.enable_cycle_var.get().strip()
        s["enable_show"] = self.enable_show_var.get().strip()
        # X/Y/rotate/spin 由 live trace 已实时写回，这里再兜底一次保证一致
        s["overlay_x"] = self.tw_x_var.get().strip() or "10"
        s["overlay_y"] = self.tw_y_var.get().strip() or "10"
        s["rotate"] = self.rotate_var.get()
        s["spin_enabled"] = bool(self.spin_enabled_var.get())
        s["spin_speed"] = self.spin_speed_var.get()
        # 倒计时（滚动小窗）：时段/行距/窗口存原始字符串，空 = 自动
        if hasattr(self, "cd_enabled_var"):
            s["countdown_enabled"] = bool(self.cd_enabled_var.get())
            # ✓ 钉死：countdown_direction_display() 是 token→显示名；这里要的是
            #   「显示名→token」，必须先倒过来，否则 _name2id.get(显示名) 恒兜底
            #   top_bottom，一选方向就被写回默认 token，界面随即弹回「上→下」
            #   （2026-10-02 回归，勿改回：原 COUNTDOWN_DIRECTIONS 是二元组
            #   (显示名, id) 才能直接当显示名→token 用）。
            _name2id = {_v: _k for _k, _v in countdown_direction_display().items()}
            s["countdown_direction"] = _name2id.get(self.cd_dir_var.get(), "top_bottom")
            for _k, _v in (("countdown_t0", self.cd_t0_var),
                           ("countdown_t1", self.cd_t1_var),
                           ("countdown_gap", self.cd_gap_var),
                           ("countdown_win_x", self.cd_winx_var),
                           ("countdown_win_y", self.cd_winy_var),
                           ("countdown_win_w", self.cd_winw_var),
                           ("countdown_win_h", self.cd_winh_var)):
                s[_k] = _v.get().strip()

    def on_ok(self):
        # 当前选中项表单写回列表（含所有字段），再统一写回容器
        if self.items:
            if self._tw_last_sel is not None and 0 <= self._tw_last_sel < len(self.items):
                self._collect_tw_form(self._tw_last_sel)
            else:
                self._collect_tw_form(0)
            # 2026-09-04：记录「用户显式指定」的外部字体到历史（供下次下拉直接选）。
            # 只读 _collect_tw_form 刚写入的 ext_font_path（=本窗口 ext_font_var），
            # 系统字体解析结果不会被 record（record 内部校验文件存在+非空）。
            if hasattr(self, "ext_font_var"):
                with suppress(Exception):
                    record_external_font(self.ext_font_var.get().strip())
        # 触发命令预览更新
        self._write_back_items()  # 2026-08-26：多实例列表写回容器
        self._refresh()
        self.destroy()

    def on_cancel(self):
        self.destroy()

    # ---------- 多文字水印列表 ----------
    def _refresh_tw_tree(self):
        sel = None
        if self.tw_tree.selection():
            sel = self.tw_tree.selection()[0]
        self.tw_tree.delete(*self.tw_tree.get_children())
        for i, it in enumerate(self.items):
            _en = "☑" if it.get("enabled", True) else "☐"
            _txt = (str(it.get("text", "")) or _("(空)"))[:14]
            # 位置列直接读顶层 overlay_x/overlay_y（多实例每项就是 text_watermark 同构 dict，
            # 不存在 text_watermark_position 子键——旧代码读子键恒为默认值，列表位置永不刷新）
            _xy = f"({it.get('overlay_x','10')},{it.get('overlay_y','10')})"
            self.tw_tree.insert("", "end", iid=str(i), values=(_en, _txt, _xy))
        if sel is not None and self.tw_tree.exists(sel):
            self.tw_tree.selection_set(sel)

    def _current_tw_idx(self):
        s = self.tw_tree.selection()
        if not s:
            return None
        try:
            return int(s[0])
        except (ValueError, TypeError):
            return None

    def _load_tw_form(self):
        self._tw_loading = True
        try:
            s = self.settings
            try:
                self.enabled_var.set(s.get("enabled", False))
                self.text_var.set(s.get("text", ""))
                self.font_var.set(s.get("font_name", _("微软雅黑")))
                # 外部字体路径回填（与 _collect_tw_form 对称；留空表示用上方下拉的系统字体）
                # ⚠️ 必须是 resolve_ext_font_path(s) 而不是 s["font_path"]：后者含系统字体
                # 解析结果，回填后编辑框非空 → 之后每次下拉选择都被这个路径覆盖。
                if hasattr(self, "ext_font_var"):
                    self.ext_font_var.set(resolve_ext_font_path(s))
                self.color_var.set(s.get("font_color", "#FFFFFF"))
                self.border_color_var.set(s.get("border_color", "#000000"))
                self.enable_start_var.set(s.get("enable_start", ""))
                self.enable_end_var.set(s.get("enable_end", ""))
                self.enable_cycle_var.set(s.get("enable_cycle", ""))
                self.enable_show_var.set(s.get("enable_show", ""))
                self.tw_x_var.set(s.get("overlay_x", "10"))
                self.tw_y_var.set(s.get("overlay_y", "10"))
                self.rotate_var.set(float(s.get("rotate", 0.0) or 0.0))
                self.spin_enabled_var.set(bool(s.get("spin_enabled", False)))
                self.spin_speed_var.set(float(s.get("spin_speed", 60.0) or 60.0))
                # 2026-08-26 修复：字号/透明度/描边宽度漏加载 → 切换选中项后残留上一项的值，
                # 点「确定」会用旧值覆盖新项（表现为「内容无法修改」）。
                try:
                    self.size_var.set(int(s.get("font_size", 48)))
                except (ValueError, TypeError):
                    pass
                try:
                    _op = int(float(s.get("opacity", 1.0)) * 100)
                except (ValueError, TypeError):
                    _op = 100
                self.opacity_var.set(max(0, min(100, _op)))
                self.opacity_label.config(text=f"{self.opacity_var.get()}%")
                try:
                    self.border_w_var.set(int(s.get("border_w", 0)))
                except (ValueError, TypeError):
                    pass
                # 富文本换行（2026-09-25）：与「启用倒计时」互斥，由各自 trace 守卫。
                if hasattr(self, "multiline_var"):
                    self.multiline_var.set(bool(s.get("multiline", False)))
                # 倒计时（滚动小窗）：空字符串 = 自动（生成器里兜底）
                if hasattr(self, "cd_enabled_var"):
                    self.cd_enabled_var.set(bool(s.get("countdown_enabled", False)))
                    # ⚠️ COUNTDOWN_DIRECTIONS 是 (显示名, id) → dict() 得到 名字→id；
                    #    这里要按 id 查显示名，必须反向建表（曾写反导致回填恒为「上→下」）
                    _id2name = countdown_direction_display()
                    self.cd_dir_var.set(_id2name.get(countdown_direction(s), _id2name["top_bottom"]))
                    for _k, _v in (("countdown_t0", self.cd_t0_var),
                                   ("countdown_t1", self.cd_t1_var),
                                   ("countdown_gap", self.cd_gap_var),
                                   ("countdown_win_x", self.cd_winx_var),
                                   ("countdown_win_y", self.cd_winy_var),
                                   ("countdown_win_w", self.cd_winw_var),
                                   ("countdown_win_h", self.cd_winh_var)):
                        _raw = s.get(_k, "")
                        _v.set("" if _raw is None else str(_raw))
            except Exception:
                pass
            self._refresh()
        finally:
            self._tw_loading = False

    def _on_tw_blank_click(self, ev):
        """点列表空白区域取消选中（ttk Treeview 默认点空白保持原选中），
        使「未选中 → 简易预览回溯全部条目」状态可达。点行不干预（ttk 自行选中）。"""
        with suppress(Exception):
            if self.tw_tree.identify_row(ev.y) == "":
                self.tw_tree.selection_remove(*self.tw_tree.selection())

    def _on_tw_select(self, ev):
        idx = self._current_tw_idx()
        if idx is None or idx >= len(self.items):
            return
        # 先收集上一个选中项的表单值（否则切换后上一项编辑丢失），再加载新选中项
        if self._tw_last_sel is not None and 0 <= self._tw_last_sel < len(self.items) \
                and self._tw_last_sel != idx:
            self._collect_tw_form(self._tw_last_sel)
        self.settings = self.items[idx]
        self._load_tw_form()
        self._tw_last_sel = idx

    def _on_tw_click(self, ev):
        with suppress(Exception):
            if self.tw_tree.identify_column(ev.x) == "#1":
                iid = self.tw_tree.identify_row(ev.y)
                if iid:
                    idx = int(iid)
                    # 先写回上一个选中项，避免其表单值把本次切换覆盖掉
                    if self._tw_last_sel is not None and 0 <= self._tw_last_sel < len(self.items) \
                            and self._tw_last_sel != idx:
                        self._collect_tw_form(self._tw_last_sel)
                    self.items[idx]["enabled"] = not self.items[idx].get("enabled", True)
                    self.enabled_var.set(self.items[idx]["enabled"])  # 同步表单（启用列/总开关同源）
                    self._refresh_tw_tree()
                    self.tw_tree.selection_set(iid)
                    self._tw_last_sel = idx
                    self.settings = self.items[idx]
                    self._load_tw_form()

    # ---------- 对话框内自包含撤销/重做（2026-09-29 Phase 2）----------
    # 🔴 2026-10-15：三份逐字同构的实现已收口到模块级 DialogUndoStack，这里只留
    #    同名转发壳 —— 调用点（_tw_begin_edit / _tw_push / …）零改动，
    #    撤销协议今后只改一处。实例在 __init__ 注入。
    def _tw_snapshot(self):
        return self._tw_undo.snapshot()

    def _tw_begin_edit(self):
        self._tw_undo.begin_edit()

    def _tw_push(self, label):
        self._tw_undo.push(label)

    def _tw_after_restore(self):
        self._refresh_tw_tree()
        if self.items:
            _sel = self._tw_last_sel if (self._tw_last_sel is not None and 0 <= self._tw_last_sel < len(self.items)) else 0
            with suppress(Exception):
                self.tw_tree.selection_set(str(_sel))
            self.settings = self.items[_sel]
            self._tw_last_sel = _sel
        else:
            self.settings = {}
            self._tw_last_sel = None
        self._load_tw_form()
        # ⛔ 不要在这里补 _tw_refresh_undo_buttons()：撤销/重做按钮的刷新由
        #    DialogUndoStack.undo()/redo() 在本回调返回后统一执行，补了会重复 configure。

    def _tw_do_undo(self):
        self._tw_undo.undo()

    def _tw_do_redo(self):
        self._tw_undo.redo()

    def _tw_refresh_undo_buttons(self):
        self._tw_undo.refresh_buttons()

    def _add_tw_item(self):
        if self._tw_last_sel is not None and 0 <= self._tw_last_sel < len(self.items):
            self._collect_tw_form(self._tw_last_sel)
        self._tw_begin_edit()
        # ⚠️ 深拷贝：dict() 浅拷贝会让新条与当前条共享 move_waypoints 列表（列表轨迹被多条共享）
        base = copy.deepcopy(self.settings) if self.settings else {}
        base["enabled"] = True
        base["text"] = _("新文字水印")
        # 2026-08-27：轨迹控制独立空白——新条不继承上一条的轨迹设置。
        # 文字水印表单没有 move_* 控件（轨迹只经「轨迹控制」弹窗修改），
        # 继承会让用户误以为新条复制了上一条的轨迹，需逐条手动清空。
        base["move_mode"] = ""
        base["move_cycle"] = 4.0
        base["move_dwell"] = 2.0
        base["move_margin"] = "W*0.03"
        base["move_waypoints"] = []
        self.items.append(base)
        self._refresh_tw_tree()
        self.tw_tree.selection_set(str(len(self.items) - 1))
        self.settings = self.items[-1]
        self._tw_last_sel = len(self.items) - 1
        self._load_tw_form()
        self._tw_push(_("添加水印"))

    def _del_tw_item(self):
        idx = self._current_tw_idx()
        if idx is None or not self.items:
            return
        if 0 <= idx < len(self.items):
            self._collect_tw_form(idx)
        self._tw_begin_edit()
        del self.items[idx]
        self._tw_last_sel = None
        self._refresh_tw_tree()
        if self.items:
            self.tw_tree.selection_set("0")
            self.settings = self.items[0]
            self._tw_last_sel = 0
            self._load_tw_form()
        else:
            self.settings = {}
            self._load_tw_form()
        self._tw_push(_("删除水印"))

    def _move_tw_item(self, d):
        idx = self._current_tw_idx()
        if idx is None:
            return
        if 0 <= idx < len(self.items):
            self._collect_tw_form(idx)
        ni = idx + d
        if ni < 0 or ni >= len(self.items):
            return
        self._tw_begin_edit()
        self.items[idx], self.items[ni] = self.items[ni], self.items[idx]
        self._refresh_tw_tree()
        self.tw_tree.selection_set(str(ni))
        self.settings = self.items[ni]
        self._tw_last_sel = ni
        self._load_tw_form()
        self._tw_push(_("移动水印"))

    def _write_back_items(self):
        """把多实例列表写回容器（app.text_watermark_items 或任务 settings['text_watermark_items']）。
        深拷贝：避免容器项与对话框 items 共享 move_waypoints 列表。

        2026-10-11 修复：列表被清空时要对称停用 legacy 单条，否则「删光水印」会被
        两道补位救回来：保存侧 get_current_settings 有 `elif 单条有效: items=[单条]`，
        消费侧 build_text_watermark_chain 又有 `if not items: items=[settings["text_watermark"]]`
        —— 只删任一道，另一道照样复活。"""
        try:
            items = [copy.deepcopy(i) for i in self.items]
            if isinstance(self.items_container, dict):
                self.items_container["text_watermark_items"] = items
            else:
                self.items_container.text_watermark_items = items
        except Exception:
            pass
        if self.items:
            return
        # 列表被清空 ⇒ 同步停用 legacy 单条（`text_watermark` / `text_watermark_settings`）。
        # ⚠️ 必须就地 update、不能重新绑定：高级选项页以引用持有这个 dict（见多处 getattr 注释）。
        # ⚠️ enabled 必须显式置 False —— 消费侧过滤是 i.get("enabled", True)，缺 key 当成有效。
        # ⚠️ 只在「用户经对话框清空」时触发；从未打开过对话框的旧预设不受影响，
        #    那正是保存侧 elif 兼容分支存在的意义。
        try:
            if isinstance(self.items_container, dict):
                _single = self.items_container.get("text_watermark")
            else:
                _single = getattr(self.items_container, "text_watermark_settings", None)
            if isinstance(_single, dict):
                _single["enabled"] = False
                _single["text"] = ""
        except Exception:
            pass

    def _sync_item_to_container(self):
        """把当前选中项实时写回容器（仅就地更新，不重建列表），让命令预览/预览窗口
        即时看到 X/Y/旋转/自旋等 live 改动，无需点「确定」。

        2026-08-26 修复：多实例后 self.settings 是容器项的副本，live trace 只写副本，
        容器直到 on_ok 才更新 →「坐标要保存后才能查看」。这里按当前索引就地 update。
        - dict 容器（队列 task.settings / 封装页 _merge_tw）→ 写 text_watermark_items[i]
          （容器无列表时写 text_watermark 单条兜底）；
        - 对象容器（主界面 app）→ 写 text_watermark_items[i]（空则写 text_watermark_settings）。"""
        try:
            idx = self._current_tw_idx()
            if idx is None or not (0 <= idx < len(self.items)):
                idx = 0
            if not (0 <= idx < len(self.items)):
                return
            it = self.items[idx]
            # 深拷贝合并：update 浅拷贝会把 move_waypoints 引用共享给容器项 → 列表轨迹多条串扰
            _it_copy = copy.deepcopy(it)
            if isinstance(self.items_container, dict):
                items = self.items_container.get("text_watermark_items")
                if isinstance(items, list) and idx < len(items):
                    items[idx].update(_it_copy)
                else:
                    _single = self.items_container.get("text_watermark")
                    if isinstance(_single, dict):
                        _single.update(_it_copy)
            else:
                items = getattr(self.items_container, "text_watermark_items", None)
                if isinstance(items, list) and idx < len(items):
                    items[idx].update(_it_copy)
                else:
                    _single = getattr(self.items_container, "text_watermark_settings", None)
                    if isinstance(_single, dict):
                        _single.update(_it_copy)
        except Exception:
            pass

    def _edit_tw_wp_point(self, row_idx, which, cur_x, cur_y, cur_angle, apply_xy, apply_angle, t0=0.0,
                          active_flag=None, w=None):
        """列表轨迹行的坐标可视化编辑（文字水印：单框，起点/终点各一个入口按钮）。
        2026-09-02：旋转手柄拖拽经 angle_cb 写回航点 ra/rb（选起点→ra，选终点→rb）。"""
        app = getattr(self, "app", None)
        if app is None:
            apply_xy(cur_x, cur_y)
            return
        mw, mh = 1280, 720
        _f = ""   # 2026-08-27：try 外初始化，供下方 main_video_file 透传（异常时回退空→纯黑）
        try:
            _f = ""
            # 上下文主视频优先（队列=task.input / 封装=merge_video或主轨）
            if getattr(self, "canvas_file", ""):
                _f = str(self.canvas_file).strip()
            # 2026-09-23：未给出语境时按宿主页作用域在本页内找，绝不再回退另一页
            # （旧代码先 input_file 再 merge_video，封装页会错取转换页画面帧）。
            if not _f or not os.path.exists(_f):
                _pf, _unused = _page_main_video(
                    app, getattr(self, "canvas_scope", None) or "convert")
                _f = _pf or ""
            if alert_if(not _f or not os.path.exists(_f), _("提示"), _("请先设置主视频后再使用可视化坐标编辑"), 'info'):
                return
            _wd, _hd = app._get_video_dimensions_cached(_f)
            mw, mh = _wd or 1280, _hd or 720
            # 2026-08-28：画布优先取主视频渲染尺寸（裁剪/缩放/旋转后），否则 overlay 坐标错位。
            # 2026-09-03（问题④）：设置源=上下文显式 canvas_settings（队列 task.settings /
            # 封装主轨 enc_settings），None 才回退转换页 get_current_settings。
            _ctx_s = getattr(self, "canvas_settings", None)
            _ms0 = _ctx_s or (app.get_current_settings() if hasattr(app, "get_current_settings") else None)
            if _ms0 and hasattr(app, "_main_render_size"):
                try:
                    _rw0, _rh0 = app._main_render_size(_ms0, _f)
                    if _rw0 and _rh0:
                        mw, mh = int(_rw0), int(_rh0)
                except Exception:
                    pass
        except Exception:
            pass
        wm_w, wm_h = 160, 40
        try:
            # 富文本换行（2026-09-25）：与渲染端统一。multiline 开保留换行（高盒）、
            # 关拼成一行（矮盒），与最终渲染严格一致。
            _ml = bool(getattr(self, "multiline_var", None) and self.multiline_var.get())
            _txt = _tw_effective_text({"text": self.text_var.get(),
                                       "multiline": _ml}) or _("水印")
            _fs = int(float(self.size_var.get() or 24))
            # 外部字体优先（与 _collect_tw_form / 滤镜侧同语义。注：当前 estimate_text_size
            # 并不消费 font_path，仅纯字符宽度估算；此处保持一致是为将来按字体度量估算预留）
            _ext_fp = self.ext_font_var.get().strip() if hasattr(self, "ext_font_var") else ""
            _fp = _ext_fp or (resolve_cn_font_path(self.font_var.get()) if hasattr(self, "font_var") else "")
            _tw, _th = estimate_text_size(_txt, _fp, _fs)
            wm_w, wm_h = _tw + 16, _th + 16
        except Exception:
            pass
        # 2026-10-05：框内渲染**真实文字**（drawtext → 带 alpha 透明 PNG）——与独立的
        # 「可视化编辑文字水印位置」窗口同款。此前本入口（列表轨迹 起始/结尾 左侧按钮）
        # 走的是 open_watermark_overlay_editor 的旧 content_file 语义（这里压根没传
        # content_file），框内是空的透明框 + "文字水印" 占位 label，两个问题一起解决。
        # 文字取当前表单实时值（用户可能刚改完文字/字体/字号就点进来）。
        # ⚠️ 全局开关「位置编辑器显示框内真实帧」关闭时不生成（省一次 ffmpeg，编辑器回退虚拟框）。
        _tw_preview_png = None
        with suppress(Exception):
            _rf_var = getattr(app, "editor_real_frame", None)
            if _rf_var is None or bool(_rf_var.get()):
                _tw_probe = {
                    "text": self.text_var.get(),
                    "multiline": bool(getattr(self, "multiline_var", None) and self.multiline_var.get()),
                    "font_name": self.font_var.get() if hasattr(self, "font_var") else _("微软雅黑"),
                    "font_path": self.ext_font_var.get().strip() if hasattr(self, "ext_font_var") else "",
                    "font_size": _opt_int(self.size_var.get(), 48),
                    "font_color": self.color_var.get() if hasattr(self, "color_var") else "#FFFFFF",
                    "opacity": (_opt_float(self.opacity_var.get(), 100) / 100.0
                                if hasattr(self, "opacity_var") else 1.0),
                    "border_w": _opt_int(self.border_w_var.get(), 0) if hasattr(self, "border_w_var") else 0,
                    "border_color": (self.border_color_var.get() if hasattr(self, "border_color_var")
                                     else "#000000"),
                }
                _tw_preview_png = _render_text_watermark_preview_png(
                    app.ffmpeg_cmd, _tw_probe, int(wm_w), int(wm_h))
        # 背景帧预处理：主视频 crop/rotate（防「渲染尺寸画布+完整原帧=变形」，2026-08-28）。
        # 2026-09-03（问题④）：设置源=上下文 canvas_settings 优先，None 才回退转换页全局。
        _bg_filter = None
        try:
            _ms1 = getattr(self, "canvas_settings", None)
            if not _ms1:
                _ms1 = app.get_current_settings() if hasattr(app, "get_current_settings") else None
            if _ms1:
                _bg_filter = _main_bg_pre_filter(_ms1)
        except Exception:
            _bg_filter = None
        vx = tk.StringVar(value=f"{int(round(cur_x)):d}")
        vy = tk.StringVar(value=f"{int(round(cur_y)):d}")
        # 2026-10-07：起始/结尾**各自**缩放（sa/sb），与「水印 / 子视频轨迹航点」编辑器同口径。
        # 基准 = 全局文字内容盒 wm_w×wm_h（由对话框「字体大小」决定；sa/sb = 相对倍率，缺省 1.0）。
        # ⚠️ 根因（用户实测）：「文字水印位置编辑器不支持起始/结尾不同缩放，一缩放就是全局缩放」——
        #   此前本入口把「重绘尺寸」直接写回**全局 font_size**（见下方 legacy 分支），
        #   于是在一端拉大盒子 = 改全局字号 ⇒ 两端必然同大小、且弹窗里其它入口的字号也一起变。
        #   现改为按【当前活动端】写 sa/sb（与 _edit_row_dialog 的「起始/结尾缩放(倍)」同语义、
        #   同一份数据）：坐标仍恒指「缩放后内容盒左上角」，缩放锚点=左上角，x/y 表达式零补偿。
        #   渲染端已消费 zoom（build_drawtext_filter / build_text_watermark_filtergraph 的
        #   fontsize 逐帧表达式，矢量重绘）⇒ 拖多大就是多大，所见即所得。
        _init_s = 1.0
        if (w is not None) and (active_flag is not None):
            _init_s = _opt_float(w.get("sb" if active_flag[0] == "end" else "sa", 1.0) or 1.0, 1.0)
            if _init_s <= 0:
                _init_s = 1.0

        def _wp_on_apply(nx, ny, nw, nh, ncw, nch):
            vx.set(str(int(round(nx)))); vy.set(str(int(round(ny))))
            # 坐标：按活动端写回 xa/ya | xb/yb + 刷列表（与 on_drag_commit 同一入口，幂等）
            with suppress(Exception):
                apply_xy(float(nx), float(ny))
            if (w is None) or (active_flag is None) or (wm_w <= 0):
                # 无航点上下文（历史调用方）→ **保留旧行为**：矩形高反推全局字号。
                with suppress(Exception):
                    if nh > 0:
                        _nlines = max(1, str(self.text_var.get() or "").count("\n") + 1)
                        _new_fs = max(8, int(round((nh - 16) / (1.2 * _nlines))))
                        _old_fs = int(self.settings.get("font_size", self.size_var.get() or 48))
                        if _new_fs != _old_fs:
                            self.settings["font_size"] = _new_fs
                            with suppress(Exception):
                                self.size_var.set(_new_fs)
                            if self.tw_refresh:
                                with suppress(Exception):
                                    self.tw_refresh()
                            with suppress(Exception):
                                self.app._append_info_ui(
                                    _('[文字水印-轨迹] 字体大小已更新: {0} → {1}').format(_old_fs, _new_fs))
                return
            # 尺寸 → 该端缩放倍率（相对全局基准内容盒；终点行无独立结尾端 → sa/sb 同值，
            # 与 _apply_angle 的 ra/rb 同值策略一致）
            _ns = None
            try:
                _ns = float(nw) / float(wm_w)
            except (TypeError, ValueError, ZeroDivisionError):
                _ns = None
            if _ns and _ns > 0:
                with suppress(Exception):
                    if w.get("mode") == "end":
                        w["sa"] = _ns
                        w["sb"] = _ns
                    elif active_flag[0] == "end":
                        w["sb"] = _ns
                    else:
                        w["sa"] = _ns
                # sa/sb 变化 ⇒ zoom 表达式变化，命令预览必须重生成
                if self.tw_refresh:
                    with suppress(Exception):
                        self.tw_refresh()
                with suppress(Exception):
                    self.app._append_info_ui(
                        _('[文字水印-轨迹] 该端缩放已更新: {0}x{1}（倍率 {2:.4g}）').format(nw, nh, _ns))
        # 起始/结尾双端（条件调用）：仅当调用方传入 w + active_flag 时启用
        start_end = None
        _se_ctx = (w is not None) and (active_flag is not None)
        if _se_ctx:
            _se_can = (w.get("mode") != "end")   # 2026-09-12 修复：按数据模型判定——坐标相等(如粘贴连通)≠无第二端；仅终点行(mode=end)无独立结尾
            def _se_scale(key):
                # 2026-10-07：安全取该端缩放倍率（缺省/非法/非正 → 1.0=基准内容盒，旧工程行为不变）
                _s = _opt_float(w.get(key, 1.0) or 1.0, 1.0)
                return _s if _s > 0 else 1.0
            def _se_read(end):
                # 2026-10-07：尺寸按【端点】返回各自缩放后的内容盒 —— wm_w/wm_h = 全局基准内容盒，
                #   sa/sb = 该端缩放倍率。切换端点时盒子尺寸随之改变，与角度 ra/rb 对称。
                #   ⚠️ 原实现两端都返回同一个 wm_w/wm_h ⇒ 切端尺寸恒等 + on_apply 写全局字号
                #   ⇒ 视觉上「怎么调都只有一种大小」（用户实测根因）。
                if end == "end":
                    _sk = _se_scale("sb")
                    return (w.get("xb", 0), w.get("yb", 0),
                            max(int(round(wm_w * _sk)), 10), max(int(round(wm_h * _sk)), 10),
                            w.get("rb", 0))
                _sk = _se_scale("sa")
                return (w.get("xa", 0), w.get("ya", 0),
                        max(int(round(wm_w * _sk)), 10), max(int(round(wm_h * _sk)), 10),
                        w.get("ra", 0))
            def _se_switch(end):
                active_flag[0] = end
            def _se_time(end):
                # 2026-10-05：两端各取各的时刻 —— 起点端=start，结尾端=start+dur。
                # 位置编辑器据此换背景帧/内容帧，否则两端画面一模一样，看不出这一段的运动。
                _st = _opt_float(w.get("start", 0.0) or 0.0, 0.0)
                if end == "end":
                    return _st + _opt_float(w.get("dur", 0.0) or 0.0, 0.0)
                return _st
            start_end = {"active": ("end" if active_flag[0] == "end" else "start"),
                         "read": _se_read, "on_switch": _se_switch, "can_compare": _se_can,
                         "time": _se_time}
        app.open_watermark_overlay_editor(
            # 初始盒子 = 当前活动端缩放后的实际内容盒（否则滑块恒显 100%、与该端真实倍率不符；
            # 切到另一端时尺寸由 start_end["read"] 重载，2026-10-07 与子视频航点编辑器同口径）。
            mw, mh, max(int(round(wm_w * _init_s)), 10), max(int(round(wm_h * _init_s)), 10), vx, vy,
            # 内容源=全局基准内容盒 → 启用「缩放 (倍率)」滑块（100% = 基准字号的内容盒，
            # 与整行编辑弹窗的「起始/结尾缩放(倍)」同一份 sa/sb 数据）。
            # ⚠️ 条件透传：无航点上下文（w/active_flag 缺失）时传 None ⇒ 旧调用方不弹滑块、
            #    行为逐字节不变（缩放倍率语义只对航点行成立）。
            content_src_w=(wm_w if _se_ctx else None), content_src_h=(wm_h if _se_ctx else None),
            scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
            watermark_dict=None, filt_frame=None, parent=self, free_layout=False,
            main_video_file=_f,   # 2026-08-27：背景帧=实际主视频（封装页 merge_video / 转换页 input_file）
            bg_pre_filter=_bg_filter,   # 主视频 crop/rotate（防背景帧变形）
            init_angle=(cur_angle or 0.0),   # 2026-09-02：航点旋转接回 ra/rb
            angle_cb=apply_angle,   # 2026-09-02：旋转手柄拖拽 → 写回航点 ra/rb
            on_apply=_wp_on_apply,  # 2026-10-07：重绘/滑块 → 按端写回缩放倍率 sa/sb 并刷新
            on_drag_commit=apply_xy,  # 2026-09-03：拖拽松手即把坐标写回航点并实时刷新列表
            initial_time=t0,        # 背景帧=该航点自身时间（起始/结尾），与位置尺寸旋转列表一致
            # 2026-10-05：**虚拟框内部改为真实文字**——content_rgba=True 走 drawtext→透明
            # PNG 路径，框内显示真实文字（含长度/宽度），不再是空参考框。content_file 指向
            # 文字 PNG（非媒体文件），content_alpha=True 让编辑器走混合渲染：角度≈0 零
            # ffmpeg 跟随拖动，角度≠0 旋转后重合成且跟随框移动。
            # ⚠️ 文字 PNG 按**基准字号**渲染、编辑器内按倍率缩放显示（放大时框内文字略软）——
            #    这只是定位辅助；实际渲染走 fontsize 逐帧表达式=矢量重绘，预览/输出都是清晰的。
            content_file=_tw_preview_png, content_alpha=True, content_rgba=True,
            # 默认 draw_diagonal=True 会给矩形填 gray50 斜纹盖住内容 ⇒ 保持 False=仅描边。
            draw_diagonal=False,
            coord_box=True,
            start_end=start_end)
        try:
            apply_xy(float(vx.get()), float(vy.get()))
        except (ValueError, TypeError):
            pass

    def _open_rich_text_editor(self):
        """富文本编辑（2026-09-19）：多行文字，回车换行，确定后按 \\n 拼回文字内容。

        普通文字水印会把多行拼成一行渲染（单个 drawtext 塞真实换行字节只有部分版本
        ffmpeg 认）；倒计时模式才是真正的逐行排版消费方。"""
        dlg = tk.Toplevel(self)
        dlg.title(_("富文本（每行一条）"))
        dlg.transient(self)
        dlg.grab_set()
        dlg.resizable(True, True)
        body = ttk.Frame(dlg, padding=6)
        body.pack(fill=tk.BOTH, expand=True)
        ttk.Label(body, text=_("每行一条（直接回车换行）。倒计时模式按行逐行排版；普通模式会拼成一行显示。")).pack(anchor="w")
        txt = tk.Text(body, width=46, height=12, wrap="none", undo=True)
        txt.pack(fill=tk.BOTH, expand=True, pady=(4, 6))
        txt.insert("1.0", self.text_var.get())
        btns = ttk.Frame(body)
        btns.pack(fill=tk.X)

        def _ok():
            self.text_var.set(txt.get("1.0", "end-1c"))
            dlg.destroy()

        ttk.Button(btns, text=_("确定"), command=_ok, width=10).grid(row=0, column=0, padx=5)
        ttk.Button(btns, text=_("取消"), command=dlg.destroy, width=10).grid(row=0, column=1)
        dlg.update_idletasks()
        dlg.geometry("+%d+%d" % (self.winfo_rootx() + 50, self.winfo_rooty() + 50))
        txt.focus_set()

    def _open_countdown_window_editor(self):
        """倒计时显示窗口框选（2026-09-19）：按当前文本/字号画画布示意图，
        拖动窗口=移动、拖右下角手柄=改尺寸，确定写回 X/Y/宽/高 四个数值。

        示意图是纯 Tk 画的槽位框（不渲染真字、不碰 ffmpeg）：每个矩形=一行/列的
        槽位（与 countdown_layout 的几何严格一致），足够表达窗口与内容的相对关系。
        """
        # 先收集当前表单，保证基于最新文本/字号/行距画图
        idx = self._current_tw_idx()
        if idx is None and self.items:
            idx = 0
        if idx is not None and 0 <= idx < len(self.items):
            self._collect_tw_form(idx)
        s = self.settings
        font_path = s.get("font_path", "") or resolve_cn_font_path(s.get("font_name", _("微软雅黑")))
        fs = _opt_int(s.get("font_size", 48), 48)
        lay = countdown_layout(s, font_path, fs)
        if alert_if(not lay, _("框选窗口"), _("请先填写文字内容并确认字体有效。"), 'info', parent=self):
            return
        cw, ch = lay["canvas_w"], lay["canvas_h"]
        scale = min(1.0, 460.0 / cw, 420.0 / ch)
        dw, dh = max(1, int(cw * scale)), max(1, int(ch * scale))
        # ⚠️ 坐标系必须唯一：内容按 scale 缩放成 dw×dh 后居中摆放，画布(视口)是
        # vw×vh。曾写成 vw=max(90, dw) 且槽位框直接用 vw 全宽、红框用 dw*scale，
        # 两套宽度不一致 → 竖排窄画布上红框只占槽位一半宽（2026-09-19 修复）。
        # 现在：所有绘制 = 偏移 + 真实坐标×scale；所有鼠标坐标 = (ev-偏移)/scale。
        vw, vh = max(140, dw), max(120, dh)
        ox, oy = (vw - dw) // 2, (vh - dh) // 2
        wx, wy, ww, wh = lay["win"]

        dlg = tk.Toplevel(self)
        dlg.title(_("框选倒计时显示窗口"))
        dlg.transient(self)
        dlg.grab_set()
        dlg.resizable(False, False)
        body = ttk.Frame(dlg, padding=6)
        body.pack(fill=tk.BOTH, expand=True)
        ttk.Label(body, text=_("灰色框=每行/列的槽位；红框=显示窗口。\n"
                             "在红框内拖动=移动；拖右下角实心手柄=改大小。")).pack(anchor="w")
        cv = tk.Canvas(body, width=vw, height=vh, bg="#F5F5F5",
                       highlightthickness=1, highlightbackground="#999999")
        cv.pack(pady=4)

        def _redraw():
            cv.delete("all")
            # 槽位框（几何与 countdown_layout 一致：行槽=画布宽 × pitch；列槽=pitch × 画布高）
            for i in range(len(lay["lines"])):
                if lay["horizontal"]:
                    sx = ox + (COUNTDOWN_PAD + i * lay["pitch"]) * scale
                    sy = oy
                    sw = lay["pitch"] * scale
                    sh = dh
                else:
                    sx = ox
                    sy = oy + (COUNTDOWN_PAD + i * lay["pitch"]) * scale
                    sw = dw
                    sh = lay["pitch"] * scale
                cv.create_rectangle(sx, sy, sx + sw, sy + sh,
                                    outline="#AAAAAA", dash=(3, 3))
                if sw > 16 and sh > 14:
                    cv.create_text(sx + sw / 2, sy + sh / 2,
                                   text=lay["lines"][i][:6], fill="#777777")
            cv.create_rectangle(ox + wx * scale, oy + wy * scale,
                                ox + (wx + ww) * scale, oy + (wy + wh) * scale,
                                outline="#D32F2F", width=2)
            cv.create_rectangle(ox + (wx + ww) * scale - 5, oy + (wy + wh) * scale - 5,
                                ox + (wx + ww) * scale + 5, oy + (wy + wh) * scale + 5,
                                fill="#D32F2F", outline="")
            cv.create_text(6, vh - 10, anchor="w", fill="#555555",
                           text=_("画布 %dx%d  窗口 %dx%d @(%d,%d)") % (cw, ch, ww, wh, wx, wy))

        _st = {"mode": None, "dx": 0, "dy": 0}

        def _down(ev):
            hx, hy = ox + (wx + ww) * scale, oy + (wy + wh) * scale
            if abs(ev.x - hx) <= 7 and abs(ev.y - hy) <= 7:
                _st["mode"] = "resize"
            else:
                x, y = (ev.x - ox) / scale, (ev.y - oy) / scale
                if wx <= x <= wx + ww and wy <= y <= wy + wh:
                    _st["mode"] = "move"
                    _st["dx"], _st["dy"] = x - wx, y - wy
                else:
                    _st["mode"] = None

        def _drag(ev):
            nonlocal wx, wy, ww, wh
            if not _st["mode"]:
                return
            x, y = (ev.x - ox) / scale, (ev.y - oy) / scale
            if _st["mode"] == "move":
                wx = int(max(0, min(x - _st["dx"], cw - ww)))
                wy = int(max(0, min(y - _st["dy"], ch - wh)))
            else:
                ww = int(max(8, min(x - wx, cw - wx)))
                wh = int(max(8, min(y - wy, ch - wy)))
            _redraw()

        cv.bind("<Button-1>", _down)
        cv.bind("<B1-Motion>", _drag)
        _redraw()

        btns = ttk.Frame(body)
        btns.pack(fill=tk.X, pady=(4, 0))

        def _ok():
            self.cd_winx_var.set(str(wx))
            self.cd_winy_var.set(str(wy))
            self.cd_winw_var.set(str(ww))
            self.cd_winh_var.set(str(wh))
            dlg.destroy()

        ttk.Button(btns, text=_("确定"), command=_ok, width=10).grid(row=0, column=0, padx=5)
        ttk.Button(btns, text=_("取消"), command=dlg.destroy, width=10).grid(row=0, column=1)
        dlg.update_idletasks()
        dlg.geometry("+%d+%d" % (self.winfo_rootx() + 40, self.winfo_rooty() + 40))

    def _open_position_editor(self):
        """直接在对话框内打开文字水印可视化位置编辑器（无需关闭本窗口）。

        位置编辑器本身是模态的（会接管输入），这里先释放本对话框的模态 grab，
        待编辑器关闭后再恢复，避免两个模态窗口抢夺输入焦点。

        2026-08-26：编辑器统一以「当前选中项 self.settings」为读写目标——
        - 封装页入口传入 position_editor_cb（直接编辑 self.settings）；
        - 转换页/队列入口委托 parent._open_text_wm_position_editor，先同步当前项
          到 parent.tw_settings，编辑器关闭后再取回，避免多实例后写到无关 dict。
        """
        # 先把当前表单收集进当前项，保证编辑器基于最新内容
        idx = self._current_tw_idx()
        if idx is None and self.items:
            idx = 0
        if idx is not None and 0 <= idx < len(self.items):
            self._collect_tw_form(idx)
            self.settings = self.items[idx]
        with suppress(Exception):
            self.grab_release()
        if self._pos_editor_cb is not None:
            try:
                self._pos_editor_cb(self)
            finally:
                with suppress(Exception):
                    self.grab_set()
        elif hasattr(self.parent, "_open_text_wm_position_editor"):
            # 转换页/队列：直接用对话框当前选中项 self.settings 作编辑器读写目标——
            # 废除经 parent.tw_settings 的 clear/update 转手。原写法在首次打开时
            # parent.tw_settings 为陈旧/被清空对象，写回落不到 self.settings，表现为
            # 「绘制不生效，须关窗重开让引用重新对齐才生效」（2026-09-02 修复）。
            try:
                self.parent._open_text_wm_position_editor(tw_override=self.settings)
            finally:
                with suppress(Exception):
                    self.grab_set()
        # 编辑器会把「绘制矩形的高度」反推的字体大小回写到文字水印设置，
        # 此处必须把本对话框的 font_size 输入框同步刷新，否则点击「确定」时 on_ok 会用
        # 旧的 size_var 把回写值覆盖掉，导致「绘制矩形→回写字体大小」看起来像没生效。
        try:
            new_fs = int(self.settings.get("font_size", self.size_var.get()))
            self.size_var.set(new_fs)
        except (ValueError, TypeError):
            pass
        # 同步 X/Y 编辑框：可视化编辑器会把拖拽结果写回 overlay_x/overlay_y
        try:
            self.tw_x_var.set(str(self.settings.get("overlay_x", "10")))
            self.tw_y_var.set(str(self.settings.get("overlay_y", "10")))
        except Exception:
            pass
        # 编辑器已写回当前项 → 同步容器，预览/命令即时生效
        self._sync_item_to_container()

    def _context_main_video(self):
        """当前对话框上下文的主视频（叠加层时间线基准，时间预览/轨迹/位置编辑器共用）：
        canvas_file（队列=task.input / 封装=merge_video或主轨）→ 本页主视频。
        2026-09-23：两页禁止互相兜底——canvas_scope='merge' 只取封装页主视频，
        其余只取转换页输入文件；本页没有就是空串（调用方各自提示/纯黑）。"""
        if getattr(self, "canvas_file", ""):
            return str(self.canvas_file).strip()
        app = getattr(self, "app", None)
        if app is None:
            return ""
        try:
            _pf, _unused = _page_main_video(app, getattr(self, "canvas_scope", None) or "convert")
            if _pf and os.path.exists(_pf):
                return _pf
        except Exception:
            pass
        return ""

    def _open_simple_preview_tw(self):
        """简易时间预览（纯帧浏览器）：回填文字水印 显示时段 起/止（秒）。
        不关闭窗口可连续设置；字段为秒数（between(t,start,end) 用 float 解析）。"""
        if not self.app:
            return
        path = self._context_main_video()
        if alert_if(not path or not os.path.exists(path), _("错误"), _("主输入文件不存在"), 'error'):
            return
        if alert_if(not self.app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        release_grab(self.app.root)

        def on_start(t):
            self.enable_start_var.set(_ffsec(t))

        def on_end(t):
            self.enable_end_var.set(_ffsec(t))

        def _on_marks_to_tw(segs):
            """标记段 → 文字水印占位条目：深拷贝当前条目模板，文本=标记N、
            显示时段 enable_start/enable_end=段起止；逐条追加（无数量上限）。"""
            added = 0
            for i, (s, e) in enumerate(segs):
                if e <= s:
                    continue
                base = copy.deepcopy(self.settings) if self.settings else {}
                base["enabled"] = True
                base["text"] = _('标记{0}').format(len(self.items) + 1)
                # 轨迹独立空白（同 _add_tw_item 约定）
                base["move_mode"] = ""
                base["move_cycle"] = 4.0
                base["move_dwell"] = 2.0
                base["move_margin"] = "W*0.03"
                base["move_waypoints"] = []
                base["enable_start"] = _ffsec(s)
                base["enable_end"] = _ffsec(e)
                self.items.append(base)
                added += 1
            if added:
                self._refresh_tw_tree()
                self.tw_tree.selection_set(str(len(self.items) - 1))
                self.settings = self.items[-1]
                self._load_tw_form()
                self._tw_last_sel = len(self.items) - 1
            # 结果只写主窗口日志，不弹窗（弹窗会让预览窗口沉底、易堆积多个预览）
            with suppress(Exception):
                if self.app:
                    self.app._append_info_ui(
                        _('[水印] 简易预览已追加 {0} 个占位文字水印（文本=标记N，可修改内容）').format(added))

        # 回溯标记段：单选 → 只回该条；未选中（点列表空白取消选中）→ 全部条目的显示时段
        if self._current_tw_idx() is not None:
            initial_marks = [(self.settings.get("enable_start"), self.settings.get("enable_end"))]
        else:
            initial_marks = [(it.get("enable_start"), it.get("enable_end")) for it in self.items]
        self.app.show_time_picker(self.app.root, path, on_set_start=on_start,
                                  on_set_end=on_end, initial_marks=initial_marks,
                                  on_send_tw_items=_on_marks_to_tw)


class BlurFilterDialog(tk.Toplevel):
    """去水印/模糊设置窗口 - 支持从裁剪复制坐标"""
    def __init__(self, parent, filter_frame):
        super().__init__(parent)
        self.withdraw()
        self.filter_frame = filter_frame
        self.title(_("去水印 / 模糊设置"))
        self.transient(parent)
        self.grab_set()
        # 2026-10-04：resizable(False, False) → (True, True)。右侧预览是 PanedWindow 的
        # 一个 pane，用户要能拖 sash 加宽看细节（原来锁死 = 分隔条拖不动，只能看见 320px）。
        # 横向可拖也顺带让「按素材比例把预览框开大」这件事在窗口内就能完成。
        self.resizable(True, True)

        # 430 → 780，右侧多一列放 LiveFramePreview（delogo/局部滤镜实时预览）
        width, height = 780, 650
        center_window(self, width, height)
        
        self.create_widgets()
        self.load_settings()
        # 撤销快照：打开时拍下编辑前态（与 watermark 编辑器同款），供 apply 提交时 push
        # 到 convert scope。delogo/区域滤镜 此前未入栈 → 撤销栏不显示、Ctrl+Z 回不去。
        self._blur_undo_before = None
        _app = getattr(self.filter_frame, "app", None)
        if _app is not None and hasattr(_app, "_build_convert_state_dict"):
            self._blur_undo_before = _app._build_convert_state_dict()

    def _open_simple_preview_blur(self):
        """简易时间预览（纯帧浏览器）：回填当前 delogo/模糊项 显示时段 起/止（秒，主视频时间线）。
        不关闭窗口可连续设置；字段为秒数（between(t,start,end) 用 float 解析）。"""
        ff = self.filter_frame
        app = getattr(ff, "app", None)
        if alert_if(app is None, _("提示"), _("未找到主应用，无法预览")):
            return
        path = self._resolve_source()
        if alert_if(not path or not os.path.exists(path), _("错误"), _("主输入文件不存在"), 'error'):
            return
        if alert_if(not app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        release_grab(app.root)

        def on_start(t):
            self.enable_start_var.set(_ffsec(t))

        def on_end(t):
            self.enable_end_var.set(_ffsec(t))

        app.show_time_picker(app.root, path, on_set_start=on_start, on_set_end=on_end,
                             initial_marks=[(self.enable_start_var.get(), self.enable_end_var.get())])

    def _resolve_source(self):
        """本窗口加工「文件本身」（与截取 file_source 同语义）：队列=任务文件、
        封装页轨道=轨道文件；转换页 current_file 为空 → 回退转换页主视频。取不到返回空串。"""
        ff = self.filter_frame
        path = ""
        try:
            path = (getattr(ff, "current_file", None) or "").strip()
        except Exception:
            path = ""
        if not path or not os.path.exists(path):
            app = getattr(ff, "app", None)
            if app is not None and getattr(app, "input_file", None) is not None:
                with suppress(Exception):
                    path = app.input_file.get().strip()
        return path or ""

    # ---------- 右侧实时预览（2026-10-04：复用 LiveFramePreview，不另写第二份实现）----------
    def _form_to_item_dict(self):
        """把当前表单读成 blur item 字典。

        ⛔ **不碰 self.items** —— 右侧预览每次重绘都要读表单，若顺手写回列表就成了
        「预览即改数据」的副作用（列表摘要 / 单项 enabled 会被预览动作带跑）。
        也不带 `enabled`：单项启用只由列表「启用」列点击管理（见 _collect_form_to_item）。
        """
        _ftype = self.type_var.get()
        return {
            "type": _ftype,
            "strength": self.strength_var.get(),
            "x": self.x_var.get(),
            "y": self.y_var.get(),
            "w": self.w_var.get(),
            "h": self.h_var.get(),
            # 存储映射：区域效果类型用 full_frame 表达（不勾局部=全帧）；其余类型恒 False
            "region_only": bool(self.region_var.get()),
            "full_frame": (not bool(self.region_var.get())) if _ftype in self._REGION_EFFECTS else False,
            "enable_start": self.enable_start_var.get().strip(),
            "enable_end": self.enable_end_var.get().strip(),
            "enable_cycle": self.enable_cycle_var.get().strip(),
            "enable_show": self.enable_show_var.get().strip(),
            # 轨迹航点（内存态，由 _open_delogo_trajectory 回写；仅 delogo 消费）
            "waypoints": list(getattr(self, "_current_waypoints", []) or []),
        }

    def _preview_settings(self):
        """喂 build_blur_preview_cmd 的设置：只放当前选中项（右侧预览看的就是这一项）。

        坐标没填时返回 None → 预览显示原帧、状态行说明原因，
        而不是拼一条 `delogo=x=:y=…` 让 ffmpeg 报一堆错。
        """
        if not self.enabled_var.get():
            return None
        _it = dict(self._form_to_item_dict())
        # delogo 恒区域；其余类型只有勾了「仅应用到选定区域」才要坐标
        _need_xy = (_it["type"] == "delogo") or bool(_it["region_only"])
        # 2026-10-09：delogo 表达式轨迹（waypoints）由表达式驱动 x/y，不依赖静态 x/y 填空
        _has_wp = bool(_it.get("waypoints"))
        if _need_xy and not _has_wp and not (_it["x"].strip() and _it["y"].strip()):
            return None
        _it["enabled"] = True
        return {"blur_enabled": True, "blur_items": [_it]}

    def _preview_build_cmd(self, src, t, static, box_w, box_h, mode):
        """右侧实时预览的单帧命令。

        节点语境（`filter_frame` 挂了 `node_preview_cb`，2026-10-16 用户报障「组内节点的
        delogo 右边预览还是原始主视频的兜底小画面」）：背景改走**节点输出画面** —— 与左侧
        「🎯 可视化选区」同源（那边走 `node_frame_extractor`），同一窗口两处画面才一致。

        tail 只含「本窗口效果链 + 装框」：
          · `mode=="orig"`（按住看原图）⇒ 不套本窗口效果；
          · ⛔ **不插 setpts** —— 节点端已用 tap_seek（输入级 -ss）+ 图首 setpts 还原了
            真实时间戳；这里再插一次会把时段类 enable 判错（旧路径的 setpts 是给
            `build_blur_preview_cmd` 的输入级 -ss 归零做补偿的，节点路径没有这个问题）。
        """
        _app = getattr(self.filter_frame, "app", None)
        _cb = getattr(self.filter_frame, "node_preview_cb", None)
        if _cb is not None:
            _tail = []
            if mode == "proc":
                _sets = self._preview_settings()
                if _sets:
                    _blur = build_video_filter_chain(
                        dict(_sets),
                        include_subtitle=False, include_speed=False, include_trim=False,
                        include_format=False, include_scale=False, include_fade=False,
                        include_mask=False, chroma_settings=None)
                    if _blur:
                        _tail.append(_blur)
            _tail.append(_pv_fit_scale(box_w, box_h))
            _cmd = None
            with suppress(Exception):
                _cmd = _cb(t, ",".join(_tail))
            if not _cmd:
                # 🔴 2026-10-17 稳健兜底（父行右侧预览 t>0 黑）：node 语境下 `_cb(t>0)` 一旦
                # 抛异常 / 返回空（真实复杂组图里 retime 偶发），不再静默回落「源文件预览」——
                # 父行没有真实源文件，回落必黑。改为回落**同命令的 t=0 合成帧**（不经 tap_seek
                # ⇒ 不触发 retime，绝不抛），拿组组合成画面首帧（非黑）。普通子视频走不到这里
                # （`_cb` 为 None ⇒ 下方源文件兜底才是正确路径）。
                with suppress(Exception):
                    _cmd = _cb(0.0, ",".join(_tail))
            if _cmd:
                return _cmd
        return build_blur_preview_cmd(
            getattr(_app, "ffmpeg_cmd", None) or "ffmpeg", src, t,
            self._preview_settings() if mode == "proc" else None,
            static_image=static, box_w=box_w, box_h=box_h)

    def _preview_precheck(self, src, t, static):
        """delogo 区域自检 → (ok, 原因)。2026-10-06：用户报「delogo 首帧一直失败，只显示
        一个看不懂的报错」。

        实测两种失败 ffmpeg 都**沉默**：
          · 区域越界（x+w > 画面宽）→ 0 帧退出，stderr 末行只有 `Conversion failed!`，
            **不提 delogo 一个字**；
          · 坐标填 `iw/2` 这类相对式 → `Error when parsing the expression` + 末行
            `Error opening output files: Invalid argument`（也看不出是 delogo 的 x）。
        ⇒ 与其让用户猜，不如预览前按素材真实尺寸先判一遍，直接说该改哪个数值。

        ⛔ **只提示、绝不夹紧坐标**：预览必须与导出同源同参数（preview.md 铁律 6）。
        静默夹紧会造成「预览看着好、导出照样失败」的假象，比报错更糟。
        """
        _it = dict(self._form_to_item_dict())
        if str(_it.get("type") or "") != "delogo":
            return True, ""
        # ⚠️「启用去水印/模糊」总开关关着时 `_preview_settings()` 返回 None ⇒ 拼出来的
        # 命令里**根本没有 delogo**（2026-10-06 用户就是在这个状态下以为「预览坏了」：
        # 开关没开 → 右侧按设计显示未处理原帧、没有任何效果，然后被一句预检越界提示吓到）。
        # 命令里没有这个滤镜 ⇒ 预检也没有检查的对象，直接放行，免得「开关关着还报
        # 区域超出画面」这种张冠李戴的提示。
        _en = getattr(self, "enabled_var", None)
        if _en is not None and not _en.get():
            return True, ""
        _label = {"x": "X", "y": "Y", "w": _("宽"), "h": _("高")}

        def _node_canvas_size():
            """节点语境（2026-10-16）：越界判定的基准 = **节点输出尺寸**，不是源文件尺寸。

            组内节点的画面是**包装盒尺寸**（挂在 filt_frame.node_frame_orig_size 上），
            拿主视频宽高去判 delogo 越界会误报/漏报 —— 与「右侧预览一直是主视频兜底画面」
            是同一处语境缺失。非节点语境 → (None, None)，调用方回落 ffprobe 量源文件。

            🔴 2026-10-16 二轮（用户实测：「他显示的画面是正确的, 但是选框的比例是和原始
            包装盒大小的比例, 所以选的位置被放大后就会超出位置」）：`node_frame_orig_size`
            是**未缩放**的包装盒，而编辑器里看到的画面是**缩放后**的 —— 父行（独立素材）
            开了 scale 时，`_node_fx_excl` **保留 scale**（只刨 crop/rotate），渲染帧 =>
            **缩放后尺寸**。⇒ 判定基准必须与渲染帧**严格同尺寸**，否则选框按未缩放盒的
            比例画、画面按缩放后尺寸显示 ⇒ 选出的区域一放大就跑到框外（管道预览里
            delogo 一旦越界就 `Error reinitializing filters!` ⇒ 永远「正在加载预览」）。
            取法与遮罩蓝框（`open_watermark_overlay_editor` 里同款注释）**完全一致**：
            「包装盒作底 + 只套 scale」→ `compute_final_size_with_order`。scale 未开或
            求不出 ⇒ 回落未缩放盒（老行为逐字节不变）。
            """
            _os = getattr(self.filter_frame, "node_frame_orig_size", None)
            try:
                if _os:
                    _app = getattr(self.filter_frame, "app", None)
                    if _app is not None and hasattr(_app, "_node_canvas_space_size"):
                        _sz = _app._node_canvas_space_size(self.filter_frame, _os)
                        return int(_sz[0]), int(_sz[1])
                    return int(_os[0]), int(_os[1])
            except (ValueError, TypeError, IndexError, AttributeError):
                pass
            return None, None        # 2026-10-09：delogo 表达式轨迹（waypoints）—— x/y 是表达式、按源原生时间驱动，
        # 不再做「空值/非数字」判定（那样会误杀表达式）；改做段墙预检（撞墙=ffmpeg 静默
        # 0 帧，必须提前拦下）。w/h 恒静态、仍做 >0 与「不超过画面」判定。
        _wps = _it.get("waypoints") or []
        if _wps:
            try:
                _delogo_waypoints_to_exprs(_wps)
            except ValueError as _e:
                return False, str(_e)
            _v = {}
            for _k in ("w", "h"):
                _raw = str(_it.get(_k) or "").strip()
                if not _raw:
                    return False, _("去水印区域%s未填（delogo 需要完整 宽/高）") % _label[_k]
                _s = str(self._resolve_crop_coord(_raw) or "").strip() or _raw
                try:
                    _v[_k] = int(float(_s))
                except (ValueError, TypeError):
                    return False, (_("去水印%s=%s 不是像素数字（delogo 不支持 iw/2 这类表达式，"
                                   "请填具体像素）") % (_label[_k], _raw))
            if _v["w"] <= 0 or _v["h"] <= 0:
                return False, _("去水印宽高必须大于 0（当前 %dx%d）") % (_v["w"], _v["h"])
            _app = getattr(self.filter_frame, "app", None)
            _fp = getattr(_app, "ffprobe_cmd", None)
            _W, _H = _node_canvas_size()
            if not _W or not _H:
                with suppress(Exception):
                    _W, _H = get_video_dimensions(_fp, src)
            if _W and _H:
                if _v["w"] > _W - 1 or _v["h"] > _H - 1:
                    return False, (_("去水印区域宽/高超出画面：宽=%d（画面宽 %d，需 ≤%d）／"
                                   "高=%d（画面高 %d，需 ≤%d）")
                                   % (_v["w"], _W, _W - 1, _v["h"], _H, _H - 1))
            return True, ""
        _v = {}
        for _k in ("x", "y", "w", "h"):
            _raw = str(_it.get(_k) or "").strip()
            if not _raw:
                return False, _("去水印区域%s未填（delogo 需要完整 X/Y/宽/高）") % _label[_k]
            # 相对式（iw/2 等）先求值：delogo 只认像素数字
            _s = str(self._resolve_crop_coord(_raw) or "").strip() or _raw
            try:
                _v[_k] = int(float(_s))
            except (ValueError, TypeError):
                return False, (_("去水印%s=%s 不是像素数字（delogo 不支持 iw/2 这类表达式，"
                               "请填具体像素）") % (_label[_k], _raw))
        if _v["w"] <= 0 or _v["h"] <= 0:
            return False, _("去水印宽高必须大于 0（当前 %dx%d）") % (_v["w"], _v["h"])
        # ⚠️ 安全域是「四周留 ≥1 像素」，不是「不超出画面」（2026-10-06 实测 320x180）：
        #   x=y=0 → 失败；x=y=1 → 通过；x+w=319 → 通过；x+w=320 → 失败。
        #   即要求 x≥1、y≥1、x+w ≤ 画面宽-1、y+h ≤ 画面高-1。
        #   与 `_delogo_safe` 的夹紧口径逐字一致（那份注释写的是同一个实测结论）。
        #   ⛔ 别按「不超出画面」判 —— 那会放过 x=0 / x+w==iw 这两种必失败的情形，
        #   而 ffmpeg 对它们同样只吐一句看不懂的 `Failed to configure input pad`。
        if _v["x"] < 1 or _v["y"] < 1:
            return False, (_("去水印区域必须离画面上/左边≥1 像素（当前 X=%d Y=%d，最小 1）")
                           % (_v["x"], _v["y"]))
        _app = getattr(self.filter_frame, "app", None)
        # ⚠️ 这里的尺寸必须取**旋转前（原始）**的 —— 2026-10-06 实测打脸旧注释：
        #   「元数据 rotation=90 的 1280x720 素材」跑 `-vf delogo=x=1179:y=1:w=1:h=1`
        #   **仍然合法**（x+w=1180 ≤ 1279）⇒ delogo 看到的是**原始 1280 宽**，
        #   ffmpeg 的自动旋转发生在**滤镜之后**（CLI 的 auto-rotate 追加在 -vf 末端），
        #   不会把宽高交换后喂给区域滤镜。
        #   ⇒ 用 get_video_dimensions（原始尺寸）。用 get_video_rotated_dimensions
        #   会把宽高交换 ⇒ 对 rotation=90 素材：X 轴过严（明明合法却报越界，误报）、
        #   Y 轴过松（非法区域放行 → ffmpeg 才吐一句看不懂的 `Logo area is outside`）。
        #   这里必须用与预览/导出滤镜链同一个口径（区域链恒在 rotate 之前），
        #   否则就是「预检说没毛病、ffmpeg 照样失败」的假象（preview.md 铁律 6）。
        _fp = getattr(_app, "ffprobe_cmd", None)
        _W, _H = _node_canvas_size()
        if not _W or not _H:
            with suppress(Exception):
                _W, _H = get_video_dimensions(_fp, src)
        if not _W or not _H:
            return True, ""      # 量不到尺寸就放行，交给 ffmpeg 自己判
        # ⚠️ 这里**不要再**给「素材比区域还小」单开一条提示分支（2026-10-06 加过又删）：
        #    w ≥ 画面宽 必然推出 x+w > 画面宽-1 ⇒ 已经被下面那条越界提示替覆盖，
        #    再来一句「素材比区域还小」只是同义重复，还多一条 multi 版要 port 的 i18n 文案
        #    （多语言版靠 `_()` 逐条同步，冗余文案是真成本）。越界提示本身就点名了
        #    「画面宽 %d，需 ≤%d」，照着改即可。
        if _v["x"] + _v["w"] > _W - 1 or _v["y"] + _v["h"] > _H - 1:
            return False, (_("去水印区域超出画面：X+宽=%d（画面宽 %d，需 ≤%d）／Y+高=%d"
                           "（画面高 %d，需 ≤%d） —— 请缩小区域或改坐标")
                           % (_v["x"] + _v["w"], _W, _W - 1,
                              _v["y"] + _v["h"], _H, _H - 1))
        return True, ""

    def _preview_status_extra(self, t, static):
        if static:
            return _("（静态图片，无时间轴，显示时段不参与判定）"), None
        if not self.enabled_var.get():
            # 用户 2026-10-06 的困惑就在这：开关没勾 ⇒ 右侧按设计显示未处理原帧，
            # 但他读成「没画面 / 取帧失败」。提示要**指着告诉他下一步做什么**（勾选），
            # 而不是陈述一个他看不懂的状态。
            return (_("「启用去水印/模糊」未勾选 —— 当前右侧是未处理原帧；"
                    "勾选该开关即可预览去水印效果"), None)
        if not (self.x_var.get().strip() and self.y_var.get().strip()):
            return _("坐标未填，无法定位区域"), None
        return _("局部滤镜坐标以【原始画面】为准（与导出一致）；按住图片看原图"), None

    def create_widgets(self):
        # ---- 左右分栏（2026-10-04 用户报「预览画面左右来回跳、尺寸适应不下来」）----
        # ⛔ 为什么必须学「高级增强」用 PanedWindow、不能把预览挂成 grid 第 4 列：
        #   grid 的列宽 = 该列子控件的**请求宽度**。预览面板内部状态行文案随内容变
        #   （「320x240 · 取帧 3.00s」↔「局部滤镜坐标以【原始画面】为准…」），ttk.Label
        #   按最长一行算请求宽度 ⇒ 列宽在两个值间震荡 ⇒ 画布 <Configure> ⇒ 重取帧
        #   ⇒ 新文案宽度不同 ⇒ 再变。给 wraplength / pack_propagate(False) 都只是
        #   **压住一部分传导源**，外层 grid 仍会重算列宽。PanedWindow 的 pane 宽度
        #   由 sash 的显式几何决定，与任何子控件请求尺寸无关 ⇒ 结构上不可能震荡
        #   （open_enhance_window 的预览栏从上线起就没这个毛病，正是因为它在 paned 上）。
        #   保留旧实现仍用 grid 的话就是「补了传导源、没断传导链」，压不干净。
        paned = ttk.PanedWindow(self, orient=tk.HORIZONTAL)
        paned.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        main = ttk.Frame(paned)          # 左 pane：原表单（列 0~2 完全不动）
        paned.add(main, weight=3)

        # ---- 启用（总开关）----
        self.enabled_var = tk.BooleanVar(value=self.filter_frame._blur_enabled.get())
        chk = ttk.Checkbutton(main, text=_("启用去水印/模糊"), variable=self.enabled_var)
        chk.grid(row=0, column=0, columnspan=3, sticky="w", pady=5)
        ToolTip(chk, _("勾选后将在视频滤镜链中插入去水印或模糊滤镜"))

        # ---- 多区域列表（2026-08-26：可添加多个 delogo/模糊项）----
        list_frame = ttk.LabelFrame(main, text=_("多区域（可添加多个 delogo / 模糊项）"), padding="3")
        list_frame.grid(row=1, column=0, columnspan=3, sticky="ew", pady=3)
        self.tree = ttk.Treeview(list_frame, columns=("en", "type", "coord"),
                                 show="headings", height=4)
        self.tree.heading("en", text=_("启用"))
        self.tree.heading("type", text=_("类型"))
        self.tree.heading("coord", text=_("坐标 / 摘要"))
        self.tree.column("en", width=44, anchor="center")
        self.tree.column("type", width=72)
        self.tree.column("coord", width=210)
        self.tree.pack(fill=tk.X, padx=3, pady=(3, 1))
        self.tree.bind("<<TreeviewSelect>>", self._on_tree_select)
        self.tree.bind("<ButtonRelease-1>", self._on_tree_click)
        tbl_row = ttk.Frame(list_frame)
        tbl_row.pack(fill=tk.X, padx=3, pady=(0, 3))
        ttk.Button(tbl_row, text=_("添加"), width=5, command=self._add_blur_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tbl_row, text=_("删除"), width=5, command=self._del_blur_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tbl_row, text=_("上移"), width=5, command=lambda: self._move_blur_item(-1)).pack(side=tk.LEFT, padx=1)
        ttk.Button(tbl_row, text=_("下移"), width=5, command=lambda: self._move_blur_item(1)).pack(side=tk.LEFT, padx=1)
        ttk.Label(tbl_row, text=_("点「启用」列可切换"), foreground="gray").pack(side=tk.LEFT, padx=8)
        self._last_sel = None
        self.items = []

        # ---- 滤镜类型（编辑当前选中项）----
        _lbltt10 = ttk.Label(main, text=_("滤镜类型:"))
        _lbltt10.grid(row=2, column=0, sticky="w", pady=5)
        self.type_var = tk.StringVar(value=self.filter_frame._blur_type.get())
        type_combo = ttk.Combobox(main, textvariable=self.type_var,
                                  values=["delogo", "boxblur", "gblur", "negate",
                                          "hflip", "vflip", "swapuv", "desat", "eq_bright",
                                          "unsharp", "avgblur", "median",
                                          "black", "white"],
                                  state="readonly", width=12)
        type_combo.grid(row=2, column=1, sticky="w", padx=5)
        type_combo.bind("<<ComboboxSelected>>", self.on_type_change)
        ToolTip(_lbltt10,
            _("【滤镜类型说明】\n"
            "• delogo：智能去水印滤镜，需指定区域坐标（用周围像素填充），本身就只作用于选定区域。\n"
            "• boxblur / gblur：模糊滤镜；勾「仅应用到选定区域」=局部模糊，不勾=全帧模糊。\n"
            "• 其余类型统称「区域效果」：勾「仅应用到选定区域」时恒作用于坐标框内：\n"
            "  negate 局部反色（把坐标框内画面逐通道反相 255-x，无强度参数；\n"
            "  与子视频混合模式里的 negation 公式完全不同）；\n"
            "  hflip / vflip 局部水平 / 垂直镜像（盖水印时比 delogo 插值更自然）；\n"
            "  swapuv 局部交换 U/V（色差故障风）；desat 局部去色；eq_bright 局部明暗；\n"
            "  black / white 局部纯黑 / 纯白遮盖；unsharp 局部锐化；\n"
            "  avgblur / median 局部均値模糊 / 中值（去小斑点、小 logo）。\n"
            "  不勾（全帧）时配合「显示时段」即时间段效果：\n"
            "  例：eq_bright + 不勾 + 显示时段 5~8 = 仅 5~8 秒整幅画面提亮。\n\n"
            "【局部滤镜如何实现】\n"
            "勾「仅应用到选定区域」时，程序会自动生成分支滤镜图（不再需要手写快速命令）：\n"
            "  split=2[bg][fg];[fg]crop=宽:高:X:Y,boxblur=..[bl];[bg][bl]overlay=X:Y\n"
            "该子图会被放在滤镜链最前面，先于裁剪 / 旋转 / 缩放 / 亮度等滤镜执行，\n"
            "因此这里填的坐标始终以【原始画面】为准，不会被后续裁剪或缩放带偏；\n"
            "若同时启用绿幕抠图，抠图会自动排在本区域链之前，区域颜色处理不影响抠像。\n"
            "卷积类（模糊 / 锐化 / 描边 / 中值）会自动向外多裁一圈、处理完再裁回，\n"
            "避免区域边缘出现方块接缝（实测边缘误差由 11dB 降到 65dB）。")
        )

        # 一键切换到局部应用
        btn_region = ttk.Button(main, text=_("🎯 局部应用"), command=self.quick_region_blur)
        btn_region.grid(row=2, column=2, sticky="w", padx=5)
        ToolTip(btn_region,
            _("一键把当前效果配置为「仅应用到选定区域」（局部滤镜）：\n"
            "1. 勾选「启用去水印/模糊」；\n"
            "2. 若当前是 delogo，自动切换为 boxblur；\n"
            "3. 勾选「仅应用到选定区域」并解锁坐标框；\n"
            "4. 坐标为空时自动从「裁剪」设置带入。\n\n"
            "应用后命令里的 -vf 会自动变成带分支的滤镜图，\n"
            "局部滤镜排在最前（先于裁剪/旋转/缩放），坐标以原始画面为准。"))

        # ---- 强度参数 + 局部模糊开关 ----
        self.strength_frame = ttk.Frame(main)
        self.strength_frame.grid(row=3, column=0, columnspan=3, sticky="w", pady=5)
        self.strength_label = ttk.Label(self.strength_frame, text=_("强度/半径:"))
        self.strength_label.pack(side=tk.LEFT)
        self.strength_var = tk.StringVar(value=self.filter_frame._blur_strength.get())
        self.strength_entry = ttk.Entry(self.strength_frame, textvariable=self.strength_var, width=8)
        self.strength_entry.pack(side=tk.LEFT, padx=5)
        ToolTip(self.strength_label,
                _("boxblur：半径（整数，默认5）\n"
                "gblur：sigma（浮点数，默认2.0）\n"
