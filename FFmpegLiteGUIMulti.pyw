def _mask_shape_movie_path(path):
    """遮罩形状图路径 → movie 滤镜可用路径；不可用返回 None。

    build_video_filter_chain 是模块级函数拿不到 self._movie_path_safe（实例方法），
    此处独立实现同款两步：反斜杠→正斜杠、冒号双重转义 \\\\（filtergraph 层 + movie 参数层
    各吃一次转义，单层 \\: 会被 graph 解析成裸冒号 → avformat_open_input 'C' 截断，
    与 _movie_path_safe 调用方 .replace(":", "\\\\:") 同款）。路径含 filtergraph 语法字符
    [ ] ' , ; 时（实测无法转义，见 _movie_path_safe 注释）→ 源文件同目录建临时硬链接
    改名（同盘必成功，不复制），登记进 _PREVIEW_LINKS 由程序退出统一清理；失败返回 None。
    """
    if not path or not os.path.exists(path):
        return None
    p = str(path).replace("\\", "/")
    if re.search(r"[\[\]',;]", p):
        try:
            h = hashlib.md5(p.encode("utf-8")).hexdigest()[:12]
            ext = os.path.splitext(p)[1] or ".png"
            target = os.path.join(os.path.dirname(p),
                                  f"ffmpeg_maskshape{h}_cache{ext}")
            if not os.path.exists(target):
                os.link(path, target)
            _PREVIEW_LINKS[str(path)] = target
            p = target
        except OSError:
            return None
    return p.replace(":", "\\\\:")


# 2026-09-11：遮罩「多形状列表」滤镜拼装（方案 B / Option 1）。
# 单一 matte 平面：底色涂满 → 每个形状各成一路独立源（矩形=color= 纯色画布，PNG=movie 载图）
# 缩放后 overlay 到同一块底 matte；非自己时段由 build_waypoint_expr 的 mode=hide 输出
# x/y=-100000 把形状移出画面（瞬切，与 Shotcut 同构）。全程只 format=rgba 一次、blend=multiply 一次，
# 规避「多段 rgba 串联」格式协商坑（tests/_probe_mask_multi_overlay.py 已验证 alpha 无 6% 残留）。
# 依赖（均为模块级）：build_waypoint_expr / _mask_shape_movie_path / _timeline_convert /
# _trim_speed_from_settings / MASK_TRAJ_CANVAS_W/H。
def _mask_rot_bbox(w, h, rot=0):
    """w×h 形状绕自身中心转 rot 度后的**最小轴对齐外接矩形**尺寸（整数像素）。

    对齐 Shotcut「Mask: Simple Shape」：它的 size-x/size-y 是**形状自身的外接尺寸**，
    旋转只改判据、不切形状 —— 形状若转出 w×h 仍是完整可见的（只被画幅边界切），
    因为它是在整幅画布上做「反变换 → 判不等式」，没有「size 窗口」这一层裁剪。

    矩形关于中心对称 ⇒ 外接矩形也居中，只需算半宽/半高：
      half_w = (w/2)·|cosθ| + (h/2)·|sinθ|
      half_h = (w/2)·|sinθ| + (h/2)·|cosθ|
    解析校验：0°/180° 恒等、90° 宽高互换、45° 得 ⌈(w+h)/√2⌉ 正方形、真圆(w==h) 仅 45° 放大。

    放大后画布的**中心与原 w×h 中心重合** ⇒ overlay 落位只需把左上角回移 (新-旧)/2，
    形状在画面里的位置不会因旋转而漂移。
    """
    try:
        _w = max(2.0, float(w))
        _h = max(2.0, float(h))
    except (TypeError, ValueError):
        _w = _h = 100.0
    try:
        _t = math.radians(float(rot or 0))
    except (TypeError, ValueError):
        _t = 0.0
    _c, _s = abs(math.cos(_t)), abs(math.sin(_t))
    if _c < 1e-9:
        _c = 0.0
    if _s < 1e-9:
        _s = 0.0
    _hw = (_w / 2.0) * _c + (_h / 2.0) * _s
    _hh = (_w / 2.0) * _s + (_h / 2.0) * _c
    # 至少 2px（color=/geq 的合法下限），并取整到整数像素（滤镜尺寸必须整数）
    return max(2, int(round(_hw * 2.0))), max(2, int(round(_hh * 2.0)))


def _shift_op(delta):
    """把偏移量渲染成可直接**字符串拼接**的带符号串（sendcmd suffix 用）。

    0 → ""（空串，拼上去不改变语义）；正数 → "+19"；负数 → "-19"（不会出 "+-19"）。
    """
    try:
        _d = float(delta)
    except (TypeError, ValueError):
        return ""
    if _d == 0.0:
        return ""
    return "%+g" % _d


def _mask_expr_shift(expr, delta):
    """给 overlay 的 x/y 表达式加一个**常数偏移**（用于旋转后的落位回移）。

    expr 可能是：
      · 裸数字          "0" / "123.5"
      · 已带单引号的表达式 "'(...) * main_w/640'"（_mask_shape_pos_expr 轨迹分支会带引号）
      · 多段 ffmpeg 表达式  "gte(t,0)*lt(t,1e+09)*(100+...)+gte(t,1e+09)*-100000"
    返回保持原引号形态的表达式。δ=0 时**原样返回**（老存档逐字节零变化）。

    ⚠️ **非纯数字时必须整体加括号**（2026-10-05 实测）：
       表达式尾段是 `*-100000`、δ=+10 时，裸拼成 `...-10000010`（正号被当成数字的一部分）
       ⇒ 数值放大一千万倍，形状飞出场外。`-10` 恰好拼成 `-100000-10` 语义正确，
       所以**只测负偏移会全绿、正偏移才炸** —— 必须两种都测。
    """
    try:
        _d = float(delta)
    except (TypeError, ValueError):
        return expr
    if _d == 0.0:
        return expr
    _s = str(expr)
    _q = ""
    if len(_s) >= 2 and _s[0] == "'" and _s[-1] == "'":
        _s = _s[1:-1]
        _q = "'"
    # 纯数字直接算完（避免生成 "0+-19" 这种冗余串）；非纯数字**一律整体加括号**
    try:
        return _q + "%g" % (float(_s) + _d)
    except ValueError:
        pass
    # ⚠️ 用 _shift_op 拿**带符号**串（"%+g"），不能用裸 "%g"：
    #    "%g" % 10.0 == "10"（无 + 号）⇒ 拼到 `...*-100000` 后面变成 `-10000010`（千万倍），
    #    而 δ=-10 时输出 "-10" 恰好拼成合法的 `-100000-10` ⇒ **只测负偏移会全绿**。
    return "%s(%s%s)" % (_q, _s, _shift_op(_d))


def _mask_shape_geq_expr(w, h, shape="rect", rot=0, cw=None, ch=None):
    """形状（圆/三角/菱形/带角度的矩形）的 geq 判据表达式：形状内=255、形状外=0。

    纯算法（逐像素判据），**不需要任何磁盘 PNG / 外部预处理图**。
    形状一律内切（内接）于框选的 w×h 包围盒：
      · circle  : 椭圆，(dx')²/rx² + (dy')²/ry² < 1（rx=w/2, ry=h/2）
      · triangle: 顶点 (0,-h/2)、底边 v=+h/2 半宽 rx ⇒ 外接框恰为 w×h、面积恰为 w·h/2
      · diamond : 四象限半平面 |dx'|/rx + |dy'|/ry < 1
      · rect    : 单矩形框（局部 |dx'|≤rx 且 |dy'|≤ry）。仅 **rot≠0** 才走本判据；
                   rot==0 时渲染侧仍走 `color=` 纯色块（不进 geq，见 _build_mask_multi_shape_filters）

    **旋转（rot，单位度，绕包围盒中心 = Shotcut Simple Shape Rotation 同口径）**：
      不去旋转像素、也不加 `rotate` 滤镜，而是在判据里先把像素坐标转进形状本机坐标系：
        dx = X-cx, dy = Y-cy
        dx' = dx·cosθ - dy·sinθ ;  dy' = dx·sinθ + dy·cosθ
      cosθ/sinθ 由 **Python 侧算成字面量**（若写 ffmpeg 的 `cos(PI*rot/180)`，逐像素要多调
      4 次三角函数，白扔 4~6% 性能）。

    **cw / ch = 形状层画布尺寸（2026-10-05 反裁剪修复）**：
      不传时默认等于 (w, h)（旧行为）。传入时（= `_mask_rot_bbox(w,h,rot)` 的结果），
      形状层画布放大到能容纳整个旋转后的形状，**判据中心用画布中心 (cw/2, ch/2)**、
      形状半径仍用原始 (w/2, h/2) ⇒ 形状在放大画布上居中且**完整不被裁**
      （对齐 Shotcut：它没有「size 窗口」这一层裁剪）。
      ⚠️ 中心必须用 cw/ch 而不是 w/h —— 否则形状会整体偏移 (cw-w)/2，转 90° 时肉眼可见。
      ⚠️ rot=0 时 `_mask_rot_bbox` 恒返回 (w, h) ⇒ 本参数与「不传」**逐字节等价**（老存档零回归）。

    ⚠️ 四个死坑（实测 tests/_probe_shape_rot_geq.py）：
      1. ffmpeg eval 的 `and()` / `or()` **只吃二元**，四条件报
         "Missing ')' or too many args" ⇒ 多条件必须写**连乘**（逻辑与）或**连加**（逻辑或）。
      2. 三角的半宽沿 v 线性张开 ⇒ 判据是**两条腰** + 纵向范围（见下），
         千万别写成 `|h·u - rx·v| <= rx·h/2` —— 那是**平行四边形**（每行宽度恒定），
         面积数值巧合同 w·h/2，只看面积测不出来，必须看「逐行宽度单调递增」+「质心偏移」。
      3. dx' / dy' 的主串必须**整体加括号**：它是「两项相减/相加」的串，
         `"%g*%s"` 会生成 `240*a-b`（系数只绑到第一项）、`"%s/%g"` 会生成 `a-b/rx`
         （除号只吃掉最后一项）⇒ 菱形转一下面积直接塌到 0.003、三角退化成平行四边形。
      4. rot=0 时本实现与改动前的旧判据**逐像素逐字节相同**（探针锁死）⇒ 老存档零回归。
    """
    _s = str(shape or "rect").strip().lower()
    # 画布中心（cw/ch 未传时 = w/h，退化为旧行为）
    _cw = float(cw) if cw else float(w)
    _ch = float(ch) if ch else float(h)
    _cx, _cy = _cw / 2.0, _ch / 2.0
    _rx = max(1.0, float(w) / 2.0)
    _ry = max(1.0, float(h) / 2.0)
    _th = math.radians(float(rot or 0))
    _c, _sn = math.cos(_th), math.sin(_th)
    if abs(_c) < 1e-9:
        _c = 0.0
    if abs(_sn) < 1e-9:
        _sn = 0.0
    # ⚠️ 坑 3：整体加括号（见 docstring）
    _dxp = "((X-%g)*%g-(Y-%g)*%g)" % (_cx, _c, _cy, _sn)   # dx'
    _dyp = "((X-%g)*%g+(Y-%g)*%g)" % (_cx, _sn, _cy, _c)   # dy'
    if _s in ("circle", "ellipse"):
        return ("if(lt(pow(%s,2)/pow(%g,2)+pow(%s,2)/pow(%g,2),1),255,0)"
                % (_dxp, _rx, _dyp, _ry))
    if _s == "triangle":
        # 本机坐标（顶点 (0,-h/2)、底边 v=+h/2 半宽 rx）在高度 v 处半宽 = rx·(v+h/2)/h
        #   ⇔  gte(h·u + rx·v + rx·h/2, 0) 且  gte(rx·h/2 - h·u + rx·v, 0) 且  lte(abs(v), h/2)
        return ("if((lte(abs(%s),%g)*gte(%g*%s+%g*%s+%g,0)"
                "*gte(%g-%g*%s+%g*%s,0)),255,0)"
                % (_dyp, h / 2.0, float(h), _dxp, float(_rx), _dyp, _rx * h / 2.0,
                   _rx * h / 2.0, float(h), _dxp, float(_rx), _dyp))
    if _s == "diamond":
        # 菱形 = 4 个象限的半平面「符号命中 × |dx'|/rx + |dy'|/ry < 1」，四象限结果**连加**（逻辑或）
        _q = []
        for _sx, _sy in ((1, -1), (1, 1), (-1, 1), (-1, -1)):
            _q.append(
                "gte(%g*%s,0)*gte(%g*%s,0)"
                "*lt(%g*%s/%g+%g*%s/%g,1)"
                % (_sx, _dxp, _sy, _dyp, _sx, _dxp, _rx, _sy, _dyp, _ry))
        return "if(gt(%s,0),255,0)" % "+".join(_q)
    if _s in ("rect", "rectangle"):
        # 矩形（2026-10-11：矩形旋转）：局部框 |u|≤rx 且 |v|≤ry —— rot 已在 dx'/dy' 里做完反变换。
        # ⚠️ geq 的 and() 只吃二元（见上方坑 1）⇒ 两个条件用连乘（逻辑与）。
        return ("if(lte(abs(%s),%g)*lte(abs(%s),%g),255,0)"
                % (_dxp, _rx, _dyp, _ry))
    return "255"


def mask_shape_outline_points(sh):
    """把一条 mask_shapes 条目（dict）解析成「画布坐标轮廓顶点表」（精确形状，供拼接对齐虚线）。

    ⚠️ 与渲染真源 `_mask_shape_geq_expr` 是**同一几何的第二份表述** —— 改一处必须同步另一处。
    几何（形状一律内切于 x/y/w/h 包围盒；旋转中心 = 包围盒中心 (x+w/2, y+h/2)）：
      · rect     : 四角局部 (-w/2,-h/2)…(w/2,h/2) 经 `_T` 变换。rot==0 时与轴对齐四角逐点相同；
                   rot≠0 时随形状旋转（2026-10-11：渲染侧矩形带角度也走 geq，与此同几何）。
      · circle   : 内切椭圆，采样成多边形（48 段）—— Tk 画不了「旋转椭圆」，采样可同时表达 rot。
      · triangle : 局部顶点 (0,-h/2)（顶点）、(-w/2,+h/2)、(w/2,+h/2)（底边）。
      · diamond  : 局部四顶点 (0,-h/2)、(w/2,0)、(0,h/2)、(-w/2,0)。
    旋转 rot（度）：与 geq 判据**同向** —— 局部位移 (u,v) → 画布 =(cx + c·u + s·v, cy - s·u + c·v)，
      c=cosθ、s=sinθ。这是从 `_mask_shape_geq_expr` 的 `dx'=dx·c-dy·sn; dy'=dx·sn+dy·c` 反解出来的
      （局部=R(θ)·偏移 ⇒ 偏移=R(-θ)·局部），**不要**改用 `rotate_rect_polygon`（那是 R(θ) 正转，方向相反）。
    PNG 形状（png_path 非空）：形状由外部图决定，轮廓退化为其 w×h 包围盒（渲染把图缩放到 w×h）。
    返回 [(x, y), ...]（画布像素坐标）。
    """
    try:
        _x = float(sh.get("x", 0) or 0)
        _y = float(sh.get("y", 0) or 0)
        _w = max(1.0, float(sh.get("w", 0) or 0))
        _h = max(1.0, float(sh.get("h", 0) or 0))
    except (ValueError, TypeError):
        return []
    _cx, _cy = _x + _w / 2.0, _y + _h / 2.0
    _rect = [(_x, _y), (_x + _w, _y), (_x + _w, _y + _h), (_x, _y + _h)]
    _shape = str(sh.get("shape", "") or "").strip().lower() or "rect"
    # PNG 形状：轴对齐包围盒（形状由外部图决定，rot 不参与）。
    # rect（2026-10-11）：支持旋转 —— rot≠0 时用 _T 变换四角；rot==0 结果与 _rect 逐点相同。
    if (str(sh.get("png_path", "") or "").strip()) or _shape not in (
            "circle", "ellipse", "triangle", "diamond", "rect", "rectangle"):
        return _rect
    try:
        _rot = float(sh.get("rot", 0) or 0)
    except (ValueError, TypeError):
        _rot = 0.0
    _th = math.radians(_rot)
    _c, _s = math.cos(_th), math.sin(_th)

    def _T(u, v):
        # 局部偏移 → 画布（与 geq 同向；见 docstring；坑：勿改符号）
        return (_cx + _c * u + _s * v, _cy - _s * u + _c * v)

    if _shape in ("rect", "rectangle"):
        return [_T(-_w / 2.0, -_h / 2.0), _T(_w / 2.0, -_h / 2.0),
                _T(_w / 2.0, _h / 2.0), _T(-_w / 2.0, _h / 2.0)]
    if _shape in ("circle", "ellipse"):
        _rx, _ry = _w / 2.0, _h / 2.0
        return [_T(_rx * math.cos(2.0 * math.pi * _k / 48.0),
                   _ry * math.sin(2.0 * math.pi * _k / 48.0)) for _k in range(48)]
    if _shape == "triangle":
        return [_T(0.0, -_h / 2.0), _T(-_w / 2.0, _h / 2.0), _T(_w / 2.0, _h / 2.0)]
    # diamond
    return [_T(0.0, -_h / 2.0), _T(_w / 2.0, 0.0), _T(0.0, _h / 2.0), _T(-_w / 2.0, 0.0)]


def mask_shape_render_box(sh):
    """一条 mask_shapes 条目在画布上的**渲染盒** (左上x, 左上y, 盒宽, 盒高)。

    与 `_build_mask_multi_shape_filters` **同几何**：带 rot 的形状层放大到 `_mask_rot_bbox`
    外接矩形、左上角回移 (cw-w)/2、(ch-h)/2 ⇒ 盒左上 = (x-(cw-w)/2, y-(ch-h)/2)。
    ⚠️ 渲染侧几何若改动，这里必须同步（否则布尔落位盒与真实渲染漂移）。
    """
    try:
        _w = max(2, int(float(sh.get("w", 100))))
        _h = max(2, int(float(sh.get("h", 100))))
    except (ValueError, TypeError):
        _w = _h = 100
    _x = _opt_float(sh.get("x", 0) or 0, 0.0)
    _y = _opt_float(sh.get("y", 0) or 0, 0.0)
    _rot = _opt_float(sh.get("rot", 0) or 0, 0.0)
    _shp = str(sh.get("shape", "") or "").strip().lower() or "rect"
    _rawp = str(sh.get("png_path", "") or "").strip()
    _cw, _ch = _mask_rot_bbox(_w, _h, _rot)
    _rect_rot = _shp in ("rect", "rectangle") and abs(_rot) > 1e-9
    if _rawp or (_shp not in ("circle", "ellipse", "triangle", "diamond")
                 and not _rect_rot):
        _cw, _ch = _w, _h
    return (_x - (_cw - _w) / 2.0, _y - (_ch - _h) / 2.0, _cw, _ch)


def mask_bool_merge_box(shapes, refs):
    """布尔结果落位盒 (x, y, w, h) = 各引用源**渲染盒的并集**；无有效源 → None。

    与 `_build_mask_multi_shape_filters` 里 `_bool_seg` 的画布口径一致：布尔画布 = 各源
    包围盒并集。这里只是把它算成 UI 可用的浮点盒（合成时用来初始化结果条目的 x/y/w/h）。
    """
    _bs = []
    for _r in refs:
        try:
            _ri = int(_r)
        except (TypeError, ValueError):
            continue
        if 0 <= _ri < len(shapes) and isinstance(shapes[_ri], dict):
            _bs.append(mask_shape_render_box(shapes[_ri]))
    if not _bs:
        return None
    _x0 = min(_b[0] for _b in _bs)
    _y0 = min(_b[1] for _b in _bs)
    _x1 = max(_b[0] + _b[2] for _b in _bs)
    _y1 = max(_b[1] + _b[3] for _b in _bs)
    return _x0, _y0, max(2.0, _x1 - _x0), max(2.0, _y1 - _y0)


def draw_mask_shape_outlines(canvas, shapes, highlight_indices, to_xy,
                             tag="mask_outline", show_labels=True):
    """在任意 Canvas 上画各遮罩形状的精确轮廓虚线（拼接对齐辅助；**只读不写**）。

    复用点（两处共用本函数，禁各写一份）：
      · A：遮罩窗口右侧预览的叠加层（`LiveFramePreview.set_overlay_drawer`）
      · B：遮罩「🎯 可视化选区」画布（`open_watermark_overlay_editor(bg_shape_outlines=...)`）
    颜色 / 线型口径**照搬画中画画布**（`FFmpegBatchGUI._draw_background`）：
      · 高亮行（highlight_indices）→ deepskyblue 实线（width=2）
      · 其余行                    → lightgreen 虚线 dash=(4,4)（width=2）
      · 序号标签                  → red / Arial 9 bold（同画中画）
    shapes            : list[dict]（mask_shapes 条目；`enabled=False` 的跳过）
    highlight_indices : set/list[int] 高亮行索引集合（单选={i}；多选=全选；布尔=其引用源行）
    to_xy(x, y)       : 画布坐标 → 目标 Canvas 屏幕坐标（A/B 各自口径；可为恒等）
    ⛔ 只读 shapes，绝不写回；不改任何数据。
    """
    try:
        canvas.delete(tag)
    except Exception:
        return
    _hl = set(highlight_indices or ())
    for _i, _sh in enumerate(shapes or []):
        if not isinstance(_sh, dict) or not _sh.get("enabled", True):
            continue
        _pts = mask_shape_outline_points(_sh)
        if len(_pts) < 2:
            continue
        _cpts = []
        for _px, _py in _pts:
            try:
                _cx, _cy = to_xy(_px, _py)
            except Exception:
                _cpts = []
                break
            _cpts.append((float(_cx), float(_cy)))
        if len(_cpts) < 2:
            continue
        _flat = [_v for _p in _cpts for _v in _p]
        _hi = _i in _hl
        _kw = {"outline": ("deepskyblue" if _hi else "lightgreen"),
               "width": 2, "fill": "", "tags": tag}
        if not _hi:
            _kw["dash"] = (4, 4)      # 实线不传 dash（空元组在部分 Tk 版本会报警告）
        canvas.create_polygon(_flat, **_kw)
        if show_labels:
            canvas.create_text(min(_p[0] for _p in _cpts) + 3,
                               min(_p[1] for _p in _cpts) + 2,
                               anchor="nw", text=str(_i + 1),
                               fill="red", font=("Arial", 9, "bold"), tags=tag)


def _build_mask_multi_shape_filters(settings, graph_id="", motion_trim_start=None,
                                    motion_speed_factor=None):
    """遮罩多形状 → 返回滤镜段字符串（已含 format=rgba,split … alphamerge），或 None。

    settings["mask_shapes"] 为列表，每项为 dict：
      mode: "outside"(只露矩形/矩形外透明) | "inside"(矩形透明/矩形处挖孔)  ← 每行独立
      x,y,w,h: 矩形坐标 / 外部形状图目标尺寸（最终渲染帧像素）
      feather: 羽化 sigma（0=硬边）
      enabled: 是否启用（False 跳过）
      t_start,t_end: 激活时间窗（输出时间线秒；t_end<=0 视为全程）
      png 专用: png_path(非空即"外部形状图"), png_type("bw"|"alpha"), png_invert
      可选轨迹: traj_enabled + waypoints（启用时轨迹自管可见性，忽略 t_start/t_end）

    合成规则（2026-09-11：每行独立方向，单 matte 叠加）：
      底 matte 取【首个形状】的方向为基准色，其余形状按列表顺序 overlay（后盖先）——
        · 纯全 outside → 黑底 + 若干白矩形 = 可见区并集
        · 纯全 inside  → 白底 + 若干黑矩形 = 整幅可见、矩形处挖孔
        · 混用 → 列表顺序叠加：先「只露」后「矩形透明」= 在可见区上挖洞（上移/下移调层序）
    """
    _raw_shapes = settings.get("mask_shapes")
    if not isinstance(_raw_shapes, list):
        return None
    _shapes = [s for s in _raw_shapes if isinstance(s, dict) and s.get("enabled", True)]
    if not _shapes:
        return None

    _sfx = graph_id or ""

    # ---- 布尔结果条目（2026-10-11）：一条 mask_booleans 条目 = 若干源形状的布尔合并 ----
    # 语义（用户拍板，研究见 research/mask-boolean-labels/README.md §7）：
    #   · 布尔只对源形状的**硬覆盖域**做（形状内=255 / 外=0），源自身的 mode/feather 一律忽略；
    #   · 相减有序：minuend = bool_src[0]（源列表最上选中行），其余为 subtrahend；并/交无序；
    #   · 结果条目 = 一个「自带轨迹的普通形状」：位置/轨迹/羽化全走既有 per-shape 通道（无新轨迹代码）；
    #   · 被任一【启用】布尔条目引用的源形状**不再单独渲染**（可见性交给布尔结果），
    #     否则会与合并结果叠加（相减尤其明显：源图形与差集一起冒出来）。
    _bools = settings.get("mask_booleans")
    _bools = ([b for b in _bools if isinstance(b, dict) and b.get("enabled", True)]
              if isinstance(_bools, list) else [])
    _bool_consumed = set()
    for _b in _bools:
        _rs = _b.get("bool_src")
        if isinstance(_rs, list):
            for _r in _rs:
                try:
                    _bool_consumed.add(int(_r))
                except (TypeError, ValueError):
                    continue
    # 渲染单元：未被消费的启用源形状（带 raw 索引）+ 启用布尔条目
    _units = [(_ri, _s) for _ri, _s in enumerate(_raw_shapes)
              if isinstance(_s, dict) and _s.get("enabled", True)
              and _ri not in _bool_consumed]
    _units += [(None, _b) for _b in _bools]
    if not _units:
        return None

    def _mode_of(_s):
        _m = str(_s.get("mode", settings.get("mask_mode", "outside")) or "outside").strip()
        return _m if _m in ("outside", "inside") else "outside"

    def _q(_e):
        """给 overlay 的 x/y 表达式加单引号（幂等）。

        ⚠️ 2026-09-11 探针修复：表达式的实参含逗号（gte(t,0)/lt(t,1e+09)），
        滤镜图解析器会把未加引号的逗号当成「下一个滤镜」→ Error parsing filterchain。
        静止窗口分支返回的是裸表达式（轨迹分支自己已带引号），这里统一补引号。
        """
        _s = str(_e)
        if len(_s) >= 2 and _s[0] == "'" and _s[-1] == "'":
            return _s
        return "'" + _s + "'"

    def _shape_cov_box(_s, _tag):
        """把一条源形状渲染成「纯覆盖域」灰度自身包围盒图（形状内=255 / 外=0）。

        布尔运算只看几何覆盖，故：
          · 忽略源自身的 mode（outside/inside）——那是合成层「只露/挖孔」语义，与布尔无关；
          · 忽略源自身的 feather —— 用户拍板：布尔只吃硬遮罩，源羽化一律丢弃（不在
            「先羽化源再布尔」这条贵路径上开放）。
        与 `_build_mask_multi_shape_filters` 主循环同几何（同一个 `_mask_shape_geq_expr`
        / `_mask_rot_bbox`）。返回 (filters, out_label, box_w, box_h, dx, dy) 或 None。
        """
        _rawp = str(_s.get("png_path", "") or "").strip()
        try:
            _w = max(2, int(float(_s.get("w", 100))))
            _h = max(2, int(float(_s.get("h", 100))))
        except (ValueError, TypeError):
            _w = _h = 100
        _rot = _opt_float(_s.get("rot", 0) or 0, 0.0)
        _cw2, _ch2 = _mask_rot_bbox(_w, _h, _rot)
        _shp = str(_s.get("shape", "") or "").strip().lower() or "rect"
        _rect_rot = _shp in ("rect", "rectangle") and abs(_rot) > 1e-9
        if _rawp or (_shp not in ("circle", "ellipse", "triangle", "diamond")
                     and not _rect_rot):
            _cw2, _ch2 = _w, _h
        _dx2, _dy2 = (_cw2 - _w) / 2.0, (_ch2 - _h) / 2.0
        if _rawp:
            _safe = _mask_shape_movie_path(_rawp)
            if not _safe:
                return None
            _ptype = _s.get("png_type", "bw") or "bw"
            _load = ("format=rgba,alphaextract" if _ptype == "alpha"
                     else "format=gbrp,extractplanes=g")
            if _s.get("png_invert"):
                _load += ",negate"
            _src, _out = f"{_tag}s", f"{_tag}g"
            return (f"movie={_safe}[{_src}];[{_src}]{_load},"
                    f"scale={_w}:{_h},format=gray[{_out}];",
                    _out, _w, _h, 0.0, 0.0)
        if _shp in ("circle", "ellipse", "triangle", "diamond") or _rect_rot:
            _out = f"{_tag}g"
            return (f"color=c=black:s={_cw2}x{_ch2},"
                    f"geq=lum='{_mask_shape_geq_expr(_w, _h, _shp, _rot, _cw2, _ch2)}'"
                    f":cb=128:cr=128,format=gbrp,extractplanes=g[{_out}];",
                    _out, _cw2, _ch2, _dx2, _dy2)
        # 普通矩形（rot=0）：全白盒
        _out = f"{_tag}g"
        return (f"color=c=white:s={_w}x{_h},format=gbrp,extractplanes=g[{_out}];",
                _out, _w, _h, 0.0, 0.0)

    def _bool_seg(_b, _bi):
        """把一条布尔条目渲染成**单个灰度 matte 源**（并/交/差）。

        算法（真实 ffmpeg 探针 tests/_dbg_mask_bool_probe.py 已验证）：
          每个源 -> 自身包围盒灰度图 -> `pad` 到布尔画布（源按相对包围盒原点落位）
            -> 并集 `blend=all_mode=lighten`(max) / 交集 `all_mode=darken`(min)
               / 相减 `all_mode=darken`(A, negate(B))（0/255 下 min 即 AND、255-x 即 NOT）。
        布尔画布 = 各源包围盒的并集（保证都装得下）。返回 (filters, out_label, W, H) 或 None。
        """
        _op = str(_b.get("bool_op", "union") or "union").strip().lower()
        if _op not in ("union", "intersect", "subtract"):
            _op = "union"
        _refs = _b.get("bool_src")
        if not isinstance(_refs, list):
            return None
        _tag = f"mk{_sfx}bo{_bi}"
        _boxes = []      # (filters, label, box_w, box_h, ox, oy)  ox/oy = 盒左上角(布尔画布坐标)
        for _j, _r in enumerate(_refs):
            try:
                _ri = int(_r)
            except (TypeError, ValueError):
                continue
            if not (0 <= _ri < len(_raw_shapes)):
                continue
            _s = _raw_shapes[_ri]
            if not isinstance(_s, dict) or not _s.get("enabled", True):
                continue      # 被停用的源退出布尔（与其「不再单独渲染」一致）
            _res = _shape_cov_box(_s, f"{_tag}s{_j}")
            if _res is None:
                continue
            _f, _lbl, _bw, _bh, _bdx, _bdy = _res
            try:
                _sx = float(_s.get("x", 0) or 0)
                _sy = float(_s.get("y", 0) or 0)
            except (ValueError, TypeError):
                _sx = _sy = 0.0
            _boxes.append((_f, _lbl, _bw, _bh, _sx - _bdx, _sy - _bdy))
        if not _boxes:
            return None
        _ox0 = min(_bx[4] for _bx in _boxes)
        _oy0 = min(_bx[5] for _bx in _boxes)
        # pad 偏移 + 画布尺寸（两遍：先定尺寸保证所有盒都装得下）
        _offs = [(max(0, int(round(_bx[4] - _ox0))), max(0, int(round(_bx[5] - _oy0)))) for _bx in _boxes]
        _cwv = max(_offs[_j][0] + _boxes[_j][2] for _j in range(len(_boxes)))
        _chv = max(_offs[_j][1] + _boxes[_j][3] for _j in range(len(_boxes)))
        _cwv, _chv = max(2, int(_cwv)), max(2, int(_chv))
        _seg2 = ""
        _pads = []
        for _j, (_f, _lbl, _bw, _bh, _box, _boy) in enumerate(_boxes):
            _pl = f"{_tag}p{_j}"
            _pads.append(_pl)
            _seg2 += (_f + f"[{_lbl}]pad=w={_cwv}:h={_chv}:"
                      f"x={_offs[_j][0]}:y={_offs[_j][1]}:color=black[{_pl}];")
        _cur = _pads[0]
        if _op == "subtract" and len(_pads) > 1:
            for _j in range(1, len(_pads)):
                _nl, _ol = f"{_tag}n{_j}", f"{_tag}o{_j}"
                _seg2 += f"[{_pads[_j]}]negate[{_nl}];"
                _seg2 += f"[{_cur}][{_nl}]blend=all_mode=darken[{_ol}];"
                _cur = _ol
        else:
            _mode = "lighten" if _op == "union" else "darken"
            for _j in range(1, len(_pads)):
                _ol = f"{_tag}o{_j}"
                _seg2 += f"[{_cur}][{_pads[_j]}]blend=all_mode={_mode}[{_ol}];"
                _cur = _ol
        return _seg2, _cur, _cwv, _chv

    # outside：该矩形涂白（声明可见区）；inside：涂黑（声明透明区/挖孔）
    _base_c = "white" if _mode_of(_shapes[0]) == "inside" else "black"
    # 整帧底色用 lut 画（2026-10-01）：drawbox 在 FFmpeg 4.3 的格式列表不含 gbrp，
    # 协商会在 drawbox 前插 auto_scaler 转进 YUV（黑=Y16）→ extractplanes=g 报
    # "Requested planes not available" 整图初始化失败（用户 4.3 ffplay 预览实测）。
    # lut 直通 gbrp、全版本无转换；r=g=b 全帧填 0/255 与 drawbox t=fill 逐字节等价
    # （n9.0.1 探针 tests/_dbg_mask_lut_probe.py md5 一致）。
    _lut_v = "255" if _base_c == "white" else "0"

    _a, _as, _ml = f"mk{_sfx}a", f"mk{_sfx}as", f"mk{_sfx}ml"
    _bgl = f"mk{_sfx}bgl"
    seg = (
        f"format=rgba,split=3[{_a}][{_as}][{_ml}];"
        # ⚠️ 底色画完后必须 `extractplanes=g`（G 平面逐字节拷贝）再喂 overlay：
        #   本函数一路可能含 movie=（外部形状图），只要图里有 rgb 源，ffmpeg 的格式协商就会把
        #   尾部 format=gray 走成 limited-range 的 RGB→Y = 黑变 16 → 形状外 alpha=16（约 6% 漏光，
        #   子视频整帧浮出一层浅影）。extractplanes=g 是纯平面拷贝（黑=0 精确），与老单形状
        #   PNG 路径同款修法（见 build_video_filter_chain 内「底色用 lutyuv/gbrp+extractplanes」注释）。
        #   2026-09-11 探针 tests/_probe_mask_time_overlap.py 复现并修正。
        f"[{_ml}]format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v},extractplanes=g[{_bgl}];"
    )
    _matte_in = _bgl
    _emitted = 0

    try:
        _cvw = int(float(settings.get("mask_traj_canvas_w", 0) or 0)) or MASK_TRAJ_CANVAS_W
        _cvh = int(float(settings.get("mask_traj_canvas_h", 0) or 0)) or MASK_TRAJ_CANVAS_H
    except (ValueError, TypeError):
        _cvw, _cvh = MASK_TRAJ_CANVAS_W, MASK_TRAJ_CANVAS_H

    if motion_trim_start is not None:
        _ts0 = float(motion_trim_start)
        _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
    else:
        _ts0, _sp0 = _trim_speed_from_settings(settings)
    if not _sp0 or _sp0 <= 0:
        _sp0 = 1.0

    for _i, (_unit_ri, _sh) in enumerate(_units):
        # 布尔结果条目？（有 bool_op + bool_src 列表即判定为布尔，见上方 _bools 说明）
        _is_bool = ("bool_op" in _sh) and isinstance(_sh.get("bool_src"), list)
        # 类型由「外部图路径是否有值」自动判定（UI 不再给类型下拉）：有路径=外部，空=矩形
        _raw = str(_sh.get("png_path", "") or "").strip()
        _typ = "png" if _raw else "rect"
        # 该行自己的着色：outside→白（可见），inside→黑（透明/挖孔）
        _shape_c = "black" if _mode_of(_sh) == "inside" else "white"
        try:
            _w = max(2, int(float(_sh.get("w", 100))))
            _h = max(2, int(float(_sh.get("h", 100))))
        except (ValueError, TypeError):
            _w = _h = 100
        _feather = _opt_float(_sh.get("feather", 0) or 0, 0.0)
        # 形状旋转角（度，绕形状层包围盒中心；0=与「坐标」框选同朝向）
        _rot = _opt_float(_sh.get("rot", 0) or 0, 0.0)
        # 形状层画布 = 旋转后的最小外接矩形（对齐 Shotcut：size 是形状自身外接尺寸，
        # 旋转只改判据、不切形状）。rot=0 时恒等于 (w,h) ⇒ 老存档零回归。
        _cw, _ch = _mask_rot_bbox(_w, _h, _rot)
        # 落位回移量：外接矩形与原 w×h 中心重合 ⇒ 左上角要回移 (cw-w)/2、(ch-h)/2，
        # 否则形状会朝右下漂。
        # ⚠️ 吃 rot 的形状：circle/ellipse/triangle/diamond，以及（2026-10-11 起）**带角度的 rect**。
        #   · png（外部形状图）—— 有 png_path 时形状下拉已失效，旋转同理；
        #   · rect 且 rot==0 —— 仍走 color= 纯色块，转动无意义。
        # 这两种必须把 _cw/_ch 拉回 (w,h)，否则 _dx/_dy 非零会**让位置莫名偏移**。
        _raw_png = str(_sh.get("png_path", "") or "").strip()
        _shp_eff = str(_sh.get("shape", "") or "").strip().lower() or "rect"
        _rect_rot = (_shp_eff in ("rect", "rectangle")) and abs(_rot) > 1e-9
        if _raw_png or (_shp_eff not in ("circle", "ellipse", "triangle", "diamond")
                        and not _rect_rot):
            _cw, _ch = _w, _h
        _dx, _dy = (_cw - _w) / 2.0, (_ch - _h) / 2.0

        # ---- 形状源（矩形=color= 纯色画布；外部图=movie 载图；布尔=合成子图）----
        _sl2 = f"mk{_sfx}sl{_i}"
        if _is_bool:
            # 布尔结果：把引用源合成成 1 张灰度 matte（并/交/差），再当「一个形状」走下面的
            # 落位 / 轨迹 / 羽化 / overlay —— 运行期只有 1 个合成源 + 1 个位置，
            # 开销与外部 PNG 等价（不是「每帧布尔」，见 README §2）。
            _bseg = _bool_seg(_sh, _i)
            if _bseg is None:
                continue          # 引用无效 / 无可用源 → 跳过该条（不阻断其余形状）
            _bstr, _comb, _bcw, _bch = _bseg
            seg += _bstr
            _sl2 = _comb
            _cw, _ch = _bcw, _bch
            _dx = _dy = 0.0
            _emitted += 1
        elif _typ == "png":
            _ptype = _sh.get("png_type", "bw") or "bw"
            if _ptype not in ("bw", "alpha"):
                _ptype = "bw"
            _safe = _mask_shape_movie_path(_raw)
            if not _safe:
                continue  # 路径不可用，跳过该项（不阻断其余形状）
            _load = "format=rgba,alphaextract" if _ptype == "alpha" else "format=gbrp,extractplanes=g"
            if _sh.get("png_invert"):
                _load += ",negate"
            if _mode_of(_sh) == "inside":
                _load += ",negate"
            _sl = f"mk{_sfx}sl{_i}src"
            seg += f"movie={_safe}[{_sl}];[{_sl}]{_load},scale={_w}:{_h},format=gbrp[{_sl2}];"
            _emitted += 1
        else:
            # 形状下拉（2026-10-05）：rect 走 color= 纯色；circle/triangle/diamond 走 geq 判据
            # 2026-10-11：rect 带角度（rot≠0）时也走 geq —— 矩形旋转；否则仍走 color= 纯色。
            _shp = str(_sh.get("shape", "") or "").strip().lower() or "rect"
            if _shp in ("circle", "ellipse", "triangle", "diamond") or (
                    _shp in ("rect", "rectangle") and abs(_rot) > 1e-9):
                # ⚠️ geq 是**单输入**滤镜（同铁律 20 的 pad）：build_seek_frame_cmd 注入的
                # setpts 正好落在它前面；判据里的多条件必须是**连乘**（and() 只吃二元）。
                # inside（挖孔）时直接 negate 反相，与 rect 的 color=c=黑 语义对齐。
                _neg = "negate," if _mode_of(_sh) == "inside" else ""
                seg += (f"color=c=black:s={_cw}x{_ch},"
                        f"geq=lum='{_mask_shape_geq_expr(_w, _h, _shp, _rot, _cw, _ch)}'"
                        f":cb=128:cr=128,"
                        f"{_neg}format=gbrp,extractplanes=g[{_sl2}];")
            else:
                seg += f"color=c={_shape_c}:s={_w}x{_h},format=gbrp[{_sl2}];"
            _emitted += 1

        # ---- 位置表达式（轨迹 or 静止时间窗）----
        _xe, _ye = _mask_shape_pos_expr(_sh, _cvw, _cvh, _ts0, _sp0)
        # ---- 旋转回移（2026-10-05 反裁剪）：形状层放大到外接矩形后，左上角要回移
        # (cw-w)/2、(ch-h)/2 才能让**中心**与原 w×h 中心重合（否则形状朝右下漂）。
        # 在**表达式层**减，不改 _sh["x"/"y"]（那会连带污染 UI 显示值与存档）。
        if _dx:
            _xe = _mask_expr_shift(_xe, -_dx)
        if _dy:
            _ye = _mask_expr_shift(_ye, -_dy)

        # ---- sendcmd 接入（轨迹航点行数 > 阈值；2026-10-01 全量接入）----
        # 挂 overlay 主输入支链（matte 累积链）+ overlay 起完整别名（sendcmd 按别名定向）
        # ⚠️ 旋转回移量必须一起传进 suffix（sendcmd 逐帧覆写 x/y，只改初始表达式会被冲掉）
        _sc = None
        if _sh.get("traj_enabled") and isinstance(_sh.get("waypoints"), list):
            _sc = _mask_sendcmd_info(
                [w for w in _sh["waypoints"] if isinstance(w, dict)],
                _cvw, _cvh, _ts0, _sp0, f"mk{_sfx}ov{_i}",
                shift_x=-_dx, shift_y=-_dy)

        # ---- 羽化（软边）----
        _node = f"[{_sl2}]"
        if _feather > 0:
            _gl = f"mk{_sfx}g{_i}"
            seg += f"[{_sl2}]gblur=sigma={_feather:.1f}[{_gl}];"
            _node = f"[{_gl}]"

        # ---- overlay 到累积 matte ----
        _cur = f"mk{_sfx}m{_i}"
        if _sc is not None:
            _scp, _sx0, _sy0 = _sc
            _scin = f"mk{_sfx}sc{_i}"
            seg += (f"[{_matte_in}]sendcmd=f='{_scp}'[{_scin}];"
                    f"[{_scin}]{_node}overlay@mk{_sfx}ov{_i}=x='{_sx0}':y='{_sy0}'[{_cur}];")
        else:
            seg += f"[{_matte_in}]{_node}overlay=x={_q(_xe)}:y={_q(_ye)}[{_cur}];"
        _matte_in = _cur

    # 唯一一次 format=gray + blend=multiply（主 alpha × matte）+ alphamerge
    _msk, _aa, _am = f"mk{_sfx}msk", f"mk{_sfx}aa", f"mk{_sfx}am"
    if _emitted == 0:
        # 所有形状均无效（如 PNG 路径缺失）且被跳过 → 回退让调用方走旧单形状/无遮罩
        return None
    seg += (
        f"[{_matte_in}]format=gray[{_msk}];"
        f"[{_as}]alphaextract[{_aa}];"
        f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
        f"[{_a}][{_am}]alphamerge"
    )
    return seg


def _mask_shape_pos_expr(sh, cvw, cvh, ts0, sp0):
    """单形状的 overlay x/y 表达式：轨迹形状走 build_waypoint_expr（自管可见性），
    静止形状用合成航点把 t_start~t_end 框成「窗口内显示在 (x,y)、窗口外 hide 移出」。"""
    # 轨迹优先：航点自带 show/hide，忽略 t_start/t_end
    if sh.get("traj_enabled") and isinstance(sh.get("waypoints"), list):
        _wps = [w for w in sh["waypoints"] if isinstance(w, dict)]
        if _wps:
            _xe, _ye, _unused, _unused, _unused = build_waypoint_expr(
                _wps, sw=str(cvw), sh=str(cvh), trim_start=ts0, speed_factor=sp0)
            if _xe and _ye:
                return f"'({_xe})*main_w/{cvw}'", f"'({_ye})*main_h/{cvh}'"
    # 静止窗口：合成单段航点（mode=move + end_action=hide）
    try:
        _t0 = float(sh.get("t_start", 0) or 0)
        _t1 = float(sh.get("t_end", 1e9) or 1e9)
    except (ValueError, TypeError):
        _t0, _t1 = 0.0, 1e9
    if _t1 <= _t0:
        _t1 = _t0 + 0.04
    try:
        _ts_out, _dur_out = _timeline_convert(_t0, _t1 - _t0, ts0, sp0)
    except (ValueError, TypeError):
        _ts_out, _dur_out = _t0, _t1 - _t0
    try:
        _x = float(sh.get("x", 0) or 0)
        _y = float(sh.get("y", 0) or 0)
    except (ValueError, TypeError):
        _x = _y = 0.0
    _wps = [{
        "start": _ts_out, "dur": max(0.04, _dur_out), "mode": "move",
        "xa": _x, "ya": _y, "xb": _x, "yb": _y, "end_action": "hide",
    }]
    _xe, _ye, _unused, _unused, _unused = build_waypoint_expr(_wps)
    return _xe or "0", _ye or "0"


def _mask_sendcmd_info(wps, cvw, cvh, ts0, sp0, tag, shift_x=0.0, shift_y=0.0):
    """遮罩轨迹的 sendcmd 接入信息（航点行数 > 阈值才启用，2026-10-01 全量接入）。

    wps: 已过滤的有效航点 dict 列表（调用方负责 traj_enabled 门控）。
    shift_x/shift_y: 落位**常数回移**（像素，2026-10-05 旋转反裁剪用）。
      ⚠️ 必须走 suffix 而非只改初始表达式 —— sendcmd 会在运行期**逐帧覆写** overlay 的
      x/y，偏移只写在初始表达式上会被第一帧就冲掉。
      ⚠️ hide 那一档用 -100000 移出画外，加偏移后仍是 -100000 量级（±半层宽），安全。
    返回 (转义路径, x0 占位表达式, y0 占位表达式) 或 None（回退表达式路）。
    值域 = 航点画布坐标，经 suffix 在 overlay 侧等比还原（*main_w/cvw，同表达式路）。
    """
    if not wps or len(wps) <= _wp_sc_rows_limit():
        return None
    _iv = build_waypoint_position_intervals(wps, trim_start=ts0, speed_factor=sp0)
    if not _iv:
        return None
    _sx = f"* main_w/{cvw}"
    _sy = f"* main_h/{cvh}"
    if shift_x:
        _sx += f" {_shift_op(shift_x)}"
    if shift_y:
        _sy += f" {_shift_op(shift_y)}"
    _p = FFmpegBatchGUI._write_waypoint_sendcmd_file(
        _iv, tag, suffix_x=_sx, suffix_y=_sy)
    if _p is None:
        return None
    if _iv[0][2] == "hide":
        _x0 = _y0 = "-100000"
    else:
        _x0 = f"{_iv[0][3]:g}"
        _y0 = f"{_iv[0][4]:g}"
    _ex = f"({_x0})*main_w/{cvw}"
    _ey = f"({_y0})*main_h/{cvh}"
    if shift_x:
        _ex = _mask_expr_shift(_ex, shift_x)
    if shift_y:
        _ey = _mask_expr_shift(_ey, shift_y)
    return _p, _ex, _ey


def _outline_hex_to_rgb(_hex):
    """描边颜色 #RRGGBB / #RGB → (r, g, b)；非法返回 None（调用方回落白色）。"""
    _s = str(_hex or "").strip().lstrip("#")
    if len(_s) == 3:
        _s = "".join(_c * 2 for _c in _s)
    if len(_s) != 6:
        return None
    try:
        return tuple(int(_s[_i:_i + 2], 16) for _i in (0, 2, 4))
    except ValueError:
        return None


# 8 邻域位掩码（上下左右 + 四个斜角）/ 4 邻域位掩码（只有上下左右）
_OUTLINE_COORD_8 = 255
_OUTLINE_COORD_4 = 90


def _outline_dilation_seq(n):
    """返回长度 n 的 dilation 邻域序列 —— 用「八角形距离」逼近欧氏圆盘。

    dilation 的结构元素由 coordinates 位掩码决定，形状只有两种：
      · 8 邻域（3x3 方形，L∞ 单位球）：沿轴向外扩 1，沿 45° 外扩 √2=1.414 → 斜边**胖 41%**
      · 4 邻域（菱形，L1 单位球）    ：沿轴向外扩 1，沿 45° 外扩 √2/2=0.707 → 斜边**瘦 29%**
    单独用任一种都会让圆形轮廓变形（实测 dil8 凸边 5/细条 3，dil4 凸边 2/细条 3）。

    要各向同性，需要 n8 次 8 邻域 + n4 次 4 邻域满足：
        轴向 n8 + n4  ==  45° 方向 1.414·n8 + 0.707·n4
      ⇒ n4 ≈ 1.414·n8  ⇒  n8 ≈ n / 2.414
    ⚠️ 所以正确比例是 **4 邻域比 8 邻域多约 41%**，不是 1:1 —— 1:1 简单交替在 n=3 时
      仍有 +0.57px 误差；按本函数分布后残余误差 ≤0.25px（4px 边宽下差 0.1~0.24px）。
    两种邻域用 Bresenham 均匀交错（不能连着排，否则局部方向会先胖后瘦）。
    """
    n = max(1, int(n))
    n8 = int(round(n / 2.414))
    n8 = max(0, min(n, n8))
    if n8 == 0:
        return [_OUTLINE_COORD_4] * n
    if n8 == n:
        return [_OUTLINE_COORD_8] * n
    seq, acc = [], 0
    for _i in range(n):
        acc += n8
        if acc >= n:
            acc -= n
            seq.append(_OUTLINE_COORD_8)
        else:
            seq.append(_OUTLINE_COORD_4)
    return seq


def _build_outline_filter_block(settings, graph_id=""):
    """外轮廓描边滤镜段 —— 返回段字符串，或 None（未启用）。

    原理（2026-10-02 实测，证据 tests/_probe_dilation_vs_morpho.py）：
        ring = 膨胀后的 alpha − 原 alpha          （纯环，blend=all_mode=subtract）
        → 给环染上指定颜色 → overlay 到主体下面（环作底、主体作顶层）→ 只露出主体外一圈。
      ⚠️ 必须是**纯环**：直接把膨胀结果整块填白，会把主体自己的半透明边缘一起染白
        （羽化抠图尤其明显，实测 d=38 处 244,111,111 粉红 vs 纯环 242,69,68）。

    膨胀为什么用 dilation 的 8/4 邻域组合，而不用 morpho 圆盘结构元：
      · 两者原理相同（都是形态学膨胀），morpho 的圆盘是**真正各向同性**的；
        但 morpho 需要第二输入「结构元素图」，必须 movie= 载入一张 PNG，
        而**每个宽度都要一张不同尺寸的**（宽度 1~20 → 20 张），内置要生成/缓存/转义
        一整套文件 —— 且 build_video_filter_chain 是模块级函数，拿不到 self.ffmpeg_cmd，
        连"运行时生成一张"都无从发起进程。
      · dilation 是纯单输入滤镜，宽度只体现在重复次数上，零文件、零转义。
      ⇒ 用 8/4 邻域按比例组合逼近圆盘（见 _outline_dilation_seq），残余误差 ≤0.25px。
        ⚠️ 已知取舍：4px 边宽下圆形/斜边方向实测比直边多约 1px（凸边 5 / 直边 4，
          含斜边 1px 离散测量偏差）。若将来要求绝对等距，改造点只有 _outline_dilation_seq
          的调用处，换成 morpho 即可（需先解决模块级 ffmpeg 进程发起问题）。

    抗锯齿：形态学膨胀是离散硬边（锯齿），必须 gblur σ1.2 + 软阈值过渡带才"丝滑"。
      ⚠️ 实测 AA 恒定让可见边宽 **+2px** ⇒ 膨胀次数 = max(1, 宽度 − 2)。
        宽度 4 → 膨胀 2 次（实测凸边 5/细条 4，去掉斜边 1px 测量偏差即 4）。

    前置（入口 tooltip 已提示）：输入必须已有 alpha —— 抠图结果 / 带透明素材 / 遮罩。
      ⚠️ 输入无 alpha 时 alpha 全 1，膨胀后仍全 1，纯环为空 ⇒ 退化成画面四周一个矩形框。

    段尾**不写输出标签**：build_video_filter_chain 用 ",".join(filters) 拼接，
    无标签时后续元素才能自然接到本段 overlay 的输出上。
    """
    if not settings.get("outline_enabled", False):
        return None
    try:
        _w = int(str(settings.get("outline_width", "4")).strip() or "4")
    except (ValueError, TypeError):
        _w = 4
    _w = max(1, min(20, _w))
    _rgb = _outline_hex_to_rgb(settings.get("outline_color", "#FFFFFF")) or (255, 255, 255)
    _n = max(1, _w - 2)     # AA 恒定 +2px，故膨胀次数 = 宽度 − 2
    _dil = ",".join("dilation=coordinates=%d" % _c for _c in _outline_dilation_seq(_n))
    _s = graph_id or ""
    _a, _b = "ob%s_a" % _s, "ob%s_b" % _s
    _o1, _o2 = "ob%s_o1" % _s, "ob%s_o2" % _s
    _d, _dl = "ob%s_d" % _s, "ob%s_dl" % _s
    _ring, _wt = "ob%s_ring" % _s, "ob%s_w" % _s
    return ("format=rgba,split=2[%s][%s];"
            "[%s]alphaextract,format=gray,split=2[%s][%s];"
            "[%s]%s[%s];"
            "[%s]gblur=sigma=1.2,lut=y='min(255,max(0,(val-8)*255/40))'[%s];"
            "[%s][%s]blend=all_mode=subtract[%s];"
            "[%s]format=rgba,colorchannelmixer=aa=0:ar=1,"
            "lutrgb=r='%d':g='%d':b='%d'[%s];"
            "[%s][%s]overlay"
            % (_a, _b, _a, _o1, _o2, _o1, _dil, _d, _d, _dl,
               _dl, _o2, _ring, _ring, _rgb[0], _rgb[1], _rgb[2], _wt,
               _wt, _b))


_COORD_BOX_CLIP = {"x": None, "y": None, "w": None, "h": None}
"""「坐标框」四格数值的复制/粘贴剪贴板（模块级单例，**跨窗口共享**）。

2026-10-09：可视化裁剪 / delogo 可视化选区 / 遮罩「🎯 可视化选区」/ 各位置编辑器
共用同一份 —— 用户要的就是「在裁剪窗口复制这四个数 → 到另一个窗口粘贴」。
只存整数像素（宽高 ≤ 0 的不进剪贴板，避免粘出一个看不见的框）。"""


def build_coord_box(parent, get_rect, apply_rect, title=None,
                    with_clipboard=True):
    """「裁剪框数值」同款四格坐标框（宽/高 + 左/上，可带复制/粘贴）→ (frame, sync)。

    从可视化裁剪窗口（`open_crop_editor`）逐字抽出来的共用块（2026-10-09）：
    公共位置编辑器（`_generic_overlay_editor`）此前**只能拖**，像素级对准全靠手感，
    而裁剪窗口早就有这四格；现在两处共用同一份实现，杜绝双份判据漂移。

    :param get_rect:  () -> (x, y, w, h) 或 None（当前没有框）
    :param apply_rect: (x, y, w, h) -> None；**钳制与重绘由调用方负责**
                       （裁剪窗口按 orig_w/orig_h 夹，位置编辑器按画布夹，各管各的）
    :return: (frame, sync)；调用方在几何变化后调 `sync()` 回填四格

    ⚠️ 双向同步的两条回路**必须分开触发**，否则互相触发成死循环：
      ① 几何 → 数值：`sync()`（由调用方在几何收口处单点调用）；
      ② 数值 → 几何：内部 `_apply()`（**只在回车 / 失焦时**触发，不绑 KeyRelease ——
         边敲边改几何会把「1」→「12」的中间态当成 1 处理，且回填会顶掉光标）。
    ⚠️ `sync()` 只在值真变了才写（`_tk_setv` 语义）：拖拽期间每帧都跑，
       无差别 set 会把用户正在输入的另一格一起冲掉。
    """
    if title is None:
        title = _("坐标（回车生效）")
    frame = ttk.LabelFrame(parent, text=title)
    frame.pack(fill=tk.X, pady=(0, 6))

    _w, _h = tk.StringVar(), tk.StringVar()
    _x, _y = tk.StringVar(), tk.StringVar()
    _busy = [False]      # 回填期间置位，杜绝「回填→触发→再回填」回环

    def _cell(row, label, var, col):
        cell = ttk.Frame(row)
        cell.grid(row=0, column=col, sticky="w", padx=(0, 10))
        ttk.Label(cell, text=label).pack(side=tk.LEFT)
        e = ttk.Entry(cell, textvariable=var, width=7)
        e.pack(side=tk.LEFT, padx=(3, 0))
        return e

    _row1 = ttk.Frame(frame)
    _row1.pack(fill=tk.X, padx=6, pady=(4, 2))
    _e_w = _cell(_row1, _("宽"), _w, 0)
    _e_h = _cell(_row1, _("高"), _h, 1)
    _row2 = ttk.Frame(frame)
    _row2.pack(fill=tk.X, padx=6, pady=(0, 6))
    _e_x = _cell(_row2, _("左"), _x, 0)
    _e_y = _cell(_row2, _("上"), _y, 1)

    def _sync():
        _busy[0] = True
        try:
            _r = get_rect()
            if _r:
                _rx, _ry, _rw, _rh = _r
                _tk_setv(_x, str(int(round(float(_rx)))))
                _tk_setv(_y, str(int(round(float(_ry)))))
                _tk_setv(_w, str(int(round(float(_rw)))))
                _tk_setv(_h, str(int(round(float(_rh)))))
            else:
                for _v in (_x, _y, _w, _h):
                    _tk_setv(_v, "")
        except (TypeError, ValueError):
            for _v in (_x, _y, _w, _h):
                _tk_setv(_v, "")
        finally:
            _busy[0] = False

    def _apply():
        if _busy[0] or not get_rect():
            _sync()
            return
        try:
            _lx = int(float(_x.get()))
            _ty = int(float(_y.get()))
            _ww = int(float(_w.get()))
            _hh = int(float(_h.get()))
        except (ValueError, TypeError):
            _sync()          # 非法输入原样回填（= 撤消这次编辑），不弹窗打断
            return
        apply_rect(_lx, _ty, max(1, _ww), max(1, _hh))

    def _copy():
        _r = get_rect()
        if not _r:
            return
        try:
            _cx, _cy, _cw, _ch = (int(round(float(_v))) for _v in _r)
        except (TypeError, ValueError):
            return
        if _cw <= 0 or _ch <= 0:
            return
        _COORD_BOX_CLIP.update({"x": _cx, "y": _cy, "w": _cw, "h": _ch})

    def _paste():
        if _COORD_BOX_CLIP.get("w") is None:
            return
        apply_rect(_COORD_BOX_CLIP["x"], _COORD_BOX_CLIP["y"],
                   _COORD_BOX_CLIP["w"], _COORD_BOX_CLIP["h"])

    if with_clipboard:
        ttk.Button(_row1, text=_("复制"), width=5, command=_copy).grid(
            row=0, column=2, sticky="w")
        ttk.Button(_row2, text=_("粘贴"), width=5, command=_paste).grid(
            row=0, column=2, sticky="w")

    for _e in (_e_w, _e_h, _e_x, _e_y):
        # ⚠️ 数值框一律不挂 write trace（会与回填互相触发），只绑回车与失焦。
        _e.bind("<Return>", lambda _ev: _apply())
        _e.bind("<FocusOut>", lambda _ev: _apply())

    _sync()
    ToolTip(frame,
            _("像素级对准：四格与画布**双向同步** —— 拖动画布会回填这里，"
            "改完数值按回车（或点到别处）也会立刻挪动画布上的框。\n"
            "· 左 / 上 = 框左上角坐标；宽 / 高 = 框尺寸；\n"
            "· 非法输入原样回填（= 撤消这次编辑），不弹窗打断；\n"
            "· 「复制 / 粘贴」搬的是这四个数，剪贴板**跨窗口共用**"
            "（可从裁剪窗口复制、到别的编辑器粘贴）。"),
            wraplength=340)
    return frame, _sync


def build_nudge_rows(parent, on_edge, on_grow, on_shift, steps=(1, 1, 1)):
    """「边缘/平移微调」三行（减 / 加 / 移），每行 4 个方向按钮 + **各自独立步进**。

    从可视化裁剪窗口抽出来的共用块（2026-10-09）：遮罩「🎯 可视化选区」要的就是这三行
    （此前给它的是一版简易「X/Y/宽/高 + 单步进 -/+」—— 不是用户要的形态，已撤销）。

    :param on_edge:  (edge, delta)      收缩该边    edge ∈ top/bottom/left/right
    :param on_grow:  (edge, delta)      扩大该边
    :param on_shift: (direction, delta) 整体平移    direction ∈ up/down/left/right
    :return: (edge_step, grow_step, shift_step) —— 三个步进 StringVar
    """
    def _step_of(sv):
        try:
            return int(sv.get())
        except (ValueError, TypeError):
            return 1

    def _row(items, cb, _sv):
        r = ttk.Frame(parent)
        r.pack(fill=tk.X, pady=1)
        for _lbl, _d in items:
            ttk.Button(r, text=_lbl, width=4,
                       command=lambda _x=_d: cb(_x, _step_of(_sv))).pack(
                side=tk.LEFT, padx=1)
        ttk.Label(r, text=_("步进:")).pack(side=tk.LEFT, padx=(8, 2))
        ttk.Spinbox(r, textvariable=_sv, from_=1, to=999, width=4).pack(side=tk.LEFT)

    _sv_edge = tk.StringVar(value=str(steps[0]))
    _sv_grow = tk.StringVar(value=str(steps[1]))
    _sv_shift = tk.StringVar(value=str(steps[2]))
    _row([(_("上减"), "top"), (_("下减"), "bottom"), (_("左减"), "left"), (_("右减"), "right")],
         on_edge, _sv_edge)
    _row([(_("上加"), "top"), (_("下加"), "bottom"), (_("左加"), "left"), (_("右加"), "right")],
         on_grow, _sv_grow)
    _row([(_("上移"), "up"), (_("下移"), "down"), (_("左移"), "left"), (_("右移"), "right")],
         on_shift, _sv_shift)
    return _sv_edge, _sv_grow, _sv_shift


def _mask_has_geometry(settings):
    """(ok, 原因)：「启用遮罩」勾着是否**真的有几何可画**（2026-10-09 自检原语）。

    ⛔ 勾了开关 ≠ 有遮罩：`_build_mask_multi_shape_filters` 在 mask_shapes 为空 / 全部
    enabled=False / 宽高为 0 时返回 None ⇒ 链里根本没有遮罩段 ⇒ 节点效果拿到 `null`
    空滤镜、列表「插入效果」列一片空白，用户只看到「没生效」而没有任何解释
    （2026-10-09 用户实测：「对视频节点无法插入遮罩效果，会变成 null 空滤镜」）。

    ⚠️ 判据必须与 `_build_mask_multi_shape_filters` **同一口径**（enabled 过滤 + 尺寸 > 0），
    否则会出现「提示说没几何、实际却画出来了」或反之 —— 这类双份判据漂移是本项目
    反复踩的坑（参见 rotation-bounding-box 的 _blend_region_size 事故）。

    返回 (True, "") / (False, 人话原因)。settings 为空 / 未启用 → (False, ...)。
    """
    _s = settings or {}
    if not _s.get("mask_enabled", False):
        return False, _("未启用遮罩")
    _shapes = _s.get("mask_shapes")
    if isinstance(_shapes, list):
        _live = [s for s in _shapes if isinstance(s, dict) and s.get("enabled", True)]
        if not _live:
            return False, _("形状列表为空（或全部禁用）")
        for _it in _live:
            try:
                if float(_it.get("w", 0) or 0) > 0 and float(_it.get("h", 0) or 0) > 0:
                    return True, ""
            except (TypeError, ValueError):
                continue
        return False, _("所有形状宽/高为 0")
    # 旧单形状字段（mask_x/y/w/h，缺省 100×100）：无 mask_shapes 的旧存档走这条回退链
    return True, ""


def _build_mask_filter_block(settings, graph_id="", in_label=None, out_label=None,
                             motion_trim_start=None, motion_speed_factor=None):
    """遮罩（透明蒙版）滤镜段独立化 —— 返回段字符串，或 None（未启用 / 无有效形状）。

    2026-09-12 方案 A：本函数体 = 原 build_video_filter_chain 链尾的遮罩区块（逐字搬迁，
    只把 `filters.append(seg)` 改成「收集到 _out_seg」，并新增输入/输出标签包装）。
    搬迁动机：遮罩坐标基准 = 打开遮罩窗口时的**最终渲染帧**（crop→rotate→scale 之后）。
    画布模式把 crop/rotate/scale 交给画布段，链尾遮罩会落在「画布前的内容帧」→ 坐标错位，
    表现为「一开画布模式遮罩就失效」。故画布模式下由 build_canvas_filtergraph 在画布段
    产出之后调用本函数（in_label=画布输出、out_label=最终标签），重新落回最终渲染帧。

    in_label=None → 段首不带输入标签（接链内隐式流，即 build_video_filter_chain 的用法）；
    out_label=None → 段尾不带输出标签（同上）。两者都 None 时行为与搬迁前逐字节一致。

    回退链（与搬迁前一致）：多形状列表 → 单形状 PNG → 轨迹挡板 → 静态矩形。
    """
    if not settings.get("mask_enabled", False):
        return None
    # 2026-10-09：**新格式（mask_shapes 是 list）却没有任何有效形状** ⇒ 不再回退旧单形状
    # 默认矩形（100×100 @ 0,0）。两条理由：
    #   ① 那个「凭空冒出来的小方块」正是 LoopChromaFrame._do_save 注释里要防的
    #      「旧单形状矩形复活」（无形状时宁可没有遮罩）；
    #   ② 必须与自检原语 `_mask_has_geometry` **同判据** —— 否则出现「提示说没几何、
    #      实际却画出来了」的双份判据漂移（rotation-bounding-box 事故同型）。
    # ⚠️ 旧存档（**没有** mask_shapes 键）仍走下方回退链，逐字节不变。
    if isinstance(settings.get("mask_shapes"), list) \
            and not _mask_has_geometry(settings)[0]:
        return None
    _pre = ("[" + in_label + "]") if in_label else ""
    _post = ("[" + out_label + "]") if out_label else ""
    _out_seg = None
    # 2026-09-11：多形状列表优先（mask_shapes 非空且至少一项有效）→ Option 1 单 matte 链路；
    # 否则走下方原有单形状逻辑（PNG / 轨迹挡板 / 静态矩形），完全不变。
    _multi_seg = _build_mask_multi_shape_filters(
        settings, graph_id, motion_trim_start, motion_speed_factor)
    if _multi_seg:
        _out_seg = _multi_seg
    else:
        # ⚠️ 2026-09-11：本行是 mask 分支尾部所有标签（mk{_sfx}a/msk/aa/am）的唯一来源；
        #   漏掉它 → 单形状回退路径（mask_shapes 空/无效）引用未绑定 _sfx 直接抛
        #   UnboundLocalError（base 多形状重构 f2f1a18 曾真实发生）。切勿删除。
        #   守门：tests/_probe_mask_single_fallback.py ＋ tests/_test_mask_base_multi_parity.py。
        _sfx = graph_id or ""
        mx = str(settings.get("mask_x", "0")).strip() or "0"
        my = str(settings.get("mask_y", "0")).strip() or "0"
        mw = str(settings.get("mask_w", "100")).strip() or "0"
        mh = str(settings.get("mask_h", "100")).strip() or "0"
        _mode = settings.get("mask_mode", "outside")  # outside=只露矩形(矩形外透明); inside=矩形透明(矩形外正常)
        # 边缘羽化：matte 生成后追加 gblur 柔化边缘（0=硬边）。2026-09-10 接上对话框 feather 项
        # （此前对话框有 UI/tooltip 但滤镜未消费 mask_feather → 羽化不生效，本次补齐）。
        _feather = _opt_float(str(settings.get("mask_feather", "0")).strip() or "0", 0.0)
        _a, _msk = f"mk{_sfx}a", f"mk{_sfx}msk"
        _aa, _am = f"mk{_sfx}aa", f"mk{_sfx}am"   # alpha 相乘链标签（抠图兼容 2026-09-10）
        # ---- 动态轨迹挡板（2026-09-10 重建）：启用「遮罩轨迹」且有航点时，matte 走 split=3 ——
        # 一路整帧涂底色；一路 crop 出挡板矩形块、整面涂反向色；再 overlay 按 build_waypoint_expr
        # 轨迹表达式移动挡板 → 可选 gblur → format=gray → alphamerge。
        # 挡板移到哪，哪边按 mask_mode 显/隐（outside=擦除式揭示，inside=遮挡式擦除）。
        _traj_on = bool(settings.get("mask_traj_enabled", False))
        _raw_wps = settings.get("mask_waypoints")
        _wps = [w for w in _raw_wps if isinstance(w, dict)] if isinstance(_raw_wps, list) else []
        _cvw = int(_opt_float(settings.get("mask_traj_canvas_w", 0) or 0, 0))
        _cvh = int(_opt_float(settings.get("mask_traj_canvas_h", 0) or 0, 0))
        if not _cvw:
            _cvw = MASK_TRAJ_CANVAS_W
        if not _cvh:
            _cvh = MASK_TRAJ_CANVAS_H
        # ---- 形状图（2026-09-10）：载入自制黑白图/透明底挡块图当 matte（心形/星星等多边形）----
        # 链型：format=rgba,split=2 → 一路 lutyuv 涂底色（outside=黑 inside=白）；movie 载形状图
        # → alpha 源取不透明度（透明底挡块，颜色无关）/ 亮度图取灰度 → scale 到「矩形坐标」宽高
        # → (反转 negate / inside 再 negate) → overlay 贴上 → 可选 gblur 羽化 → format=gray → alphamerge。
        # ⚠️ 底色用 lutyuv 不用 drawbox：movie 引入 rgb 源后格式协商会把 drawbox 拖进 yuva420p，
        #   drawbox 的 black 在 yuv 上=limited 16 → PNG 区域外整圈 alpha=16 漏光
        #   （tests/_verify_mask_png 探针复现）；lutyuv 是查表滤镜恒保持 gray，0 恒 0。
        # ⚠️ movie 单帧 EOF 后 overlay 默认 eof_action=repeat 静止停留（t=2.5s 实测 alpha 不变）。
        # 形状与轨迹挡板两种 matte 语义不叠加：形状图生效时轨迹本轮不参与（日志提示）。
        _png_built = False
        _png_on = bool(settings.get("mask_png_enabled", False))
        _png_raw = str(settings.get("mask_png_path", "") or "").strip()
        if _png_on and _png_raw:
            _ptype = str(settings.get("mask_png_type", "bw") or "bw").strip()
            if _ptype not in ("bw", "alpha"):
                _ptype = "bw"
            try:
                _sw = max(2, int(float(str(settings.get("mask_w", "100")).strip() or "100")))
                _sh = max(2, int(float(str(settings.get("mask_h", "100")).strip() or "100")))
            except (ValueError, TypeError):
                _sw = _sh = 100
            _safe_png = _mask_shape_movie_path(_png_raw)
            if _safe_png:
                _pg = f"mk{_sfx}pgn"
                _shp = f"mk{_sfx}shp"
                _bgl = f"mk{_sfx}bg"
                _ml = f"mk{_sfx}m"
                _as = f"mk{_sfx}as"
                # 底色：outside=只露形状（黑底=透明）；inside=形状透明（白底=显示）
                # gbrp 域画底（RGB 白=255/黑=0 精确）→ extractplanes=g 取 full-range 灰度。
                # ⚠️ gray 域 matte 会被下游 blend 协商转 limited-range YUV（白→235/黑→16），
                # alphamerge 把它当 full-range alpha → 挡板外 6% 透明残留（2026-09-10 E 系列实测）。
                _base_c = "white" if _mode == "inside" else "black"
                # 整帧底色 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                _lut_v = "255" if _base_c == "white" else "0"
                _load = f"movie={_safe_png}[{_pg}];[{_pg}]"
                # rgb 路线：gbrp 取 G 平面（PNG 白=255 精确，gray 域转换会得 limited 白 235）；
                # alpha 路线：alpha 平面天生 full-range，原样保留
                _load += ("format=rgba,alphaextract" if _ptype == "alpha" else "format=gbrp,extractplanes=g")
                if bool(settings.get("mask_png_invert", False)):
                    _load += ",negate"
                if _mode == "inside":
                    _load += ",negate"
                # overlay x/y：启用轨迹且有航点 → 形状沿轨迹移动（心形探照灯/擦除），与矩形挡板
                # 同款等比还原（*main_w/cvw）与同段时间换算（motion_trim_start/speed 或
                # _trim_speed_from_settings）；否则静止在「矩形坐标」。表达式含逗号必须单引号包。
                _png_ox, _png_oy, _png_traj_on = mx, my, False
                _png_sc = None
                if _traj_on and _wps:
                    if motion_trim_start is not None:
                        _pts = float(motion_trim_start)
                        _psp = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
                    else:
                        _pts, _psp = _trim_speed_from_settings(settings)
                    _pxe, _pye, _pws, _pwz, _pwza = build_waypoint_expr(
                        _wps, sw=str(_cvw), sh=str(_cvh), trim_start=_pts, speed_factor=_psp)
                    if _pxe and _pye:
                        _png_ox = f"'({_pxe})*main_w/{_cvw}'"
                        _png_oy = f"'({_pye})*main_h/{_cvh}'"
                        _png_traj_on = True
                        _png_sc = _mask_sendcmd_info(_wps, _cvw, _cvh, _pts, _psp, f"mk{_sfx}png")
                _png_seg = (
                    f"format=rgba,"
                    # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离）：同一 split 输出同时喂
                    # alphaextract(→blend) 和 alphamerge 两条腿会触发 FFmpeg 协商 bug
                    # （alphamerge 报两腿尺寸不匹配=源尺寸，真机 2026-09-10 实测），
                    # split 多一腿隔离后正常
                    f"split=3[{_a}][{_as}][{_ml}];"
                    # 整帧底色 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                    f"[{_ml}]format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v},extractplanes=g[{_bgl}];"
                    f"{_load},scale={_sw}:{_sh},format=gray[{_shp}];"
                )
                if _png_sc is not None:
                    # sendcmd 挂 overlay 主输入支链（底色腿）+ overlay 起完整别名
                    _png_seg += (f"[{_bgl}]sendcmd=f='{_png_sc[0]}'[mk{_sfx}pgsc];"
                                 f"[mk{_sfx}pgsc][{_shp}]overlay@mk{_sfx}png"
                                 f"=x='{_png_sc[1]}':y='{_png_sc[2]}'")
                else:
                    _png_seg += f"[{_bgl}][{_shp}]overlay=x={_png_ox}:y={_png_oy}"
                if _feather > 0:
                    _png_seg += f",gblur=sigma={_feather:.1f}"
                # alpha 相乘（抠图兼容 2026-09-10）：无抠图时 format=rgba 已补 alpha=255
                # → 255×M/255=M 与旧替换语义等效；同开抠图时 = 抠图 alpha × 遮罩 matte（交集）。
                _png_seg += (
                    f",format=gray[{_msk}];"
                    f"[{_as}]alphaextract[{_aa}];"
                    f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                    f"[{_a}][{_am}]alphamerge"
                )
                _out_seg = _png_seg
                _png_built = True
                if _png_traj_on:
                    print(_('[遮罩] 形状图沿轨迹移动：{0}（路线={1}，大小={2}x{3}，模式={4}，{5} 航点）').format(_png_raw, _ptype, _sw, _sh, _mode, len(_wps)))
                else:
                    print(_('[遮罩] 形状图生效（静止）：{0}（路线={1}，矩形={2},{3},{4}x{5}，模式={6}）').format(_png_raw, _ptype, mx, my, _sw, _sh, _mode))
            else:
                print(_('[遮罩] 形状图路径不可用（不存在/含特殊字符且硬链接失败），回退矩形：{0}').format(_png_raw))
        _dyn_built = False
        if not _png_built and _traj_on and _wps:
            # 段时间换算与裁剪简易位置同款（2026-08-29：段时间=主视频原始时间 → 换算输出时间线）
            if motion_trim_start is not None:
                _ts0 = float(motion_trim_start)
                _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
            else:
                _ts0, _sp0 = _trim_speed_from_settings(settings)
            _xe, _ye, _ws, _wz, _wza = build_waypoint_expr(
                _wps, sw=str(_cvw), sh=str(_cvh), trim_start=_ts0, speed_factor=_sp0)
            if _xe and _ye:
                # 航点画布（cvw×cvh = 打开遮罩窗口时的最终渲染帧尺寸）→ 实际帧等比还原：
                # x*W/cvw、y*H/cvh，行程比例恒正确、与素材分辨率解耦（见 MASK_TRAJ_CANVAS_* 注释）。
                # x/y 表达式为纯数字累加 → 整体包一层括号乘系数即可，无变量歧义。
                # ⚠️ overlay 的 x/y 变量表里没有 iw/ih（那是 crop/drawbox 的），必须用 main_w/main_h。
                _xf = f"({_xe})*main_w/{_cvw}"
                _yf = f"({_ye})*main_h/{_cvh}"
                # 挡板尺寸同构还原；min 防挡板比帧大（轨迹挡板可拖出画布，但不能大于帧）
                _pw = f"min({mw}*iw/{_cvw},iw)"
                _ph = f"min({mh}*ih/{_cvh},ih)"
                if _mode == "inside":
                    # 矩形透明、矩形外正常：底=white（显示），黑挡板盖住处=透明
                    _base_c, _plate_c = "white", "black"
                else:
                    # 只露矩形（矩形外透明）：底=black（透明），白挡板扫过处=显示（擦除式揭示）
                    _base_c, _plate_c = "black", "white"
                # 整帧底色/挡板底用 lut 直通 gbrp（4.3 drawbox 兼容，见上方多形状段注释）
                _lut_v = "255" if _base_c == "white" else "0"
                _lut_pv = "255" if _plate_c == "white" else "0"
                _m0, _p0 = f"mk{_sfx}m0", f"mk{_sfx}p0"
                _as = f"mk{_sfx}as"
                _plt = f"mk{_sfx}plt"
                # sendcmd 接入（航点行数 > 阈值）：挂 overlay 主输入支链（matte 腿）内联 +
                # overlay 起完整别名（2026-10-01 全量接入）
                _dyn_sc = _mask_sendcmd_info(_wps, _cvw, _cvh, _ts0, _sp0, f"mk{_sfx}dyn")
                _msk_chain = f"format=gbrp,lut=r={_lut_v}:g={_lut_v}:b={_lut_v}"
                if _dyn_sc is not None:
                    _msk_chain += f",sendcmd=f='{_dyn_sc[0]}'"
                _seg1 = (
                    f"format=rgba,"
                    # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离），同 S2 形状图段注释
                    f"split=4[{_a}][{_as}][{_m0}][{_p0}];"
                    # gbrp 域画 matte（RGB 白=255/黑=0 精确）；overlay 同在 gbrp 域，
                    # 尾部 format=gray 转出 full-range 灰度进 blend（gray 域 matte 会被
                    # blend 协商转 limited YUV 白→235/黑→16，2026-09-10 E 系列实测）
                    f"[{_m0}]{_msk_chain}[{_msk}];"
                    f"[{_p0}]crop='{_pw}':'{_ph}':0:0,format=gbrp,"
                    f"lut=r={_lut_pv}:g={_lut_pv}:b={_lut_pv}[{_plt}];"
                )
                # overlay x/y 用单引号包表达式（航点累加表达式内含逗号）；
                # 隐藏段 x=-100000 → 挡板自动移出画面（hide/freeze 语义由 build_waypoint_expr 负责）
                if _dyn_sc is not None:
                    _seg2 = f"[{_msk}][{_plt}]overlay@mk{_sfx}dyn=x='{_dyn_sc[1]}':y='{_dyn_sc[2]}'"
                else:
                    _seg2 = f"[{_msk}][{_plt}]overlay=x='{_xf}':y='{_yf}'"
                if _feather > 0:
                    _seg2 += f",gblur=sigma={_feather:.1f}"
                _seg2 += f",format=gray[{_msk}];"
                # alpha 相乘（同形状图段注释）：抠图 alpha × 遮罩 matte = 交集
                _seg3 = (
                    f"[{_as}]alphaextract[{_aa}];"
                    f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                    f"[{_a}][{_am}]alphamerge"
                )
                _out_seg = _seg1 + _seg2 + _seg3
                _dyn_built = True
        if not _dyn_built and not _png_built:
            # 静态矩形（轨迹未启用 / 无航点 / 表达式构建失败时的兜底，行为与旧版一致）
            if _mode == "inside":
                # 矩形透明、矩形外正常：matte = 白底 + 黑矩形
                _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=white:t=fill,"
                         f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=black:t=fill")
            else:
                # 只露矩形（矩形外透明）：matte = 黑底 + 白矩形
                _draw = (f"drawbox=x=0:y=0:w=iw:h=ih:color=black:t=fill,"
                         f"drawbox=x={mx}:y={my}:w={mw}:h={mh}:color=white:t=fill")
            if _feather > 0:
                _draw += f",gblur=sigma={_feather:.1f}"
            _m = f"mk{_sfx}m"
            _as = f"mk{_sfx}as"
            _out_seg = (
                f"format=rgba,"
                # ⚠️ split 多出一条腿给 alphaextract（拓扑隔离），同 S2 形状图段注释
                f"split=3[{_a}][{_as}][{_m}];"
                # gbrp 域画 matte（RGB 白=255/黑=0 精确）→ format=gray 转出 full-range 灰度；
                # gray 域 matte 会被 blend 协商转 limited YUV（白→235/黑→16），
                # alphamerge 当 full-range alpha → 挡板外 6% 透明残留（2026-09-10 E 系列实测）
                f"[{_m}]format=gbrp,{_draw},format=gray[{_msk}];"
                # alpha 相乘（同形状图段注释）：抠图 alpha × 遮罩 matte = 交集
                f"[{_as}]alphaextract[{_aa}];"
                f"[{_aa}][{_msk}]blend=all_mode=multiply[{_am}];"
                f"[{_a}][{_am}]alphamerge"
            )
    if _out_seg is None:
        return None
    return _pre + _out_seg + _post


# ==================== 图节点（中间标签）工具 —— 2026-09-25 ====================
# 用途：把 -filter_complex 里某个中间标签（例如「主视频叠加完 PNG 之后」）当成一个
# 新的视频素材来处理 —— ①截断到该节点渲染出行焊缝 ②把一段滤镜插到它后面。
#
# 两条硬约束（tests/_verify_graph_node_tap.py 实跑 ffmpeg 得出，改动前务必重读该档案）：
#   ① 标签独占消费：一个标签被下游滤镜消费后，不能再用 -map 把它当输出 —— 会报
#      "Output with label 'x' ... was already used elsewhere" ⇒ 只能「截断」或「split 分流」；
#   ② 命名输出必须有去处：截断 / 删段后悬空的输出标签必须补 nullsink —— 否则报
#      "Filter 'xxx' has output N (...) unconnected"（真实图里 split 分叉极多，一截就悬空）。
#
# 因此本组全部是**纯字符串搬运**：输入一串 filtergraph，输出一串新的 filtergraph，
# 不 import 任何东西、不碰任何 builder、不依赖 app 状态 ⇒ 可直接单元测试。


def graph_split(graph):
    """按 ';' 切成多段，感知单引号保护（drawtext=text='a;b' 里的分号不是分隔符）。"""
    parts, buf, q, esc = [], [], False, False
    for ch in (graph or ""):
        if esc:
            buf.append(ch); esc = False; continue
        if ch == "\\":
            buf.append(ch); esc = True; continue
        if ch == "'":
            q = not q; buf.append(ch); continue
        if ch == ";" and not q:
            parts.append("".join(buf)); buf = []; continue
        buf.append(ch)
    tail = "".join(buf)
    if tail.strip():
        parts.append(tail)
    return [p for p in parts if p.strip()]


def _scan_labels(seg):
    """扫描段内所有**不在单引号内**的 [标签]，返回 [(start, end, name)]（按位置升序）。"""
    res, q, esc, i, n = [], False, False, 0, len(seg)
    while i < n:
        c = seg[i]
        if esc:
            esc = False; i += 1; continue
        if c == "\\":
            esc = True; i += 1; continue
        if c == "'":
            q = not q; i += 1; continue
        if c == "[" and not q:
            j = seg.find("]", i)
            if j == -1:
                break
            res.append((i, j + 1, seg[i + 1:j]))
            i = j + 1
            continue
        i += 1
    return res


def graph_parse_chain(seg):
    """拆一段 → (ins, body, outs)。ins/outs 是标签名（不含方括号），body 是滤镜主体。"""
    labs = _scan_labels(seg)
    ins, pos, k = [], 0, 0
    while k < len(labs) and labs[k][0] == pos:      # 段首连续标签 = 输入
        ins.append(labs[k][2]); pos = labs[k][1]; k += 1
    outs, end, j = [], len(seg), len(labs) - 1      # 段尾连续标签 = 输出
    while j >= k and labs[j][1] == end:
        outs.insert(0, labs[j][2]); end = labs[j][0]; j -= 1
    return ins, seg[pos:end], outs


def _last_top_comma(body):
    """主体内最后一个不在引号内的逗号位置（-1=没有）。"""
    q, esc, res = False, False, -1
    for i, c in enumerate(body):
        if esc:
            esc = False; continue
        if c == "\\":
            esc = True; continue
        if c == "'":
            q = not q; continue
        if c == "," and not q:
            res = i
    return res


def chain_last_filter(body):
    """取主体里最后一个滤镜名（用于给节点生成可读名/指纹）。"""
    if not body:
        return ""
    i = _last_top_comma(body)
    tail = body[i + 1:] if i >= 0 else body
    return tail.split("=", 1)[0].strip().lstrip("-")


def graph_nodes(graph):
    """列出可作为节点（在其后插入滤镜）的候选 → [(段序号, 输出标签名, 末滤镜名)]。

    只收「恰好一个输出标签」的段：多输出即分叉（split），语义不明，本轮不支持。
    """
    nodes = []
    for i, seg in enumerate(graph_split(graph)):
        _ins, body, outs = graph_parse_chain(seg)
        if len(outs) == 1:
            nodes.append((i, outs[0], chain_last_filter(body)))
    return nodes


def graph_nodes_full(graph):
    """graph_nodes 的扩展：额外返回段主体（用于判别视频/音频段）。

    返回 [(段序号, 输出标签名, 末滤镜名, 主体)]，只收「恰好一个输出标签」的段。
    """
    out = []
    for i, seg in enumerate(graph_split(graph)):
        _ins, body, outs = graph_parse_chain(seg)
        if len(outs) == 1:
            out.append((i, outs[0], chain_last_filter(body), body))
    return out


# 音频段判定用的滤镜 token（含 = 的是带参滤镜名，避免误命中其它词）
_AUDIO_FILTER_TOKENS = (
    "anull", "amix", "acrossfade", "atrim", "adelay", "asetpts", "aformat",
    "aresample", "apad", "pan=", "bass=", "treble=", "equalizer=", "afftdn",
    "arnndn", "highpass=", "lowpass=", "loudnorm", "volume=", "acompressor",
    "aecho", "anlmdn", "acontrast", "dynaudnorm", "silenceremove", "asetrate",
    "achannelmap", "ajoin", "amerge", "asplit", "anullsrc", "anullsink",
    "areverse", "aphaser", "agate", "aemph", "adeclick", "adeclip",
)


def is_audio_segment(body):
    """判断一段 filter 主体是否为「音频段」（视频/音频节点对话框据此互相排除）。

    判别依据：①显式音频拼接标记 v=0:a=1 / a=1:v=0；②音频专用滤镜 token；
    ③aformat/aresample（音频归一）。视频段（overlay/scale/crop/format…）不含这些 → 判为视频。
    """
    b = (body or "").lower()
    if "v=0:a=1" in b or "a=1:v=0" in b:
        return True
    if "aformat=" in b or "aresample" in b:
        return True
    for _t in _AUDIO_FILTER_TOKENS:
        if _t in b:
            return True
    return False


def node_fingerprint(seg_index, last_filter, dup=0):
    """节点指纹 —— 「段序号 + 末滤镜名」。

    ⚠️ 为什么不用标签名当持久化 key：标签是随开关增减的 f-string（v_out_{i} / v_temp_{i}…），
    同一「第 N 步」在不同配置下名字会变 ⇒ 存了也对不上。改用位置+滤镜名作指纹，
    配置变了就自然失配 → 由调用方日志提示并跳过，绝不静默插到错误位置。
    """
    base = "#%d:%s" % (seg_index, last_filter or "null")
    return base if not dup else "%s#%d" % (base, dup)


def node_fx_key_of_node(seg_index, label, last_filter):
    """节点 → 其 node_fx key（统一口径，2026-10-17 Point 4 方案A）。

    · 组父行标签 `v_grp_<gid>_<n>` → **稳定语义 key** `grp:<gid>`（只依赖 gid，永不漂）；
    · 其余节点 → `node_fingerprint(段序号, 末滤镜名)`（保留原口径，零回归）。

    旧 `node_fingerprint` 取图内**位置**，单画布 A3 重构或成员增减位移 ⇒ key 漂 ⇒ 存好的
    父行效果查不到 ⇒ 被孤儿检测清空。父行标签本身只依赖 gid，故直接用 gid 作 key。
    所有「算节点 key」的地方都走本函数，保证 存储 / 查找 / 孤儿检测 一致。
    """
    _m = re.match(r"^v_grp_(.+)_\d+$", str(label or ""))
    if _m:
        return "grp:%s" % _m.group(1)
    return node_fingerprint(seg_index, last_filter)


def material_win_title(ident, tail=""):
    """「标签即素材」三入口的**统一窗口标题**（2026-10-18 用户定案 C）。

    父行 / 视频节点 / 命令编辑器打开的是**同一个**「视频轨道设置」窗，此前各自起名
    （`组轨道设置 - 组 g1（640x360）` / `节点效果 [v_grp_g1_1]` /
    `视频轨道设置（命令编辑器 · 填入滤镜串）`）⇒ 同一张 UI 三个名字，用户要建立三次映射。

    统一成 `素材设置 - <身份><尾巴>`：
      · `<身份>` 回答「这是谁」：`组 g1（640x360）` / `[v_grp_g1_1]` / `命令编辑器`；
      · `<尾巴>` 回答「当前状态」：` · 轨迹:父` / `（第 2 条）` / ` · 填入滤镜串`。
    ⚠️ 只改**标题文案**，不改任何窗口参数 / 行为；调用方缺省不传 title 时仍走这里。
    """
    return _("素材设置 - %s%s") % (ident, tail or "")


def dedup_node_fx_rows(raw_nodes):
    """graph_nodes_full 的 (i, name, lastf, body) → `rows` 元组 (key, i, lastf, name)。

    🔴 关键：组内多条成员腿（`v_grp_<gid>_0`、`v_grp_<gid>_1`…）都被
    `node_fx_key_of_node` 塌缩成同一个 `grp:<gid>` key。必须按 key 去重，否则
    「视频节点」对话框建树时同一个 tree iid 被插入两次 ⇒ `TclError: Item grp:g1
    already exists`。去重时保留「段序号最大」那条（= 父行最终输出），与
    `_apply_node_fx` 的 key2seg（grp: 取最大段）口径一致；非组 key 天然唯一不受影响。
    """
    _seen = {}
    for _i, _name, _lastf, _body in (raw_nodes or []):
        _k = node_fx_key_of_node(_i, _name, _lastf)
        if _k not in _seen or _i > _seen[_k][1]:
            _seen[_k] = (_k, _i, _lastf, _name)
    return list(_seen.values())


def node_fx_graph_id(key):
    """节点指纹 → ffmpeg 标签安全的 graph_id（2026-10-09：遮罩进节点后必须唯一）。

    指纹形如 `#3:scale`（重名时 `#3:scale#1`），含 `#` / `:` —— **不能**直接当 ffmpeg
    标签的一部分。这里压成字母数字下划线：`nfx3_scale` / `nfx3_scale_1`。

    ⚠️ 为什么必须每个节点一个：遮罩段自带 `[mk{graph_id}a]` 等 6 个内部标签且跨 5~8 段，
    两个节点都挂遮罩而 graph_id 相同 ⇒ 同名输出 ⇒ ffmpeg 拒整条链。局部模糊（同样带
    标签）此前共用常量 `"nodefx"` 也有这个隐患，一并收口。
    ⚠️ 顶层 def（铁律：顶格 def 会吞后面的类方法）。
    """
    import re as _re
    return "nfx" + _re.sub(r"[^0-9A-Za-z]", "_", str(key or ""))


def node_key_alias(base_nodes, target_nodes):
    """把「base 图」算出的节点指纹重锚到「target 图」的标签 → {指纹: 标签}。

    为什么需要：同一个「第 N 步」在两张图里**段序号常常不同**。正式命令图与预览图
    （mpv/ffplay 以及管道）是两套构图（预览多了 movie= 源段、trim 收尾段、末尾 null
    段等），于是直接拿各自算出的「#段序号:末滤镜名」互相对齐一定会大量落空
    （实测：3 个节点里只有主链那个对得上）。

    折中口径 —— **只按「同名末滤镜的第 n 次出现」对齐，且要求该滤镜名在两张图里出现
    次数完全相同**：次数不同说明这一层的结构真的变了（例如预览把某环节展开成多段），
    此时不给结果，由调用方按「处理链已变化」提示跳过。宁可不生效，也绝不插到别的节点上。

    精确相同的 key 由调用方**优先**使用，本函数只负责补齐没命中的那些。

    返回 {指纹: (标签, 段序号)}（2026-09-26 起带段序号）：PiP 级联 amix 的同名标签
    [amain] 顺序复用时，只拿标签名没法区分「第 n 个 amain」→ 调用方须按段序号插入
    （insert_after_at），否则永远命中第一个。
    """
    out = {}
    if not base_nodes or not target_nodes:
        return out
    tgt_by_f, base_cnt = {}, {}
    for _i, _n, _f in target_nodes:
        tgt_by_f.setdefault(_f, []).append((_n, _i))
    for _i, _n, _f in base_nodes:
        base_cnt[_f] = base_cnt.get(_f, 0) + 1
    seen = {}
    for _i, _n, _f in base_nodes:
        _nth = seen.get(_f, 0)
        seen[_f] = _nth + 1
        _lst = tgt_by_f.get(_f) or []
        if len(_lst) != base_cnt[_f]:      # 该滤镜层在两张图里数量不对等 → 不猜
            continue
        if _nth < len(_lst):
            out[node_fingerprint(_i, _f)] = _lst[_nth]   # (标签, 段序号)
    return out


def _overlay_tip_segs(graph):
    """图里所有「overlay 第二输入（上层）的生产者」段序号，按 overlay 出现顺序。

    即「子视频链末端」——它后面紧跟着把它叠到主画面上的那一段 overlay。
    只收**恰好一个输出标签**的段（多输出 = split 分叉，语义不明，与 graph_nodes 同口径）。
    """
    segs = graph_split(graph)
    out = []
    for _i, _seg in enumerate(segs):
        _ins, _body, _outs = graph_parse_chain(_seg)
        if len(_outs) != 1 or len(_ins) < 2:
            continue
        if chain_last_filter(_body) != "overlay":
            continue
        _src = _ins[1]
        for _j in range(len(segs)):
            if _j == _i:
                continue
            _i2, _b2, _o2 = graph_parse_chain(segs[_j])
            if len(_o2) == 1 and _src in _o2:
                out.append(_j)
                break
    return out


def node_key_alias_overlay_tip(base_graph, target_graph):
    """正式图 ↔ 预览图的「子视频链末端」重锚 → {base 段序号: target 段序号}。

    为什么需要它（2026-10-09 实测 bug）：预览图与正式图是两套构图 —— 预览把子视频
    拆成 `movie=` / `scale=` 多段、尾部另有 `trim=…,setpts=…` 收尾段。于是
    `node_key_alias` 的「末滤镜名第 n 次出现」口径会把**子视频链**上的节点效果错配到
    **收尾段**：正式图里遮罩挂在 `v_temp_0`（下面紧接 overlay，alpha 被消费 ⇒ 看得见），
    预览图里却挂到 `vo`（图的最终输出）—— 播放器不消费 alpha ⇒ **遮罩完全看不见**，
    而命令预览与实际转换都正常。这是「预览路径没接」的真因。

    本函数按「第 k 个 overlay 的第二输入生产者」对齐，位置与语义都对得上。

    ⚠️ 两张图的 overlay 数量不等 ⇒ 返回 {}（结构真变了，不猜）
    —— 宁可不生效，也绝不生效错地方（与 node_key_alias 同一条铁律）。
    """
    _b = _overlay_tip_segs(base_graph or "")
    _t = _overlay_tip_segs(target_graph or "")
    if not _b or not _t or len(_b) != len(_t):
        return {}
    return dict(zip(_b, _t))


def truncate_at(graph, label):
    """方案A 截断：丢掉该标签之后的所有段，让它变成末节点（这样就能 -map 了）。"""
    segs = graph_split(graph)
    for i, seg in enumerate(segs):
        _ins, _body, outs = graph_parse_chain(seg)
        if label in outs:
            return ";".join(segs[:i + 1])
    return None


def dangling_labels(graph):
    """图中「产出但无人消费」的输出标签（末段的输出=图的出口，不算悬空）。"""
    segs = graph_split(graph)
    produced, consumed = [], set()
    for i, seg in enumerate(segs):
        ins, _body, outs = graph_parse_chain(seg)
        consumed.update(ins)
        for o in outs:
            produced.append((i, o))
    last_i = len(segs) - 1
    return [o for i, o in produced if o not in consumed and i != last_i]


def add_nullsinks(graph, keep=None):
    """给悬空标签补 nullsink（约束②）。keep = 你自己要 -map 的那个，不给它补。"""
    dang = [d for d in dangling_labels(graph) if d != keep]
    if not dang:
        return graph
    extra = ";".join("[%s]nullsink" % d for d in dang)
    return "%s;%s" % (graph, extra) if graph else extra


def retime_input_heads(graph, labels, t):
    """把每个输入分支头的输出时间戳整体平移到 t 秒（补偿段接在**归零之后**）。

    背景（快路径 seek）：输入级 `-ss` 会把滤镜图时间轴**归零**（实测 `-ss 1.9` 后首帧
    `pts_time≈0`，不是 1.9），所以抽帧 / 快照要在每个输入入口补一段 `setpts=PTS+T/TB`
    把时间戳还原到真实位置 —— 否则 `rotate(t)` / `overlay enable(t)` / 色键 / 列表轨迹
    等**一切依赖 t 的表达式**都按 `t≈0` 算。典型症状：同一张快照图只改取帧时刻，画面
    **逐像素相同**（自旋转、淡入淡出、轨迹全部丢失）。

    🔴 补偿段的位置是唯一的坑：必须接在分支头 setpts **之后**。各分支头自带一段归零
    —— `[k:v]setpts=PTS-STARTPTS`（多输入 overlay 的对齐基准；主视频是静态图片时是
    恒等的 `setpts=PTS+0/TB`）—— 把补偿接在它**前面**会被整块抵消：
    `[0:v]setpts=PTS+1.9/TB,setpts=PTS-STARTPTS,…` 实测首帧又回到 `pts_time:0`。
    「先归零、再偏移」⇒ 首帧恰在 T，且保留归零对「非 0 起始 PTS」的规范化
    （与 `_rewrite_abs_trims` 的既有写法同款）。

    labels：输入标签列表（如 `["[0:v]", "[1:v]"]`）；t：秒（int/float/数字串皆可）。
    返回 `(新图, 命中数)`。某标签在图中没有 setpts 分支头 ⇒ 跳过、不计数
    （零回归：调用方看命中数即可，个别输入缺头不会让整体失败）。
    """
    try:
        _add = ",setpts=PTS+%s/TB" % _ffsec(t)
    except Exception:
        return graph, 0
    _out = graph or ""
    _n = 0
    for _lb in labels:
        # 只认「该标签紧接 setpts=」这种**分支头**形态；后续对同标签的引用（如
        # `[m][1:v]overlay=…`）不匹配，故不会被误改。
        _i = _out.find("%ssetpts=" % _lb)
        if _i < 0:
            continue
        # 跳到该 setpts 表达式末尾（下一个 `,` / `;` / `[` 之前）；表达式本身不含这些字符。
        _j = _i + len(_lb)
        while _j < len(_out) and _out[_j] not in ",;[":
            _j += 1
        _out = _out[:_j] + _add + _out[_j:]
        _n += 1
    return _out, _n


# 🔴 tap_seek（>0）快路径的**第二个**平移对象：滤镜自带生成器源（见 retime_source_heads）。
# 只列**纯视频生成器**（无时间性以外的副作用）；音频源（`anullsrc` / `sine` …）绝不可加
# setpts ⇒ 不在名单里的链条一律不动（零回归硬门）。
_VIDEO_SRC_FILTERS = frozenset((
    "color", "allrgb", "allyuv", "gray", "nullsrc",
    "pal75bars", "pal100bars", "rgbtestsrc", "smptebars", "smptehdbars",
    "testsrc", "testsrc2", "gradients", "mandelbrot", "life",
))


def retime_source_heads(graph, t):
    """把**无输入的生成器源**（`color=` / `testsrc=` …）的起始时间戳也平移到 t 秒。

    为什么必须补这一步（2026-10-17 用户报障「组父行右侧预览＝左边黑、只剩子画面」，
    真机构图 + 真 ffmpeg 复现：T>0 ⇒ 合成帧**整帧全黑**，T=0 正确）：
      `retime_input_heads` 只平移**输入分支**（`[k:v]…setpts=PTS+T/TB`）；而滤镜图里还有
      一类链条的起点不是输入、而是**生成器源** —— 典型就是嵌套合成的组画布
      `color=c=black@0:s=WxH:r=fps:d=len[v_gbase_G]`。它的时间轴恒从 **t=0** 起，同一张图
      里的输入腿却已被「输入级 `-ss` + setpts 补偿」平移到 **t=T** ⇒ 两个时间原点差了 T：
        · overlay（framesync）在第二个输入（成员内容腿）尚未到达前，先输出主输入（画布）
          的帧 ⇒ 图的**首帧**落在 t=0，那一帧只有空画布 ⇒ **全透明（渲染成黑）**；
        · `-frames:v 1` 取的正是首帧 ⇒ T>0 必黑，T=0 恰好正确。
      这正是「可视化选区 / 位置编辑器框内组合成图正常、而右侧预览默认 3 秒全黑」的差别
      （前者恒取 t=0 / 不经 tap_seek）。
    把生成器源统一平移到 T ⇒ 全图时间原点一致，**首帧即第 T 秒**的合成帧。

    ⚠️ 只认白名单 `_VIDEO_SRC_FILTERS`；且 body 里已有 `setpts=` 的段跳过（防重复注入）。
    返回 `(新图, 命中数)`；命中 0 也安全（老图照样能跑，只是沿用旧行为）。
    """
    try:
        _add = ",setpts=PTS+%s/TB" % _ffsec(t)
    except Exception:
        return graph, 0
    if not graph:
        return graph, 0
    _segs = graph_split(graph)
    _n = 0
    for _i, _seg in enumerate(_segs):
        _ins, _body, _outs = graph_parse_chain(_seg)
        if _ins or not _outs or not _body or "setpts=" in _body:
            continue          # 有输入（不属本函数职责）/ 无输出 / 已平移 ⇒ 跳过
        _fm = _body.split(",", 1)[0].split("=", 1)[0].strip()
        if _fm not in _VIDEO_SRC_FILTERS:
            continue
        _new = "%s%s[%s]" % (_body, _add, "][".join(_outs))
        if len(_outs) > 1:
            _new = "%s%s%s" % (_body, _add, "".join("[%s]" % _o for _o in _outs))
        _segs[_i] = _new
        _n += 1
    return (";".join(_segs), _n) if _n else (graph, 0)


def insert_after(graph, label, effect, tmp_suffix="_nf"):
    """在定义 label 的段后面插入一段滤镜。

    手法就是用户说的那句：把原输出改名成临时标签 → effect 接上 → 产出还原成原名。
    effect 可以是多段串（局部模糊之类的带标签子图就是这样）；只改「入口/出口」两端，
    内部自带标签原样并入。找不到或不满足前置条件返回 None（调用方负责提示）。
    """
    segs = graph_split(graph)
    for i, seg in enumerate(segs):
        ins, body, outs = graph_parse_chain(seg)
        if len(outs) != 1 or outs[0] != label:
            continue
        eff_segs = graph_split(effect)
        if not eff_segs:
            return None
        tmp = label + tmp_suffix
        new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
        eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])
        eff_segs[-1] = "%s[%s]" % (eff_segs[-1], label)
        return ";".join(segs[:i] + [new_seg] + eff_segs + segs[i + 1:])
    return None


def insert_after_at(graph, seg_index, effect, tmp_suffix="_nf"):
    """在指定段序号的段后面插入滤镜（insert_after 的按位版本）。

    为什么需要（2026-09-26）：PiP 级联 amix 的每个段输出都叫 [amain]（同名标签
    顺序复用），insert_after 按标签名找只会命中第一个 —— 用户在「音频节点」里选
    最后一个 amain，效果却插到第一个后面。按段序号（graph_split 下标）定位天然
    精确：指纹「段序号+末滤镜名」里的段序号在这里真正派上用场。
    手法与 insert_after 完全一致：原输出改名临时标签 → effect 接上 → 还原原名。
    段序号越界 / 该段输出不是单标签（分叉）/ effect 为空 → 返回 None（调用方提示）。
    """
    segs = graph_split(graph)
    if not (0 <= seg_index < len(segs)):
        return None
    ins, body, outs = graph_parse_chain(segs[seg_index])
    if len(outs) != 1:
        return None
    eff_segs = graph_split(effect)
    if not eff_segs:
        return None
    tmp = outs[0] + tmp_suffix
    new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
    eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])
    eff_segs[-1] = "%s[%s]" % (eff_segs[-1], outs[0])
    return ";".join(segs[:seg_index] + [new_seg] + eff_segs + segs[seg_index + 1:])


def _uc_seg_parts(seg):
    """段 → (ins, outs, body_span)，ins/outs 元素形如 (名字, 起, 止)（位置升序）。

    ⚠️ 分区口径与 graph_parse_chain **完全一致**（段首连续 = 输入、段尾连续 = 输出），
       差别只是把方括号的起止位置也带出来：改标签名必须按位置替换，
       拿子串 replace 会误伤参数文本里的方括号（drawtext 的 text='[' 之类）。
    """
    labs = _scan_labels(seg)
    ins, pos, k = [], 0, 0
    while k < len(labs) and labs[k][0] == pos:
        ins.append((labs[k][2], labs[k][0], labs[k][1])); pos = labs[k][1]; k += 1
    outs, end, j = [], len(seg), len(labs) - 1
    while j >= k and labs[j][1] == end:
        outs.insert(0, (labs[j][2], labs[j][0], labs[j][1])); end = labs[j][0]; j -= 1
    return ins, outs, (pos, end)


def graph_labels(graph):
    """图里已用到的**输出标签名**列表（去重保序）—— 自定义子图重名检查用。

    为什么要在写入前查：用户在自定义命令里写的标签若撞上主图已有的标签名，
    ffmpeg 会拒绝整条链（"multiple outputs with the name 'b'"），而报错只会甩一个
    陌生行号 ⇒ 自定义功能本来就是给高级用户的，但**提前把冲突点说清楚**不算替他兜底。
    """
    out = []
    for seg in graph_split(graph):
        for o in graph_parse_chain(seg)[2]:
            if o not in out:
                out.append(o)
    return out


def insert_effect_subgraph(graph, seg_index, effect, tmp_suffix="_uc_"):
    """在指定段后插入一条**允许带 [标签] / 用分号分多段**的自定义子图。

    2026-10-03 起：节点「自定义命令」开放标签（方案 B —— 保留用户写的标签，撞名/悬空只提示）。

    ⚠️ insert_after_at 为什么接不住：它的手法是「原输出改名 tmp → effect 前置 [tmp] →
       末段**追加**一个输出标签」，只覆盖「effect 恰好一段、零标签」这一种形状；
       effect 里但凡出现标签就必炸（More input/output link labels）。本函数补四件事：

      1. **入口注入**：首段若自带输入标签 → 把**第一个**换成 tmp（入口只能有一个，
         否则 ffmpeg 报 More input link labels）；没有 → 前置 `[tmp]`。
      2. **出口收口**：末段**改名**它最后一个输出标签成节点原标签（不是「追加」——
         追加会让末段多一个输出 ⇒ More output link labels）；没有输出标签 → 追加。
      3. **中段接线**：第 k 段没有输出标签、第 k+1 段却写了入口标签 → 把第 k+1 段的那个
         入口标签**上移**成第 k 段的输出（漏写输出标签最常见的就断在这里）。反过来
         「第 k 段输出 [12313]、第 k+1 段却写 [999]」→ 记为悬空引用，只提示、不改名。
      4. **多余输出接 nullsink**：末段除收口外还有没人接的输出（如写了 `[uc][uc2]`）→
         `[x]nullsink`（承既有约束②），并明确提示「这条支线画面不会进入最终输出」——
         ⚠️ 不静默吞：只补 nullsink 而不说，就是「错误找不到 + 效果丢失」的组合。

    返回 (新图, 提示列表)：
      - 新图为 None 表示插不进去（段序号越界 / 该段不是单输出 / effect 空）；
      - 提示列表 list[str] 全是**警告**，不拦、不改名 —— 用户原话「都已经用自定义了，
        默认高级用户，后果自负」；但凡我们替他动过标签的地方必须说清楚改了什么，
        否则「我写什么就跑什么」的直觉会变成排障噩梦。
    老写法（纯逗号链 / 无标签）走这里同样跑得通、提示为空 ⇒ 老工程零回归。
    """
    segs = graph_split(graph)
    if not (0 <= seg_index < len(segs)):
        return None, []
    ins, body, outs = graph_parse_chain(segs[seg_index])
    if len(outs) != 1:
        return None, []
    eff_segs = graph_split(effect)
    if not eff_segs:
        return None, []
    node_label = outs[0]
    tmp = node_label + tmp_suffix
    warn = []

    info = [_uc_seg_parts(s) for s in eff_segs]

    # 老形状（单段、入/出都没有标签）= 纯逗号滤镜链 = insert_after_at 支持的那种 ⇒ 直接复用，
    # 连临时标签后缀都用它的 "_nf"，老工程生成的图逐字节等价（零回归的第一道保险）。
    if len(eff_segs) == 1 and not info[0][0] and not info[0][1]:
        return insert_after_at(graph, seg_index, effect, "_nf"), []

    # ⚠️ 位置锚点一律**现场重算**，绝不复用开头的 info：下面的手法会来回改 eff_segs
    #    （前置 [tmp] / 把入口标签提到上一段 / 末段改名），任何一步改完，之前存下来的
    #    起止位置就整体错位 —— 实测踩过（2026-10-03）：末段写成 [uc][uc2] 时，前置 [b_uc_]
    #    之后旧位置切片把命令切成 "…:h[b]c][uc2]"，一条本来能跑的命令被改废。
    def _parts(i):
        return _uc_seg_parts(eff_segs[i])

    # ---- 1. 入口注入 ----
    _p0 = _parts(0)
    if _p0[0]:
        _nm, _s, _e = _p0[0][0]
        if _nm != tmp:
            eff_segs[0] = eff_segs[0][:_s] + "[%s]" % tmp + eff_segs[0][_e:]
            warn.append(_("第 1 段的入口标签 [%s] 已换成接本节点上游（[%s]）。") % (_nm, tmp))
        if len(_p0[0]) > 1:
            warn.append(_("第 1 段还带了 %d 个入口标签（[a][b] 形式），请确保它们是你图里真实存在的输出。")
                        % (len(_p0[0]) - 1))
    else:
        eff_segs[0] = "[%s]%s" % (tmp, eff_segs[0])

    # ---- 3. 中段接线（放在入口注入之后：第一段刚被改过）----
    #     _produced = 到当前为止「已经被某段产出」的标签名。悬空判据是「引用了但没人产出」，
    #     不是「和紧邻那段的输出名对不上」—— 分叉（split=2[a][p] 后紧跟 [p]delogo）这种
    #     完全正常的写法，用「对不上」判会一路刷屏自相矛盾的假警告。
    _produced = set(_nm for _nm, _a, _b in _parts(0)[1])
    for _k in range(len(eff_segs) - 1):
        _cur = _parts(_k)
        _n_ins = _parts(_k + 1)[0]
        if _n_ins:
            if not _cur[1]:
                _nm, _s, _e = _n_ins[0]
                # ⚠️ 2026-10-03 修「局部模糊在节点里标签必错」：这个标签若**已经被前面的段
                #    产出过**（典型 = 局部模糊的 split=2[bg][fg] 正好产出了下一段要接的 [fg]），
                #    上移就会造出第二个同名输出 ⇒ ffmpeg 拒（"multiple outputs with the
                #    name"）。这种其实是用户自己把分叉接好了，链本来就通 —— 一个字都不动。
                if _nm in _produced:
                    _produced |= set(_nm for _nm2, _a2, _b2 in _parts(_k)[1])
                    continue
                eff_segs[_k] = eff_segs[_k] + "[%s]" % _nm
                eff_segs[_k + 1] = eff_segs[_k + 1][:_s] + eff_segs[_k + 1][_e:]
                _rest = len(_n_ins) - 1
                warn.append(_("第 %d 段没写输出标签，已把第 %d 段的入口标签 [%s] 提上来当它的输出%s。")
                            % (_k + 1, _k + 2, _nm,
                               (_("（第 %d 段其余入口标签保持原样）") % (_k + 2)) if _rest else ""))
            _produced |= set(_nm for _nm, _a, _b in _parts(_k)[1])
            _left = [x for x in _n_ins if x[0] not in _produced]
            if _left:
                warn.append(_("第 %d 段引用了标签 [%s]，但前面的段并没有输出它 → 这条支线会断（多半是标签名写错）。")
                            % (_k + 2, _left[0][0]))
        else:
            _produced |= set(_nm for _nm, _a, _b in _parts(_k)[1])

    # ---- 2. 出口收口 ----
    _m_outs = _parts(-1)[1]
    if _m_outs:
        _nm, _s, _e = _m_outs[-1]
        if _nm != node_label:
            eff_segs[-1] = eff_segs[-1][:_s] + "[%s]" % node_label + eff_segs[-1][_e:]
            warn.append(_("末段的输出标签 [%s] 已改名为 [%s]（接回本节点下游）。") % (_nm, node_label))
        _extra = []
        for _n2, _s2, _e2 in _m_outs[:-1]:
            _extra.append("[%s]nullsink" % _n2)
            warn.append(_("标签 [%s] 这条支线没有下游，已接到空输出端 —— 它的画面不会进入最终输出。")
                        % _n2)
        if _extra:
            eff_segs[-1] = "%s;%s" % (eff_segs[-1], ";".join(_extra))
    else:
        eff_segs[-1] = "%s[%s]" % (eff_segs[-1], node_label)
        warn.append(_("末段没写输出标签，已自动收口成 [%s]（结果接回本节点下游）。"
                    "想让它流向别处时，请自己补一个输出标签。") % node_label)

    # ---- 重名检查（方案 B 的「对比一下是否重名，然后提示一下」）----
    # ⚠️ 只有**末段收口后那一个**输出标签允许等于 node_label（收口本来就是把它的输出
    #    改名成 node_label 接回下游）；其余任何段（尤其第 1 段）只要产出/引用了这张图里
    #    既有的标签名就必然是冲突 —— ffmpeg 会直接拒掉整条链（"multiple outputs with
    #    the name 'b'"）。早期版本图省事把「== node_label」整个排除，撞名的真实场景
    #    （自定义里写了 [b]，恰好就是本节点的标签）反而一声不吭，纯属漏报。
    _exist = set(graph_labels(graph))
    _close_idx = len(eff_segs) - 1
    _last_outs = _uc_seg_parts(eff_segs[-1])[1]
    _close_name = _last_outs[-1][0] if _last_outs else node_label
    for _idx, _s in enumerate(eff_segs):
        _allowed = set([tmp])
        if _idx == _close_idx and _close_name == node_label:
            _allowed.add(node_label)
        for _nm2, _a, _b in _uc_seg_parts(_s)[0] + _uc_seg_parts(_s)[1]:
            if _nm2 and _nm2 in _exist and _nm2 not in _allowed:
                warn.append(_("标签 [%s] 与这张图里已有的标签重名，ffmpeg 会拒绝整条链；"
                            "换个没用过的名字（如 [uc_%d]）即可。") % (_nm2, _idx + 1))

    new_seg = "%s%s[%s]" % ("".join("[%s]" % x for x in ins), body, tmp)
    return ";".join(segs[:seg_index] + [new_seg] + eff_segs + segs[seg_index + 1:]), warn


NODE_FX_CUSTOM_KEY = "_custom_chain"


def node_fx_items(v):
    """node_fx[key] / node_audio_fx[key] → **效果项列表**（2026-10-02 L1「自由顺序」）。

    一个节点可以挂 N 个效果，顺序即列表顺序（UI 可上移/下移）。存储两态并存：
    - 新：`[{...}, {...}]`（效果列表）
    - 旧：`{...}`（2026-10-02 之前是「一节点一效果」的裸 dict）→ **自动包成 1 项**，
      老工程零迁移、零回归。
    非 dict/list（脏数据）→ []。
    """
    if isinstance(v, list):
        return [x for x in v if isinstance(x, dict)]
    if isinstance(v, dict):
        return [v] if v else []
    return []


def node_effect_chain_multi(v, graph_id=None, material=False, material_size=None):
    """一个节点的效果列表 → 合并成**一条**滤镜串（顺序 = 列表顺序），交给一次插入。

    graph_id（2026-10-09，可选）：透传给 `node_effect_chain` 的标签前缀基名。本函数给
    每一项追加 `_序号` ⇒ **同一节点挂多条带标签效果**（两条遮罩、遮罩+局部模糊）也不撞名。
    缺省 None = 每项都用旧常量 "nodefx"（**仅供摘要/显示**；构图必须传，见
    `node_fx_graph_id`）。

    material（2026-10-16）：True ⇒ 用**独立素材口径** `node_material_chain`（组的最终
    输出标签；开缩放 / 淡入淡出 / 透明度 / 抠像），False = 旧口径 `node_effect_chain`
    ⇒ 未传参的老调用方逐字节不变。

    material_size（2026-10-16，可选取用）：素材节点**自己的尺寸** (w, h)，只在该节点勾了
    画布模式时被 `node_material_chain` 用来产画布图（画布=内容=这个尺寸）。
    None ⇒ 画布模式仍不产图（与改动前逐字节一致）。

    2026-10-03 起支持**链式**而非纯逗号拼接（开放 `[标签]` 后必须这样）：
    - 相邻两段「都没带标签」→ 仍用逗号连（= 老行为，纯逗号链仍然只是一个段）；
    - 任一侧带标签 → 用分号分两段，并把下段的入口标签对齐上段的输出标签
      （名字对不上就改下段的入口名）；上段没输出而下段有入口 → 把入口标签上移成上段输出。
    ⇒ 否则「同一节点挂 N 个效果」在带标签时整条链会断（实测 unconnected）。

    ⚠️ 必须合并成一条一次插入，不能逐项 insert_after_at：同一节点的多项段序号相同，
    插完第一项后第二项的段序号会漂移（现有 `_apply_node_fx` 只对**不同 key** 做降序
    防漂移，同 key 内无效）。合并后一次插入 ⇒ 顺序由列表决定、且零漂移。

    空列表 / 全空效果 → ''（调用方应跳过插入，与旧行为一致）。
    """
    _segs = []
    _builder = node_material_chain if material else node_effect_chain
    for _n, _it in enumerate(node_fx_items(v)):
        _gid_n = (None if graph_id is None else "%s_%d" % (graph_id, _n))
        # ⚠️ 只有素材口径的 `node_material_chain` 收 `material_size`（旧口径没这个形参，
        #    多传会 TypeError ⇒ 分支调用，绝不**kwargs 乱塞）。
        if material:
            _c = _builder(_it, graph_id=_gid_n, material_size=material_size)
        else:
            _c = _builder(_it, graph_id=_gid_n)
        if not _c:
            continue
        _parts = graph_split(_c)
        if not _parts:
            continue
        # 相邻两段都无标签 → 逗号连成一整段（老行为：纯逗号链永远只是一个段）
        if _segs and _uc_seg_parts(_segs[-1])[1] == [] and _uc_seg_parts(_parts[0])[0] == []:
            _segs[-1] = "%s,%s" % (_segs[-1], _parts[0])
            _parts = _parts[1:]
        _segs.extend(_parts)
    # 段间接线：下段的入口标签对齐上段的输出标签（对不上就改下段那个入口的名字）。
    # ⚠️ 2026-10-03 修「节点里局部模糊标签必错」（正常设置却没问题，根就在这）：
    #    这套接线只服务「下段**单入口**」的直线链。下段多入口（分叉合流）时**绝不能**
    #    只把第一个入口改名 —— 实测把局部模糊的 `[fg][bl]overlay` 改成 `[bl][bl]overlay`，
    #    「原帧当底图 + 糊块当叠加」的结构整个没了；再叠上「上段没输出就把入口名上移成
    #    上段输出」，还会给 overlay 追加一个和 split 已经产出的 [fg] 同名的新输出 ⇒
    #    ffmpeg 直接拒（"multiple outputs with the name"）。分叉一律**一个字都不动**，
    #    悬空/重名提示统一交给 insert_effect_subgraph 的 _produced 判据。
    for _k in range(len(_segs) - 1):
        _a_outs = _uc_seg_parts(_segs[_k])[1]
        _b_ins = _uc_seg_parts(_segs[_k + 1])[0]
        if not _b_ins or len(_b_ins) > 1:
            continue
        _nm, _s, _e = _b_ins[0]
        if _a_outs and _nm != _a_outs[0][0]:
            # ⚠️ 2026-10-03 续修：下段**单入口**时，入口名也可能根本不是「接上一段」，
            #    而是**接更早那一段的支线**（典型：局部模糊的 split=2[bg][fg] 产了 [fg]，
            #    下一段却写 [fg]delogo —— 用户是想把 delogo 挂在 split 的第二路上）。
            #    这种「对不上上段首个输出、但名字是前面某段真真实实产出来的」= 用户自己
            #    接好的分叉，照旧对齐改名就会把 [fg]delogo 改成 [bl]delogo（方案 B 明令
            #    不许替用户动标签）。只在「这个名字前面谁都没产出」时才认为是接错了，
            #    这时才按老行为对齐。
            if _nm in _produced_all(_segs, _k):
                continue
            _segs[_k + 1] = _segs[_k + 1][:_s] + "[%s]" % _a_outs[0][0] + _segs[_k + 1][_e:]
        elif not _a_outs and _nm not in _produced_all(_segs, _k):
            _segs[_k] = "%s[%s]" % (_segs[_k], _nm)
            _segs[_k + 1] = _segs[_k + 1][:_s] + _segs[_k + 1][_e:]
    return ";".join(_segs)


def _produced_all(_segs, _upto):
    """segs[0.._upto] 这段前缀里所有**已产出的标签名**集合（分叉接线前的重名护栏）。

    局部模糊这类结构：`split=2[bg][fg]` 已经产出了 [fg]，紧接着的 `[fg][bl]overlay`
    又被「上段没输出 → 把入口名上移成输出」的手法定成 `[fg][bl]overlay[fg]`，
    就变成两个同名输出 ⇒ ffmpeg 拒。所以上移之前必须先看这个名字是不是**用户（或
    前一效果）自己接好的现有支线**——是就别动，链本来就通。
    """
    _out = set()
    for _i in range(_upto + 1):
        for _nm, _a, _b in _uc_seg_parts(_segs[_i])[1]:
            _out.add(_nm)
    return _out


def node_label_friendly(name):
    """原始图标签 → 中文阶段名（**纯显示层**；定位仍靠指纹 = 段序号+末滤镜名）。

    为什么不做成「标签名 → 效果」的登记表（2026-09-27「节点窗显示友好名」）：标签是随开关
    增减的位置相关 f-string（`v_out_{i}` / `v_temp_{i}`…），登记表得改遍所有 builder。
    这里只做**从名字反推**的正则映射，漏匹配就原样返回原名 —— 显示降级，绝不误判。
    """
    import re as _re
    n = (name or "").strip()
    if not n:
        return "?"
    if n == "v_main_proc":
        return node_label_display("主视频（预处理后）")
    if n == "v_main_base":
        return node_label_display("主视频原始帧（blend 基底）")
    if n == "v_base":
        return node_label_display("画布基底")
    if n == "v1":
        return node_label_display("画布缩放后")
    if n == "amain":
        return node_label_display("主音频")
    if n == "aout":
        return node_label_display("音频输出")
    _m = _re.fullmatch(r"v_temp_(\d+)", n)
    if _m:
        return node_label_display("子视频 %d（预处理后）") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_out_(\d+)", n)
    if _m:
        return node_label_display("叠加子视频 %d 后") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_crop_(\d+)", n)
    if _m:
        return node_label_display("区域裁剪 %d") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"v_base(\d+)", n)
    if _m:
        return node_label_display("画布段 %d 基底") % (int(_m.group(1)) + 1)
    _m = _re.fullmatch(r"vt(\d+)", n)
    if _m:
        return node_label_display("画布段 %d 中间") % (int(_m.group(1)) + 1)
    return n


def node_label_display(name):
    """原始图阶段名 → **当前界面语言**的显示名（纯显示层，`node_label_friendly` 专用）。

    2026-10-02 建：node_label_friendly 里 11 条中文阶段名（「主视频（预处理后）」…）
    原是硬编码 return，multi 切英文界面也照出中文，这里统一收口到显示层。

    ⚠️ 必须是函数（multi 的 _() 依赖启动后装载的 TRANS）：写成模块级常量会把显示名
       冻在导入时的中文上（同 countdown_direction_display / node_group_display / node_fx_display）。
    ⚠️ 入参恒为中文阶段名（= _() 的 key），返回值恒为当前语言显示名；只用于**显示**，
       不参与任何比较/查表（定位仍靠指纹 = 段序号+末滤镜名）。
    ⚠️ 双版同构：base 不装 gettext → 恒等返回，中文界面行为零变化；multi 走 _()。
       改这一处务必同步另一版，反之亦然。
    """
    return _(name)


