        self.scale_height.set(w)

    def _popup_scale_algorithm_menu(self, event):
        """⇄ 按钮右键菜单：选缩放算法（2026-10-08）。

        算法不下拉到主区而是收进这里，为的是不占缩放行的横向空间；菜单项自带一句
        极简用途说明 ⇒ 不必再开一层弹窗。当前生效项前面打 ✓（空串 = 自动）。
        """
        _menu = tk.Menu(self, tearoff=0)
        _cur = _norm_scale_algorithm(self.scale_algorithm.get())
        # (canonical, 菜单文案)；canonical 恒英文（「自动」= 空串 = 不写 flags）
        # 文案「中文在前 + 英文在后」：中文开头左对齐更整齐，canonical 放末尾便于对照命令
        _items = (
            ("", _("自动（ffmpeg 默认）· auto")),
            (None, None),                       # 分隔线
            ("lanczos", _("放大首选，锐利 · lanczos")),
            ("spline", _("放大次选，柔和 · spline")),
            ("bicubic", _("速度画质均衡 · bicubic")),
            ("bilinear", _("快，偏糊 · bilinear")),
            ("fast_bilinear", _("最快，最糊 · fast_bilinear")),
            ("neighbor", _("最近邻，马赛克/硬边 · neighbor")),
            ("area", _("缩小抗锯齿好 · area")),
            ("sinc", _("缩小最锐但慢 · sinc")),
            ("gauss", _("高斯，柔和 · gauss")),
            ("bicublin", _("亮度bicubic+色度bilinear · bicublin")),
        )
        for _val, _label in _items:
            if _val is None:
                _menu.add_separator()
                continue
            _mark = "✓ " if _val == _cur else "   "
            _menu.add_command(label=_mark + _label,
                              command=lambda v=_val: self._set_scale_algorithm(v))
        with suppress(Exception):
            _menu.tk_popup(event.x_root, event.y_root)

    def _set_scale_algorithm(self, value):
        """选缩放算法（右键菜单回调）：canonical 恒英文；空串显示为「自动」。
        只在「启用缩放」勾选时才写进命令（见 build_video_filter_chain），算法本身
        不影响分辨率，只影响插值画质。"""
        self.scale_algorithm.set(value if value else _("自动"))
        # 与旧行为一致：本类没有 trace 链，靠调用方（页面）的刷新回调更新命令预览
        _cb = getattr(self, "refresh_cb", None)
        if _cb:
            with suppress(Exception):
                _cb()

    def extract_video_frame_scaled(self, input_file, frame_sec=0.0,
                                   target_width=None, target_height=None):
        """
        使用 FFmpeg 提取视频帧并缩放到目标尺寸，输出 PPM bytes（内存管道，零磁盘写）。
        若 target_width 或 target_height 为 None，则保持原始比例（自动计算）。
        返回 (实际宽度, 实际高度, PPM_bytes) 或 (None, None, None) 若失败。
        2026-08-27：接入模块级 LRU 帧缓存（与 _extract_frame_scaled 共用），
        消除反复打开可视化编辑器时对同一背景帧的重复子进程抽帧。
        """
        if not self.app.ffmpeg_cmd:
            return None, None, None
        # 静态图片只有 t=0 一帧：忽略 seek，始终抽首帧（避免 -ss>0 抽不到帧 → 抽帧失败）。
        # 「检测到图片就直接使用图片」：背景帧 = 图片本身（下游 tk.PhotoImage 渲染不变）。
        _is_img = _is_static_image_file(input_file)
        if _is_img:
            frame_sec = 0.0
        _ck = _frame_cache_key(input_file, frame_sec, target_width, target_height)
        _cv = _frame_cache_get(_ck)
        if _cv is not None:
            return _cv

        # 构建 scale 滤镜
        scale_filter = ""
        if target_width is not None and target_height is not None:
            scale_filter = f"scale={target_width}:{target_height}"
        elif target_width is not None:
            scale_filter = f"scale={target_width}:-2"
        elif target_height is not None:
            scale_filter = f"scale=-2:{target_height}"
        # 若两者都为 None，则不加 scale（输出原始尺寸）

        cmd = [
            self.app.ffmpeg_cmd,
            "-i", input_file,
            "-vframes", "1",
            "-f", "image2pipe",
            "-vcodec", "ppm",
        ]
        if not _is_img:
            # 视频才需要 seek；图片无时间轴，加 -ss 反而不抽帧。
            cmd.insert(1, "-ss")
            cmd.insert(2, str(frame_sec))
        # 如果 scale_filter 非空，插入 -vf 参数（放在 -i 之后，-vframes 之前）
        if scale_filter:
            vframes_idx = cmd.index("-vframes")
            cmd.insert(vframes_idx, "-vf")
            cmd.insert(vframes_idx + 1, scale_filter)
        cmd += ["pipe:1"]

        try:
            flags = _ffmpeg_spawn_flags()
            # 2026-09-08：stderr DEVNULL→PIPE + communicate(timeout=30)。
            # 旧写法 stdout.read() 无超时，ffmpeg 异常挂住时线程永久阻塞；
            # 失败时 stderr 尾部 / 空输出原因上浮到信息面板（曾因「截取」起始时间
            # 残留超出新视频时长 → -ss 越过 EOF → rc=0 空输出，用户只见报错不知因）。
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.PIPE, creationflags=flags)
            try:
                data, err_data = proc.communicate(timeout=30)
            except subprocess.TimeoutExpired:
                try:
                    proc.kill()
                    proc.communicate()
                except Exception:
                    pass
                self.app._append_info_ui(
                    _('[裁剪辅助] 取帧超时(30s): {0} @ {1}:.2fs').format(os.path.basename(input_file), frame_sec))
                return None, None, None
            if proc.returncode != 0 or not data:
                if proc.returncode != 0:
                    _tail = ""
                    if err_data:
                        _lines = [ln.strip() for ln in err_data.decode("utf-8", "replace").splitlines() if ln.strip()]
                        if _lines:
                            _tail = _lines[-1][:200]
                    self.app._append_info_ui(
                        _('[裁剪辅助] 取帧失败: {0} @ {1}:.2fs, ffmpeg 返回码 {2}').format(os.path.basename(input_file), frame_sec, proc.returncode)
 + (f" | {_tail}" if _tail else ""))
                else:
                    # rc=0 但 0 字节：-ss 越过 EOF（取帧时间 ≥ 视频时长），典型成因是
                    # 换了新主视频后旧「截取」起始时间残留。只提示不改行为。
                    self.app._append_info_ui(
                        _('[裁剪辅助] 取帧无输出帧: {0} @ {1}:.2fs —— 取帧时间可能超出视频时长，请检查「截取」是否残留开启（起始时间超出本视频）').format(os.path.basename(input_file), frame_sec)
)
                return None, None, None
            w, h = _ppm_dimensions_from_bytes(data)
            _frame_cache_put(_ck, (w, h, data))
            return w, h, data
        except Exception as e:
            self.app._append_info_ui(_("[裁剪辅助] 提取缩放帧失败: {0}").format(e))
            return None, None, None


