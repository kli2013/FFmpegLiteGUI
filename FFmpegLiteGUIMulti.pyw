# ================== 多语言 (i18n) ==================
# 设计：默认中文。TRANS 为空时 _() 直接返回原文（中文），因此未翻译/缺失项始终回退中文，
# 绝不会出现空白或崩溃。英文等语言从 lang/<code>.json 加载，键为中文原文、值为译文。
TRANS = {}
_CURRENT_LANG = "zh"

def _(msg):
    """翻译函数：返回当前语言译文，缺失则回退原文（中文）。非字符串原样返回。"""
    if not isinstance(msg, str):
        return msg
    return TRANS.get(msg, msg)

def _lang_search_dirs():
    """lang 文件夹候选目录（按优先级）。

    2026-09-08 修复：PyInstaller onedir（文件夹版，6.x 起）把数据文件统一放进
    <exe目录>/_internal，lang/ 打包后位于 _internal/lang；而 get_script_dir()
    frozen 时返回 exe 所在目录 → 旧逻辑只查 exe 目录，文件夹版找不到语言包，
    英文界面静默回退中文。
    候选顺序：
      1. 脚本/exe 目录 —— 源码运行；以及手动把 lang 放 exe 旁的发布方式（老行为保留）
      2. sys._MEIPASS —— PyInstaller 运行时数据根：onefile=解压临时目录，
         onedir=<exe>/_internal。非冻结环境不存在该属性，用 getattr 取。
    ⚠️ 不改 get_script_dir() 本身：ffmpeg_presets.json / editlog.txt / 字体缓存
    等是「可写配置」，放 exe 旁边是对的，只读的语言包才需要去 _internal 找。
    """
    dirs = [get_script_dir()]
    meipass = getattr(sys, "_MEIPASS", None)
    if meipass and meipass not in dirs:
        dirs.append(meipass)
    return dirs

def load_language(lang):
    """加载语言包到全局 TRANS。lang='zh' 或文件缺失时清空（回退中文）。"""
    global TRANS, _CURRENT_LANG
    _CURRENT_LANG = lang or "zh"
    TRANS = {}
    if _CURRENT_LANG == "zh":
        return
    try:
        for _dir in _lang_search_dirs():
            lang_path = os.path.join(_dir, "lang", f"{_CURRENT_LANG}.json")
            if os.path.exists(lang_path):
                with open(lang_path, "r", encoding="utf-8") as f:
                    TRANS = json.load(f)
                break
    except Exception:
        TRANS = {}

def get_current_lang():
    return _CURRENT_LANG

# ================== 进程优先级（设置项控制） ==================
# 转码默认「低于正常」优先级，避免 ffmpeg 占满 CPU 把 UI 拖死（配合日志节流根治卡顿）。
# 仅 Windows 生效；非 Windows 恒为 0。「normal」映射为 0（仅 CREATE_NO_WINDOW，用 OS 默认优先级）。
_PROC_PRIORITY_MAP = {
    "normal": 0,
    "below_normal": 0x00004000,   # BELOW_NORMAL_PRIORITY_CLASS（默认）
    "above_normal": 0x00008000,   # ABOVE_NORMAL_PRIORITY_CLASS
    "idle": 0x00000040,           # IDLE_PRIORITY_CLASS
    "high": 0x00000080,           # HIGH_PRIORITY_CLASS
}
_FFMPEG_PRIORITY_FLAG = _PROC_PRIORITY_MAP["below_normal"]

def _ffmpeg_spawn_flags():
    """返回 ffmpeg 等子进程的统一 creationflags：CREATE_NO_WINDOW + 当前优先级类。"""
    base = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
    return base | _FFMPEG_PRIORITY_FLAG

def _kill_proc_tree(pid):
    """Windows 下用 taskkill /T 杀进程树（覆盖 shell=True 的孙进程 ffmpeg），其他平台直接 kill。
    失败（进程已死等）一律忽略。"""
    with suppress(Exception):
        if sys.platform == "win32":
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(pid)],
                           creationflags=(subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        else:
            os.kill(pid, 9)

# 预览播放器进程登记表（mpv/ffplay，含音频引擎、轨列表播放、分段预览）：
# 关闭程序时统一杀掉，避免孤儿 ffplay 残留（用户报「关闭程序 ffplay 预览进程残留一堆」）。
# 只登记本程序自己 spawn 的播放器，绝不按进程名全量杀（用户可能另开着独立播放器）。
_PREVIEW_PROCS = []


def _register_preview_proc(p):
    """登记一个预览播放器进程；顺带清掉已自然退出的旧条目。"""
    with suppress(Exception):
        _PREVIEW_PROCS[:] = [q for q in _PREVIEW_PROCS if q.poll() is None]
    _PREVIEW_PROCS.append(p)


def _kill_all_preview_procs():
    """关闭程序时杀掉全部登记的预览播放器（已退出的跳过，静默忽略一切异常）。"""
    for q in list(_PREVIEW_PROCS):
        with suppress(Exception):
            if q.poll() is None:
                q.terminate()
    _PREVIEW_PROCS[:] = []

# 日志文本框行数上限（超出删前 1/4，控制内存与控件体积，根治长任务滚爆）
# detail=转换进程信息（ffmpeg stderr 逐行；实测统计行约 2 行/秒 → 10000 行≈80 分钟编码）
# info=关键信息（每个任务约 4~6 行 → 10000 行≈1000+ 个任务，批量时不再丢掉最早的任务结果；
#      两者行都很短，1 万行仍仅 MB 级，Tk 无压力）
_DETAIL_MAX_LINES = 10000
_INFO_MAX_LINES = 10000

def _faststart_on(settings):
    """编码设置里是否开启「网络优化」（mp4/mov 把索引放到文件最前面，可边下边播）。

    唯一来源 = 编码参数 `faststart_enabled`（VideoEncoderFrame，随编码预设一起保存），
    转换页与封装页共用同一份 → 天然全局生效。
    settings 为 None 或没有该键（纯流复制等没有编码参数的路径）→ False ，多数转码软件的默认设置
    """
    if not settings:
        return False
    v = settings.get("faststart_enabled", None)
    return False if v is None else bool(v)

# ================== 公共工具函数 ==================

def format_cmd_for_display(cmd_list: List[str]) -> str:
    """
    将命令列表转换为适合显示/复制的字符串，带必要的引号。
    Windows 使用 subprocess.list2cmdline，Unix 使用 shlex.quote 逐个转义。
    """
    if sys.platform == "win32":
        return subprocess.list2cmdline(cmd_list)
    else:
        return ' '.join(shlex.quote(arg) for arg in cmd_list)

# ---------- 命令编辑器：命令行 ↔ argv 互转 / 滤镜链拆分（2026-10-13） ----------
# 动机：复制出去跑受 **cmd.exe 8191** 字符上限约束，而内部 CreateProcess 上限 32767。
# 命令编辑器把命令铺平成「一行一个标签」便于阅读与就地编辑，再原样拼回 argv 直接 Popen。
#
# ⚠️ 铁律 1：反解析必须走 CommandLineToArgvW —— 它与 list2cmdline 互为逆运算。
#    自己写 tokenizer 必在反斜杠/引号组合上翻车（list2cmdline 的转义规则是非对称的）。
# ⚠️ 铁律 2：list2cmdline 的「需加引号」判据**只认空格与 Tab，不认 \n**（同理
#    CommandLineToArgvW 也只把空格/Tab 当分隔符）。两个「不认」抵消 ⇒ 含换行的参数
#    **往返仍然一致**（实测），但有两处会炸：① 复制进 cmd.exe 时换行＝命令结束，命令被
#    截断；② Treeview 单元格里换行会串成多行，破坏「一行一个标签」。故编辑/复制前用
#    `cmd_find_unsafe_args` 查出来提示用户，而不是假装看不见。
# ⚠️ 铁律 3：表格里存的是**裸 token（不含引号）**，引号由 list2cmdline 在拼回时自动添加
#    ⇒ 从根上杜绝「编辑时把引号配对改坏」这一整类事故。

CMD_ROW_EXE = "exe"        # argv[0]：程序自身
CMD_ROW_FLAG = "flag"      # 无值开关（-y / -nostdin）
CMD_ROW_OPT = "opt"        # 有值选项（-i / -c:v）
CMD_ROW_FILTER = "filter"  # 滤镜类选项：值按 `;` 拆成子链，可展开成二级行
CMD_ROW_OUT = "out"        # 末位位置参数（输出文件）
