                _sc_box = ttk.LabelFrame(page_subctrl, text=_("子视频批量控制（作用于全部子视频，不含主视频）"))
                _sc_box.pack(fill=tk.X, padx=8, pady=(10, 4))
                _sc_row1 = ttk.Frame(_sc_box)
                _sc_row1.pack(fill=tk.X, padx=6, pady=(6, 2))
                ttk.Label(_sc_row1, text=_("循环次数:")).pack(side=tk.LEFT)
                ttk.Entry(_sc_row1, textvariable=self.oneclick_loop_count, width=6).pack(side=tk.LEFT, padx=(2, 8))
                _sc_btn_loop = ttk.Button(
                    _sc_row1, text=_("一键有限循环(all)"),
                    command=lambda: self._pip_finite_loop_all(self.oneclick_loop_count.get()))
                _sc_btn_loop.pack(side=tk.LEFT)
                _sc_row2 = ttk.Frame(_sc_box)
                _sc_row2.pack(fill=tk.X, padx=6, pady=(2, 4))
                _sc_btn_chain = ttk.Button(
                    _sc_row2, text=_("一键设置开始"),
                    command=self._pip_chain_show_starts)
                _sc_btn_chain.pack(side=tk.LEFT)
                _sc_btn_mix = ttk.Button(
                    _sc_row2, text=_("一键混音(all)"),
                    command=self._pip_mix_all)
                _sc_btn_mix.pack(side=tk.LEFT, padx=(8, 0))
                _sc_hint = ttk.Label(
                    _sc_box,
                    text=_("接龙规则：第 1 个子视频接在主视频之后，之后每段起点 = 前一段起点 + 前一段时长 − 前一段转场时长。\n"
                         "声音（混音/替换/跟随）按显示起点自动跟上，无需再单独调音频。"),
                    wraplength=520, justify=tk.LEFT, foreground="#666666")
                _sc_hint.pack(fill=tk.X, padx=6, pady=(0, 6))
                ToolTip(_sc_btn_loop,
                        _("一键有限循环（All）：\n"
                        "为所有子视频启用循环控制并设次数（次数取本行「循环次数」框，1 = 只播一遍）。\n"
                        "子视频窗口有界（有限次数/显示结束）才能被转场链收录、总时长才算得准。"),
                        wraplength=420)
                ToolTip(_sc_btn_chain,
                        _("一键设置开始（接龙）：\n"
                        "按列表顺序把子视频依次接上前一段：第 1 个接在主视频之后（起点 = 主视频时长），\n"
                        "之后每段起点 = 前一段起点 + 前一段时长 − 前一段转场时长（前段挂了转场时画面会\n"
                        "提前切换，摆位同步让位；硬切项目转场时长为 0，即首尾相接）。\n"
                        "前一段时长探不到（无限循环没设次数）则该段原地不动。"),
                        wraplength=440)
                ToolTip(_sc_btn_mix,
                        _("一键混音（All）：\n"
                        "为所有子视频（不含主视频）把「音频模式」设为「混音」——子声并入主声、不再单独出一条轨。\n"
                        "与「音频跟随转场」勾选框自动切混音同源（都写循环/绿幕控制页那条「音频:」下拉）；\n"
                        "子视频本身无音轨时自动降级为忽略，零副作用。"),
                        wraplength=440)

            # ---- 页面5：叠加/偏移（仅在画中画或水印模式下显示） ----
            overlay_frame = None
            show_overlay = is_watermark or (pip_enabled_var is not None and pip_enabled_var.get())
            # 2026-10-15 更正（用户反馈「叠加/偏移页以前是都有的」）：节点编辑器
            # （右键「视频节点」）里**本页对所有节点保留** —— 之前那版加了
            # `node_ctx and overlay_track_idx is None ⇒ 不建页`，把普通 overlay 节点的
            # 页面整个吃掉了（只有「组节点」还剩）。该门控已删。
            # 本页写的是**轨道**的 overlay_x/y（不进 node_fx）⇒ 不会产生 null 空操作。
            # 每个节点尽量映射到它**自己的那条轨道**（`_open_node_tap_dialog` 传
            # overlay_track_idx/obj；组节点=组内主，普通 overlay 节点=对应子视频轨）；
            # 映射不到的主链节点仍按老行为提示「缺少索引或回调」。
            if show_overlay:
                page_overlay = ttk.Frame(notebook)
                notebook.add(page_overlay, text=_("叠加/偏移"))

                if is_watermark:
                    # 水印模式，使用 visual_callback
                    def watermark_visual_callback():
                        main_file = canvas_file or self.input_file.get().strip()
                        if alert_if(not main_file or not os.path.exists(main_file), _("提示"), _("请先选择一个有效的输入文件作为画布")):
                            return

                        # 主视频设置：调用方显式 main_settings_ctx 优先（队列任务编辑=task.settings，
                        # 2026-09-03 问题④：队列里取转换页 get_current_settings=错源），
                        # 否则主界面 get_current_settings（含主视频 crop/rotate，与封装页子视频
                        # 同源模式）；filt_frame 在水印编辑模式下承载**水印**设置（26789 注释），
                        # 用它的 rotate 算主视频背景帧=旋转丢失/错位。
                        # ⚠️ 形参独立命名 main_settings_ctx：回调内要新建局部 main_settings，
                        # 同名会触发「局部遮蔽形参」→ 首读 UnboundLocalError。
                        main_settings = None
                        if main_settings_ctx is not None:
                            main_settings = (dict(main_settings_ctx)
                                             if isinstance(main_settings_ctx, dict)
                                             else main_settings_ctx)
                        if not main_settings:
                            try:
                                if hasattr(self, "get_current_settings"):
                                    _gs = self.get_current_settings()
                                    if _gs:
                                        main_settings = dict(_gs)
                            except Exception:
                                main_settings = None
                        if not main_settings:
                            try:
                                _mt0 = next((t for t in self.merge_tracks
                                             if t.enabled and t.type == "video"), None)
                                if _mt0 is not None:
                                    main_settings = dict(_mt0.enc_settings)
                            except Exception:
                                main_settings = None
                        if not main_settings:
                            # 兜底：filt_frame（仅尺寸语义，旋转可能不准）
                            # vflip/hflip（2026-09-20 健壮性审计补）：该 dict 同时喂
                            # bg_pre_filter=_main_bg_pre_filter(...)（42709），缺键=兜底
                            # 分支下背景帧丢翻转（尺寸不受影响，但画面不镜像）。
                            main_settings = {
                                "crop_enabled": filt_frame.crop_enabled.get(),
                                "crop_width": filt_frame.crop_width.get(),
                                "crop_height": filt_frame.crop_height.get(),
                                "crop_left": filt_frame.crop_left.get(),
                                "crop_top": filt_frame.crop_top.get(),
                                "scale_enabled": filt_frame.scale_enabled.get(),
                                "scale_method": filt_frame.scale_method.get(),
                                "scale_width": filt_frame.scale_width.get(),
                                "scale_height": filt_frame.scale_height.get(),
                                "rotate": filt_frame.rotate.get(),
                                "vflip": filt_frame.vflip.get() if hasattr(filt_frame, "vflip") else False,
                                "hflip": filt_frame.hflip.get() if hasattr(filt_frame, "hflip") else False
                            }
                        # 获取主视频尺寸（优先使用传入的 main_video_size）
                        if main_video_size is not None:
                            main_w, main_h = main_video_size
                        else:
                            orig_w, orig_h = self._cached_video_dimensions(main_file)
                            if orig_w is None or orig_h is None:
                                orig_w, orig_h = 1280, 720
                            main_w, main_h = self.compute_final_size_with_order(orig_w, orig_h, main_settings)
                    
                        wm_file = initial_settings.get("file_path", "")
                        if alert_if(not wm_file or not os.path.exists(wm_file), _("提示"), _("水印文件未设置或不存在")):
                            return
                    
                        # 从 filt_frame 获取当前水印的滤镜设置（因为用户可能已修改）
                        # 注意：filt_frame 是主视频的滤镜框架，但在水印编辑模式下，它被用于水印设置
                        wm_settings = {
                            "crop_enabled": filt_frame.crop_enabled.get(),
                            "crop_width": filt_frame.crop_width.get(),
                            "crop_height": filt_frame.crop_height.get(),
                            "scale_enabled": filt_frame.scale_enabled.get(),
                            "scale_method": filt_frame.scale_method.get(),
                            "scale_width": filt_frame.scale_width.get(),
                            "scale_height": filt_frame.scale_height.get(),
                            "rotate": filt_frame.rotate.get(),
                            "vflip": filt_frame.vflip.get(),
                            "hflip": filt_frame.hflip.get(),
                            # 其他增强滤镜不影响尺寸，不需要
                        }
                    
                        orig_w, orig_h = self._cached_video_dimensions(wm_file)
                        if orig_w is None or orig_h is None:
                            orig_w, orig_h = 320, 240
                    
                        # 计算水印渲染尺寸（包含旋转）
                        wm_w, wm_h = self.compute_final_size_with_order(orig_w, orig_h, wm_settings)
                        if wm_w <= 0 or wm_h <= 0:
                            wm_w, wm_h = orig_w, orig_h
                    
                        # 打开编辑器
                        # ⚠️ 2026-08-29：背景帧预处理与画布同源（main_settings，含 crop_left/top/rotate）——
                        # 原来从 filt_frame 另读，水印编辑模式下语义混淆导致背景帧旋转丢失。
                        self.open_watermark_overlay_editor(
                            main_w, main_h,
                            wm_w, wm_h,
                            overlay_frame.overlay_x,
                            overlay_frame.overlay_y,
                            scale_enabled_var=filt_frame.scale_enabled,   # 用于回写缩放
                            scale_w_var=filt_frame.scale_width,
                            scale_h_var=filt_frame.scale_height,
                            watermark_dict=initial_settings,  # 用于回写水印设置
                            filt_frame=filt_frame,
                            parent=win,
                            free_layout=overlay_frame.overlay_free_layout.get(),
                            ov_angle_var=getattr(overlay_frame, "rotate_angle", None),
                            main_video_file=main_file,
                            main_render_size=(main_w, main_h),
                            bg_pre_filter=_main_bg_pre_filter(main_settings),
                            # 2026-10-05：**虚拟框内渲染水印真实帧**（透明叠在背景真实帧之上，
                            # 只保留红/蓝描边）⇒ 位置由画面本身反映，不必再开第二个预览窗。
                            # 缩放/旋转/透明度一律基于「按端预取的缓存帧」做，不反复解码源文件。
                            content_file=wm_file,
                            content_src_w=orig_w, content_src_h=orig_h,
                            content_time=0.0,
                            content_alpha=True,
                            coord_box=True,
                        )
                    overlay_frame = OverlayPositionFrame(
                        page_overlay,
                        app=self,
                        mode='sub',
                        track_idx=None,
                        track_obj=None,
                        filt_frame=filt_frame,
                        visual_callback=watermark_visual_callback,
                        # 2026-09-23：主视频作用域——转换页水印编辑器传 'convert'；
                        # 队列任务水印经 canvas_file/main_settings_ctx 显式给语境主视频
                        # （ctx 优先于 page_scope，轨迹坐标编辑器按此取本语境背景帧）。
                        page_scope=page_scope,
                        ctx_main_file=canvas_file,
                        ctx_main_settings=main_settings_ctx
                    )
                else:
                    # 画中画模式（或主视频偏移）
                    # 2026-10-15：节点语境（overlay_track_idx 由 `_open_node_tap_dialog` 传）——
                    # 位置页挂在**该节点对应的轨道**上：组节点 → 组内主（拖组合包围盒，
                    # group_box_edit=True）；普通 overlay 节点 → 对应子视频轨（拖它自己的盒）。
                    # 二者都由 open_visual → open_visual_overlay_editor(...) 消费。
                    _ov_tidx = overlay_track_idx if overlay_track_idx is not None else track_idx
                    _ov_tobj = overlay_track_obj if overlay_track_obj is not None else track_obj
                    overlay_frame = OverlayPositionFrame(
                        page_overlay,
                        app=self,
                        mode=overlay_mode,
                        track_idx=_ov_tidx,
                        track_obj=_ov_tobj,   # 透传：供轨迹坐标编辑器取子视频真实渲染尺寸
                        filt_frame=filt_frame,
                        visual_callback=None,
                        page_scope=page_scope,  # 2026-09-23：封装页='merge'（主视频画布偏移仅在封装页出现）
                        # 2026-10-16：无轨宿主（命令编辑器）注入的三个入口实现；
                        # 全 None（默认）⇒ 封装页/转换页/队列逐字节不变（见 OverlayPositionFrame docstring）。
                        overlay_visual_callback=overlay_visual_callback,
                        pad_visual_callback=pad_visual_callback,
                        tile_callback=tile_callback,
                        tile_inside_callback=tile_inside_callback,
                    )
                    overlay_frame.group_box_edit = bool(overlay_group_box)
                    # 2026-10-16：组父行的**节点指纹 key** —— 可视化编辑器里拧角度 / 拖
                    # 缩放把手时把结果写进父行的素材设置（投影），而不是写组内主轨道。
                    overlay_frame.group_fx_key_edit = (
                        overlay_group_fx_key if overlay_group_box else None)
                overlay_frame.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
                overlay_frame.set_settings(initial_settings)

            # ---- 页面6：轨道元数据（仅视频轨道非水印） ----
            if track_obj is not None and not is_watermark:
                page_meta = ttk.Frame(notebook)
                notebook.add(page_meta, text=_("轨道元数据"))
                meta_frame = ttk.Frame(page_meta, padding="10")
                meta_frame.pack(fill=tk.X, pady=5)
            
                # 语言选择（下拉框 + 自定义输入）
                ttk.Label(meta_frame, text=_("语言:")).grid(row=0, column=0, sticky="w", padx=5, pady=5)
                lang_var = tk.StringVar(value=track_obj.language)
                # 下拉框显示友好名称
                lang_combo = ttk.Combobox(meta_frame, textvariable=lang_var,
                                          values=[display for display, code in self.COMMON_LANGUAGES],
                                          state="normal", width=20)
                lang_combo.grid(row=0, column=1, padx=5, pady=5, sticky="w")
            
                # 自定义输入框（用于输入未列出的代码）
                ttk.Label(meta_frame, text=_("或手动输入:")).grid(row=0, column=2, padx=5, pady=5)
                custom_lang_var = tk.StringVar(value=track_obj.language)  # 初始同步
                custom_lang_entry = ttk.Entry(meta_frame, textvariable=custom_lang_var, width=10)
                custom_lang_entry.grid(row=0, column=3, padx=5, pady=5, sticky="w")
            
                # 绑定事件：从下拉框选择时，自动填充自定义框（填入标准码）
                lang_combo.bind("<<ComboboxSelected>>", _make_on_lang_select(lang_var, custom_lang_entry, self.COMMON_LANGUAGES))
            
                # 轨道标题（不变）
                ttk.Label(meta_frame, text=_("轨道标题:")).grid(row=1, column=0, sticky="w", padx=5, pady=5)
                title_var = tk.StringVar(value=track_obj.title)
                title_entry = ttk.Entry(meta_frame, textvariable=title_var, width=30)
                title_entry.grid(row=1, column=1, columnspan=3, padx=5, pady=5, sticky="w")

                # 章节标签（仅串行模式）
                chapter_label_var = tk.StringVar(value="")
                if is_concat_mode:
                    ttk.Label(meta_frame, text=_("章节标签:")).grid(row=2, column=0, sticky="w", padx=5, pady=5)
                    chapter_label_var.set(track_obj.enc_settings.get("chapter_label", ""))
                    chapter_label_entry = ttk.Entry(meta_frame, textvariable=chapter_label_var, width=30)
                    chapter_label_entry.grid(row=2, column=1, columnspan=3, padx=5, pady=5, sticky="w")

                # 提示信息
                ttk.Label(meta_frame, text=_("从下拉框选择常用语言，或直接输入 ISO 639-2/B 代码（如 cmn、yue）"),
                          foreground="gray").grid(row=3, column=0, columnspan=4, sticky="w", padx=5, pady=2)

            # 是否为主视频已在本函数前面计算（用于淡入淡出页的串行转场）
            bgm_enabled_var = None
            bgm_path_var = None
            bgm_volume_var = None

            # ================== 页面7：音频绑定 ==================
            # 仅在串接 / 画中画主视频下显示此页（水印无音频绑定需求）。
            # 2026-09-17：放宽到 (is_concat_mode or is_pip)——画中画主视频也开放「音频绑定」页（仅 BGM 框，
            # concat 专属的「音频源类型 / 音频独立截取」仍按 is_concat_mode 隐藏，见下方两处门控）。
            # 2026-09-18：画中画子视频不显示此页——子视频无任何控件开放（BGM 仅主视频；音频源类型 /
            # 音频独立截取仅串行），显示空标签页会误导用户以为子视频也能绑定音频。
            if ((is_concat_mode or is_pip) and not is_watermark
                    and track_obj is not None and track_obj.type == "video"
                    and (not is_pip or is_main_video)):
                page_audio_binding = ttk.Frame(notebook)
                notebook.add(page_audio_binding, text=_("音频绑定"))
    
                bind_frame = ttk.Frame(page_audio_binding, padding="10")
                bind_frame.pack(fill=tk.BOTH, expand=True)
    
                # 音频源类型：仅串行模式有意义（画中画音频来自轨道，无「自身/静音源」概念）→ PiP 下隐藏
                if is_concat_mode:
                    src_row = ttk.Frame(bind_frame)
                    src_row.grid(row=0, column=0, columnspan=2, sticky="w", padx=5, pady=5)
                    ttk.Label(src_row, text=_("音频源类型:")).pack(side=tk.LEFT, padx=(0, 5))
                    audio_source_type_var = tk.StringVar(value=initial_settings.get("audio_source_type", "self"))
                    source_frame = ttk.Frame(src_row)
                    source_frame.pack(side=tk.LEFT)
                    rb_self = ttk.Radiobutton(source_frame, text=_("使用视频自身音频"), 
                                              variable=audio_source_type_var, value="self")
                    rb_silence = ttk.Radiobutton(source_frame, text=_("生成静音流"), 
                                                 variable=audio_source_type_var, value="silence")
                    # 外部音频暂时隐藏，可后续启用
                    # rb_external = ttk.Radiobutton(source_frame, text="从外部文件导入", variable=audio_source_type_var, value="external")
                    rb_self.pack(side=tk.LEFT, padx=5)
                    rb_silence.pack(side=tk.LEFT, padx=5)
                    ToolTip(rb_silence,
                            _("静音流时长自动匹配视频片段时长。\n"
                            "此功能用于解决串接时因视频缺少音频流导致的音画错位问题。\n"
                            "注意：此功能会强制重新编码视频（无法使用流复制）。\n"
                            "如需快速拼接且保留原始编码，可提前用命令生成静音音频文件，\n"
                            "例如：ffmpeg -f lavfi -i anullsrc=r=44100:cl=stereo -t 10 silence.wav\n"
                            "然后将该音频流 copy 无损封装到视频中，最后再使用 copy 模式进行串接。"))

                if is_main_video:
                    bgm_enabled_var = tk.BooleanVar(value=bool(initial_settings.get("bgm_enabled", False)))
                    bgm_path_var = tk.StringVar(value=initial_settings.get("bgm_audio_path", "") or "")
                    _bv = _opt_float(initial_settings.get("bgm_volume", 0.3) or 0.3, 0.3)
                    bgm_volume_var = tk.DoubleVar(value=_bv)
                    bgm_trim_start_var = tk.StringVar(value=initial_settings.get("bgm_trim_start", "") or "")
                    bgm_trim_end_var = tk.StringVar(value=initial_settings.get("bgm_trim_end", "") or "")

                    bgm_frame = ttk.LabelFrame(bind_frame, text=_("背景音乐 (BGM，全局叠加)"), padding="4")
                    bgm_frame.grid(row=3, column=0, columnspan=2, sticky="we", padx=5, pady=4)

                    # 叠加背景音乐：勾选后展开【右侧】开始/结束 与【下方】音量/音频文件
                    # 原灰色说明文字收进 ToolTip（不再单独占用界面）
                    _bgm_chk = ttk.Checkbutton(
                        bgm_frame, text=_("叠加背景音乐"),
                        variable=bgm_enabled_var,
                        command=lambda: (_bgm_r0.grid() if bgm_enabled_var.get() else _bgm_r0.grid_remove(),
                                         _bgm_r1.grid() if bgm_enabled_var.get() else _bgm_r1.grid_remove())
                    )
                    _bgm_chk.grid(row=0, column=0, sticky="w", padx=5, pady=3)
                    ToolTip(_bgm_chk,
                            _("外部音频将循环铺满整段合并输出，并按此处比例降低音量后垫在原音之下。\n"
