    def _on_combo_changed(self, *args):
        """组合跳转相关控件变化时，触发外部刷新"""
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 新增：组合跳转切换回调 ----------
    def _on_combo_toggle(self):
        if self.combo_seek.get():
            # 启用组合跳转时，禁用精准模式（互斥）
            self.precise_trim.set(False)
            self.precise_check.config(state='disabled')
        else:
            self.precise_check.config(state='normal')
        if not self._setting and self.update_callback:
            self.update_callback()

    # ---------- 修改：精准模式切换回调（增加互斥） ----------
    def on_precise_toggle(self):
        if self.precise_trim.get() and self.show_combo_seek and self.combo_seek.get():
            # 如果精准模式被启用，但组合跳转已启用，则禁用组合跳转
            self.combo_seek.set(False)
            if self.combo_check:
                self.combo_check.config(state='normal')
        # 原有逻辑（如有）保留
        pass

    def on_trim_toggle(self):
        state = tk.NORMAL if self.trim_enabled.get() else tk.DISABLED
        self.trim_start_entry.config(state=state)
        self.trim_end_entry.config(state=state)

    # ---------- 图片素材模式：显示「显示时长」，隐藏常规截取控件 ----------
    def _current_source_is_image(self):
        u"""根据 file_source 回调判断当前素材是否为静态图片。"""
        try:
            if self.file_source is None:
                return False
            p = self.file_source()
            if not p:
                return False
            return _is_static_image_file(p)
        except Exception:
            return False

    def trim_active(self):
        u"""「截取」是否等效生效：图片素材没有时间轴，截取不适用（长度由「显示时长」决定）。
        统一出口——图片模式下控件已被隐藏，这里把残留状态一并屏蔽，
        避免隐藏控件的旧值被命令生成端消费（曾出现：图片被前置 -ss/-to 截取，覆盖显示时长）。"""
        if self._current_source_is_image():
            return False
        return bool(self.trim_enabled.get())

    def refresh_source_mode(self):
        u"""根据素材类型切换 UI：
        图片 → 仅显示「显示时长(秒)」，隐藏 启用截取/起止/精准/组合跳转；
        视频 → 显示常规截取控件，隐藏「显示时长」。
        幂等：模式未变直接返回（命令预览每次刷新都会调用一次）。"""
        is_img = self._current_source_is_image()
        if self._src_is_img_mode == is_img:
            return
        self._src_is_img_mode = is_img
        if is_img:
            for w in (self._top_line, self._time_frame, self._time_frame2,
                      self._precise_frame, self._combo_frame):
                if w is not None:
                    w.pack_forget()
            self._img_frame.pack(fill=tk.X, pady=4)
        else:
            self._img_frame.pack_forget()
            self._top_line.pack(fill=tk.X, pady=(0, 5))
            self._time_frame.pack(fill=tk.X, pady=2)
            self._time_frame2.pack(fill=tk.X, pady=2)
            self._precise_frame.pack(fill=tk.X, pady=5)
            if self._combo_frame is not None:
                self._combo_frame.pack(fill=tk.X, pady=2)
        if not is_img:
            self.on_trim_toggle()

    # ---------- 简易时间预览（内置帧浏览器，2026-08-25 方案 B） ----------
    def _open_simple_preview(self):
        """打开内置简易时间预览窗口，暂停后「设为起点/终点」自动回填截取时间。"""
        if not self.app or not self.file_source:
            return
        try:
            path = self.file_source()
        except Exception:
            path = None
        if alert_if(not path or not os.path.exists(path), _("提示"), _("请先选择要预览的视频文件")):
            return
        if alert_if(not self.app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        # ⚠️ 释放调用方弹窗的模态 grab（SafeToplevel 等）——否则预览窗口被 grab
        # 锁住焦点（点击/拖拽无效，与可视化选区同一问题），预览窗口自身置顶可交互。
        release_grab(self.app.root)
        self.app.show_time_picker(self.app.root, path,
                                  on_set_start=lambda s: self.trim_start.set(_format_preview_time(s)),
                                  on_set_end=lambda s: self.trim_end.set(_format_preview_time(s)),
                                  initial_marks=[(self.trim_start.get(), self.trim_end.get())],
                                  use_output_context=False)

    def _import_trim_clipboard(self):
        """读剪贴板一行 `-ss S -to E`（程序内部通用格式），直接填入开始/结束框（不弹窗）。
        用户场景：在预览里标记了首尾却忘了发送单段，或从音频等无预览窗口复制一行过来。"""
        # ⚠️ 非阻塞读（2026-09-16）：同步 clipboard_get 在预览窗口持有剪贴板时会死锁。
        read_clipboard_safe(self.winfo_toplevel(), self._import_trim_apply)

    def _import_trim_apply(self, text):
        text = (text or "").strip()
        pairs = parse_ss_to_commands(text)
        if alert_if(not pairs, _("提示"), _("剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）"), 'info'):
            return
        s, e = pairs[0]  # 只取第一行
        self.trim_start.set(_ffsec(s))
        self.trim_end.set(_ffsec(e))
        if not self._setting and self.update_callback:
            with suppress(Exception):
                self.update_callback()

    # ---------- 修改：get_settings 增加组合跳转字段 ----------
    def get_settings(self):
        res = {
            "trim_enabled": self.trim_active(),
            "trim_start": self.trim_start.get(),
            "trim_end": self.trim_end.get(),
            "precise_trim": self.precise_trim.get(),
            "img_duration": self.img_duration.get(),
        }
        if self.show_combo_seek:
            res["combo_seek"] = self.combo_seek.get()
            res["combo_threshold"] = self.combo_threshold.get()
        else:
            # 在不显示的场景下强制为 False
            res["combo_seek"] = False
            res["combo_threshold"] = 30
        return res

    # ---------- 修改：set_settings 增加组合跳转字段 ----------
    def set_settings(self, settings):
        self._setting = True
        try:
            self.trim_enabled.set(settings.get("trim_enabled", False))
            self.trim_start.set(settings.get("trim_start", "0"))
            self.trim_end.set(settings.get("trim_end", ""))
            self.precise_trim.set(settings.get("precise_trim", False))
            self.img_duration.set(settings.get("img_duration", "10"))
            self.refresh_source_mode()
            if self.show_combo_seek:
                self.combo_seek.set(settings.get("combo_seek", False))
                self.combo_threshold.set(settings.get("combo_threshold", 30))
                self._on_combo_toggle()
            else:
                self.combo_seek.set(False)
            self.on_trim_toggle()
        finally:
            self._setting = False

# ================== 内置简易时间预览（方案 B，2026-08-25） ==================
def _format_preview_time(sec: float) -> str:
    """秒 → HH:MM:SS.mmm（3 位小数），供截取时间回填。"""
    h, m, s = _hms_split(sec)
    return f"{h:02d}:{m:02d}:{s:09.6f}"


# ---------- 简易时间预览窗口宽度下限（2026-09-09） ----------
# 段落条 / 波形条 / 大波形都是 pack(fill=X, expand=True)，窗口越宽 → 时间轴像素越多
# → 1px 代表的秒数越少 → 打点、拖段、点选越精细。与画面尺寸**解耦**：画面仍由
# preview_max_w/h 决定并在窗口内居中，加宽不增加任何解码/取帧开销。
# 用「下限」而不是「+N 叠加」：两种模式各取一个下限，切换模式不会叠加成过宽。
_PREVIEW_WIN_MIN_W = 1100        # 画面模式窗口宽度下限（px）
_PREVIEW_AUDIO_WIN_MIN_W = 1400  # 音频模式窗口宽度下限（px，取代原「画面模式 +500」写法）


# ---------- 音频引擎常量（2026-09-05 方案B：ffplay 直读+波形，实测定版值） ----------
# ffplay -nodisp 状态行示例: "   9.49 M-A:  0.000 fd=   0 aq=  208KB ..."
# 音频主时钟=M-A；视频文件=A-V。取行首第一个数=当前播放位置（=耳朵听到的位置，~30Hz）。
_AUDIO_STATUS_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s+[A-Z]-[A-Z]:")
_WAVE_BUCKETS = 3000   # 波形包络桶数（整条时间轴，实测 60s mp3 解码+聚桶 0.23s）
_WAVE_SR = 8000        # 波形解码采样率（单声道 s16，纯内存管道无临时文件）

# ================== 更多设置（2026-08-28；2026-09-18 扩容） ==================
# 模块级配置字典：无 app/self 引用的模块级函数（get_video_dimensions / _frame_cache_put /
# _fonts_remember_recent）与 SimplePreviewer 从这里读取；App 初始化 /「更多设置」弹窗
# 保存时同步（见 _sync_global_settings）。
# 后 6 项 2026-09-18 由「写死的模块级常量」升级为可调：出厂默认值一律取自各同名常量
# （单一来源，避免两处写死走偏）。
_GLOBAL_SETTINGS = {
    "ffprobe_timeout": 5,   # ffprobe 探测超时（秒）
    "preview_max_w": 700,   # 简易时间预览画面宽度上限（px）
    "preview_max_h": 520,   # 简易时间预览画面高度上限（px）
    "preview_win_min_w": _PREVIEW_WIN_MIN_W,        # 时间预览窗口宽度下限·画面模式（px）
    "preview_audio_win_min_w": _PREVIEW_AUDIO_WIN_MIN_W,  # 同上·音频模式（px）
    "wave_buckets": _WAVE_BUCKETS,                  # 波形包络桶数
    "wave_sr": _WAVE_SR,                            # 波形解码采样率（Hz）
    "frame_cache_max": _FRAME_CACHE_MAX,            # 可视化背景帧 LRU 上限
    "fonts_recent_max": FONTS_CACHE_MAX_RECENT,     # 字体最近使用条数上限
    "preview_volume": 10,                           # 预览播放音量（ffplay -volume，0~100）
}


# 内置时间预览引擎（pipe_engine）的「工作分辨率上限」（px，按宽度计）：
# 简易时间引擎用 CPU 跑 ffmpeg 滤镜图，4K+ 主视频上叠加子视频/滤镜时全分辨率计算极吃力
# （外部播放器 mpv/ffplay 走 GPU 不显此问题）。帧尺寸（渲染尺寸 / pad 画布 / 画布模式产出）宽超过
# 此值时，把帧尺寸整体乘 f = 上限/宽，并**改写链内分辨率**为降采样尺寸（不在图首另插 scale——
# 链内自带用户「分辨率」scale，插在图首会被它整段顶回去），全部几何（_main_w/_main_h、子尺寸、
# pad 画布）同步乘 f → 布局逐像素一致、仅像素变少，图计算量按 f² 下降。≤此值时 f=1，完全不改设置、
# 几何零缩放（与旧行为逐字节一致）。仅作用于 pipe_engine 路线；外部播放器（GPU）不受此限。
# 实测（tests/_bench_pipe_cap_speed3.py，4K/4s，真链顺序「缩放 → 降噪/锐化/颜色」）：
#   缩放后 hqdn3d+unsharp 3.53s→0.68s（5.2x，1.1x 实时 → 5.9x 实时）；
#   缩放后 nlmeans        36.8s→2.3s（15.9x）；
#   纯 overlay / delogo 链本就 ≥3x 实时 ⇒ 无增益（~1.0x，上限只对「缩放之后的昂贵滤镜」有效）。
_PIPE_WORK_MAX_W = 1280

# ---------- A/V 双引擎内核常量（2026-09-06：内核移植自 tests/_audit_av_sync_player.py） ----------
_AV_POLL_MS = 50            # 同步仲裁 / UI 刷新周期
_AV_PUMP_MS = 16            # 画面取帧周期
_AV_FRAME_BUF = 24          # 帧缓冲上限（背压，防内存爆）
_AV_SEEK_DEBOUNCE_MS = 250  # 波形条点击防抖（每次 seek 都要重启 ffmpeg+ffplay）
_AV_HARD_TOL = 0.30         # 硬容差：漂移超了立刻重启音频
_AV_SOFT_TOL = 0.12         # 软容差：超了持续 soft_hold 秒才重启（小偏差不打断）
_AV_SOFT_HOLD = 1.20
_AV_RESTART_GAP = 0.70      # 两次音频重启最小间隔（防抖成噪声）
_AV_LATENCY = 0.20          # 音频启动延迟初始估计（Popen→出声，实测 0.20s）
_AV_LAT_MIN, _AV_LAT_MAX = 0.03, 0.60
_AV_COARSE_BACK = 15.0      # ffplay 粗 seek 回退秒数（音频解码瞬时，无感）
_AV_DRIFT_HISTORY = 400     # 漂移曲线采样点数（400*50ms=20s）

# ---------- 音频 seek 链路诊断日志（2026-09-05 排查"播放态 seek 不跳/跳回"） ----------
# 2026-09-06 用户确认可用后下线：_atrace 改 no-op，调用点保留（翻 _AUDIO_TRACE_ON
# 即可整体重开诊断；将来彻底稳定可连同调用点一起移除）。
_AUDIO_TRACE_ON = False
_AUDIO_TRACE_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                 "_audio_trace.log")

def _atrace(msg):
    if not _AUDIO_TRACE_ON:
        return
    with suppress(Exception):
        with open(_AUDIO_TRACE_PATH, "a", encoding="utf-8") as f:
            f.write("%.3f %s\n" % (time.monotonic() % 1e5, msg))
_WAVE_REDRAW_GAP = 0.4  # 波形渐进重绘最小间隔（秒）
_AUDIO_POLL_MS = 50     # 音频引擎主线程轮询周期


class SimplePreviewer:
    """内置简易时间预览：纯 ffmpeg 依赖（无需 mpv/PotPlayer），定位截取时间用。
    - ffmpeg 解码 rawvideo rgb24 走 stdout（每帧 w*h*3 字节），双 -ss（输入粗 seek +
      输出精 seek）首帧精确到目标网格帧（B 帧正确重排）。
    - **时间 = anchor(seek 目标) + 帧计数/fps 推算**，确定性、无外部依赖。绝不读
      ffmpeg stderr 传时间——实测其 stderr 为 4KB 块缓冲，showinfo 行不逐帧 flush，
      会导致时间停住（"无法恢复播放"的根源）。
    - **暂停 = 立即 kill ffmpeg 进程**（画面保留在 canvas，时间固定）——不做"停读
      管道让 ffmpeg 挂起"（管道缓冲写满会死锁）。恢复播放 = 从当前位置重新双 -ss
      seek 启动（与步进同一条已验证好用的路径，~200ms）。
    - 步进（上一帧/下一帧）= 暂停态从 当前时间 ± 1/fps 重启，读一帧显示后即 kill 停住。
    - 进度条拖动 = kill + 双 -ss 重启（250ms 防抖），拖动后进入播放态，时间立即精确。
    - 线程模型：worker 线程只读原始字节，主线程 after() 创建 PhotoImage 显示（tk 非线程安全）。
      所有管道读取均非阻塞+超时，解码异常超时放弃，worker 绝不可能卡死。
    """

    PREVIEW_WIDTH = 640

    def __init__(self, root, ffmpeg_cmd, ffprobe_cmd, file_path,
                 on_set_start=None, on_set_end=None, app=None, on_send_segments=None,
                 on_send_waypoints=None, on_send_tw_items=None, on_send_chapters=None,
                 initial_marks=None, mark_rows=None, on_mark_edit=None,
                 on_coord_request=None, trim_start=None, speed_factor=None,
                 use_output_context=True, start_mode="video",
                 lavfi_complex=None, pipe_aspect=None, pipe_duration=None,
                 pipe_start=None, pipe_out_mode=False,
                 pipe_audio_graph=None, pipe_audio_map=None, initial_time=None,
                 wp_mark=None, pipe_alpha=False):
        """initial_marks: 打开预览时回溯调用方已有时间 [(s, e), ...]（秒/字符串/None 混合），
        探测完成后重建为标记段显示在段落条上，可直接「复制时间」粘到别处（如音频窗口）。
        on_send_*（2026-08-29 回滚恢复）：单对单「发送到」按钮，mark_row 原位、点击即发，
        各调用方只传自己的目标（跨窗口同步走「复制时间/导入时间」-ss/-to 剪贴板）。
        trim_start/speed_factor（2026-08-29 方向A/阶段1）：主视频截取/变速参数。默认 None
        且 use_output_context=True 时**自动从 app.get_time_context() 读取**（子功能预览），
        调用方零参数；激活时在时间旁追加「成片」时间显示（=(素材−trim)/speed）。
        主视频自身预览（截取/分段/章节）传 use_output_context=False：纯素材时间、不显示成片。
        lavfi_complex（2026-09-20「时间预览引擎」）：给定时本预览改为**管道合成模式**
        ——`-filter_complex` 渲染完整合成图（水印/旋转/轨迹/画布/画中画）→ 末尾 scale+pad 到
        预览尺寸 → rawvideo 管道。默认 None ⇒ 行为与旧调用方**完全一致**（普通 scale 管道）。
        ⚠️ 图内 movie= 子输入不吃命令行 -ss，但 _launch_video_pipe 会把它改写成外部 `-ss -i`
        输入（帧精确），改不到的才退回 `seek_point` 近似（向后关键帧 seek，误差可达一个 GOP）——
        与正式导出「主从 pipe_start 起算、子从 0 起算」口径一致。
        见 research/preview/README1.md 修正表 #2 与 Phase 2 记录。
        pipe_aspect：合成图画面比（≠源文件时给，用于画面框计算）；pipe_duration：输出时长上限
        （图内可能有 color 无限源，给 0/None 时退化为「主输入时长 → 1h 兜底」）。
        pipe_start：打开后自动定位到的秒数（管道模式用；对应旧路径把截取起点交给播放器 --start
        的行为）——默认 None ⇒ 从 0 开始（旧行为）。
        pipe_out_mode（串行合并专用）：True = 图本身是「输出时间轴」（多段 + xfade），不能用
        素材时间轴 seek → 拖动时改为在图的末端追加 `trim=start=sec`（输出侧裁剪，从头解码到
        目标点）。默认 False = 素材时间轴模式（-ss 主输入 + 子输入改写成外部 -i）。
        pipe_audio_graph/pipe_audio_map（串行合并专用，2026-09-20）：合成音频图（各段 amovie +
        concat/acrossfade/BGM，末标签 = pipe_audio_map）。给定时 _a_start 不再直读主文件音轨
        （串行合并的主文件=第一段 → 播完第一段就无声，用户实测），改起
        `ffplay -f lavfi -i "<图>;[末标签]atrim=start=at,asetpts=PTS-STARTPTS"` 播**合成音频**，
        声音跨段连续且与 xfade 画面对齐；has_audio/时长也按图口径覆盖。默认 None ⇒ ffplay 行为
        与旧版逐字一致。
        pipe_alpha（2026-10-12，research/pipe-preview-alpha §5）：True = 尾链在 format=rgb24 前
        垫一层**棋盘格底**（透明指示）——本预览出口是 rawvideo rgb24（无 alpha），合成图带 alpha
        时 alpha 被整幅丢掉 ⇒ 表现为「和没有透明一模一样」，用户看不出抠图/遮罩/透明度的效果。
        垫底后只有真透明处透出格子。⛔ **必须门控、不可默认开**：垫底多一次 gbrp→rgb24 转换，
        全不透明工程整帧会有 ≤2 灰阶偏移 ⇒ 由调用方按 `_settings_needs_alpha(settings)`
        （绿幕抠像 / 遮罩 / 描边 / 透明度<1.0）+ 虚拟源透明底显式声明。默认 False ⇒ 旧调用方
        逐字节不变。⚠️ 导出当前帧会**关掉棋盘重渲**（见 save_current_frame_png），格子不会被烤进 PNG。"""
        self.root = root
        self.ff = ffmpeg_cmd
        self.ffprobe = ffprobe_cmd
        self.file = file_path
        # ---- 管道合成模式（2026-09-20「时间预览引擎」Phase 1）：门控，None=完全旧行为 ----
        # _pipe_graph：已翻译成 ffmpeg -filter_complex 的合成图（[0:v] 主输入 + [pv_src] 末标签）；
        # None ⇒ _launch_video 走原 -vf scale 路径，零行为变化。
        self._pipe_graph = lavfi_complex or None
        self._pipe_aspect = pipe_aspect
        self._pipe_dur = pipe_duration
        self._pipe_start = pipe_start
        # 🔴 串行合并（out_mode）的 `_pipe_start` **恒 0** ⇒ 进度条/时间读数 = **成片时间轴**
        #    并**故意从 0 开始**（设计，不是 bug）：多段 trim 顺序拼接后成品必须 0 基，否则
        #    第 2 段起整段时间错位。研究依据 + 物证见 research/seek-model/README.md §4.1。
        #    ⛔ 别为了「打开时光标落在素材位置」把它改成素材轴（2026-10-13 试过、已整体回退）：
        #    合成音频图 `_pipe_audio_graph` 是 0 基成片轴，`_a_start` 直接拿位置读数当
        #    `atrim=start=` ⇒ 两轴相差 S0 ⇒ 声音错位 + 到 EOF 反复重启（用户实测「声音炸、
        #    一会有一会没」）。真想改轴必须连音频图一起改，收益仅是「打开时光标位置」，不值。
        self._pipe_out_mode = bool(pipe_out_mode)
        self._pipe_audio_graph = pipe_audio_graph or None
        self._pipe_audio_map = pipe_audio_map or "[ao]"
        # 透明指示棋盘底（2026-10-12）：True 才在管道尾链垫格子；默认 False = 旧调用方逐字节不变
        self._pipe_alpha = bool(pipe_alpha)
        # #5（2026-10-08）：开窗后落到的**素材时刻**（秒）。仅列表轨迹面板「重开本管道」下传
        # （回到用户原来看的那个时刻）；None ⇒ 不覆盖 _pipe_start 的定位（旧行为）。
        self._initial_time = initial_time
        # #3（2026-10-08）：本窗与「列表轨迹弹窗未保存坐标」的关系（见 _wp_mark_status）：
        # None = 无关（标题/横幅逐字节不变）；"live" = 图里用了未保存坐标（工程文件未改）；
        # "stale" = 有未保存坐标但注不进这张图（预览仍是存档值）。由 _build_ui 转成标题 + 横幅。
        self._wp_mark = wp_mark if wp_mark in ("live", "stale") else None
        self.on_set_start = on_set_start
        self.on_set_end = on_set_end
        self._stop = False
        # 音频形态入口（音频分段效果「时间预览」）默认不开播：等探测完成后
        # _apply_probe_ui 调 _enter_audio_mode 统一切引擎（避免视频引擎先空跑一下）。
        self._start_mode = start_mode
        self._playing = (start_mode != "audio")
        # ---- A/V 双引擎内核状态（2026-09-06 移植自 tests/_audit_av_sync_player.py：
        #      画面=ffmpeg 双 -ss + 帧队列 + 墙钟节奏显示（丝滑），位置真源=帧号/fps；
        #      音频=ffplay 从时钟 + 漂移仲裁容错重启） ----
        self.has_video = True     # 后台探测修正（_run_probe）；worker 等待 _probe_done
        self.has_audio = True
        self._current_us = 0      # 当前帧微秒时间戳（=_v_pos*1e6，标记/播放头/循环全读它）
        self._at_eof = False      # 播放到末尾标记（恢复播放时从头）
        self._v_lock = threading.Lock()
        self._v_frames = collections.deque()   # [(rel_idx, bytes)]
        self._v_proc = None
        self._v_gen = 0           # 世代号：kill（暂停/seek）递增，旧 reader/帧全作废
        self._v_target = None     # 待启动的起点（None=无请求）
        self._v_one = False       # 只读一帧（暂停态定位/步进）
        self._v_anchor = 0.0      # 当前 proc 首帧绝对时间（_grid 对齐真实帧 pts）
        self._v_wall0 = None      # 首帧显示墙钟（节奏基准）
        self._v_shown_idx = -1    # 已显示相对帧号
        self._v_pos = 0.0         # 画面位置（秒）= anchor + 已显示帧号/fps
        self._v_eof = False
        self._autostart_ts = 0.0  # 首次自动开播冷却（ffmpeg 异常时防 20/s 空转）
        self._dur = None
        self._fps = 25.0
        self._vw, self._vh = 640, 360
        self._frame_bytes = 0
        self._img = None          # PhotoImage 引用保持（替换即释放旧图）
        self._last_rgb = None     # 最近一帧 raw rgb24 字节（导出 PNG 用）
        self._ppm_header = None   # PPM 头缓存（_vw/_vh 探测后惰性构建，_show_frame 复用）
        self._last_scale_tick = 0.0  # 播放中进度条跟随节流（100ms）
        self._seek_after = None   # 进度条拖动防抖
        self._updating_scale = False  # 抑制 scale.set 触发的 command（防自我 seek 循环）
        self._aspect = 16.0 / 9.0  # 视频宽高比（_run_probe 更新；初始默认 16:9）
        self._probe_done = threading.Event()  # 后台探测完成信号（worker 等待，主线程不阻塞）
        self._keyframes = None  # ffprobe 预扫描的关键帧 pts_time 列表（None=扫描中/失败/过密禁用）
        self._kf_buttons_enabled = False  # 关键帧按钮是否已启用（主线程轮询置位）
        self._kf_scan_done = False  # 关键帧扫描是否结束（成功/失败都置位，主线程轮询据此提示）
        # ---- 成片时间显示（2026-08-29 方向A/阶段1：默认自动读 app 时间上下文）----
        if use_output_context:
            if trim_start is None and app is not None:
                try:
                    _tc = app.get_time_context()
                    trim_start, _te, speed_factor = _tc[0], _tc[1], _tc[2]
                except Exception:
                    trim_start, speed_factor = 0.0, 1.0
            if trim_start is None:
                trim_start = 0.0
            if speed_factor is None:
                speed_factor = 1.0
            self.trim_start = float(trim_start or 0.0)
            self.speed_factor = _opt_float(speed_factor or 1.0, 1.0)
            if self.speed_factor <= 0:
                self.speed_factor = 1.0
            self._show_disp_time = (self.trim_start != 0.0 or self.speed_factor != 1.0)
        else:
            # 主视频自身预览（截取/分段/章节）：纯素材时间线，不显示成片时间
            self.trim_start = 0.0
            self.speed_factor = 1.0
            self._show_disp_time = False
        # ---- 标记 / 段落条 / 循环预览（2026-08-28） ----
        self._marks = []            # 已闭合标记段 [(s, e), ...]（秒）
        # 段↔来源行映射（2026-10-08）：每条标记段可选绑定一个调用方「列表轨迹」行号
        # （None = 无来源，如现场新标记/导入）。用于①端点改写回写原行②点段开位置编辑器。
        self._mark_rows = []
        self._initial_marks = initial_marks  # 调用方回溯的初始时间（探测完成后注入）
        self._initial_mark_rows = mark_rows   # 与 initial_marks 平行：各段来源行号（可 None）
        self._on_mark_edit = on_mark_edit          # (row_idx, s, e) 段端点改写 → 回写来源行
        self._on_coord_request = on_coord_request  # (row_idx, back_win) 点「坐标」→ 打开该行位置编辑器
        self._initial_injected = False  # 初始标记是否已注入（探测完成只注入一次）
        self._open_start = None     # 未闭合起点（None=当前无待闭合起点）
        self._selected_seg = None   # 当前选中段索引（段落条点击/双击）
        self._loop_active = False   # 循环预览某段中
        self._loop_s = 0.0
        self._loop_e = 0.0
        self._loop_cooldown = 0.0   # 循环回跳防抖时间戳
        self._loop_seek_pending = False  # 循环内部 seek 守卫（避免自我退出循环）
        # 外部播放器入口：已透传进所有调用点，故「外部播放此段」按钮始终创建（None 时点击仅提示）
        self._app = app
        self._on_send_segments = on_send_segments  # 发送全部标记到分段列表回调
        self._on_send_waypoints = on_send_waypoints  # 发送全部标记到轨迹列表回调（hide 段）
        self._on_send_tw_items = on_send_tw_items  # 发送全部标记到文字水印列表回调（占位条目）
        self._on_send_chapters = on_send_chapters  # 发送全部标记到章节列表回调（段起点章节点）
        self._mark_palette = ["#85B7EB", "#97C459", "#E1A33B", "#B58EDC", "#5FB0B5"]
        self._seg_tri = []          # 段落条起点三角标记命中检测 [(x, idx), ...]
        self._ph_line = None        # 播放头竖线图元
        self._ph_tri = None         # 播放头顶部小三角图元
        # ---- 音频引擎 / A/V 仲裁状态（2026-09-06 内核移植自 _audit_av_sync_player） ----
        # 音频=ffplay 从时钟（粗 -ss 回退 + atrim 精修），画面是主、音频只有被纠正的份；
        # _audio_mode=True 时切纯音频形态（音频时钟即真源，标记/段落条共用 _current_us）。
        self._audio_mode = False    # 进入/退出由 _enter/_exit_audio_mode 统一管理
        self._ffplay = self._resolve_ffplay()
        self._a_proc = None
        self._a_gen = 0             # 进程代际号：kill 也递增（防竞态）
        self._a_anchor = 0.0        # 本次 ffplay 启动的目标点（状态行时钟+anchor=绝对时间）
        self._a_anchor_wall = 0.0
        self._a_spawn_wall = 0.0
        self._a_parsed = False      # 本次 ffplay 启动后是否已收到首条状态行
        self._a_pos = 0.0
        self._a_events = queue.Queue()  # reader 线程唯一输出通道 ("eof", gen)
        self._a_last_restart = 0.0
        self._a_restarts = 0
        self._a_dead = False        # 音频已播到尾（音视频时长不等）→ 停止纠正
