        ttk.Label(r3, text=_("(视频忽略此项)"), foreground="gray").pack(side=tk.LEFT)
        ttk.Label(f2, text=_("图片自动缩放适配主视频尺寸，不足则 pad 黑底居中；视频直接拼接在末尾。"),
                  foreground="gray").pack(anchor=tk.W, pady=(2, 0))
        ToolTip(f2,
                _("在输出视频末尾追加一段内容：\n"
                "• 图片（如二维码）：循环显示指定秒数，自动缩放适配输出尺寸，\n"
