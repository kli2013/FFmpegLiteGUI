        r3 = _mk_row()
        ttk.Label(r3, text=_("高度 (像素):")).grid(row=0, column=0, padx=(0, 4))
        ttk.Entry(r3, textvariable=h_var, width=10).grid(row=0, column=1, padx=(0, 6))

        r4 = _mk_row()
        ttk.Label(r4, text=_("时长 (秒):")).grid(row=0, column=0, padx=(0, 4))
