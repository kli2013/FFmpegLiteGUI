        """简易时间预览（纯帧浏览器）：回填子视频 overlay enable between 起/止（秒，主视频时间线）。
        不关闭窗口可连续设置；字段为秒数（between(t,start,end) 用 float 解析）。"""
        ff = self.filt_frame
        app = getattr(ff, "app", None) if ff is not None else None
        if alert_if(app is None, _("提示"), _("未找到主应用，无法预览")):
            return
        # 子视频是叠加层：显示时段 enable 吃「主视频」时间线（输出时间线 t），主视频取
        # edit_video_settings 透传的 canvas_file（队列=task.input / 封装=merge_video），
        # 空则回退转换页主视频。⚠️ 不能用 current_file——那是子视频轨道文件本身。
        path = ""
        try:
            path = (getattr(ff, "canvas_file", None) or "").strip()
        except Exception:
            path = ""
        if not path or not os.path.exists(path):
            path = app.input_file.get().strip() if hasattr(app, "input_file") else ""
        if alert_if(not path or not os.path.exists(path), _("错误"), _("主输入文件不存在"), 'error'):
            return
        if alert_if(not app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        release_grab(app.root)

        def on_start(t):
            self.show_start_var.set(_ffsec(t))

        def on_end(t):
            self.show_end_var.set(_ffsec(t))

        app.show_time_picker(app.root, path, on_set_start=on_start, on_set_end=on_end,
                             initial_marks=[(self.show_start_var.get(), self.show_end_var.get())])

    def _pick_standard_color(self):
        from tkinter import colorchooser
        color_code = colorchooser.askcolor(title=_("选择抠像颜色"), parent=self, initialcolor=self.chroma_color.get())[1]
        if color_code:
            self.chroma_color.set(color_code)

    def open_outline_dialog(self):
        """外轮廓描边设置弹窗：启用、颜色、宽度（2026-10-02）。

        只有三个参数：描边的语义（沿 alpha 轮廓外扩一圈）决定了它不需要坐标编辑器，
        也不需要像遮罩那样区分方向 —— 保持最小可用，避免摆设 UI。
        """
        # ⚠️ 与 open_chroma_color 一致：colorchooser 是**函数内局部导入**（项目风格，
        # 模块级没有这个 import）→ 漏了会在点「选择…」按钮时 NameError。
        from tkinter import colorchooser
        win = tk.Toplevel(self)
        win.withdraw()  # 先隐藏，构建完成后再由 center_window 居中显示（避免左上角闪一下）
        win.title(_("外轮廓描边"))
        try:
            win.transient(self.winfo_toplevel())
            win.grab_set()
            # 禁 -topmost（项目铁律）：置顶会把非置顶的 ToolTip 压到窗体后面 → 提示显示不全。
        except Exception:
            pass

        # 临时变量（仅「确定」时才写回 self.outline_*）
        t_enabled = tk.BooleanVar(value=self.outline_enabled.get())
        _c0 = str(self.outline_color.get() or "#FFFFFF").strip() or "#FFFFFF"
        t_color = tk.StringVar(value=_c0)
        t_width = tk.StringVar(value=str(self.outline_width.get() or "4"))

        main = ttk.Frame(win, padding=10)
        main.pack(fill=tk.BOTH, expand=True)

        chk = ttk.Checkbutton(main, text=_("启用描边（作用于当前子视频）"), variable=t_enabled)
        chk.pack(anchor="w")
        ToolTip(chk,
                _("描边沿子视频当前的透明轮廓向外描边 —— 前置必须有 alpha：\n"
                "抠图（绿幕/色键）结果、外部抠好的带透明素材、或本窗的遮罩。\n"
                "素材本身不透明时，alpha 全 1，描边会退化成「整帧一个矩形框」；\n"
                "那种情况请先把主体抠出来（勾选抠像）再开描边。"),
                wraplength=460)

        row = ttk.Frame(main)
        row.pack(fill=tk.X, pady=(8, 0))
        ttk.Label(row, text=_("颜色:")).pack(side=tk.LEFT)
        swatch = tk.Label(row, text="      ", bg=_c0, relief="solid", bd=1)
        swatch.pack(side=tk.LEFT, padx=(4, 6))

        def _pick_color():
            _c = colorchooser.askcolor(title=_("选择描边颜色"), parent=win,
                                       initialcolor=t_color.get())[1]
            if _c:
                t_color.set(_c)
                swatch.config(bg=_c)

        ttk.Button(row, text=_("选择…"), command=_pick_color, width=6).pack(side=tk.LEFT)
        ttk.Label(row, text=_("宽度 (px):")).pack(side=tk.LEFT, padx=(16, 2))
        ttk.Spinbox(row, from_=1, to=20, textvariable=t_width, width=5).pack(side=tk.LEFT)
        ToolTip(row, _("宽度按最终渲染帧像素算（默认 4）。1~20 之间；超过 20 视觉上已不像描边。"), wraplength=440)

        # 按钮行：确定 col0 / 取消 col1（用户既定约定，勿换序）
        btn_row = ttk.Frame(main)
        btn_row.pack(pady=(12, 2))

        def _do_ok():
            self.outline_enabled.set(t_enabled.get())
            self.outline_color.set(t_color.get())
            try:
                _wv = int(str(t_width.get()).strip() or "4")
            except (ValueError, TypeError):
                _wv = 4
            self.outline_width.set(str(max(1, min(20, _wv))))
            win.destroy()

        ttk.Button(btn_row, text=_("确定"), command=_do_ok, width=8).grid(row=0, column=0, padx=6)
        ttk.Button(btn_row, text=_("取消"), command=win.destroy, width=8).grid(row=0, column=1, padx=6)
        center_window(win, 420, 170)
        win.deiconify()

    def open_mask_dialog(self):
        """遮罩 / 透明蒙版 设置弹窗：启用、方向、矩形坐标（可从裁剪复制）"""
        win = tk.Toplevel(self)
        win.withdraw()  # 先隐藏，构建完成后再由 center_window 居中显示（避免左上角闪一下）
        win.title(_("遮罩 / 透明蒙版"))
        try:
            win.transient(self.winfo_toplevel())
            win.grab_set()
            # 禁 -topmost（项目铁律）：置顶会把非置顶的 ToolTip 压到窗体后面 → 提示显示不全。
            # transient + grab_set 已足够模态，无需置顶。
        except Exception:
            pass

        # 临时变量（仅「保存」时才写回 self.mask_*）
        t_enabled = tk.BooleanVar(value=self.mask_enabled.get())
        t_x = tk.StringVar(value=self.mask_x.get())
        t_y = tk.StringVar(value=self.mask_y.get())
        t_w = tk.StringVar(value=self.mask_w.get())
        t_h = tk.StringVar(value=self.mask_h.get())
        t_mode = tk.StringVar(value=self.mask_mode.get())
        # 2026-10-05：形状下拉（对齐 Shotcut「Mask: Simple Shape」四形状）
        # ⚠️ 数据结构里存**英文键**（写进 app_settings.json / 可导出），下拉里显示中文
        _SHAPE_LABELS = ((_("矩形"), "rect"), (_("圆"), "circle"),
                         (_("三角"), "triangle"), (_("菱形"), "diamond"))

        def _shape_to_ui(_v):
            for _lb, _k in _SHAPE_LABELS:
                if _k == _v:
                    return _lb
            return _("矩形")

        def _shape_from_ui(_v):
            for _lb, _k in _SHAPE_LABELS:
                if _lb == _v:
                    return _k
            return "rect"

        t_shape = tk.StringVar(value=_shape_to_ui(
            (next((s for s in (self.mask_shapes or []) if isinstance(s, dict) and s.get("enabled", True)),
                  {"shape": "rect"})).get("shape", "rect")))
        t_shape_hint = tk.StringVar(value="")
        # 2026-09-10：羽化 + 轨迹（临时变量，仅「保存」时写回 self.mask_*）
        t_feather = tk.StringVar(value=self.mask_feather.get())
        # 2026-10-05：形状旋转角（对齐 Shotcut「Mask: Simple Shape」的 Rotation）。
        # 初值恒 "0"（真实值由后面 _load_form(0) 灌）；这里给 0 是为了 Spinbox 建得起来。
        t_rot = tk.StringVar(value="0")
        t_traj = tk.BooleanVar(value=self.mask_traj_enabled.get())
        t_wps = list(self.mask_waypoints)
        # 2026-09-10：形状图（临时变量，仅「保存」时写回 self.mask_*）
        t_png_enabled = tk.BooleanVar(value=self.mask_png_enabled.get())
        t_png_path = tk.StringVar(value=self.mask_png_path.get())
        t_png_invert = tk.BooleanVar(value=self.mask_png_invert.get())
        _t_pt = str(self.mask_png_type.get() or "bw")
        t_png_type = tk.StringVar(value=_t_pt if _t_pt in ("bw", "alpha") else "bw")
        # ⚠️ LoopChromaFrame 自身没有 app 属性（app 挂在 filt_frame 上），直接 self.app 会
        # AttributeError → 与同窗 _open_mask_visual 一致，统一从 filt_frame 取。
        _app = getattr(self, "app", None)
        if _app is None:
            _ff = getattr(self, "filt_frame", None)
            _app = getattr(_ff, "app", None) if _ff is not None else None
        # 背景帧源（轨迹弹窗 + 下面「起始/结尾坐标」可视化编辑器共用）：本页主视频
        _vf = ""
        _ffm = _fprobe = None
        if _app is not None:
            try:
                # 2026-09-23 修正：本组件也被转换页水印编辑器实例化 → 按 page_scope 取
                # 本页主视频（'merge'=封装页 / 'convert'=转换页 input_file），不跨页兜底。
                _pf, _unused = _page_main_video(_app, self.page_scope)
                _vf = _pf or ""
            except Exception:
                _vf = ""
            _ffm = getattr(_app, "ffmpeg_cmd", None)
            _fprobe = getattr(_app, "ffprobe_cmd", None)
        # ⚠️ 遮罩作用在【子视频】上，不是主视频 → 可视化画布/背景帧一律用子视频的文件与尺寸。
        # 取法同本窗 _open_mask_visual：filt_frame.current_file，拿不到才回落主视频。
        _sub_file = ""
        try:
            _sub_file = getattr(self.filt_frame, "current_file", "") or ""
        except Exception:
            _sub_file = ""
        if (not _sub_file or not os.path.exists(_sub_file)) and _vf:
            _sub_file = _vf
        # 画布尺寸 = 子视频【最终渲染】尺寸（crop→rotate→scale 之后）。
        # ⚠️ 2026-09-10 修正：之前误用原始（未变换）尺寸，导致画布与「实际看到的子视频」不一致；
        #    按规定「尺寸唯一真源 = final_render_size」，遮罩坐标必须落在最终渲染帧上，
        #    与下方「把遮罩滤镜移到 crop/rotate/scale 之后」严格对应（否则坐标空间对不上）。
        #    取法与 app._get_video_render_size(track, filt_frame) 等价（原始尺寸用 current_file，
        #    变换 settings 从 filt_frame 实时读——用户刚改的裁剪/缩放/旋转立即生效，比 track.enc_settings 更准）。
        _cw = _ch = 0
        try:
            _ff = self.filt_frame
            # 节点语境（组父行 / 视频节点）：基准尺寸 = 节点输出尺寸（组 = 包装盒），
            # 但「背景帧 / 右侧预览」走 _node_fx_excl —— 它**只排除 crop/rotate、保留 scale**
            # （见 _node_fx_excl / _make_node_frame_extractor），渲染出的画面是**缩放后**尺寸。
            # ⇒ 这里必须用「包装盒作底 + 只套 scale」得到缩放后尺寸，与渲染帧严格同尺寸，
            # 蓝框比例才对得上（修复：缩放组里遮罩蓝框比显示区域小 / 可视化选区比例错）。
            # ⚠️ node_frame_orig_size 是**未缩放**的包装盒，不能直接当坐标基准（那是旧 bug）。
            _nf_os = getattr(_ff, "node_frame_orig_size", None) if _ff is not None else None
            if _nf_os:
                _bw0, _bh0 = int(_nf_os[0]), int(_nf_os[1])
                _rs_set = {
                    "crop_enabled": False,
                    "scale_enabled": _ff.scale_enabled.get(),
                    "scale_method": _ff.scale_method.get(),
                    "scale_width": _ff.scale_width.get(),
                    "scale_height": _ff.scale_height.get(),
                    "rotate": 0,
                }
                _cw, _ch = _app.compute_final_size_with_order(_bw0, _bh0, _rs_set)
            elif _sub_file and _app is not None and _ff is not None:
                _ow, _oh = _app._cached_video_dimensions(_sub_file)
                if _ow and _oh:
                    _rs_set = {
                        "crop_enabled": _ff.crop_enabled.get(),
                        "crop_width": _ff.crop_width.get(),
                        "crop_height": _ff.crop_height.get(),
                        "crop_left": _ff.crop_left.get(),
                        "crop_top": _ff.crop_top.get(),
                        "scale_enabled": _ff.scale_enabled.get(),
                        "scale_method": _ff.scale_method.get(),
                        "scale_width": _ff.scale_width.get(),
                        "scale_height": _ff.scale_height.get(),
                        "rotate": _ff.rotate.get(),
                    }
                    _cw, _ch = _app.compute_final_size_with_order(
                        int(_ow), int(_oh), _rs_set)
        except Exception:
            _cw = _ch = 0
        try:
            _cw = int(_cw or 0)
            _ch = int(_ch or 0)
        except (ValueError, TypeError):
            _cw = _ch = 0
        if not _cw or not _ch:
            _cw, _ch = MASK_TRAJ_CANVAS_W, MASK_TRAJ_CANVAS_H

        # ---- 左右分栏（2026-10-04 用户要求：遮罩窗口也加右侧预览，学 delogo 窗口）----
        # 结构与 BlurFilterDialog / open_enhance_window **逐字同构**：预览挂 PanedWindow
        # 右 pane，pane 宽由 sash 显式几何决定，与子控件请求尺寸无关 ⇒ 结构上不可能震荡。
        # 绝不能图省事挂成 pack 里的第二块（pack 会按子控件请求尺寸分配，换图即被撑大）。
        _pv_paned = ttk.PanedWindow(win, orient=tk.HORIZONTAL)
        _pv_paned.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        main = ttk.Frame(_pv_paned)          # 左 pane：原表单（布局一行不改）
        _pv_paned.add(main, weight=3)
        # 2026-09-11 重构：delogo 式「上列表 + 下参数」单弹窗（原独立多形状弹窗已删）。
        # 时段(秒)：止<=0 或留空 = 全程常显；勾「轨迹」后由航点接管（时段两框置灰）。
        t_t0 = tk.StringVar(value="0")
        t_t1 = tk.StringVar(value="0")
        t_ptype_hint = tk.StringVar(value="")

        # ---------- 工具 / 状态 ----------
        _to_f = _opt_float  # 宽容转 float，失败回 default（2026-09-22 抽公共）

        def _fmt_t(v):
            try:
                f = float(v)
            except (ValueError, TypeError):
                return "?"
            return ("%g" % f)

        def _type_str(it):
            return _("外部") if str(it.get("png_path", "") or "").strip() else _("矩形")

        def _dir_str(it):
            return _("透明") if str(it.get("mode", "outside")) == "inside" else _("只露")

        def _summary(it):
            _w = int(round(_to_f(it.get("w", 0), 0.0)))
            _h = int(round(_to_f(it.get("h", 0), 0.0)))
            _p = str(it.get("png_path", "") or "").strip()
            if _p:
                _base = "%s %dx%d" % (os.path.basename(_p)[:18], _w, _h)
            else:
                _base = "%dx%d@(%s,%s)" % (_w, _h, _fmt_t(it.get("x", 0)), _fmt_t(it.get("y", 0)))
            if it.get("traj_enabled"):
                _n = len([w for w in (it.get("waypoints") or []) if isinstance(w, dict)])
                _tail = _("[轨迹 %d 点]") % _n
            else:
                _t1 = _to_f(it.get("t_end", 0), 0.0)
                _t0 = _to_f(it.get("t_start", 0), 0.0)
                _tail = _("[全程]") if _t1 <= 0 else "[%s~%ss]" % (_fmt_t(_t0), _fmt_t(_t1))
            # 旋转只在 rot≠0 时显示（0° 就是默认朝向，列表里不必添噪音）
            _r = _to_f(it.get("rot", 0), 0.0)
            if _r:
                _tail += " ↻%g°" % _r
            return _base + " " + _tail

        items = []                  # 源形状列表（下方初始化处再灌）
        bitems = []                 # 2026-10-11：布尔结果列表（源形状的 并/交/差 合并）
        _loading = {"v": False}     # _load_form 期间抑制 trace，防止旧形状值串到新形状
        _last_sel = {"v": None}     # 回环保卫：刷新回声不改表单
        _last_bool_sel = {"v": None}
        _edit_on = {"v": True}      # 无形状时整片编辑区置灰
        # 当前焦点表：shape = 源形状列表 / bool = 布尔结果列表。
        # 聚焦布尔表时，编辑区只有「编辑航点…」「🎯 可视化选区…」有效（其余置灰）——
        # 那些都是源形状属性（mode/羽化/旋转/形状/外部图/时段），对合并结果无意义。
        _active = {"v": "shape"}

        _sel_idx = lambda: selected_tree_index(tree)
        _bidx = lambda: selected_tree_index(btree)

        def _cur_entry():
            """当前焦点目标 → (索引, 条目的真身 dict)；无有效目标 → (None, None)。

            ⚠️ 返回的是**列表里的那个 dict**（非副本），调用方改动即落回数据。
            """
            if _active["v"] == "bool":
                _i = _bidx()
                if _i is not None and 0 <= _i < len(bitems):
                    return _i, bitems[_i]
                return None, None
            _i = _sel_idx()
            if _i is not None and 0 <= _i < len(items):
                return _i, items[_i]
            return None, None

        # ---- 布尔结果（2026-10-11）：多选源形状 → 并/交/差 合并成 1 个「标签」条目 ----
        # 研究见 research/mask-boolean-labels/README.md §7；渲染见 _build_mask_multi_shape_filters。
        _BOOL_OPS = ((_("并集"), "union"), (_("交集"), "intersect"), (_("相减"), "subtract"))

        def _op_to_ui(_v):
            for _lb, _k in _BOOL_OPS:
                if _k == _v:
                    return _lb
            return _("并集")

        def _op_from_ui(_v):
            for _lb, _k in _BOOL_OPS:
                if _lb == _v:
                    return _k
            return "union"

        def _tree_sel_idxs():
            """源列表多选索引（按行序上→下；相减的 minuend 即第一个）。"""
            _out = []
            for _iid in tree.selection():
                try:
                    _out.append(int(_iid))
                except (ValueError, TypeError):
                    continue
            return sorted(_out)

        def _bool_bbox(_refs):
            """源索引集合 → 合并结果的落位盒 (x, y, w, h)（各源渲染盒的并集）。"""
            return mask_bool_merge_box(items, _refs)

        def _op_str(_b):
            return _op_to_ui(str(_b.get("bool_op", "union")))

        def _bsummary(_b):
            _n = len([r for r in (_b.get("bool_src") or [])])
            if _b.get("traj_enabled"):
                _k = len([w for w in (_b.get("waypoints") or []) if isinstance(w, dict)])
                _tail = _("[轨迹 %d 点]") % _k
            else:
                _t1 = _to_f(_b.get("t_end", 0), 0.0)
                _tail = _("[全程]") if _t1 <= 0 else "[%s~%ss]" % (_fmt_t(_b.get("t_start", 0)),
                                                              _fmt_t(_t1))
            _pos = _("落位(%s,%s) %dx%d") % (_fmt_t(_b.get("x", 0)), _fmt_t(_b.get("y", 0)),
                                          int(round(_to_f(_b.get("w", 0), 0.0))),
                                          int(round(_to_f(_b.get("h", 0), 0.0))))
            return _("%d 个源 %s %s") % (_n, _pos, _tail)

        def _update_brow(idx):
            _iid = str(idx)
            if btree.exists(_iid) and 0 <= idx < len(bitems):
                _b = bitems[idx]
                btree.item(_iid, values=("✓" if _b.get("enabled", True) else "—",
                                         _op_str(_b), _bsummary(_b)))

        def _brefresh():
            _sel = _bidx()
            btree.delete(*btree.get_children())
            for _i, _b in enumerate(bitems):
                btree.insert("", "end", iid=str(_i),
                             values=("✓" if _b.get("enabled", True) else "—",
                                     _op_str(_b), _bsummary(_b)))
            if _sel is not None and 0 <= _sel < len(bitems):
                btree.selection_set(str(_sel))
            _ov_redraw()

        def _load_bool_form(idx):
            """把布尔条目灌进表单（表单在布尔态只显示、不可编辑；只有轨迹相关可改）。"""
            if idx is None or not (0 <= idx < len(bitems)):
                return
            _b = bitems[idx]
            _loading["v"] = True
            try:
                _tk_setv(t_x, _fmt_t(_b.get("x", 0)))
                _tk_setv(t_y, _fmt_t(_b.get("y", 0)))
                _tk_setv(t_w, _fmt_t(_b.get("w", 100)))
                _tk_setv(t_h, _fmt_t(_b.get("h", 100)))
                _tk_setv(t_rot, "0")
                _tk_setv(t_feather, _fmt_t(_b.get("feather", 0)))
                _tk_setv(t_t0, _fmt_t(_b.get("t_start", 0)))
                _tk_setv(t_t1, _fmt_t(_b.get("t_end", 0)))
                _tk_setv(t_traj, bool(_b.get("traj_enabled", False)))
            finally:
                _loading["v"] = False
            try:
                _n = len([w for w in (_b.get("waypoints") or []) if isinstance(w, dict)])
                _wp_lbl.configure(text=(_("（%d 个航点）") % _n))
            except Exception:
                pass
            _sync_state()

        def _bool_apply(*_a):
            """布尔态下把表单里的轨迹/时段写回布尔条目（编辑区其余控件已置灰）。"""
            if _loading["v"] or _active["v"] != "bool":
                return
            _i = _bidx()
            if _i is None or not (0 <= _i < len(bitems)):
                return
            _b = bitems[_i]
            _b["traj_enabled"] = bool(t_traj.get())
            _b["t_start"] = _to_f(t_t0.get(), 0.0)
            _b["t_end"] = _to_f(t_t1.get(), 0.0)
            _update_brow(_i)

        def _remap_bool_refs(_fn):
            """源列表增删/重排后同步修正布尔条目的源引用（返回 None = 丢弃该引用）。"""
            for _b in bitems:
                _rs = _b.get("bool_src")
                if not isinstance(_rs, list):
                    continue
                _new = []
                for _r in _rs:
                    try:
                        _ri = int(_r)
                    except (TypeError, ValueError):
                        continue
                    _nr = _fn(_ri)
                    if _nr is not None:
                        _new.append(_nr)
                _b["bool_src"] = _new

        def _make_bool():
            """上方源列表的**多选** → 按当前 op 合成 1 个布尔结果，追加到下方列表。"""
            _idxs = _tree_sel_idxs()
            if len(_idxs) < 2:
                alert_if(True, _("提示"),
                         _("请在上方形状列表里选中至少 2 个形状（按住 Ctrl / Shift 多选），再点合成。"),
                         'info', parent=win)
                return
            _op = _op_from_ui(t_bool_op.get())
            _bb = _bool_bbox(_idxs)
            if _bb is None:
                return
            bitems.append({
                "enabled": True, "bool_op": _op, "bool_src": [int(i) for i in _idxs],
                "x": round(_bb[0], 2), "y": round(_bb[1], 2),
                "w": round(_bb[2], 2), "h": round(_bb[3], 2),
                "feather": 0.0, "t_start": 0.0, "t_end": 0.0,
                "traj_enabled": False, "waypoints": []})
            _brefresh()
            _n = len(bitems) - 1
            _active["v"] = "bool"
            _last_bool_sel["v"] = _n
            _edit_on["v"] = True
            btree.selection_set(str(_n))
            _load_bool_form(_n)
            _sync_state()
            _ov_redraw()

        def _bdel():
            _i = _bidx()
            if _i is None:
                return
            del bitems[_i]
            _brefresh()
            if bitems:
                _active["v"] = "bool"
                _last_bool_sel["v"] = 0
                _edit_on["v"] = True
                btree.selection_set("0")
                _load_bool_form(0)
            else:
                _active["v"] = "shape"
                _last_bool_sel["v"] = None
                _last_sel["v"] = None
                if items:
                    _edit_on["v"] = True
                    tree.selection_set("0")
                    _last_sel["v"] = 0
                    _load_form(0)
                else:
                    _edit_on["v"] = False
                    _clear_form()
            _sync_state()
            _ov_redraw()
        # 前向持有右侧预览组件：轮廓重绘回调定义早于 _mask_pv 创建（拼接对齐虚线，研究见
        # research/mask-boolean-labels/README.md §10）。创建后把 _mask_pv 塞进来即可生效。
        _pv_ref = {"pv": None}

        def _ov_redraw(*_a):
            """刷新右侧预览的「形状轮廓虚线」叠加层（预览未创建 / 未启用时静默跳过）。"""
            _pv = _pv_ref.get("pv")
            if _pv is not None:
                with suppress(Exception):
                    _pv.refresh_overlay()

        def _refresh():
            _sel = _sel_idx()
            tree.delete(*tree.get_children())
            for _i, _it in enumerate(items):
                tree.insert("", "end", iid=str(_i),
                            values=("✓" if _it.get("enabled", True) else "—",
                                    _type_str(_it), _dir_str(_it), _summary(_it)))
            if _sel is not None and 0 <= _sel < len(items):
                tree.selection_set(str(_sel))
            _brefresh()   # 源列表变化（增删/重排/改名）→ 布尔列表摘要一起刷新

        def _update_row(idx):
            _iid = str(idx)
            if tree.exists(_iid) and 0 <= idx < len(items):
                _it = items[idx]
                tree.item(_iid, values=("✓" if _it.get("enabled", True) else "—",
                                        _type_str(_it), _dir_str(_it), _summary(_it)))
            _ov_redraw()

        def _collect_form(idx):
            if idx is None or not (0 <= idx < len(items)):
                return
            _it = items[idx]
            _m = str(t_mode.get() or "outside")
            _it["mode"] = _m if _m in ("outside", "inside") else "outside"
            # 形状：下拉里的中文 → 存英文键（png_path 有值时滤镜侧仍以外部图优先）
            _it["shape"] = _shape_from_ui(t_shape.get())
            _it["x"] = _to_f(t_x.get(), 0.0)
            _it["y"] = _to_f(t_y.get(), 0.0)
            _it["w"] = _to_f(t_w.get(), 0.0)
            _it["h"] = _to_f(t_h.get(), 0.0)
            _it["feather"] = _to_f(t_feather.get(), 0.0)
            # 旋转角（度）：绕形状层包围盒中心；0=与「坐标」框选同朝向
            _it["rot"] = _to_f(t_rot.get(), 0.0)
            _it["t_start"] = _to_f(t_t0.get(), 0.0)
            _it["t_end"] = _to_f(t_t1.get(), 0.0)
            _it["png_path"] = t_png_path.get().strip()
            _pt = str(t_png_type.get() or "bw")
            _it["png_type"] = _pt if _pt in ("bw", "alpha") else "bw"
            _it["png_invert"] = bool(t_png_invert.get())
            _it["traj_enabled"] = bool(t_traj.get())
            _it["type"] = "png" if _it["png_path"] else "rect"

        def _load_form(idx):
            if idx is None or not (0 <= idx < len(items)):
                return
            _it = items[idx]
            _loading["v"] = True
            try:
                _tk_setv(t_mode, str(_it.get("mode", "outside")))
                _tk_setv(t_shape, _shape_to_ui(_it.get("shape", "rect")))
                # 外部形状图有值时提示一下（滤镜侧以图为准，下拉此刻不生效）
                t_shape_hint.set(_("（外部图优先，下拉暂不生效）")
                                 if str(_it.get("png_path", "") or "").strip() else "")
                _tk_setv(t_x, _fmt_t(_it.get("x", 0)))
                _tk_setv(t_y, _fmt_t(_it.get("y", 0)))
                _tk_setv(t_w, _fmt_t(_it.get("w", 100)))
                _tk_setv(t_h, _fmt_t(_it.get("h", 100)))
                _tk_setv(t_feather, _fmt_t(_it.get("feather", 0)))
                _tk_setv(t_rot, _fmt_t(_it.get("rot", 0)))
                _tk_setv(t_t0, _fmt_t(_it.get("t_start", 0)))
                _tk_setv(t_t1, _fmt_t(_it.get("t_end", 0)))
                _tk_setv(t_png_path, str(_it.get("png_path", "") or ""))
                _tk_setv(t_png_type, str(_it.get("png_type", "bw")))
                _tk_setv(t_png_invert, bool(_it.get("png_invert", False)))
                _tk_setv(t_traj, bool(_it.get("traj_enabled", False)))
                if not str(_it.get("png_path", "") or "").strip():
                    _tk_setv(t_ptype_hint, "")
            finally:
                _loading["v"] = False
            try:
                _n = len([w for w in (_it.get("waypoints") or []) if isinstance(w, dict)])
                _wp_lbl.configure(text=(_("（%d 个航点）") % _n))
            except Exception:
                pass
            _sync_state()

        def _clear_form():
            _loading["v"] = True
            try:
                _tk_setv(t_mode, "outside")
                _tk_setv(t_shape, _("矩形"))
                t_shape_hint.set("")
                _tk_setv(t_x, "0"); _tk_setv(t_y, "0")
                _tk_setv(t_w, "100"); _tk_setv(t_h, "100")
                _tk_setv(t_feather, "0")
                _tk_setv(t_rot, "0")
                _tk_setv(t_t0, "0"); _tk_setv(t_t1, "0")
                _tk_setv(t_png_path, "")
                _tk_setv(t_png_type, "bw")
                _tk_setv(t_png_invert, False)
                _tk_setv(t_traj, False)
                _tk_setv(t_ptype_hint, "")
            finally:
                _loading["v"] = False

        def _apply_now(*_):
            # ttk.Entry/Combobox 无 command= → 用 textvariable write trace 触达回写
            if _loading["v"]:
                return
            # 聚焦布尔结果时表单不编辑源形状（表单可能正显示布尔条目的落位/时段，
            # 若回写会把布尔的值串进源形状）→ 由 _bool_apply 单独处理布尔字段。
            if _active["v"] == "bool":
                return
            _idx = _sel_idx()
            if _idx is None:
                return
            _collect_form(_idx)
            _update_row(_idx)   # 只改该行显示：不刷新整表、不改选中 → 无回声、不冲光标

        def _sync_state():
            _on = _edit_on["v"]
            for _w in _edit_widgets:
                with suppress(Exception):
                    _w.configure(state=("normal" if _on else "disabled"))
            _is_bool = (_active["v"] == "bool")
            if _on and _is_bool:
                # 聚焦布尔结果时：只有「轨迹（沿轨迹移动）」「编辑航点…」「🎯 可视化选区…」
                # 与「时段」有效，其余置灰。
                # ⚠️ 2026-10-11 用户报障：布尔行**轨迹勾选**此前也被置灰 → 每次开关都得点进航点，
                #    或去列表左边点「启用」列。布尔结果就是一条普通形状（自带 traj_enabled +
                #    t_start/t_end），这两组控件对它**本就有意义**（渲染走同一 _mask_shape_pos_expr：
                #    勾轨迹=航点接管可见性；不勾=时段窗口，止<=0 全程常显）→ 一并放行。
                #    其余（mode/羽化/旋转/形状下拉/外部图）才是**源形状**属性，对合并结果无意义。
                _bool_ok = (_chk_traj, e_t0, e_t1, _btn_traj, _btn_vis)
                try:
                    for _w in _edit_widgets:
                        if _w in _bool_ok:
                            continue
                        with suppress(Exception):
                            _w.configure(state="disabled")
                except NameError:
                    pass
            if _on and t_traj.get():
                for _w in (e_t0, e_t1):
                    with suppress(Exception):
                        _w.configure(state="disabled")
                with suppress(Exception):
                    _btn_seg_prev.configure(state="disabled")
            with suppress(Exception):
                if not _on:
                    _time_hint.configure(text=_("秒（未选中形状）"))
                elif _is_bool:
                    _time_hint.configure(text=_("秒（布尔结果自身的显示时段；勾轨迹则由航点接管可见性）"))
                elif t_traj.get():
                    _time_hint.configure(text=_("秒（已由轨迹接管，此处被忽略）"))
                else:
                    _time_hint.configure(text=_("秒（止=0 或留空 = 全程常显）"))

        def _on_traj_change(*_):
            _sync_state()
            _apply_now()

        def _on_tree_select(ev=None):
            _idx = _sel_idx()
            if _idx is None:
                return
            _was_bool = (_active["v"] == "bool")
            if _idx == _last_sel["v"] and not _was_bool:
                return   # 刷新回声（同一行）：表单本就是这行数据，不回读
            if not _was_bool:
                # ⚠️ 从布尔态切回来时**不能** _collect_form：表单此刻装的是布尔条目的值，
                #    回写会把布尔的落位/时段串进源形状。
                _prev = _last_sel["v"]
                if _prev is not None and 0 <= _prev < len(items):
                    _collect_form(_prev)
                    _update_row(_prev)
            _active["v"] = "shape"
            _last_bool_sel["v"] = None
            with suppress(Exception):
                btree.selection_remove(*btree.selection())
            _last_sel["v"] = _idx
            _edit_on["v"] = True
            _load_form(_idx)
            _ov_redraw()   # 选中行 → 高亮该行轮廓（其余虚线）

        def _on_btree_select(ev=None):
            """聚焦布尔结果列表：表单按布尔条目回显、编辑区只留轨迹/可视化两处。"""
            _bi = _bidx()
            if _bi is None:
                return
            if _active["v"] == "bool" and _bi == _last_bool_sel["v"]:
                return
            if _active["v"] == "shape":
                # 切换前先把源形状表单落盘（否则正在编辑的形状改动会丢）
                _si = _sel_idx()
                if _si is not None and 0 <= _si < len(items):
                    _collect_form(_si)
                    _update_row(_si)
            _active["v"] = "bool"
            _last_bool_sel["v"] = _bi
            _edit_on["v"] = True
            _load_bool_form(_bi)
            _ov_redraw()

        def _on_btree_click(ev):
            with suppress(Exception):
                if btree.identify_column(ev.x) == "#1":
                    _iid = btree.identify_row(ev.y)
                    if _iid:
                        _i = int(_iid)
                        if 0 <= _i < len(bitems):
                            bitems[_i]["enabled"] = not bitems[_i].get("enabled", True)
                            _update_brow(_i)
                            btree.selection_set(_iid)

        def _on_tree_click(ev):
            with suppress(Exception):
                if tree.identify_column(ev.x) == "#1":
                    _iid = tree.identify_row(ev.y)
                    if _iid:
                        _i = int(_iid)
                        if 0 <= _i < len(items):
                            items[_i]["enabled"] = not items[_i].get("enabled", True)
                            _update_row(_i)
                            tree.selection_set(_iid)

        def _add():
            _idx = _sel_idx()
            if _idx is not None:
                _collect_form(_idx)
            items.append({
                "enabled": True, "mode": "outside", "shape": "rect",
                "x": 0.0, "y": 0.0,
                "w": 100.0, "h": 100.0, "feather": 0.0,
                # 旋转角（度）：0 = 与「坐标」框选同朝向；⚠️ 与 rot 有关的五处联动见
                # _collect_form / _load_form / _clear_form / _do_save 白名单 / 下方 setdefault
                "rot": 0.0,
                "t_start": 0.0, "t_end": 0.0, "png_path": "",
                "png_type": "bw", "png_invert": False,
                "traj_enabled": False, "waypoints": []})
            _refresh()
            _n = len(items) - 1
            _last_sel["v"] = _n
            _edit_on["v"] = True
            tree.selection_set(str(_n))
            _load_form(_n)

        def _del():
            _idx = _sel_idx()
            if _idx is None:
                return
            # 删除源形状：焦点切回源表（布尔选中让位），并同步修正布尔源引用
            _active["v"] = "shape"
            _last_bool_sel["v"] = None
            with suppress(Exception):
                btree.selection_remove(*btree.selection())
            del items[_idx]
            _remap_bool_refs(lambda _r: None if _r == _idx else (_r - 1 if _r > _idx else _r))
            _last_sel["v"] = None
            _refresh()
            if items:
                _last_sel["v"] = 0
                _edit_on["v"] = True
                tree.selection_set("0")
                _load_form(0)
            else:
                _edit_on["v"] = False
                _clear_form()
                _sync_state()

        def _move(d):
            _idx = _sel_idx()
            if _idx is None:
                return
            if _active["v"] != "bool":
                _collect_form(_idx)
            _j = _idx + d
            if not (0 <= _j < len(items)):
                return
            # 源列表重排：焦点回到源表；布尔源引用同步对调（否则引用会指向错行）
            _active["v"] = "shape"
            _last_bool_sel["v"] = None
            with suppress(Exception):
                btree.selection_remove(*btree.selection())
            items[_idx], items[_j] = items[_j], items[_idx]
            _remap_bool_refs(lambda _r: _j if _r == _idx else (_idx if _r == _j else _r))
            _last_sel["v"] = _j
            _refresh()
            tree.selection_set(str(_j))
            _load_form(_j)

        def _migrate_row():
            """首开（列表为空）时从旧单形状字段搬 1 行，老存档不破。"""
            _png = (str(self.mask_png_path.get() or "").strip()
                    if self.mask_png_enabled.get() else "")
            _md = str(self.mask_mode.get() or "outside")
            return {
                "enabled": True,
                "mode": _md if _md in ("outside", "inside") else "outside",
                "x": _to_f(self.mask_x.get(), 0.0),
                "y": _to_f(self.mask_y.get(), 0.0),
                "w": _to_f(self.mask_w.get(), 100.0),
                "h": _to_f(self.mask_h.get(), 100.0),
                "feather": _to_f(self.mask_feather.get(), 0.0),
                "t_start": 0.0, "t_end": 0.0,
                "png_path": _png,
                "png_type": (self.mask_png_type.get()
                             if self.mask_png_type.get() in ("bw", "alpha") else "bw"),
                "png_invert": bool(self.mask_png_invert.get()),
                "traj_enabled": bool(self.mask_traj_enabled.get()),
                "waypoints": [dict(w) for w in (self.mask_waypoints or [])
                              if isinstance(w, dict)],
            }

        # ---------- 背景帧预处理 / 可视化选区 ----------
        # ⛔ 这里**故意不含 scale**：可视化编辑器走 `_extract_frame_scaled(
        # target_width=画布宽, target_height=画布高)` 自己缩到画布；这里再塞
        # scale 会双重缩放。右侧预览另用 `_mask_pv_pre_filter()`（含 scale）。
        def _mask_bg_pre_filter():
            """可视化编辑器 + 遮罩坐标基准共用的预处理（crop→rotate→flip，**不含 scale**）。

            ⛔ 这里的 scale 是**故意缺的**：可视化编辑器走 `_extract_frame_scaled(
            target_width=画布宽, target_height=画布高)`，由它负责把背景缩到画布；
            这里再塞一个 scale 就会双重缩放 → 编辑器里画面与坐标对不上。
            右侧实时预览不走那条路（自己发命令），所以另用 `_mask_pv_pre_filter()`。
            """
            _ff = self.filt_frame
            if _ff is None:
                return None
            try:
                return _main_bg_pre_filter({
                    "crop_enabled": _ff.crop_enabled.get(),
                    "crop_width": _ff.crop_width.get(),
                    "crop_left": _ff.crop_left.get(),
                    "crop_top": _ff.crop_top.get(),
                    "crop_height": _ff.crop_height.get(),
                    "rotate": _ff.rotate.get() if hasattr(_ff, "rotate") else "none",
                    "vflip": _ff.vflip.get() if hasattr(_ff, "vflip") else False,
                    "hflip": _ff.hflip.get() if hasattr(_ff, "hflip") else False,
                })
            except Exception:
                return None

        def _mask_pv_pre_filter():
            """右侧实时预览专用预处理 = crop→rotate→flip→**scale**。

            遮罩坐标基准 = 子视频**最终渲染帧**（`_build_mask_filter_block` 注释钉死：
            crop → rotate → scale 之后），而 `_cw/_ch` 由 `compute_final_size_with_order`
            按同一顺序算出（含 scale）。预览若只补 crop/rotate（`_mask_bg_pre_filter` 的
            口径），子视频开了缩放时画的是**缩放前**的原始帧，矩形坐标却按缩放后算 ——
            表现为「矩形位置/大小和可视化编辑器里摆的不一致」。

            ⛔ 不能把 scale 加进 `_mask_bg_pre_filter`（它有 3 个消费点，其中可视化编辑器
            自己会缩放到画布）—— 那样会双重缩放。

            scale 段**逐字照抄导出链 `build_video_filter_chain` 的 scale_enabled 分支**
            （width→`scale=W:-2`、height→`scale=-2:H`、exact→`scale=W:H`），不另造写法。
            """
            _base = _mask_bg_pre_filter()
            _ff = self.filt_frame
            if _ff is None:
                return _base
            try:
                if not _ff.scale_enabled.get():
                    return _base
                _method = _ff.scale_method.get()
                _sw = str(_ff.scale_width.get() or "").strip()
                _sh = str(_ff.scale_height.get() or "").strip()
                _seg = None
                if _method == "width" and _sw:
                    _seg = f"scale={_sw}:-2"
                elif _method == "height" and _sh:
                    _seg = f"scale=-2:{_sh}"
                elif _method == "exact" and _sw and _sh:
                    _seg = f"scale={_sw}:{_sh}"
                if not _seg:
                    return _base
                return f"{_base},{_seg}" if _base else _seg
            except Exception:
                return _base


        def _open_mask_visual():
            _ff = self.filt_frame
            app = getattr(_ff, "app", None)  # LoopChromaFrame 自身无 app，必须从 filt_frame 取
            file_path = getattr(_ff, "current_file", "") or ""
            if not file_path or not os.path.exists(file_path):
                # 2026-09-23：按 page_scope 回落本页主视频（不拿另一页的 input_file）
                if app is not None:
                    _pf, _unused = _page_main_video(app, self.page_scope)
                    file_path = _pf or ""
            if alert_if(not file_path or not os.path.exists(file_path), _("提示"), _("请先选择子视频文件（水印/画中画）")):
                return
            if app is None or app.root is None:
                return
            with suppress(Exception):
                win.grab_release()
            with suppress(Exception):
                win.attributes("-topmost", False)
            _is_bool = (_active["v"] == "bool")
            _tgt_i, _tgt_e = _cur_entry()
            _bw = max(10.0, _to_f(t_w.get(), 10.0))
            _bh = max(10.0, _to_f(t_h.get(), 10.0))
            _vx = tk.StringVar(value=str(int(round(_to_f(t_x.get(), 0.0)))))
            _vy = tk.StringVar(value=str(int(round(_to_f(t_y.get(), 0.0)))))

            def _vis_on_apply(nx, ny, nw, nh, ncw, nch):
                # 布尔结果：只反映**落位平移**（用户拍板：缩放开销大就不开放 → 回上方改源图形尺寸）。
                # 结果内部排布由源图形决定，这里只挪整体锚点。
                if _is_bool:
                    if _tgt_e is not None:
                        with suppress(Exception):
                            _tgt_e["x"] = float(nx)
                            _tgt_e["y"] = float(ny)
                        _update_brow(_tgt_i)
                    return
                try:
                    t_x.set(str(int(round(float(nx)))))
                    t_y.set(str(int(round(float(ny)))))
                    if nw and nh:
                        t_w.set(str(int(round(float(nw)))))
                        t_h.set(str(int(round(float(nh)))))
                except Exception:
                    pass

            # 拼接对齐：把「各形状精确轮廓虚线」也叠进可视化选区画布（高亮当前选中行）。
            # 复用 open_watermark_overlay_editor 的 bg_shape_outlines 开关（传一个参数即开启）。
            _vsi = None if _is_bool else _sel_idx()
            if not (_vsi is not None and 0 <= _vsi < len(items)):
                _vsi = None
            if _is_bool and _tgt_e is not None:
                # 布尔结果：高亮它引用的源行集合（与轮廓钩子 §10.5 点 5 完全一致）
                _vhl = set()
                for _r in (_tgt_e.get("bool_src") or []):
                    try:
                        _vhl.add(int(_r))
                    except (TypeError, ValueError):
                        continue
            else:
                _vhl = {_vsi} if _vsi is not None else set()

            def _vis_live_outline(ov_canvas, _sx, _sy, _live):
                """拖拽 / 微调 / 坐标框 / 旋转滑块每次改几何 → 按**实时几何**重画各形状轮廓。

                （2026-10-11 用户报障：编辑器里红色框是「正的（未旋转）」，旋转只体现在
                蓝色虚线上，且拖拽时那条虚线**不跟随** → 拼图形必须多次保存出去观察。
                这里让轮廓跟着实时几何重画，所见即所得。）

                ⛔ 只画不改：绝不写回 items / 表单。
                ⛔ 只对**源形状**生效：布尔结果没有 per-shape rot、可见性由源图形决定，
                   红框（落位盒）已足够 → 直接返回（保留 bg_draw_func 初次绘制的结果）。
                """
                if _vsi is None:
                    return
                try:
                    _lx, _ly, _lw, _lh, _lrot = _live
                except (TypeError, ValueError):
                    return
                _lst = list(items)
                if not (0 <= _vsi < len(_lst)):
                    return
                _v2 = dict(_lst[_vsi])
                _v2["x"], _v2["y"], _v2["w"], _v2["h"], _v2["rot"] = _lx, _ly, _lw, _lh, _lrot
                # ⚠️ 刻意**不**强制 enabled=True：`draw_mask_shape_outlines` 会跳过停用行，
                #    与初次 bg_draw_func 的画法保持一致（停用行本来就不该出现轮廓）。
                _lst[_vsi] = _v2
                draw_mask_shape_outlines(ov_canvas, _lst, set(_vhl),
                                         lambda px, py: (px * _sx, py * _sy),
                                         tag="mask_outline")

            # 右栏「旋转」滑块（仅**源形状**；布尔结果无 rot 语义 → 不传）。
            # 语义 = 遮罩 shape rot（R(−θ) 逆时针），**刻意不复用**编辑器旋转手柄（R(+θ) 正转）。
            _rot_slider_arg = None
            if _vsi is not None:
                _rv = tk.DoubleVar(value=round(_to_f(t_rot.get(), 0.0), 1))

                def _rot_slider_cb(_val):
                    # 写回表单 t_rot（唯一真源）：既有 trace 链会接着写回 items[_vsi]、
                    # 刷新列表摘要（↻N°）与右侧预览轮廓 —— 不另造数据通路。
                    with suppress(Exception):
                        t_rot.set("%g" % round(float(_val) % 360.0, 1))

                _rot_slider_arg = {
                    "var": _rv, "cb": _rot_slider_cb,
                    "tip": _("遮罩形状的旋转角（0~360°，逆时针，绕形状中心）。\n"
                           "· 只改**本形状**的旋转，不影响编辑器自身的角度通道；\n"
                           "· 拖动时画布上的轮廓虚线实时跟随（无需保存出去观察）。"),
                }
            app.open_watermark_overlay_editor(
                _cw, _ch, _bw, _bh, _vx, _vy,
                scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
                watermark_dict=None, filt_frame=None, parent=self, free_layout=False,
                main_video_file=file_path,
                bg_pre_filter=_mask_bg_pre_filter(),
                on_apply=_vis_on_apply,
                initial_time=0.0,
                aspect_ratio=None,   # 遮罩挡板宽高独立：自由绘制矩形
                # ⚠️ 遮罩不支持角度（钉死防误改）：遮罩链只消费 x/y，转动手柄所见非所得。
                #    遮罩的形状旋转走**右栏独立滑块**（rot_slider，写 shape rot），不复活手柄。
                angle_editable=False,
                # 2026-09-22：画布=子视频缩放后尺寸，显示层允许放大适配窗口。
                allow_upscale=True,
                # ⚠️ 节点语境：遮罩背景帧走「节点时间轴取帧器」（=节点输出画面，含像素类效果、
                # 排除几何效果）；非节点语境 node_frame_extractor 为 None → 旧行为（主视频 bg_file）。
                frame_extractor=getattr(self.filt_frame, "node_frame_extractor", None),
                # 2026-10-09：右侧「坐标（回车生效）」四格 + 「边缘/平移微调」三行 ——
                # 遮罩挡板此前只能拖，像素级对准全靠手感；与画布双向同步（拖/微调→回填，
                # 回车→挪框）。四格带「复制 / 粘贴」（剪贴板与裁剪窗口共用）。
                # ⚠️ 三行微调**只有遮罩要**（它有「区域」语义，需要逐边推拉）；
                #    其余位置编辑器只开 coord_box。
                coord_box=True,
                nudge_rows=True,
                # 2026-10-11：可复用开关（传 (形状列表, 高亮索引集) 即开启轮廓虚线；其余页面可同样复用）
                bg_shape_outlines=(list(items), _vhl),
                # 2026-10-11：轮廓「实时跟随」（拖拽/微调/旋转中重画）+ 右栏旋转滑块（仅源形状）
                bg_shape_outlines_live=_vis_live_outline,
                rot_slider=_rot_slider_arg,
            )

        # ---------- 轨迹（起始/结尾坐标）回调 ----------
        def _mask_edit_cb(row_idx, which, cur_x, cur_y, cur_angle,
                          apply_xy, apply_angle, t0=0.0,
                          active_flag=None, w=None):
            """「起始坐标… / 结尾坐标…」入口：可视化摆放挡板在该航点起点/终点的位置。

            ⚠️ 必须传这个回调——_trajectory_dialog 里 edit_cb is None 时那两个按钮永久置灰。
            """
            if _app is None:
                apply_xy(cur_x, cur_y)
                return
            _bw = max(10.0, min(float(_cw), _to_f(t_w.get(), 0.0) or 10.0))
            _bh = max(10.0, min(float(_ch), _to_f(t_h.get(), 0.0) or 10.0))
            vx = tk.StringVar(value=f"{int(round(cur_x or 0)):d}")
            vy = tk.StringVar(value=f"{int(round(cur_y or 0)):d}")

            def _on_apply(nx, ny, nw, nh, ncw, nch):
                vx.set(str(int(round(nx))))
                vy.set(str(int(round(ny))))
                with suppress(Exception):
                    if nw and nh:
                        t_w.set(str(int(round(float(nw)))))
                        t_h.set(str(int(round(float(nh)))))

            # 起始/结尾双端（条件调用）：仅当调用方传入 w + active_flag 时启用
            # （active_flag 由 _open_editor 的 _active 可变列表提供，翻转即切写回目标端）
            start_end = None
            if w is not None and active_flag is not None:
                _se_can = (w.get("mode") != "end")   # 2026-09-12 修复：按数据模型判定——坐标相等(如粘贴连通)≠无第二端；仅终点行(mode=end)无独立结尾
                def _se_read(end):
                    if end == "end":
                        return (w.get("xb", 0), w.get("yb", 0), _bw, _bh, w.get("rb", 0))
                    return (w.get("xa", 0), w.get("ya", 0), _bw, _bh, w.get("ra", 0))
                def _se_switch(end):
                    active_flag[0] = end
                def _se_time(end):
                    # 2026-10-05：两端各取各的时刻 —— 起点端=start，结尾端=start+dur。
                    # 位置编辑器据此换背景帧/内容帧，否则两端画面一模一样，看不出这一段的运动。
                    _st = _opt_float(w.get("start", 0.0) or 0.0, 0.0)
                    if end == "end":
                        return _st + _opt_float(w.get("dur", 0.0) or 0.0, 0.0)
                    return _st
                start_end = {"active": ("end" if active_flag[0] == "end" else "start"),
                             "read": _se_read, "on_switch": _se_switch, "can_compare": _se_can,
                             "time": _se_time}
            # 🔴 2026-10-16（用户第 1 条后半）：**组父行语境**框内内容 = **组内合成画面**。
            #   病根与 `_edit_wp_point` 完全同源：`_sub_file` 是 `filt_frame.current_file`
            #   （组父行窗内 = 组内主文件）⇒ 编辑器里画的是**组内主视频帧被拉伸成整只大盒**，
            #   用户实测「画面帧不是组内合成帧, 是组内主视频帧」。
            #   ▸ 2026-10-16 收敛：改问**素材语境唯一解析器** `resolve_material_ctx` ——
            #     组语境它给出合成帧 PNG（`_group_box_snapshot_png`，带缓存）+ 盒尺寸；
            #     节点语境给出 `node_frame_extractor`；plain 语境给出 None（旧行为逐字节不变）。
            _ctx = _app.resolve_material_ctx(self.filt_frame)
            _gc_png = _ctx.frame_png if _ctx is not None else None
            # 🔴 2026-10-17（用户：「除了文字水印真实帧，其它一律不落盘」）：优先**内存字节**
            _gc_ppm = getattr(_ctx, "frame_ppm", None) if _ctx is not None else None
            _gc_w = _gc_h = None
            if _ctx is not None and _ctx.kind == "group_box" and _ctx.size[0]:
                _gc_w, _gc_h = int(_ctx.size[0]), int(_ctx.size[1])
            # 背景帧：节点语境（组父行 / 视频节点 / 遮罩可视化已在用的同一条路）走
            #   **节点时间轴取帧器**（= 节点输出画面），而不是 `_sub_file`（组父行 = 组内主文件）。
            #   `_mask_bg_pre_filter()` 由 filt_frame 自己的 crop/rotate 拼成，而节点取帧器
            #   已在内部排除几何效果（`_node_fx_excl`）⇒ 节点语境不能再叠 pre_filter（双重变换）。
            _nf_ex = _ctx.frame_extract if _ctx is not None else None
            _app.open_watermark_overlay_editor(
                _cw, _ch, _bw, _bh, vx, vy,
                scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
                watermark_dict=None, filt_frame=None, parent=self, free_layout=True,
                main_video_file=_sub_file,
                bg_pre_filter=(None if _nf_ex else _mask_bg_pre_filter()),
                frame_extractor=_nf_ex,
                on_apply=_on_apply, on_drag_commit=apply_xy,
                initial_time=t0,
                aspect_ratio=None,
                angle_editable=False,
                # 2026-09-12：八向飞入/飞出预设（与画布编辑器共用同一份常量）。
                # 偏移基准 = 遮罩画布尺寸 _cw x _ch（挡板保持原尺寸，只挪位置）。
                corner_dirs=CORNER_DIR_PRESETS,
                corner_src_w=_cw, corner_src_h=_ch,
                start_end=start_end,
                # 2026-09-22：遮罩画布=子视频缩放后尺寸（语义要求），子视频缩小时画布极小，
                # 编辑器显示层允许放大适配窗口（坐标空间不受影响）。
                allow_upscale=True,
                # 2026-10-05 用户拍板：**遮罩不接入真实帧**（上一轮误改为 False 导致框内
                # 透明空白）。遮罩是「半透明挡板」，框内透明既看不出挡板形状、也没有真实帧
                # 可显示（这里根本没传 content_file），纯误导 ⇒ 回退 draw_diagonal=True，
                # 矩形内填 gray50 斜纹 = 红蓝虚拟框，与子视频/文字水印的「真实帧」模式区分开。
                # 🔴 2026-10-16（用户第 1 条后半）：**组父行语境例外** —— 合成帧可用（_gc_png）
                #   ⇒ 打开真实帧模式（content_file + content_alpha），框内直接显示组内合成画面，
                #   用户能对着合成画面摆挡板；非组语境仍走 draw_diagonal 虚拟框（原行为不变）。
                coord_box=True,
                content_file=(_gc_png or None),
                content_ppm=_gc_ppm,
                content_chroma_settings=None,
                content_src_w=(_gc_w if _gc_w else None),
                content_src_h=(_gc_h if _gc_h else None),
                content_time=t0,
                content_alpha=bool(_gc_png or _gc_ppm),
                draw_diagonal=(not bool(_gc_png or _gc_ppm)))
            try:
                apply_xy(float(vx.get()), float(vy.get()))
            except (ValueError, TypeError):
                pass

        def _open_mask_traj():
            # 轨迹对「源形状」与「布尔结果」同样生效 —— 布尔结果每行就是一条普通形状
            # （自带 traj_enabled+waypoints），故这里统一按当前焦点目标取条目。
            _idx, _cur = _cur_entry()
            if _cur is None:
                return
            if _active["v"] != "bool":
                _collect_form(_idx)
                _cur = items[_idx]
            _wps0 = [dict(w) for w in (_cur.get("waypoints") or []) if isinstance(w, dict)]
            with suppress(Exception):
                win.grab_release()
            with suppress(Exception):
                win.attributes("-topmost", False)

            def _commit_traj(v):
                _nw = [w for w in (v.get("move_waypoints") or []) if isinstance(w, dict)]
                _cur["waypoints"] = _nw
                if _nw and not t_traj.get():
                    t_traj.set(True)
                _cur["traj_enabled"] = bool(t_traj.get())
                with suppress(Exception):
                    _wp_lbl.configure(text=_("（%d 个航点）") % len(_nw))
                if _active["v"] == "bool":
                    _update_brow(_idx)
                else:
                    _update_row(_idx)

            _trajectory_dialog(
                win,
                # ⚠️ 2026-09-11 修复：原来恒传 "waypoints" → 轨迹弹窗一打开就「启用列表轨迹」
                #    勾着并种子 1 行（用户实测「打开就是一个启用的带初始一条的」）。
                #    改为回显真实状态：已有航点、或本形状已勾「轨迹」才预启用；否则干净打开。
                {"move_mode": ("waypoints" if (_wps0 or t_traj.get()) else ""),
                 "move_cycle": 4.0, "move_dwell": 2.0,
                 "move_margin": "W*0.03", "move_waypoints": list(_wps0)},
                _commit_traj,
                # ⚠️ edit_cb 必须传：为 None 时列表里的「起始坐标…/结尾坐标…」按钮永久置灰
                edit_cb=_mask_edit_cb,
                canvas_w=_cw, canvas_h=_ch,
                video_file=_vf, ffmpeg_cmd=_ffm, ffprobe_cmd=_fprobe,
                app=_app,
                # 遮罩链只消费航点 x/y：预设动效/角度/缩放链路不消费 → 隐藏
                show_presets=False, allow_angle=False,
                consume_alpha=False)

        # ---------- 外部形状图 ----------
        def _pick_png():
            p = filedialog.askopenfilename(
                title=_("选择形状图（黑白图或透明底挡块，格式不限）"),
                filetypes=[(_("图片"), "*.png *.jpg *.jpeg *.bmp *.webp *.gif *.tif *.tiff"),
                           (_("所有文件"), "*.*")])
            if not p:
                return
            t_png_path.set(p)
            detected = ""
            try:
                if _fprobe:
                    _r = subprocess.run(
                        [_fprobe, "-v", "error", "-select_streams", "v:0",
                         "-show_entries", "stream=pix_fmt",
                         "-of", "default=noprint_wrappers=1:nokey=1", p],
                        capture_output=True, timeout=5,
                        creationflags=_ffmpeg_spawn_flags())
                    _pf = _r.stdout.decode("utf-8", "replace").strip().splitlines()
                    _pf = _pf[0].strip().lower() if _pf else ""
                    if _pf in _MASK_SHAPE_ALPHA_PIXFMTS:
                        detected = "alpha"
                    elif _pf:
                        detected = "bw"
            except Exception:
                detected = ""
            if detected:
                t_png_type.set(detected)
                t_ptype_hint.set(_("（已自动检测：%s）")
                                 % (_("透明底挡块") if detected == "alpha" else _("黑白亮度图")))
            else:
                t_png_type.set("bw")
                t_ptype_hint.set(_("（未检测到，按黑白亮度图；可手动改）"))

        def _clear_png():
            t_png_path.set("")
            t_ptype_hint.set("")

        # ---------- 保存 ----------
        def _do_save():
            _idx = _sel_idx()
            # ⚠️ 布尔态下表单装的是布尔条目的值，绝不能 collect 进源形状（会串值）
            if _idx is not None and _active["v"] != "bool":
                _collect_form(_idx)
            _out = []
            for _it in items:
                _d = {
                    "enabled": bool(_it.get("enabled", True)),
                    "mode": (_it.get("mode", "outside")
                             if _it.get("mode", "outside") in ("outside", "inside")
                             else "outside"),
                    # ⚠️ shape 必须在白名单里（2026-10-05 事故：白名单漏了它 ⇒ 保存后
                    # mask_shapes 里没.shape，重开下拉恒回「矩形」；预览正常是因为预览
                    # 走 _collect_form 写回 items[idx] 再读，绕开了这份重建）。
                    "shape": (_it.get("shape", "rect")
                              if str(_it.get("shape", "rect")).strip().lower()
                              in ("rect", "circle", "triangle", "diamond")
                              else "rect"),
                    "x": _to_f(_it.get("x", 0), 0.0),
                    "y": _to_f(_it.get("y", 0), 0.0),
                    "w": _to_f(_it.get("w", 100), 100.0),
                    "h": _to_f(_it.get("h", 100), 100.0),
                    "feather": _to_f(_it.get("feather", 0), 0.0),
                    # ⚠️ rot 必须在白名单里（2026-10-05 事故先例：shape 漏在白名单外 ⇒
                    # 保存后 mask_shapes 没.rot，重开恒回「矩形」）。白名单是重建式的，
                    # 漏一个键 = 该字段静默丢弃（预览正常，只有「重开弹窗」才现形）。
                    "rot": _to_f(_it.get("rot", 0), 0.0),
                    "t_start": _to_f(_it.get("t_start", 0), 0.0),
                    "t_end": _to_f(_it.get("t_end", 0), 0.0),
                    "png_path": str(_it.get("png_path", "") or "").strip(),
                    "png_type": (_it.get("png_type", "bw")
                                 if _it.get("png_type", "bw") in ("bw", "alpha") else "bw"),
                    "png_invert": bool(_it.get("png_invert", False)),
                    "traj_enabled": bool(_it.get("traj_enabled", False)),
                    "waypoints": [dict(w) for w in (_it.get("waypoints") or [])
                                  if isinstance(w, dict)],
                }
                _d["type"] = "png" if _d["png_path"] else "rect"
                _out.append(_d)
            self.mask_shapes = _out
            # 2026-10-11：布尔结果白名单重建（重建式，漏键 = 静默丢弃；同 mask_shapes 的教训）。
            # 源引用按 `_out`（与 items 同序）校验，越界/失效的丢弃；无有效源 ⇒ 整条丢弃。
            _bout = []
            for _b in bitems:
                _refs = []
                for _r in (_b.get("bool_src") or []):
                    try:
                        _ri = int(_r)
                    except (TypeError, ValueError):
                        continue
                    if 0 <= _ri < len(_out):
                        _refs.append(_ri)
                if not _refs:
                    continue
                _bop = _b.get("bool_op", "union")
                if _bop not in ("union", "intersect", "subtract"):
                    _bop = "union"
                _bout.append({
                    "enabled": bool(_b.get("enabled", True)),
                    "bool_op": _bop,
                    "bool_src": _refs,
                    "x": _to_f(_b.get("x", 0), 0.0),
                    "y": _to_f(_b.get("y", 0), 0.0),
                    "w": _to_f(_b.get("w", 0), 0.0),
                    "h": _to_f(_b.get("h", 0), 0.0),
                    "feather": _to_f(_b.get("feather", 0), 0.0),
                    "t_start": _to_f(_b.get("t_start", 0), 0.0),
                    "t_end": _to_f(_b.get("t_end", 0), 0.0),
                    "traj_enabled": bool(_b.get("traj_enabled", False)),
                    "waypoints": [dict(w) for w in (_b.get("waypoints") or [])
                                  if isinstance(w, dict)],
                })
            self.mask_booleans = _bout
            # 无形状 → 关闭总开关（避免旧单形状 0 尺寸矩形复活成黑屏）
            # 2026-10-09：提示必须**看得见** —— 原来只 print 到 stdout（GUI 用户根本看不到），
