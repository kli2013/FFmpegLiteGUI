        # 时段「时间预览」：回填上方「时段」起/止（输出时间线 t，秒）
        def _open_mask_seg_preview():
            """遮罩时段（输出时间线 t）时间预览：暂停后「设为起点/终点」回填 t_t0/t_t1（秒）。"""
            if alert_if(_app is None, _("提示"), _("未找到主应用，无法预览")):
                return
            _path = (_vf or "").strip()
            if alert_if(not _path or not os.path.exists(_path), _("错误"), _("主输入文件不存在，无法时间预览"), 'error'):
                return
            if alert_if(not (getattr(_app, "ffmpeg_cmd", None)), _("提示"), _("未找到 ffmpeg，无法预览")):
                return
            release_grab(_app.root)

            def _on_start(t):
                t_t0.set(_ffsec(t))

            def _on_end(t):
                t_t1.set(_ffsec(t))

            _init = []
            try:
                _s = float(t_t0.get() or 0)
                _e = float(t_t1.get() or 0)
                _init = [(_ffsec(_s), _ffsec(_e))]
            except (ValueError, TypeError):
                _init = []
            _app.show_time_picker(_app.root, _path, on_set_start=_on_start,
                                  on_set_end=_on_end, initial_marks=_init)

        # 时段（勾轨迹置灰 = 由航点接管）
        _t_row = ttk.Frame(edit_lf)
        _t_row.pack(fill=tk.X, pady=(4, 0))
        _lbltt31 = ttk.Label(_t_row, text=_("时段:"))
        _lbltt31.pack(side=tk.LEFT)
        e_t0 = ttk.Entry(_t_row, textvariable=t_t0, width=7)
        e_t0.pack(side=tk.LEFT, padx=2)
        ttk.Label(_t_row, text="~").pack(side=tk.LEFT)
        e_t1 = ttk.Entry(_t_row, textvariable=t_t1, width=7)
        e_t1.pack(side=tk.LEFT, padx=2)
        _time_hint = ttk.Label(_t_row, text=_("秒（止=0 或留空 = 全程常显）"), foreground="gray")
        _time_hint.pack(side=tk.LEFT, padx=6)
        _btn_seg_prev = ttk.Button(_t_row, text=_("时间预览"), command=_open_mask_seg_preview, width=8)
        _btn_seg_prev.pack(side=tk.LEFT, padx=(6, 0))
        ToolTip(_btn_seg_prev,
                _("打开内置简易时间预览（纯 ffmpeg）：暂停后点「设为起点/终点」回填上方时段起/止（秒，输出时间线）。"))
        ToolTip(_lbltt31,
                _("该形状的显示时段（秒，输出时间线）。\n"
                "止 <= 0 或留空 = 全程常显。\n"
                "勾选「轨迹」后本时段被忽略（可见性由航点接管）。"))

        # 轨迹（与上方「时段」互斥：勾选后时段被忽略、两框置灰）
        # 2026-09-11 布局调整：从「羽化」行移到这里——和时段相邻，互斥关系一眼可见。
        _traj_row = ttk.Frame(edit_lf)
        _traj_row.pack(fill=tk.X, pady=(3, 0))
        _chk_traj = ttk.Checkbutton(_traj_row, text=_("轨迹（沿轨迹移动）"), variable=t_traj)
        _chk_traj.pack(side=tk.LEFT)
        _btn_traj = ttk.Button(_traj_row, text=_("编辑航点…"), command=_open_mask_traj)
        _btn_traj.pack(side=tk.LEFT, padx=(6, 0))
        _wp_lbl = ttk.Label(_traj_row, text="", foreground="gray")
        _wp_lbl.pack(side=tk.LEFT, padx=(4, 0))
        ToolTip(_chk_traj,
                _("勾选后本形状沿「航点」移动，可见性也由航点接管。\n"
                "勾选后上方「时段」两框自动置灰（被忽略）。"))

        # 底部按钮（Windows 习惯：确认在左、消失在右，整体居中）
        _btns = ttk.Frame(main)
        _btns.pack(anchor=tk.CENTER, pady=(8, 0))
        ttk.Button(_btns, text=_("保存"), width=8, command=_do_save).pack(side=tk.LEFT, padx=5)
        ttk.Button(_btns, text=_("取消"), width=8, command=win.destroy).pack(side=tk.LEFT, padx=5)

        # ---- 右侧实时预览（2026-10-04 用户要求：遮罩窗口也加右边画面，学 delogo 窗口）----
        # 与 BlurFilterDialog 同款：预览挂在 PanedWindow 右 pane，坐标基准 = 遮罩作用的那张
        # 帧（子视频最终渲染尺寸，窗口上方 _sub_file / _cw / _ch 已算好），链序 = 预处理 → 遮罩 → scale。
        def _mask_pv_src():
            """预览源 = 遮罩实际作用的子视频（_sub_file 已在窗口上方按 page_scope 解析）。"""
            return _sub_file if _sub_file and os.path.exists(_sub_file) else ""

        def _mask_pv_build_cmd(src, t, static, bw, bh, mode):
            _settings = None
            # ⚠️ 轨迹画布必须与导出口径一致（2026-10-11 用户报障「布尔在右边预览坐标不对，
            #    整个画面的中下面只露一点点」）：
            #    `_mask_shape_pos_expr` 对**轨迹**形状返回 `(xe)*main_w/{cvw}`，分母 cvw 取自
            #    settings["mask_traj_canvas_w"]（缺失回退 MASK_TRAJ_CANVAS=1280x720）。
            #    导出链走 get_settings()（含该键，= 保存时的子视频渲染尺寸），而预览此前**没传**
            #    → 分母永远是 1280x720，与航点所在坐标系不一致 → 位置被按错误比例缩放
            #    （实测：画布 576x1024 时 x 缩到 0.45、y 放大到 1.42，形状跑到中下面并被底边裁掉）。
            #    这里补上与导出同一来源的画布值（未保存过 → 回落当前渲染尺寸）。
            #    真源探针：tests/_dbg_mask_preview_canvas.py（真实 ffmpeg，A/B 对照）。
            try:
                _pv_tcw = int(self.mask_traj_canvas_w.get() or 0) or int(_cw)
            except Exception:
                _pv_tcw = int(_cw)
            try:
                _pv_tch = int(self.mask_traj_canvas_h.get() or 0) or int(_ch)
            except Exception:
                _pv_tch = int(_ch)
            if mode == "proc":
                # 只取**当前编辑的那一块**做实时预览（与 delogo 窗口同款语义）。
                if _active["v"] == "bool":
                    # 布尔结果：预览 = 该条合并结果。必须把**全部源形状**一起传（源按 bool_src
                    # 索引引用），source 的可见性由这条布尔接管（被消费的源不再单独渲染）。
                    _bi = _bidx()
                    if _bi is not None and 0 <= _bi < len(bitems):
                        _settings = {"mask_shapes": [dict(_s) for _s in items],
                                     "mask_booleans": [dict(bitems[_bi])],
                                     "mask_traj_canvas_w": _pv_tcw,
                                     "mask_traj_canvas_h": _pv_tch}
                else:
                    # ⚠️ 两个真源约定（写错必错）：
                    #   ① 选中索引 = `_sel_idx()`（读 Treeview selection，无选中返回 None）；
                    #   ② `_collect_form(idx)` 是**写回** `items[idx]` 且**返回 None** ——
                    #      不能拿它的返回值当 dict，必须写回后再从 `items` 取。
                    _idx = _sel_idx()
                    if _idx is not None and 0 <= _idx < len(items):
                        _collect_form(_idx)          # 先把表单同步进 items（副作用）
                        # ⚠️ 此处**刻意不接**列表轨迹实时快照（live_wp_snapshot）。
                        # 2026-10-05 用户拍板：遮罩预览的语义 = 透明度/抠图/混合的颜色变化，
                        # **不该反映位置变化**；位置归位置编辑器自己的虚拟框（框内已渲染真实帧，
                        # 天然跟随）。曾在此注入未提交航点 → 预览跟着拖拽乱跳，方向错误已回退。
                        _settings = {"mask_shapes": [dict(items[_idx])],
                                     "mask_traj_canvas_w": _pv_tcw,
                                     "mask_traj_canvas_h": _pv_tch}
            # 节点语境（2026-10-16 用户报障「遮罩右边预览也是原始主视频兜底画面」）：
            # 背景改走**节点输出画面**（与左边「🎯 可视化选区」同源，那边走 node_frame_extractor），
            # 链路本身与旧路径**完全一致**（pre_filter → 遮罩链 → 棋盘底 → 装框），只换掉
            # 输入源 ⇒ 坐标基准、effect 语义都不会漂。
            _cb = getattr(self.filt_frame, "node_preview_cb", None)
            if _cb is not None:
                _tail = []
                if mode == "proc":
                    _pf = _mask_pv_pre_filter()
                    if _pf:
                        _tail.append(_pf)
                    if _settings:
                        _mk = _build_mask_multi_shape_filters(dict(_settings))
                        if _mk:
                            _tail.append(_mk)          # 原样拼接，不做能力降级
                            _tail.append(build_mask_checker_underlay())
                _tail.append(_pv_fit_scale(bw, bh))
                _cmd = None
                with suppress(Exception):
                    _cmd = _cb(t, ",".join(_tail))
                if not _cmd:
                    # 🔴 2026-10-17 稳健兜底（同 delogo 右侧预览）：node 语境下 `_cb(t>0)` 抛/
                    # 空 ⇒ 回落 t=0 合成帧（不经 tap_seek，不触发 retime，绝不抛），拿组组合成
                    # 画面首帧（非黑），而非源文件预览（父行无源文件⇒黑）。
                    with suppress(Exception):
                        _cmd = _cb(0.0, ",".join(_tail))
                if _cmd:
                    return _cmd
            return build_mask_preview_cmd(
                getattr(_app, "ffmpeg_cmd", None) or "ffmpeg", src, t,
                _settings, static_image=static, box_w=bw, box_h=bh,
                pre_filter=(_mask_pv_pre_filter() if mode == "proc" else ""))

        def _mask_pv_status_extra(t, static):
            if static:
                return _("（静态图片，无时间轴，显示时段不参与判定）"), None
            if not _sub_file:
                return _("遮罩作用在【子视频】上，当前未取到子视频"), None
            _extra = f"遮罩坐标基准 = 子视频最终渲染尺寸 {int(_cw)}x{int(_ch)}（与导出一致）"
            if _cw and _ch:
                return _extra, None
            return _extra + _("（未取到尺寸，坐标可能对不齐）"), None

        def _mask_outline_drawer(ov_canvas, ow, oh, iw, ih, off_x, off_y):
            """在右侧预览上叠「各形状轮廓虚线」（拼接对齐用；研究见 mask-boolean-labels §10）。

            画面尺寸 iw×ih = 最终渲染帧撑进预览框（force_original_aspect_ratio=decrease）后的
            实际像素；遮罩坐标基准 = _cw×_ch（二者同源）⇒ 映射
            (x,y) → 图区左上角 + (x·iw/_cw, y·ih/_ch)。图区左上角 offset 由组件按 letterbox 算好。
            ⛔ 只画不改：本回调绝不写回 items / 表单。
            """
            try:
                _cwv = float(_cw or 0)
                _chv = float(_ch or 0)
            except (ValueError, TypeError):
                _cwv = _chv = 0.0
            if _cwv <= 0 or _chv <= 0 or iw <= 0 or ih <= 0:
                return
            _sx, _sy = iw / _cwv, ih / _chv

            def _to_xy(px, py):
                return (off_x + px * _sx, off_y + py * _sy)

            if _active["v"] == "bool":
                # 聚焦布尔行 → 高亮它引用的源行集合
                _bi = _bidx()
                _hl = set()
                if _bi is not None and 0 <= _bi < len(bitems):
                    for _r in (bitems[_bi].get("bool_src") or []):
                        try:
                            _hl.add(int(_r))
                        except (TypeError, ValueError):
                            continue
            else:
                _si = _sel_idx()
                _hl = {_si} if (_si is not None and 0 <= _si < len(items)) else set()
            draw_mask_shape_outlines(ov_canvas, items, _hl, _to_xy, tag="mask_outline")

        _mask_pv = LiveFramePreview(
            _pv_paned, _app,
            get_src=_mask_pv_src,
            build_cmd=_mask_pv_build_cmd,
            status_extra=_mask_pv_status_extra,
            time_value="3", title=_("实时预览（内存中）"),
            hint=None,
            tip=_("右侧显示的是**当前列表选中行**的遮罩效果。\n"
                "坐标基准 = 子视频最终渲染帧（与正式导出、遮罩可视化编辑器同一口径）。\n"
                "改方向 / 坐标 / 羽化 / 时段 / 航点都会实时刷新。\n"
                "（左右分隔条可拖，拉宽后画面更清楚。）"),
            box_w=320, box_h=250)
        _pv_paned.add(_mask_pv, weight=2)
        # 登记前向持有 + 挂「形状轮廓虚线」叠加层（选中行实线高亮、其余浅绿虚线，方便拼接对齐）
        _pv_ref["pv"] = _mask_pv
        with suppress(Exception):
            _mask_pv.set_overlay_drawer(_mask_outline_drawer)

        def _mask_pv_kick(*_a):
            # 遮罩窗的所有表单变量都在 _apply_now 的 trace 名单里（模式/坐标/羽化/时段/…），
            # 这里再补一条独立 trace：它们变化不保证触发 schedule（_apply_now 只写回数据）。
            with suppress(Exception):
                _mask_pv.schedule()
            _ov_redraw()   # 形状参数（坐标/形状/旋转）变了 → 轮廓虚线跟着重画

        for _v in (t_mode, t_shape, t_x, t_y, t_w, t_h, t_feather, t_rot, t_t0, t_t1,
                   t_png_path, t_png_type, t_png_invert, t_traj):
            with suppress(Exception):
                _v.trace_add("write", _mask_pv_kick)
        # ⚠️ t_rot_d（旋转**滑块**侧）也要挂：它自己是 DoubleVar，不经过 t_rot 就会静默。
        # 滑块拖动 → t_rot_d trace → _rot_from_scale 写 t_rot → 上面那条已挂 ⇒ 预览会刷新；
        # 但**双保险**直接挂上，避免将来改同步实现时无声断链（症状＝拖滑块预览不动）。
        with suppress(Exception):
            t_rot_d.trace_add("write", _mask_pv_kick)
        # ⚠️ 必须首渲一次（同 BlurFilterDialog 的教训）：开窗这条路上变量值往往与初值相同
        # ⇒ trace 一个都不响 ⇒ 右侧一直空白。只有「新建/切换行」才会改值。
        with suppress(Exception):
            _mask_pv.schedule()

        # 编辑区控件集合（无形状时统一置灰）
        # ⚠️ 旋转的**滑块 _srot 与编辑框 e_rot 都要进名单** —— 漏滑块会出现
        #    「禁用状态下仍能拖动旋转」（编辑框灰了、滑块还在，用户以为没生效）。
        _edit_widgets = [_rd_out, _rd_in, _cb_shape, e_x, e_y, e_w, e_h, e_feather,
                         _srot, e_rot, _chk_traj,
                         _btn_traj, e_png, _btn_pl, _btn_pc, _rd_bw, _rd_al, _chk_inv,
                         e_t0, e_t1, _btn_vis, _btn_seg_prev]

        # form 改动即写回当前形状（ttk.Entry 无 command=，用 write trace）
        for _v in (t_mode, t_shape, t_x, t_y, t_w, t_h, t_feather, t_rot, t_t0, t_t1,
                   t_png_path, t_png_type, t_png_invert):
            _v.trace_add("write", _apply_now)
        t_traj.trace_add("write", _on_traj_change)
        # 布尔态：表单里的轨迹/时段改动写回布尔条目（其余控件已置灰 → 不触发 _apply_now）。
        for _v in (t_traj, t_t0, t_t1):
            with suppress(Exception):
                _v.trace_add("write", _bool_apply)

        # ---------- 初始化 ----------
        items = [dict(_s) for _s in (self.mask_shapes or []) if isinstance(_s, dict)]
        if not items:
            items = [_migrate_row()]
        for _it in items:
            _it.setdefault("enabled", True)
            _it.setdefault("mode", "outside")
            _it.setdefault("shape", "rect")
            _it.setdefault("rot", 0.0)     # 老存档没有 rot 键 → 按「不转」兜（2026-10-05）
            _it.setdefault("png_type", "bw")
            _it.setdefault("png_invert", False)
            _it.setdefault("traj_enabled", False)
            if not isinstance(_it.get("waypoints"), list):
                _it["waypoints"] = []
        # 布尔结果：引用式条目（记 op + 源引用），打开窗口时按当前源重算显示/落位盒
        bitems = [dict(_b) for _b in (self.mask_booleans or []) if isinstance(_b, dict)]
        for _b in bitems:
            _b.setdefault("enabled", True)
            _b.setdefault("bool_op", "union")
            if not isinstance(_b.get("bool_src"), list):
                _b["bool_src"] = []
            _b.setdefault("feather", 0.0)
            _b.setdefault("t_start", 0.0)
            _b.setdefault("t_end", 0.0)
            _b.setdefault("traj_enabled", False)
            if not isinstance(_b.get("waypoints"), list):
                _b["waypoints"] = []
        _refresh()
        if items:
            _edit_on["v"] = True
            _last_sel["v"] = 0
            tree.selection_set("0")
            _load_form(0)
        else:
            _edit_on["v"] = False
        _sync_state()

        win.update_idletasks()
        try:
            # 2026-09-11：上列表 + 下参数（方向/坐标/羽化轨迹/外部图/时段），窗口加高
            # 2026-10-04：480 → 830，右侧多一个 PanedWindow pane 放 LiveFramePreview
            # （与 BlurFilterDialog 的 780 同款口径：左表单 ~470 + 右预览 ~350 + sash）。
            # 2026-10-11：加「布尔结果列表」+ 布尔合成行 → 高度 660 → 760（宽不变）
            # 2026-10-11（二次）：760 仍不够 —— 用户报「下面很多被遮挡」⇒ 改为**按内容自适应**：
            #   取左表单 `main` 的请求高度（新列表自然计入），下限 880、上限屏幕 94%。
            #   比再拍一个固定数字稳 —— 以后再往表单里加一行也不会被裁。
            win.resizable(True, True)      # 允许拖 sash / 拉宽看细节
            try:
                _need_h = int(main.winfo_reqheight()) + 24   # +24 = paned 的 pady×2 + 余量
            except Exception:
                _need_h = 0
            _need_h = max(880, _need_h)
            try:
                _need_h = min(_need_h, int(win.winfo_screenheight() * 0.94))
            except Exception:
                pass
            center_window(win, 830, _need_h)
        except Exception:
            pass

    def get_settings(self):
        _s = {
            "loop_enabled": self.loop_enabled.get(),
            "loop_mode": self.loop_mode.get(),
            "loop_count": self.loop_count.get(),
            # 显示时段 / 循环显示（enable 控制）
            "show_start": self.show_start_var.get().strip(),
            "show_end": self.show_end_var.get().strip(),
            "show_cycle": self.show_cycle_var.get().strip(),
            "show_once": self.show_once_var.get().strip(),
            "chroma_enabled": self.chroma_enabled.get(),
            "chroma_color": self.chroma_color.get(),
            "chroma_similarity": self.chroma_similarity.get(),
            "chroma_blend": self.chroma_blend.get(),
            # 新增透明度
            "alpha_enabled": self.alpha_enabled.get(),
            "alpha_value": self.alpha_value.get(),
            "chroma_filter_type": self.chroma_filter_type.get(),
            # 子视频音频模式（默认/忽略/混音/替换）
            "audio_mode": self.audio_mode.get(),
            # 外轮廓描边（2026-10-02）
            "outline_enabled": self.outline_enabled.get(),
            "outline_color": self.outline_color.get(),
            "outline_width": self.outline_width.get(),
            # 遮罩 / 透明蒙版
            "mask_enabled": self.mask_enabled.get(),
            "mask_x": self.mask_x.get(),
            "mask_y": self.mask_y.get(),
            "mask_w": self.mask_w.get(),
            "mask_h": self.mask_h.get(),
            "mask_mode": self.mask_mode.get(),
            # 2026-09-10：遮罩轨迹 + 边缘羽化
            "mask_feather": self.mask_feather.get(),
            "mask_traj_enabled": self.mask_traj_enabled.get(),
            "mask_waypoints": self.mask_waypoints,
            "mask_traj_canvas_w": self.mask_traj_canvas_w.get(),
            "mask_traj_canvas_h": self.mask_traj_canvas_h.get(),
            # 2026-09-10：形状图（自制黑白/透明底形状当 matte）
            "mask_png_enabled": self.mask_png_enabled.get(),
            "mask_png_path": self.mask_png_path.get(),
            "mask_png_invert": self.mask_png_invert.get(),
            "mask_png_type": self.mask_png_type.get(),
            # 2026-09-11：遮罩多形状列表（空列表→旧单形状逻辑）
            "mask_shapes": list(self.mask_shapes),
            # 2026-10-11：遮罩布尔结果列表（源形状的 并/交/差 合并；空列表=无布尔）
            "mask_booleans": [dict(_b) for _b in (self.mask_booleans or [])
                              if isinstance(_b, dict)],
        }
        # 2026-10-09 主视频模式：循环/显示时段/音频模式对主视频不适用（UI 已置灰）→
        # 不写回设置，避免污染主视频 enc_settings。绿幕/透明度/描边/遮罩照常返回。
        if self.main_video_mode:
            for _k in ("loop_enabled", "loop_mode", "loop_count",
                       "show_start", "show_end", "show_cycle", "show_once",
                       "audio_mode"):
                _s.pop(_k, None)
        return _s
    
    def set_settings(self, settings):
        self.loop_enabled.set(settings.get("loop_enabled", False))
        self.loop_mode.set(settings.get("loop_mode", "infinite"))
        self.loop_count.set(settings.get("loop_count", 3))
        self.show_start_var.set(str(settings.get("show_start", "")))
        self.show_end_var.set(str(settings.get("show_end", "")))
        self.show_cycle_var.set(str(settings.get("show_cycle", "")))
        self.show_once_var.set(str(settings.get("show_once", "")))
        self.chroma_enabled.set(settings.get("chroma_enabled", False))
        self.chroma_color.set(settings.get("chroma_color", "#3fff08"))
        sim = settings.get("chroma_similarity", 0.2)
        if sim <= 0:
            sim = 0.2
        self.chroma_similarity.set(sim)
        self.sim_entry_var.set(f"{sim:.4f}")
        blend = settings.get("chroma_blend", 0.1)
        self.chroma_blend.set(blend)
        self.blend_entry_var.set(f"{blend:.2f}")
        self.chroma_filter_type.set(settings.get("chroma_filter_type", "chromakey"))
        # 子视频音频模式恢复（英文键 → 中文显示）
        self.audio_mode.set(settings.get("audio_mode", "default") or "default")
        self.audio_mode_disp.set(self._audio_mode_v2d.get(self.audio_mode.get(), _("默认")))
        self.color_swatch.config(bg=self.chroma_color.get())
        self._update_loop_state()
    
        # 新增透明度恢复
        self.alpha_enabled.set(settings.get("alpha_enabled", False))
        val = settings.get("alpha_value", 1.0)
        self.alpha_value.set(val)
        self.alpha_spinbox_var.set(f"{val:.1f}")

        # 外轮廓描边 恢复（2026-10-02；旧工程无此项 → 三个默认值，行为完全不变）
        self.outline_enabled.set(bool(settings.get("outline_enabled", False)))
        _oc = str(settings.get("outline_color", "#FFFFFF") or "#FFFFFF").strip()
        self.outline_color.set(_oc or "#FFFFFF")
        try:
            _ow = int(str(settings.get("outline_width", "4")).strip() or "4")
        except (ValueError, TypeError):
            _ow = 4
        self.outline_width.set(str(max(1, min(20, _ow))))

        # 遮罩 / 透明蒙版 恢复
        self.mask_enabled.set(settings.get("mask_enabled", False))
        self.mask_x.set(str(settings.get("mask_x", "0")))
        self.mask_y.set(str(settings.get("mask_y", "0")))
        self.mask_w.set(str(settings.get("mask_w", "100")))
        self.mask_h.set(str(settings.get("mask_h", "100")))
        self.mask_mode.set(settings.get("mask_mode", "outside"))
        # 2026-09-10：遮罩轨迹 + 边缘羽化 恢复
        self.mask_feather.set(str(settings.get("mask_feather", "0")))
        self.mask_traj_enabled.set(settings.get("mask_traj_enabled", False))
        self.mask_waypoints = list(settings.get("mask_waypoints") or [])
        # 2026-09-10：形状图恢复（type 非法值归位 bw）
        self.mask_png_enabled.set(bool(settings.get("mask_png_enabled", False)))
        self.mask_png_path.set(str(settings.get("mask_png_path", "") or ""))
        self.mask_png_invert.set(bool(settings.get("mask_png_invert", False)))
        _t_pt = str(settings.get("mask_png_type", "bw") or "bw")
        self.mask_png_type.set(_t_pt if _t_pt in ("bw", "alpha") else "bw")
        # 航点坐标系：随航点一起恢复（0/缺失 → 生成时按 MASK_TRAJ_CANVAS_* 兜底）
        try:
            self.mask_traj_canvas_w.set(int(settings.get("mask_traj_canvas_w", 0) or 0))
            self.mask_traj_canvas_h.set(int(settings.get("mask_traj_canvas_h", 0) or 0))
        except (ValueError, TypeError):
            self.mask_traj_canvas_w.set(0)
            self.mask_traj_canvas_h.set(0)
        # 2026-09-11：遮罩多形状列表（旧工程无此项→空列表→走旧单形状逻辑）
        self.mask_shapes = [s for s in (settings.get("mask_shapes") or []) if isinstance(s, dict)]
        # 2026-10-11：遮罩布尔结果列表（旧工程无此项→空列表→无布尔）
        self.mask_booleans = [b for b in (settings.get("mask_booleans") or [])
                              if isinstance(b, dict)]

        # 2026-10-09 主视频模式：循环/音频项不适用（UI 置灰）→ 复位默认，避免存档带出勾选态。
        if self.main_video_mode:
            self.loop_enabled.set(False)
            self.loop_mode.set("infinite")
            self.audio_mode.set("default")
            self.audio_mode_disp.set(_("默认"))
            self._update_loop_state()

    def set_duration_info(self, duration_sec: Optional[float]):
        """设置时长显示信息"""
        if duration_sec is not None and duration_sec > 0:
            text = _('视频时长: {0}').format(format_seconds_short(duration_sec))
            self.duration_label.config(text=text)
        else:
            self.duration_label.config(text="")

    def _update_loop_state(self):
        if self.loop_enabled.get():
            self.count_spinbox.config(state="readonly")
            self.loop_mode.set("count")
        else:
            self.count_spinbox.config(state="disabled")
            self.loop_mode.set("infinite")

# ================== 公共组件：叠加位置与画布偏移（仅轨道模式） ==================
class OverlayPositionFrame(ttk.LabelFrame):
    """
    叠加位置（子视频）或画布偏移（主视频）设置组件。
    仅用于画中画或水印模式，始终显示控件。
    """
    def __init__(self, master, app, mode='sub', track_idx=None, track_obj=None,
                 filt_frame=None, visual_callback=None,
                 page_scope="merge", ctx_main_file=None, ctx_main_settings=None,
                 overlay_visual_callback=None, pad_visual_callback=None,
                 tile_callback=None, tile_inside_callback=None, **kwargs):
        """…

        🔴 2026-10-16（用户第 2 条「命令编辑器不支持新组合模式 / 各种位置编辑器入口报没有索引」）：
        本组件原先**硬依赖 `track_idx`**（`self.app.open_visual_overlay_editor(self.track_idx…)`、
        `open_visual_pad_editor(self.track_idx…)`、`merge_smart_tile(self.track_idx…)`），
        凡是没有真轨道的宿主（**命令编辑器**：`edit_video_settings(track_idx=None)`）点这三个
        入口全部走 else 分支弹「缺少轨道索引」——**入口等于死的**。
        ⇒ 改成「**回调优先**」：宿主可注入自己的实现（对象 + 转发器由宿主给），
        有回调就走回调，没有才回到老的 `track_idx` 路径。四个参数**全部默认 None**
        ⇒ 封装页/转换页/队列的既有调用逐字节不变（零回归）。
        回调签名（都无参/自取自用，宿主闭包）：
          · `overlay_visual_callback()`       = 「🎨 可视化编辑坐标」
          · `pad_visual_callback(pw, ph, ox, oy)` = 「🎨 可视化编辑画布偏移」（传活控件值）
          · `tile_callback()` / `tile_inside_callback()` = 两个平铺入口
        """
        super().__init__(master, **kwargs)
        self.app = app
        self.mode = mode
        # 2026-09-23 修正：本组件不只封装页用——edit_video_settings 还把它用于
        # 转换页水印编辑器（page_scope='convert'）与队列任务水印（ctx_main_file=任务输入）。
        # 轨迹/坐标编辑器的主视频解析按此作用域取「本页自己的主视频」，两页绝不互相兜底。
        self.page_scope = page_scope or "merge"
        self.ctx_main_file = ctx_main_file      # 显式语境主视频（队列任务编辑=task.input）优先
        self.ctx_main_settings = ctx_main_settings  # 与 ctx_main_file 同源设置（队列=task.settings）
        self.track_idx = track_idx
        self.track_obj = track_obj
        self.filt_frame = filt_frame
        self.visual_callback = visual_callback
        # 无轨宿主（命令编辑器）注入的入口实现；None = 走老的 track_idx 路径（见 __init__ docstring）
        self.overlay_visual_callback = overlay_visual_callback
        self.pad_visual_callback = pad_visual_callback
        self.tile_callback = tile_callback
        self.tile_inside_callback = tile_inside_callback
        self._controls = []
        self.blend_mode = tk.StringVar(value="normal")
        self._create_controls()

    def _create_controls(self):
        if self.mode == 'sub':
            self._create_sub_controls()
        else:
            self._create_main_controls()

    def _create_sub_controls(self):
        """子视频叠加位置控件"""
        self.overlay_enabled = tk.BooleanVar(value=True)
        top_row = ttk.Frame(self)
        top_row.pack(anchor=tk.W, pady=(0,5))
        cb = ttk.Checkbutton(top_row, text=_("启用叠加"), variable=self.overlay_enabled)
        cb.pack(side=tk.LEFT)
        self._controls.append(cb)
        ttk.Label(top_row, text=_("混合模式:")).pack(side=tk.LEFT, padx=(40,5))
        self._blend_display = {
            "normal": _("正常(透明叠加)"),
            "overlay": _("叠加混合(blend)"),
            "screen": _("滤色(screen)"),
            "multiply": _("正片叠底(multiply)"),
            "darken": _("变暗(darken)"),
            "lighten": _("变亮(lighten)"),
            "addition": _("相加(addition)"),
            "difference": _("差值(difference)"),
            "softlight": _("柔光(softlight)"),
            "hardlight": _("强光(hardlight)"),

            "average": _("平均(average)"),
            "burn": _("颜色加深(burn)"),
            "grainextract": _("颗粒提取(grainextract)"),
            "divide": _("划分(divide)"),
            "dodge": _("颜色减淡(dodge)"),
            "freeze": _("冻结(freeze)"),
            "exclusion": _("排除(exclusion)"),
            "extremity": _("极值(extremity)"),
            "glow": _("发光(glow)"),
            "hardmix": _("实色混合(hardmix)"),
            "heat": _("加热(heat)"),
            "linearlight": _("线性光(linearlight)"),
            "multiply128": _("正片叠底128(multiply128)"),
            "grainmerge": _("颗粒合并(grainmerge)"),
            "phoenix": _("凤凰(phoenix)"),
            "pinlight": _("点光(pinlight)"),
            "reflect": _("反射(reflect)"),
            "subtract": _("相减(subtract)"),
            "vividlight": _("亮光(vividlight)"),

             #位运算类（and/or/xor/negation）是逐像素按位逻辑运算，8-bit 下效果很怪（基本是黑白噪点感），合法但实用价值低
            "or": _("按位或(or)"),
            "and": _("按位与(and)"),
            "xor": _("按位异或(xor)"),
            "negation": _("反相(negation)"),

        }
        blend_values = list(self._blend_display.keys())
        blend_labels = [self._blend_display[k] for k in blend_values]
        self.blend_mode_display = tk.StringVar(value=self._blend_display.get(self.blend_mode.get(), blend_labels[0]))
        blend_cb = ttk.Combobox(top_row, textvariable=self.blend_mode_display, width=18,
                               values=blend_labels, state="readonly")
        blend_cb.pack(side=tk.LEFT, padx=(0,5))

        self.overlay_free_layout = tk.BooleanVar(value=False)
        free_cb = ttk.Checkbutton(top_row, text=_("放开边界"), variable=self.overlay_free_layout)
        free_cb.pack(side=tk.LEFT, padx=10)
        ToolTip(free_cb,
                _("放开边界限制（自由布局）：允许子视频比主视频大、可拖出主画面之外（编辑器不滚动，超出部分自然出框）。\n"
                "位置/大小原样送入 ffmpeg，最终输出画布=主视频（超出部分被主帧裁掉）；主视频启用偏移/pad 时底=pad 画布。"),
                wraplength=400)
        self._controls.append(free_cb)

        def _on_blend_selected(evt=None):
            sel = blend_cb.get()
            if sel in blend_labels:
                self.blend_mode.set(blend_values[blend_labels.index(sel)])
        blend_cb.bind("<<ComboboxSelected>>", _on_blend_selected)
        ToolTip(blend_cb, _("「正常(透明叠加)」=常规 overlay：子视频保留自身透明、叠在主画面上层，位置随 X/Y。其余为 Photoshop 式混合算法(blend)：子视频按 X/Y 摆放、其外部区域以该模式中性色填充后再对整帧按算法混合，与「正常」视觉完全不同。"), wraplength=440)
        self._controls.append(top_row)

        # X/Y 位置：2 行（标签行 + 编辑框行）。用 grid 分两列，
        # 第 1 列放 X 标签/编辑框，第 2 列放 Y 标签/编辑框，
        # 列各自左对齐 → 右侧 Y 标签与 Y 编辑框天然左对齐（不受 X 宽度影响）。
        pos_frame = ttk.Frame(self)
        pos_frame.pack(anchor=tk.W, fill=tk.X, pady=(2, 4))
        self.overlay_x = tk.StringVar(value=DEFAULT_OVERLAY_X)
        self.overlay_y = tk.StringVar(value=DEFAULT_OVERLAY_Y)
        ttk.Label(pos_frame, text=_("X 位置 (支持表达式，如 W-w-10):")).grid(row=0, column=0, sticky="w")
        ttk.Label(pos_frame, text=_("Y 位置 (支持表达式):")).grid(row=0, column=1, sticky="w", padx=(24, 0))
        x_entry = ttk.Entry(pos_frame, textvariable=self.overlay_x, width=28)
        x_entry.grid(row=1, column=0, sticky="w", pady=2)
        y_entry = ttk.Entry(pos_frame, textvariable=self.overlay_y, width=28)
        y_entry.grid(row=1, column=1, sticky="w", padx=(24, 0), pady=2)
        self._controls.extend([pos_frame, x_entry, y_entry])

        # 快速预设
        preset_frame = ttk.LabelFrame(self, text=_("快速预设"), padding="3")
        preset_frame.pack(fill=tk.X, pady=5)
        self._controls.append(preset_frame)

        positions = {
            _("左上角"): ("10", "10"),
            _("右上角"): (DEFAULT_OVERLAY_X, "10"),
            _("左下角"): ("10", DEFAULT_OVERLAY_Y),
            _("右下角"): (DEFAULT_OVERLAY_X, DEFAULT_OVERLAY_Y),
            _("居中"): ("(W-w)/2", "(H-h)/2")
        }
        def set_position(x_val, y_val):
            self.overlay_x.set(x_val)
            self.overlay_y.set(y_val)
        for text, (x_val, y_val) in positions.items():
            btn = ttk.Button(preset_frame, text=text,
                             command=lambda x=x_val, y=y_val: set_position(x, y))
            btn.pack(side=tk.LEFT, padx=2, pady=2)
            self._controls.append(btn)

        # 可视化编辑
        def open_visual():
            if alert_if(not self.overlay_enabled.get(), _("提示"), _("请先勾选「启用叠加」再使用可视化编辑功能。"), 'info'):
                return
            if self.visual_callback is not None:
                self.visual_callback()
            elif self.overlay_visual_callback is not None:
                # 无轨宿主（命令编辑器）注入的实现：背景帧/坐标空间/写回都由宿主给
                # （2026-10-16）。放在 track 分支**之前** —— 命令编辑器本来就没有 track_idx，
                # 老分支永远进不去，放在后面等于没接。
                self.overlay_visual_callback()
            elif self.app and self.track_idx is not None:
                parent_win = self.winfo_toplevel()
                _free = self.overlay_free_layout.get()
                self.app.open_visual_overlay_editor(
                    self.track_idx,
                    ov_x_var=self.overlay_x,
                    ov_y_var=self.overlay_y,
                    ov_angle_var=getattr(self, "rotate_angle", None),
                    filt_frame=self.filt_frame,
                    parent=parent_win,
                    free_layout=_free,
                    free_layout_var=self.overlay_free_layout,
                    # 2026-10-15：节点编辑器里的**组节点** —— 拖的是组**组合包围盒**
                    # （`_open_node_tap_dialog` → edit_video_settings 置本标志）。
                    group_box=getattr(self, "group_box_edit", False),
                    # 2026-10-16：父行的节点指纹 key —— 缩放/旋转把手写回父行素材设置
                    group_fx_key=getattr(self, "group_fx_key_edit", None),
                )
            else:
                messagebox.showinfo(_("提示"), _("无法启动可视化编辑：缺少轨道索引或回调"))
        btn = ttk.Button(preset_frame, text=_("🎨 可视化编辑坐标"), command=open_visual)
        btn.pack(side=tk.LEFT, padx=5, pady=2)
        self._controls.append(btn)

        # 持续旋转（绕中心动态旋转）——仅子视频（水印/画中画）
        spin_frame = ttk.Frame(self)
        spin_frame.pack(anchor=tk.W, fill=tk.X, pady=(4, 2))
        self.spin_enabled = tk.BooleanVar(value=False)
        spin_cb = ttk.Checkbutton(spin_frame, text=_("持续旋转 (绕中心)"), variable=self.spin_enabled)
        spin_cb.pack(side=tk.LEFT)
        self._controls.append(spin_cb)
        ttk.Label(spin_frame, text=_("转速 (度/秒):")).pack(side=tk.LEFT, padx=(12, 2))
        self.spin_speed = tk.DoubleVar(value=60.0)
        spin_sb = ttk.Spinbox(spin_frame, from_=1, to=720, increment=5, width=6,
                              textvariable=self.spin_speed)
        spin_sb.pack(side=tk.LEFT)
        self._controls.append(spin_sb)
        ToolTip(spin_cb,
                _("让水印/画中画在叠加过程中绕自身中心持续旋转（动态动画，不是单次旋转）。\n"
                "转速单位为度/秒，例如 60 = 每 6 秒转一圈（angle = 转速×π/180×t）。\n"
                "旋转后边角填充为透明（c=black@0），与现有透明/遮罩/放开边界管线兼容。\n"
                "注意：水印本身不宜过大，旋转包围盒为对角线尺寸，过大会被主画面边缘裁切。"),
                wraplength=420)

        # ---- 轨迹控制（动态水印：位置随时间循环移动） ----
        # move 字段独立持久化；命令生成时由 build_move_xy_expr 生成 x/y 表达式，
        # 不覆盖用户设置的 overlay_x/overlay_y 基准。
        self.move_mode = tk.StringVar(value="")          # "" / h / v / diamond / corners
        self.move_cycle = tk.DoubleVar(value=4.0)        # 周期（秒，往返/菱形）
        self.move_amp = tk.StringVar(value="W*0.1")     # 幅度/尺寸（可填像素或 W*0.1 相对式）
        self.move_dwell = tk.DoubleVar(value=2.0)        # 四角跳跃每点停留（秒）
        self.move_margin = tk.StringVar(value="W*0.03") # 四角跳跃边距（像素或相对式）
        self.move_waypoints = []   # 列表轨迹（move_mode=="waypoints" 时生效）
        ttk.Button(spin_frame, text=_("轨迹控制..."), command=self._open_trajectory_dialog
                   ).pack(side=tk.LEFT, padx=(16, 0))

        # ---- 静态角度旋转（自由角度）：透明层上绕中心旋转，边角透明，与文字水印旋转一致 ----
        _lbltt32 = ttk.Label(spin_frame, text=_("角度:"))
        _lbltt32.pack(side=tk.LEFT, padx=(16, 2))
        self.rotate_angle = tk.DoubleVar(value=0.0)
        rot_sb = ttk.Spinbox(spin_frame, from_=-180, to=180, increment=1, width=6,
                             textvariable=self.rotate_angle)
        rot_sb.pack(side=tk.LEFT)
        self._controls.append(rot_sb)
        ToolTip(_lbltt32,
                _("静态角度旋转（自由角度，度，支持负角）。\n"
                "与文字水印旋转一致：在透明层上绕自身中心旋转，边角填充透明(c=black@0)，\n"
                "叠加到主视频不会出现黑色裁切块。\n"
                "与「持续旋转」可叠加：先转静态角度、再持续旋转。\n"
                "注意：旋转包围盒为对角线尺寸，水印不宜过大，否则会被主画面边缘裁切。"),
                wraplength=420)


    def _edit_wp_point(self, row_idx, which, cur_x, cur_y, cur_angle, apply_xy, apply_angle, t0=0.0,
                       active_flag=None, w=None):
        """列表轨迹行的坐标可视化编辑（单框，起点/终点各一个入口按钮）。
        2026-09-02：旋转手柄拖拽经 angle_cb 写回航点 ra/rb（选起点→ra，选终点→rb）。
        t0：背景帧取帧时间（该航点自身 start / start+dur），与「位置、尺寸、旋转」关键帧一致。"""
        app = self.app
        if app is None:
            apply_xy(cur_x, cur_y)
            return
        mw = mh = None
        _mf = ""
        _bg_file = ""            # 背景帧源（封装页=主视频轨道文件，转换页=input_file）
        _bg_offset = (0, 0)      # pad 时主视频内容偏移（背景帧按此摆放）
        _bg_render_size = None   # pad 时主视频实际渲染尺寸（画布含 pad 留黑）
        _src_from_merge = False   # ⚠️ 2026-08-27 修复：主视频画布设置的来源（封装页/转换页）
        try:
            # 2026-09-23 修正：OverlayPositionFrame 不只封装页用——edit_video_settings 还把
            # 它用于转换页水印编辑器（page_scope='convert'）与队列任务水印（ctx_main_file）。
            # 主视频解析按宿主语境取「本页自己的主视频」，两页绝不互相兜底：
            #   1) ctx_main_file（队列任务编辑显式传入的 task.input）优先；
            #   2) 否则按 page_scope 取本页主视频（'merge'=封装页主视频 / 'convert'=input_file）。
            # 本页没有主视频 → 提示并退出（等价纯黑），绝不拿另一页的文件抽帧。
            if self.ctx_main_file:
                _mf = self.ctx_main_file if os.path.exists(self.ctx_main_file) else ""
                _src_from_merge = False
                _no_video_hint = _("未找到该任务的主视频文件，请确认任务输入有效")
            else:
                _pf, _unused = _page_main_video(app, self.page_scope)
                _mf = _pf or ""
                _src_from_merge = bool(_mf and os.path.exists(_mf)) and self.page_scope == "merge"
                _no_video_hint = (_("请先在封装页设置主视频后再使用可视化坐标编辑")
                                  if self.page_scope == "merge" else
                                  _("请先在转换页设置输入文件后再使用可视化坐标编辑"))
            if alert_if(not _mf, _("提示"), _no_video_hint, 'info'):
                return
            _wd, _hd = app._cached_video_dimensions(_mf)
            mw, mh = _wd, _hd
            if _src_from_merge:
                # ⚠️ 2026-08-27 修复（三连，用户拍板照抄 open_visual_overlay_editor）：
                # 封装页子视频列表轨迹坐标编辑的画布/背景帧语义与子视频位置编辑器完全一致：
                #   · 画布 = _get_canvas_size(main_track)：**pad 优先**（pad 时画布>主视频、
                #     主视频内容按 offset 摆放、超出黑色）；否则 crop→rotate→scale 渲染尺寸。
                #   · 背景帧 = main_track.file_path + main_offset + main_render_size
                #     （_generic_overlay_editor 按 offset 摆放主视频内容，超出黑色）。
                # 之前只按 merge_video 源旋转尺寸算画布，pad 场景画布/背景全错（黑边/错位）。
                try:
                    _tracks = app._get_enabled_video_tracks() if hasattr(app, "_get_enabled_video_tracks") else []
                    if _tracks:
                        _mt = _tracks[0]
                        if hasattr(app, "_get_canvas_size"):
                            _cw, _ch = app._get_canvas_size(_mt)
                            if _cw and _ch:
                                mw, mh = int(_cw), int(_ch)
                        if hasattr(app, "_get_video_render_size"):
                            _rnd = app._get_video_render_size(_mt)
                            if _rnd and _rnd[0] and _rnd[1]:
                                _bg_render_size = (int(_rnd[0]), int(_rnd[1]))
                        if _mt.enc_settings.get("pad_enabled", False):
                            try:
                                _ox = safe_eval_expr(str(_mt.enc_settings.get("offset_x", "0") or "0"),
                                                     {"W": mw, "H": mh}) or 0
                                _oy = safe_eval_expr(str(_mt.enc_settings.get("offset_y", "0") or "0"),
                                                     {"W": mw, "H": mh}) or 0
                                _bg_offset = (int(_ox), int(_oy))
                            except Exception:
                                pass
                        _bg_file = _mt.file_path
                except Exception:
                    pass
                if not _bg_file:
                    _bg_file = _mf
            else:
                # 转换页/队列：渲染画布 = 本语境主视频设置（队列=ctx_main_settings=task.settings，
                # 转换页=get_current_settings()，主视频 crop/scale/rotate 后），背景帧 = 本语境主视频。
                # ⚠️ 切勿从 self.filt_frame 读设置——OverlayPositionFrame
                # 的 filt_frame 是【子视频/水印自己】的滤镜框架（scale_width/height=子视频尺寸），
                # 上一版误用导致画布变成子视频缩放大小。正确来源：语境设置 +
                # app._main_render_size（与正式命令 _compute_output_canvas 同源）。
                _bg_file = _mf
                if getattr(app, "_main_render_size", None):
                    try:
                        if self.ctx_main_settings is not None:
                            _ms0 = (self.ctx_main_settings
                                    if isinstance(self.ctx_main_settings, dict)
                                    else dict(self.ctx_main_settings))
                        else:
                            _ms0 = app.get_current_settings() if hasattr(app, "get_current_settings") else {}
                        _rw0, _rh0 = app._main_render_size(_ms0 or {}, _mf)
                        if _rw0 and _rh0:
                            mw, mh = _rw0, _rh0
                    except Exception:
                        pass
        except Exception:
            pass
        mw = mw or 1280
        mh = mh or 720
        # ⚠️ 2026-09-11 修复（轨迹坐标编辑器尺寸取错）：
        #   原代码直接读 ff.scale_height，子视频「320宽 + 高度自动」时该值为空 → 兜底 120
        #   → 得到错误 320x120，必须先去「可视化位置窗口」确认一次把 exact 尺寸写回才正确。
        #   现改为与「可视化位置窗口」(open_visual_overlay_editor → _get_video_render_size
        #   → compute_final_size_with_order) 完全同源地解析真实渲染尺寸，「width 模式 / 高度
        #   自动」按源比例推得真实高度（如 320x569），一打开即正确。
        wm_w = wm_h = None
        ff = self.filt_frame
        # 路径①（最优）：有轨道对象时直接问 app 要渲染尺寸（含 crop→rotate→scale）
        _to0 = getattr(self, "track_obj", None)
        if _to0 is not None and hasattr(app, "_get_video_render_size"):
            try:
                _rnd0 = app._get_video_render_size(_to0, None)
                if _rnd0 and _rnd0[0] and _rnd0[1]:
                    wm_w, wm_h = int(_rnd0[0]), int(_rnd0[1])
            except Exception:
                wm_w = wm_h = None
        # 路径②（兜底同源）：用 filt_frame 设置 + 子视频源文件比例自算
        if (not wm_w or not wm_h) and ff is not None:
            _sub_f = ""
            try:
                _sub_f = (getattr(ff, "current_file", "") or "").strip()
            except Exception:
                _sub_f = ""
            if not _sub_f:
                # 二级来源：filt_frame 绑定的轨道对象（set_track 时会带 file_path）
                try:
                    _ct = getattr(ff, "current_track", None)
                    if _ct is not None:
                        _sub_f = (getattr(_ct, "file_path", "") or "").strip()
                except Exception:
                    pass
            if not _sub_f:
                # 三级来源：本框自己的 track_obj（部分调用点会传，防未来构造点变化）
                try:
                    _to2 = getattr(self, "track_obj", None)
                    if _to2 is not None:
                        _sub_f = (getattr(_to2, "file_path", "") or "").strip()
                except Exception:
                    pass
            if _sub_f and os.path.exists(_sub_f):
                try:
                    _settings = {
                        "crop_enabled": ff.crop_enabled.get(),
                        "crop_width": ff.crop_width.get(),
                        "crop_height": ff.crop_height.get(),
                        "scale_enabled": ff.scale_enabled.get(),
                        "scale_method": ff.scale_method.get(),
                        "scale_width": ff.scale_width.get(),
                        "scale_height": ff.scale_height.get(),
                        "rotate": ff.rotate.get(),
                    }
                    _sw, _sh = app._cached_video_dimensions(_sub_f)
                    if _sw and _sh:
                        _fw, _fh = app.compute_final_size_with_order(int(_sw), int(_sh), _settings)
                        if _fw and _fh:
                            wm_w, wm_h = int(_fw), int(_fh)
                except Exception:
                    wm_w = wm_h = None
        if not wm_w or not wm_h:
            # 兜底：直接读 filt_frame 控件（scale_width / scale_height）。⚠️ 若 width 模式
            # 且高度为空，仍需按比例推高，否则会退回错误 320x120（用户原始问题）。
            wm_w = wm_h = 120
            if ff is not None:
                with suppress(Exception):
                    wm_w = int(float(ff.scale_width.get() or 0) or wm_w)
                try:
                    wm_h = int(float(ff.scale_height.get() or 0) or 0) or 0
                except Exception:
                    wm_h = 0
                if not wm_h:
                    # 高度自动：取子视频源比例（width→高、height→宽）
                    try:
                        _m = ff.scale_method.get()
                    except Exception:
                        _m = "width"
                    try:
                        _cf = (getattr(ff, "current_file", "") or "").strip()
                        _sw2, _sh2 = app._cached_video_dimensions(_cf) if _cf else (None, None)
                        if _sw2 and _sh2:
                            if _m == "width":
                                # 宽已定，按源比例推高
                                wm_h = max(1, int(round(wm_w * _sh2 / _sw2)))
                            elif _m == "height":
                                _hh = int(float(ff.scale_height.get() or 0) or 0)
                                if _hh > 0:
                                    wm_w = max(1, int(round(_hh * _sw2 / _sh2)))
                                    wm_h = _hh
                    except Exception:
                        pass
                # 仍推不出高度 → 回退安全值 120（不得留 0，否则编辑器盒子高度为 0）
                if not wm_h:
                    wm_h = 120
        # 背景帧预处理：主视频 crop/rotate（防「渲染尺寸画布+完整原帧=变形」，2026-08-28）
        _bg_filter = None
        try:
            if _src_from_merge:
                _gt = getattr(app, "_get_enabled_video_tracks", None)
                if _gt:
                    _t0 = _gt()
                    if _t0:
                        _bg_filter = _main_bg_pre_filter(_t0[0].enc_settings)
            else:
                _ms0 = app.get_current_settings() if hasattr(app, "get_current_settings") else None
                if _ms0:
                    _bg_filter = _main_bg_pre_filter(_ms0)
        except Exception:
            _bg_filter = None
        vx = tk.StringVar(value=f"{int(round(cur_x)):d}")
        vy = tk.StringVar(value=f"{int(round(cur_y)):d}")
        def _wp_on_apply(nx, ny, nw, nh, ncw, nch):
            # 2026-09-14 改（起点/终点各存各的大小）：重绘/缩放 → 按【当前活动端】写回
            # 该端缩放倍率 sa/sb，不再改全局 scale_width/height。
            #   基准尺寸 wm_w/wm_h 是「子视频整体渲染尺寸」，sa/sb 是相对它的倍率（滤镜侧
            #   build_waypoint_expr 的 zoom 每段线性插值，默认 1.0 → 旧工程行为不变）。
            #   整体基准尺寸的设定权交给「可视化位置窗口」(open_visual_overlay_editor)：
            #   本窗口只调该端相对大小，故重绘不再污染全局尺寸（原「Alt 重绘统一两端」根因）。
            vx.set(str(int(round(nx)))); vy.set(str(int(round(ny))))
            # 坐标顺带落盘 + 刷新列表（列表「起始/结尾缩放」两列随之立即更新）。
            # 与 on_drag_commit 同一函数（_open_editor 的 _apply_xy：按活动端写 xa/ya|xb/yb + _refresh）。
            try:
                apply_xy(float(nx), float(ny))
            except (ValueError, TypeError):
                pass
            _ns = None
            if (w is not None) and (active_flag is not None) and wm_w:
                try:
                    _ns = float(nw) / float(wm_w)
                except (TypeError, ValueError, ZeroDivisionError):
                    _ns = None
                if _ns and _ns > 0:
                    with suppress(Exception):
                        if w.get("mode") == "end":
                            # 终点行：无独立结尾端（_se_can=False）→ sa/sb 同值，
                            # 与 _apply_angle 的 ra/rb 同值策略一致。
                            w["sa"] = _ns
                            w["sb"] = _ns
                        elif active_flag[0] == "end":
                            w["sb"] = _ns
                        else:
                            w["sa"] = _ns
            # 刷新命令预览（转换页 update_command_preview / 封装页 merge_update_command_preview）：
            # sa/sb 变化即 zoom 表达式变化，必须重生成命令串。
            _app = self.app
            if _app is not None:
                for _m in ("update_command_preview", "merge_update_command_preview"):
                    _rf = getattr(_app, _m, None)
                    if _rf is not None:
                        with suppress(Exception):
                            _rf()
            with suppress(Exception):
                self.app._append_info_ui(
                    _('[轨迹] 该端尺寸已更新: {0}x{1}').format(nw, nh)
                    + (_('（缩放倍率 {0:.4g}）').format(_ns) if _ns else ""))
        # 起始/结尾双端（条件调用）：仅当调用方传入 w + active_flag 时启用
        # （active_flag 由 _open_editor 的 _active 可变列表提供，翻转即切写回目标端）
        start_end = None
        if w is not None and active_flag is not None:
            _se_can = (w.get("mode") != "end")   # 2026-09-12 修复：按数据模型判定——坐标相等(如粘贴连通)≠无第二端；仅终点行(mode=end)无独立结尾
            def _se_scale(key):
                # 2026-09-14：安全取该端缩放倍率（缺省/非法/非正 → 1.0=基准尺寸，旧工程行为不变）
                _s = _opt_float(w.get(key, 1.0) or 1.0, 1.0)
                return _s if _s > 0 else 1.0
            def _se_read(end):
                # 2026-09-14 修复（起点/终点尺寸被「统一成最新大小」）：
                #   尺寸按【端点】返回各自缩放后的内容盒 —— wm_w/wm_h=全局基准尺寸，
                #   sa/sb=该端缩放倍率。切换端点时尺寸随之改变，与角度 ra/rb 对称。
                #   原实现两端都返回同一个 wm_w/wm_h → 切端尺寸恒等；配合 _wp_on_apply
                #   写全局尺寸 → Alt 重绘一次就把两端统一（用户实测根因）。
                #   倍率取整到像素：sa = round(wm_w*sa)/wm_w，反复开关会收敛到稳定点，不累积漂移。
                # 🔴 2026-10-17（用户第 1 条）：角度同样按「静态 + 该端 ra/rb」合成返回 ——
                #   否则在本窗口里切「起始/结尾」端会把静态角度丢掉（看到的就是没转的框）。
                if end == "end":
                    _sk = _se_scale("sb")
                    return (w.get("xb", 0), w.get("yb", 0),
                            int(round(wm_w * _sk)), int(round(wm_h * _sk)),
                            float(w.get("rb", 0) or 0.0) + _mat_ang)
                _sk = _se_scale("sa")
                return (w.get("xa", 0), w.get("ya", 0),
                        int(round(wm_w * _sk)), int(round(wm_h * _sk)),
                        float(w.get("ra", 0) or 0.0) + _mat_ang)
            def _se_switch(end):
                active_flag[0] = end
            def _se_time(end):
                # 2026-10-05：两端各取各的时刻 —— 起点端=start，结尾端=start+dur。
                # 位置编辑器据此换背景帧/内容帧，否则两端画面一模一样，看不出这一段的运动。
                _st = _opt_float(w.get("start", 0.0) or 0.0, 0.0)
                if end == "end":
                    return _st + _opt_float(w.get("dur", 0.0) or 0.0, 0.0)
                return _st
            start_end = {"active": ("end" if active_flag[0] == "end" else "start"),
                         "read": _se_read, "on_switch": _se_switch, "can_compare": _se_can,
                         "time": _se_time}
        # 2026-09-14：初始矩形=当前活动端缩放后的实际内容盒（否则滑块初始恒显 100%，
        # 与该端真实倍率不一致；切到另一端时尺寸由 start_end["read"](_se_read) 重载）。
        _init_s = 1.0
        if (w is not None) and (active_flag is not None):
            _init_s = _opt_float(w.get("sb" if active_flag[0] == "end" else "sa", 1.0) or 1.0, 1.0)
            if _init_s <= 0:
                _init_s = 1.0
        # 2026-10-05：**框内要渲染子视频本尊那一帧**（透明叠在背景真实帧上）。
        # 只靠 draw_diagonal=False 的话，框内透出的是**主视频**背景画面（底下的那一层），
        # 而不是被摆上去的子视频 —— 用户要的是后者（「框里的内容」= 这个素材自己）。
        # ⚠️ 上面尺寸走路径①（track_obj 渲染尺寸）时 _sub_f 压根不会赋值 ⇒ 这里独立再解析一次。
        _sub_f = ""
        try:
            _sub_f = (getattr(ff, "current_file", "") or "").strip()
        except Exception:
            _sub_f = ""
        if not _sub_f:
            with suppress(Exception):
                _ct = getattr(ff, "current_track", None)
                if _ct is not None:
                    _sub_f = (getattr(_ct, "file_path", "") or "").strip()
        if not _sub_f:
            with suppress(Exception):
                _to2 = getattr(self, "track_obj", None)
                if _to2 is not None:
                    _sub_f = (getattr(_to2, "file_path", "") or "").strip()
        if _sub_f and not os.path.exists(_sub_f):
            _sub_f = ""
        # 2026-10-11：子视频绿幕设置源 = 子视频轨 enc_settings（与成片 sub_settings 同源：
        #   _build_sub_layer_command 用 sv.enc_settings.copy()）。OverlayPositionFrame.get_settings()
        #   不含 chroma_enabled（那是 LoopChromaFrame 的字段）⇒ 用它恒得缺省 False、预览无绿幕。
        _chroma_src = None
        for _cand in (getattr(self, "track_obj", None),
                      getattr(ff, "current_track", None)):
            if _cand is not None and hasattr(_cand, "enc_settings"):
                _chroma_src = _cand.enc_settings
                break
        # 🔴 2026-10-16（用户第 1/2 条）：**组父行语境**框内内容 = **组内合成画面**，
        #   不是组内主自己那一帧；且**拖动矩形 = 包装盒尺寸**，不是组内主渲染尺寸。
        #   病根：上面 `_sub_f` 取的是 `ff.current_file` / `track_obj.file_path`，而组父行窗
        #   的 `track_obj` 是**组内主**（`_node_label_track` 对组节点返回组内主）⇒ 框里
        #   显示组内主画面被拉伸成整只大盒、矩形也是组内主大小。
        #   ▸ 2026-10-16 收敛：改问**素材语境唯一解析器** `resolve_material_ctx` ——
        #     group_box ⇒ 合成帧 PNG + 盒尺寸（`size`）；node ⇒ 节点取帧器；plain ⇒ None。
        _ctx = app.resolve_material_ctx(ff)
        _gc_png = _ctx.frame_png if _ctx is not None else None
        # 🔴 2026-10-17（用户：「除了文字水印真实帧，其它一律不落盘」）：优先**内存字节**
        _gc_ppm = getattr(_ctx, "frame_ppm", None) if _ctx is not None else None
        _gc_w = _gc_h = None
        # 🔴 2026-10-17（用户第 1 条：**外面位置编辑器的缩放 / 角度必须和这里联通**）：
        #   父行 = 独立素材 ⇒ 位置编辑器把「缩放」写进 `node_fx[key]`（`node_material_chain`
        #   渲染成 scale=）、把「角度」写 `rotate_angle` ＋ 组级 `grp_rot_angle`（Stage B 的
        #   组节点 rotate）。而这里原先用 **包装盒原始尺寸 + 航点自己的 sa/sb、ra/rb** ⇒
        #   显示的永远是「没缩放、没转过的盒」，用户感知就是「这里只能控移动，大小和角度被
        #   外面定死了」。正常子视频之所以是"联通"的，就因为基准取自**同一份** enc_settings。
        #   ⇒ 这里同样以「已应用静态缩放的盒」为基准（唯一出处 `_group_material_scaled_size`，
        #     与 export 侧的 `_last_group_material_size` 同源），静态角度按「加法」合成显示、
        #     写回时扣掉（渲染链恰好也是 静态 → 航点增量 的顺序）。
        _mat_ang = 0.0
        if _ctx is not None and _ctx.kind == "group_box" and _ctx.size[0]:
            _key0 = getattr(ff, "group_fx_key_edit", None)
            _base_sz = _ctx.size
            try:
                _sc0 = (app._group_material_scaled_size(_ctx.size, _key0)
                        if _key0 else None)
            except Exception:
                _sc0 = None
            if _sc0 and _sc0[0] and _sc0[1]:
                _base_sz = _sc0
            # ⚠️ 尺寸与合成图解耦 —— 即使合成图没取到，尺寸也必须是（静态缩放后的）盒尺寸。
            _gc_w, _gc_h = float(_base_sz[0]), float(_base_sz[1])
            wm_w, wm_h = int(_base_sz[0]), int(_base_sz[1])
            # 静态角度：**优先读组级字段**（位置编辑器刚写进去、可能还没保存），
            # 没有才回落到素材项（上次保存的 rotate_angle）—— 两处本来就是同时写的。
            _ang0 = None
            try:
                _gbt = app._merge_group_base_track(
                    getattr(self, "track_obj", None), app._get_enabled_video_tracks())
                if _gbt is not None:
                    _ang0 = (getattr(_gbt, "enc_settings", None) or {}).get("grp_rot_angle")
            except Exception:
                _ang0 = None
            if _ang0 is None:
                try:
                    _it0 = app._group_material_item(_key0) if _key0 else None
                    if isinstance(_it0, dict):
                        _ang0 = _it0.get("rotate_angle")
                except Exception:
                    _ang0 = None
            try:
                _mat_ang = float(_ang0 or 0.0)
            except (TypeError, ValueError):
                _mat_ang = 0.0
        app.open_watermark_overlay_editor(
            mw, mh, max(int(round(wm_w * _init_s)), 10), max(int(round(wm_h * _init_s)), 10), vx, vy,
            # 2026-09-14：内容源=全局基准尺寸 → 启用「缩放 (倍率)」滑块（100%=当前基准尺寸，
            # 与「位置、尺寸、旋转」画布编辑器同口径）。重绘/滑块 → 按端写 sa/sb（见 _wp_on_apply）。
            # 🔴 2026-10-16（用户第 1/3 条）：组父行语境 content 换成**组合成画面** ⇒ 基准尺寸
            #   同步改用**包装盒尺寸**（否则「合成图」被按组内主尺寸再拉伸一次）。缺回落原值。
            content_src_w=(_gc_w if _gc_w else wm_w), content_src_h=(_gc_h if _gc_h else wm_h),
            scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
            watermark_dict=None, filt_frame=None, parent=self.winfo_toplevel(),
            # 2026-09-12 修复：原先硬编码 False → 面板上勾了「放开边界」，轨迹列表里
            # 起始/结尾坐标编辑器仍是收边版本（拖不出主画面、不能比主视频大），勾选形同无效。
            # 与主 可视化编辑坐标 入口（_create_sub_controls 内 open_visual_overlay_editor）同口径。
            free_layout=bool(getattr(self, "overlay_free_layout", None)
                             and self.overlay_free_layout.get()),
            main_video_file=_bg_file,
            main_offset=_bg_offset, main_render_size=_bg_render_size,
            bg_pre_filter=_bg_filter,
            # 2026-10-05：框内内容帧 = 子视频文件自己（透明模式，见 content_alpha）。
            # 时刻与背景帧同一 t0（该航点 start / start+dur）；切端时由 start_end["time"]
            # 换到另一端的时刻，并走按端缓存 ⇒ 两端画面不同，能看出这一段的运动。
            # 🔴 2026-10-16（用户第 1/3 条）：**组父行语境**改用**组内合成画面**（`_gc_png`）
            #   + 包装盒尺寸；合成图里抠像/叠加都已算完 ⇒ chroma 传 None（否则二次抠像）。
            #   生成失败（_gc_png=None）⇒ 逐字节回落旧行为（组内主文件 + 原尺寸 + chroma）。
            content_file=((_gc_png or _sub_f) or None),
            # 🔴 2026-10-17：有内存字节就用字节（**零磁盘**），`content_file` 只作兜底。
            content_ppm=_gc_ppm,
            content_chroma_settings=(None if (_gc_png or _gc_ppm) else _chroma_src),   # 2026-10-11：子视频绿幕接入真实帧（子视频轨 enc_settings）
            content_time=t0,
            content_alpha=bool((_gc_png or _gc_ppm) or _sub_f),
            # 🔴 2026-10-17（用户第 1 条）：合成显示 = 静态角度（位置编辑器）+ 航点 ra/rb，
            #   写回时扣掉静态部分 ⇒ 渲染链的「静态 rotate + 航点 rotate」加法顺序不被破坏。
            #   (`_se_read` 同步加了静态分量，保证本窗口内「切起始/结尾端」也不丢。)
            init_angle=((cur_angle or 0.0) + _mat_ang),
            angle_cb=((lambda _na: apply_angle(float(_na or 0.0) - _mat_ang))
                      if _mat_ang else apply_angle),   # 2026-09-02：旋转手柄拖拽 → 写回航点 ra/rb
            on_apply=_wp_on_apply,  # 2026-09-14：重绘/缩放 → 按端写回缩放倍率 sa/sb 并刷新
            on_drag_commit=apply_xy,  # 2026-09-03：拖拽松手即把坐标写回航点并实时刷新列表
            initial_time=t0,        # 背景帧=该航点自身时间（起始/结尾），与位置尺寸旋转列表一致
            # 2026-10-05：**虚拟框内部改为真实帧**——默认 draw_diagonal=True 会给矩形填
            # gray50 斜纹，正好把背景真实帧盖住 ⇒ 看到的还是「灰斜纹虚拟框」。
            # False = 仅描边（fill=""）⇒ 框内透明，直接透出主视频该时刻的真实画面，
            # 只留红/蓝边框 ⇒ 位置由画面本身反映，不必再开第二个预览窗。
            draw_diagonal=False,
            coord_box=True,
            start_end=start_end)
        try:
            apply_xy(float(vx.get()), float(vy.get()))
        except (ValueError, TypeError):
            pass

    def _open_trajectory_dialog(self):
        """轨迹控制弹窗：预设动效 + 列表轨迹（与文字水印共用公共实现 _trajectory_dialog）。"""
        _vf = ""
        _ffm = _fprobe = None
        if self.app is not None:
            try:
                # 2026-09-23 修正：按宿主语境取本页主视频（转换页水印编辑器/队列任务也会
                # 实例化本组件），绝不跨页兜底：队列=ctx_main_file（任务输入）优先，
                # 否则 page_scope（'merge'=封装页 / 'convert'=转换页 input_file）。
                if self.ctx_main_file and os.path.exists(self.ctx_main_file):
                    _vf = self.ctx_main_file
                else:
                    _pf, _unused = _page_main_video(self.app, self.page_scope)
                    _vf = _pf or ""
            except Exception:
                _vf = ""
            _ffm = getattr(self.app, "ffmpeg_cmd", None)
            _fprobe = getattr(self.app, "ffprobe_cmd", None)

        # #1 管道入口（2026-10-08）：列表轨迹窗口的「时间预览」改走**完整管道合成预览**
        # （ffmpeg -filter_complex → rawvideo，实时反映滤镜/水印/子视频按轨迹移动的合成），
        # 复用 app 既有管道入口，不另起一套。判定收进 `_traj_pipe_preview`（与文字水印宿主
        # 共用，避免两处各写一份判据）：
        #   · 封装页 → `_live_preview_pipe`（按 串行合并 / 画中画 / 单轨 自动分派同一套合成图）；
        #   · 转换页 → `_time_preview_pipe_current`（当前设置的合成图）；
        #   · 语境主视频不属于本页（队列任务编辑 ctx_main_file=task.input）→ 返回 False，
        #     回退普通简易预览 = 旧行为（管道入口只认本页主视频，取不到任务文件）。
        def _pipe_preview(_kw):
            # #5（2026-10-08）：声明「弹窗里未提交的航点属于**哪个目标**」——图里可能同时有
            # 主视频 / 各子视频 / 文字水印三处轨迹，不声明身份就会串味（用户实测：从文字水印
            # 轨迹窗开预览，子视频被套上了文字的列表轨迹）。判据见 _live_wp_target。
            #   有轨对象（封装页主视频/子视频设置页）→ 按对象身份；无轨对象但 mode='sub'
            #   （转换页图片/视频水印编辑器）→ settings["watermark"]；其余 → 该层自身。
            if isinstance(_kw, dict):
                if getattr(self, "track_obj", None) is not None:
                    _kw["_wp_target"] = ("track", self.track_obj)
                elif getattr(self, "mode", "") == "sub":
                    _kw["_wp_target"] = ("wm", None)
                else:
                    _kw["_wp_target"] = ("layer", None)
            return _traj_pipe_preview(self.app, getattr(self, "page_scope", None), _vf, _kw)

        _trajectory_dialog(
            self,
            {"move_mode": self.move_mode.get(),
             "move_cycle": self.move_cycle.get(),
             "move_dwell": self.move_dwell.get(),
             "move_margin": self.move_margin.get(),
             "move_waypoints": self.move_waypoints},
            lambda v: (self.move_mode.set(v["move_mode"]),
                       self.move_cycle.set(v["move_cycle"]),
                       self.move_dwell.set(v["move_dwell"]),
                       self.move_margin.set(v["move_margin"]),
                       list(v["move_waypoints"]) if v.get("move_waypoints") is not None else None),
            edit_cb=self._edit_wp_point,
            canvas_w=1280, canvas_h=720,
            video_file=_vf, ffmpeg_cmd=_ffm, ffprobe_cmd=_fprobe,
            app=self.app, pipe_preview_cb=_pipe_preview)

    def _create_main_controls(self):
        """主视频画布偏移控件 - 左右分栏（左侧偏移设置，右侧快捷操作）"""
        # 主容器：水平分割
        main_container = ttk.Frame(self)
        main_container.pack(fill=tk.BOTH, expand=True)
    
        # ---------- 左容器：偏移设置 ----------
        left_frame = ttk.Frame(main_container)
        left_frame.pack(side=tk.LEFT, fill=tk.Y, expand=False)
    
        self.pad_enabled = tk.BooleanVar(value=False)
        cb = ttk.Checkbutton(left_frame, text=_("启用画布偏移"), variable=self.pad_enabled)
        cb.pack(anchor=tk.W, pady=(0,5))
        self._controls.append(cb)
    
        w_frame = ttk.Frame(left_frame)
        w_frame.pack(fill=tk.X, pady=2)
        ttk.Label(w_frame, text=_("画布宽度:")).pack(side=tk.LEFT)
        self.pad_width = tk.StringVar(value="")
        entry = ttk.Entry(w_frame, textvariable=self.pad_width, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([w_frame, entry])
    
        if self.app:
            def fetch_size():
                # 2026-09-23：按宿主页取本页主视频（不跨页兜底，拿到另一页的视频尺寸）；
                # 画布偏移控件只出现在封装页轨道设置 → page_scope 恒为 'merge'。
                main_file, _unused = _page_main_video(self.app, self.page_scope)
                main_file = main_file or ""
                if alert_if(not main_file or not os.path.exists(main_file), _("错误"), _("未找到主视频文件，请先在封装页设置主视频"), 'error'):
                    return
                w, h = self.app._get_video_dimensions_cached(main_file)
                if w is not None and h is not None:
                    self.pad_width.set(str(w))
                    self.pad_height.set(str(h))
                    self.app._append_info_ui(_('[尺寸获取] 获取到主视频尺寸: {0}x{1}').format(w, h))
                else:
                    messagebox.showerror(_("错误"), _('无法获取视频尺寸，请检查 ffprobe 是否可用或文件是否正常。'))
            btn = ttk.Button(w_frame, text=_("获取尺寸"), command=fetch_size)
            btn.pack(side=tk.LEFT, padx=5)
            self._controls.append(btn)
    
        h_frame = ttk.Frame(left_frame)
        h_frame.pack(fill=tk.X, pady=2)
        ttk.Label(h_frame, text=_("画布高度:")).pack(side=tk.LEFT)
        self.pad_height = tk.StringVar(value="")
        entry = ttk.Entry(h_frame, textvariable=self.pad_height, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([h_frame, entry])
    
        ox_frame = ttk.Frame(left_frame)
        ox_frame.pack(fill=tk.X, pady=2)
        ttk.Label(ox_frame, text=_("偏移 X:")).pack(side=tk.LEFT)
        self.offset_x = tk.StringVar(value="0")
        entry = ttk.Entry(ox_frame, textvariable=self.offset_x, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([ox_frame, entry])
    
        oy_frame = ttk.Frame(left_frame)
        oy_frame.pack(fill=tk.X, pady=2)
        ttk.Label(oy_frame, text=_("偏移 Y:")).pack(side=tk.LEFT)
        self.offset_y = tk.StringVar(value="0")
        entry = ttk.Entry(oy_frame, textvariable=self.offset_y, width=10)
        entry.pack(side=tk.LEFT, padx=5)
        self._controls.extend([oy_frame, entry])
    
        def open_pad_editor():
            if alert_if(not self.pad_enabled.get(), _("提示"), _("请先勾选「启用画布偏移」再使用可视化编辑功能。"), 'info'):
                return
            if self.pad_visual_callback is not None:
                # 无轨宿主（命令编辑器）：把活控件的四项值原样交给宿主（2026-10-16）。
                # 仍然保留上面「先勾选启用」的门槛 —— 文本世界里它 = 「我要给这条链加 pad」。
                self.pad_visual_callback(self.pad_width.get(), self.pad_height.get(),
                                         self.offset_x.get(), self.offset_y.get())
            elif self.app and self.track_idx is not None:
                parent_win = self.winfo_toplevel()
