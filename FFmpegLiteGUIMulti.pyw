                                                     #   手柄改的是编辑器几何 current_angle（正转角 R(+θ)），
                                                     #   本滑块改的是调用方数据（遮罩 shape rot，其 geq/轮廓是
                                                     #   R(−θ) 逆时针）——语义不同，刻意不复用手柄（用户拍板：
                                                     #   复用会在后期排查时混淆）。None=不创建。
                                content_ppm=None,    # 🔴 2026-10-17（用户：「除了文字水印真实帧，其它都别落盘，
                                                     #   能在内存就都内存」）：**内容帧的 PPM 字节**（已解码）。
                                                     #   给了它 ⇒ 内容帧**不碰磁盘**（既不 seek 源文件、也不写
                                                     #   临时文件），直接把字节喂给后续 ffmpeg 管道。
                                                     #   与 `content_file` 二选一：**本参数优先**；都不给 = 旧
                                                     #   行为（虚线框）。静态快捷键退出同理。
        ):
        """
        通用叠加/偏移可视化编辑器（核心重构函数）
        
        支持三种主要使用模式：
        
        1. 主视频画布偏移（pad）模式
           - allow_negative_offset=True
           - rect_color='deepskyblue'
           - show_canvas_controls=True（允许调整画布尺寸）
           - 允许矩形超出画布（负偏移）
           - 用于调整主视频内容在更大画布中的位置
        
        2. 子视频/画中画叠加模式
           - allow_negative_offset=False（默认）
           - rect_color='red'
           - allow_resize=True（支持绘制新矩形调整大小）
           - 矩形必须限制在画布内
           - 用于调整画中画、水印等子视频的位置和大小
        
        3. 水印专用模式（通过 open_watermark_overlay_editor 调用）
           - 与子视频模式类似，但额外支持回写缩放尺寸到滤镜框架和 watermark_dict
        
        参数说明：
            on_apply: 回调函数，签名 on_apply(new_x, new_y, new_w, new_h, new_canvas_w, new_canvas_h)
            bg_draw_func: 可选，背景绘制回调，用于画其他子视频的虚线框
            aspect_ratio: 绘制新矩形时是否强制保持宽高比（水印/叠加常用）
            coord_mode: 'top_left'（左上角坐标）或 'offset'（偏移量）
        """
        # 解析 App 引用：本函数既被 AdvancedFrame(self.app 存在) 调用，
        # 也被 FFmpegBatchGUI(self 即 App 本体，无 .app 属性) 调用，故统一用 getattr 兼容
        if title is None:
            title = _("可视化编辑位置")
        app = getattr(self, 'app', self)

        # ---- 放开边界开关（2026-10-05）：编辑器内实时切换，省去返回上一层 ----
        # free_layout_var 由调用方传入（如 OverlayPositionFrame.overlay_free_layout）则双向同步；
        # 未传则内部自管一个 BooleanVar。_allow_neg 是可变容器，让复选框能实时翻转
        # allow_negative_offset（闭包参数本身不可 nonlocal 重绑，clamp_rect/reset_position 改读它）。
        _free_var = free_layout_var if free_layout_var is not None else tk.BooleanVar(
            value=bool(allow_negative_offset))
        _allow_neg = [_free_var.get()]

        # ---- 「框内真实帧」总开关（2026-10-05，读「更多设置 → 预览窗口」）----
        # 开（默认）：content_alpha/content_rgba 照旧渲染真实帧/真实文字。
        # 关：回退成**红蓝虚拟框**——矩形内填斜纹、隐藏内容图，且不再跑 ffmpeg 取帧/合成
        #      （省性能 + 彻底无闪烁）。用可变容器 _real_frame[0] 供内部各函数实时读。
        # ⚠️ 读取时兜底 True：拿不到 app（如纯函数式调用/测试）时保持"显示真实帧"的旧行为。
        _real_frame = [True]
        with suppress(Exception):
            _rf_var = getattr(app, "editor_real_frame", None)
            if _rf_var is not None:
                _real_frame[0] = bool(_rf_var.get())

        # ---- 窗口级「真实帧」临时开关（2026-10-05）----
        # 与上面的全局总开关**解耦**：它只改本窗口的 `_real_frame[0]`，关窗即丢弃、
        # 绝不写回全局/父级变量。初始态 = 全局总开关的当前值（本窗口的"默认"）。
        _local_real_frame = tk.BooleanVar(value=bool(_real_frame[0]))
        _real_frame[0] = bool(_local_real_frame.get())

        # ---- 内容源是否可用（2026-10-17 修）----
        # 🔴 组盒模式下调用方只给 **内存字节** `content_ppm`（`content_file` 刻意留 None，
        #    「除了文字水印真实帧其它一律不落盘」），而下面两处门控此前**只认 content_file**：
        #      · `_schedule_content_render` 开头 `if not content_file: return` ⇒ 内容帧
        #        **永远不会被调度渲染**（框内一片黑）；
        #      · 右栏「真实帧」按钮 `if content_file:` ⇒ 按钮压根不出现（用户报障入口）。
        #    ⇒ 门控必须同时认 `content_ppm`（`_fetch_raw_frame` 早已优先吃它）。
        _content_ppm_ok = (isinstance(content_ppm, (bytes, bytearray))
                           and len(content_ppm) > 16)
        _has_content_src = bool(content_file) or _content_ppm_ok

        # ---- 辅助灰边像素宽（2026-09-12 参数化 + 自适应）----
        # 平时 RK_PAD(=10)；「起始 / 结尾」类窗口（start_end 非 None）自动用 RK_PAD_WIDE(=20)。
        # ⚠️ 灰边不要给太大：图像区之外本来就不绘制任何东西（矩形/幽灵都被钳在图像区内），
        #    灰边给多了纯浪费屏幕（2026-09-12 用户实测：50 太大 → 20）。
        # 调用方传 pad=<int> 可显式覆盖（None=自适应）。PAD 用于画布尺寸与坐标换算。
        PAD = int(pad) if pad is not None else (RK_PAD_WIDE if start_end is not None else RK_PAD)

        # ---- 非活动端幽灵框颜色（2026-09-12）----
        # 显式 ghost_color 优先；否则「起始/结尾」双端窗口用互补青色，其余窗口沿用 rect_color
        # （= 与改动前逐像素一致，PiP/水印/主视频偏移/画布等窗口零变化）。
        GHOST_COLOR = ghost_color or (RK_SE_GHOST_COLOR if start_end is not None else rect_color)

        # ---- 目标显示区（2026-09-12 立，2026-09-23 全量放开）----
        # 参照可视化裁剪窗口 open_crop_editor 的画布可用区（画布约占屏幕 90%）：
        #   · 本窗口「图像区 + 2*PAD 灰边」总量 = 裁剪窗口的画布区；
        #   · 于是图像区比裁剪窗口少 2*PAD（PAD=20 → 少 40；PAD=10 → 少 20）。
        # 2026-09-23 用户拍板：全部窗口（含 PiP/水印/文字水印/主视频偏移/遮罩单块等
        # 非双端入口）统一走此口径，废除旧 800×600 上限——大画布预览精度提升，
        # 窗口最终仍被 0.95/0.94 屏幕钳制（见函数尾 geometry）。
        RIGHT_PANEL_WIDTH = 320   # 控件右栏定宽（照可视化裁剪窗口 RIGHT_PANEL_WIDTH 思路）
        try:
            _scr_w = parent.winfo_screenwidth()
            _scr_h = parent.winfo_screenheight()
        except Exception:
            _scr_w, _scr_h = 1280, 800
        # 与 open_crop_editor 同口径：RIGHT_PANEL 280 + 间隔 20 + PADDING*2 → 宽减 320；
        # EXTRA_HEIGHT 10 + PADDING*2 → 高减 30。
        _crop_avail_w = int(_scr_w * 0.9) - 320
        _crop_avail_h = int(_scr_h * 0.9) - 30
        max_display_w = max(320, _crop_avail_w - 2 * PAD)
        max_display_h = max(240, _crop_avail_h - 2 * PAD)

        # ---- 主视频背景帧（可选）状态 ----
        bg_file = main_video_file

        # ---- SAR（非方形像素）显示拉伸（2026-09-07）：HandBrake crop 等会写 SAR
        # 保住源显示比例，播放器把编码 1080x1080 拉成 1080x1920 显示。坐标空间仍是
        # 画布编码像素；预览按播放显示比例拉伸，to_canvas/to_real 拆 x/y 双因子反算。
        # 正常文件（SAR=1:1 或读取失败）_sar_pair=None，一切与旧逻辑完全一致。----
        _sar_pair = None
        _sar_note = ""
        if bg_file and os.path.exists(bg_file):
            try:
                _sar_pair = get_video_pixel_aspect(app.ffprobe_cmd, bg_file)
            except Exception:
                _sar_pair = None
            # 主视频链含 90°/270° 旋转（transpose）时画面坐标轴已转，拉伸轴随之交换
            # （画布是旋转后空间；不交换则竖拉/横拉方向与播放器相反——实测 transpose
            # 会交换 SAR 而 crop 保留，见 _sar_effective_after_prefilter）
            _sar_pair = _sar_effective_after_prefilter(_sar_pair, bg_pre_filter)
            if _sar_pair is not None:
                _sn, _sd = _sar_pair
                _sar_note = _(' (SAR {0}:{1} 拉伸预览)').format(_sn, _sd)

        def _sar_stretch(cw, ch):
            """画布编码尺寸 → 播放显示几何（SAR 拉伸；方形像素原样返回）"""
            if not _sar_pair:
                return cw, ch
            _sn, _sd = _sar_pair
            if _sd > _sn:
                return cw, max(1, int(round(ch * _sd / _sn)))
            return max(1, int(round(cw * _sn / _sd))), ch

        _sar_fw, _sar_fh = _sar_stretch(canvas_w, canvas_h)
        # allow_upscale=True（遮罩）：画布小于显示区时放大显示（解除 1.0 钳制）——
        # 画布=子视频缩放后尺寸（语义要求，坐标必须落在最终渲染帧），子视频当水印
        # 缩小后画布只有几百像素，1.0 钳制会让帧显示极小。坐标换算 scale_x/y 按
        # 显示/编码反推，>1 同样成立；背景帧按显示尺寸从原文件提取，反而更清晰。
        scale = min(max_display_w / _sar_fw, max_display_h / _sar_fh)
        if not allow_upscale:
            scale = min(scale, 1.0)
        disp_w = int(_sar_fw * scale)
        disp_h = int(_sar_fh * scale)
        # x/y 因子均为「显示 px / 编码 px」（to_canvas 乘、to_real 除），恒从 disp/canvas 反推。
        # ⚠️ 不可直接用 scale 当 x 因子：scale 按显示几何(_sar_fw/_sar_fh)算出，竖向拉伸时
        # _sar_fw==canvas_w 故碰巧相等，横向拉伸（SAR 随 transpose 换轴，2026-09-07 修复）
        # 时 x 因子=disp_w/canvas_w≠scale——背景帧按 scale 提取会整体压窄、画布右侧留黑边，
        # 矩形 x 坐标换算同样错。正常文件 scale_x == scale_y == scale（等比，行为不变）。
        scale_x = disp_w / canvas_w
        scale_y = disp_h / canvas_h
        bg_off_x = main_offset[0] if main_offset else 0
        bg_off_y = main_offset[1] if main_offset else 0
        bg_rw = main_render_size[0] if main_render_size else canvas_w
        bg_rh = main_render_size[1] if main_render_size else canvas_h
        bg_cur_time = 0.0
        if initial_time is None:
            # 默认取当前截取起始时间，方便预览「实际要处理的开头画面」
            try:
                _tf = app.trim_frame
                if _tf.trim_enabled.get():
                    _s = _tf.trim_start.get().strip()
                    if _s:
                        _sec = time_to_seconds(_s)
                        if _sec is not None:
                            initial_time = _sec
            except Exception:
                pass
        bg_cur_time = float(initial_time) if initial_time else 0.0
        bg_img_obj = None       # 保持引用防 GC
        bg_img_id = None
        bg_loading_id = None
        bg_cancel = threading.Event()
        bg_thread = [None]

        win = tk.Toplevel(parent)
        win.title(title + _sar_note)
        win.transient(parent)
        win.grab_set()
        win.withdraw()
        # 2026-09-11：最小宽高保护——子视频过小时画布随之变小、窗口被压窄，
        # 控件会被挤压遮挡。统一在共享编辑器设下限。
        # 2026-09-12：两栏布局后，宽度下限要含右栏（≈320）+ 最小画布区，故 420→600；
        # 高度下限保证右栏控件（画布尺寸/绘制/微调/缩放/应用）可完整显示。
        win.minsize(600, 520)

        # ---- 内部状态 ----
        current_x, current_y, current_w, current_h = rect_x, rect_y, rect_w, rect_h
        current_angle = float(rotate_angle or 0.0)
        current_canvas_w, current_canvas_h = canvas_w, canvas_h
        # 起始/结尾双端（条件调用）：初始几何按活动端从调用方实时读取（read 返回画布坐标），
        # 保证活动端与 rect_x/y/w/h 一致；翻转时由 _switch_end 重载。
        if start_end is not None:
            try:
                _sx, _sy, _sw, _sh, _sa = start_end["read"](start_end["active"])
                current_x, current_y, current_w, current_h = _sx, _sy, _sw, _sh
                current_angle = float(_sa or 0.0)
            except Exception:
                pass
        scale_pct = None           # 缩放倍率滑块（content_src_* 提供时启用）
        scale_entry = None         # 缩放% 数字输入框（与滑块双向同步）
        # _sync_scale_display 写 scale_pct 会反过来触发 ttk.Scale 的 command → 再进
        # _on_scale_slider → 再 update_rect_position → 再 _sync_scale_display …
        # 无限递归（2026-09-12：缩放滑块「没用/卡住」的根因）。用容器锁斩断回写触发链。
        _scale_sync_lock = [False]
        rect_id = None
        text_id = None
        coord_disp_id = None
        ghost_id = None           # 起始/结尾双端：非活动端幽灵矩形
        se_var = None             # 起始/结尾双端：RadioButton 选中态变量（切换时回写）
        ghost_label_id = None     # 幽灵端的小标签（「起始」/「结尾」）
        draw_rect_temp = None
        draw_start = None
        draw_mode_active = False
        dragging = False
        drag_start_x = 0
        drag_start_y = 0
        drag_mouse_start = (0, 0)
        rotate_handle_id = None       # 旋转手柄（右上角外侧小圆点）
        rotating = False              # 是否正在拖旋转手柄
        rot_mouse_start = (0, 0)
        rot_start_angle = 0.0
        # ---- 内容帧渲染状态（2026-09-12，无 PIL：ffmpeg 合成整帧，与原始画布编辑器同款）----
        content_img_id = None
        content_photo_ref = None       # 保持引用防 GC
        _content_render_timer = [None]
        # 2026-10-05：合成模式下「已渲染几何」记忆 [x, y, w, h, angle]。
        # ⚠️ 与上一版的「只挪图」不同：内容帧是**叠在背景上合成好的整帧**，位置一变整张图
        #    就变了 ⇒ 位置也必须参与判定。这里只用来「完全没变 → 直接跳过」，省一次无谓渲染。
        _content_geom = [None, None, None, None, None]
        # 2026-10-11：子视频绿幕滤镜接入真实帧（预览=成片）。chroma 串在合成图 [1:v] 链首
        # 注入；透明由 overlay 烘焙到背景帧之上（PPM 无 alpha，不能靠 Tk 混合）。
        _content_chroma_f = _build_chroma_filter(content_chroma_settings) or ""
        # 2026-10-14：子视频裁剪接入真实帧（修复 Bug2：位置编辑器预览显示整段子视频缩放、
        #   丢掉裁剪，应为「裁剪局部放大」）。content_chroma_settings 即 track.enc_settings，
        #   含 crop_enabled/crop_width/crop_height/crop_left/crop_top（与主视频
        #   _main_bg_pre_filter 同款 key 名）。取帧走 _extract_frame_scaled 不带 target 尺寸
        #   ⇒ 原生整帧，crop 的 iw/ih 指子视频原生尺寸（在 scale 之前注入，安全，不回归）。
        _content_crop_f = ""
        if isinstance(content_chroma_settings, dict):
            _cs = content_chroma_settings
            if _cs.get("crop_enabled", False):
                _cw = str(_cs.get("crop_width", "") or "").strip()
                _ch = str(_cs.get("crop_height", "") or "").strip()
                _cx = str(_cs.get("crop_left", "0") or "0").strip()
                _cy = str(_cs.get("crop_top", "0") or "0").strip()
                if _cw and _ch:
                    _content_crop_f = f"crop={_cw}:{_ch}:{_cx}:{_cy}"
        # 合成链前置滤镜（在 scale 之前）：crop → chroma → format=rgba。
        # ⚠️ 子视频无裁剪/无绿幕时 _cf 为空，行为与修复前完全一致（不回归）。
        _cf = ""
        if _content_crop_f:
            _cf += _content_crop_f + ","
        if _content_chroma_f:
            _cf += _content_chroma_f + ",format=rgba,"
        # 2026-10-05：背景帧 → PNG 文件的缓存 [path, stamp]。键 = id(bg_img_obj)。
        # ⚠️ 为什么要把 Tk 图倒出来给 ffmpeg 当底图：Tk 的 canvas **不会**把带 alpha 的
        #   image item 的透明区与下层 item 混合（透明区直接露 canvas 底色 = 黑），
        #   所以「透明 PNG 叠在背景帧上」这条路根本不成立（用户实测：帧四周一大片黑）。
        #   ⇒ 改为由 ffmpeg 做 overlay 合成（overlay 是真 alpha 合成），背景层直接用
        #   canvas 上那张**已经裁好/缩放好/摆好 offset 和黑边**的背景帧。
        _bg_png_cache = [None, None]
        # 2026-10-05：背景帧导出 PPM 文件缓存（供旋转路径 ffmpeg overlay 复用，避免反复写盘）
        _bg_ppm_cache = [None, None]
        # 2026-10-05：**按端预取的原始帧缓存** {端: (时刻, PNG bytes)}。
        # 从列表「起始/结尾坐标」进入位置编辑器的那一刻，就把**两端的帧各取一张**存好；
        # 之后在本窗口内的切端 / 拖动 / 缩放 / 旋转一律复用这 2 帧，绝不回源文件解码——
        # 从视频里 seek+decode 一帧是这条链最贵的一步（拖动时反复做会明显卡顿），而对一张
        # 已解码的 PNG 做 scale+rotate 只是毫秒级。
        # ⚠️ 只按「该端的取帧时刻」失效：时刻没变就不重解码；切端只是换 key，零 ffmpeg。
        _content_raw_cache = {}
        # 2026-10-05（重写）：**旋转后的内容小图缓存**，key=(端, 角度, 显示宽, 显示高)。
        # 只有「端/角度/尺寸」变了才跑 ffmpeg 渲染一次；纯位置拖动命中缓存 → 只 Tk 重贴（瞬时）。
        _content_rot_cache = {}
        _content_prefetching = set()

        def _fetch_raw_frame(t):
            """解出一帧原始内容（PPM bytes）；失败返回 None。

            2026-10-05（用户拍板）：**照抄背景帧 `_draw_bg_frame` 的取帧路径**。背景帧在
            列表轨迹里能按「起点 / 结尾」正确换帧，内容帧就必须走同一条路，别自己另拼命令：
              · `_extract_frame_scaled` 内部 = `-ss`(输入级 seek) 前置 + `-i` + PPM 管道，
                与背景帧同源；曾自己拼 `-frames:v 1 -c:v png`，与背景帧行为不一致。
              · 输出 **PPM 就够**：原始帧不需要 alpha（alpha 由第二步 rotate 产生、末级
                `format=rgba` 输出 PNG 时才需要），PPM 解码也更快。
              · 自动带上模块级 LRU 帧缓存 `_FRAME_CACHE` ⇒ 反复打开 / 切端零重复解码。
              · 静态图片自动降级到 0 秒（函数内部 `_is_static_image_file` 已处理），
                与「任何取素材时长的新代码必须先分流静态图片」铁律一致。
            """
            if isinstance(content_ppm, (bytes, bytearray)) and len(content_ppm) > 16:
                # 🔴 2026-10-17（全内存）：调用方已把内容帧解码好 ⇒ **零磁盘、零第二个子进程**
                #   —— 既不 `-ss <file>` 抽帧，也不写任何临时文件（老路径二者都有）。
                #   ⚠️ 内容这是**一张静止帧**（就像过去那张按状态分名的组合成 PNG），
                #      `t` 不影响它 —— 组合成帧本来就是「当前设置的一帧」。
                return bytes(content_ppm)
            if not content_file:
                return None
            _w, _h, _d = _extract_frame_scaled(app.ffmpeg_cmd, content_file, frame_sec=t)
            return _d or None

        def _prefetch_other_end(key, t):
            """后台预取另一端的帧 ⇒ 切过去时零等待（首次打开会顺带把对端取好）。"""
            if (key in _content_raw_cache) or (key in _content_prefetching):
                return
            _content_prefetching.add(key)

            def _w():
                try:
                    _d = _fetch_raw_frame(t)
                    if _d:
                        _content_raw_cache[key] = (t, _d)
                except Exception:
                    pass
                with suppress(Exception):
                    _content_prefetching.discard(key)
            threading.Thread(target=_w, daemon=True).start()
        # 2026-10-05：**内容帧取帧时刻**（可变容器）。「起始 / 结尾」两端各取各的时刻
        # （起点=start，结尾=start+dur），切端必须换帧 —— 否则两端共用同一帧，用户根本
        # 看不出两端的差异。用容器而非直接改参数：嵌套函数共享同一个值。
        _content_time = [content_time]

        # 启用旋转功能的条件：初始角度非 0 或提供了角度回调（子视频编辑器会传）
        rotation_enabled = (current_angle != 0) or (angle_cb is not None)
    
        # ---- 辅助函数 ----
        # ⚠️ PADDING 灰边（2026-09-10，与可视化裁剪窗口同款）：画布四周留 PAD 像素灰色边距，
        # 图像区从 (PAD, PAD) 开始。to_canvas/to_real 是「图像坐标 ↔ 画布坐标」唯一换算收口：
        # to_canvas 输出恒 +PAD、to_real 输入恒 -PAD；事件坐标与 canvas.bbox 同为画布系，
        # 与 to_canvas 输出做差/比较时 PAD 自动抵消，无需逐点再换算。
        # （PAD 已在函数开头按 pad / start_end 自适应求得：普通 RK_PAD=10、起始/结尾类 RK_PAD_WIDE=20。
        #  ⚠️ 量纲铁律（2026-09-12 修正）：本函数内凡是【显示层】的量（画布物理尺寸、to_canvas/
        #     to_real 的 ±PAD、图像/背景粘贴位置、浮动坐标文字、窗口尺寸）必须引用 PAD；
        #     凡是写进 canvas_w/h【内容坐标】的量（默认摆放内缩、重置归位边距）必须用
        #     RK_PLACE_INSET——两者量纲不同，互换了就会错位（PAD 还会随窗口是否带起始/结尾浮动）。

        def to_canvas(ox, oy):
            return int(ox * scale_x) + PAD, int(oy * scale_y) + PAD

        def to_real(cx, cy):
            return int(round((cx - PAD) / scale_x)), int(round((cy - PAD) / scale_y))

        # ---- 主视频背景帧（可选）：后台线程取帧，主线程绘制，置于最底层 ----
        def _draw_bg_frame():
            """（可选）提取主视频当前帧作为画布背景。pad 时按 main_offset 摆放主视频
            内容，超出画布的部分保持黑色（画布 bg=black）。未配置/失败则保持纯黑旧行为。
            后台线程取帧（与裁剪编辑器同套），主线程 via after(0) 绘制，绝不阻塞 GUI。"""
            if not bg_file or not os.path.exists(bg_file):
                return
            nonlocal bg_img_obj, bg_img_id, bg_loading_id, bg_cur_time
            _tw = max(1, int(round(bg_rw * scale_x)))
            _th = max(1, int(round(bg_rh * scale_y)))
            with suppress(Exception):
                if bg_loading_id is None:
                    bg_loading_id = canvas.create_text(
                        PAD + disp_w // 2, PAD + disp_h // 2, text=_("正在加载画面…"),
                        fill="#888888", font=("Arial", 11), tags="bg_load")
            # 取消旧线程（避免多次点击/尺寸切换堆积）
            if bg_thread[0] and bg_thread[0].is_alive():
                bg_cancel.set()
                with suppress(Exception):
                    bg_thread[0].join(timeout=0.5)
            bg_cancel.clear()

            def _on_ok(data):
                nonlocal bg_img_obj, bg_img_id, bg_loading_id
                try:
                    _img = tk.PhotoImage(data=data)
                except Exception as _e:
                    _on_fail(_('加载图像失败: {0}').format(_e))
                    return
                try:
                    if bg_loading_id is not None:
                        with suppress(Exception):
                            canvas.delete(bg_loading_id)
                        bg_loading_id = None
                    if bg_img_id is not None:
                        with suppress(Exception):
                            canvas.delete(bg_img_id)
                    _ox = int(round(bg_off_x * scale_x)) + PAD
                    _oy = int(round(bg_off_y * scale_y)) + PAD
                    bg_img_id = canvas.create_image(_ox, _oy, anchor=tk.NW,
                                                    image=_img, tags="bg_frame")
                    bg_img_obj = _img
                    # 2026-10-05：背景层换了（重新取帧 / 切端换时刻）⇒ 合成图
                    #（背景 + 内容帧那一整帧）必须重做一次，否则画面还是旧背景。
                    with suppress(Exception):
                        _schedule_content_render()
                    # 背景帧置于黑色垫层（pad_black）之上、矩形/坐标/手柄之下。
                    # ⚠️ 不能 tag_lower 到全局最底：PADDING 灰边（2026-09-10）新增的黑色垫层
                    # 也是 item 且恒在最底，全局 tag_lower 会把图像压到垫层之下 → 全黑。
                    try:
                        canvas.tag_raise("bg_frame", "pad_black")
                    except Exception:
                        canvas.tag_lower("bg_frame")
                    with suppress(Exception):
                        canvas.tag_raise("bg")
                    for _t in (rect_id, text_id, coord_disp_id, rotate_handle_id):
                        if _t:
                            with suppress(Exception):
                                canvas.tag_raise(_t)
                    # 背景帧同样是不透明整帧：重排幽灵，防参考框被背景帧盖住（2026-09-12）
                    with suppress(Exception):
                        _restack_ghost()
                    with suppress(Exception):
                        bg_refresh_btn.config(state=tk.NORMAL, text=_("重新获取帧"))
                    # 取帧时刻超出时长 → 已回退到开头：明确告知，免得用户以为画面不对
                    if _fallback_note[0]:
                        with suppress(Exception):
                            status_var.set(_("背景帧") + _fallback_note[0])
                except Exception as _e:
                    _on_fail(_('绘制失败: {0}').format(_e))

            def _on_fail(msg):
                nonlocal bg_loading_id
                with suppress(Exception):
                    if bg_loading_id is not None:
                        canvas.delete(bg_loading_id)
                        bg_loading_id = None
                with suppress(Exception):
                    status_var.set(_('背景帧获取失败：{0}').format(msg))
                with suppress(Exception):
                    bg_refresh_btn.config(state=tk.NORMAL, text=_("重新获取帧"))

            _fallback_note = [""]      # 取帧回退提示（容器：供 _extract 写、_on_ok 读）

            def _extract():
                if bg_cancel.is_set():
                    return
                try:
                    _pf = bg_pre_filter
                    if _pf and "t" in _pf:
                        # 动态裁剪（简易位置表达式）：input -ss 后滤镜 t 恒从 0 起
                        # （=段前基准），注入 setpts=PTS+取帧时间/TB 让 crop 表达式
                        # 在 bg_cur_time 时刻求值（背景=该时刻真实裁剪画面）
                        _pf = f"setpts=PTS+{bg_cur_time}/TB,{_pf}"
                    if frame_extractor is not None:
                        # 节点语境：背景帧走「节点时间轴取帧器」（由 _make_node_frame_extractor
                        # 生成，tap_seek=bg_cur_time 取节点输出第 T 秒画面，含节点像素类效果、
                        # 排除几何效果以保持坐标空间不被打乱）。bg_file（主视频）在此被忽略。
                        w, h, data = frame_extractor(
                            bg_file, frame_sec=bg_cur_time,
                            target_width=_tw, target_height=_th, pre_vf=_pf)
                    else:
                        w, h, data = _extract_frame_scaled(
                            app.ffmpeg_cmd, bg_file,
                            frame_sec=bg_cur_time, target_width=_tw, target_height=_th,
                            pre_vf=_pf)
                        # ⚠️ 2026-10-05 实测抓到（「框内透明、没有真实帧」的根因）：
                        # 航点时刻可能**超出素材长度**（如航点 start=10s 而视频只有 5s），
                        # 此时 ffmpeg 出不来帧、_extract_frame_scaled 返回空 ⇒ 背景全黑，
                        # 表现为「矩形是透明的、里面什么都没有」（连主视频画面都没有）。
                        # ⇒ 回退到 0 秒再取一次：宁可显示开头那一帧，也绝不留一片黑。
                        if not data and bg_cur_time > 0:
                            w, h, data = _extract_frame_scaled(
                                app.ffmpeg_cmd, bg_file,
                                frame_sec=0.0, target_width=_tw, target_height=_th,
                                pre_vf=_pf)
                            if data:
                                _fallback_note[0] = _("（该时刻超出视频长度，已回退到开头）")
                except Exception as _e:
                    app.root.after(0, lambda e=_e: _on_fail(_('提取异常: {0}').format(e)))
                    return
                if bg_cancel.is_set():
                    return
                if w is None or h is None or not data:
                    app.root.after(0, lambda: _on_fail(_("提取帧失败，请检查文件")))
                    return
                app.root.after(0, lambda d=data: _on_ok(d))

            bg_thread[0] = threading.Thread(target=_extract, daemon=True)
            bg_thread[0].start()
    
        # ---- 旋转辅助（rotation_enabled 时启用）----
        def content_diag():
            """旋转后包围盒边长 d（与 rotate 滤镜 ow/oh=hypot(iw,ih) 一致）；仅 rot_square 模式使用。"""
            return int(round(((current_w * current_w + current_h * current_h) ** 0.5)))

        def content_center():
            """内容矩形旋转中心（=旋转画布 d×d 正方形中心，二者重合）。
            锚点 current_x/y 恒为内容盒左上角（overlay_x/y 语义，2026-08-26 统一）：
            旋转正方形以内容中心为中心居中 → 内容盒左上角=锚点、旋转中心=锚点+半宽/半高。"""
            return current_x + current_w / 2.0, current_y + current_h / 2.0

        def geom_center():
            """当前真实几何的旋转中心 = 内容矩形中心（=旋转正方形中心）。
            角度=0 与角度≠0 一致：overlay x/y 恒为内容盒左上角（current_x/y），
            旋转/不旋转都以内容中心为旋转轴，不得按正方形中心反推偏移。"""
            return content_center()

        def polygon_canvas():
            """内容矩形绕中心旋转 current_angle 后的 4 顶点（画布坐标）。
            中心 = geom_center() = 内容中心（=旋转正方形中心）：角度 0 → 4 顶点即
            current_x/current_y 起始的精确矩形；角度≠0 → 内容绕内容中心旋转，
            与 rotate 滤镜物理中心一致（正方形自动居中，锚点恒为内容盒左上角）。"""
            cx, cy = geom_center()
            pts = rotate_rect_polygon(cx - current_w / 2.0, cy - current_h / 2.0,
                                      current_w, current_h, current_angle)
            return [tuple(to_canvas(px, py)) for px, py in pts]

        def rotate_handle_canvas():
            """旋转手柄位置：内容矩形旋转后的右上角，沿旋转方向外推 14px（画布坐标）。
            角度=0 时旋转恒等 → 手柄=内容矩形右上角 (x+w, y)；角度≠0 时绕内容中心
            （=正方形中心）旋转，与 rotate 滤镜物理中心一致。"""
            import math as _m
            cx, cy = geom_center()
            a = _m.radians(current_angle)
            ca, sa = _m.cos(a), _m.sin(a)
            px, py = cx + current_w / 2.0, cy - current_h / 2.0
            dx, dy = px - cx, py - cy
            rx, ry = cx + dx * ca - dy * sa, cy + dx * sa + dy * ca
            vx, vy = rx - cx, ry - cy
            vlen = (vx * vx + vy * vy) ** 0.5 or 1.0
            return tuple(to_canvas(rx + vx / vlen * 14, ry + vy / vlen * 14))

        def clamp_rect():
            nonlocal current_x, current_y, current_w, current_h
            if _allow_neg[0] and min_visible_pixels > 0:
                # 允许负偏移，但至少保留 min_visible_pixels 像素可见
                # （2026-09-10：钳制收编 _rect_kit.rk_clamp_min_visible）
                current_x, current_y, current_w, current_h = rk_clamp_min_visible(
                    current_x, current_y, current_w, current_h,
                    current_canvas_w, current_canvas_h, min_visible_pixels)
            elif _allow_neg[0]:
                # 完全放开，无任何限制
                pass
            else:
                # 严格限制在画布内（子视频/水印模式）。旋转（实际角度≠0）且 rot_square 时，
                # current_x/y 是内容盒左上角，而实际叠加区域是中心对齐的 d×d 正方形
                # （正方形左上角=内容盒左上角-(d-w)/2），故按「正方形完全落在画布内」
                # 反推内容盒边界：内容盒 ∈ [(d-w)/2, 画布-d+(d-w)/2]。
                # ⚠️ 必须判 current_angle != 0 而非 rotation_enabled：子视频/文字水印编辑器
                # 都传了 angle_cb（供随时开启旋转），rotation_enabled 恒为 True，若用它判定，
                # 角度=0 时也会按对角线 d=hypot(w,h) 钳制 → 矩形拖不到边、留出 d-w 的边距，
                # 且矩形越大差量越大（用户实测「无旋转时矩形外有无形边框」）。
                if current_angle != 0 and rot_square:
                    d = content_diag()
                    _shx = (d - current_w) / 2.0
                    _shy = (d - current_h) / 2.0
                    current_x = max(_shx, min(current_x, max(_shx, current_canvas_w - d + _shx)))
                    current_y = max(_shy, min(current_y, max(_shy, current_canvas_h - d + _shy)))
                    current_w = min(current_w, current_canvas_w)
                    current_h = min(current_h, current_canvas_h)
                else:
                    # 非旋转：完全钳进画布（2026-09-10：收编 _rect_kit.rk_clamp_inside）
                    current_x, current_y, current_w, current_h = rk_clamp_inside(
                        current_x, current_y, current_w, current_h,
                        current_canvas_w, current_canvas_h)

        def _place_box_labels(_bb, _tid=None, _cid=None):
            """把 label(text_id) 与浮动坐标(coord_disp_id) 摆到包围盒**外侧**（2026-10-12）。

            ⚠️ 起因：label 原画在**框内左上角**（+5,+5，anchor=nw），子视频缩放较小时
            正好压住框内真实帧内容（用户实测困扰）⇒ 一律移出框外；coord 原「上方居中
            y-10」也一并由本函数接管，避免两处坐标各自演化。

            🔴 **必须显式传 item id**（`_tid` / `_cid`），不能只靠闭包里的 `text_id`：
            `create_rect()` 内部刚 `create_text` 出来的 item 还**没有**写回 nonlocal
            `text_id`（那是 `rect_id, text_id = create_rect()` 返回时才赋值的）⇒ 首次
            打开编辑器时 helper 读到 `text_id=None` 直接跳过，label 就停在 create_text
            的初始坐标 (0,0) = **画布左上角**（用户实测「刚点进去字在画布左上角，挪一下
            框才跟过来」）。update_rect_position 里闭包变量已就位，故可省略实参。

            规则（判据只此一份；create_rect 与 update_rect_position 都调它）：
              1. 优先挂框**上方**：label 贴框顶上方 3px、coord 再往上一行（20px），
                 均左对齐框左边；框贴顶（上方放不下两行 ≈34px）时整体改挂框**下方**；
              2. **垂直分行**而不是「左右分列」——实测 label "当前子视频" 宽约 62px，
                 比很多子视频框还宽，同基线分居两端在窄框（实测 64px 宽）下照样叠字；
              3. 落位后按画布实际宽度水平夹一次（框贴左边/右边时防文字被裁掉）。
            """
            if not _bb:
                _fx = current_x * scale_x + PAD
                _fy = current_y * scale_y + PAD
                _bb = (_fx, _fy, _fx + max(1.0, current_w * scale_x),
                       _fy + max(1.0, current_h * scale_y))
            _tid = _tid if _tid is not None else text_id
            _cid = _cid if _cid is not None else coord_disp_id
            _cw = 0
            with suppress(Exception):
                _cw = canvas.winfo_width()
            _up = _bb[1] >= 34
            _x = max(0, _bb[0])
            if _tid:
                with suppress(Exception):
                    canvas.itemconfig(_tid, anchor="sw" if _up else "nw")
                    canvas.coords(_tid, _x, _bb[1] - 3 if _up else _bb[3] + 2)
            if _cid:
                with suppress(Exception):
                    canvas.itemconfig(_cid, anchor="sw" if _up else "nw")
                    canvas.coords(_cid, _x, _bb[1] - 20 if _up else _bb[3] + 19)
                    canvas.itemconfig(_cid, text=f"({current_x}, {current_y})")
            for _it in (_tid, _cid):
                if not _it or not _cw or _cw <= 1:
                    continue
                with suppress(Exception):
                    _tbb = canvas.bbox(_it)
                    if not _tbb:
                        continue
                    if _tbb[2] > _cw:
                        canvas.move(_it, _cw - _tbb[2], 0)
                    elif _tbb[0] < 0:
                        canvas.move(_it, -_tbb[0], 0)

        def create_rect():
            nonlocal rect_id, text_id, coord_disp_id, rotate_handle_id
            # 统一用 polygon 绘制（4 顶点=矩形，N 顶点=旋转矩形）：
            # ⚠️ 绝不能按角度 0 创建 create_rectangle——拖手柄后角度变非 0，
            # update_rect_position 会用 8 个顶点 coords 一个 rectangle 对象（只收 4 坐标）
            # → TclError/静默失败，矩形不跟随旋转（用户实测「第一次打开拖手柄矩形不动」）。
            # 角度=0 时 polygon_canvas 经 geom_center（内容中心）算出 4 顶点 = 精确矩形，
            # 左上角就是 current_x/current_y（无偏移），与坐标显示一致。
            pts = polygon_canvas()
            # 2026-10-05：「更多设置 → 位置编辑器显示框内真实帧」关闭时 ⇒ 强制虚拟框
            #   （矩形内填斜纹）。等价于调用方传 draw_diagonal=True，但只在运行期可判。
            _want_diagonal = draw_diagonal or (not _real_frame[0])
            if _want_diagonal:
                rid = canvas.create_polygon(pts, outline=rect_color, width=2,
                                            fill=rect_color, stipple="gray50", tags="rect")
            else:
                # 仅描边、不填充斜纹（draw_diagonal=False）：矩形内部保持透明，便于看清背景帧。
                # ⚠️ 必须显式 fill=""：Tk 多边形不指定 fill 时默认 SystemButtonText（本机解析为黑色），
                # 不填会整块黑、挡住背景帧。
                # ⚠️ 拖动/旋转中例外：**重建时也要保持虚拟框样式**——on_move 每动一像素都会
                #   走到这里重建矩形，若恒 fill="" 则刚设好的拖动样式立刻被冲掉（表现为
                #   「拖动时仍是透明框」）。松手由 stop_move/stop_rotate 恢复透明。
                if dragging or rotating:
                    rid = canvas.create_polygon(pts, outline=rect_color, width=2,
                                                fill=rect_color, stipple="gray25",
                                                tags="rect")
                else:
                    rid = canvas.create_polygon(pts, outline=rect_color, width=2,
                                                fill="", tags="rect")
            bbox = canvas.bbox(rid)
            # 2026-10-05：content_rgba（框内已渲染**真实文字**）时不再画 "文字水印" 这类占位
            #   label——它与真实文字同处框内左上角、且在内容层之上（内容被 tag_lower 到
            #   "rect" 之下），两者重叠直接干扰阅读。真实文字本身已说明类型，label 纯冗余。
            #   置空串而非返回 None：text_id 仍是个合法 canvas item，下游 coords/delete 零改动。
            # ⚠️ 2026-10-12：label **不再画在框内**——子视频缩放较小时框内左上角那行白字
            #   正好压住框内真实帧内容（用户实测困扰）⇒ 挂到包围盒外侧，具体落位统一交给
            #   `_place_box_labels()`（此处只负责创建 item，坐标由它随后设定）。
            tid = canvas.create_text(0, 0, anchor="nw",
                                     text=("" if content_rgba else rect_label),
                                     fill="white", font=("Arial", 9), tags="rect")
            # 旋转手柄：可编辑角度时始终显示（角度 0 也保留，保证能随时拖手柄开始旋转）
            if angle_editable:
                hx, hy = rotate_handle_canvas()
                rotate_handle_id = canvas.create_oval(hx - 6, hy - 6, hx + 6, hy + 6,
                                                      outline="yellow", width=2, fill="black",
                                                      tags="rothead")
            # 浮动坐标显示（2026-10-12：同样交给 _place_box_labels 统一摆到框外）
            bbox2 = canvas.bbox(rid)
            coord_disp_id = canvas.create_text(0, 0, anchor="nw",
                                               text=f"({current_x}, {current_y})",
                                               fill="#00ff00", font=("Arial", 8),
                                               tags="coord_disp")
            # 🔴 必须显式传 tid / coord_disp_id：此刻 nonlocal 的 text_id 还是旧值/None
            _place_box_labels(bbox2, tid, coord_disp_id)
            return rid, tid

        # 2026-10-09：右侧「坐标框」同步句柄（coord_box=True 时才由下方构建段赋值）。
        # ⚠️ 必须先置 None：`update_rect_position` 在入口处就会调 `_sync_coord_box()`，
        #    而构建段在几百行之后 —— 未赋值就调用会 UnboundLocalError（本项目已踩过同型坑）。
        coord_sync = None

        def _cur_rot_val():
            """rot_slider 的当前值（度）；未传滑块 → 0（不影响旧调用方）。"""
            if rot_slider is None:
                return 0.0
            with suppress(Exception):
                return float(rot_slider["var"].get() or 0.0)
            return 0.0

        def _restack_bg():
            """把其他子视频虚线框（bg_draw）抬到黑色底衬 / 背景帧 / 内容合成图之上、活动矩形之下。

            ⚠️ 2026-10-11 修复「真实帧模式下其他子视频虚线框被背景帧盖住、仅点击时露出的分叉」：
            bg_draw_func 画出的 items 在 bg_frame / content_img（不透明整帧）创建时被覆盖。
            本函数由 `_restack_ghost` 在每次重排叠加栈时一并调用，使其常驻可见。
            """
            if bg_draw_func is None:
                return
            with suppress(Exception):
                canvas.tag_raise("bg_draw")  # 先抬到最顶
            with suppress(Exception):
                canvas.tag_lower("bg_draw", "rect")  # 再压到活动矩形之下（仍高于黑层）

        def _invoke_bg_draw():
            """初次绘制 bg_draw_func 的叠加层（其他子视频虚线框）。

            条件调用：只有调用方显式传 `bg_draw_func` 才生效（None=旧调用方逐字节不变）。
            画出的 canvas item 收尾与实时重画版同口径：统一平移进图像区（+PAD）、
            打 tag "bg_draw"、压到红色矩形（tag "rect"）之下。
            ⛔ 只画不改：本函数绝不写回任何数据（回调方也须只读）。
            """
            if bg_draw_func is None:
                return
            try:
                _before = set(canvas.find_all())
                bg_draw_func(canvas, scale_x, scale_y)
                for _i in canvas.find_all():
                    if _i in _before:
                        continue
                    with suppress(Exception):
                        canvas.move(_i, PAD, PAD)
                    with suppress(Exception):
                        canvas.addtag_withtag("bg_draw", _i)
                    with suppress(Exception):
                        canvas.tag_lower(_i, "rect")
            except Exception:
                pass

        def _invoke_bg_live_draw():
            """按**当前实时几何**重画 bg_draw_func 的叠加层（拖拽/微调/坐标框/旋转中跟随）。

            条件调用：只有调用方显式传 `bg_live_draw_func` 才生效（None=旧调用方逐字节不变）。
            新画出的 canvas item 需两件收尾（与首次 bg_draw_func 调用同口径）：
              · 统一平移进图像区（+PAD）—— 回调按「图像坐标」画，无 PAD 概念；
              · 压到红色矩形（tag "rect"）之下 —— 否则会盖住可拖拽的红框（红框是最上层交互对象）。
            ⛔ 只画不改：本函数绝不写回任何数据（回调方也须只读）。
            """
            if bg_live_draw_func is None:
                return
            try:
                _before = set(canvas.find_all())
                bg_live_draw_func(canvas, scale_x, scale_y,
                                  (current_x, current_y, current_w, current_h, _cur_rot_val()))
                for _i in canvas.find_all():
                    if _i in _before:
                        continue
                    with suppress(Exception):
                        canvas.move(_i, PAD, PAD)
                    with suppress(Exception):
                        canvas.tag_lower(_i, "rect")
            except Exception:
                pass

        def update_rect_position():
            pts = polygon_canvas()
            canvas.coords(rect_id, [c for pt in pts for c in pt])
            bbox = canvas.bbox(rect_id)
            if bbox:
                # 2026-10-12：label / 浮动坐标挂在框外，落位判据统一在 _place_box_labels
                _place_box_labels(bbox)
            if angle_editable and rotate_handle_id:
                hx, hy = rotate_handle_canvas()
                canvas.coords(rotate_handle_id, hx - 6, hy - 6, hx + 6, hy + 6)
            # 浮动坐标（2026-10-12：与 label 一同由 _place_box_labels 摆位，见其上方调用）
            update_coord_display()
            _sync_scale_display()
            _sync_coord_box()
            # 角度≈0：内容帧是「独立轻量个体」，拖动时随 box 实时跟随（零 ffmpeg，只挪图）
            # 2026-10-05：全局开关关闭（虚拟框模式）时无内容图可跟随，跳过。
            # 2026-10-11：绿幕开启时角≈0 走合成路径（整张画布大图）⇒ 不能按 box 挪位（会画面丢失）；
            #   与「角度≠0」同列，交给 _do_render_content 重渲染产图。
            if (_real_frame[0] and content_alpha and abs(current_angle) < 0.5
                    and not _content_chroma_f and content_img_id is not None):
                with suppress(Exception):
                    canvas.coords(content_img_id, *to_canvas(current_x, current_y))
            _schedule_content_render()
            # 2026-10-11：叠加层（如遮罩各形状轮廓虚线）按实时几何跟随重画 ——
            # 拖拽/微调/坐标框/旋转滑块每次改几何都会走到这里；未传回调则是 no-op。
            _invoke_bg_live_draw()

        # ---- 起始/结尾双端（条件调用）：画另一端幽灵 + 内部翻转 ----
        def polygon_for(ox, oy, ow, oh, oang):
            """任意几何的旋转多边形（画布坐标）；polygon_canvas 用 current_* 同款数学。"""
            pts = rotate_rect_polygon(ox, oy, ow, oh, oang)
            return [tuple(to_canvas(px, py)) for px, py in pts]

        def _restack_ghost():
            """把幽灵框（se_ghost）抬到黑色底衬 / 背景帧 / 内容合成图之上、活动矩形之下。

            ⚠️ 关键（2026-09-12 修复「互相的参考框被黑画布裁切」）：content_img / bg_frame
            都是后创建的不透明整帧（多为黑底）。若幽灵先画、随后 content_img 调
            `tag_lower(content_img_id, "rect")`，黑帧会正好落在幽灵之上把它整块盖住 →
            看起来像被黑画布裁掉。故每次重建黑层（取背景帧 / 内容合成）后都要重新抬一次。
            """
            # 2026-10-11：重排幽灵时也重排其他子视频虚线框（bg_draw），使其常驻可见。
            _restack_bg()
            if ghost_id is None and ghost_label_id is None:
                return
            for _gid in (ghost_id, ghost_label_id):
                if _gid is None:
                    continue
                with suppress(Exception):
                    canvas.tag_raise(_gid)          # 先抬到最顶
                with suppress(Exception):
                    canvas.tag_lower(_gid, "rect")  # 再压到活动矩形之下（仍高于黑层）

        def _draw_ghost():
            """画非活动端为浅色幽灵（描边+斜纹），便于同画布对比起始/结尾位置。

            ⚠️ 颜色用 GHOST_COLOR（2026-09-12 起=互补青色），**不再用** rect_color：
            两端同红时只剩线宽 1/2 + 点密度 gray25/gray50 可辨，实际看不出哪端在被编辑。
            """
            nonlocal ghost_id, ghost_label_id
            for _gid in (ghost_id, ghost_label_id):
                if _gid is not None:
                    with suppress(Exception):
                        canvas.delete(_gid)
            ghost_id = ghost_label_id = None
            if start_end is None or not start_end.get("can_compare", True):
                return
            _other = "end" if start_end["active"] == "start" else "start"
            try:
                gx, gy, gw, gh, gang = start_end["read"](_other)
            except Exception:
                return
            # 与活动端重合（如 still 段）→ 不画
            if (gx, gy, gw, gh, gang) == (current_x, current_y, current_w, current_h, current_angle):
                return
            gp = polygon_for(gx, gy, gw, gh, gang)
            ghost_id = canvas.create_polygon(gp, outline=GHOST_COLOR, width=1,
                                             fill=GHOST_COLOR, stipple="gray25", tags="se_ghost")
            bx, by = gp[0][0], gp[0][1]
            ghost_label_id = canvas.create_text(bx + 6, by + 6, anchor="nw",
                                                text=(_("起始") if _other == "start" else _("结尾")),
                                                fill=GHOST_COLOR, font=("Arial", 9), tags="se_ghost")
            # 统一走 _restack_ghost：抬到黑层之上、活动矩形之下（防被黑画布盖住）
            _restack_ghost()

        def _sync_angle_cb():
            """把 `current_angle` 立即同步给调用方（`angle_cb(current_angle)`）。

            ⚠️ 2026-09-12 关键修复（「结尾的旋转角度没保存」根因）：
            不同调用方的 angle_cb 语义不同——
              · 航点/遮罩/文字水印：angle_cb 直接写数据（ra/rb），随手柄松手即落盘；
              · 画布编辑器 `_open_generic_editor`：angle_cb 只把角度写进 `captured` 缓冲，
                **真正的落盘在 on_apply 里读该缓冲**（`_set_kf(..., captured[0])`）。
            于是缓冲必须与「当前活动端」时刻保持一致。而以下几处会改 `current_angle`
            却不经过旋转手柄：切换起始/结尾（重载另一端角度）、重置位置（角度归零）。
            缓冲不同步 → 紧接着任何 on_apply 都会把「另一端的角度」写进当前端 →
            表现为切换端后当前端的旋转角度被另一端覆盖 / 像没保存。
            故：凡 `current_angle` 变动处，都必须在紧邻的 on_apply 前后调用本函数。
            """
            if angle_cb is not None:
                with suppress(Exception):
                    angle_cb(float(current_angle))

        def _fire_drag_commit():
            """松手 / 切端 / 关闭 / 选八向预设时的统一回写口（2026-09-03）+ **M1** 同步通知预览（2026-10-04）。

            ⛔ 为什么把 `live_preview_commit()` 放在 `if on_drag_commit` **外面**：多数位置编辑器
            （画布 / 主视频偏移 / 水印位置 / 裁剪）压根没传这个回调，只在有回调时才刷新的话，
            这些窗口就永远享受不到同步预览。而「没回调 ⇒ 坐标没回写」的情况下刷新预览也无害
            —— 命令串没变，M2 的 dirty 检查会让它零成本跳过。
            """
            if on_drag_commit is not None:
                with suppress(Exception):
                    on_drag_commit(current_x, current_y)
            live_preview_commit()

        def _switch_end(which):
            """内部「起始/结尾」切换：先把当前端编辑回写，再翻转活动端并重载几何 + 重画幽灵。"""
            nonlocal current_x, current_y, current_w, current_h, current_angle, se_var, bg_cur_time
            if start_end is None or which not in ("start", "end"):
                return
            # ⚠️ 切换前必须先回写当前端（角度 angle_cb + 坐标 on_drag_commit + 尺寸/刷新 on_apply），
            # 否则通过滑块/微调/输入框/旋转手柄做的调整在切换瞬间丢失（表现为「恢复到弹出时状态」）。
            # 此时 active_flag 仍指向当前端，回写路由正确。
            _sync_angle_cb()   # ← 必须早于 on_apply：画布编辑器的 on_apply 要读 captured 缓冲
            _fire_drag_commit()
            if on_apply is not None:
                with suppress(Exception):
                    on_apply(current_x, current_y, current_w, current_h,
                             current_canvas_w, current_canvas_h)
            start_end["active"] = which
            # 2026-10-05：两端各取各的时刻（起点=start，结尾=start+dur）⇒ 切端必须**换帧**，
            # 否则两端共用同一帧，看起来就是「结尾和起点画面一模一样」。
            # start_end["time"] 由调用方提供（航点面板知道该行的 start/dur）；老调用方
            # 不给这个键 ⇒ 完全不触发，行为与改动前一致。
            _tof = start_end.get("time") if isinstance(start_end, dict) else None
            if callable(_tof):
                with suppress(Exception):
                    _nt = max(0.0, float(_tof(which)))
                    if abs(_nt - bg_cur_time) > 1e-6:
                        bg_cur_time = _nt          # 背景帧换时刻
                        _content_time[0] = _nt     # 内容帧换时刻
                        # ⚠️ 刻意**不**清 _content_raw_cache：它按 (端, 时刻) 判定，
                        # 切端只是换 key —— 另一端若已后台预取好就直接命中（零 ffmpeg），
                        # 没预取到或时刻对不上则由 ① 自动重取，无需在这里手动失效。
                        _content_geom[0] = None    # 失效几何记忆（强制重渲染而非只挪图）
                        with suppress(Exception):
                            bg_time_var.set(f"{_nt:.2f}")   # 时间输入框同步
                        _draw_bg_frame()                    # 背景帧按新时刻重取
            if se_var is not None:
                with suppress(Exception):
                    se_var.set(which)
            with suppress(Exception):
                start_end["on_switch"](which)   # 调用方翻 edit_end 标记（写回路由随之切换）
            try:
                gx, gy, gw, gh, gang = start_end["read"](which)
            except Exception:
                return
            current_x, current_y, current_w, current_h = gx, gy, gw, gh
            current_angle = float(gang or 0.0)
            # ⚠️ 关键：重载后立即把新端角度同步进调用方缓冲，否则缓冲仍是上一端的角度，
            # 之后任何 on_apply 都会把它写进新端（「结尾角度被起始角度覆盖」的根因）。
            _sync_angle_cb()
            clamp_rect()
            update_rect_position()
            _sync_scale_display()   # 切换端后把新端尺寸/倍率同步回滑块（防滑块显示旧值）
            _draw_ghost()

        # ---- 内容帧渲染（2026-09-12）：照抄原始画布编辑器 _render() 的「ffmpeg 合成整帧」，
        # 全程 ffmpeg + tk.PhotoImage，无 PIL / 无第三方库（同时间铁律）。
        # 仅当 content_file 提供时启用；其余调用方（PiP/水印/简易位置）不传，行为不变。
        def _do_render_content():
            """把内容帧（含缩放/旋转/位置）合成整张画布图，垫在矩形描边之下。

            2026-10-05：「更多设置 → 位置编辑器显示框内真实帧」关闭 ⇒ 开头直接返回：
            隐藏已渲染的内容图（回退红蓝虚拟框），不再跑任何 ffmpeg 取帧/合成。

            逐条照抄原始「位置、尺寸、旋转」窗口 _render()（9108 行起）的 ffmpeg 合成图：
                color 黑底 + [0:v]scale(倍率) + rotate(角度) + overlay(居中+偏移) + 末级 scale(显示尺寸)
            ⚠️ 必须走这条合成路径（而非单抽一帧直接画矩形内）：Tk 原生 PhotoImage 无法旋转，
               只有交给 ffmpeg 才能在非零角度下也画出正确的旋转内容；原窗口即如此，旋转帧也正常显示。
            ⚠️ 不引入 PIL / numpy 等任何第三方库（2026-09-12 铁律），全程 ffmpeg + tk.PhotoImage。
            ⚠️ 合成图含不透明黑底，故仅当调用方不提供 main_video_file（画布编辑器场景）时使用。
            """
            nonlocal content_img_id, content_photo_ref
            # 2026-10-05 诊断（用户报「子视频普通位置编辑器框内透明」）：把「为什么没内容帧」
            #   显式写到状态栏，避免只能靠猜。早退各有明确文案：
            #   ① 全局/窗口临时开关关掉了 → 虚拟框（正常，不是故障）
            #   ② 调用方没给内容源 → 本窗口不支持真实帧
            #   ③ 给了但取不到帧 → 见下方「框内帧获取失败」（文件/编码问题）
            if not _real_frame[0]:
                if content_img_id is not None:
                    with suppress(Exception):
                        canvas.itemconfig(content_img_id, state="hidden")
                return
            # ============ 文字水印：框内渲染真实文字（带 alpha 的透明 PNG） ============
            # 与子视频 content_alpha 路径完全独立：文字不是媒体文件，走 _render_text_watermark_preview_png
            # 生成的透明 PNG，scale/rotate 全程 png 保留 alpha ⇒ 框内就是真实文字（透明处透出背景）。
            # 角度=0：直接缩放到 box 显示尺寸贴左上角（零 ffmpeg 跟随，见 update_rect_position）；
            # 角度≠0：旋转有透明角 → ffmpeg overlay 到背景帧（拖拽中隐藏红框，松手才渲一次）。
            if content_rgba and content_file and os.path.exists(content_file):
                _disp_cw = max(2, int(round(current_w * scale_x)))
                _disp_ch = max(2, int(round(current_h * scale_y)))
                _ang0 = abs(current_angle) < 0.5
                # 2026-10-05 修「旋转后拖框，文字不跟随、停留在旋转位置」：
                #   角度≠0 时输出是**整张画布合成图**（rotate+overlay 把文字按中心坐标烘焙进
                #   像素），位置已固化在图里 ⇒ 位置**必须**进 cache key，否则移动框后命中旧 key
                #   直接复用旧位置的残图（拖动中内容隐藏、松手才渲一次，暴露为"不跟随"）。
                #   角度=0 时输出是 box 尺寸小图，位置在绘制时由 to_canvas 决定 ⇒ 不进 key
                #   （否则每像素拖动都 miss，缓存爆炸且失去零 ffmpeg 跟随）。
                _cache_key = (_disp_cw, _disp_ch, 0 if _ang0 else round(current_angle * 10),
                              None if _ang0 else (round(current_x, 2), round(current_y, 2)))
                _ct = _content_rot_cache.get(_cache_key)
                if _ct is None:
                    try:
                        with open(content_file, "rb") as _f:
                            _png = _f.read()
                    except Exception:
                        return
                    if not _png:
                        return
                    if _ang0:
                        graph = f"[0:v]scale={_disp_cw}:{_disp_ch}:eval=frame[src]"
                        _cmd = [app.ffmpeg_cmd, "-f", "image2pipe", "-c:v", "png", "-i", "pipe:0",
                                "-filter_complex", graph, "-map", "[src]",
                                "-frames:v", "1", "-f", "image2pipe", "-c:v", "png", "pipe:1"]
                    else:
                        _bg_in = None
