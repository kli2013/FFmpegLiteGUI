def _jsonable_node_fx(app):
    """self.node_fx → 可安全 json.dump 的普通 dict（2026-09-26）。

    逐个试 dumps，不可序列化的那一项**跳过**而不是让整个项目保存失败。
    （「保存项目」挂掉比丢一个节点效果严重得多。）
    """
    _out = {}
    for _k, _v in (getattr(app, "node_fx", None) or {}).items():
        try:
            json.dumps({"v": _v})
        except Exception:
            continue
        try:
            _out[str(_k)] = copy.deepcopy(_v)
        except Exception:
            continue
    return _out


