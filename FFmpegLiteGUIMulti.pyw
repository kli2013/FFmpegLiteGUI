                    bgm_frame.grid(row=3, column=0, columnspan=2, sticky="we", padx=5, pady=8)

                    ttk.Checkbutton(
                        bgm_frame, text=_("叠加背景音乐（循环铺满整段输出，混在原有音频之下）"),
