    def add_segment_with_time(self, start_sec, end_sec, flip=None, speed="1.0", reverse=False):
        """直接使用浮点数添加片段（用于外部命令导入）"""
        if flip is None:
            flip = _("无")
        if start_sec is None or end_sec is None:
            return False
        if start_sec >= end_sec:
            return False

        # 检查是否超出总时长（容差 0.001 秒，自动修正）
        dur = self._get_input_duration()
        if dur is not None:
            if abs(end_sec - dur) <= 0.001:
                end_sec = dur
            if end_sec > dur + 0.001:
                if self.app:
                    self.app._append_info_ui(_("[分段] 片段超出总时长，已跳过"))
                return False

        start_str = seconds_to_time(start_sec)
        end_str = seconds_to_time(end_sec)
        self._seg_begin_edit()
        self.segments.append({"start": start_str, "end": end_str, "flip": flip, "speed": speed, "reverse": reverse})
        self.refresh_tree()
        self._seg_push(_("添加片段"))
        return True

    def add_segment(self):
        """
        从界面输入添加片段。
        若结束时间为空，自动补全为视频总时长（直接使用浮点数，避免往返转换误差）。
        """
        start = self.start_entry.get().strip()
        end = self.end_entry.get().strip()

        if alert_if(not start, _("提示"), _("请填写开始时间")):
            return

        start_sec = time_to_seconds(start)
        if alert_if(start_sec is None, _("错误"), _("开始时间格式无效，请使用 HH:MM:SS.ms 或秒数"), 'error'):
            return

        # 如果结束时间为空，自动补全为视频总时长
        if not end:
            dur = self._get_input_duration()
            if dur is not None:
                end_sec = dur                     # 直接使用浮点数
                end = seconds_to_time(dur)        # 仅用于显示
                if self.app:
                    self.app._append_info_ui(_('[分段] 结束时间自动设为总时长: {0}').format(end))
            else:
                if not self._get_input_path():
                    messagebox.showerror(_("错误"), _("未指定输入文件，无法自动获取结束时间，请手动填写"))
                else:
                    messagebox.showerror(_("错误"), _("无法获取视频总时长，请手动填写结束时间"))
                return
        else:
            end_sec = time_to_seconds(end)
            if alert_if(end_sec is None, _("错误"), _("结束时间格式无效"), 'error'):
                return

        if alert_if(start_sec >= end_sec, _("错误"), _("开始时间必须小于结束时间"), 'error'):
            return

        # 仅对手动输入的结束时间进行超时检查（自动补全的已保证不超）
        if end:  # 用户手动输入
            dur = self._get_input_duration()
            if dur is not None:
                if abs(end_sec - dur) <= 0.001:
                    end_sec = dur
                    end = seconds_to_time(dur)
                if end_sec > dur + 0.001:
                    if self.app:
                        self.app._append_info_ui(_('[分段] 片段超出总时长: {0}->{1}，已跳过').format(start, end))
                    return

        flip_value = self.flip_combo.get()
        speed_value = self.speed_var.get().strip()
        reverse_value = self.reverse_var.get()
        self._seg_begin_edit()
        self.segments.append({"start": start, "end": end, "flip": flip_value, "speed": speed_value, "reverse": reverse_value})
        self.refresh_tree()
        self._seg_push(_("添加片段"))

    def delete_selected(self):
        selected = self.tree.selection()
        if not selected:
            return
        self._seg_begin_edit()
        # Treeview 的 iid 即片段在 self.segments 中的下标（refresh_tree 用 iid=str(i)）。
        # 多选删除：把所有选中下标收集起来，从大到小删，避免删前面的行后下标错位。
        indices = []
        for s in selected:
            try:
                indices.append(int(s))
            except (ValueError, TypeError):
                pass
        indices = sorted(set(indices), reverse=True)
        for idx in indices:
            if 0 <= idx < len(self.segments):
                del self.segments[idx]
        self.refresh_tree()
        self._seg_push(_("删除片段"))

    def move_up(self):
        selected = self.tree.selection()
        if not selected:
            return
        idx = int(selected[0])
        if idx == 0:
            return
        self._seg_begin_edit()
        self.segments[idx], self.segments[idx-1] = self.segments[idx-1], self.segments[idx]
        self.refresh_tree()
        self.tree.selection_set(str(idx-1))
        self._seg_push(_("上移"))

    def move_down(self):
        selected = self.tree.selection()
        if not selected:
            return
        idx = int(selected[0])
        if idx == len(self.segments)-1:
            return
        self._seg_begin_edit()
        self.segments[idx], self.segments[idx+1] = self.segments[idx+1], self.segments[idx]
        self.refresh_tree()
        self._seg_push(_("下移"))
        self.tree.selection_set(str(idx+1))

    def clear_all(self):
        if self.segments and messagebox.askyesno(_("确认"), _("确定清空所有片段吗？")):
            self._seg_begin_edit()
            self.segments.clear()
            self.refresh_tree()
            self._seg_push(_("清空所有"))

    def open_simple_preview_segment(self):
        """简易时间预览（纯帧浏览器）：用于标记分段并回写 / 发送到列表。
        - 选中列表片段后打开：设起点/终点回写该片段的 开始/结束（原功能保留）；
        - 未选中也能打开：可用「标记」打点 + 「发送到列表」/「复制时间」批量落段。
        不关闭窗口可连续设置；回填用 HH:MM:SS.ms（与片段存储格式一致）。"""
        sel = self.tree.selection()
        idx = int(sel[0]) if sel else None  # 未选中=None：仅预览/标记，不回填单行
        path = self._get_input_path()
        if alert_if(not path or not os.path.exists(path), _("错误"), _("输入文件不存在"), 'error'):
            return
        if alert_if(not self.app or not self.app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        release_grab(self.app.root)

        def on_start(t):
            if idx is None:
                return  # 未选中片段：起点仅用于预览定位，不回填
            self.segments[idx]["start"] = seconds_to_time(t)
            self.refresh_tree()
            self.tree.selection_set(str(idx))

        def on_end(t):
            if idx is None:
                return  # 未选中片段：终点仅用于预览定位，不回填
            self.segments[idx]["end"] = seconds_to_time(t)
            self.refresh_tree()
            self.tree.selection_set(str(idx))

        # 回溯标记段：单选 → 只回该段（同文字水印/轨迹）；未选中 → 全部段（批量复制用）
        if idx is not None:
            initial_marks = [(self.segments[idx].get("start"), self.segments[idx].get("end"))]
        else:
            initial_marks = [(seg.get("start"), seg.get("end")) for seg in self.segments]
        self.app.show_time_picker(self.app.root, path, on_set_start=on_start,
                                  on_set_end=on_end, initial_marks=initial_marks,
                                  use_output_context=False,
                                  on_send_segments=self._on_send_marks)

    def _on_send_marks(self, segments):
        """简易时间预览「发送到列表」回调：segments=[(s,e), ...]（秒）。
        追加到分段列表（不覆盖已有），复用 add_segment_with_time 的总时长校验。
        结果只写主窗口日志，不弹窗（弹窗会让预览窗口沉底、易堆积多个预览）。"""
        added = 0
        for s, e in segments:
            if self.add_segment_with_time(s, e, flip=_("无"), speed="1.0", reverse=False):
                added += 1
        self.refresh_tree()
        with suppress(Exception):
            if self.app:
                if added:
                    self._update_segment_total_label()
                    self.app._append_info_ui(_('[分段] 简易预览已追加 {0} 个片段到列表').format(added))
                else:
                    self.app._append_info_ui(_("[分段] 简易预览发送：没有可添加的片段（可能超出总时长）"))

    def refresh_tree(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        for i, seg in enumerate(self.segments):
            start = seg["start"]
            end = seg["end"]
            # ⚠️ 2026-10-11 修复：time_to_seconds 对空串/非法时间返回 None，必须先分别判空再相减。
            #   旧写法 `dur = t2s(end) - t2s(start)` 会在减法处 TypeError，后面的 `dur is not None`
            #   永远到不了（失效守卫）。口径对齐下方 _update_segment_total_label。
            _s = time_to_seconds(start)
            _e = time_to_seconds(end)
            dur_str = seconds_to_time(_e - _s) if (_s is not None and _e is not None) else "?"
            reverse_str = _("是") if seg.get("reverse", False) else _("否")
            speed_str = f"{seg.get('speed', '1.0')}x"
            self.tree.insert("", tk.END, iid=str(i), values=(i+1, start, end, dur_str, seg.get("flip", _("无")), reverse_str, speed_str))

        # 更新音频截取参考标签（分段视频总时长）
        self._update_segment_total_label()

    def _update_segment_total_label(self):
        """计算分段视频总时长（含逐段变速），更新显示标签。"""
        dur = 0.0
        for seg in self.segments:
            start = time_to_seconds(seg.get("start", ""))
            end = time_to_seconds(seg.get("end", ""))
            if start is not None and end is not None and end > start:
                d = end - start
                speed_str = seg.get("speed", "1.0").strip()
                try:
                    sf = float(speed_str)
                    if sf > 0:
                        d /= sf
                except (ValueError, TypeError):
                    pass
                dur += d
            else:
                self.segment_total_label.config(text=_("分段视频总时长: ?"))
                return
        if dur > 0:
            self.segment_total_label.config(
                text=_('分段视频总时长: {0}:.1f秒 ({1})').format(dur, seconds_to_time(dur)))
        else:
            self.segment_total_label.config(text=_("分段视频总时长: 0秒（请添加片段）"))

    def _on_audio_trim_toggle(self):
        """根据复选框状态启用/禁用起止时间输入框。"""
        state = tk.NORMAL if self.audio_trim_enabled_var.get() else tk.DISABLED
        self.at_start_entry.config(state=state)
        self.at_end_entry.config(state=state)

    def _get_input_path(self):
        """返回应使用的输入文件路径（批量队列注入 > 主界面）。"""
        path = self._custom_input_file
        if path and os.path.exists(path):
            return path
        if self.app and hasattr(self.app, "input_file"):
            return self.app.input_file.get().strip() or ""
        return ""

    def _get_input_duration(self):
        """获取输入文件总时长（秒），失败返回 None。"""
        path = self._get_input_path()
        if not path:
            return None
        if self.app:
            return self.app._get_media_duration(path)
        return None


    # ---------- 列表交互：单击取消选择 / 双击编辑 ----------
    def on_tree_click_clear_selection(self, event):
        """单击表头 / 列分隔线 / 列表下方空白区 → 取消选择（2026-09-08）。

        用途：「简易时间预览」在**未选中任何片段**时会载入全部片段的标记（批量用），
        而 Treeview 的默认行为点空白并不清空选中，以前只能重开窗口才能回到「全选标记」状态。

        ⚠️ 只在确实点到了「非行」区域时才清空：行内的选中交给 Tk 自己的 class 绑定处理。
        （widget 级 bind 先于 class 绑定执行，若在这里误清会被随后的 class 选中覆盖。）
        """
        try:
            region = self.tree.identify_region(event.x, event.y)
        except Exception:
            region = ""
        row = self.tree.identify_row(event.y)
        if region in ("heading", "separator") or not row:
            sel = self.tree.selection()
            if sel:
                self.tree.selection_remove(*sel)

    def on_tree_double_click(self, event):
        """双击列表行 → 编辑该片段。

        用 identify_row(event.y) 定位而不是直接取 selection()：点在表头或空白区时
        identify_row 返回空，此时直接返回，避免「点空白却改了上次选中的片段」。
        """
        row = self.tree.identify_row(event.y)
        if not row:
            return
        self.tree.selection_set(row)
        self.edit_selected()

    def edit_selected(self):
        """编辑当前选中片段（双击行 / 「编辑」按钮共用入口）。"""
        selected = self.tree.selection()
        if alert_if(not selected, _("提示"), _("请先选中一个片段"), 'info'):
            return
        idx = int(selected[0])
        if idx < 0 or idx >= len(self.segments):
            return
        seg = self.segments[idx]

        dialog = EditSegmentDialog(self.window, _("编辑片段"),
                                   start=seg["start"], end=seg["end"], flip=seg["flip"],
                                   speed=seg.get("speed", "1.0"), reverse=seg.get("reverse", False))
        if dialog.start is not None and dialog.end is not None:
            start_sec = time_to_seconds(dialog.start)
            end_sec = time_to_seconds(dialog.end)
            if alert_if(start_sec is None or end_sec is None, _("错误"), _("时间格式无效"), 'error'):
                return
            if alert_if(start_sec >= end_sec, _("错误"), _("开始时间必须小于结束时间"), 'error'):
                return

            start_display = seconds_to_time(start_sec)
            end_display = seconds_to_time(end_sec)

            # 检查并修正接近总时长的时间
            dur = self._get_input_duration()
            if dur is not None:
                if abs(end_sec - dur) <= 0.001:
                    end_sec = dur
                    end_display = seconds_to_time(end_sec)
                if end_sec > dur + 0.001:
                    if self.app:
                        self.app._append_info_ui(_('[分段] 片段超出总时长: {0}->{1}，已跳过').format(start_display, end_display))
                    return

            # 存储用户输入的原始字符串（以便显示时与输入一致）
            seg["start"] = dialog.start
            seg["end"] = dialog.end
            seg["flip"] = dialog.flip
            seg["speed"] = dialog.speed
            seg["reverse"] = dialog.reverse
            self.refresh_tree()
            # 刷新后保持选中刚编辑的那行（iid 即索引字符串，与 move_up/down 写法一致）
            self.tree.selection_set(str(idx))

