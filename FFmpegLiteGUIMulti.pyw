                        _cb(_opt_float(_rs_dvar.get(), 0.0))
                # 角度一变即按新 rot 重画叠加层（无需等拖拽）→ 旋转中的虚拟框跟随
                _invoke_bg_live_draw()

            def _rs_from_scale(*_a):
                if _rs_lock[0]:
                    return
                _rs_lock[0] = True
                try:
                    _rs_svar.set("%g" % round(_opt_float(_rs_dvar.get(), 0.0), 1))
                finally:
                    _rs_lock[0] = False
                _rs_fire()

            def _rs_from_entry(*_a):
                if _rs_lock[0]:
                    return
                _rs_lock[0] = True
                try:
                    _v = _opt_float(_rs_svar.get(), 0.0)
                    if _v < 0.0 or _v > 360.0:
                        return                     # 超界先不动，等失焦/回车再夹
                    _rs_dvar.set(_v)
                finally:
                    _rs_lock[0] = False
                _rs_fire()

            def _rs_clamp():
                _rs_lock[0] = True
                try:
                    _v = min(360.0, max(0.0, _opt_float(_rs_svar.get(), 0.0)))
                    _rs_svar.set("%g" % round(_v, 1))
                    _rs_dvar.set(_v)
                finally:
                    _rs_lock[0] = False
                _rs_fire()

            _rs_dvar.trace_add("write", _rs_from_scale)
            _rs_svar.trace_add("write", _rs_from_entry)
            _rs_entry.bind("<Return>", lambda _e: (_rs_clamp(), _rs_entry.select_range(0, "end"))[0])
            _rs_entry.bind("<FocusOut>", lambda _e: _rs_clamp())
            if rot_slider.get("tip"):
                ToolTip(_rs_scale, rot_slider["tip"])

        # 微调按钮：移动 / 减 / 加 三行，各自带步进（2026-08-26 与裁剪可视化同套语义）。
        # show_nudge=False 时整段跳过。
        if show_nudge:
            nudge_frame = ttk.LabelFrame(right_frame, text=_("微调 (像素)"), padding=3)
            nudge_frame.pack(anchor="w", pady=(2, 2))

            def nudge_rect(kind, direction, step):
                nonlocal current_x, current_y, current_w, current_h
                if draw_mode_active:
                    return
                # 2026-09-10：微调纯计算收编 _rect_kit.rk_nudge（语义逐字一致，
                # w/h 下限 1 也在库内）；钳制仍由 clamp_rect 收口。
                current_x, current_y, current_w, current_h = rk_nudge(
                    kind, direction, step,
                    current_x, current_y, current_w, current_h)
                clamp_rect()
                update_rect_position()

            _nstep = {}
            for _kind, _labels in [("move", [(_("上移"), "up"), (_("下移"), "down"), (_("左移"), "left"), (_("右移"), "right")]),
                                   ("shrink", [(_("上减"), "top"), (_("下减"), "bottom"), (_("左减"), "left"), (_("右减"), "right")]),
                                   ("grow", [(_("上加"), "top"), (_("下加"), "bottom"), (_("左加"), "left"), (_("右加"), "right")])]:
                _nr = ttk.Frame(nudge_frame)
                _nr.pack(fill=tk.X, pady=1)
                for _label, _dir in _labels:
                    ttk.Button(_nr, text=_label, width=4,
                               command=lambda k=_kind, d=_dir: nudge_rect(k, d, _nstep_get(_kind))).pack(
                        side=tk.LEFT, padx=1)
                ttk.Label(_nr, text=_("步进:")).pack(side=tk.LEFT, padx=(6, 2))
                _sv = tk.StringVar(value="1")
                _nstep[_kind] = _sv
                ttk.Spinbox(_nr, textvariable=_sv, from_=1, to=999, width=4).pack(side=tk.LEFT)

            def _nstep_get(kind):
                try:
                    return int(_nstep[kind].get())
                except (ValueError, TypeError, KeyError):
                    return 1

        # ---- 缩放倍率滑块（content_src_* 提供时启用）：滑块 + 数字框双向同步 ----
        def _on_scale_slider(v):
            """滑块拖动：以内容中心为锚点改变矩形尺寸（=改变缩放倍率），保持位置视觉连续。"""
            # ⚠️ 必须声明 nonlocal：本函数会写 current_* 几何量。漏了 nonlocal 时 Python
            # 会把它们当**局部变量**，于是下方 `cx0 = current_x + current_w/2.0` 在读一个
            # 「尚未赋值的局部变量」→ UnboundLocalError，滑块一动就抛异常、表现就是「缩放完全没用
            # /拖不动/点了应用也没数值回来」（2026-09-12 实测根因，别再删这行）。
            nonlocal current_x, current_y, current_w, current_h
            # 2026-09-12：本回调也可能由 _sync_scale_display 回写 scale_pct 触发，
            # 此时必须直接返回——否则与回写互触发形成无限递归。
            if _scale_sync_lock[0]:
                return
            if not content_src_w or content_src_w <= 0:
                return
            pct = max(5.0, min(500.0, float(v)))
            new_w = content_src_w * pct / 100.0
            new_h = content_src_h * pct / 100.0
            cx0 = current_x + current_w / 2.0
            cy0 = current_y + current_h / 2.0
            current_w = max(2, int(round(new_w)))
            current_h = max(2, int(round(new_h)))
            current_x = cx0 - current_w / 2.0
            current_y = cy0 - current_h / 2.0
            clamp_rect()
            update_rect_position()

        def _on_scale_entry():
            """数字框输入（键盘）：回车/失焦时归一并同步滑块。"""
            if scale_entry is None:
                return
            v = _opt_float(scale_entry.get(), scale_pct.get())
            _on_scale_slider(v)

        def _on_corner():
            """八向位置预设（条件调用）：把内容中心偏移到 (cx*W*倍率, cy*H*倍率)。

            (0,0) = 归位到画布正中心（canonical「reset」= X/Y 偏移归零）。
            基准尺寸优先用 corner_src_w/h，缺省回落 content_src_w/h。
            倍率取「当前矩形宽 / 内容源宽」，与缩放滑块口径一致。
            """
            nonlocal current_x, current_y
            if not corner_dirs or draw_mode_active:
                return
            # 按索引取方向（不做显示文本匹配）：canonical 与 UI 语言/译文解耦，换语言不会错位
            _ci = corner_combo.current()
            if not (0 <= _ci < len(corner_dirs)):
                return
            cx, cy = float(corner_dirs[_ci][1]), float(corner_dirs[_ci][2])
            bw = corner_src_w or content_src_w or 0
            bh = corner_src_h or content_src_h or 0
            if not bw or not bh:
                return
            sc = (current_w / float(content_src_w)) if content_src_w else 1.0
            new_cx = current_canvas_w / 2.0 + cx * bw * sc
            new_cy = current_canvas_h / 2.0 + cy * bh * sc
            current_x = new_cx - current_w / 2.0
            current_y = new_cy - current_h / 2.0
            update_rect_position()
            # 与拖拽松手同口径：选完方向即回写（列表/航点实时刷新），不必等点「应用」
            _fire_drag_commit()

        # ---- 起始/结尾切换 + 缩放（右栏纵向排布，2026-09-12 迁入右栏）----
        # 切换 Radiobutton 是独立普通 Frame，绝不塞进「缩放」LabelFrame 内部。
        # 右栏窄（RIGHT_PANEL_WIDTH），故切换与缩放各占一行（切换在上、缩放在下）。
        if se_var is not None or (content_src_w and content_src_h):
            if se_var is not None:
                se_row = ttk.Frame(right_frame)
                se_row.pack(anchor="w", pady=(2, 0))
                for _w in ("start", "end"):
                    ttk.Radiobutton(se_row, text=(_("起始") if _w == "start" else _("结尾")),
                                    variable=se_var, value=_w,
                                    command=lambda w=_w: _switch_end(w)).pack(side=tk.LEFT, padx=4)
            if content_src_w and content_src_h:
                scale_frame = ttk.LabelFrame(right_frame, text=_("缩放 (倍率)"), padding=3)
                scale_frame.pack(anchor="w", pady=(2, 2))
                scale_pct = tk.DoubleVar(
                    value=round(current_w / content_src_w * 100.0, 1))
                sc_slider = ttk.Scale(scale_frame, from_=5, to=500, orient=tk.HORIZONTAL,
                                      length=200, variable=scale_pct,
                                      command=lambda v: _on_scale_slider(float(v)))
                sc_slider.pack(side=tk.LEFT, padx=4)
                scale_entry = ttk.Entry(scale_frame, width=7)
                scale_entry.pack(side=tk.LEFT, padx=2)
                scale_entry.bind("<Return>", lambda e: _on_scale_entry())
                scale_entry.bind("<FocusOut>", lambda e: _on_scale_entry())
                ttk.Label(scale_frame, text="%").pack(side=tk.LEFT)
                # 注：八向位置预设下拉不在此行——已移到「绘制新矩形/取消绘制」同一行（见上方 draw_btn_frame）。

        # 通用操作按钮（右栏底部）
        action_frame = ttk.Frame(right_frame)
        action_frame.pack(anchor="w", pady=10, side=tk.BOTTOM)
        ttk.Button(action_frame, text=_("应用"), command=apply).pack(side=tk.LEFT, padx=5)
        ttk.Button(action_frame, text=_("取消"), command=cancel).pack(side=tk.LEFT, padx=5)
        ttk.Button(action_frame, text=_("重置位置"), command=reset_position).pack(side=tk.LEFT, padx=5)
        # 点窗口×关闭 = 提交当前端后关闭（与应用同口径，避免未点「应用」导致结束端丢失）
        with suppress(Exception):
            win.protocol("WM_DELETE_WINDOW", apply)

        if show_scale_tip:
            tip_text = _("提示：重新绘制矩形时，如果比例不对，请先返回上一个界面取消「缩放」的勾选，已保存的上一次缩放会干扰裁剪属性。")
            # 迁入右栏：右栏定宽，wraplength 直接用面板宽，静态折行即可（不再随窗口宽度动态计算）
            tip_label = ttk.Label(right_frame, text=tip_text, foreground="gray",
                                  justify=tk.LEFT, wraplength=RIGHT_PANEL_WIDTH - 12)
            tip_label.pack(fill=tk.X, padx=4, pady=5)

        # 绑定事件
        canvas.tag_bind("rect", "<Button-1>", start_move)
        canvas.tag_bind("rect", "<B1-Motion>", on_move)
        canvas.tag_bind("rect", "<ButtonRelease-1>", stop_move)
        if rotation_enabled and angle_editable:
            canvas.tag_bind("rothead", "<Button-1>", start_rotate)
            canvas.tag_bind("rothead", "<B1-Motion>", on_rotate)
            canvas.tag_bind("rothead", "<ButtonRelease-1>", stop_rotate)
        canvas.bind("<Button-1>", start_draw, add=True)
        canvas.bind("<B1-Motion>", on_draw_move, add=True)
        canvas.bind("<ButtonRelease-1>", end_draw, add=True)

        # ---- Alt+左键 = 随时重选范围（等同点「绘制新矩形」再拖，无需先点按钮）----
        # 2026-09-02 修正：不是「无限绘制 / 越界」，只是跳过「先点绘制按钮」这一步。
        def alt_start_draw(event):
            """Alt+左键拖拽 = 直接重选范围（等同点「绘制新矩形」再拖）。

            ⚠️ Tk bind 匹配：模式里未列出的修饰符不影响匹配——<Button-1> 也会在
            Alt+左键时触发，故矩形 tag 的 start_move 可能已把 dragging 置 True；
            这里强制清掉，且绘制相关回调都有 draw_mode_active 守卫，互不干扰。
            """
            nonlocal draw_start, draw_rect_temp, draw_mode_active, dragging
            if not allow_resize or draw_mode_active:
                return
            dragging = False
            if draw_rect_temp:
                canvas.delete(draw_rect_temp)
                draw_rect_temp = None
            draw_mode_active = True
            draw_start = to_real(event.x, event.y)
            if 'draw_btn' in globals():
                try:
                    draw_btn.config(state="disabled")
                    draw_abort_btn.config(state="normal")
                except Exception:
                    pass
            status_var.set(_("Alt 绘制：按住左键拖拽重新选择范围，松开落定"))
        canvas.bind("<Alt-Button-1>", alt_start_draw, add=True)

        # 方向键微调（点击矩形后可用，每次 1px）
        def arrow_move(event):
            nonlocal current_x, current_y
            if draw_mode_active:
                return
            if event.keysym == 'Left':
                current_x -= 1
            elif event.keysym == 'Right':
                current_x += 1
            elif event.keysym == 'Up':
                current_y -= 1
            elif event.keysym == 'Down':
                current_y += 1
            else:
                return
            clamp_rect()
            update_rect_position()
            status_var.set(_('方向键微调: ({0}, {1})  [可用 ↑↓←→ 继续调整]').format(current_x, current_y))
        canvas.bind("<Left>", arrow_move)
        canvas.bind("<Right>", arrow_move)
        canvas.bind("<Up>", arrow_move)
        canvas.bind("<Down>", arrow_move)
    
        # 初始化
        clamp_rect()
        rect_id, text_id = create_rect()
        _draw_ghost()
        # 起始/结尾类窗口：把初始活动端的角度同步进调用方缓冲（画布编辑器的
        # captured 必须与当前端一致，后续任何 on_apply 才不会写错另一端角度）。
        if start_end is not None:
            _sync_angle_cb()
        _schedule_content_render()
        update_coord_display()
        if rect_color == 'deepskyblue':
            status_var.set(_("拖拽蓝色矩形移动，调整主视频内容在画布中的位置。"))
        elif rotation_enabled and angle_editable:
            status_var.set(_("红色多边形=旋转后的子视频（已钳制当前角度）。拖拽移动/调整大小，"
                           "拖黄色圆点旋转角度，点「应用」写回。有旋转时 X/Y 为内容盒左上角（旋转正方形自动居中）。"))
        elif rotation_enabled:
            status_var.set(_("蓝色矩形=主视频内容，已显示旋转状态（档位角度，仅指示不可拖转）。"
                           "拖拽移动/调整画布，点「应用」写回。"))
        else:
            status_var.set(_("红色矩形可拖拽移动。"))
        # ⚠️ 该帧现在也可能只承载八向方向下拉（allow_resize=False + corner_dirs）——
        # 那种情况下必须保留，否则下拉被藏掉等于功能消失。
        if not allow_resize and not corner_dirs and 'draw_btn_frame' in locals():
            draw_btn_frame.pack_forget()
    
        # 2026-09-12：两栏布局后，窗口宽 = 画布宽 + 右栏宽（不再为「下方控件区」留高度）。
        # 2026-09-23：画布显示区全量放开到「可视化裁剪窗口画布区」口径（见函数开头），
        # 窗口随之变大；高度下限 720（保证右栏控件完整显示），统一钳进屏幕内。
        _scr_w = win.winfo_screenwidth()
        _scr_h = win.winfo_screenheight()
        _win_w = min(disp_w + 2 * PAD + RIGHT_PANEL_WIDTH + 40, int(_scr_w * 0.95))
        _win_h = max(disp_h + 2 * PAD + 24, 720)
        _win_h = min(_win_h, int(_scr_h * 0.94))
        center_window(win, _win_w, _win_h)
        win.wait_window()
        parent.lift()
        parent.focus_force()


    # ---------- 主视频位置可视化编辑器 ----------
    def open_visual_pad_editor(self, track_idx, pad_w_var, pad_h_var, off_x_var, off_y_var,
                               live_filt_frame=None, parent=None):
        track = self.merge_tracks[track_idx]
        if track.type != "video":
            return
    
        enabled_videos = self._get_enabled_video_tracks()
        if alert_if(not enabled_videos, _("错误"), _("没有启用的视频轨道"), 'error'):
            return
        main_track = enabled_videos[0]
        sub_tracks = enabled_videos[1:]
    
        # ---- 主视频渲染尺寸：优先使用 live_filt_frame 的实时值 ----
        if live_filt_frame is not None:
            main_settings = {
                "crop_enabled": live_filt_frame.crop_enabled.get(),
                "crop_width": live_filt_frame.crop_width.get(),
                "crop_height": live_filt_frame.crop_height.get(),
                "scale_enabled": live_filt_frame.scale_enabled.get(),
                "scale_method": live_filt_frame.scale_method.get(),
                "scale_width": live_filt_frame.scale_width.get(),
                "scale_height": live_filt_frame.scale_height.get(),
                "rotate": live_filt_frame.rotate.get()
            }
            orig_w, orig_h = self._cached_video_dimensions(main_track.file_path)
            if orig_w is None or orig_h is None:
                orig_w, orig_h = 1280, 720
            main_render_w, main_render_h = self.compute_final_size_with_order(orig_w, orig_h, main_settings)
        else:
            main_render_w, main_render_h = self._get_video_render_size(main_track)
            if alert_if(main_render_w is None, _("错误"), _("无法获取主视频渲染尺寸"), 'error'):
                return
    
        # 获取当前画布尺寸
        try:
            canvas_w = int(pad_w_var.get().strip()) if pad_w_var.get().strip() else 0
            canvas_h = int(pad_h_var.get().strip()) if pad_h_var.get().strip() else 0
            if canvas_w <= 0 or canvas_h <= 0:
                raise ValueError
        except:
            canvas_w, canvas_h = main_render_w, main_render_h
            pad_w_var.set(str(canvas_w))
            pad_h_var.set(str(canvas_h))
    
        # 获取当前偏移
        try:
            off_x = int(off_x_var.get()) if off_x_var.get().strip() else 0
            off_y = int(off_y_var.get()) if off_y_var.get().strip() else 0
        except:
            off_x, off_y = 0, 0
    
        # 定义应用回调
        def apply_pad(new_x, new_y, new_w, new_h, new_canvas_w, new_canvas_h):
            # 更新轨道设置
            track.enc_settings['pad_enabled'] = True
            track.enc_settings['pad_width'] = str(new_canvas_w)
            track.enc_settings['pad_height'] = str(new_canvas_h)
            track.enc_settings['offset_x'] = str(new_x)
            track.enc_settings['offset_y'] = str(new_y)
            # 同步属性
            track.pad_enabled = True
            track.pad_width = str(new_canvas_w)
            track.pad_height = str(new_canvas_h)
            track.offset_x = str(new_x)
            track.offset_y = str(new_y)
            # 更新界面变量
            pad_w_var.set(str(new_canvas_w))
            pad_h_var.set(str(new_canvas_h))
            off_x_var.set(str(new_x))
            off_y_var.set(str(new_y))
            self.merge_refresh_ui()
            self._append_info_ui(_('[可视化-主] 已设置画布 {0}x{1}, 偏移 ({2}, {3})').format(new_canvas_w, new_canvas_h, new_x, new_y))
    
        # 背景绘制函数（显示其他子视频虚线框）
        def draw_bg(canvas, scale_x, scale_y=None):
            # 主视频内容矩形（用于绘制主视频边界）
            main_render_size = (main_render_w, main_render_h)
            self._draw_background(canvas, canvas_w, canvas_h, scale_x, main_track, sub_tracks,
                                  off_x, off_y, main_render_size, current_edit_track=None, tag="bg",
                                  scale_y=scale_y)
    
        # 调用通用编辑器
        self._generic_overlay_editor(
            parent=parent or self.root,
            canvas_w=canvas_w,
            canvas_h=canvas_h,
            rect_x=off_x,
            rect_y=off_y,
            rect_w=main_render_w,
            rect_h=main_render_h,
            on_apply=apply_pad,
            title=_("可视化编辑画布偏移 - 拖拽蓝色矩形"),
            aspect_ratio=None,
            bg_draw_func=draw_bg,
            allow_resize=False,
            show_canvas_controls=True,
            coord_mode='offset',
            allow_negative_offset=True,   # 允许负偏移
            rect_color='deepskyblue',      # 蓝色
            rect_label=_('主视频'),
            min_visible_pixels=10,
            show_nudge=False   # 封装页主视频位置编辑器：虚拟画布，无微调按钮
        )

    # ---------- 水印位置可视化编辑器 ----------
    def open_watermark_overlay_editor(self, canvas_w, canvas_h, wm_w, wm_h, x_var, y_var,
                                      scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
                                      watermark_dict=None, filt_frame=None, parent=None,
                                      free_layout=False, ov_angle_var=None, main_video_file=None,
                                      main_offset=(0, 0), main_render_size=None,
                                      bg_pre_filter=None, angle_cb=None, init_angle=None,
                                      on_apply=None, initial_time=None, on_drag_commit=None,
                                      aspect_ratio="auto", angle_editable=True,
                                      corner_dirs=None, corner_src_w=None, corner_src_h=None,
                                      start_end=None,     # 2026-09-12：起始/结尾双端（透传 _generic_overlay_editor）
                                      pad=None,           # 2026-09-12：辅助灰边宽（透传；None=自适应，
                                                          # 起始/结尾类窗口自动用 RK_PAD_WIDE=20）
                                      reset_origin=False,  # 2026-09-12：「重置位置」语义（透传）
                                      ghost_color=None,    # 2026-09-12：幽灵框颜色（透传；None=自适应青色）
                                      content_src_w=None,  # 2026-09-14：内容源宽（透传 _generic_overlay_editor；
                                                           #   非空即启用「缩放 (倍率)」滑块，100%=content_src_w）
                                      content_src_h=None,  # 2026-09-14：内容源高（透传；缩放滑块模式）
                                      allow_upscale=False, # 2026-09-22：允许放大显示（透传；遮罩画布=子视频缩放后尺寸时帧极小）
                                      frame_extractor=None,  # ⚠️ 节点语境：透传「节点时间轴取帧器」给 _generic_overlay_editor._extract；None=旧行为（主视频 bg_file）
                                      content_alpha=False,  # 2026-10-05：透传「内容帧透明模式」（虚拟框内渲染真实帧）
                                      content_file=None,    # 2026-10-05：内容媒体文件（虚拟框内渲染真实帧用）
                                      content_time=0.0,     # 2026-10-05：内容帧取帧时刻（秒）
                                      free_layout_var=None, # 2026-10-05：编辑器内「放开边界」开关（透传，双向同步父级复选框）
                                      content_rgba=False,  # 2026-10-05：内容=带 alpha 的真实文字（文字水印轨迹航点预览用）
                                      draw_diagonal=True,   # 2026-10-05：透传「矩形是否填斜纹」。
                                                            # True=旧行为（gray50 斜纹填充）；False=仅描边
                                                            # ⇒ 框内透明，直接透出背景真实帧（列表轨迹航点编辑器用）
                                      coord_box=False,     # 2026-10-09：透传「坐标（回车生效）」四格
                                                            # （宽/高 + 左/上 + 复制/粘贴，双向同步）。
                                      nudge_rows=False,   # 2026-10-09：透传「边缘/平移微调」三行。
                                                            # False=不创建；
                                                            # ⚠️ 必须放签名末尾——旧调用点有按位置传参（同 _generic_overlay_editor）。
                                                            # 目前仅遮罩「🎯 可视化选区」传 True。
                                      bg_shape_outlines=None,  # 2026-10-11：可复用开关——传
                                                            # (shapes, highlight_indices) 即在编辑器画布上叠
                                                            # 「各形状精确轮廓虚线」（拼接对齐；高亮行实线、
                                                            # 其余浅绿虚线）。None=不开（默认，旧调用点零变化）。
                                                            # ⚠️ 仍须保持签名最末（旧的按位置传参不受影响）。
                                      bg_shape_outlines_live=None,  # 2026-10-11：轮廓的「实时跟随」版
                                                            # （透传 _generic_overlay_editor 的 bg_live_draw_func）。
                                                            # 签名 (canvas, scale_x, scale_y, live)，live=(x,y,w,h,rot)。
                                                            # 传了才在拖拽/微调/旋转中重画轮廓。None=不跟随（旧行为）。
                                      rot_slider=None,       # 2026-10-11：右栏「旋转」滑块（透传 rot_slider）——
                                                            # dict {"var":DoubleVar(0~360), "cb":f(v), "tip":str}。
                                                            # 仅遮罩「🎯 可视化选区」（源形状）用；None=不创建。
                                      content_ppm=None,      # 🔴 2026-10-17：**内容帧的 PPM 字节**（已解码，全内存）。
                                                            # 透传 `_generic_overlay_editor`；给了它 ⇒ 内容帧
                                                            # **零磁盘**（不 seek 源文件、不写临时文件）。
                                                            # 与 content_file 二选一，**本参数优先**。
                                  content_chroma_settings=None):  # 2026-10-11：虚拟框内渲染绿幕——
                                                            # 子视频轨 enc_settings（含 chroma_enabled 等），
                                                            # 透传 _generic_overlay_editor；None=不接（旧调用零变化）。
                                                            # ⚠️ 放签名最末（旧的按位置传参不受影响）。
        """
        水印可视化编辑器，支持回写位置和缩放尺寸，以及更新水印字典和滤镜框架。
        free_layout=True 时放开边界（子视频可拖出画布、可比主视频大）。
        allow_upscale: False（默认）=画布大于显示区时钳 1.0（旧行为）；True=允许放大显示
                       （画布小于显示区时放大适配窗口）。透传 _generic_overlay_editor 同名参数。
        ov_angle_var: OverlayPositionFrame 的 rotate_angle DoubleVar（应用时写回角度）
        aspect_ratio: "auto"（默认）=按水印/挡板当前宽高比锁定「绘制新矩形」的比例；
                      None=自由矩形（遮罩挡板宽高独立，2026-09-10 修「只能画正方形」）。
                      ⚠️ 参数必须放签名末尾——旧调用点有按位置传参（同 _generic_overlay_editor 约定）。
        angle_editable: False=不显示旋转手柄、禁角度编辑（遮罩轨迹：链路不消费 ra/rb，
                        显示可旋转 UI 会所见非所得）。透传 _generic_overlay_editor 同名参数。
        corner_dirs/corner_src_w/corner_src_h: 2026-09-12 八向位置预设（条件调用，透传）。
                        None=不创建下拉；传值时下拉出现在「绘制新矩形/取消绘制」同一行右侧。
                        corner_src_w/h 缺省回落 content_src_w/h（本包装器未启用缩放倍率，故必传）。
        """
        # 水印静态旋转角度（rotate_angle），旋转后为 hypot 正方形包围盒
        _wm_ra = _opt_float((watermark_dict or {}).get("rotate_angle", 0) or 0, 0.0)
        if ov_angle_var is not None:
            try:
                _wm_ra = float(ov_angle_var.get() or 0)
            except (ValueError, TypeError):
                pass
        if init_angle is not None:
            # 2026-09-02：轨迹航点编辑——初始旋转角直接由调用方指定（ra/rb），不走 watermark_dict
            _wm_ra = _opt_float(init_angle or 0.0, 0.0)
        _wm_spin = bool((watermark_dict or {}).get("spin_enabled", False))
        # 解析当前坐标：overlay_x/y 的 w/h 恒为内容盒（wm_w/wm_h，2026-08-26 统一）；
        # 旋转时 d×d 正方形由编辑器内部自动居中（锚点=内容盒左上角），不再按 d 求值。
        # 默认摆放（x/y 表达式无法解析时）→ 右下角，内缩 RK_PLACE_INSET。
        # ⚠️ 内缩量是【内容像素】(与 canvas_w/h 同域)，用 RK_PLACE_INSET 而不是辅助灰边 PAD：
        #    PAD 是显示层像素且随「窗口是否带起始/结尾」在 10/20 浮动（遮罩窗口带双端 → 20），
        #    绑上去会让默认摆放位置跟着窗口类型变（2026-09-12 修正）。
        #    max(0,...) 防「水印/挡板比画布大」时落负值。
        rect_x = safe_eval_expr(x_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})
        if rect_x is None:
            rect_x = max(0, canvas_w - wm_w - RK_PLACE_INSET)
        rect_y = safe_eval_expr(y_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})
        if rect_y is None:
            rect_y = max(0, canvas_h - wm_h - RK_PLACE_INSET)
        if not free_layout:
            rect_x = max(0, min(rect_x, canvas_w - wm_w))
            rect_y = max(0, min(rect_y, canvas_h - wm_h))
    
        def _wm_builtin_on_apply(new_x, new_y, new_w, new_h, new_canvas_w, new_canvas_h):
            # 更新位置变量
            x_var.set(str(new_x))
            y_var.set(str(new_y))
            # 更新缩放控件
            if scale_enabled_var is not None:
                scale_enabled_var.set(True)
            if scale_w_var is not None:
                scale_w_var.set(str(new_w))
            if scale_h_var is not None:
                scale_h_var.set(str(new_h))
            # 更新水印设置字典（如果提供）
            if watermark_dict is not None:
                watermark_dict["scale_width"] = str(new_w)
                watermark_dict["scale_height"] = str(new_h)
                watermark_dict["scale_method"] = "exact"
                watermark_dict["scale_enabled"] = True
            # 同步滤镜框架的缩放控件（如果提供）
            if filt_frame is not None:
                filt_frame.scale_enabled.set(True)
                filt_frame.scale_method.set("exact")
                filt_frame.scale_width.set(str(new_w))
                filt_frame.scale_height.set(str(new_h))
            self._append_info_ui(_('[可视化-水] 已保存位置: ({0}, {1}) 尺寸: {2}x{3}').format(new_x, new_y, new_w, new_h))

        def apply_wm_angle(new_angle):
            # 2026-09-02：轨迹航点编辑——angle_cb 优先（写回航点 ra/rb），否则回退水印静态旋转
            if angle_cb is not None:
                with suppress(Exception):
                    angle_cb(float(new_angle or 0.0))
                return
            if watermark_dict is not None:
                watermark_dict["rotate_angle"] = float(new_angle or 0.0)
            if ov_angle_var is not None:
                with suppress(Exception):
                    ov_angle_var.set(float(new_angle or 0.0))

        title = _("可视化编辑水印位置及大小")
        # aspect_ratio 语义（2026-09-10）："auto"（默认）=旧行为，按水印/挡板当前宽高比锁定
        # 「绘制新矩形」的比例；None=自由矩形。⚠️ 遮罩挡板宽高独立，且初始常为正方形
        # （mask_w=mask_h=100）→ aspect=1.0 → 绘制恒出正方形拉不动（用户实测），故遮罩
        # 调用点显式传 None；水印/画中画保持 "auto" 锁比例。
        aspect = aspect_ratio
        if aspect == "auto":
            aspect = None
            if wm_h and wm_h > 0:
                aspect = wm_w / wm_h
        _cb = on_apply if on_apply is not None else _wm_builtin_on_apply
        # 2026-10-11：可复用开关 —— 传了 (shapes, highlight_indices) 就在编辑器画布上叠
        # 「各形状精确轮廓虚线」（拼接对齐）。None=不开（默认，其余调用点逐字节不变）。
        _shape_outline_drawer = None
        if bg_shape_outlines is not None:
            try:
                _ol_shapes, _ol_hl = bg_shape_outlines
            except (TypeError, ValueError):
                _ol_shapes, _ol_hl = [], set()

            def _shape_outline_drawer(canvas, scale_x, scale_y=None):
                # 画布坐标 = 编辑器内容坐标（canvas_w×canvas_h）⇒ 乘 scale_x/scale_y 得图像坐标；
                # 随背景一起被 _generic_overlay_editor 统一平移 PAD（故在 bg_draw_func 内绘制即可）。
                _sy = scale_x if scale_y is None else scale_y
                draw_mask_shape_outlines(canvas, _ol_shapes, _ol_hl,
                                         lambda px, py: (px * scale_x, py * _sy),
                                         tag="mask_outline")

        self._generic_overlay_editor(parent or self.root, canvas_w, canvas_h,
                                     rect_x, rect_y, wm_w, wm_h,
                                     _cb, title, aspect, bg_draw_func=_shape_outline_drawer,rect_label=_('水印'),
                                     min_visible_pixels=0,show_scale_tip=True,
                                     allow_negative_offset=free_layout,
                                     free_layout_var=free_layout_var,
                                     rotate_angle=_wm_ra, angle_cb=apply_wm_angle,
                                     angle_editable=angle_editable,   # False=无旋转手柄（遮罩：链路不消费角度）
                                     show_nudge=False,   # 图片水印位置编辑器：无微调按钮
                                     # ⚠️ 2026-08-27 修复：背景帧来源参数化——旧代码硬编码
                                     # 转换页 input_file，封装页场景（画布=merge_video）背景帧
                                     # 读错源导致黑画布。调用方（_edit_wp_point/_edit_tw_wp_point）
                                     # 传入实际主视频；None 时保持旧行为（转换页 input_file）。
                                     main_video_file=main_video_file if main_video_file is not None
                                     else getattr(self, 'app', self).input_file.get().strip(),
                                     main_offset=main_offset,
                                     main_render_size=main_render_size,  # 背景帧=主视频当前帧；offset/render_size 供 pad 摆放
                                     bg_pre_filter=bg_pre_filter,  # 主视频 crop/rotate 预处理（防背景帧变形）
                                     initial_time=initial_time,   # 背景帧取帧时间（航点列表轨迹=该航点自身时间）
                                     on_drag_commit=on_drag_commit,   # 2026-09-03：拖拽松手即回写（航点列表实时刷新）
                                     # 2026-09-12：八向位置预设（条件调用）——遮罩 起始/结尾坐标 用
                                     corner_dirs=corner_dirs,
                                     corner_src_w=corner_src_w,
                                     corner_src_h=corner_src_h,
                                     start_end=start_end,
                                     pad=pad,
                                     reset_origin=reset_origin,
                                     ghost_color=ghost_color,   # 2026-09-12：幽灵框颜色（透传）
                                     content_src_w=content_src_w,   # 2026-09-14：缩放倍率滑块（透传）
                                     content_src_h=content_src_h,
                                     allow_upscale=allow_upscale,  # 2026-09-22：画布放大显示（透传；遮罩用）
                                     frame_extractor=frame_extractor,  # ⚠️ 节点语境：透传「节点时间轴取帧器」（遮罩背景=节点输出画面）
                                     content_alpha=content_alpha,  # 2026-10-05：透传「内容帧透明模式」（虚拟框内渲染真实帧）
                                     content_rgba=content_rgba,    # 2026-10-05：透传「真实文字带 alpha」模式（框内渲染 drawtext 文字）
                                     draw_diagonal=draw_diagonal,  # 2026-10-05：透传「仅描边（露出真实帧）」
                                     content_file=content_file,    # 2026-10-05：透传内容帧源
                                     content_ppm=content_ppm,      # 2026-10-17：透传内容帧**字节**（全内存，优先于 content_file）
                                     content_time=content_time,    # 2026-10-05：透传内容帧取帧时刻
                                     coord_box=coord_box,          # 2026-10-09：坐标框（各位置编辑器=True）
                                     nudge_rows=nudge_rows,        # 2026-10-09：微调三行（仅遮罩可视化选区=True）
                                     # 2026-10-11：轮廓「实时跟随」+ 右栏旋转滑块（均为尾部条件调用；
                                     # None=旧调用点零变化）。两者都属于「遮罩可视化选区」这一处
                                     # 拼接对齐用法，其余位置编辑器（PiP/水印/画布/主视频偏移）不传。
                                     bg_live_draw_func=bg_shape_outlines_live,
                                     rot_slider=rot_slider,
                                     content_chroma_settings=content_chroma_settings)  # 2026-10-11：透传子视频绿幕设置

    # ---------- 从视频位置可视化编辑器 ----------
    def _merge_group_base_track(self, track, enabled_videos=None):
        """返回 track 所在组的**组内主** track；track 不属于任何组（或组内无有效成员）→ None。

        判定口径与构建器 `_build_overlay_filter_complex` 的分组规划**完全一致**：
        同组内带 `is_grp_base` 者优先，缺省取组内列表序最上者。UI 侧（位置编辑器背景、
        叠加/偏移页提示、时间总览）一律走这里，避免各处自行解释"谁是组内主"。
        """
        if track is None:
            return None
        _ss = getattr(track, "enc_settings", None)
        if not isinstance(_ss, dict):
            return None
        g = str(_ss.get("grp") or "").strip()
        if not g:
            return None
        evs = enabled_videos if enabled_videos is not None else self._get_enabled_video_tracks()
        mems = [t for t in evs if str(t.enc_settings.get("grp") or "").strip() == g]
        if not mems:
            return None
        return next((t for t in mems if t.enc_settings.get("is_grp_base")), mems[0])

    def _resolve_editor_bg(self, track, enabled_videos=None):
        """位置编辑器的「背景是谁、画布多大」（2026-10-15 用户定案：**恒为原始主视频**）。

        为什么不再按组画布换底（推翻 2026-10-15 早前实现）：组内成员的 overlay_x/y 虽
        是「相对组画布」语义，但组画布 = 组内主的非旋转内容盒，**没有画布偏移(pad)入口**
        ⇒ 用户无法把组当"一块大画布上的平铺素材"来摆；且列表里子视频本就该各拖各的。
        所以一律回退「背景 = 主视频、画布 = 真输出画布」；组的**整体**落位改由
        「视频节点」里拖**组合包围盒**处理（见 `_group_composite_box`）。

        组内主的判定与构建器 `_build_overlay_filter_complex` 的分组规划**同口径**：
        同组内 `is_grp_base` 者优先，缺省取组内列表序最上（`_merge_group_base_track`）。
        本函数保留作**唯一解析口径**（供虚线框 / 组检测共用），不散写各处。

        返回 (bg_track, canvas_w, canvas_h)；无启用视频轨时返回 (None, None, None)。
        """
        evs = enabled_videos if enabled_videos is not None else self._get_enabled_video_tracks()
        if not evs:
            return None, None, None
        cw, ch = self._get_canvas_size(evs[0])
        return evs[0], cw, ch

    def _group_members(self, track, enabled_videos=None):
        """track 所在组的**全部启用成员**（保列表序）；不成组 → []。"""
        _ss = getattr(track, "enc_settings", None) or {}
        _g = str(_ss.get("grp") or "").strip()
        if not _g:
            return []
        evs = enabled_videos if enabled_videos is not None else self._get_enabled_video_tracks()
        return [t for t in evs if str(t.enc_settings.get("grp") or "").strip() == _g]

    def _group_composite_box(self, track, enabled_videos=None):
        """组的**包装盒矩形**（**真主画布**坐标）—— 派生量，**不落库**。

        = `_group_box_geometry` 的 UI 包装（**唯一出处**，与构建器的组画布尺寸/成员相对
        坐标同源；勿在这里另行现算，否则预览/编辑器/成片三者必然漂移）。

        口径（2026-10-16 用户定案纠正）：组画布 = 包装盒 = 各成员在**真主画布**上矩形的
        并集。所以成员 overlay_x/y 的求值域是**真主画布**（`_get_canvas_size(主视频)`，
        含 pad）——纠正前这里用「组内主的内容盒 bw×bh」当求值域，与构建器/成片不一致
        ⇒ 虚线框与实际落位错位（用户实测）。

        返回 (x, y, w, h, dx, dy, ox, oy)（主画布像素，float）；不成组 / 几何求不出 → None。
          · (x, y, w, h) = 包装盒本身（虚线框 / 拖拽盒），**已含组级落位**
            （2026-10-16：`grp_dx/grp_dy` 增量，缺省 0 ⇒ 旧行为；`grp_abs_x/grp_abs_y`
            绝对落位优先于增量 —— 父行窗口 X/Y 数字框走这一路）；
          · (dx, dy) = 组内主相对盒左上角的偏移（**不含** delta —— delta 是整盒平移，
            组内主与盒一起走，相对量不变）；
          · (ox, oy) = 盒**原点**（**不含任何组级落位**）—— 拖拽回写增量的基准
            （2026-10-16 补：此前靠 `rect_x - ddx0` 反推，一旦落位是绝对值就推错）。
        """
        evs = enabled_videos if enabled_videos is not None else self._get_enabled_video_tracks()
        mems = self._group_members(track, evs)
        if len(mems) < 2:
            return None
        _main = evs[0] if evs else None
        _canvas = self._get_canvas_size(_main) if _main is not None else None
        if not _canvas or _canvas[0] < 2:
            return None
        geo = self._group_box_geometry([(t.file_path, t.enc_settings) for t in mems],
                                       canvas=_canvas)
        if geo is None:
            return None
        _ox, _oy = geo["origin"]
        _pw, _ph = geo["size"]
        # 组级落位增量（唯一出处 _group_place_delta；缺省 0 ⇒ 老工程逐像素不变）
        _base_t = self._merge_group_base_track(track, evs) or mems[0]
        _ddx, _ddy = self._group_place_delta(_base_t.enc_settings)
        # 组级**绝对落位**（父行 X/Y 数字框）：有就覆盖，缺省/非法 → 走增量
        _ax, _ay = self._group_place_abs(_base_t.enc_settings)
        # 绝对落位若是**表达式**（如 `W-w-10`）就求不出数 ⇒ 画框回退到增量位置；
        # 构建器那边仍是原样字符串，成片不受影响（只是虚线框位置不精确）。
        _gx = _ax if isinstance(_ax, float) else float(_ox) + _ddx
        _gy = _ay if isinstance(_ay, float) else float(_oy) + _ddy
        return (_gx, _gy, float(_pw), float(_ph),
                float(geo["base"][0]), float(geo["base"][1]),
                float(_ox), float(_oy))

    def _node_label_track(self, lab, sub_videos=None):
        """「视频节点」里选中的节点标签 → 它**对应的那条真实轨道** (track_idx, track_obj)。

        供节点编辑器的「叠加/偏移」页接线（拖该轨道的叠加盒，写回它的 overlay_x/y ——
        不进 node_fx，故不会产生 null 空操作）。两级口径：
          ① **组节点**（构建器快照 self._last_group_label_map 覆盖 v_gbase_/v_grp_/组变换/
             最终 v_out_）→ **组内主轨道**（拖的是组组合包围盒，见 open_visual_overlay_editor
             的 group_box 分支）；
          ② **普通子视频节点**：画中画图里子视频相关标签一律带子视频序号（构建器阶段 A
             用 enumerate 生成）—— 构建器快照 `_last_member_lbl_map`（图层最终标签 →
             序号，2026-10-17 单画布方案起**首选命中**，组成员不再产 vc_）；
             `v_out_<i>`=叠加输出 / `v_temp_<i>`=输入 setpts 腿 / `vc_<i>`=内容画布腿 /
             `cbase_<i>`=透明底 ⇒ 正则兜底映射 `sub_videos[i]`。
        取不到（主链 / 收尾段等本就没有叠加语义的节点）→ (None, None)，调用方按老行为
        提示「缺少索引或回调」。
        """
        _gid = (getattr(self, "_last_group_label_map", {}) or {}).get(lab)
        if _gid:
            _evs = self._get_enabled_video_tracks()
            _mems = [t for t in _evs
                     if str(t.enc_settings.get("grp") or "").strip() == _gid]
            _base = self._merge_group_base_track(_mems[0] if _mems else None, _evs)
            if _base is None and _mems:
                _base = _mems[0]
            if _base is not None:
                with suppress(Exception):
                    return self.merge_tracks.index(_base), _base
            return None, None
        # 成员内容腿尾标签（2026-10-17 单画布方案）：组成员不再产 `vc_<i>`，构建器把
        # 每个图层的**最终标签**快照进 `_last_member_lbl_map` —— 腿尾随效果多样
        # （v_zm_<i> / 节点效果链输出等），正则命中不了，先查快照再落正则兜底。
        _si = (getattr(self, "_last_member_lbl_map", {}) or {}).get(lab)
        if _si is not None and sub_videos and 0 <= _si < len(sub_videos):
            _obj = sub_videos[_si]
            with suppress(Exception):
                return self.merge_tracks.index(_obj), _obj
        _m = re.match(r"^(?:vc|v_out|v_temp|cbase)_(\d+)$", lab or "")
        if _m and sub_videos:
            _si = int(_m.group(1))
            if 0 <= _si < len(sub_videos):
                _obj = sub_videos[_si]
                with suppress(Exception):
                    return self.merge_tracks.index(_obj), _obj
        return None, None

    def _group_box_snapshot_png(self, main_track, enabled_videos, base_track, out_png=None,
                                pipe_ppm=False):
        """生成「组内成员合成后」的一帧 PNG —— 尺寸 = 包装盒，给组位置编辑器当框内画面。

        2026-10-16：组位置编辑器里拖的那个框，里面显示的必须是**组的合成画面**（而不是
        组内主自己的画面被拉成整只大盒）—— 用户实测「框内内容只有组内主视频被拉伸后的图,
        不是节点合成的图」。tap 标签 = 组内合成链末环 `_merge_group_row_label`（与列表父行
        「来源」列显示的那个标签同源）。

        out_png（2026-10-16 第七轮，可选）：输出路径。None = 老固定名 `grp_box_<gid>.png`
        （老调用方逐字节不变）。带缓存那条路（`_material_ctx_group_png`）会传**按状态分名**
        的路径 —— 见那里的注释：不同状态共用同一文件名会导致「A→B→A」反向陈旧。

        失败一律返回 None（不弹窗）⇒ 调用方落回旧行为（content = 组内主文件），
        保证任何异常都不阻塞打开位置编辑器。
        """
        _gid = str((base_track.enc_settings or {}).get("grp") or "").strip()
        if not _gid or main_track is None:
            return None
        _mems = [t for t in (enabled_videos or [])
                 if t.type == "video"
                 and str((t.enc_settings or {}).get("grp") or "").strip() == _gid]
        if len(_mems) < 2:
            return None
        _out = out_png or os.path.join(tempfile.gettempdir(),
                                       "grp_box_%s.png" % re.sub(r"\W", "_", _gid))
        try:
            if pipe_ppm:
                # 🔴 2026-10-17（用户要「全内存缓存」）：不落盘，直接把 PPM 字节吐回内存
                #   （`-f image2pipe -vcodec ppm`）。上层 `_material_ctx_group_png` 用这条
                #   路把**组内合成帧**缓存在内存里 ⇒ 命中缓存时**不重跑 ffmpeg**。
                _cmd, _unused = self._build_pip_snapshot_cmd(
                    main_track, enabled_videos[1:],
                    tap_label=self._merge_group_row_label(_gid, _mems), pipe_ppm=True)
                _p = subprocess.run(_cmd, creationflags=_ffmpeg_spawn_flags(),
                                    capture_output=True)
                if _p.returncode != 0 or not _p.stdout or _p.stdout[:2] != b"P6":
                    return None
                return _p.stdout
            _cmd, _png = self._build_pip_snapshot_cmd(
                main_track, enabled_videos[1:],
                tap_label=self._merge_group_row_label(_gid, _mems), out_png=_out)
            _p = subprocess.run(_cmd, creationflags=_ffmpeg_spawn_flags(),
                                capture_output=True)
            if _p.returncode == 0 and os.path.exists(_png):
                return _png
        except Exception:
            pass
        return None

    def open_visual_overlay_editor(self, track_idx, ov_x_var=None, ov_y_var=None, ov_angle_var=None,
                                   filt_frame=None, parent=None, free_layout=False,
                                   free_layout_var=None, group_box=False,
                                   group_fx_key=None):
        """
        画中画子视频叠加位置/大小可视化编辑器（保留背景虚线框）
        ov_angle_var: OverlayPositionFrame 的 rotate_angle DoubleVar（应用时写回角度）

        group_box=True（**「视频节点」里选到组节点 / 列表虚拟父行的组轨道设置窗**）：
        拖的不是组内主自己的盒，而是**组的组合包围盒**（组内各成员在主画布上的并集）。

        🔴 2026-10-16 用户定案（推翻 2026-10-15 的「反向减 (dx,dy) 写回组内主 overlay」）：
        **拖动 = 整组平移 ⇒ 只写组级增量 `grp_dx/grp_dy`（存在组内主），成员坐标一字不动。**
        旧写法会让成员并集原点随组内主重算 ⇒「拖完重开节点变成一只新盒子」，且组内其他
        成员"没跟着动"（用户两轮实测）。增量模型下全部成员视觉上一起走、数据零改写
        —— 正如用户说的「对节点插入新 overlay 天然不会错位」。

        🔴 2026-10-16 二轮定案（推翻上面"该模式下只写位置、缩放不开放"）：
        用户心智模型是「**组最终标签 = 一条包装盒大小的独立素材**」⇒ **没有新规则**：
          · **缩放把手**照常生效 —— 写进该父行的素材设置（node_fx 第 0 项）的
            `scale_enabled/scale_width/scale_height`，由 `node_material_chain` 渲染；
            并**同步回设置窗的「缩放」编辑框**（同一份数据两处显示，用户实测要一致）；
          · **旋转把手**照常生效 —— 写素材设置的 `rotate_angle`（**界面数据**）**＋组级
            字段 `grp_rot_angle`**（**渲染侧唯一读取口径**：Stage B 组节点 rotate +
            `_group_box_geometry` 的中心对齐补偿）。**不写任何成员轨道的 enc_settings**
            —— 尤其**不写组内主的 `rotate_angle`**（那会让成员自己再转一次 = 双重旋转）。
        位置增量 `grp_dx/grp_dy` / 绝对落位 `grp_abs_x/y` / 角度 `grp_rot_angle` 都是
        **组级字段**（与成员自身语义无关，唯一例外且已沿用两轮）。

        打开时的**初始矩形尺寸/角度**都**优先读设置窗里活的控件**（用户刚改完还没保存也
        要立刻反映），没值才回落素材设置（上次保存的）—— 两个方向都要能看见对方。

        group_fx_key：该组最终输出标签的节点指纹 key（父行设置存在 node_fx 里）。
        None = 老调用方（「视频节点」里直接选组节点但没有 key）⇒ 缩放/旋转按老行为
        （只写位置），保证不因缺 key 而抛错。
        """
        track = self.merge_tracks[track_idx]
        if track.type != "video":
            return
    
        enabled_videos = self._get_enabled_video_tracks()
        if alert_if(not enabled_videos, _("错误"), _("没有启用的视频轨道"), 'error'):
            return
        main_track = enabled_videos[0]
        # 2026-10-15（用户定案：**列表里子视频各拖各的，恢复原样**）：
        # 背景恒为**原始主视频**、画布恒为**真输出画布**，子视频列表恢复 `enabled_videos[1:]`。
        # 组的**整体**落位不在这里改 —— 走「视频节点」里拖**组合包围盒**（本函数 group_box=True）。
        # 这里只在画布上**多画一个虚线框**标出组范围（信息展示，不改任何数据）。
        _bg_track, canvas_w, canvas_h = self._resolve_editor_bg(track, enabled_videos)
        if _bg_track is None:
            _bg_track = main_track
            canvas_w, canvas_h = self._get_canvas_size(main_track)
        # 🔴 2026-10-16（用户定案修正，推翻 2026-10-15 的「节点语境对齐可视化裁剪」）：
        # 位置编辑器属于**落位域** ⇒ 画布恒为**真主画布**（含 pad）、背景恒为**主视频帧**，
        # **不**改用节点输出尺寸/节点帧。节点输出（组内腿）是"包装盒大小"的合成画面，
        # 那是**像素域**（右侧预览 / 可视化裁剪 / delogo / 画布 / 遮罩）的口径；
        # 位置编辑器里要拖的是「**整只包装盒**在主画布上的落位」⇒ 必须用主画布坐标空间。
        # （上一轮把这两个域混成一个，导致组内节点的位置编辑器背景变成组内主画面、画布
        #   缩成组内腿尺寸、虚线框被丢 —— 用户实测「更差了」。）
        _grp_box = self._group_composite_box(track, enabled_videos)
    
        curr_w, curr_h = self._get_video_render_size(track, filt_frame)
        if alert_if(curr_w is None, _("错误"), _("无法获取视频渲染尺寸"), 'error'):
            return
    
        # 当前旋转角度（静态角度 rotate_angle）
        # 2026-10-16：组盒模式下角度属于**父行素材**（投影），不再读组内主的 enc_settings
        # （否则"打开父行编辑器 → 看到成员的角度 → 应用又写回成员"，等价于用父行改成员）。
        _grp_fx = self._group_material_item(group_fx_key) if group_box else {}
        # 与下面的「缩放」同一口径：**优先读窗口里活的角度控件**（用户刚改完还没保存也
        # 要立刻反映），它没值才回落素材设置（上次保存的）。
        _ra = None
        if group_box and ov_angle_var is not None:
            try:
                _ra = float(ov_angle_var.get() or 0.0)
            except (AttributeError, TypeError, ValueError):
                _ra = None
        if _ra is None:
            _ra = _opt_float((_grp_fx.get("rotate_angle", 0) if _grp_fx
                              else track.enc_settings.get("rotate_angle", 0)) or 0, 0.0)
    
        # 计算当前矩形位置：overlay_x/y 的 w/h 恒为内容盒（curr_w/curr_h，2026-08-26 统一）；
        # 旋转时 d×d 正方形由编辑器内部自动居中（锚点=内容盒左上角），不再按 d 求值
        # （否则初始显示偏左上 (d-w)/2，与实际成片/复杂预览不一致）。
        x_expr = track.enc_settings.get('overlay_x', '0')
        y_expr = track.enc_settings.get('overlay_y', '0')
        # 默认摆放 → 右下角内缩 RK_PLACE_INSET【内容像素】（与 canvas_w/h 同域）。
        # ⚠️ 不用 RK_PAD：那是画布灰边（显示层像素），与最终写进 overlay_x/y 的坐标不同域。
        rect_x = safe_eval_expr(x_expr, {"W": canvas_w, "H": canvas_h, "w": curr_w, "h": curr_h})
        if rect_x is None:
            rect_x = max(0, canvas_w - curr_w - RK_PLACE_INSET)
        rect_y = safe_eval_expr(y_expr, {"W": canvas_w, "H": canvas_h, "w": curr_w, "h": curr_h})
        if rect_y is None:
            rect_y = max(0, canvas_h - curr_h - RK_PLACE_INSET)
        if not free_layout:
            rect_x = max(0, min(rect_x, canvas_w - curr_w))
            rect_y = max(0, min(rect_y, canvas_h - curr_h))

        # 矩形尺寸（=框大小）。默认可缩放的矩形就是本轨内容盒（curr_w×curr_h）；
        # ⚠️ 组盒模式下矩形=**组合包围盒**，但**内容源尺寸仍用本轨内容盒** —— 否则会把
        #    组内主的画面拉伸到整只大盒（用户实测「画面缩成一兜底尺寸」）。故两者分开：
        #    `_rect_w/_rect_h` 只给矩形；`content_src_w/h` 恒用 curr_w/curr_h。
        _rect_w, _rect_h = curr_w, curr_h
        # 组盒模式（父行 / 「视频节点」里的组节点）：矩形 = **组合包围盒**，拖动 = 整组平移，
        # 只写组级增量、成员坐标一字不动（见 on_apply 与 docstring）。
        _grp_place_base = None        # 组落位增量(delta)的宿主 = 组内主轨；None = 非组盒模式
        if group_box and _grp_box is not None:
            rect_x, rect_y = _grp_box[0], _grp_box[1]
            _rect_w, _rect_h = _grp_box[2], _grp_box[3]
            # 组落位宿主 = 组内主（判定口径唯一出处 `_merge_group_base_track`）
            _grp_place_base = self._merge_group_base_track(track, enabled_videos) or track
            # 初始矩形尺寸 = 父行素材的**当前缩放**（打开时就是这个大小，把手接着拖）。
            # 🔴 两处数据必须一致（用户实测「缩放里手动填写的新尺寸，没有反应到位置编辑器
            #    里的大小」）：**优先读设置窗里活的缩放控件**（用户刚改完、还没保存也要立刻
            #    反映），它没值才回落素材设置（上次保存的）。
            _sw = _sh = None
            # 🔴 2026-10-16（用户第 1 条）：**活的控件一旦存在就是唯一真相源** ——
            #   包括它「被取消勾选」这件事。旧写法只判「勾选且有值才读」，一取消勾选
            #   就落到下面读**上次保存**的素材项（`_grp_fx`，里面 scale_enabled 仍是
            #   True + 旧宽高）⇒ 编辑器显示的还是「没取消前缩放大小」（用户实测：
            #   「缩放那边取消勾选，位置编辑器读取不到取消的信息」）。
            #   反方向（编辑器重绘 → 回写 `filt_frame.scale_*`）一直是通的 ⇒ 表现为
            #   「只能单向同步」。修法：记录「有没有活控件」，有就**不再回落素材项**；
            #   只有压根没有活控件（老调用方/独立进程）才读保存值。
            _has_live = False
            if filt_frame is not None:
                try:
                    _live_on = bool(filt_frame.scale_enabled.get())
                    # 勾选但宽/高缺失（width 模式高度自动）⇒ 交给下方「取不到就 None」
                    # 逻辑处理，仍算「有活控件」（不回落到保存值，否则旧尺寸诈尸）。
                    _has_live = True
                    if _live_on:
                        _sw = float(str(filt_frame.scale_width.get() or 0))
                        _sh = float(str(filt_frame.scale_height.get() or 0))
                except (AttributeError, TypeError, ValueError):
                    _sw = _sh = None
                    _has_live = False
            if not _has_live and _grp_fx.get("scale_enabled", False):
                # 无活控件（老调用方 / 非设置窗入口）⇒ 回落素材设置（上次保存的）
                try:
                    _sw = float(str(_grp_fx.get("scale_width") or 0))
                    _sh = float(str(_grp_fx.get("scale_height") or 0))
                except (TypeError, ValueError):
                    _sw = _sh = None
            if not (_sw and _sw >= 2 and _sh and _sh >= 2):
                _sw = _sh = None
            if _sw and _sw >= 2 and _sh and _sh >= 2:
                _rect_w, _rect_h = _sw, _sh

        def on_apply(new_x, new_y, new_w, new_h, new_canvas_w, new_canvas_h):
            if _grp_place_base is not None:
                # 🔴 组盒模式（2026-10-16 用户定案）：拖动 = **整组平移** ⇒ 只改组级增量
                #    `grp_dx/grp_dy`，**成员 overlay_x/y 一字不动**。
                #    旧实现写回组内主的 overlay_x/y ⇒ 成员并集原点重算 ⇒「拖完重开节点
                #    变成一只新盒子」，且组内其他成员"没跟着动"（用户两轮实测）。
                #    增量以「打开时的盒位置」为基准（不用当前 delta 反复叠加，避免漂移）。
                # ⚠️ 基准用**盒原点** `_grp_box[6..7]`（不含任何组级落位），不要用
                #    `旧 delta + (new_x - rect_x)`：rect_x 在「绝对落位」模式下是绝对值，
                #    反推会算出错误的增量。
                _ndx = round(float(new_x) - float(_grp_box[6]), 3)
                _ndy = round(float(new_y) - float(_grp_box[7]), 3)
                _es = _grp_place_base.enc_settings
                _es["grp_dx"] = "%g" % _ndx
                _es["grp_dy"] = "%g" % _ndy
                # 拖动写的是**增量** ⇒ 若之前用父行 X/Y 定过绝对落位，此处作废
                # （两者互斥，避免"拖完又跳回旧绝对值"）。
                _es.pop("grp_abs_x", None)
                _es.pop("grp_abs_y", None)
                # 🔴 2026-10-16 二轮：**缩放把手照常生效**（父行 = 独立素材 ⇒ 没有新规则）。
                #    写进父行的素材设置（node_fx），由 node_material_chain 渲染成 scale=。
                #    与「包装盒尺寸」不同才写（拖动只挪位置时会带回原尺寸，不必脏化设置）。
                if group_fx_key and (abs(float(new_w) - float(_rect_w)) >= 1
                                     or abs(float(new_h) - float(_rect_h)) >= 1):
                    _nsw = str(int(round(float(new_w))))
                    _nsh = str(int(round(float(new_h))))
                    self._group_material_set(
                        group_fx_key,
                        scale_enabled=True,
                        scale_width=_nsw,
                        scale_height=_nsh,
                        scale_method="exact")
                    # 🔴 位置编辑器 → 设置窗「缩放」编辑框：同一份数据在两处显示，必须同步
                    #    （用户实测「位置编辑器重新画的新矩形，保存后没有反应到缩放编辑框」）。
                    #    与下方非组路径的写法同一套（scale_enabled/method/width/height）。
                    if filt_frame is not None:
                        with suppress(Exception):
                            filt_frame.scale_enabled.set(True)
                            filt_frame.scale_method.set("exact")
                            filt_frame.scale_width.set(_nsw)
                            filt_frame.scale_height.set(_nsh)
                self.merge_refresh_ui()
                self._append_info_ui(
                    _("[可视化-组] 组整体落位已保存：平移 (%g, %g)（成员坐标未改动）")
                    % (_ndx, _ndy))
                return
            # 非组盒路径（普通子视频 / 组盒几何求不出时的降级）：写本轨 overlay_x/y + 缩放
            track.enc_settings['overlay_x'] = str(new_x)
            track.enc_settings['overlay_y'] = str(new_y)
            track.overlay_x = str(new_x)
            track.overlay_y = str(new_y)
            if ov_x_var is not None:
                ov_x_var.set(str(new_x))
            if ov_y_var is not None:
                ov_y_var.set(str(new_y))
            track.enc_settings["scale_enabled"] = True
            track.enc_settings["scale_width"] = str(new_w)
            track.enc_settings["scale_height"] = str(new_h)
            track.enc_settings["scale_method"] = "exact"
            if filt_frame is not None:
                filt_frame.scale_enabled.set(True)
                filt_frame.scale_method.set("exact")
                filt_frame.scale_width.set(str(new_w))
                filt_frame.scale_height.set(str(new_h))
            track.overlay_enabled = True
            self.merge_refresh_ui()
            self._append_info_ui(_('[可视化-从] 已保存位置: ({0}, {1}) 大小: {2}x{3}').format(new_x, new_y, new_w, new_h))

        def apply_angle(new_angle):
            """编辑器「应用」时写回旋转角度。

            2026-10-16：组盒模式下角度是**父行素材的属性**（投影）⇒ 写到两处：
              · `node_fx[group_fx_key]` 第 0 项（**界面数据**：设置窗的角度框、重开编辑器
                时的预填都读它）；
              · 组级字段 `grp_rot_angle`（**渲染侧唯一读取口径**，存在组内主 —— 与
                grp_dx/grp_dy 同族）。
            🔴 **绝不写组内主的 `rotate_angle`** —— 那是成员自己的角度，写了就是"用父行
            改成员"，而且会双重旋转（成员自己转一次 + 组再转一次）。
            """
            if _grp_place_base is not None and group_fx_key:
                _ang = float(new_angle or 0.0)
                self._group_material_set(group_fx_key, rotate_angle=_ang)
                _es = _grp_place_base.enc_settings
                if _ang:
                    _es["grp_rot_angle"] = _ang
                else:
                    _es.pop("grp_rot_angle", None)
            else:
                track.enc_settings['rotate_angle'] = float(new_angle or 0.0)
            if ov_angle_var is not None:
                with suppress(Exception):
                    ov_angle_var.set(float(new_angle or 0.0))
            # 角度直接改滤镜图（组节点上的 rotate）⇒ 走完整刷新，不能只刷命令预览
            self.merge_refresh_ui()
    
        # pad 是「主画布」的概念：背景恒为主视频（_resolve_editor_bg 唯一口径）⇒ pad 留黑
        # 照旧参与摆放。（2026-10-16：位置编辑器不再有「节点帧」这一路。）
        main_pad_enabled = _bg_track.enc_settings.get('pad_enabled', False)
        if main_pad_enabled:
            off_x_expr = _bg_track.enc_settings.get('offset_x', '0')
            off_y_expr = _bg_track.enc_settings.get('offset_y', '0')
            offset_x = safe_eval_expr(off_x_expr, {"W": canvas_w, "H": canvas_h}) or 0
            offset_y = safe_eval_expr(off_y_expr, {"W": canvas_w, "H": canvas_h}) or 0
        else:
            offset_x, offset_y = 0, 0
        extra_info = _('主视频偏移: X={0}, Y={1}').format(offset_x, offset_y)
        if _grp_box is not None:
            extra_info += (_("\n组范围: %dx%d @ (%d, %d)（虚线框）；拖动本框 = 整组平移"
                           "（写组级增量，成员坐标不动）")
                           % (_grp_box[2], _grp_box[3], _grp_box[0], _grp_box[1]))

        # ----- 组盒模式：框内显示**组的合成画面**（而不是组内主自己的画面被拉成整盒）-----
        # 2026-10-16 用户实测：「拖动的是组内包装盒大小的画面了, 但是框内内容只有组内主
        # 视频被拉伸后的图,不是节点合成的图」。故 group_box 时 tap 到组内合成链末环标签，
        # 生成一张包装盒尺寸的合成 PNG 当 content_file；content_src 同步改用**盒尺寸**
        # （否则 содержимое 与 src 不同域 ⇒ 又被拉伸一次）。生成失败 ⇒ 静默回落旧行为。
        # 🔴 2026-10-17（用户：「除了文字水印真实帧，其它一律不落盘」）：这里不再落
        #   `grp_box_<gid>.png`，直接要 **PPM 字节**（`-f image2pipe -vcodec ppm`），
        #   经 `content_ppm` 喂给编辑器 ⇒ 组盒模式全程**零临时文件**。
        _gc_png = None
        if _grp_place_base is not None and _grp_box is not None:
            # 🔴 2026-10-17（与轨迹「起始/结尾坐标」编辑器同款口径）：组父行框内内容 =
            # **组内合成画面**，统一走 `resolve_material_ctx`（带缓存 + 状态签名失效）→
            # `frame_ppm`（内存字节）。这样「叠加/偏移外面的位置编辑器」与用户已确认能看
            # 真实帧的轨迹坐标编辑器**同源同码**，不再两处各算各的（旧直接调
            # `_group_box_snapshot_png` 在某些调用语境下拿不到组 id/盒几何 ⇒ 回落组内主，
            # 表现为框内真实帧「不见了」）。
            with suppress(Exception):
                _mctx = self.resolve_material_ctx(filt_frame)
                if (_mctx is not None
                        and isinstance(_mctx.frame_ppm, (bytes, bytearray))
                        and len(_mctx.frame_ppm) > 16):
                    _gc_png = bytes(_mctx.frame_ppm)
            # 兜底：上面任一步异常 ⇒ 退回旧的「直接取一帧」路径（行为不变）
            if not _gc_png:
                with suppress(Exception):
                    _gc_png = self._group_box_snapshot_png(main_track, enabled_videos, track,
                                                           pipe_ppm=True)
        # ----- 定义背景绘制函数（现在内部只需使用 offset_x/offset_y 而不需定义 extra_info）-----
        def draw_bg(canvas, scale_x, scale_y=None):
            # 背景底 = 主视频（_resolve_editor_bg 唯一口径）；子视频列表恢复 enabled_videos[1:]
            main_render_size = (self._get_video_render_size(_bg_track)
                                or (canvas_w, canvas_h))
            self._draw_background(canvas, canvas_w, canvas_h, scale_x, _bg_track,
                                  enabled_videos[1:], offset_x, offset_y, main_render_size,
                                  current_edit_track=track, tag="bg", scale_y=scale_y,
                                  group_box=(_grp_box[:4] if _grp_box is not None else None))
    
        title = _('可视化编辑叠加位置 - {0}').format(os.path.basename(track.file_path))
        if _gc_png:
            title = _("可视化编辑组整体位置 - 组 %s（%dx%d）") % (
                str(track.enc_settings.get("grp") or "").strip() or "?",
                int(_grp_box[2]), int(_grp_box[3]))
        aspect = None
        # 背景底渲染尺寸（pad 时=其实际内容尺寸，画布含 pad 留黑）；供背景帧按 offset 摆放
        main_render_size = (self._get_video_render_size(_bg_track)
                            or (canvas_w, canvas_h))
        if _gc_png and _grp_box is not None and _grp_box[3]:
            # 组盒模式：内容就是**包装盒画面** ⇒ 宽高比/内容源尺寸都用盒尺寸，
            # 用组内主的 curr_w/h 会让"组合成图"再被拉伸一次（用户实测的画面变形）。
            aspect = float(_grp_box[2]) / float(_grp_box[3])
        elif curr_w and curr_h > 0:
            aspect = curr_w / curr_h
        self._generic_overlay_editor(
            parent or self.root,
            canvas_w, canvas_h,
            rect_x, rect_y, _rect_w, _rect_h,
            on_apply,
            title,
            aspect,
            bg_draw_func=draw_bg,
            extra_info=extra_info,
            rect_label=(_('组合成画面') if _gc_png else _('当前子视频')),
            min_visible_pixels=0,
            show_scale_tip=True,
            allow_negative_offset=free_layout,
            free_layout_var=free_layout_var,
            # 🔴 2026-10-17：组父行框内是**组合成画面**（可能远小于主画布）→ 解除 1.0 钳制
            # 放大显示（与轨迹坐标编辑器 `allow_upscale=True` 同一修复口径），否则小合成帧
            # 被按 1:1 显示、框内几乎看不见。普通子视频（无 _gc_png）保持旧行为不放大大图。
            allow_upscale=bool(_gc_png),
            rotate_angle=_ra,
            angle_cb=apply_angle,
            show_nudge=False,  # 画中画/子视频位置编辑器：无微调按钮
            main_video_file=main_track.file_path,   # 背景帧=主视频当前帧
            main_offset=(offset_x, offset_y),       # pad 时主视频内容偏移（超出黑色）
            main_render_size=main_render_size,
            bg_pre_filter=_main_bg_pre_filter(main_track.enc_settings),  # 主视频 crop/rotate（防背景帧变形）
            # 2026-10-05：框内渲染**子视频真实帧**（此前只有列表轨迹入口有，普通位置编辑器
            #   框内是空的）。content_file=子视频自身文件 + content_alpha=True（透明角），
            #   编辑器内「放开边界」右边新增的**窗口级临时**「真实帧」按钮可临时回退虚拟框。
            #   文件不存在/为空 ⇒ content_alpha=False，编辑器行为与旧版完全一致。
            # ⚠️ content_src_w/h 必传：它是「缩放(倍率)」滑块的基准、也是内容帧的尺寸基准。
            #   缺它 ⇒ 缩放控件整块不显示（列表轨迹入口传了所以有），且「100%」无语义。
            #   取子视频的渲染尺寸（curr_w/curr_h，与 _get_video_render_size 同源、crop/scale 后）。
            # 2026-10-16（组盒模式）：content 换成**组合成画面**（tap 到组内合成链末环），
            #   content_src 同步用**盒尺寸**；合成图里抠像/叠加都已算完 ⇒ **不**再传
            #   content_chroma_settings（否则二次抠像）。生成失败 ⇒ 逐字节落回旧行为。
            content_file=(None if _gc_png else (track.file_path or None)),
            # 🔴 2026-10-17：组盒模式直接给**内存字节** ⇒ 编辑器全程零临时文件。
            content_ppm=(_gc_png or None),
            content_alpha=bool(_gc_png
                               or (track.file_path and os.path.exists(track.file_path))),
            content_src_w=(float(_grp_box[2]) if _gc_png and _grp_box is not None else curr_w),
            content_src_h=(float(_grp_box[3]) if _gc_png and _grp_box is not None else curr_h),
            # 2026-10-11：虚拟框内真实帧接入绿幕（预览=成片）——传子视频轨 enc_settings，
            #   与成片 _build_sub_layer_command 的 sub_settings（=sv.enc_settings.copy()）同源。
            content_chroma_settings=(None if _gc_png else track.enc_settings),
            coord_box=True,     # 子视频/画中画位置编辑器：四格坐标（含 复制/粘贴）
            draw_diagonal=False)

    # ---------- 预设管理 ----------
    def load_preset_list(self):
        presets = self.preset_manager.load_all()
        preset_names = list(presets.keys())
        self.preset_combo['values'] = preset_names

    def _clean_settings(self, settings: dict, defaults: dict = None) -> dict:
        """
        递归清洗设置字典，移除与默认值相同的字段。
        """
        if defaults is None:
            defaults = self.default_settings
        cleaned = {}
        for key, value in settings.items():
            if key not in defaults:
                # 如果键不在默认字典中，保留（通常不会发生）
                cleaned[key] = value
                continue
            default_value = defaults[key]
            if isinstance(value, dict) and isinstance(default_value, dict):
                # 递归处理子字典，并传入对应的默认值
                sub_cleaned = self._clean_settings(value, default_value)
                if sub_cleaned:  # 只有子字典非空才保留
                    cleaned[key] = sub_cleaned
            elif value != default_value:
                cleaned[key] = value
            # 值相同则忽略
        return cleaned

    def save_preset(self):
        preset_name = simpledialog.askstring(_("保存预设"), _("请输入预设名称:"), parent=self.root)
        if not preset_name:
            return
        preset_settings = self.get_current_settings()

        # ---- 剔除「当前作业数据」：水印 / 分段 / 截取 / 列表轨迹 / 时段 ----
        # 详见模块级 _PRESET_EXCLUDE_KEYS，新增参数在那儿登记，不要在这里散写 pop
        for _ex in _PRESET_EXCLUDE_KEYS:
            preset_settings.pop(_ex, None)
        # 子字典内的时段键（enhance.enh_seg_*）：顶层 pop 够不着，单独走登记表
        for _parent, _subs in _PRESET_EXCLUDE_NESTED.items():
            _sub = preset_settings.get(_parent)
            if isinstance(_sub, dict):
                for _ex in _subs:
                    _sub.pop(_ex, None)

        # 清洗
#        print("原始设置:", preset_settings)
        cleaned = self._clean_settings(preset_settings)
 #       print("清洗后:", cleaned)
        self.preset_manager.save_preset(preset_name, cleaned)
        self.load_preset_list()
        messagebox.showinfo(_("成功"), _("预设“{0}”已保存到:\n{1}").format(preset_name, self.preset_file_path))

    def load_preset(self, preset_name):
        if not preset_name:
            return
        presets = self.preset_manager.load_all()
        if preset_name not in presets:
            return
        # ⚠️ 撤销快照：套用预设会整页覆盖参数，先拍下套用前的状态
        _undo_snap = self._build_convert_state_dict()
        self.load_settings_into_ui(presets[preset_name])
        _after_snap = self._build_convert_state_dict()   # 套用后态，供重做
        self._push_history("convert", _("套用预设"),
                           lambda: self._restore_convert_state_dict(copy.deepcopy(_undo_snap)),
                           lambda: self._restore_convert_state_dict(copy.deepcopy(_after_snap)))
        messagebox.showinfo(_("成功"), _("已加载预设“{0}”").format(preset_name))

    def delete_preset(self):
        preset_name = self.preset_name.get()
        if alert_if(not preset_name, _("警告"), _("请先选择一个预设")):
            return
        if not messagebox.askyesno(_("确认删除"), _('确定要删除预设“{0}”吗？').format(preset_name)):
            return
        # ⚠️ 撤销快照：删除前拍下整库（最细粒度=单预设），还原时恢复选中名
        _old_presets = copy.deepcopy(self.preset_manager.load_all())
        if self.preset_manager.delete_preset(preset_name):
            _new_presets = copy.deepcopy(self.preset_manager.load_all())
            self.load_preset_list()
            self.preset_name.set("")
            messagebox.showinfo(_("成功"), _('预设“{0}”已删除').format(preset_name))
            self._push_history(
                "convert", _('删除预设({0})').format(preset_name),
                lambda: (self.preset_manager.replace_all(copy.deepcopy(_old_presets)),
                         self.load_preset_list(),
                         self.preset_name.set(preset_name)),
                lambda: (self.preset_manager.replace_all(copy.deepcopy(_new_presets)),
                         self.load_preset_list(),
                         self.preset_name.set("")),
            )
        else:
            messagebox.showerror(_("错误"), _("删除失败"))

    def export_all_presets(self):
        if not os.path.exists(self.preset_file_path):
            if messagebox.askyesno(_("提示"), _("当前没有预设文件，是否创建一个空的预设文件并导出？")):
                with open(self.preset_file_path, 'w', encoding='utf-8') as f:
                    json.dump({}, f, indent=4)
            else:
                return
        save_path = filedialog.asksaveasfilename(
            title=_("导出全部预设 (备份)"),
            defaultextension=".json",
            filetypes=[(_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")],
            initialfile="ffmpeg_presets_backup.json"
        )
        if not save_path:
            return
        try:
            # 只导出预设本体：全局设置已迁到 app_settings.json，即便预设文件里还残留
            # 未迁移的 player_settings（含 mpv_path / log_path 等本机路径）也不外泄
            _data = self.preset_manager.load_all()
            with open(save_path, 'w', encoding='utf-8') as _f:
                json.dump(_data, _f, indent=4, ensure_ascii=False)
            self._append_info_ui(_("✅ 全部预设已备份到: {0}").format(save_path))
            messagebox.showinfo(_("导出成功"), _("预设库已导出至:\n{0}").format(save_path))
        except Exception as e:
            messagebox.showerror(_("导出失败"), str(e))

    def import_presets(self):
        import_path = filedialog.askopenfilename(
            title=_("导入预设库"),
            filetypes=[(_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")]
        )
        if not import_path:
            return
        # 🩹 2026-10-14：同项目加载，改走 read_json_file_guarded（绝不整文件裸读）
        imported, _err = read_json_file_guarded(import_path)
        if _err:
            messagebox.showerror(_("读取失败"), _("无法读取文件:\n%s") % _err)
            return
        if alert_if(not (isinstance(imported, dict)), _("格式错误"), _("导入的文件必须是 JSON 对象（键为预设名称，值为设置字典）"), 'error'):
            return
        # 全局设置不再随预设导入（已迁至 app_settings.json）；旧备份里的
        # player_settings 一律丢弃，避免对方本机路径污染本机全局设置
        imported = {k: v for k, v in imported.items() if k != "player_settings"}
        for preset_name, settings in imported.items():
            if isinstance(settings, dict) and "custom_args" in settings:
                custom = settings["custom_args"].strip()
                if re.search(r'[;&|`$]', custom):
                    self._append_info_ui(_("警告：预设 '{0}' 中的自定义参数包含危险字符，已清空").format(preset_name))
                    settings["custom_args"] = ""
            # 审计 H2：crop_* 直通画布滤镜图（旧 eval 已修为 safe_eval_expr），此处白名单兜底，
            # 含非法字符直接清空并警告，避免危险表达式进入 filtergraph（防御纵深）。
            if isinstance(settings, dict):
                for _ck in ("crop_width", "crop_height"):
                    if isinstance(settings.get(_ck), str):
                        _cv = settings[_ck].strip()
                        if _cv and not re.match(r'^[0-9+\-*/()\.\sA-Za-z_]+$', _cv):
                            self._append_info_ui(_("警告：预设 '{0}' 的 {1} 含非法字符，已清空").format(preset_name, _ck))
                            settings[_ck] = ""
        current = self.preset_manager.load_all()
        answer = messagebox.askyesnocancel(
            _("导入方式"),
            _('当前有 {0} 个预设，导入文件包含 {1} 个预设。\n「是」=完全替换整个预设库；「否」=合并（同名预设被覆盖）；「取消」=放弃导入。').format(len(current), len(imported))
        )
        if answer is None:
            self._append_info_ui(_("已取消预设库导入"))
            return
        # ⚠️ 撤销快照：整库覆盖前拍下旧库，还原/重做都走 replace_all（原子写，落盘一致）
        _old_presets = copy.deepcopy(current)
        if answer:
            new_presets = imported
        else:
            new_presets = current.copy()
            new_presets.update(imported)
        _new_presets = copy.deepcopy(new_presets)
        try:
            self.preset_manager.replace_all(new_presets)
            self.load_preset_list()
            self._append_info_ui(_('预设库已更新，共 {0} 个预设').format(len(new_presets)))
            messagebox.showinfo(_("导入成功"), _('预设库已更新，当前共 {0} 个预设').format(len(new_presets)))
            self._push_history(
                "convert", _('导入预设库({0}项)').format(len(imported)),
                lambda: (self.preset_manager.replace_all(copy.deepcopy(_old_presets)), self.load_preset_list()),
                lambda: (self.preset_manager.replace_all(copy.deepcopy(_new_presets)), self.load_preset_list()),
            )
        except Exception as e:
            messagebox.showerror(_("保存失败"), str(e))

    def export_convert_project(self):
        """导出转换页项目到 .fflgproject（全量设置快照，含视频/文字水印，带 convert 标记）"""
        file_path = filedialog.asksaveasfilename(
            title=_("导出转换项目"),
            defaultextension=".fflgproject",
            filetypes=[(_("fflgproject 项目文件"), "*.fflgproject"), (_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")]
        )
        if not file_path:
            return
        # get_current_settings 已含全部设置（编码/滤镜/音频/裁剪/高级/输出/分段/
        # 音频截取/末端处理/视频水印 watermark/文字水印 text_watermark+items）
        state = self.get_current_settings()
        state["version"] = "1.0"
        state["project_type"] = "convert"   # 独有标识：封装页项目没有此键（向后兼容）
        input_file = self.input_file.get().strip()
        if input_file:
            state["input_file"] = input_file
        try:
            with open(file_path, 'w', encoding='utf-8') as f:
                json.dump(state, f, indent=2, ensure_ascii=False)
            self._append_info_ui(_('✅ 转换项目已导出到: {0}').format(os.path.basename(file_path)))
        except Exception as e:
            self._append_info_ui(_('❌ 导出转换项目失败: {0}').format(e))
            messagebox.showerror(_("导出失败"), str(e))

    def import_convert_project(self):
        """从 .fflgproject 加载转换页项目（须带 convert 标记；无标记=封装页项目）"""
        # ⚠️ 撤销快照：先拍下导入前的整页参数（任何对话框之前），供右上「↶ 撤销」还原
        _undo_snap = self._build_convert_state_dict()
        file_path = filedialog.askopenfilename(
            title=_("导入转换项目"),
            filetypes=[(_("fflgproject 项目文件"), "*.fflgproject"), (_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")]
        )
        if not file_path:
            return
        # 🩹 2026-10-14：同 _load_merge_project，改走 read_json_file_guarded（绝不整文件裸读）
        state, _err = read_json_file_guarded(file_path)
        if _err:
            self._append_info_ui(_("❌ 读取转换项目失败: %s") % _err)
            messagebox.showerror(_("读取失败"), _err)
            return
        if not isinstance(state, dict) or state.get("project_type") != "convert":
            messagebox.showwarning(
                _("无法导入"),
                _("这不是转换页面的项目文件（缺少转换页标识）。\n"
                "它可能是封装页面的项目，请在封装页面用「📂 加载项目」打开。"))
            return
        # 项目语义=完整快照：水印也要恢复。主预设链刻意不恢复水印（见
        # load_settings_into_ui 注释），这里必须手动恢复，且 watermark_settings /
        # text_watermark_settings 被高级选项页以引用持有（17073/17080），只能
        # 原地 clear+update，不能重绑，否则 UI 引用脱钩失效。
        _restore_watermark_state(self, state)
        if state.get("input_file"):
            self.input_file.set(state["input_file"])
        self.load_settings_into_ui(state)
        _after_snap = self._build_convert_state_dict()   # 导入后态，供重做
        self._push_history("convert", _("导入项目"),
                           lambda: self._restore_convert_state_dict(copy.deepcopy(_undo_snap)),
                           lambda: self._restore_convert_state_dict(copy.deepcopy(_after_snap)))
        self._append_info_ui(_('✅ 转换项目已导入: {0}').format(os.path.basename(file_path)))

    # ============ 转换页撤销支持（2026-09-29）============
    # 与封装页共用同一套多栈机制（_push_history / _do_undo / _do_redo），只是快照内容换成转换页
    # 参数。拍快照与还原都复用既有「导出/导入项目」的口径，零额外状态逻辑：
    #   拍 = get_current_settings()（已含水印/文字水印/末端处理）+ input_file
    #   还 = import_convert_project 的恢复序列（水印必须 clear+update 原地还原，
    #        因为高级选项页以引用持有 watermark_settings / text_watermark_settings）
    # ⚠️ load_settings_into_ui 刻意不恢复水印（水印由独立预设管理），因此套用预设时
    #    水印的「还原」是恒等写入，无害。

    def _build_convert_state_dict(self):
        """转换页参数快照：与 export_convert_project 同口径（含水印与输入文件）。"""
        state = self.get_current_settings()
        state["version"] = "1.0"
        state["project_type"] = "convert"
        _in = self.input_file.get().strip()
        if _in:
            state["input_file"] = _in
        return state

    def _restore_convert_state_dict(self, state):
        """还原转换页参数：与 import_convert_project 的恢复序列同源，但 input_file 精确还原。"""
        _restore_watermark_state(self, state)
        # ⚠️ 与 import_convert_project 不同：撤销要的是「精确还原」，键不存在也必须清掉
        #   （导入项目则刻意保留现有输入文件，避免导入没带 input_file 的旧项目时误清）
        self.input_file.set(state.get("input_file", ""))
        self.load_settings_into_ui(state)

    # ---------- 预览与 UI 辅助 ----------
    def preview_current_file(self, with_snapshot: bool = False):
        path = self.input_file.get().strip()
        if alert_if(not path or not os.path.exists(path), _("错误"), _("请先选择一个有效的输入文件"), 'error'):
            return
        settings = self.get_current_settings()
        self._preview_with_settings(path, settings, with_snapshot=with_snapshot)

    def preview_selected_task(self, with_snapshot: bool = False):
        selected = self.task_tree.selection()
        if alert_if(not selected, _("警告"), _("请先选中一个任务")):
            return
        idx = int(selected[0])
        task = self.tasks[idx]
        if alert_if(not os.path.exists(task.input), _("错误"), _('输入文件不存在: {0}').format(task.input), 'error'):
            return
        self._preview_with_settings(task.input, task.settings, with_snapshot=with_snapshot)

    def toggle_only_audio_mode(self):
        state = tk.DISABLED if self.audio_frame.only_audio.get() else tk.NORMAL
        self._set_recursive_state(self.video_encoder, state)
        self._set_recursive_state(self.video_filter, state)
        self.update_command_preview()
    
    def _set_recursive_state(self, widget, state):
        try:
            widget.config(state=state)
        except:
            pass
        for child in widget.winfo_children():
            self._set_recursive_state(child, state)


    def open_segment_editor(self):
        if alert_if(not self.segment_enabled.get(), _("提示"), _("请先勾选「启用分段拼接模式」再打开设置窗口。"), 'info'):
            return
        import copy
        initial_segments = copy.deepcopy(self.segments)
        editor = SegmentEditor(self.root, initial_segments, self)
        # 恢复已保存的音频截取设置
        editor.audio_trim_enabled = self.audio_trim_enabled
        editor.audio_trim_start = self.audio_trim_start
        editor.audio_trim_end = self.audio_trim_end
        editor.audio_trim_enabled_var.set(self.audio_trim_enabled)
        editor.audio_trim_start_var.set(self.audio_trim_start)
        editor.audio_trim_end_var.set(self.audio_trim_end)
        editor._on_audio_trim_toggle()
        self.root.wait_window(editor.window)
        if editor.result is not None:
            self.segments = editor.result
            # 保存音频独立截取设置
            self.audio_trim_enabled = editor.audio_trim_enabled
            self.audio_trim_start = editor.audio_trim_start
            self.audio_trim_end = editor.audio_trim_end
            self.update_command_preview()


    def update_command_preview(self, *args):
        """防抖版刷新命令预览"""
        if self._preview_after_id:
            self.root.after_cancel(self._preview_after_id)
            self._preview_after_id = None
        self._preview_after_id = self.root.after(50, self._do_update_command_preview)

    def _do_update_command_preview(self):
        """实际执行命令刷新的函数"""
        if not hasattr(self, 'watermark_settings'):
            return
        self._preview_after_id = None
        # 素材类型切换（图片/视频）：「截取」面板随当前输入自动切换
        # （图片→仅「显示时长」；视频→常规截取控件）。放在命令生成之前，
        # 保证本次刷新消费的就是切换后的设置。幂等，重复调用无副作用。
        _tf = getattr(self, 'trim_frame', None)
        if _tf is not None:
            _tf.refresh_source_mode()
        if getattr(self, '_loading_preset', False):
            return
        if hasattr(self, '_updating_preview') and self._updating_preview:
            return
        self._updating_preview = True
        try:
            # ---- 水印禁用组合跳转 ----
            # 2026-09-12：删去 pip_enabled 条件——「启用画中画」勾选只在封装页（合并 tab），
            # 转换命令生成全程不消费它，勾了会误锁转换页截取/组合跳转（-双ss）。
            # 页面隔离同 L34443 判例（2026-08-19：转换页水印不得影响封装页）的反向。
            watermark_enabled = self.watermark_settings.get("enabled", False)
            if watermark_enabled:
                if self.trim_frame.show_combo_seek and self.trim_frame.combo_seek.get():
                    self.trim_frame.combo_seek.set(False)
                    self._append_info_ui(_("[提示] 水印/画中画模式下已自动禁用组合跳转。"))
                    if self.trim_frame.combo_check:
                        self.trim_frame.combo_check.config(state='disabled')
            else:
                if self.trim_frame.show_combo_seek and self.trim_frame.combo_check:
                    self.trim_frame.combo_check.config(state='normal')
            # -------------------------------------------------
    
            input_file = self.input_file.get()
            try:
                if not input_file:
                    cmd_list = self.generate_ffmpeg_command("{input}", "{output}", self.get_current_settings(), preview=True)
                else:
                    settings = self.get_current_settings()
                    output_path = self.generate_output_path(input_file, settings)
                    cmd_list = self.generate_ffmpeg_command(input_file, output_path, settings, preview=True)
                cmd_str = format_cmd_for_display(cmd_list)
            except Exception as e:
                cmd_str = _('生成命令时出错: {0}').format(e)
    
            # 更新预览区（根据全局开关控制状态）
            preview = self.cmd_preview
            preview.config(state='normal')
            preview.delete(1.0, tk.END)
            preview.insert(tk.END, cmd_str)
            if hasattr(self, 'preview_editable_var') and self.preview_editable_var.get():
                preview.config(state='normal')
            else:
                preview.config(state='disabled')
    
            # ---- 同步精准截取 ----
            try:
                watermark_enabled = self.watermark_settings.get("enabled", False)
                # 2026-09-12：删去 pip_enabled——同上，画中画只在封装页，转换页只看水印。
                if watermark_enabled and self.trim_frame.trim_active():
                    if not self.trim_frame.precise_trim.get():
                        self.trim_frame.precise_trim.set(True)
                    self.trim_frame.precise_check.config(state='disabled')
                    if not self._watermark_precise_hint_shown:
                        self._append_info_ui(_("[水印/画中画] 已自动启用精准截取（确保叠加对齐）。"))
                        self._watermark_precise_hint_shown = True
                else:
                    self.trim_frame.precise_check.config(state='normal')
            except Exception as e:
                pass
        finally:
            self._updating_preview = False


    # ---------- 同名文件处理 ----------
    def _unique_path(self, path: str) -> str:
        """生成不冲突的唯一路径（自动加序号）"""
        dirname = os.path.dirname(path)
        basename, ext = os.path.splitext(os.path.basename(path))
        counter = 1
        new_path = path
        # 检查文件系统存在或任务列表中已占用
        while os.path.exists(new_path) or any(t.output == new_path for t in self.tasks):
            new_path = os.path.join(dirname, f"{basename} ({counter}){ext}")
            counter += 1
        return new_path

    def _resolve_path_conflict(self, output_path: str, show_dialog: bool = True):
        """
        根据当前策略处理同名文件冲突，返回最终路径。
        若策略为 'ask' 且用户取消覆盖，则自动重命名。
        永远不会返回 None。
        """
        if not output_path:
            return output_path
        policy = self.overwrite_policy.get()
        
        def conflict(path):
            return os.path.exists(path) or any(t.output == path for t in self.tasks)
        
        if policy == "overwrite":
            return output_path
        elif policy == "rename":
            return self._unique_path(output_path)
        else:  # "ask"
            if not show_dialog:
                # 预览模式：直接重命名，不弹窗
                return self._unique_path(output_path)
            else:
                if conflict(output_path):
                    if messagebox.askyesno(_("文件已存在"), _("输出文件已存在:\n{0}\n\n是否覆盖？").format(output_path)):
                        return output_path
                    else:
                        return self._unique_path(output_path)
                return output_path


    # ---------- 任务管理 ----------
    def is_duplicate_task(self, input_path, output_path):
        """检查输出路径是否已被已有任务占用（无论输入是否相同）"""
        norm_out = normalize_path(output_path)
        for task in self.tasks:
            if normalize_path(task.output) == norm_out:
                return True
        return False


    def add_task(self, input_path, settings=None, auto_crop=False):
        if settings is None:
            settings = self.get_current_settings()
    
        # 如果水印未启用（路径为空），则移除 watermark 键，避免残留参数污染任务
        if not settings.get("watermark", {}).get("enabled", False) or not settings.get("watermark", {}).get("file_path", "").strip():
            settings.pop("watermark", None)
    
        # 分段拼接设置：尊重调用方传入的值，否则使用界面当前值
        if "segment_enabled" not in settings:
            settings["segment_enabled"] = self.segment_enabled.get()
        if "segments" not in settings:
            settings["segments"] = copy.deepcopy(self.segments)
    
        try:
            output_path = self.generate_output_path(input_path, settings)
            self._append_info_ui(_("生成输出路径: {0}").format(output_path))
        except Exception as e:
            err_msg = _('生成输出路径失败: {0}').format(e)
            self._append_info_ui(err_msg)
            import traceback
            self._append_info_ui(traceback.format_exc())
            messagebox.showerror(_("错误"), err_msg)
            return False
    
        output_path = self._resolve_path_conflict(output_path)
        if output_path is None:
            self._append_info_ui(_("添加任务已取消"))
            return False
    
        try:
            task = Task(input_path, output_path, settings, [])
            cmd_list = self.generate_ffmpeg_command(input_path, output_path, settings, task)
            task.cmd = cmd_list
            self._append_info_ui(_("命令生成成功，参数个数: {0}").format(len(cmd_list)))
        except Exception as e:
            err_msg = _('命令生成错误: {0}').format(e)
            self._append_info_ui(err_msg)
            import traceback
            self._append_info_ui(traceback.format_exc())
            messagebox.showerror(_("命令生成错误"), err_msg)
            return False
    

        self.tasks.append(task)
        self.update_task_list()
        self._append_info_ui(_("✅ 已添加任务: {0} -> {1}").format(os.path.basename(input_path), output_path))
        self._enqueue_precheck(task)   # 入队预检（后台 ffprobe，不阻塞入队）
        # 入队自动去黑边：仅【拖放批量添加】(auto_crop=True) 且开关勾选时，
        # 对单个任务后台跑一次 cropdetect 并写 crop；单文件「添加到任务列表」不触发。
        if auto_crop and self.auto_crop_queue_enabled.get():
            self._auto_crop_one_task(task)
        return True

    def add_current_as_task(self):
        input_path = self.input_file.get()
        if alert_if(not input_path or not os.path.exists(input_path), _("错误"), _("请先在输入文件中选择一个有效的文件"), 'error'):
            return
        self.add_task(input_path)

    def update_task_list(self):
        for item in self.task_tree.get_children():
            self.task_tree.delete(item)
    
        for i, task in enumerate(self.tasks):
            seq = i + 1
            tag = 'odd' if i % 2 == 0 else 'even'
            
            # 构建耗时字符串
            elapsed_str = ""
            if task.start_time and not task.is_finished:
                # 正在转码，实时计算
                elapsed = time.time() - task.start_time
                elapsed_str = _(" 耗时 {0}").format(seconds_to_time(elapsed, short=True))
            elif task.elapsed_time is not None:
                # 已完成或失败
                elapsed_str = _(" 耗时 {0}").format(seconds_to_time(task.elapsed_time, short=True))

            if task.status == _("转码中"):
                if task.total_sec > 0:
                    status_display = _("转码中 {0}% ({1}/{2} 秒){3}").format(
                        task.progress, task.current_sec, task.total_sec, elapsed_str)
                else:
                    status_display = _("转码中 {0}%{1}").format(task.progress, elapsed_str)
            else:
                if task.postcheck:
                    status_display = _("疑似{0}").format(elapsed_str)
                else:
                    status_display = f"{task.status}{elapsed_str}"

            # 大小预估（#4）：状态列尾部追加 ·约xxMB（转码中不追加）
            if task.size_estimate and task.status != _("转码中"):
                status_display = f"{status_display} ·{task.size_estimate}"

            # 详情列（错误信息列）：转后校验疑似 > 真错误 > 入队预检提示
            err_parts = []
            if task.postcheck:
                err_parts.extend(task.postcheck)
            if task.error_msg:
                err_parts.append(task.error_msg[:100])
            if task.precheck:
                err_parts.extend(txt for _lv, txt in task.precheck)
            err_display = _("；").join(err_parts)[:100]
            # 入队预检：等待态状态列追加 ⛔/⚠ 计数
            if task.precheck and task.status == _("等待"):
                n_bad = sum(1 for lv, _t in task.precheck if lv == "bad")
                n_warn = sum(1 for lv, _t in task.precheck if lv == "warn")
                marks = ""
                if n_bad:
                    marks += f" ⛔{n_bad}"
                if n_warn:
                    marks += f" ⚠{n_warn}"
                if marks:
                    status_display = f"{status_display}{marks}"
            # 行配色：疑似=黄字（条纹保留）；任务终态后预检配色退役；等待态按预检级别整行底色
            if task.postcheck:
                row_tags = (tag, "postcheck_suspect")
            elif task.is_finished:
                row_tags = (tag,)
            elif any(lv == "bad" for lv, _t in task.precheck):
                row_tags = ("precheck_bad",)
            elif any(lv == "warn" for lv, _t in task.precheck):
                row_tags = ("precheck_warn",)
            else:
                row_tags = (tag,)

            self.task_tree.insert("", tk.END, iid=str(i), values=(
                seq,
                os.path.basename(task.input),
                task.output,
                task.get_short_cmd(),
                status_display,
                err_display[:100]
            ), tags=row_tags)

    # ---------- 入队预检 ----------
    def _enqueue_precheck(self, task):
        """任务入队后挂后台预检：不阻塞入队，结果经 root.after 回主线程刷新"""
        if task.is_custom:
            return  # 自定义命令任务不套用规则
        self._precheck_queue.put(task)
        if self._precheck_thread is None or not self._precheck_thread.is_alive():
            self._precheck_thread = threading.Thread(target=self._precheck_worker, daemon=True)
            self._precheck_thread.start()

    def _precheck_worker(self):
        """预检守护线程：顺序消费队列，只跑 ffprobe，不碰任何 UI"""
        while True:
            task = self._precheck_queue.get()
            try:
                probe = ffprobe_json(self.ffprobe_cmd, task.input)
                results = precheck_task_rules(probe, task.settings, task.output)
                est_text = estimate_output_size_text(task.settings, probe)  # #4 顺手算（probe 已带时长）
            except Exception as e:
                results = [("bad", _("预检异常: {0}").format(e))]
                est_text = ""
            try:
                self.root.after(0, self._on_precheck_done, task, results, est_text)
            except Exception:
                pass  # 窗口已销毁（程序退出中），静默丢弃

    def _on_precheck_done(self, task, results, est_text=""):
        """预检结果回写（主线程）：红/黄命中写日志；顺带落大小预估并刷新列表"""
        if task not in self.tasks:
            return  # 预检期间任务已被移除
        task.precheck = results
        task.precheck_done = True
        if est_text:
            task.size_estimate = est_text
            self._append_info_ui(_("[预估] {0}: 预计输出{1}（码率模式）").format(os.path.basename(task.input), est_text))
        hits = [(lv, txt) for lv, txt in results if lv in ("bad", "warn")]
        if hits:
            name = os.path.basename(task.input)
            for lv, txt in hits:
                mark = "⛔" if lv == "bad" else "⚠"
                self._append_info_ui(_("[预检] {0} {1}: {2}").format(mark, name, txt))
        if hits or est_text:
            self.update_task_list()

    # ================== 入队自动去黑边（仅转换页队列） ==================
    def _auto_crop_one_task(self, task):
        """后台线程：对单个队列任务跑 cropdetect，成功则【无条件】用检测结果覆盖 crop 进 settings 并重算 cmd。
        即勾选后拖入队列的文件，即使继承了 UI 模板里的手动裁剪(crop_enabled)或简易位置(crop_pos_enabled)，
        也会被检测出的黑边裁剪覆盖（同时清掉 crop_pos_enabled，避免与静态 crop 冲突）。
        仅以下情况不动：自定义命令 / 文件不存在 / ffmpeg 缺失 / 检测不到黑边(detect_crop 返回 None)。
        尊重开关最新状态：取消勾选后仍在跑的检测不会回写。"""
        if task.is_custom:
            return
        if not os.path.exists(task.input):
            return
        if not getattr(self, "ffmpeg_cmd", None):
            return

        def worker():
            try:
                res = detect_crop(self.ffmpeg_cmd, task.input, timeout=15)
                if not res:
                    return
                w, h, x, y = res

                def apply():
                    # 任务可能已被移除 / 开关被取消 → 丢弃回写
                    if task not in self.tasks:
                        return
                    if not self.auto_crop_queue_enabled.get():
                        return
                    # 无条件覆盖：先清掉可能从模板继承来的动态裁剪/手动裁剪，再写检测结果
                    task.settings["crop_pos_enabled"] = False
                    task.settings["crop_enabled"] = True
                    task.settings["crop_width"] = str(w)
                    task.settings["crop_height"] = str(h)
                    task.settings["crop_left"] = str(x)
                    task.settings["crop_top"] = str(y)
                    with suppress(Exception):
                        task.cmd = self.generate_ffmpeg_command(
                            task.input, task.output, task.settings, task)
                    self.update_task_list()
                    self._append_info_ui(
                        _('[批量去黑边] {0} -> crop={1}:{2}:{3}:{4}').format(os.path.basename(task.input), w, h, x, y))

                self.root.after(0, apply)
            except Exception as e:
                try:
                    self.root.after(0, lambda: self._append_info_ui(_('[批量去黑边] 出错: {0}').format(e)))
                except Exception:
                    pass  # 窗口已销毁（程序退出中），静默丢弃

        threading.Thread(target=worker, daemon=True).start()

    # ============ 任务队列撤销支持（2026-09-29）============
    # Task 只含路径/设置/命令/状态等普通数据（无 Tk 引用），可安全 deepcopy。
    # 拍快照失败一律静默降级为「不登记撤销」，绝不能阻断删除动作本身。

    def _snapshot_tasks(self):
        """任务队列快照；失败返回 None（调用方据此跳过登记）。"""
        try:
            return copy.deepcopy(self.tasks)
        except Exception:
            return None

    def _restore_tasks(self, snap):
        """还原任务队列快照并刷新列表（再拷一份，避免快照被后续操作改动）。"""
        self.tasks = copy.deepcopy(snap)
        self.update_task_list()

    def remove_selected_tasks(self):
        selected = self.task_tree.selection()
        if not selected: return
        indices = sorted([int(iid) for iid in selected], reverse=True)
        _snap = self._snapshot_tasks()
        _removed = 0
        for idx in indices:
            if 0 <= idx < len(self.tasks):
                if self.tasks[idx].status == _("转码中"):
                    messagebox.showwarning(_("无法删除"), _("任务 {0} 正在转码中，请先停止队列").format(os.path.basename(self.tasks[idx].input)))
                    continue
                del self.tasks[idx]
                _removed += 1
        self.update_task_list()
        if _removed and _snap is not None:
            _after = self._snapshot_tasks()
            if _after is not None:
                self._push_history("tasks", _("移除任务"),
                                   lambda: self._restore_tasks(_snap),
                                   lambda: self._restore_tasks(_after))

    def clear_all_tasks(self):
        if alert_if(self.is_processing, _("警告"), _("请先停止队列或等待完成后再清空")):
            return
        if not self.tasks:
            return
        _snap = self._snapshot_tasks()
        self.tasks.clear()
        self.update_task_list()
        if _snap is not None:
            _after = self._snapshot_tasks()   # 清空后 = 空列表
            if _after is not None:
                self._push_history("tasks", _("清空任务"),
                                   lambda: self._restore_tasks(_snap),
                                   lambda: self._restore_tasks(_after))

    def clear_finished_tasks(self):
        _before = len(self.tasks)
        _snap = self._snapshot_tasks()
        self.tasks = [t for t in self.tasks if t.status not in (_("完成"), _("失败"))]
        self.update_task_list()
        if len(self.tasks) != _before and _snap is not None:
            _after = self._snapshot_tasks()
            if _after is not None:
                self._push_history("tasks", _("清除已完成任务"),
                                   lambda: self._restore_tasks(_snap),
                                   lambda: self._restore_tasks(_after))

    def stop_queue(self):
        self.stop_flag = True
        self._append_info_ui(_("收到停止信号，当前正在运行的任务将继续完成，不再启动新任务"))
        self.root.after(100, self._check_and_finish_if_idle)
    
    def _check_and_finish_if_idle(self):
        if self.stop_flag and not self.running_futures:
            self._finish_queue()

    # ---------- 并行队列处理 ----------
    @staticmethod
    def is_hardware_encoder(encoder):
        hw_keywords = ('nvenc', 'qsv', 'amf', 'vaapi', 'videotoolbox')
        encoder_lower = encoder.lower()
        return any(kw in encoder_lower for kw in hw_keywords)

    def start_queue(self):
        if self.is_processing:
            if not self.running_futures and not self.pending_tasks:
                self._finish_queue()
            else:
                messagebox.showinfo(_("提示"), _("队列已在运行中"))
            return
        if self.executor:
            self.executor.shutdown(wait=False)
            self.executor = None
        self.pending_tasks = [t for t in self.tasks if t.status == _("等待")]
        if alert_if(not self.pending_tasks, _("提示"), _("没有等待中的任务"), 'info'):
            return
        # 图片主视频 + 输出尺寸非偶数 → 拦下（不自动偶数化，理由见 _check_image_main_even_size）
        # 逐个过一遍：有问题的任务会在信息区单独报出，本次队列整体不启动，
        # 用户把尺寸改成偶数后重新点「开始队列」即可。非图片任务只按扩展名判，不跑 ffprobe。
        _bad_img = []
        for _qi, _t in enumerate(self.pending_tasks, 1):
            if not self._check_image_main_even_size(
                    getattr(_t, "input", ""), getattr(_t, "settings", None), queue_pos=_qi):
                _bad_img.append(_qi)
        if _bad_img:
            self._append_info_ui(
                _('[队列] 共 {0} 个任务的图片主视频输出尺寸不是偶数（序号：{1}），队列未启动。把尺寸改成偶数后重新点「开始队列」即可。').format(len(_bad_img), '、'.join(('#%d' % i for i in _bad_img))))
            return
        self.is_processing = True
        self.stop_flag = False
        self._queue_run_tasks = list(self.pending_tasks)   # 本次运行快照（转后校验汇总段用）
        max_workers = self.max_parallel.get()
        self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=max_workers)
        self._append_info_ui(_('启动并行队列，最大并行任务数: {0}，硬件编码最大并发: {1}').format(max_workers, self.max_hw_parallel.get()))
        self._submit_next_batch()

    def _submit_next_batch(self):
        if not self.is_processing or self.executor is None:
            return
    
        # ---- 停止信号处理 ----
        if self.stop_flag:
            # 如果有正在运行的任务，让它们继续运行，但不启动新任务
            if not self.running_futures:
                self._finish_queue()   # 所有任务已完成，结束队列
            return
    
        if not self.pending_tasks and not self.running_futures:
            self._finish_queue()
            return
    
        max_total = self.max_parallel.get()
        max_hw = self.max_hw_parallel.get()
    
        if len(self.running_futures) >= max_total:
            return
    
        # 查找可提交的任务
        to_submit_idx = None
        for idx, task in enumerate(self.pending_tasks):
            if task.status != _("等待"):
                continue
            encoder = task.settings.get("encoder", "")
            is_hw = self.is_hardware_encoder(encoder)
            if is_hw and self.current_hw_encoding_count >= max_hw:
                continue
            else:
                to_submit_idx = idx
                break

        if to_submit_idx is None:
            return

        task = self.pending_tasks.pop(to_submit_idx)
        if task.status != _("等待"):
            return

        future = self.executor.submit(self._process_single_task, task)
        self.running_futures.add(future)
        if self.is_hardware_encoder(task.settings.get("encoder", "")):
            self.current_hw_encoding_count += 1
        future.add_done_callback(self._on_task_done)

        self.root.after(10, self._submit_next_batch)

    def safe_append_detail(self, text):
        """工作线程安全：累积日志行，主线程每 100ms 批量刷新一次。
        根治「逐行 root.after(0)」在高频日志时把 after 队列堆爆 → UI 假死的链路。"""
        with suppress(Exception):
            self._detail_buf.append(text)
        if not self._detail_flush_pending:
            self._detail_flush_pending = True
            try:
                self.root.after(100, self._flush_detail_buf)
            except Exception:
                self._detail_flush_pending = False

    def _flush_detail_buf(self):
        self._detail_flush_pending = False
        buf = self._detail_buf
        if not buf:
            return
        self._detail_buf = []
        with suppress(Exception):
            self.append_detail(''.join(buf))



    def _process_single_task(self, task):
        """处理单个任务（队列模式）"""
        # 防设置残留：末端处理等子弹窗会就地改 task.settings 的 dict，若用户在子弹窗
        # 确定后未在主弹窗点「确定」，task.cmd 仍是旧命令（可能带着已取消的 split/concat）。
        # 执行前用 task.settings 重新生成命令，保证所见即所得（custom 任务除外）。
        if not getattr(task, "is_custom", False):
            try:
                task.cmd = self.generate_ffmpeg_command(task.input, task.output, task.settings, task)
            except Exception:
                pass  # 生成失败保留原命令（原始错误会在执行时暴露）
        task.status = _("转码中")
        task.start_time = time.time()
        self._update_task_list_ui()
        self._append_info_ui(_("\n========== 开始转码: {0} ==========").format(os.path.basename(task.input)))
        cmd_str = format_cmd_for_display(task.cmd)
        self._append_info_ui(f">>> {cmd_str}")
        self.ensure_output_dir(task.output)
    
        # 获取视频总时长用于进度
        total_duration = 0
        if task.settings.get("segment_enabled", False) and task.settings.get("segments"):
            # 分段拼接模式：计算所有片段时长之和（含逐段变速）
            total_duration = self._calc_segments_total_duration(task.settings)
            # 如果片段总时长计算失败，回退到原始方式
            if total_duration <= 0:
                raw_duration = self._get_media_duration(task.input)
                total_duration = self._get_effective_duration(task.settings, raw_duration) if raw_duration is not None else 0
        else:
            raw_duration = self._get_media_duration(task.input)
            total_duration = self._get_effective_duration(task.settings, raw_duration) if raw_duration is not None else 0
        if total_duration is None:
            total_duration = 0
    
        proc = None
        try:
            proc = subprocess.Popen(
                task.cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                stdin=subprocess.PIPE,          # 保留 stdin：停止时发 q 让 ffmpeg 优雅收尾（写 moov atom），勿改 DEVNULL
                text=True,
                encoding='utf-8',
                errors='replace',
                creationflags=_ffmpeg_spawn_flags()
            )
            with self._proc_lock:
                self.running_procs.append(proc)
                self._running_tasks.append((proc, task))
    
            for line in proc.stdout:
                self._last_ffmpeg_output = time.time()
                if not self._is_ffmpeg_banner_line(line):
                    self.safe_append_detail(line)
                    if total_duration > 0 and "time=" in line:
                        match = re.search(r'time=(\d+):(\d+):(\d+\.?\d*)', line)
                        if match:
                            h, m, s = match.groups()
                            current_sec = int(h) * 3600 + int(m) * 60 + float(s)
                            self.update_progress(current=int(current_sec), total=int(total_duration), task=task, log_progress=False)
    
            retcode = proc.wait()
            # 优先判断用户停止
            if task.stopped_by_user:
                task.status = _("已停止")
                self._append_info_ui(_("⏹️ 任务已停止: {0}").format(os.path.basename(task.input)))
            elif retcode == 0:
                task.status = _("完成")
                self._append_info_ui(_("✅ 任务完成: {0}").format(os.path.basename(task.input)))
                self._log_command_to_file(cmd_str)
                # 转后校验（#2，轻量档：命中疑似才深扫；异常不阻断队列）
                try:
                    issues = verify_output_file(self.ffmpeg_cmd, self.ffprobe_cmd,
                                                task.output, task.total_sec)
                except Exception as ve:
                    issues = [_("校验异常: {0}").format(ve)]
                if issues:
                    task.postcheck = issues
                    extra = _(" 等{0}项").format(len(issues)) if len(issues) > 1 else ""
                    self._append_info_ui(_("[校验] ⚠ {0}: {1}{2}").format(os.path.basename(task.output), issues[0], extra))
            else:
                task.status = _("失败")
                task.error_msg = _('返回码 {0}').format(retcode)
                self._append_info_ui(_("任务失败: {0} (返回码 {1})").format(os.path.basename(task.input), retcode))
            self._update_task_list_ui()
        except Exception as e:
            self._append_info_ui(_("任务异常: {0}").format(e))
            task.status = _("失败")
            task.error_msg = str(e)
            self._update_task_list_ui()
        finally:
            task.is_finished = True
            if task.start_time is not None:
                task.elapsed_time = time.time() - task.start_time
            with self._proc_lock:
                if proc in self.running_procs:
                    self.running_procs.remove(proc)
                self._running_tasks = [(p, t) for (p, t) in self._running_tasks if p != proc]
            self.update_progress(current=0, total=0, task=task, log_progress=False)
            if hasattr(task, 'temp_files'):
                self._cleanup_temp_files(task.temp_files)
                task.temp_files = []
        return task

    def _on_task_done(self, future):
        task = future.result()
        if self.is_hardware_encoder(task.settings.get("encoder", "")):
            self.current_hw_encoding_count -= 1
            self.current_hw_encoding_count = max(0, self.current_hw_encoding_count)
        self.running_futures.discard(future)
        self.root.after(100, self._submit_next_batch)

    def _finish_queue(self):
        if not self.is_processing:
            return
        self.is_processing = False
        if self.executor:
            self.executor.shutdown(wait=False)
            self.executor = None
        self.current_hw_encoding_count = 0
        # ⚠️「先读旧值 → 立刻复位 → 再判断」，顺序不可颠倒：
        #    更早（修复前）写成在 if 之前就 self.stop_flag = False → 条件恒假，
        #    「队列已停止」一次都打不出来，点停止也显示「所有任务处理完成」。
        stopped = bool(self.stop_flag)
        self.stop_flag = False
        if stopped:
            self._append_info_ui(_("\n队列已停止"))
        else:
            self._append_info_ui(_("\n所有任务处理完成"))

        # 转后校验汇总段（#2）：成功/疑似/失败 + 详情行；不弹窗、不落 txt（输出目录洁癖）
        run_tasks = list(getattr(self, "_queue_run_tasks", []) or [])
        self._queue_run_tasks = []
        if run_tasks:
            ok = [t for t in run_tasks if t.status == _("完成") and not t.postcheck]
            suspect = [t for t in run_tasks if t.status == _("完成") and t.postcheck]
            failed = [t for t in run_tasks if t.status == _("失败")]
            stopped = [t for t in run_tasks if t.status == _("已停止")]
            self._append_info_ui(_("\n========== 队列汇总 =========="))
            summary = _("成功 {0} | 疑似 {1} | 失败 {2}").format(len(ok), len(suspect), len(failed))
            if stopped:
                summary += _(" | 已停止 {0}").format(len(stopped))
            self._append_info_ui(summary)
            for t in suspect:
                for r in t.postcheck[:2]:
                    self._append_info_ui(_("  ⚠ 疑似 {0}: {1}").format(os.path.basename(t.output), r))
                if len(t.postcheck) > 2:
                    self._append_info_ui(_("    …共 {0} 项，见上方 [校验] 日志").format(len(t.postcheck)))
            for t in failed:
                self._append_info_ui(_("  ⛔ 失败 {0}: {1}").format(os.path.basename(t.input), t.error_msg or _("未知错误")))

    def _update_task_list_ui(self):
        self.root.after(0, self.update_task_list)

    def _append_info_ui(self, text: str):
        self.root.after(0, lambda: self.append_info(text))

    def _log_alpha_once(self, key, text):
        """透明输出提示去重（2026-10-09）：命令预览每敲一键/每改一项就重跑一次构建，
        无条件 _append_info_ui 会把信息区刷爆（与 _warn_bitdepth_break /
        _warn_private_params_overridden 同一手法：按语义 key 去重，结论变化才重打）。
        key 由调用方给出（如 "conv_mov" / "alpha_enc:[转码]:libx264"）。"""
        _seen = getattr(self, "_alpha_log_keys", None)
        if _seen is None:
            _seen = set()
            self._alpha_log_keys = _seen
        if key in _seen:
            return
        _seen.add(key)
        self._append_info_ui(text)

    def get_time_context(self):
        """时间上下文：主视频截取/变速参数 (trim_start, trim_end, speed_factor)。

        2026-08-29（阶段1）：SimplePreviewer 等时间消费方统一从这里读，调用方零参数。
        trim_end=None=未设截取终点（截到素材结尾）。"""
        try:
            return _main_trim_range(self)
        except Exception:
            return 0.0, None, 1.0

    def show_time_picker(self, parent, file_path, *, on_set_start=None, on_set_end=None,
                         initial_marks=None, on_send_segments=None, on_send_waypoints=None,
                         on_send_tw_items=None, on_send_chapters=None, use_output_context=True,
                         start_mode="video", lavfi_complex=None, pipe_aspect=None,
                         pipe_duration=None, pipe_start=None, pipe_out_mode=False,
                         pipe_audio_graph=None, pipe_audio_map=None,
                         mark_rows=None, on_mark_edit=None, on_coord_request=None,
                         initial_time=None, wp_mark=None, pipe_alpha=False):
        """统一时间预览入口（2026-08-29 阶段2）：构造 SimplePreviewer 的薄封装。

        内部自动读取 get_time_context() 提供成片时间换算，调用方无需再传
        trim_start/speed_factor。on_send_*：单对单「发送到」按钮（mark_row 原位，
        点击即发），各调用方只传自己的目标（跨窗口同步走「复制时间/导入时间」）。
        主视频自身预览传 use_output_context=False（不显示成片时间）。
        start_mode="audio"（2026-09-05 方案B）：打开即音频引擎（ffplay 直读+波形）。
        initial_time（#5，2026-10-08）：开窗后落到的**素材时刻**（秒）。仅列表轨迹面板
        「重开本管道」时下传（回到用户原来看的那个时刻）；缺省 None ⇒ 完全旧行为。
        wp_mark（#3，2026-10-08）：本预览与「弹窗未保存坐标」的关系（"live"/"stale"，
        见 _wp_mark_status）→ 预览窗标题 + 顶部横幅。缺省 None ⇒ 标题逐字节不变。"""
        try:
            SimplePreviewer(parent, self.ffmpeg_cmd, self.ffprobe_cmd, file_path,
                            on_set_start=on_set_start, on_set_end=on_set_end, app=self,
                            initial_marks=initial_marks,
                            mark_rows=mark_rows,
                            on_mark_edit=on_mark_edit,
                            on_coord_request=on_coord_request,
                            on_send_segments=on_send_segments,
                            on_send_waypoints=on_send_waypoints,
                            on_send_tw_items=on_send_tw_items,
                            on_send_chapters=on_send_chapters,
                            use_output_context=use_output_context,
                            start_mode=start_mode,
                            # 管道合成模式（时间预览引擎）：None = 完全旧行为
                            lavfi_complex=lavfi_complex,
                            pipe_aspect=pipe_aspect,
                            pipe_duration=pipe_duration,
                            pipe_start=pipe_start,
                            pipe_out_mode=pipe_out_mode,
                            pipe_audio_graph=pipe_audio_graph,
                            pipe_audio_map=pipe_audio_map,
                            # #5：开窗即落到指定素材时刻（仅列表轨迹「重开本管道」下传）
                            initial_time=initial_time,
