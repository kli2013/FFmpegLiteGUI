    def _contact_sheet_current_file(self):
        """对转码页当前输入文件生成缩略图"""
        path = self.input_file.get().strip()
        if alert_if(not path or not os.path.exists(path), _("提示"), _("请先选择有效的输入文件")):
            return
        self._show_contact_sheet_async(path)

    def _contact_sheet_selected_track(self):
        """对合并页选中的第一个视频轨道生成缩略图。
        若选中的是主视频：画中画模式→模拟叠加后画面；串行模式→模拟拼接+转场后画面。"""
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        track = self.merge_tracks[indices[0]]
        if alert_if(track.type != "video", _("提示"), _("缩略图仅支持视频轨道"), 'info'):
            return
        if not os.path.exists(track.file_path):
            self._append_info_ui(_("[缩略图] 文件不存在"))
            return
        enabled_videos = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        is_main = bool(enabled_videos) and enabled_videos[0] == track
        if is_main and self.pip_enabled.get() and len(enabled_videos) > 1:
            # 画中画主视频：模拟叠加后的缩略图
            self._show_pip_contact_sheet_async(track, enabled_videos[1:])
        elif is_main and self.concat_enabled.get() and len(enabled_videos) > 1:
            # 串行主视频：模拟拼接+转场后的缩略图
            self._show_concat_contact_sheet_async(enabled_videos)
        else:
            # 普通单文件缩略图
            self._show_contact_sheet_async(track.file_path)

    def _contact_sheet_selected_task(self):
        """对队列选中的第一个任务生成缩略图"""
        selected = self.task_tree.selection()
        if alert_if(not selected, _("提示"), _("请先选中一个任务")):
            return
        idx = int(selected[0])
        task = self.tasks[idx]
        if alert_if(not os.path.exists(task.input), _("提示"), _('输入文件不存在: {0}').format(task.input)):
            return
        self._show_contact_sheet_async(task.input)

    def merge_move_up_selected(self):
        indices = self._get_selected_track_indices()
        if not indices:
            return
        self._move_selected_tracks(indices, direction=-1)
    
    def merge_move_down_selected(self):
        indices = self._get_selected_track_indices()
        if not indices:
            return
        self._move_selected_tracks(indices, direction=1)

    def _move_selected_tracks(self, indices, direction):
        """
        将选中的轨道整体上移（direction=-1）或下移（direction=1）。
        仅当选中轨道连续时支持整体移动，否则只移动第一个选中项。
        移动即时生效；命令预览刷新由 merge_update_command_preview 的
        300ms 防抖统一合并（2026-08-25 用户拍板：不做移动级防抖）。

        🔴 2026-10-17（用户拍板「硬拦截」）：**组不能升到第一行当主视频**。
        输出分辨率/表达式 W/H 基准恒由「首条启用视频轨」（主视频）给出，而组是叠加层
        —— 它的坐标相对画布、自身不带画布，包围盒也没有合法通用尺寸（成员表达式又要
        引用 W/H，且允许负原点）。组一旦顶上去，`_group_box_geometry` 拿到的画布就变成
        组基成员自己的尺寸，盒原点与成员 rel 全错。与其产出错乱命令，不如在入口挡住并
        指路（加一层虚拟素材当底板）。**先在候选顺序上判定、违规不落地** ⇒ 不留半错状态。
        """
        if not indices:
            return
    
        # 排序
        indices = sorted(indices)
        min_idx = indices[0]
        max_idx = indices[-1]
        _contig = (max_idx - min_idx + 1 == len(indices))
        if not _contig:
            self._append_info_ui(_("[提示] 选中轨道不连续，仅移动第一个。请选择连续轨道以整体移动。"))
            min_idx = max_idx = indices[0]
    
        # 边界
        if direction == -1 and min_idx == 0:
            self._append_info_ui(_("[提示] 已在顶部，无法上移"))
            return
        if direction == 1 and max_idx == len(self.merge_tracks) - 1:
            self._append_info_ui(_("[提示] 已在底部，无法下移"))
            return
    
        # ---- 候选顺序（先算后判：违规时不改 self.merge_tracks）----
        _cand = list(self.merge_tracks)
        if direction == -1:
            _cand[min_idx - 1:max_idx + 1] = _cand[min_idx:max_idx + 1] + [_cand[min_idx - 1]]
            new_min, new_max = min_idx - 1, max_idx - 1
        else:
            _cand[min_idx:max_idx + 2] = [_cand[max_idx + 1]] + _cand[min_idx:max_idx + 1]
            new_min, new_max = min_idx + 1, max_idx + 1
    
        # 🔴 组不得成为主视频（首条启用视频轨 = 输出画布的唯一真相源）
        if self._block_group_as_main(_cand):
            return
    
        # ---- 落地（原地替换，保持 merge_tracks 对象身份）----
        self.merge_tracks[:] = _cand
        if _contig:
            # 2026-10-12：行序已变 ⇒ 必须按**轨道对象**指定保持选中（旧 iid 已与数据错位）；
            #   且**不能**再 selection_add —— 刷新内已还原，叠加会把移动前的邻居行一起选中。
            self.merge_update_track_list(
                keep_tracks=[self.merge_tracks[_i] for _i in range(new_min, new_max + 1)])
            self.merge_update_command_preview()
            self._append_info_ui(_('[移动] 已整体{0} {1} 个轨道').format('上移' if direction == -1 else '下移', len(indices)))
            return
    
        # 不连续：只移动了第一个（旧路径同口径：refresh + 按新行号选中，不走整体日志）
        self.merge_refresh_ui()
        if 0 <= new_min < len(self.merge_tracks):
            self.merge_tree.selection_set(f"track_{new_min}")
    
    def merge_clone_selected(self):
        """克隆选中轨道：深拷贝（含全部滤镜/截取/叠加/转场设置）插入原轨道后，
        方便同一素材做不同滤镜效果对比，无需重新拖入文件。多选时克隆第一个。"""
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        idx = indices[0]
        src = self.merge_tracks[idx]
        new_track = copy.deepcopy(src)  # 深拷贝：克隆的 enc_settings 独立，改滤镜不影响原件
        self.merge_tracks.insert(idx + 1, new_track)
        self.merge_refresh_ui()
        self.merge_tree.selection_set(f"track_{idx + 1}")
        self.merge_tree.see(f"track_{idx + 1}")
        self._append_info_ui(
            _('[封装] 已克隆轨道（{0} - {1}）插入到第 {2} 位，可独立修改滤镜设置').format(src.type, os.path.basename(src.file_path), idx + 2))

    def merge_delete_selected(self):
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        # 🔴 删掉主视频后，组会顺势顶到主视频位（与 _move_selected_tracks 同一硬拦截）
        if self._block_group_as_main(
                [_t for _i, _t in enumerate(self.merge_tracks) if _i not in indices]):
            return
        _snap = self._build_merge_state_dict()
        # 2026-10-12：删除会改变行序（旧 selection 的 iid 与数据错位）⇒ 先记住被选中的
        #   轨道**对象**，删除后只还原「还在的那些」（被删的自然落空 ⇒ 保持未选中）。
        _del_objs = [self.merge_tracks[_i] for _i in indices if _i < len(self.merge_tracks)]
        # 从大到小删除
        for idx in reversed(indices):
            removed = self.merge_tracks.pop(idx)
            self._append_info_ui(_('[封装] 已删除轨道: {0} - {1}').format(removed.type, os.path.basename(removed.file_path)))
        self.merge_update_track_list(
            keep_tracks=[_t for _t in _del_objs if _t in self.merge_tracks])
        self.merge_auto_recommend_container()
        self.merge_update_command_preview()
        _after_snap = self._build_merge_state_dict()
        self._push_history("merge", _("删除轨道"),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_snap)),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))
    
    def merge_clear_tracks(self):
        if not (self.merge_tracks or self.merge_video.get().strip() or self.merge_output.get().strip()):
            return
        _snap = self._build_merge_state_dict()
        self.merge_tracks.clear()
        self.merge_video.set("")
        self.merge_output.set("")
        self.merge_update_track_list()
        self.merge_auto_recommend_container()
        self.merge_update_command_preview()
        self.merge_reset_column_widths()    #调用恢复列宽
        self._append_info_ui(_("[封装] 已清空所有附加轨道"))
        _after_snap = self._build_merge_state_dict()
        self._push_history("merge", _("清空轨道"),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_snap)),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))


    # ============ 撤销/重做引擎（2026-09-29 架构升级）============
    # 多步历史 + 重做 + 页面归属：每个 scope 独立栈，跨页不再互相覆盖丢失。
    # 快照口径统一：操作前 _build_*_state_dict() 一次、操作后立即再 build 一次，
    # 撤销=restore(前态) / 重做=restore(后态)，零额外状态逻辑。

    def _push_history(self, scope, label, undo_fn, redo_fn):
        """登记一次可撤销操作（多步历史 + 重做）。
        scope: convert/merge/tasks/chapter/watermark；undo_fn 还原前态，redo_fn 重放后态。
        新操作使同 scope 的重做栈失效（标准编辑语义）。注意：不改动 _active_undo_scope，
        活动 scope 由主 notebook 切页事件决定（见 _on_main_tab_changed）。"""
        if scope not in self._undo_stacks:
            self._undo_stacks[scope] = []
            self._redo_stacks[scope] = []
        self._undo_stacks[scope].append({"label": label, "undo": undo_fn, "redo": redo_fn})
        self._redo_stacks[scope].clear()
        self._refresh_undo_buttons()

    def _do_undo(self, scope=None):
        """执行撤销：取指定 scope（默认当前活动页）栈顶条目还原，移入重做栈。"""
        scope = scope or self._active_undo_scope
        if not scope or not self._undo_stacks.get(scope):
            return
        entry = self._undo_stacks[scope].pop()
        try:
            entry["undo"]()
        except Exception as _e:
            self._undo_stacks[scope].append(entry)   # 失败则放回，允许重试
            self._append_info_ui(_("❌ 撤销失败: {0}").format(_e))
            messagebox.showerror(_("撤销失败"), str(_e))
            return
        self._redo_stacks[scope].append(entry)
        self._append_info_ui(_("↩️ 已撤销：{0}").format(entry['label']))
        self._refresh_undo_buttons()

    def _do_redo(self, scope=None):
        """执行重做：取指定 scope 重做栈顶条目重放，移回撤销栈。"""
        scope = scope or self._active_undo_scope
        if not scope or not self._redo_stacks.get(scope):
            return
        entry = self._redo_stacks[scope].pop()
        try:
            entry["redo"]()
        except Exception as _e:
            self._redo_stacks[scope].append(entry)
            self._append_info_ui(_("❌ 重做失败: {0}").format(_e))
            messagebox.showerror(_("重做失败"), str(_e))
            return
        self._undo_stacks[scope].append(entry)
        self._append_info_ui(_("↪️ 已重做：{0}").format(entry['label']))
        self._refresh_undo_buttons()

    def _refresh_undo_buttons(self):
        """按当前活动 scope 刷新共享栏 撤销/重做 按钮（无历史则隐藏）。
        任务队列（scope=tasks）有独立按钮，不挤共享栏。"""
        scope = self._active_undo_scope
        u = self._undo_stacks.get(scope) if scope else None
        r = self._redo_stacks.get(scope) if scope else None
        if u:
            self._undo_btn.configure(text=_("↶ 撤销：{0}").format(u[-1]['label']))
            self._undo_btn.pack(side=tk.RIGHT, padx=2)
        else:
            self._undo_btn.pack_forget()
        if r:
            self._redo_btn.configure(text=_("↷ 重做：{0}").format(r[-1]['label']))
            self._redo_btn.pack(side=tk.RIGHT, padx=2)
        else:
            self._redo_btn.pack_forget()
        # 任务队列独立按钮（scope=tasks，不在共享栏显示）
        _tu = self._undo_stacks.get("tasks")
        _tr = self._redo_stacks.get("tasks")
        if _tu:
            self._task_undo_btn.configure(text=_("↶ 撤销：{0}").format(_tu[-1]['label']))
            self._task_undo_btn.pack(side=tk.LEFT, padx=5)
        else:
            self._task_undo_btn.pack_forget()
        if _tr:
            self._task_redo_btn.configure(text=_("↷ 重做：{0}").format(_tr[-1]['label']))
            self._task_redo_btn.pack(side=tk.LEFT, padx=5)
        else:
            self._task_redo_btn.pack_forget()

    def _on_main_tab_changed(self, event=None):
        """主 notebook 切页：重映射共享栏撤销/重做到当前页 scope。各 scope 独立栈，互不影响。"""
        try:
            _tab = self.notebook.select()
            _text = self.notebook.tab(_tab, "text")
        except Exception:
            return
        if _text == _("视频转码"):
            self._active_undo_scope = "convert"
        elif _text == _("封装/合并/画中画"):
            self._active_undo_scope = "merge"
        else:
            self._active_undo_scope = None
        self._refresh_undo_buttons()

    def merge_on_tree_double_click(self, event):
        """双击编辑第一个选中的轨道。

        2026-10-16：**虚拟组父行**（iid=`grp_<gid>`）双击 ⇒ 打开「组的整体位置」编辑器
        （拖组合包围盒，写组级增量 `grp_dx/grp_dy`）—— 父行就是那条
        `[主画布][组输出]overlay` 的宿主，此处正是它的编辑入口。
        普通轨道行保持原行为（`merge_edit_selected`）。
        """
        _iid = None
        with suppress(Exception):
            _iid = self.merge_tree.identify_row(getattr(event, "y", 0))
        if not _iid:
            with suppress(Exception):
                _iid = self.merge_tree.focus()
        if isinstance(_iid, str) and _iid.startswith("grp_"):
            if self._merge_edit_group_row(_iid[4:]):
                return
        self.merge_edit_selected()

