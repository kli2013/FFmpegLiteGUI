            ttk.Label(bg_ctrl, text=_("帧时间(秒):")).pack(side=tk.LEFT)
            bg_time_var = tk.StringVar(value=f"{bg_cur_time:.2f}")
            ttk.Entry(bg_ctrl, textvariable=bg_time_var, width=12).pack(side=tk.LEFT, padx=4)
            def _on_bg_refresh():
                nonlocal bg_cur_time
                _ts = bg_time_var.get().strip()
                if alert_if(not _ts, _("提示"), _("请输入帧时间")):
                    return
                _sec = time_to_seconds(_ts)
                if alert_if(_sec is None, _("错误"), _('无效的时间格式: {0}\n支持格式: 秒数(如 10.5) 或 HH:MM:SS[.mmm]').format(_ts), 'error'):
                    return
                bg_cur_time = max(0.0, float(_sec))
                bg_refresh_btn.config(state=tk.DISABLED, text=_("提取中…"))
                status_var.set(_('⏳ 正在提取 {0:.2f}s 画面…').format(bg_cur_time))
                _draw_bg_frame()
            bg_refresh_btn = ttk.Button(bg_ctrl, text=_("重新获取帧"), command=_on_bg_refresh)
            bg_refresh_btn.pack(side=tk.LEFT, padx=4)

        status_var = tk.StringVar(value=_("红色矩形可拖拽移动。"))
        ttk.Label(right_frame, textvariable=status_var, justify=tk.LEFT,
                  wraplength=RIGHT_PANEL_WIDTH - 12).pack(anchor="w", pady=5)
    
        coord_var = tk.StringVar(value="")
        coord_label = ttk.Label(right_frame, textvariable=coord_var, font=("", 10))
        coord_label.pack(anchor="w", pady=2)

        # ---- 放开边界开关（2026-10-05）：编辑器内直接切换，省去返回上一层 ----
        # 勾选 = 自由布局（内容可拖出画布 / 比画布大）；实时生效（翻转钳制 + 重贴 + 重渲）。
        def _on_free_toggle():
            _allow_neg[0] = _free_var.get()
            clamp_rect()
            update_rect_position()
            _schedule_content_render()
            status_var.set(_("放开边界：") + (_("已开启（可拖出画布 / 超出画布）") if _free_var.get()
                                          else _("已关闭（限制在画布内）")))

        # ---- 窗口级「真实帧」临时开关的回调（2026-10-05）----
        # 只翻 _real_frame[0]（本窗口），**不碰** app.editor_real_frame 等任何全局/父级变量。
        # 开 → 矩形重建为「仅描边」+ 渲真实帧；关 → 矩形重建为「填斜纹」+ 隐藏/停渲内容图。
        def _on_local_real_frame_toggle():
            _on = bool(_local_real_frame.get())
            _real_frame[0] = _on
            if _on:
                # 恢复仅描边（去掉虚拟框斜纹），并失效几何记忆强制重渲真实帧
                with suppress(Exception):
                    canvas.itemconfig(rect_id, fill="", stipple="")
                _content_geom[0] = None
                _do_render_content()
            else:
                # 回退虚拟框：填斜纹 + 隐藏已渲染的内容图（此后 _do_render_content 早退，不再跑 ffmpeg）
                with suppress(Exception):
