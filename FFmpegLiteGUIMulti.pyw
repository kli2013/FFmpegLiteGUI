                    _bgm_sub = ttk.Frame(bgm_frame)
                    _bgm_sub.grid(row=1, column=0, sticky="we", padx=5, pady=3)

                    ttk.Label(_bgm_sub, text=_("音频文件:")).grid(row=0, column=0, sticky="w", padx=3)
