# 走 volume 滤镜的类型才支持软边缘（表达式包络）
_ASEG_SOFT_TYPES = ("mute", "volume")


def aseg_type_label(t):
    """效果类型 key → 中文显示名（未登记类型原样返回，避免 KeyError）。"""
    d = AUDIO_SEGMENT_TYPES.get(t)
    return _(d["label"]) if d else str(t)


# 下拉框显示中文名，内部数据一律存 key；反查表在表定义后一次性建好
def aseg_label_to_key():
    """显示名 → 内部 token（英文 key，稳定）。

    ⚠️ 必须是函数、在调用时求值：multi 的 _() 依赖启动后装载的 TRANS，写成模块级
    常量会把 key 冻在导入时的中文上 ⇒ 英文界面下拉值("Silence")查不到 ⇒ 返回译文本身，
    下游 AUDIO_SEGMENT_TYPES.get(译文) 落空 ⇒ 分段参数框不出现。
    """
    return {_(_s["label"]): k for k, _s in AUDIO_SEGMENT_TYPES.items()}


def aseg_key_from_label(label):
    """中文显示名 → 效果类型 key（未登记的原样返回，兼容老数据）。"""
    return aseg_label_to_key().get(label, label)


def _aseg_num(x):
    """滤镜参数/表达式里的数字：定宽 4 位小数并去掉无意义的尾巴（1.0000→1，1000 不会被截）。"""
    try:
        s = f"{float(x):.4f}"
    except (TypeError, ValueError):
        return "0"
    return s.rstrip("0").rstrip(".") if "." in s else s


def _aseg_filter_body(t, p1, p2):
    """效果类型 + 参数 → 滤镜主体串（不含 enable）。"""
    if t == "mute":
        return "volume=0"
    if t == "volume":
        return f"volume={_aseg_num(_opt_float(p1, 1.0))}"
    if t == "denoise":
        return (f"afftdn=nr={_aseg_num(_opt_float(p1, 12.0))}"
                f":nf={_aseg_num(_opt_float(p2, -30.0))}")
    if t == "highpass":
        return f"highpass=f={_aseg_num(_opt_float(p1, 200.0))}"
    if t == "lowpass":
        return f"lowpass=f={_aseg_num(_opt_float(p1, 3000.0))}"
    if t == "eq_low":
        return f"bass=g={_aseg_num(_opt_float(p1, 0.0))}"
    if t == "eq_mid":
        return f"equalizer=f=1000:width_type=h:width=200:g={_aseg_num(_opt_float(p1, 0.0))}"
    if t == "eq_high":
        return f"treble=g={_aseg_num(_opt_float(p1, 0.0))}"
    return ""


def _aseg_soft_expr(ranges, target, r):
    """生成多段软边缘音量包络（clip/max/min，规避 ffmpeg 嵌套 if 解析失败）。

    单段 [a,b]、目标音量 v、柔化半径 r(秒)：
      t<a-r → 1；[a-r,a] → 1 线性降到 v；[a,b] → v；[b,b+r] → v 线性升回 1；t>b+r → 1。
    多段取 min（最「静」的一层）；每段只加一层 max，线性增长不指数膨胀，段重叠语义正确。
    说明：ffmpeg 表达式解析器不支持 if 嵌套在 if 的第三参数（报 too many args），
    故改用 clip(钳制)+max+min 的纯算术形式。
    """
    envs = []
    for a, b in ranges:
        ar = a - r
        rd = f"1+({_aseg_num(target)}-1)*clip((t-{_aseg_num(ar)})/{_aseg_num(r)},0,1)"
        ru = f"{_aseg_num(target)}+({_aseg_num(1.0 - target)})*clip((t-{_aseg_num(b)})/{_aseg_num(r)},0,1)"
        envs.append(f"max({rd},{ru})")
    if not envs:
        return "1"
    # ffmpeg 的 min/max 仅接受固定个数参数（多段并排 min(a,b,c,...) 会初始化失败），
    # 利用结合律改为两两嵌套 min，每个 min 恒为 2 参数，与段数无关。
    expr = "1"
    for e in reversed(envs):
        expr = f"min({e},{expr})"
    return expr


def build_audio_segment_filters(segments, trim_start=0.0, speed_factor=1.0, offset=0.0):
    """把分段列表编译成 ffmpeg 音频滤镜串列表（调用方 join 后接到 -af 链尾）。

    - 过滤：未启用 / 时间非数字 / end<=start / start<0 的段直接跳过
      （校验与提示由 UI 层负责，这里只做兜底，绝不抛异常）。
    - **时间基准换算（2026-09-04 修复）**：用户填的分段时间是「源时间线」（听见第几秒
      即源文件第几秒），但滤镜链在 atrim+asetpts 之后 t 已归零到输出时间线，故每段
      必须按 trim_start/speed_factor 换算：a_out=max(0,(a-trim_start)/speed)、
      b_out=(b-trim_start)/speed；b_out<=a_out（整段落在 trim 之前）的段直接丢弃。
      与视频 _timeline_convert 同公式，conversion 页传视频 trim 起点、merge 页传每轨
      trim_start，做到「音频跟随截取」。不传（默认 0/1）即源=输出，零影响。
    - **offset（2026-09-04 增）**：封装页 adelay 在分段滤镜之前 → 输出 t 被推后
      offset 秒（且随 atempo 缩放），换算须把 offset 加回内容位置：
      a_out=max(0,((a-trim_start)+offset)/speed)。转换页无音频偏移，传默认 0。
    - 合并：同 (type, p1, p2, soft) 的段合成单个滤镜实例，enable 用
      between(t,a,b)+between(t,c,d) 相加表达「或」→ 滤镜链长度不随段数膨胀。
    - 软边缘：mute/volume 且柔化>0 时改用 volume=eval=frame:volume='包络表达式'。
    - 淡入淡出：afade 的 st 是硬参数，每段独立实例，不合并、也不加 enable。
    """
    if not segments:
        return []
    _ts = _opt_float(trim_start or 0.0, 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _off = _opt_float(offset or 0.0, 0.0)
    items = []
    for seg in segments:
        if not isinstance(seg, dict) or not seg.get("enabled", True):
            continue
        try:
            a = float(seg.get("start", 0))
            b = float(seg.get("end", 0))
        except (TypeError, ValueError):
            continue
        if b <= a or a < 0:
            continue
        # 换算到 atrim+asetpts 之后的输出时间线（与视频 _timeline_convert 同公式）。
        # offset：封装页 adelay 在分段之前 → 输出 t 被推后 off 秒（且随 atempo 缩放），
        # 故换算须把 off 加回内容位置：(src - trim_start + offset) / speed。
        a = max(0.0, ((a - _ts) + _off) / _sp)
        b = ((b - _ts) + _off) / _sp
        if b <= a:
            continue
        items.append((a, b, seg))
    if not items:
        return []
    items.sort(key=lambda x: (x[0], x[1]))

    out = []
    # 1) 淡入淡出：每段独立 afade 实例
    for a, b, seg in items:
        t = seg.get("type", "mute")
        if t == "fade_in":
            d = _opt_float(seg.get("p1", ""), 0.5)
            if d > 0:
                out.append(f"afade=t=in:st={_aseg_num(a)}:d={_aseg_num(d)}")
        elif t == "fade_out":
            d = _opt_float(seg.get("p1", ""), 0.5)
            if d > 0:
                out.append(f"afade=t=out:st={_aseg_num(max(0.0, b - d))}:d={_aseg_num(d)}")

    # 2) 其余效果：按 (type, p1, p2, soft) 分组，同组共用一个滤镜实例
    groups = {}
    order = []
    for a, b, seg in items:
        t = seg.get("type", "mute")
        if t in ("fade_in", "fade_out"):
            continue
        soft = 0
        if t in _ASEG_SOFT_TYPES:
            soft = int(_opt_float(seg.get("soft", 0), 0))
            if soft < 0:
                soft = 0
        p1 = str(seg.get("p1", ""))
        p2 = str(seg.get("p2", ""))
        key = (t, p1, p2, soft)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append((a, b))

    for key in order:
        t, p1, p2, soft = key
        ranges = groups[key]
        # 静音 / 局部音量：走 volume 表达式（eval=frame 每帧求值，绕开 enable 段首瞬态，
        # 且与柔化共用同一滤镜形式；硬切=if(enable,target,1)，柔化=clip/max/min 包络）。
        if t in _ASEG_SOFT_TYPES:
            target = 0.0 if t == "mute" else _opt_float(p1, 1.0)
            if soft > 0:
                out.append(f"volume=eval=frame:volume='{_aseg_soft_expr(ranges, target, soft / 1000.0)}'")
            else:
                enable = "+".join(f"between(t,{_aseg_num(a)},{_aseg_num(b)})" for a, b in ranges)
                out.append(f"volume=eval=frame:volume='if({enable},{_aseg_num(target)},1)'")
            continue
        # 其余效果（降噪/滤波/EQ 等）：沿用 enable 表达式（频率类切换无静音式爆音，瞬态可忽略）
        body = _aseg_filter_body(t, p1, p2)
        if not body:
            continue
        expr = "+".join(f"between(t,{_aseg_num(a)},{_aseg_num(b)})" for a, b in ranges)
        out.append(f"{body}:enable='{expr}'")
    if out:
        # ⚠️ 2026-09-04 实测：atempo 输出的帧 PTS 是 AV_NOPTS（无效值），
        # 其后 volume=eval=frame / enable 表达式里的 t 全部失效（分段静音静默失效）。
        # 分段组前统一 asetpts=PTS-STARTPTS 重置时间轴（幂等：无 atempo 时首帧本就 pts=0，
        # adelay 头部静音的内容/t 映射不受影响）。
        out.insert(0, "asetpts=PTS-STARTPTS")
    return out


class AudioSegmentDialog:
    """音频分段效果编辑器（列表式）。

    转换页（self.audio_segments）与封装页（track.enc_settings["audio_segments"]）共用同一份实现，
    调用方只负责传入/取回列表；滤镜编译统一走 build_audio_segment_filters()。
    """

    _TREE_H = 9

    def __init__(self, parent, segments, title=None, app=None, file_source=None):
        self.parent = parent
        if title is None:
            title = _("音频分段效果")
        self.title_text = title
        self.segments = [dict(s) for s in (segments or []) if isinstance(s, dict)]
        self.result = None
        self._loading = False
        self._last_sel = None
        # 时间预览入口（2026-09-05）：app=主程序引用（ffmpeg/ffplay 路径），
        # file_source=返回当前音频源文件路径的回调（None 则不显示「时间预览」按钮）
        self.app = app
        self.file_source = file_source

    # ---------- 列表渲染 ----------
    def _fill_tree(self):
        tv = self.tree
        for iid in tv.get_children():
            tv.delete(iid)
        for i, seg in enumerate(self.segments):
            try:
                a = float(seg.get("start", 0))
                b = float(seg.get("end", 0))
            except (TypeError, ValueError):
                a = b = 0.0
            t = seg.get("type", "mute")
            spec = AUDIO_SEGMENT_TYPES.get(t, {})
            labels = [_(_lb) for _lb, _dv in spec.get("params", [])]
            vals = [str(seg.get("p1", "")), str(seg.get("p2", ""))]
            pv = "  ".join(f"{lb}={v}" for lb, v in zip(labels, vals) if v != "")
            soft = int(_opt_float(seg.get("soft", 0), 0))
            if soft > 0 and t in _ASEG_SOFT_TYPES:
                pv = (pv + _('  柔化{0}ms').format(soft)).strip()
            tv.insert("", "end", iid=str(i), values=(
                "√" if seg.get("enabled", True) else "",
                seconds_to_time(a, short=True),
                seconds_to_time(b, short=True),
                f"{b - a:.3f}s" if b > a else "-",
                aseg_type_label(t),
                pv,
            ))
        self._update_count()

    def _update_count(self):
        n = len(self.segments)
        on = sum(1 for s in self.segments if s.get("enabled", True))
        if hasattr(self, "count_label"):
            self.count_label.config(text=_("共 {0} 段（启用 {1} 段）").format(n, on))

    # ---------- 选中 / 编辑区同步（三守卫：_loading 内、_last_sel 同项短路） ----------
    def _sel_index(self):
        sel = self.tree.selection()
        if not sel:
            return None
        try:
            return int(sel[0])
        except (TypeError, ValueError):
            return None

    def _on_select(self, _evt=None):
        if self._loading:
            return
        idx = self._sel_index()
        if idx == self._last_sel:
            return
        # 切换前先把编辑区写回「正在离开的段」（防止直接点列表导致本段改动丢失/串到下一
        # 段）。与视频列表的「_setv 同值不写 / _loading 内 / _last_sel 同项短路」三守卫一致。
        self._commit_form_to(self._last_sel)
        self._last_sel = idx
        self._load_to_form(idx)

    def _load_to_form(self, idx):
        self._loading = True
        try:
            if idx is None or idx >= len(self.segments):
                self.start_var.set("")
                self.end_var.set("")
                self.type_var.set(aseg_type_label("mute"))
                self.p1_var.set("")
                self.p2_var.set("")
                self.soft_var.set("0")
                self._sync_param_fields()
                return
            seg = self.segments[idx]
            try:
                a = float(seg.get("start", 0))
                b = float(seg.get("end", 0))
            except (TypeError, ValueError):
                a = b = 0.0
            self.start_var.set(seconds_to_time(a, short=True))
            self.end_var.set(seconds_to_time(b, short=True))
            self.type_var.set(aseg_type_label(seg.get("type", "mute")))
            self.p1_var.set(str(seg.get("p1", "")))
            self.p2_var.set(str(seg.get("p2", "")))
            self.soft_var.set(str(int(_opt_float(seg.get("soft", 0), 0))))
            self._sync_param_fields()
        finally:
            self._loading = False

    def _sync_param_fields(self):
        """按当前效果类型显示/隐藏参数框（ttk 禁用用 state(["disabled"])）。"""
        key = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(key, {})
        params = spec.get("params", [])
        for i, (lbl, ent, var) in enumerate(self._param_widgets):
            if i < len(params):
                name, dflt = params[i]
                lbl.config(text=f"{name}:")
                if not var.get():
                    var.set(dflt)
                lbl.state(["!disabled"])
                ent.state(["!disabled"])
            else:
                lbl.config(text="—:")
                var.set("")
                lbl.state(["disabled"])
                ent.state(["disabled"])
        # 软边缘只对 mute / volume 有意义（其余滤镜不走 volume 包络）
        if key in _ASEG_SOFT_TYPES:
            self.soft_label.state(["!disabled"])
            self.soft_entry.state(["!disabled"])
        else:
            self.soft_label.state(["disabled"])
            self.soft_entry.state(["disabled"])

    def _commit_form_to(self, idx):
        """把编辑区当前内容写回第 idx 段（仅写数据 + 单行刷新，不碰选择、不触发回环）。"""
        if self._loading:
            return
        if idx is None or idx < 0 or idx >= len(self.segments):
            return
        seg = self.segments[idx]
        s = time_to_seconds(self.start_var.get().strip())
        e = time_to_seconds(self.end_var.get().strip())
        if s is None:
            s = float(seg.get("start", 0) or 0)
        if e is None:
            e = float(seg.get("end", 0) or 0)
        seg["start"] = s
        seg["end"] = e
        seg["type"] = aseg_key_from_label(self.type_var.get())
        seg["p1"] = self.p1_var.get().strip()
        seg["p2"] = self.p2_var.get().strip()
        seg["soft"] = int(_opt_float(self.soft_var.get(), 0))
        self._refresh_row(idx)
        self._update_count()

    def _refresh_row(self, idx):
        """只更新第 idx 行显示（tree.item 不删除子项 → 不丢选择、不派发 <<TreeviewSelect>>）。"""
        if idx is None or idx < 0 or idx >= len(self.segments):
            return
        try:
            tv = self.tree
        except Exception:
            return
        seg = self.segments[idx]
        try:
            a = float(seg.get("start", 0))
            b = float(seg.get("end", 0))
        except (TypeError, ValueError):
            a = b = 0.0
        t = seg.get("type", "mute")
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        labels = [_(_lb) for _lb, _dv in spec.get("params", [])]
        vals = [str(seg.get("p1", "")), str(seg.get("p2", ""))]
        pv = "  ".join(f"{lb}={v}" for lb, v in zip(labels, vals) if v != "")
        soft = int(_opt_float(seg.get("soft", 0), 0))
        if soft > 0 and t in _ASEG_SOFT_TYPES:
            pv = (pv + _('  柔化{0}ms').format(soft)).strip()
        try:
            tv.item(str(idx), values=(
                "√" if seg.get("enabled", True) else "",
                seconds_to_time(a, short=True),
                seconds_to_time(b, short=True),
                f"{b - a:.3f}s" if b > a else "-",
                aseg_type_label(t),
                pv,
            ))
        except Exception:
            # 行不存在（极少数并发）时退回整表刷新
            self._fill_tree()

    def _apply_form_to_sel(self, *args):
        """编辑区改动 → 写回「最后一次加载进编辑区的段」(_last_sel)。

        *args 兼容两种回调：<Return>/<FocusOut> 传 event；StringVar write trace
        传 (name, index, mode) 三参（与视频列表原型 _sync_current_to_tree 同款）。
        ⚠️ 提交目标必须锁定 _last_sel，不能取“当前选中行”：
        用户「输入完马上点下一段」时，Entry 的 <FocusOut> 与 Treeview 的
        <<TreeviewSelect>> 触发先后顺序不可靠，若按当前选中提交，迟到的 FocusOut
        会把正在编辑的内容写进新选中的段（两段同时变成新时间）。
        锁定 _last_sel 后任何时序都只落回正在编辑的那段；配合 show() 里挂的
        write trace（击键当下即落盘），编辑内容不存在“未提交残留”，串段不可能发生。
        """
        self._commit_form_to(self._last_sel)

    def _on_type_changed(self, _evt=None):
        """切换效果类型：参数默认值跟着换，空参数自动填上默认值。"""
        spec = AUDIO_SEGMENT_TYPES.get(aseg_key_from_label(self.type_var.get()), {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        if len(defaults) > 0 and not self.p1_var.get().strip():
            self.p1_var.set(defaults[0])
        if len(defaults) > 1 and not self.p2_var.get().strip():
            self.p2_var.set(defaults[1])
        self._sync_param_fields()
        self._apply_form_to_sel()

    # ---------- 列表操作 ----------
    def _add(self):
        # 先保存正在编辑的段（防点「添加」时本段改动丢失/串段）
        self._commit_form_to(self._last_sel)
        seg = {"enabled": True, "start": 0.0, "end": 1.0, "type": "mute",
               "p1": "", "p2": "", "soft": 0}
        if self.segments:
            try:
                last_end = max(float(x.get("end", 0) or 0) for x in self.segments)
            except (TypeError, ValueError):
                last_end = 0.0
            seg["start"] = last_end
            seg["end"] = last_end + 1.0
        self.segments.append(seg)
        self._fill_tree()
        self._select(len(self.segments) - 1)

    def _delete(self):
        # 先保存正在编辑的段
        self._commit_form_to(self._last_sel)
        idx = self._sel_index()
        if idx is None:
            return
        del self.segments[idx]
        self._fill_tree()
        self._select(min(idx, len(self.segments) - 1))

    def _move(self, delta):
        # 先保存正在编辑的段
        self._commit_form_to(self._last_sel)
        idx = self._sel_index()
        if idx is None:
            return
        j = idx + delta
        if j < 0 or j >= len(self.segments):
            return
        self.segments[idx], self.segments[j] = self.segments[j], self.segments[idx]
        self._fill_tree()
        self._select(j)

    def _clear(self):
        if not self.segments:
            return
        self.segments = []
        self._fill_tree()
        self._load_to_form(None)

    def _import_time(self):
        """从剪贴板读 `-ss S -to E` 行批量建段（与音频截取的「导入时间」同格式）。"""
        # 先保存正在编辑的段（防导入时本段改动丢失）
        self._commit_form_to(self._last_sel)
        # ⚠️ 非阻塞读（2026-09-16）：同步 clipboard_get 在预览窗口持有剪贴板时会死锁，
        # 主线程全程不阻塞、读毕再建段。
        read_clipboard_safe(self.win, self._import_time_apply)

    def _import_time_apply(self, text):
        text = (text or "").strip()
        pairs = parse_ss_to_commands(text)
        if alert_if(not pairs, _("提示"), _("剪贴板没有可解析的时间（格式：-ss 10.5 -to 20.3）"), 'info', parent=self.win):
            return
        t = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        for s, e in pairs:
            self.segments.append({
                "enabled": True, "start": float(s), "end": float(e), "type": t,
                "p1": defaults[0] if len(defaults) > 0 else "",
                "p2": defaults[1] if len(defaults) > 1 else "",
                "soft": 0,
            })
        self._fill_tree()
        self._select(len(self.segments) - 1)

    def _select(self, idx):
        if idx is None or idx < 0 or not self.segments:
            self._last_sel = None
            self._load_to_form(None)
            return
        self._last_sel = idx
        self.tree.selection_set(str(idx))
        self.tree.see(str(idx))
        self._load_to_form(idx)

    # ---------- 时间预览入口（2026-09-05 方案B：简易时间预览音频引擎形态） ----------
    def _open_time_preview(self):
        """打开简易时间预览（打开即音频引擎：ffplay 直读+内存波形+段落条打标）。
        「发送到列表」把标记段按编辑区当前效果类型追加到本对话框分段列表，
        时间=源文件时间线（启用截取/变速后由 build_audio_segment_filters 自动换算）。"""
        try:
            path = self.file_source()
        except Exception:
            path = None
        if alert_if(not path or not os.path.exists(path), _("提示"), _("未找到音频/视频源文件，无法打开时间预览"), 'info', parent=self.win):
            return
        app = self.app
        if alert_if(app is None or not getattr(app, "ffmpeg_cmd", None), _("提示"), _("未找到 ffmpeg，无法预览"), 'info', parent=self.win):
            return
        # ⚠️ 释放宿主弹窗的模态 grab（与其它时间预览入口同一问题）——否则预览窗口
        # 被 grab 锁住焦点（点击/拖拽无效），预览窗口自身置顶可交互。
        release_grab(app.root)
        # 已有分段回溯为标记段显示在段落条上（可直接在此基础上增删改再发回）
        init_marks = [(s.get("start"), s.get("end")) for s in self.segments]
        app.show_time_picker(self.win, path,
                             on_send_segments=self._receive_preview_marks,
                             initial_marks=init_marks,
                             use_output_context=False,   # 纯源时间线，不显示成片时间
                             start_mode="audio")

    def _receive_preview_marks(self, pairs):
        """简易时间预览「发送到列表」回调：标记段按编辑区当前效果类型追加为分段。
        落点结构与「导入时间」完全一致（enabled/start/end/type/p1/p2/soft）。"""
        with suppress(Exception):
            self._commit_form_to(self._last_sel)   # 先落盘正在编辑的段，防改动丢失
        t = aseg_key_from_label(self.type_var.get())
        spec = AUDIO_SEGMENT_TYPES.get(t, {})
        defaults = [dv for _lb, dv in spec.get("params", [])]
        added = 0
        for s, e in pairs:
            try:
                a, b = float(s), float(e)
            except (TypeError, ValueError):
                continue
            if b <= a:
                continue
            self.segments.append({
                "enabled": True, "start": a, "end": b, "type": t,
                "p1": defaults[0] if len(defaults) > 0 else "",
                "p2": defaults[1] if len(defaults) > 1 else "",
                "soft": 0,
            })
            added += 1
        if added:
            self._fill_tree()
            self._select(len(self.segments) - 1)

    # ---------- 构建 ----------
    def show(self):
        win = self.win = tk.Toplevel(self.parent)
        win.withdraw()
        win.title(self.title_text)

        main = ttk.Frame(win, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        tip = ttk.Label(main,
                        text=_("在指定时间区间内施加音频效果，音频总时长不变。"
                             "时间填源文件里听到第几秒，工具会自动按截取/变速换算到输出时间线。"),
                        wraplength=860, justify=tk.LEFT, foreground="#555555")
        tip.pack(fill=tk.X, pady=(0, 6))

        # ---- 列表 ----
        cols = ("on", "start", "end", "dur", "type", "param")
        tree = self.tree = ttk.Treeview(main, columns=cols, show="headings",
                                        height=self._TREE_H, selectmode="browse")
        for cid, head, w in (("on", _("启用"), 42), ("start", _("开始"), 96), ("end", _("结束"), 96),
                             ("dur", _("时长"), 76), ("type", _("效果"), 88), ("param", _("参数"), 190)):
            tree.heading(cid, text=head)
            tree.column(cid, width=w, anchor=tk.W if cid in ("type", "param") else tk.CENTER)
        sb = ttk.Scrollbar(main, orient=tk.VERTICAL, command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb.pack(side=tk.LEFT, fill=tk.Y)
        tree.bind("<<TreeviewSelect>>", self._on_select)

        right = ttk.Frame(main)
        right.pack(side=tk.LEFT, fill=tk.BOTH, padx=(8, 0))

        # 双击切换启用（单行刷新：整表重建会丢选择并派发 TreeviewSelect 回环）
        def _toggle_enabled(_evt=None):
            idx = self._sel_index()
            if idx is None:
                return
            self.segments[idx]["enabled"] = not self.segments[idx].get("enabled", True)
            self._refresh_row(idx)
            self._update_count()
        tree.bind("<Double-1>", _toggle_enabled)

        # ---- 编辑区 ----
        ed = ttk.LabelFrame(right, text=_("编辑选中段"), padding="6")
        ed.pack(fill=tk.X)

        self.start_var = tk.StringVar()
        self.end_var = tk.StringVar()
        self.type_var = tk.StringVar(value=aseg_type_label("mute"))
        self.p1_var = tk.StringVar()
        self.p2_var = tk.StringVar()
        self.soft_var = tk.StringVar(value="0")

        r = 0
        _lbltt16 = ttk.Label(ed, text=_("开始:"))
        _lbltt16.grid(row=r, column=0, sticky="w", pady=3)
        e_s = ttk.Entry(ed, textvariable=self.start_var, width=12)
        e_s.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(_lbltt16, _("开始时间，支持 12.5 或 00:00:12.500"))

        r += 1
        _lbltt17 = ttk.Label(ed, text=_("结束:"))
        _lbltt17.grid(row=r, column=0, sticky="w", pady=3)
        e_e = ttk.Entry(ed, textvariable=self.end_var, width=12)
        e_e.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(_lbltt17, _("结束时间，必须大于开始时间"))

        r += 1
        _lbltt18 = ttk.Label(ed, text=_("效果:"))
        _lbltt18.grid(row=r, column=0, sticky="w", pady=3)
        # 下拉显示中文名，内部数据一律存 key（aseg_key_from_label / aseg_type_label 互转）
        cb = ttk.Combobox(ed, textvariable=self.type_var, state="readonly", width=11,
                          values=[_(_spec["label"]) for _spec in AUDIO_SEGMENT_TYPES.values()])
        cb.grid(row=r, column=1, sticky="w", pady=3)
        self._type_combo = cb
        ToolTip(_lbltt18, _("选择该时间段内要施加的音频效果，下方参数框会随效果类型自动切换。"),
                wraplength=380)

        r += 1
        self._param_widgets = []
        for i in range(2):
            lbl = ttk.Label(ed, text="—:")
            lbl.grid(row=r + i, column=0, sticky="w", pady=3)
            var = tk.StringVar()
            ent = ttk.Entry(ed, textvariable=var, width=10)
            ent.grid(row=r + i, column=1, sticky="w", pady=3)
            self._param_widgets.append((lbl, ent, var))
        self.p1_var = self._param_widgets[0][2]
        self.p2_var = self._param_widgets[1][2]

        r += 2
        self.soft_label = ttk.Label(ed, text=_("柔化(ms):"))
        self.soft_label.grid(row=r, column=0, sticky="w", pady=3)
        self.soft_entry = ttk.Entry(ed, textvariable=self.soft_var, width=10)
        self.soft_entry.grid(row=r, column=1, sticky="w", pady=3)
        ToolTip(self.soft_label,
                _("静音/局部音量的边缘过渡时长（毫秒），0=硬切。\n"
                "30~50ms 可明显减轻静音起止点的爆音；段数较多时表达式会变长，建议不超过 20 段。"))

        # 时间与数值框绑 <Return>/<FocusOut>，另挂 write trace 实时提交到 _last_sel：
        # 用户「输入完马上点下一段」时，FocusOut 与 TreeviewSelect 的先后不可靠，单靠失焦
        # 提交会把上一段输入写进新段；trace 在击键当下即落盘，消除“未提交残留”。
        # （trace 回调只读变量 → 写内存 → tree.item 单行刷新，绝不做 .set 回填，
        #   故不触发“同值写入回环 / set 推光标”铁律场景；_load_to_form 内由 _loading 短路。）
        for w in (e_s, e_e, self.soft_entry,
                  self._param_widgets[0][1], self._param_widgets[1][1]):
            w.bind("<Return>", self._apply_form_to_sel)
            w.bind("<FocusOut>", self._apply_form_to_sel)
        for _v in (self.start_var, self.end_var, self.soft_var,
                   self._param_widgets[0][2], self._param_widgets[1][2]):
            with suppress(Exception):
                _v.trace_add("write", self._apply_form_to_sel)
        cb.bind("<<ComboboxSelected>>", self._on_type_changed)

        # ---- 操作按钮 ----
        btns = ttk.Frame(right)
        btns.pack(fill=tk.X, pady=(8, 0))
        ttk.Button(btns, text=_("添加"), width=8, command=self._add).grid(row=0, column=0, padx=2, pady=2)
        ttk.Button(btns, text=_("删除"), width=8, command=self._delete).grid(row=0, column=1, padx=2, pady=2)
        ttk.Button(btns, text=_("上移"), width=8, command=lambda: self._move(-1)).grid(row=1, column=0, padx=2, pady=2)
        ttk.Button(btns, text=_("下移"), width=8, command=lambda: self._move(1)).grid(row=1, column=1, padx=2, pady=2)
        ttk.Button(btns, text=_("清空"), width=8, command=self._clear).grid(row=2, column=0, padx=2, pady=2)
        _btn_import_time = ttk.Button(btns, text=_("导入时间"), width=8, command=self._import_time)
        _btn_import_time.grid(row=2, column=1, padx=2, pady=2)
        # tooltip 绑在「导入时间」按钮本体上（不能绑 btns 整块，会盖住相邻控件悬停提示）
        ToolTip(_btn_import_time,
                _("导入时间：从剪贴板读取多行 `-ss 开始 -to 结束`，一次性建成多段，\n"
                "效果类型取编辑区当前所选。格式与音频截取的「导入时间」一致。"),
                wraplength=380)
        # 时间预览（2026-09-05）：6 个操作按钮下面第 7 个入口——打开即简易时间预览
        # 音频引擎（ffplay 直读+波形），「发送到列表」直达本对话框分段列表
        if self.file_source is not None:
            _btn_time_preview = ttk.Button(btns, text=_("时间预览"), width=8,
                                           command=self._open_time_preview)
            _btn_time_preview.grid(row=3, column=0, columnspan=2, sticky="we",
                                   padx=2, pady=(4, 0))
            ToolTip(_btn_time_preview,
                    _("打开简易时间预览（音频引擎形态）：ffplay 直读播放 + 内存波形 + 段落条打标。\n"
                    "听杂音/鼓点打标成段后点「发送到列表」，按编辑区当前效果类型追加到本分段列表。\n"
                    "时间=源文件时间线，启用截取/变速后由工具自动换算。\n"
                    "打开即音频形态：不显示画面、没有逐帧步进——音轨没有「帧」的概念，\n"
                    "定位靠波形 + 反复听（与 Shotcut 等剪辑软件一致，非本工具缺陷）。\n"
                    "要帧级定位：在预览窗口内点「画面模式」按钮切回帧浏览器。"),
                    wraplength=380)

        self.count_label = ttk.Label(right, text="", foreground="#555555")
        self.count_label.pack(anchor="w", pady=(8, 0))

        # ---- 底部：确定 col0 / 取消 col1 ----
        bottom = ttk.Frame(win, padding=(10, 0, 10, 10))
        bottom.pack(fill=tk.X)
        btn_row = ttk.Frame(bottom)
        btn_row.pack()

        def _ok():
            self.result = [dict(s) for s in self.segments]
            win.destroy()

        ttk.Button(btn_row, text=_("确定"), width=10, command=_ok).pack(side=tk.LEFT, padx=5)
        ttk.Button(btn_row, text=_("取消"), width=10, command=win.destroy).pack(side=tk.LEFT, padx=5)

        self._fill_tree()
        if self.segments:
            self._select(0)
        else:
            self._load_to_form(None)

        try:
            center_window(win, 920, 470)
        except Exception:
            win.geometry("920x470")
            win.deiconify()
        win.transient(self.parent.winfo_toplevel())
        win.wait_window()
        return self.result


class AudioFrame(ttk.LabelFrame):
    def __init__(self, parent, enable_checkbox=False, refresh_cb=None,
                 app=None, file_source=None, **kwargs):
        super().__init__(parent, text=_("音频"), padding="5", **kwargs)
        # app/file_source：时间预览入口上下文（显式参数，绝不进 **kwargs——ttk 不认识）
        self.app = app
        self.file_source = file_source
        self.enable_checkbox = enable_checkbox
        self.refresh_cb = refresh_cb    # 分段等延迟到弹窗确定才生效的设置 → 确定后回调刷新命令预览
        self.audio_segments = []
        self.create_widgets()

    def create_widgets(self):
        inner = ttk.Frame(self)
        inner.pack(fill=tk.X, expand=True)
    
        top_row = ttk.Frame(inner)
        top_row.pack(fill=tk.X, pady=(0,5))

        if self.enable_checkbox:
            self.audio_enabled = tk.BooleanVar(value=True)
            chk = ttk.Checkbutton(top_row, text=_("保留音频"), variable=self.audio_enabled)
            chk.pack(side=tk.LEFT)

        self.only_audio = tk.BooleanVar(value=False)
        self.only_audio_cb = ttk.Checkbutton(top_row, text=_("仅提取音频"), variable=self.only_audio)
        self.only_audio_cb.pack(side=tk.LEFT, padx=(50,2))

        # "仅提取音频" ↔ "保留音频" 联动：勾选仅音频时强制保留音频，取消时恢复
        self._prev_only_audio = False
        self._saved_audio_enabled = True  # 记录勾选"仅音频"前的状态
        def _on_only_audio_changed(*args):
            curr = self.only_audio.get()
            if curr and not self._prev_only_audio:
                # 勾上"仅音频" → 保存旧状态并强制保留音频
                self._saved_audio_enabled = self.audio_enabled.get()
                self.audio_enabled.set(True)
            elif not curr and self._prev_only_audio:
                # 取消"仅音频" → 恢复原来的保留音频状态
                self.audio_enabled.set(self._saved_audio_enabled)
            self._prev_only_audio = curr
        self.only_audio.trace_add("write", _on_only_audio_changed)

        ttk.Label(top_row, text=_("输出容器:")).pack(side=tk.LEFT, padx=(12,2))
        self.audio_format = tk.StringVar(value="m4a")
        audio_format_combo = ttk.Combobox(top_row, textvariable=self.audio_format,
                                          values=["mp3", "aac", "m4a", "flac", "opus", "wav", "ac3"],
                                          state="readonly", width=6)
        audio_format_combo.pack(side=tk.LEFT, padx=2)
        ToolTip(self.only_audio_cb, _("勾选后，将只输出音频文件（自动添加 -vn 忽略视频），\n输出容器将使用右边选择的音频格式"), wraplength=440, offset_x=0, offset_y=5)

        # ---- 音轨处理（多音轨）：仅第1轨 / 全部·同参重编码 / 全部·原样保留 ----
        # ⚠️ audio_track_mode 的值域恒为 first/all_reencode/all_copy（命令组装按此比较），
        # 中文只用于显示 → 必须用独立 disp 变量做双向映射，
        # 绝不可把中文直接绑进 audio_track_mode（否则 all_copy 判定永远为假、原样保留会被重编码）。
        _lbltt20 = ttk.Label(top_row, text=_("音轨:"))
        _lbltt20.pack(side=tk.LEFT, padx=(12,2))
        self.audio_track_mode = tk.StringVar(value="first")
        self._atm_v2d = {"first": _("仅第1轨"), "all_reencode": _("全部·同参重编码"),
                         "all_copy": _("全部·原样保留")}
        self._atm_d2v = {_v: _k for _k, _v in self._atm_v2d.items()}
        self._audio_track_disp = tk.StringVar(value=self._atm_v2d["first"])
        track_mode_combo = ttk.Combobox(top_row, textvariable=self._audio_track_disp, width=14,
                                        values=list(self._atm_v2d.values()), state="readonly")
        track_mode_combo.pack(side=tk.LEFT, padx=2)
        def _atm_disp_to_val(*_a):
            _v = self._atm_d2v.get(self._audio_track_disp.get())
            if _v and self.audio_track_mode.get() != _v:
                self.audio_track_mode.set(_v)
        def _atm_val_to_disp(*_a):
            _d = self._atm_v2d.get(self.audio_track_mode.get())
            if _d and self._audio_track_disp.get() != _d:
                self._audio_track_disp.set(_d)
        self._audio_track_disp.trace_add("write", _atm_disp_to_val)
        self.audio_track_mode.trace_add("write", _atm_val_to_disp)
        ToolTip(_lbltt20, _("多音轨源的处理方式（单音轨源无差别）：\n"
               "仅第1轨=默认（对标旧行为，其余音轨丢弃）；\n"
               "全部·同参重编码=保留所有源音轨并用本页音频设置统一重编码；\n"
               "全部·原样保留=所有源音轨直接 copy（忽略音频滤镜）。"), wraplength=460)
    
        controls_frame = ttk.Frame(inner)
        controls_frame.pack(fill=tk.X, expand=True, pady=(5,0))

        ttk.Label(controls_frame, text=_("编码器:")).pack(side=tk.LEFT)
        self.audio_codec = tk.StringVar(value="aac")
        ttk.Combobox(controls_frame, textvariable=self.audio_codec,
                     values=ALL_AUDIO_ENCODERS, state="readonly", width=10).pack(side=tk.LEFT, padx=5)
        _lbltt21 = ttk.Label(controls_frame, text=_("比特率:"))
        _lbltt21.pack(side=tk.LEFT)
        self.audio_bitrate = tk.StringVar(value="auto")
        bitrate_combo = ttk.Combobox(controls_frame, textvariable=self.audio_bitrate, width=6, values=["auto","64k", "96k", "128k", "192k", "256k", "320k"], state='readonly')
        bitrate_combo.pack(side=tk.LEFT, padx=5)
        ToolTip(_lbltt21, _("auto = 不向 ffmpeg 传 -b:a，由编码器自行决定。\n\n无损编码器（FLAC/ALAC/PCM）不接受比特率——ffmpeg 会静默忽略。"), wraplength=420)

        _lbltt22 = ttk.Label(controls_frame, text=_("采样率:"))
        _lbltt22.pack(side=tk.LEFT)
        self.audio_samplerate = tk.StringVar(value="auto")
        samplerate_combo = ttk.Combobox(controls_frame, textvariable=self.audio_samplerate, width=8, values=["auto","8000","12000","16000","22050","32000", "44100", "48000", "96000"], state='readonly')
        samplerate_combo.pack(side=tk.LEFT, padx=5)

        # ---- AAC VBR 质量模式（仅 native aac 可用）----
        self.audio_vbr = tk.BooleanVar(value=False)
        self.audio_quality = tk.StringVar(value="2.0")
        vbr_cb = ttk.Checkbutton(controls_frame, text="VBR", variable=self.audio_vbr)
        vbr_cb.pack(side=tk.LEFT, padx=(10,2))
        ttk.Label(controls_frame, text=_("质量:")).pack(side=tk.LEFT)
        quality_combo = ttk.Combobox(controls_frame, textvariable=self.audio_quality,
                                     values=["0.5", "1.0", "1.5", "2.0"], state="readonly", width=5)
        quality_combo.pack(side=tk.LEFT, padx=2)
        quality_combo.config(state=tk.DISABLED)
        ToolTip(vbr_cb, _("AAC VBR 质量模式：勾选后用 -q:a 质量编码替代固定比特率（仅 native aac）。\n"
                       "libfdk_aac 用 -vbr 质量模式，但默认 ffmpeg 构建未含该非自由编码器，本版不暴露。"),
               wraplength=460)
        ToolTip(_lbltt22, _("auto = 保持源采样率，不传 -ar（推荐）。\n\n指定数值会强制重采样，对无损编码器等于破坏无损。"), wraplength=420)

        # 无损 / 直通编码器：比特率本就不接受（ffmpeg 静默忽略）→ 置灰；
        # 采样率也必须强制 auto 并置灰——否则 build_audio_encoder_args 会带 -ar，
        # 把无损源重采样（如 48k→44.1k）破坏无损（B方案铁律：「-ar 是真伤」）。
        # 切到无损前先备份有损时的值，切回有损再还原，避免用户显式设的 44100/128k 被吞。
        # 事件绑定紧跟控件创建，绝不塞进几何/尺寸类方法（历史教训：曾导致绑定从未生效）。
        def _sync_bitrate_state(*_args):
            _codec = self.audio_codec.get()
            _lossless_or_copy = (_codec in LOSSLESS_AUDIO_CODECS) or (_codec == "copy")
            if _lossless_or_copy:
                # 备份有损时的值（首次进入可能尚无属性）
                self._lossy_br_backup = self.audio_bitrate.get()
                self._lossy_sr_backup = self.audio_samplerate.get()
                bitrate_combo.config(state=tk.DISABLED)
                samplerate_combo.config(state=tk.DISABLED)
                # 比特率对无损/直通无效（helper 已跳过 -b:a），值留着无害；
                # 采样率必须改 auto，否则 -ar 会破坏无损。
                self.audio_samplerate.set(AUDIO_AUTO)
            else:
                bitrate_combo.config(state="readonly")
                samplerate_combo.config(state="readonly")
                # 还原切到无损前用户选的有损值（无备份则维持现状）
                if getattr(self, "_lossy_sr_backup", None) is not None:
                    self.audio_samplerate.set(self._lossy_sr_backup)
                    self._lossy_sr_backup = None
                if getattr(self, "_lossy_br_backup", None) is not None:
                    self.audio_bitrate.set(self._lossy_br_backup)
                    self._lossy_br_backup = None
        self.audio_codec.trace_add("write", _sync_bitrate_state)

        # VBR 模式联动（仅 native aac 可用）：勾选后改用 -q:a，禁用比特率；
        # 无损/直通或非 aac 时强制关闭并禁用。事件绑定紧跟控件创建（历史教训）。
        def _sync_vbr_state(*_args):
            _codec = self.audio_codec.get()
            _lossless_or_copy = (_codec in LOSSLESS_AUDIO_CODECS) or (_codec == "copy")
            if _lossless_or_copy or _codec != "aac":
                if self.audio_vbr.get():
                    self.audio_vbr.set(False)
                vbr_cb.config(state=tk.DISABLED)
                quality_combo.config(state=tk.DISABLED)
                bitrate_combo.config(state=tk.DISABLED if _lossless_or_copy else "readonly")
            else:
                vbr_cb.config(state=tk.NORMAL)
                if self.audio_vbr.get():
                    bitrate_combo.config(state=tk.DISABLED)
                    quality_combo.config(state="readonly")
                else:
                    bitrate_combo.config(state="readonly")
                    quality_combo.config(state=tk.DISABLED)
        self.audio_vbr.trace_add("write", _sync_vbr_state)
        _sync_bitrate_state()
        _sync_vbr_state()

        volume_frame = ttk.Frame(inner)
        volume_frame.pack(fill=tk.X, pady=(2,0))
        self.volume_enabled = tk.BooleanVar(value=False)
        chk_volume = ttk.Checkbutton(volume_frame, text=_("启用音量"), variable=self.volume_enabled)
        chk_volume.pack(side=tk.LEFT, padx=(0,5))
        ToolTip(chk_volume, _("勾选后启用音量倍数调整，可拖动滑块设置倍数（0.1~3.0）\n\n1.0=原始音量"), wraplength=400)
        ttk.Label(volume_frame, text=_("倍数:")).pack(side=tk.LEFT, padx=(5,0))
        self.volume_value = tk.DoubleVar(value=1.0)
        self.volume_text = tk.StringVar(value="1.00")
        self._vol_sync = [False]                      # 编辑框↔滑块同步锁，防 trace 自激
        self.volume_slider = ttk.Scale(volume_frame, from_=0.1, to=3.0, variable=self.volume_value,
                                       orient=tk.HORIZONTAL, length=110, state=tk.DISABLED)
        self.volume_slider.pack(side=tk.LEFT, padx=5)
        # 滑块右侧编辑框：可直接键入倍数（0.1~3.0），与滑块双向同步（2026-09-26）
        # ⚠️ 原右侧是只读 Label，改成 Entry 后必须自己保证「键入即生效」，否则等于没加。
        self.volume_entry = ttk.Entry(volume_frame, textvariable=self.volume_text, width=5,
                                      justify=tk.CENTER)
        self.volume_entry.pack(side=tk.LEFT)

        def _vol_from_entry(*_a):
            if self._vol_sync[0]:
                return
            try:
                v = float(self.volume_text.get())
            except (ValueError, TypeError):
                self._vol_sync[0] = True
                self.volume_text.set(f"{self.volume_value.get():.2f}")
                self._vol_sync[0] = False
                return
            if v < 0.1:
                v = 0.1
            elif v > 3.0:
                v = 3.0
            self._vol_sync[0] = True
            self.volume_value.set(v)
            self.volume_text.set(f"{v:.2f}")
            self._vol_sync[0] = False

        def _vol_from_slider(v):
            if self._vol_sync[0]:
                return
            # ⚠️ 置锁必须在写文本**之前**：写文本会触发 volume_text 的 trace →
            #    _vol_from_entry，不置锁就会把滑块值反向写回 volume_value（多余往返）。
            self._vol_sync[0] = True
            self.volume_text.set(f"{float(v):.2f}")
            self._vol_sync[0] = False

        self.volume_text.trace_add("write", _vol_from_entry)
        self.volume_entry.bind("<Return>", lambda e: self.volume_entry.selectrange(0, tk.END))
        self.volume_slider.configure(command=_vol_from_slider)

        def on_volume_enabled(*args):
            state = tk.NORMAL if self.volume_enabled.get() else tk.DISABLED
            self.volume_slider.config(state=state)
            # 编辑框跟随滑块一起禁用/启用，否则「未勾选启用」还能键入（口径不一致）
            self.volume_entry.config(state=state)
        self.volume_enabled.trace_add("write", on_volume_enabled)

        # 变速 + 高级音频弹窗
        adv_row = ttk.Frame(inner)
        adv_row.pack(fill=tk.X, pady=(3,0))
        self.audio_speed_enabled = tk.BooleanVar(value=False)
        ttk.Checkbutton(adv_row, text=_("变速"), variable=self.audio_speed_enabled).pack(side=tk.LEFT, padx=(0,3))
        ttk.Label(adv_row, text=_("倍数:")).pack(side=tk.LEFT)
        self.audio_speed_factor = tk.StringVar(value="1.0")
        ttk.Entry(adv_row, textvariable=self.audio_speed_factor, width=7).pack(side=tk.LEFT, padx=3)
        ToolTip(adv_row, _("音频变速（atempo），0.25~4.0，>2 自动串联多个 atempo"), wraplength=400)

        # 音频倒放独立控制（不再跟随主视频倒放）
        self.audio_reverse = tk.BooleanVar(value=False)
        chk_reverse = ttk.Checkbutton(adv_row, text=_("音频倒放（独立于视频）"), variable=self.audio_reverse)
        chk_reverse.pack(side=tk.LEFT, padx=(5,0))
        ToolTip(chk_reverse, _("勾选后，音频将单独倒放，不受视频倒放影响；与上方「变速」同为独立控制。"))

        ttk.Button(adv_row, text=_("高级音频…"), command=self._open_advanced_audio_dialog).pack(side=tk.LEFT, padx=(10,0))

        # ---- 音频分段效果（独立一行）：按时间段施加效果，与上面的全局效果互不冲突 ----
