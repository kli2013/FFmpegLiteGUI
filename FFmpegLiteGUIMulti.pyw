# 反交错滤镜的「已死旧值 → 现行值」别名表。
# 旧版下拉里提供过 "pp=lb"（行混合）：新版 ffmpeg 已移除 libpostproc，`pp` 滤镜不存在，
# 选中即报 "Error parsing a filter description"（2026-09-14 审计实测）。
# 这里负责把旧 app_settings.json / 旧模板 / 旧队列里残留的 "pp=lb" 静默迁移为
# "bwdif"（本机在册、运动自适应、比 yadif 更锐利），避免老用户升级后一开程序就踩死滤镜。
_DEINTERLACE_LEGACY_ALIASES = {"pp=lb": "bwdif"}


def normalize_deinterlace_filter(value):
    """把旧版 deinterlace_filter 值迁移为当前有效值；非 str 原样返回（空值判断交给调用方）。"""
    if isinstance(value, str):
        return _DEINTERLACE_LEGACY_ALIASES.get(value, value)
    return value

# ---------- 缩放算法（2026-10-08） ----------
# scale 滤镜默认走 -sws_flags 的默认值（本机 n9.0.1 实测 default bicubic），
# 界面此前恒生成裸 `scale=W:H`（= 用默认 bicubic）。放大时 lanczos/spline 明显更锐，
# 缩小时 area/sinc 抗锯齿更好 —— 这条是网上高级转码实践里几乎人手一条的旋钮。
# ⚠️ 白名单是**硬需求**：实测 `flags=point` 与任意非法值都会让 ffmpeg **rc=127 直接崩**
# （"Unable to parse \"sws_flags\" option value"），不是静默降级 ⇒ 非法值一律退回「自动」。
# ⚠️ canonical 恒为**英文**（与 _MARK_SENTINEL / hwaccel 的 canonical 惯例一致）：
#    只有「自动」这一项需要翻译显示，算法名是 ffmpeg 原生枚举、各语言通用。
_SCALE_ALGORITHMS = ("lanczos", "bicubic", "spline", "bilinear", "neighbor",
                     "area", "sinc", "gauss", "bicublin", "fast_bilinear")
# 「自动」/空/None = 不写 flags（用 ffmpeg 默认）→ 与旧行为逐字一致。
# 大小写不敏感（英文界面下 _() 会把「自动」译成 "Auto"）。
_SCALE_ALGO_AUTO_WORDS = ("", "auto", "自动")


def _norm_scale_algorithm(v) -> str:
    """缩放算法归一：返回要写进 scale 滤镜的 flags 值；「自动」/非法 → 空串（不写 flags）。"""
    _s = str(v or "").strip()
    _low = _s.lower()
    if _low in _SCALE_ALGO_AUTO_WORDS:
        return ""
    return _low if _low in _SCALE_ALGORITHMS else ""

# 无损音频编码器：不接收 -b:a（ffmpeg 静默忽略，HandBrake 也不提供该选项），
# 且对容器有约束（见 AUDIO_CONTAINER_MATRIX）。含下拉未列出者仅作防御。
LOSSLESS_AUDIO_CODECS = frozenset({
    "flac", "alac", "truehd", "dts", "dtshd", "tta", "wavpack",
    "pcm_s16le", "pcm_s24le", "pcm_s32le", "pcm_f32le", "pcm_f64le",
    "pcm_s16be", "pcm_s24be", "pcm_s32be", "pcm_f32be", "pcm_f64be",
})
# 比特率/采样率 «auto» 哨兵：保持源 / 交给编码器，不拼 -b:a / -ar。
AUDIO_AUTO = "auto"

# 音频编码器 × 容器 兼容矩阵（**逐格真机实测**，2026-09-14 用本机 ffmpeg n9.0.1 重测）。
# 方法：`ffmpeg -f lavfi -i sine -c:a <codec> out.<ext>`，rc==0 才记入；opus 额外带 -strict -2
#       （原生 opus 是实验性编码器，不加必 rc≠0 —— 与 build_audio_encoder_args 的行为一致）。
# 复跑：`python tests/_audit_ffmpeg_spec.py --matrix` 直接打印可粘贴的表体。
# 语义：matrix[codec] = 「该编码器能装进哪些容器」。**高估的后果是「该切容器却不切」→
#       用户拿到 ffmpeg 报错**；少列的后果只是多切一次容器（仍能成功），所以宁可保守。
# 例外：`copy` 是「容器 × 源编码」的关系、不是编码器属性，无法用固定源判定 → 保留原样。
# 仅用于「仅音频」模式下 codec×容器错配时自动改容器（不弹窗，只日志）。
# ⚠ 2026-09-14 之前的旧表把 aac/ac3/eac3/libmp3lame/pcm_s16le 几行几乎写成了「全部 13 个容器」，
#   6~8 格/行 实测根本不成立（如 aac→.mp3 报 "Exactly one MP3 audio stream is required"）。
AUDIO_CONTAINER_MATRIX = {
    "copy":        {"mp3", "aac", "m4a", "flac", "opus", "wav", "ac3", "mka", "ogg", "webm", "mp4", "mkv", "mov"},
    "aac":         {"aac", "m4a", "wav", "mka", "mp4", "mkv", "mov"},
    "libmp3lame":  {"mp3", "wav", "mka", "mp4", "mkv", "mov"},
    "opus":        {"opus", "mka", "ogg", "webm", "mp4", "mkv"},   # mov 不在列：实测 "opus only supported in MP4"
    "ac3":         {"m4a", "wav", "ac3", "mka", "mp4", "mkv", "mov"},
    "eac3":        {"wav", "mka", "mp4", "mkv", "mov"},
    "flac":        {"flac", "opus", "wav", "mka", "ogg", "mp4", "mkv"},   # .opus/.ogg 扩展名走 Ogg 系封装，实测可容纳 flac
    "alac":        {"m4a", "mka", "mp4", "mkv", "mov"},
    "pcm_s16le":   {"wav", "mka", "mp4", "mkv", "mov"},
}
# 每类编码器错配时的回退容器优先级（最通用在前）。
_AUDIO_FALLBACK_CONTAINERS = ["mka", "mkv", "wav", "mp4", "mov", "flac", "m4a", "mp3"]


def audio_stream_suffix(n):
    """输出音频流的「按轨说明符」后缀，供 -filter:a:N / -c:a:N / -b:a:N 等使用。

    为什么必须是 ':{n}' 而不是 ':a:{n}'（2026-09-13 真机实测，修掉两个 bug）：
    1) 前缀本身已含 ':a'（build_audio_encoder_args 内部硬编码 "-c:a"/"-b:a"/
       "-q:a"/"-ar:a"）。旧调用点传 ':a:{n}' → 拼出 `-c:a:a:0`，ffmpeg 直接报
       「Stream type specified multiple times」并拒绝打开输出文件（rc=-22）。
    2) 按轨音频滤镜只能用 `-filter:a:N`，**不可用 `-af:a:N`**。实测 -af 的流
       说明符会被忽略（等价于全局 -af，多条里最后一条套到全部音轨），多音轨时
       各轨 trim/volume/speed 互相串味，而且完全静默、ffmpeg 不报任何错。
    """
    return f":{n}"


def build_audio_encoder_args(acodec, settings, stream_tag="", skip_ar=False):
    """统一拼装单条音频输出流参数，处理无损 / auto 边界。

    - acodec == "copy"   → 仅 -c:a{tag} copy（不拼码率/采样率）
    - 无损编码器         → 跳过 -b:a（ffmpeg 静默忽略，HandBrake 也不提供该选项）
    - 比特率/采样率==auto → 跳过对应参数（保持源 / 交给编码器自行决定）
    - 其余               → 正常拼 -b:a{tag} / -ar{tag}
    - skip_ar=True       → 跳过 -ar（soxr 链已用 aresample 精确重采样，-ar 是 no-op；
                           只在该轨滤镜链确实追加了 soxr 时由调用点传入，
                           禁止按 settings 键全局推断——多段拼接分支链内无 soxr）

    settings 兼容两套键名：主面板用 audio_bitrate/audio_samplerate，
    合并轨道级 enc_settings 用 bitrate/samplerate。
    stream_tag 例：'' 或 ':0'（拼成 -b:a:0 / -ar:a:0）；按轨时用 audio_stream_suffix(n)。
    """
    if acodec == "copy":
        return ["-c:a" + stream_tag, "copy"]
    args = []
    if acodec == "opus":
        # -strict -2 为 ffmpeg n9.0.1 实测必需：去掉即报「Experimental feature」并拒绝
        # 输出（2026-09-14 审计实测），勿删。它是 output 级选项，位置只需在输出文件之前。
        args += ["-strict", "-2"]
    args += ["-c:a" + stream_tag, acodec]
    br = settings.get("audio_bitrate")
    if br is None:
        br = settings.get("bitrate", AUDIO_AUTO)
    # AAC VBR 质量模式（仅 native aac）：-q:a 替代 -b:a
    vbr = settings.get("audio_vbr")
    if vbr is None:
        vbr = settings.get("vbr", False)
    if vbr and acodec == "aac" and acodec not in LOSSLESS_AUDIO_CODECS:
        q = settings.get("audio_quality")
        if q is None:
            q = settings.get("quality", "2")
        if str(q) not in ("", "auto"):
            args += ["-q:a" + stream_tag, str(q)]
    elif br and br != AUDIO_AUTO and acodec not in LOSSLESS_AUDIO_CODECS:
        args += ["-b:a" + stream_tag, str(br)]
    sr = settings.get("audio_samplerate")
    if sr is None:
        sr = settings.get("samplerate", AUDIO_AUTO)
    if sr and sr != AUDIO_AUTO and not skip_ar:
        args += ["-ar:a" + stream_tag, str(sr)]
    return args


def audio_soxr_resample_filter(settings):
    """非 auto 采样率时返回 soxr 高质量重采样滤镜（对标 HandBrake），否则返回 None。

    追加到音频滤镜链末尾即可；调用点需同时向 build_audio_encoder_args 传
    skip_ar=True，避免 -ar 与 aresample 重复。
    settings 兼容主面板 audio_samplerate 与封装页轨道级 samplerate 两套键名。
    依赖 ffmpeg 编译含 libsoxr（现代 Windows 构建如 gyan/BtbN 均内置）。
    """
    # copy（流复制）不可施加任何滤镜，跳过 soxr，避免触发「有滤镜→强制改 aac」
    # 的副作用而违背 copy 意图。封装轨用 encoder 键，转换页用 audio_codec 键。
    _enc = settings.get("encoder")
    if _enc is None:
        _enc = settings.get("audio_codec")
    if _enc == "copy":
        return None
    # 手动开关：默认关闭。仅在用户显式开启 soxr_enabled 且采样率≠auto 时生效。
    # soxr 仅在超声区（>20kHz 混叠抑制）有明显优势，可听范围≈零，故默认不开启。
    # 注意：本函数返回非 None 时，调用点应向 build_audio_encoder_args 传 skip_ar=True
    # （aresample 已完成重采样，-ar 冗余）。
    if not settings.get("soxr_enabled", False):
        return None
    sr = settings.get("audio_samplerate")
    if sr is None:
        sr = settings.get("samplerate", AUDIO_AUTO)
    if sr and sr != AUDIO_AUTO:
        return f"aresample={sr}:resampler=soxr"
    return None


def compatible_audio_container(acodec, preferred):
    """仅音频模式下：若 preferred 容器与 acodec 不兼容，返回兼容容器，否则原样返回。"""
    ok = AUDIO_CONTAINER_MATRIX.get(acodec)
    if ok is None or preferred in ok:
        return preferred
    for c in _AUDIO_FALLBACK_CONTAINERS:
        if c in ok:
            return c
    return preferred

