                    # 置于矩形描边之下（矩形 fill="" 透明 → 内容可见）
                    with suppress(Exception):
                        canvas.tag_lower(content_img_id, "rect")
                # 矩形描边/坐标显示/旋转手柄不能被合成图盖住
                for _t in ("rect", "coord_disp", rotate_handle_id):
                    if _t:
                        with suppress(Exception):
                            canvas.tag_raise(_t)
                # ⚠️ 合成图是不透明黑底整帧，刚被压到「rect」之下 → 正好落在幽灵之上。
                # 必须重排幽灵，否则参考框被黑画布整块盖住（2026-09-12 修复）。
                _restack_ghost()
            except Exception:
                pass

        def _schedule_content_render():
            # 🔴 2026-10-17：组盒模式只有 `content_ppm`（无 content_file）⇒ 旧判据直接
            # return，内容帧永不渲染（框内黑）。必须认 `_has_content_src`。
            if not _has_content_src:
                return
            # 拖动/旋转中：内容帧已隐藏（角度≠0 看红框）或正在 coords 跟随（角度≈0），
            # 不浪费 ffmpeg；松手才真正重渲染一次。
            if dragging or rotating:
                return
            if _content_render_timer[0]:
                with suppress(Exception):
                    win.after_cancel(_content_render_timer[0])
            _content_render_timer[0] = win.after(120, _do_render_content)

        def update_coord_display():
            if coord_mode == 'offset':
                coord_var.set(_('偏移: X={0}, Y={1}').format(current_x, current_y))
            else:
                # 用真实角度判定：角度 0 显示纯矩形语义（左上角=矩形左上角）
                if current_angle != 0:
                    if rot_square:
                        coord_var.set(_('左上角: ({0}, {1})  宽: {2}  高: {3}  角度: {4}°\n（有旋转时 X/Y 为内容盒左上角，旋转正方形自动居中）').format(current_x, current_y, current_w, current_h, current_angle))
                    else:
                        coord_var.set(_('左上角: ({0}, {1})  宽: {2}  高: {3}  角度: {4}°\n（档位旋转：90°顺/180°/90°逆，角度应用时吸附 90° 档）').format(current_x, current_y, current_w, current_h, current_angle))
                else:
                    coord_var.set(_('左上角: ({0}, {1})  宽: {2}  高: {3}').format(current_x, current_y, current_w, current_h))

        def _sync_scale_display():
            """缩放倍率滑块模式：把当前矩形宽高同步回「缩放%」滑块与数字框（双向同步）。

            仅在 content_src_* 提供（缩放模式）时生效；否则静默跳过。
            由 update_rect_position / end_draw（重绘新矩形后）/ 初始构建调用。
            ⚠️ 回写必须持锁：scale_pct.set 会触发 ttk.Scale 的 command → _on_scale_slider
            → update_rect_position → 本函数，不持锁即无限递归（2026-09-12 缩放滑块失效根因）。
            """
            if scale_pct is None or not content_src_w or content_src_w <= 0:
                return
            try:
                pct = current_w / content_src_w * 100.0
                _scale_sync_lock[0] = True
                try:
                    scale_pct.set(round(pct, 1))
                    if scale_entry is not None:
                        scale_entry.delete(0, tk.END)
                        scale_entry.insert(0, f"{pct:g}")
                finally:
                    _scale_sync_lock[0] = False
            except Exception:
                _scale_sync_lock[0] = False
    
        # ---- 坐标框 / 微调三行（coord_box / nudge_rows）：与可视化裁剪窗口共用构建块 ----
        # 2026-10-09：遮罩「🎯 可视化选区」与各类位置编辑器此前**只能拖**，像素级对准全靠
        # 手感；裁剪可视化窗口早就有「裁剪框数值」四格 + 「边缘/平移微调」三行，这里直接复用
        # 抽出来的 `build_coord_box` / `build_nudge_rows`，**不再另写一份**（双份判据必漂移）。
        #
        # 这里只给 get/apply/微调 三个回调；真正的构建段在下方几百行之后（right_frame 区），
        # 句柄 `coord_sync` 先置 None —— `update_rect_position` 在入口处就会调
        # `_sync_coord_box()`，那时构建段还没跑。
        def _coord_get_rect():
            if draw_mode_active:
                return None
            return (current_x, current_y, current_w, current_h)

        def _coord_apply_rect(x, y, w, h):
            """数值 / 粘贴 → 几何。钳制与重绘走 `clamp_rect()` + `update_rect_position()`
            （与画布拖拽同一条收口路径，保证框永远在画布内）。"""
            nonlocal current_x, current_y, current_w, current_h
            if draw_mode_active:
                return
            current_x, current_y = float(x), float(y)
            current_w, current_h = max(1.0, float(w)), max(1.0, float(h))
            clamp_rect()
            update_rect_position()

        def _coord_edge(edge, delta, grow=False):
            """收缩 / 扩大某一条边（grow=True 为扩大），与裁剪窗口同语义。"""
            nonlocal current_x, current_y, current_w, current_h
            if draw_mode_active:
                return
            _s = -1 if grow else 1
            if edge == "left":
                current_x += _s * delta
                current_w -= _s * delta
            elif edge == "right":
                current_w -= _s * delta
            elif edge == "top":
                current_y += _s * delta
                current_h -= _s * delta
            elif edge == "bottom":
                current_h -= _s * delta
            if current_w <= 0 or current_h <= 0:
                return
            clamp_rect()
            update_rect_position()

        def _coord_shift(direction, delta):
            """整体平移（上移 / 下移 / 左移 / 右移）。"""
            nonlocal current_x, current_y, current_w, current_h
            if draw_mode_active:
                return
            if direction == "up":
                current_y -= delta
            elif direction == "down":
                current_y += delta
            elif direction == "left":
                current_x -= delta
            else:
                current_x += delta
            clamp_rect()
            update_rect_position()

        def _sync_coord_box():
            """几何 → 四格数值框（双向同步的另一半）。coord_box=False 时静默跳过。

            ⚠️ 只在值真的变了才写（`_tk_setv` 语义）：`update_rect_position` 在拖拽期间
            每帧都跑，无差别 set 会把用户正在输入的另一格一起冲掉。
            """
            if coord_sync is not None:
                coord_sync()

        # ---- 画布尺寸应用 ----
        def _apply_canvas_size():
            nonlocal current_canvas_w, current_canvas_h, scale, scale_x, scale_y, disp_w, disp_h, rect_id, text_id, bg_img_id, bg_loading_id
            try:
                new_w = int(canvas_w_var.get())
                new_h = int(canvas_h_var.get())
                if new_w <= 0 or new_h <= 0:
                    raise ValueError
                current_canvas_w, current_canvas_h = new_w, new_h
                _nfw, _nfh = _sar_stretch(current_canvas_w, current_canvas_h)
                scale = min(max_display_w / _nfw, max_display_h / _nfh)
                if not allow_upscale:
                    scale = min(scale, 1.0)
                disp_w = int(_nfw * scale)
                disp_h = int(_nfh * scale)
                scale_x = disp_w / current_canvas_w
                scale_y = disp_h / current_canvas_h
                # 两栏布局：宽=画布宽+右栏宽，高=画布高（下限 720、钳屏幕）
                _nw_w = min(disp_w + 2 * PAD + RIGHT_PANEL_WIDTH + 40,
                            int(win.winfo_screenwidth() * 0.95))
                _nw_h = min(max(disp_h + 2 * PAD + 24, 720),
                            int(win.winfo_screenheight() * 0.94))
                win.geometry(f"{_nw_w}x{_nw_h}")
                canvas.config(width=disp_w + 2 * PAD, height=disp_h + 2 * PAD)
                canvas.delete("all")
                bg_img_id = None
                bg_loading_id = None
                _invoke_bg_draw()
                _draw_pad_black()
                _draw_bg_frame()  # 画布尺寸变化后按新 scale 重新取帧
                clamp_rect()
                if rect_id:
                    canvas.delete(rect_id)
                    canvas.delete(text_id)
                rect_id, text_id = create_rect()
                _draw_ghost()
                _schedule_content_render()
                update_coord_display()
                # 2026-10-16：与 end_draw 同款补齐 —— 改画布尺寸会经 clamp_rect() 改几何，
                # 几何→四格的回填唯一收口是 update_rect_position()，本函数同样不走它，
                # 故这里也显式刷一次（否则画布改小、矩形被钳后四格仍是旧值）。
                _sync_coord_box()
                status_var.set(_('画布已调整为 {0}x{1}').format(current_canvas_w, current_canvas_h))
                win.update_idletasks()
                # 重新居中窗口
                x = self.root.winfo_x() + (self.root.winfo_width() - win.winfo_width()) // 2
                y = self.root.winfo_y() + (self.root.winfo_height() - win.winfo_height()) // 2
                win.geometry(f"+{x}+{y}")
            except:
                messagebox.showerror(_("错误"), _("画布尺寸无效"))
    
        # ---- 矩形「真实帧 / 虚拟框」切换（2026-10-05 用户拍板交互）----
        # 交互约定：
        #   · 蓝色幽灵框（另一端参考）  → **恒为虚拟框**（保持原样，便于对比另一端位置）
        #   · 红色活动框 **静止**        → 仅描边（fill=""）⇒ 框内直接透出背景真实帧
        #   · 红色活动框 **拖动中**      → 变回红色虚拟框（淡填充）⇒ 拖的时候一眼看清框在哪，
        #                                 不被画面细节干扰；松手立刻恢复真实帧
        def _set_content_visible(vis):
            """合成图（= 背景 + 内容帧那一整帧）的显隐。

            ⚠️ 2026-10-05 用户实测提出：拖动时只把描边换成虚拟框还不够 —— 那一整帧合成图
            仍然压在画面上（截图里就是「红色叠加到了这一帧上」）。拖动时要的是**干净的
            背景 + 红框**，所以这里把合成图整个隐藏，松手再由重渲染恢复。
            """
            if content_img_id is None:
                return
            with suppress(Exception):
                canvas.itemconfig(content_img_id, state=("normal" if vis else "hidden"))

        def _set_rect_live(is_live):
            """True=静止→透明（露出真实帧）；False=拖动中→红色虚拟框（淡填充）+隐藏内容帧。

            ⚠️ 2026-10-05 混合渲染：角度≈0 时内容帧是「独立轻量个体」（box 尺寸不透明小图），
            拖动期间保持可见并实时 coords 跟随（零 ffmpeg），不再整帧隐藏；此时矩形只保留描边、
            不铺红色淡填充，避免遮住内容。只有角度≠0（旋转有透明角需 ffmpeg 真合成）才在拖动中
            整帧隐藏、回到红色虚拟框。
            """
            if not rect_id or draw_diagonal or not _real_frame[0]:
                return      # 斜纹模式（旧行为）不参与：它本来就是虚拟框
                                                    # 2026-10-05：全局开关关闭=虚拟框模式，同理不参与
            try:
                if is_live:
                    canvas.itemconfig(rect_id, fill="", stipple="")
                else:
                    # 2026-10-11：绿幕开启时角≈0 走合成路径（整张画布大图）⇒ 归类为「非轻量」，
                    #   拖动中回红色虚拟框（与角度≠0 一致），避免把整张大图按 box 挪位。
                    if content_alpha and abs(current_angle) < 0.5 and not _content_chroma_f:
                        # 角度≈0：内容帧随 box 实时跟随，矩形只保留描边、不铺红填充遮内容
                        canvas.itemconfig(rect_id, fill="", stipple="")
                    else:
                        canvas.itemconfig(rect_id, fill=rect_color, stipple="gray25")
            except Exception:
                pass
            if content_alpha:
                if abs(current_angle) < 0.5 and not _content_chroma_f:
                    # 角度≈0（轻量路径 · box 小图）：拖动中保持可见并跟随；松手(render)时坐标已由
                    #   update_rect_position 同步。（绿幕开启时角≈0 走合成路径 · 整张大图 ⇒ 不在此列）
                    if not is_live and content_img_id is not None:
                        with suppress(Exception):
                            canvas.coords(content_img_id, *to_canvas(current_x, current_y))
                    # 可见性不变（始终显示内容帧）
                elif not is_live:
                    # 角度≠0 或 绿幕开启（整张画布合成图）：拖动中隐藏合成图（回红色虚拟框），
                    #   松手由 _do_render_content 重渲染产出正确位置的图。
                    _set_content_visible(False)
                # 角度≠0 松手(is_live=True)：**故意不**把旧图重新显示出来——
                #   旧图是拖动前按旧位置/旧角度渲染的，一显示就会「在原始位置闪一下」
                #   （用户实测：拖动后真实帧先闪旧位置再跳新位置，非常难看）。
                #   这里保持隐藏，由随后的 _do_render_content 重渲染**直接产出新位置**的图，
                #   旧图被 delete、新图 create ⇒ 视觉上「隐藏原画面 → 直接在新位置出现」。
                #   若几何恰好没变，_do_render_content 的快捷路径会 itemconfig(state="normal") 恢复显示。

        # ---- 矩形拖拽事件 ----
        def start_move(event):
            nonlocal drag_start_x, drag_start_y, drag_mouse_start, dragging
            if draw_mode_active:
                return
            canvas.focus_set()
            cx, cy = event.x, event.y
            bbox = canvas.bbox(rect_id)
            if bbox and bbox[0] <= cx <= bbox[2] and bbox[1] <= cy <= bbox[3]:
                drag_start_x = current_x
                drag_start_y = current_y
                drag_mouse_start = (cx, cy)
                dragging = True
                _set_rect_live(False)      # 拖动中 → 红色虚拟框（便于找位置）
                status_var.set(_("拖拽移动矩形"))
    
        def on_move(event):
            nonlocal current_x, current_y, dragging
            if not dragging or draw_mode_active:
                return
            dx_pixel = event.x - drag_mouse_start[0]
            dy_pixel = event.y - drag_mouse_start[1]
            dx = dx_pixel / scale_x
            dy = dy_pixel / scale_y
            new_x = int(drag_start_x + dx)
            new_y = int(drag_start_y + dy)
            if new_x != current_x or new_y != current_y:
                current_x, current_y = new_x, new_y
                clamp_rect()   # 应用边界约束（根据 allow_negative_offset 和 min_visible_pixels）
                update_rect_position()
    
        def stop_move(event):
            nonlocal dragging
            dragging = False
            _set_rect_live(True)           # 松手 → 恢复透明，露出该位置的真实帧
            # 2026-10-05：合成图 =「背景帧 + 内容帧」整帧，位置一变整张图就变；拖动期间图
            # 是隐藏的，这里才重合成一次让它重新出现（约 200ms，松手才付一次，可接受）。
            _schedule_content_render()
            status_var.set(_("拖拽完成，可调整或应用"))
            # 2026-09-03：松手即把当前坐标回写（列表轨迹等需要实时反映到列表，
            # 不必等点「应用」按钮）。on_drag_commit 由调用方按需传入（如航点 apply_xy）。
            _fire_drag_commit()

        # ---- 旋转手柄（rotation_enabled 时启用）：拖动时绕中心算角度 ----
        def start_rotate(event):
            nonlocal rotating, rot_mouse_start, rot_start_angle
            if draw_mode_active or not rotation_enabled:
                return
            canvas.focus_set()
            rot_mouse_start = (event.x, event.y)
            rot_start_angle = current_angle
            rotating = True
            _set_rect_live(False)      # 旋转中同样切回虚拟框（角度一直在变，看真实帧没意义）
            status_var.set(_("拖拽旋转手柄调整角度（可负角）"))

        def on_rotate(event):
            nonlocal current_angle, rotating
            if not rotating or draw_mode_active:
                return
            import math as _m
            mcx, mcy = geom_center()
            mcx, mcy = to_canvas(mcx, mcy)
            a0 = _m.atan2(rot_mouse_start[1] - mcy, rot_mouse_start[0] - mcx)
            a1 = _m.atan2(event.y - mcy, event.x - mcx)
            delta = (a1 - a0) * 180.0 / _m.pi
            # 归一化到 [-180, 180]，与数值框范围一致
            new_angle = (rot_start_angle + delta + 180.0) % 360.0 - 180.0
            current_angle = round(new_angle, 1)
            update_rect_position()
            status_var.set(_('旋转角度: {0}°（可负角）').format(current_angle))

        def stop_rotate(event):
            nonlocal rotating
            rotating = False
            _set_rect_live(True)       # 松手 → 恢复透明，露出该角度下的真实帧
            _schedule_content_render()  # 角度变了 → 重合成（拖动期间图是隐藏的）
            status_var.set(_('旋转完成，当前角度 {0}°，点「应用」写回角度框').format(current_angle))
            # 2026-09-03：松手即回写角度（angle_cb）+ 坐标（on_drag_commit），
            # 使航点列表的「起始角度/结尾角度」「起始坐标/结尾坐标」实时刷新。
            if angle_cb is not None:
                with suppress(Exception):
                    angle_cb(current_angle)
            _fire_drag_commit()

        # ---- 绘制新矩形（仅当 allow_resize=True 时可用） ----
        def start_draw(event):
            nonlocal draw_start, draw_rect_temp, draw_mode_active
            if not draw_mode_active:
                return
            if draw_rect_temp:
                canvas.delete(draw_rect_temp)
                draw_rect_temp = None
            draw_start = to_real(event.x, event.y)
    
        def on_draw_move(event):
            nonlocal draw_rect_temp, draw_start, draw_mode_active
            if not draw_mode_active or draw_start is None:
                return
            cur = to_real(event.x, event.y)
            x1 = min(draw_start[0], cur[0])
            y1 = min(draw_start[1], cur[1])
            x2 = max(draw_start[0], cur[0])
            y2 = max(draw_start[1], cur[1])
            w = x2 - x1
            h = y2 - y1
            if w == 0 or h == 0:
                return
            if aspect_ratio is not None:
                # 等比修正收编 _rect_kit.rk_fit_aspect（超宽压 w、超高压 h；
                # x1/y1 锚定 → 与原「超宽只改 x2 / 超高只改 y2」逐字等价）
                _aw, _ah = rk_fit_aspect(x2 - x1, y2 - y1, aspect_ratio)
                x2 = x1 + _aw
                y2 = y1 + _ah
            draw_x = x1
            draw_y = y1
            draw_w = x2 - x1
            draw_h = y2 - y1
            # 边界裁剪（保持矩形在画布内，不超出）
            if draw_x < 0:
                draw_w += draw_x
                draw_x = 0
            if draw_y < 0:
                draw_h += draw_y
                draw_y = 0
            if draw_x + draw_w > current_canvas_w:
                draw_w = current_canvas_w - draw_x
                if aspect_ratio is not None:
                    draw_h = draw_w / aspect_ratio
            if draw_y + draw_h > current_canvas_h:
                draw_h = current_canvas_h - draw_y
                if aspect_ratio is not None:
                    draw_w = draw_h * aspect_ratio
            if draw_w <= 0 or draw_h <= 0:
                return
            cx1, cy1 = to_canvas(draw_x, draw_y)
            cx2, cy2 = to_canvas(draw_x + draw_w, draw_y + draw_h)
            if draw_rect_temp:
                canvas.coords(draw_rect_temp, cx1, cy1, cx2, cy2)
            else:
                draw_rect_temp = canvas.create_rectangle(cx1, cy1, cx2, cy2,
                                                         outline="yellow", width=2, dash=(2, 2))
    
        def end_draw(event):
            nonlocal draw_mode_active, draw_start, draw_rect_temp, current_x, current_y, current_w, current_h, rect_id, text_id
            if not draw_mode_active or draw_start is None:
                return
            if draw_rect_temp:
                coords = canvas.coords(draw_rect_temp)
                if len(coords) == 4:
                    cx1, cy1, cx2, cy2 = coords
                    x1, y1 = to_real(cx1, cy1)
                    x2, y2 = to_real(cx2, cy2)
                    new_w = x2 - x1
                    new_h = y2 - y1
                    if new_w > 0 and new_h > 0:
                        current_x, current_y = x1, y1
                        current_w, current_h = new_w, new_h
                        clamp_rect()  # 应用边界限制（根据 allow_negative_offset 和 min_visible_pixels）
                        canvas.delete(rect_id)
                        canvas.delete(text_id)
                        canvas.delete(coord_disp_id)
                        if rotate_handle_id:
                            canvas.delete(rotate_handle_id)
                        rect_id, text_id = create_rect()  # 新矩形沿用当前旋转角度（钳制新角度）
                        _schedule_content_render()
                        update_coord_display()
                        _sync_scale_display()  # 重绘新矩形=改尺寸→把倍率同步回滑块/数字框
                        status_var.set(_("新矩形已创建，可拖拽移动或应用"))
                if draw_rect_temp:
                    canvas.delete(draw_rect_temp)
                    draw_rect_temp = None
            draw_mode_active = False
            # 2026-10-16（用户第 3 条）：**重新画矩形**这条路径右上「宽/高/左/上」四格没刷新。
            #   病根有两层：
            #     ① `_coord_get_rect()` 在 `draw_mode_active=True` 时返回 None（画框期间框还不存在，
            #        「没有框 → 清空四格」是它设计的语义）⇒ 若在清除标志**之前**调 `_sync_coord_box()`，
            #        拿到的是 None → 四格被**清成空**（用户实测「右上有一个填充动作, 但是把所有的
            #        原始数值全变成了空的」）。
            #     ② 画新矩形走的是本函数自己的 create_rect 重建流程，**不经过** `update_rect_position()`
            #        （那才是几何变化的统一收口、内部调 `_sync_coord_box()`）⇒ 不清标志就永远拿不到
            #        新几何，直到下一次拖拽才被刷出来（「拖动一下才更新」）。
            #   ⇒ 必须在 `draw_mode_active=False` **之后**再同步：此时 `_coord_get_rect()` 返回
            #     刚建好的新矩形几何，四格一次性填成新值（不是先清空再等拖拽）。
            _sync_coord_box()
            if allow_resize:
                draw_btn.config(state="normal")
                draw_abort_btn.config(state="disabled")
            draw_start = None
    
        def abort_draw():
            nonlocal draw_mode_active, draw_rect_temp, draw_start
            draw_mode_active = False
            if allow_resize:
                draw_btn.config(state="normal")
                draw_abort_btn.config(state="disabled")
            if draw_rect_temp:
                canvas.delete(draw_rect_temp)
                draw_rect_temp = None
            draw_start = None
            status_var.set(_("已取消绘制"))
    
        def enter_draw_mode():
            nonlocal draw_mode_active
            if draw_mode_active:
                return
            draw_mode_active = True
            draw_btn.config(state="disabled")
            draw_abort_btn.config(state="normal")
            status_var.set(_("绘制模式：按住左键拖拽绘制新矩形（保持宽高比）；也可按住 Alt + 左键直接重选范围（免点按钮）。松开后自动替换"))
    
        # ---- 重置位置 ----
        def reset_position():
            nonlocal current_x, current_y, current_angle
            # 「重置位置」两种语义（2026-09-12 定稿）：
            #   ① 归位 (0,0)：
            #      · 主视频/画布偏移模式（allow_negative_offset 且 rect_color=deepskyblue）→ 偏移归零；
            #      · reset_origin=True（画布编辑器：矩形=片段内容盒）→ 内容盒贴图像区左上角。
            #   ② 右下角默认摆放：水印/画中画/挡板等子元素 → 距图像区右下角内缩 RK_PLACE_INSET。
            # ⚠️ 内缩量是【内容像素】（与 current_canvas_w/h 同域），必须用 RK_PLACE_INSET，
            #    不能引用 PAD：PAD 是【显示层像素】且随「窗口是否带起始/结尾」在 10/20 浮动，
            #    绑上去会让重置位置莫名其妙地跟着窗口类型变（2026-09-12 遮罩重置跑到 (-20,-20)）。
            # ⚠️ 且必须 max(0,...) 钳到图像区左上角：矩形尺寸 ≥ 画布时（满屏挡板/内容盒），
            #    canvas - w - inset 恒为负；画布编辑器/遮罩窗口 allow_negative_offset=True，
            #    clamp_rect 走「完全放开」分支不会钳回 → 直接落负值就跑到图像区外（看着错位）。
            if (_allow_neg[0] and rect_color == 'deepskyblue') or reset_origin:
                current_x = 0
                current_y = 0
            else:
                current_x = max(0, current_canvas_w - current_w - RK_PLACE_INSET)
                current_y = max(0, current_canvas_h - current_h - RK_PLACE_INSET)
            if angle_editable:
                current_angle = 0.0  # 重置位置的同时把旋转角度归零
            clamp_rect()
            update_rect_position()
            # 角度归零也要落盘（否则调用方仍留着旧角度，画布编辑器的 captured 缓冲更会不同步）
            _sync_angle_cb()
            status_var.set(_("已重置位置") + (_("，角度已归零") if angle_editable else ""))
    
        # ---- 应用与取消（2026-09-12 修复：关闭即提交当前活动端，杜绝「结束没记住」）----
        # 本编辑器是「实时编辑单点几何」模型：切换端时已自动保存另一端（见 _switch_end），
        # 但当前活动端的改动只在拖拽松手(on_drag_commit) / 尺寸刷新(on_apply) / 旋转(angle_cb)
        # 触发时落盘；若直接点「取消」或点窗口×关闭，当前端改动会丢失。
        # 为避免「起始记住了 结束没记住」，统一在关闭（应用 / 取消 / 点×）时提交当前端。
        def _commit_current():
            """把当前活动端（旋转 angle_cb + 坐标 on_drag_commit + 尺寸/刷新 on_apply）写回。"""
            clamp_rect()
            # ⚠️ 顺序铁律：angle_cb 必须早于 on_apply。画布编辑器的 on_apply 是
            # `_set_kf(..., captured[0])`，读的是 angle_cb 写入的缓冲；反过来则永远慢一拍，
            # 关闭时提交的角度是「上一次」的（2026-09-12 「结尾角度没保存」根因之一）。
            _sync_angle_cb()
            _fire_drag_commit()
            if on_apply is not None:
                with suppress(Exception):
                    on_apply(current_x, current_y, current_w, current_h,
                             current_canvas_w, current_canvas_h)

        def apply():
            _commit_current()
            win.destroy()

        def cancel():
            # ⚠️ 与「应用」同口径提交：切换端已保存另一端，关闭时再保存当前端，
            # 避免「结束没记住」。若确需彻底放弃改动，应另行提供「重置」语义，此处保持提交。
            _commit_current()
            win.destroy()
    
