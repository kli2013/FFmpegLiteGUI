            wraplength=420)

        # ---- 动态轨迹（与图片/视频水印同套逻辑；文字尺寸用 tw/th，主画布用 main_w/main_h）----
        _tw_vf = ""
        _tw_ffm = _tw_fprobe = None
        if getattr(self, "app", None) is not None:
