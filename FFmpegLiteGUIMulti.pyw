def _crop_box_to_helper_rect(crop_enabled, crop_left, crop_top, crop_width, crop_height,
                             file_path=None, app=None):
    """把裁剪框四值转蓝色辅助框 tuple（供 RegionVisualEditor.helper_rect）。

    支持 iw / ih / w / h 公式（如 iw/2、ih-100）：
    - 纯数字直接 int；
    - 公式用视频实际尺寸经 safe_eval_expr 求值（与 ffmpeg crop 的 iw/ih 语义一致：
      iw/ih = 输入帧宽高 = 可视化选区显示的完整原帧尺寸）；
    - 视频尺寸未知时公式退化回 None（与旧行为一致：无蓝色框），纯数字仍可用。

    2026-09-02 修复：旧实现直接 int(字段)，一旦裁剪框填公式（iw 等）就抛异常 →
    helper=None → delogo / 局部模糊 / 遮罩的可视化选区永远不显示蓝色裁剪辅助框。
    """
    if not crop_enabled or not crop_enabled.get():
        return None
    _wd = _hd = None
    if app is not None and file_path:
        try:
            _wd, _hd = app._get_video_dimensions_cached(file_path)
        except Exception:
            _wd = _hd = None
    if not (_wd and _hd):
        try:
            _p = getattr(app, "ffprobe_cmd", None) if app else None
            _wd2, _hd2 = get_video_dimensions(_p, file_path)
            _wd, _hd = _wd2, _hd2
        except Exception:
            pass
    _ctx = {"iw": int(_wd or 0), "ih": int(_hd or 0),
            "w": int(_wd or 0), "h": int(_hd or 0)}

    def _cv(v):
        try:
            return int(v)
        except (ValueError, TypeError):
            if _wd and _hd:
                try:
                    return safe_eval_expr(str(v), _ctx)
                except Exception:
                    return None
            return None

    try:
        _cl = _cv(crop_left.get())
        _ct = _cv(crop_top.get())
        _cw = _cv(crop_width.get())
        _ch = _cv(crop_height.get())
        if None not in (_cl, _ct, _cw, _ch):
            return (_cl, _ct, _cw, _ch)
    except Exception:
        pass
    return None


def fix_bitrate_value(bitrate_str: str) -> str:
    """将纯数字比特率转换为数字+k 格式"""
    val = bitrate_str.strip()
    if not val:
        return "1000k"
    if re.match(r'^\d+$', val):
        return val + "k"
    return val

def is_valid_timestamp(ts: str) -> bool:
    """验证时间戳格式 (HH:MM:SS[.mmm] 或 数字)"""
    if not ts:
        return True
    # 小数位放宽到 9 位：界面已按 6 位显示/回存，3 位上限会把用户粘回来的
    # “00:00:10.133333” 判为非法。
    pattern = r'^(\d{1,2}:)?\d{1,2}:\d{1,2}(\.\d{1,9})?$'
    if re.match(pattern, ts):
        return True
    if ts.replace('.', '', 1).isdigit():
        return False
    return False


def _ffsec(sec):
    """秒 → 命令层 / 回存层用的字符串：9 位小数（去掉尾随零）。

    ⚠️ 凡是「切点 / 区间阈值 / 存回项目」都走这里，不要再写 .3f。
    毫秒级四舍五入会偷偷把切点挪到相邻的一张（实测 tb=1/15360 下
    10.1333 正确、10.1334 就漏帧），而容忍额度随素材 timebase 变化，
    同一个数换个素材就翻脸，用户无法预判 —— 唯一解是「准」。

    为什么取 9 位、不写满全精度：真值常是无限循环（304/30 = 10.1333…），
    全量写出来既无意义也难读。9 位（纳秒）的舍入误差 ≤ 5e-10 秒，
    比最严 timebase（1/90000）的半格 5.5e-6 秒还小四个数量级，
    足够安全，是个相对平衡的位数。
    """
    try:
        v = float(sec)
    except (TypeError, ValueError):
        return "0"
    if v != v or v in (float("inf"), float("-inf")):  # NaN / inf
        return "0"
    if v == 0:
        return "0"
    s = "%.9f" % v
    if "." in s:
        s = s.rstrip("0").rstrip(".")
    return s or "0"


def _fmt_sec6(sec):
    """秒 → 纯显示用的 6 位小数字符串（例：10.133333）。

    只给「看」的场合用（时间码标签、日志、剪贴板导出）；
    凡是会被读回当真值的场合一律用 _ffsec（9 位），不要用这个。
    6 位舍入误差 ≤ 5e-7 秒，也远小于最严 timebase 半格 5.5e-6 秒，
    单纯显示是安全的。
    """
    try:
        v = float(sec)
    except (TypeError, ValueError):
        return "0.000000"
    if v != v or v in (float("inf"), float("-inf")):
        return "0.000000"
    return "%.6f" % v


def _hms_split(sec):
    """秒 → (时, 分, 秒浮点)；非法/负值一律钳为 0（各时间显示函数共用的分解步）。

    只服务「看」的格式化；要写回/进命令的真值请直接用 float/_ffsec，不要经这里。
    """
    s = _opt_float(sec, 0.0)
    s = max(0.0, s)
    return int(s // 3600), int((s % 3600) // 60), s % 60


def seconds_to_time(sec, short=True):
    """
    秒数转时间字符串。
    short=True 时：<1小时 → MM:SS.ms，>=1小时 → H:MM:SS.ms
    short=False 时：始终 HH:MM:SS.ms
    """
    if sec is None:
        return ""
    h, m, s = _hms_split(sec)
    if short:
        if h > 0:
            return f"{h:01d}:{m:02d}:{s:09.6f}"
        else:
            return f"{m:02d}:{s:09.6f}"
    else:
        return f"{h:02d}:{m:02d}:{s:09.6f}"




def _fmt_window_time(sec):
    """把秒数格式化为紧凑「分:秒.百分秒」，用于合并页轨道「规格」列末尾追「始于」。

    返回紧凑 MM:SS.cc（≥1h 加 H:）。显示时段(show_start)以主视频时间线秒为单位，
    与子视频 enable 表达式同源。该信息仅非主视频的视频轨有意义（主视频始终铺满）。"""
    if sec is None:
        return None
    h, m, s = _hms_split(sec)
    if h > 0:
        return f"{h}:{m:02d}:{s:05.2f}"
    return f"{m:02d}:{s:05.2f}"


# 静态图片扩展名（GIF 动画除外：GIF 有多帧、可 seek，不当静态图处理）。
_STATIC_IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".bmp", ".webp")


def _is_static_image_file(path):
    """模块级：判断路径是否为静态图片（单帧、无视频时长概念）。

    与 App._is_static_image 共用同一真源：主文件为图片时，所有「抽帧」类可视化
    （裁剪框/位置/水印/文字水印 等背景帧、SimplePreviewer 实时预览）应跳过 seek、
    直接取图片本身，否则 -ss>0 抽不到帧 → 抽帧失败/可视化报错。"""
    if not path:
        return False
    return os.path.splitext(str(path))[1].lower() in _STATIC_IMAGE_EXTS


def _cmd_collect_virtual_aware_inputs(main, ins):
    """命令编辑器取帧/预览/量尺寸「可喂输入」收集：返回输入列表或 None（无可用输入）。

    虚拟源（color:/gen: 哨兵及其经 `_virtual_lavfi_spec` 展开后的 `color=c=...` 形态）、
    真实磁盘文件都算可喂、一律纳入；既非真实文件也非已知虚拟源（表达式/笔误/尚未存在）
    → 不可喂、剔除。剔除后若「非主输入」不可喂则退回「仅主输入」（保持 [0:v] pad 对齐，
    旧行为一致）；主输入本身也不可喂 → None（调用方报「找不到主输入，无法出图」）。
    """
    def _feedable(p):
        return bool(p) and (os.path.exists(p) or
                            _is_virtual_source(p) or _is_expanded_virtual_spec(p))
    _main = (main or "").strip()
    _ins = [p for p in (ins or []) if p]
    if _main and (not _ins or _ins[0] != _main):
        _ins = [_main] + _ins
    if _ins and all(_feedable(p) for p in _ins):
        return _ins
    if _main and _feedable(_main):
        return [_main]
    return None


def _cmd_editor_in_args(inputs, seek_t=0.0):
    """构造命令编辑器节点取帧 / 出图预览的 `-i` 输入参数。

    ⚠️ 2026-10-15 修「overlay 节点 0 帧出图失败」根因：静态图输入若只按普通
    `-i img.jpg` 喂进去，ffmpeg 只读 1 帧、clip 立刻 EOF ⇒ 任何 overlay/引用该
    `[k:v]` 的子图都 `Output file is empty, nothing was encoded (frame=0)`。须按
    成片口径补 `-loop 1 -framerate 30 -t N`（与用户真实命令
    `-loop 1 -framerate 30 -t 10.000 -i ...jpg` 一致）把它撑成一条可引用的视频流。

    - 虚拟/生成源（color:/gen:）：`-f lavfi -i <_virtual_lavfi_spec>`（非磁盘文件，
      原样 `-i` 会 `Protocol not found`，与 `_build_pip_snapshot_cmd` 同口径）；
      spec 解析失败才回退原样 `-i`。主输入（_i==0）仍带 `-ss` 以跳到预览时刻帧。
    - 静态图（`_is_static_image_file`）：`-loop 1 -framerate 30 -t <dur> -i`（不 -ss，
      单帧无限循环；dur 取 max(10s, seek_t+2s) 兜住长视频 seek 后子图仍要引用该图）。
    - 首个输入（主输入）为视频：`-ss <seek_t> -i`（与 preview.md 输入 seek 口径一致）。
    - 其余视频输入：普通 `-i`（从 0 起算，子输入不 -ss）。
    """
    _args = []
    _seek = float(seek_t or 0.0)
    _img_dur = "%.3f" % max(10.0, _seek + 2.0)
    for _i, _f in enumerate(inputs):
        _nf = normalize_path(_f)
        if _is_virtual_source(_nf):
            _spec = _virtual_lavfi_spec(_nf)
            if _spec:
                if _i == 0:
                    _args += ["-ss", "%.3f" % _seek, "-f", "lavfi", "-i", _spec]
                else:
                    _args += ["-f", "lavfi", "-i", _spec]
            elif _i == 0:
                _args += ["-ss", "%.3f" % _seek, "-i", _nf]
            else:
                _args += ["-i", _nf]
        elif _is_expanded_virtual_spec(_nf):
            # 命令编辑器解析出的展开式（color=c=0x... / smptebars=...）：本身已是合法
            # `-f lavfi -i` 值，直接透传，不要再用 _virtual_lavfi_spec 二次展开（会失败）。
            if _i == 0:
                _args += ["-ss", "%.3f" % _seek, "-f", "lavfi", "-i", _nf]
            else:
                _args += ["-f", "lavfi", "-i", _nf]
        elif _is_static_image_file(_nf):
            _args += ["-loop", "1", "-framerate", "30", "-t", _img_dur, "-i", _nf]
        elif _i == 0:
            _args += ["-ss", "%.3f" % _seek, "-i", _nf]
        else:
            _args += ["-i", _nf]
    return _args


# ----- 媒体类浏览窗口文件类型统一口径（2026-09-22）-----
# 媒体 = 视频 + 图片，之下细分 视频 / 图片（用户诉求：全包括的媒体下再分视频、图片，
# 选起来更快）。此前各浏览窗口各自手写，出现过两类问题：①串联「添加外部视频」只列
# 视频、图片选不到；②「替换素材」把图片塞进「视频文件」项（分类错）。
# 视频集合 = 程序实际支持的容器（与拖拽分类 video_exts 一致）；
# 图片集合 = 程序实际按图片轨处理的集合（与拖拽分类 img_exts 一致，不含 tif/tiff）。
_MEDIA_VIDEO_PATTERN = "*.mp4 *.mkv *.avi *.mov *.flv *.webm *.ts"
# 「素材分类用」图片集合：添加轨道 / 浏览窗口 filter 的判定，含 gif。
# ⚠️ 与上面的 _STATIC_IMAGE_EXTS 不是一回事，两者不能混用：
#   _STATIC_IMAGE_EXTS = 可视化抽帧判定（刻意排除动画 gif：gif 多帧可 seek，抽帧不该跳过 seek）
#   _MEDIA_IMAGE_EXTS  = 素材归类判定（拖拽 / 添加轨道 / filetypes，"gif 是图片"符合用户直觉）
# 2026-09-22 审计：两者曾被混用 → 同一个 .gif，拖拽 / 画中画建成 image2 图片轨，
#   而用「添加外部视频(串联)」按钮选进去却建成 gif 视频轨（回执也写成"视频"）
#   → 同一文件两种添加方式的轨道标记与回执不一致。现统一走本常量。
#   ⚠️ 命令构建层（40+ 处）仍统一走 _is_static_image：gif 有自身时长、按视频处理，此处不改。
_MEDIA_IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".bmp", ".gif", ".webp")
_MEDIA_IMAGE_PATTERN = " ".join("*" + e for e in _MEDIA_IMAGE_EXTS)
_MEDIA_AUDIO_PATTERN = "*.mp3 *.aac *.m4a *.wav *.flac *.ogg *.opus *.ac3 *.dts *.mka"
_MEDIA_SUBTITLE_PATTERN = "*.srt *.ass *.ssa *.vtt *.idx *.sup"


def media_filetypes(include_audio=False, include_subtitle=False, all_files=True):
    """媒体类浏览窗口的统一 filetypes：媒体文件(全) → 视频 → 图片 [→ 音频 → 字幕] → 所有文件。

    :param include_audio:    该窗口也接受音频（替换素材 / 流提取页等）
    :param include_subtitle: 该窗口也接受字幕
    :param all_files:        末尾是否附「所有文件 *.*」（默认附，避免特殊格式被过滤挡住）
    """
    _all = _MEDIA_VIDEO_PATTERN + " " + _MEDIA_IMAGE_PATTERN
    if include_audio:
        _all += " " + _MEDIA_AUDIO_PATTERN
    if include_subtitle:
        _all += " " + _MEDIA_SUBTITLE_PATTERN
    types = [(_("媒体文件"), _all),
             (_("视频文件"), _MEDIA_VIDEO_PATTERN),
             (_("图片文件"), _MEDIA_IMAGE_PATTERN)]
    if include_audio:
        types.append((_("音频文件"), _MEDIA_AUDIO_PATTERN))
    if include_subtitle:
        types.append((_("字幕文件"), _MEDIA_SUBTITLE_PATTERN))
    if all_files:
        types.append((_("所有文件"), "*.*"))
    return types


def _blend_colors(hexes):
    """多段重叠区混色：RGB 均值（无 PIL 依赖）。返回 #rrggbb。"""
    try:
        rs = gs = bs = 0
        for hx in hexes:
            hx = hx.lstrip("#")
            rs += int(hx[0:2], 16)
            gs += int(hx[2:4], 16)
            bs += int(hx[4:6], 16)
        n = len(hexes)
        return "#%02x%02x%02x" % (rs // n, gs // n, bs // n)
    except Exception:
        return hexes[0] if hexes else "#888888"


def _make_range_sync(entry_var, target_var, fmt):
    """生成 滑块↔输入框 双向同步闭包（chroma/blend/alpha 三套共用）。

    slider_changed: 拖滑块 → 按 fmt 写回 entry；
    entry_changed: 手动输入 entry → 校验 [0,1] 写回 target_var，越界回弹到 target_var。
    """
    def slider_changed(val):
        entry_var.set(fmt.format(float(val)))
    def entry_changed(*_args):
        try:
            v = float(entry_var.get())
            if 0.0 <= v <= 1.0:
                target_var.set(v)
            else:
                raise ValueError
        except Exception:
            entry_var.set(fmt.format(target_var.get()))
    return slider_changed, entry_changed


def _make_edge_adjuster(get_points, set_points, orig_w, orig_h, redraw, grow):
    """生成裁剪边界 收缩/扩大 闭包（edge_adjust/grow_adjust 共用）。

    grow=False 收缩（边界朝内），grow=True 扩大（边界朝外）；其余逻辑同构。

    ⚠️ 2026-09-06 修复（可视化裁剪「上减/上加」两排按钮静默失效）：
    旧签名是 (points, ...)，闭包捕获的是**列表对象**。而调用方多处用
    `points = [...]` 重新绑定（on_drag_end / Alt 搬移 / clear_rect /
    auto_detect / on_extract_success / 初始加载已有裁剪），重新绑定后闭包里
    拿到的仍是初次那个空列表 → len != 2 直接 return，按钮点了没反应。
    （「上移」排是嵌套 def，读的是闭包变量而非旧对象，所以一直是好的。）
    改为 getter/setter 回调传递后，调用方怎么重绑定都能拿到当前矩形。
    """
    s = -1 if grow else 1
    def adjust(edge, delta):
        pts = get_points()
        if not pts or len(pts) != 2:
            return
        x1, y1 = pts[0]; x2, y2 = pts[1]
        l = min(x1, x2); r = max(x1, x2)
        t = min(y1, y2); b = max(y1, y2)
        if edge == 'left':   l += s * delta
        elif edge == 'right': r -= s * delta
        elif edge == 'top':    t += s * delta
        elif edge == 'bottom': b -= s * delta
        l = max(0, l); t = max(0, t)
        r = min(orig_w, r); b = min(orig_h, b)
        if r <= l or b <= t:
            return
        set_points([(l, t), (r, b)])
        redraw()
    return adjust


def _make_on_lang_select(lang_var, custom_lang_entry, common_languages):
    """生成 下拉选语言→自动填自定义码 闭包（3 处语言选择对话框共用）。"""
    def on_lang_select(event):
        selected = lang_var.get()
        for display, code in common_languages:
            if display == selected:
                custom_lang_entry.delete(0, tk.END)
                custom_lang_entry.insert(0, code)
                break
    return on_lang_select


# ================== 预设管理 ==================
# 全局设置独立文件（2026-09-08）：历史上 29 个全局设置以魔法键 "player_settings"
# 与预设同层混装在 ffmpeg_presets.json 里，带来三个问题：
#   ① 预设若命名为 player_settings，会被 load_all 静默过滤（存了却看不见）；
#   ② 导出备份是整文件拷贝，会把 mpv_path / log_path / ffmpeg_dir_path 等本机绝对路径带走；
#   ③ 任一设置改动（几十个 trace_add）都会重写整个预设库，与 save_preset 形成读写竞态。
# 现拆为独立文件 app_settings.json（新版真源）。配置目录双基准定位：app_settings.json
# 与 ffmpeg_presets.json 任意一个存在即可，本地目录优先——详见 _resolve_config_dir。
# 旧键 player_settings 保留不摘，供旧版程序读取（save_preset 会把它原样带回去）。
APP_SETTINGS_FILE = "app_settings.json"
PRESETS_FILE = "ffmpeg_presets.json"

def _resolve_config_dir() -> str:
    r"""配置目录锚点（2026-09-08）。双基准：app_settings.json 与 ffmpeg_presets.json
    任意一个在某个目录存在，该目录就是配置目录——两者都认，是为了兼容旧版程序
    （旧版只认 ffmpeg_presets.json，它建起来的目录新版必须能接着用）。

    死规则一：本地目录一律优先于 %USERPROFILE%\.FFLiteGUI——先扫完本地目录的两个文件名，
    再扫用户目录（外圈目录、内圈文件名），绝不许出现「本地有 presets 却因用户目录有
    app_settings 而跑到用户目录」的撕裂。
    死规则二：目录一旦定下，presets / app_settings / quick_cmds / watermark_templates
    全部同目录。两者都不存在则取本地目录（便携模式首装）。"""
    script_dir = get_script_dir()
    user_dir = os.path.join(os.path.expanduser("~"), ".FFLiteGUI")
    for _dir in (script_dir, user_dir):
        for _name in (APP_SETTINGS_FILE, PRESETS_FILE):
            if os.path.exists(os.path.join(_dir, _name)):
                return _dir
    return script_dir


_OUTPUT_HISTORY_FILE = "output_dir_history.json"
_OUTPUT_HISTORY_MAX = 20

def _load_output_history():
    """读取输出目录历史 → {"convert": [...], "merge": [...]}；缺失/损坏回退空结构。"""
    path = os.path.join(_resolve_config_dir(), _OUTPUT_HISTORY_FILE)
    default = {"convert": [], "merge": []}
    try:
        if not os.path.exists(path):
            return default
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return default
        return {"convert": list(data.get("convert", [])),
                "merge": list(data.get("merge", []))}
    except Exception:
        return default

def _save_output_history(hist):
    """把历史写回 output_dir_history.json（与全局设置分离，单独一个文件）。"""
    try:
        path = os.path.join(_resolve_config_dir(), _OUTPUT_HISTORY_FILE)
        d = os.path.dirname(path)
        if d and not os.path.exists(d):
            os.makedirs(d, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(hist, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


