# ----- 下拉框「无 / None」哨兵：显示文本经 _() 翻译，命令值恒为 "none" -----
def _disp_to_cmd(v):
    """下拉显示值 -> FFmpeg 命令值。仅哨兵「无 / None」需映射，其余（已是命令 token）原样返回。"""
    if v is None:
        return "none"
    if v in ("无", "None"):
        return "none"
    return v

def _cmd_to_disp(v):
    """FFmpeg 命令值 -> 当前语言显示。none / 无 / 空串 -> 无 / None，其余原样返回。"""
    if v is None or v == "" or v in ("none", "无"):
        return _("无")
    return v

# 硬件解码下拉：显示文本（哨兵与描述均经 _() 翻译）与命令值一一对应
# ⚠️ 本组是 multi 专有 i18n 适配：base 侧用 HARDWARE_DECODER_OPTIONS + DECODER_MAP（键为中文显示值），
#    此处改为「命令值列表 + 显示值列表」双表 + 索引互转函数，保证存盘恒为 cuda/qsv/... 英文 token。
#    port / 审计 diff 出现这块差异属预期，勿当「历史遗留」合并或删改。
HW_DECODER_CMD = ["none", "cuda", "qsv", "vaapi", "amf", "videotoolbox"]


def hw_decoder_display():
    """内部 token（英文，稳定）→ 当前语言显示名。

    ⚠️ 必须是函数（multi 的 _() 依赖启动后装载的 TRANS）：模块级列表 HW_DECODER_DISPLAY 会把
    显示名冻在导入时中文上 ⇒ 英文界面下 .index(译文) 恒 ValueError ⇒ 解码器选择静默失效。
    """
    return {"none": _("无"), "cuda": _("cuda (NVIDIA通用)"), "qsv": _("qsv (Intel通用)"),
            "vaapi": _("vaapi (Linux VAAPI)"), "amf": _("amf (AMD通用)"),
            "videotoolbox": _("videotoolbox (macOS)")}


def _hwaccel_disp_to_cmd(disp):
    """硬件解码显示值 -> 命令 token（**幂等**：已经是命令 token 时原样返回）。

    ⚠️ 幂等不是锦上添花：命令构建侧拿到的 settings 里存的就是命令 token，若这里只认
    显示名 -> index() 抛 ValueError -> 兜底成 "none" -> 用户勾了「启用硬件解码」但命令里
    一个 -hwaccel 都不出现（2026-10-02 回归，勿删这个直通分支）。
    旧预设的「cuda (NVIDIA通用)」等中文显示值仍走 DECODER_MAP 兜底。
    """
    if disp in HW_DECODER_CMD:
        return disp
    try:
        return HW_DECODER_CMD[list(hw_decoder_display().values()).index(disp)]
    except ValueError:
        return DECODER_MAP.get(disp, _disp_to_cmd(disp))


def _hwaccel_cmd_to_disp(cmd):
    """硬件解码命令 token -> 当前语言显示（精确匹配下拉项）。"""
    try:
        return hw_decoder_display()[cmd]
    except KeyError:
        return _cmd_to_disp(cmd)

