        tip = ttk.Label(
            frm,
            text=_("倒计时以「时长」为零点，正计时从 0 起；\n"
                 "生成源无音频，导出容器 / 编码器口径与颜色源一致。\n"
                 "⚠️ 转盘背景在高分辨率（如 1080p）预览时会周期性卡顿：\n"
                 "逐像素生成赶不上墙钟，属正常；导出文件不受影响。"),
            wraplength=380, justify=tk.LEFT)
        tip.pack(fill=tk.X, pady=6)

        def _on_ok():
            try:
