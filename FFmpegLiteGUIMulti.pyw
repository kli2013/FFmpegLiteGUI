        # （见 LiveFramePreview 注释：否则换图会把框撑大）。
        self.preview = LiveFramePreview(
            paned, getattr(self.filter_frame, "app", None),
            get_src=self._resolve_source,
            build_cmd=self._preview_build_cmd,
            status_extra=self._preview_status_extra,
            precheck=self._preview_precheck,
            time_value="3", title=_("实时预览（内存中）"),
            hint=None,
            tip=_("右侧显示的是**当前列表选中项**的效果（delogo / 局部模糊 / 区域效果）。\n"
                "坐标以原始画面为准 —— 与正式导出同源同坐标。\n"
                "改类型 / 坐标 / 强度 / 勾「局部滤镜」都会实时刷新。\n"
                "（左右分隔条可拖，拉宽后画面更清楚。）"),
            box_w=320, box_h=250)
        paned.add(self.preview, weight=2)
        # 窗宽 780：左表单约 420 + 右预览 342 + sash。weight 3:2 让默认分配落在右侧框附近，
        # 且用户拖宽任一侧都不再引起另一侧震荡（paned 语义）。
        self._paned = paned

        def _preview_kick(*_a):
            """任何表单变化都重渲右侧预览（组件内部 150ms 防抖合并）。"""
            pv = getattr(self, "preview", None)
            if pv is not None:
                pv.schedule()

        for _v in (self.x_var, self.y_var, self.w_var, self.h_var,
                   self.strength_var, self.region_var, self.enabled_var,
                   self.enable_start_var, self.enable_end_var,
                   self.enable_cycle_var, self.enable_show_var, self.type_var):
            with suppress(Exception):
                _v.trace_add("write", _preview_kick)

        # ⚠️ 这里也要首渲一次（2026-10-04 用户报「开窗没有帧 / 点默认那条 delogo 也没帧」）：
        # 组件自身只在 schedule()/reload() 时才跑 ffmpeg，而开窗这条路上 trace 一个都不会响
        # ——load_settings 用 _tk_setv 回填表单（值与初值相同则**根本不写**），点列表已有项
        # 又被 `_on_tree_select` 的「刷新回声」守卫提前 return（表单本就是这行的数据）。
        # 两路都不产生变量变化 ⇒ 永不 schedule ⇒ 右侧一直空白。只有「新建」会改值才有帧。
        # 本句覆盖「列表为空」那条路径（此时 load_settings 不走 _load_item_to_form）；
        # 有列表项时由 _load_item_to_form 收口处的 schedule 负责（组件内部 150ms 防抖会合并）。
        with suppress(Exception):
            self.preview.schedule()

        # 2026-08-26 修复：表单值实时同步到列表摘要。原来坐标/类型/强度只在
        # 切换选中项或点「应用」时才写回，新加 delogo 填完坐标列表数值不变，
        # 要保存重开才看得到。给各表单变量挂 trace，任一变化即时刷新当前项列表行。
        self._loading_form = False
        for _v in (self.x_var, self.y_var, self.w_var, self.h_var,
                   self.type_var, self.strength_var, self.enabled_var, self.region_var,
                   self.enable_start_var, self.enable_end_var,
                   self.enable_cycle_var, self.enable_show_var):
            with suppress(Exception):
                _v.trace_add("write", self._sync_current_to_tree)

        self.update_coord_state()
    
    # 区域效果类型（2026-09-07）：走统一的「仅应用到选定区域」开关——
    # 勾=恒局部（旧行为，坐标解锁）；不勾=全帧时间段效果（坐标禁用）。
    # 与生成端 _REGION_EFFECT_FILTERS 一一对应，加类型时两边一起改。
    _REGION_EFFECTS = ("negate", "hflip", "vflip", "swapuv", "desat", "eq_bright",
                       "unsharp", "avgblur", "median", "black", "white")

    # 有强度参数的类型：type -> (强度框标签, 默认值)。不在此表里的类型强度框禁用。
    # 🔴 类体 dict 同样是 import 期求值（与「默认参数」坑一致）：写成 `_("半径:")` 会被冻成
    #    中文，英文界面里局部模糊的强度标签不翻译。改为静态方法，每次调用现查 TRANS
    #    （4 个调用点全在运行时）。键与默认值不变，只是求值时机挪后。
    @staticmethod
    def _strength_spec():
        return {
            "boxblur": (_("半径:"), "5"),
            "gblur": ("sigma:", "2.0"),
            "unsharp": (_("强度:"), "1.5"),
            "avgblur": (_("半径:"), "5"),
            "median": (_("半径:"), "3"),
            "eq_bright": (_("亮度:"), "-0.3"),
        }

    def _is_region_blur(self) -> bool:
        """当前是否处于「局部模糊」状态（仅 boxblur/gblur 有意义）"""
        return bool(self.region_var.get()) and self.type_var.get() in ("boxblur", "gblur")

    def update_strength_state(self):
        """仅更新标签文字与可编辑状态，不改动用户已填的数值。"""
        ftype = self.type_var.get()
        _spec = self._strength_spec().get(ftype)
        if _spec:
            self.strength_label.config(text=_spec[0])
            self.strength_entry.config(state="normal")
        else:
            # delogo 沿用「参数:」，其余无强度的区域效果统一「无:」
            self.strength_label.config(text=_("参数:") if ftype == "delogo" else _("无:"))
            self.strength_entry.config(state="disabled")
    
    def update_coord_state(self):
        ftype = self.type_var.get()
        # delogo 恒区域；区域效果勾「仅应用到选定区域」时需坐标（不勾=全帧免坐标）；
        # boxblur/gblur 仅勾局部时需坐标
        if ftype == "delogo":
            need_coord = True
        elif ftype in self._REGION_EFFECTS:
            need_coord = bool(self.region_var.get())
        else:
            need_coord = self._is_region_blur()
        state = "normal" if need_coord else "disabled"
        for entry in getattr(self, "_coord_entries", []):
            entry.config(state=state)
        # 统一开关仅 delogo 不可用（恒区域）；其余类型都用它切换 局部/全帧
        if hasattr(self, "region_chk"):
            self.region_chk.config(state="disabled" if ftype == "delogo" else "normal")
        # 轨迹控制按钮：仅 delogo 可点，其他局部滤镜灰掉（用户拍板只给 delogo 接）
        if hasattr(self, "traj_btn"):
            self.traj_btn.config(state="normal" if ftype == "delogo" else "disabled")

    def _open_delogo_trajectory(self):
        """delogo 轨迹控制弹窗：列表轨迹让去水印区域随时间平移（X/Y），宽高恒取表单。

        只消费航点、不消费预设动效/角度/缩放/透明度（show_presets=False /
        allow_angle=False / consume_alpha=False）—— delogo 只吃 x/y 表达式。
        画布 = 源原生分辨率（与 delogo 区域链恒在 crop/rotate/scale 之前一致）。
        """
        if self.type_var.get() != "delogo":
            return
        _ff = self.filter_frame
        _app = getattr(_ff, "app", None)
        _vf = self._resolve_source()
        _ffm = getattr(_app, "ffmpeg_cmd", None) if _app else None
        _fprobe = getattr(_app, "ffprobe_cmd", None) if _app else None
        _cw, _ch = (1280, 720)
        # 🔴 2026-10-16（用户第 2 条）：**节点/组语境**的 delogo 轨迹窗口画布 = 解析器给的
        #   坐标空间尺寸（组 = 包装盒；节点 = `_node_canvas_space_size` 已含 scale），
        #   不是源文件原生分辨率。
        #   病根：delogo 作用于**合成之后的整帧**（节点效果链），而这里拿源文件
        #   `_resolve_source()`（组父行 = 组内主文件）的 ffprobe 尺寸当画布 ⇒ 用户实测
        #   「轨迹控制的起始结尾坐标里拖动的是组内主视频帧和尺寸, 不是组内合成帧和尺寸」。
        #   ▸ 2026-10-16 收敛：`resolve_material_ctx` = 判据唯一出处；plain ⇒ size 空 ⇒
        #     回落源文件 ffprobe（旧行为逐字节不变）。
        _ctx = _app.resolve_material_ctx(_ff) if _app is not None else None
        _node_sz = _ctx.size if (_ctx is not None and _ctx.size[0]) else None
        if _node_sz:
            _cw, _ch = int(_node_sz[0]), int(_node_sz[1])
        elif _vf and os.path.exists(_vf):
            with suppress(Exception):
                _cw, _ch = get_video_dimensions(_fprobe, _vf)
            if not _cw or not _ch:
                _cw, _ch = (1280, 720)
        # 当前航点：优先内存态（弹窗可能多次开），否则从选中项读
        _wps = list(getattr(self, "_current_waypoints", []) or [])
        if not _wps:
            _idx = self._current_item_idx()
            if _idx is not None and 0 <= _idx < len(self.items):
                _wps = [dict(w) for w in (self.items[_idx].get("waypoints") or [])
                        if isinstance(w, dict)]
        if _app is not None and _app.root is not None:
            with suppress(Exception):
                self.grab_release()
        _trajectory_dialog(
            self,
            # ⚠️ 必须回显真实状态：`_trajectory_dialog` 的「启用列表轨迹」勾选框初值 =
            #    (initial["move_mode"] == "waypoints")。只传 move_waypoints 而不传 move_mode
            #    ⇒ 即使已有航点，重开弹窗列表也是整块置灰（用户以为数据丢了）。
            #    与遮罩 `_open_mask_traj`（L29377）同一处理。（本弹窗无预设区，故不传
            #    move_cycle/dwell/margin——show_presets=False 时它们本就不创建。）
            {"move_mode": ("waypoints" if _wps else ""), "move_waypoints": _wps},
            lambda v: self._commit_delogo_waypoints(
                v.get("move_waypoints") if isinstance(v, dict) else None),
            edit_cb=self._delogo_edit_wp_point,
            canvas_w=_cw, canvas_h=_ch,
            video_file=_vf, ffmpeg_cmd=_ffm, ffprobe_cmd=_fprobe,
            app=_app,
            show_presets=False, allow_angle=False, consume_alpha=False,
            pipe_preview_cb=None)

    def _commit_delogo_waypoints(self, wps):
        """轨迹弹窗确定 回写航点到内存态 + 选中项 + 右侧预览。"""
        _wps = [dict(w) for w in (wps or []) if isinstance(w, dict)]
        self._current_waypoints = _wps
        _idx = self._current_item_idx()
        if _idx is not None and 0 <= _idx < len(self.items):
            self.items[_idx]["waypoints"] = _wps
        with suppress(Exception):
            self.preview.schedule()

    def _delogo_edit_wp_point(self, row_idx, which, cur_x, cur_y, cur_angle,
                             apply_xy, apply_angle, t0=0.0,
                             active_flag=None, w=None):
        """轨迹列表「可视化编辑坐标」回调：在源帧上摆放该航点 X/Y（delogo 只平移）。

        框尺寸 = 表单 W/H（delogo 区域宽高，静态）；背景 = 源原生帧（与 delogo 区域链
        恒在 crop/rotate/scale 之前一致，故不套 crop/rotate 预处理）。

        ⚠️ 尾部 t0 / active_flag / w 三参必须保留：`_waypoints_panel._open_editor` 恒按
        关键字 `edit_cb(..., _t0, active_flag=_active, w=w)` 调用（与 `_mask_edit_cb` /
        `_edit_wp_point` 同签名）—— 少一个就会抛 TypeError「unexpected keyword argument」，
        整个可视化编辑器打不开。
        """
        _app = getattr(self.filter_frame, "app", None)
        if _app is None:
            if apply_xy is not None:
                apply_xy(cur_x, cur_y)
            return
        _vf = self._resolve_source()
        if not _vf or not os.path.exists(_vf):
            if apply_xy is not None:
                apply_xy(cur_x, cur_y)
            return
        # 框尺寸取表单 W/H（delogo 区域静态宽高）
        try:
            _bw = max(10.0, float(str(self.w_var.get()).strip() or 10.0))
            _bh = max(10.0, float(str(self.h_var.get()).strip() or 10.0))
        except (ValueError, TypeError):
            _bw, _bh = (10.0, 10.0)
        _cw, _ch = (1280, 720)
        # 🔴 2026-10-16（用户第 2 条）：节点/组语境 ⇒ 画布 = 解析器给的坐标空间尺寸
        #   （组 = 包装盒；节点 = `_node_canvas_space_size` 已含 scale）。
        #   ▸ 2026-10-16 收敛：改问 `resolve_material_ctx`（判据唯一出处）；
        #     plain ⇒ size=(None,None) ⇒ 回落源文件 ffprobe（旧行为逐字节不变）。
        _ctx = _app.resolve_material_ctx(self.filter_frame)
        _node_sz = _ctx.size if (_ctx is not None and _ctx.size[0]) else None
        # 组语境画面帧 = 合成帧（组内合成画面），组内主文件那一帧不再正确
        _ctx_png = _ctx.frame_png if _ctx is not None else None
        # 🔴 2026-10-17（用户：「除了文字水印真实帧，其它一律不落盘」）：优先拿**内存字节**
        _ctx_ppm = getattr(_ctx, "frame_ppm", None) if _ctx is not None else None
        _ctx_extract = _ctx.frame_extract if _ctx is not None else None
        if _node_sz:
            _cw, _ch = int(_node_sz[0]), int(_node_sz[1])
        else:
            with suppress(Exception):
                _cw, _ch = get_video_dimensions(getattr(_app, "ffprobe_cmd", None), _vf)
            if not _cw or not _ch:
                _cw, _ch = (1280, 720)
        _bw = max(10.0, min(float(_cw), _bw))
        _bh = max(10.0, min(float(_ch), _bh))
        vx = tk.StringVar(value=f"{int(round(cur_x or 0)):d}")
        vy = tk.StringVar(value=f"{int(round(cur_y or 0)):d}")

        def _on_apply(nx, ny, nw, nh, ncw, nch):
            vx.set(str(int(round(nx))))
            vy.set(str(int(round(ny))))
            # W/H 也写回表单（delogo 区域只有一份静态宽高，无逐航点动画）；
            # 轨迹本身只消费 x/y ⇒ 与「只做平移 x/y」不冲突。
            with suppress(Exception):
                if nw and nh:
                    self.w_var.set(str(int(round(float(nw)))))
                    self.h_var.set(str(int(round(float(nh)))))

        # 起始/结尾双端（与遮罩 `_mask_edit_cb` 同款，条件调用）：
        # 仅当调用方传入 w + active_flag 时启用；active_flag 由 `_waypoints_panel._open_editor`
        # 的可变列表提供，编辑器内翻转「起始/结尾」即切写回目标端（x 起点↔终点）。
        start_end = None
        if w is not None and active_flag is not None:
            _se_can = (w.get("mode") != "end")

            def _se_read(end):
                if end == "end":
                    return (w.get("xb", 0), w.get("yb", 0), _bw, _bh, 0)
                return (w.get("xa", 0), w.get("ya", 0), _bw, _bh, 0)

            def _se_switch(end):
                active_flag[0] = end

            def _se_time(end):
                # 两端各取各的时刻：起点端 = start，结尾端 = start+dur（背景帧随端切换）
                _st = _opt_float(w.get("start", 0.0) or 0.0, 0.0)
                if end == "end":
                    return _st + _opt_float(w.get("dur", 0.0) or 0.0, 0.0)
                return _st

            start_end = {"active": ("end" if active_flag[0] == "end" else "start"),
                         "read": _se_read, "on_switch": _se_switch,
                         "can_compare": _se_can, "time": _se_time}

        _app.open_watermark_overlay_editor(
            int(round(_cw)), int(round(_ch)), _bw, _bh, vx, vy,
            scale_enabled_var=None, scale_w_var=None, scale_h_var=None,
            watermark_dict=None, filt_frame=None, parent=self, free_layout=True,
            main_video_file=_vf,
            bg_pre_filter=None,
            on_apply=_on_apply, on_drag_commit=apply_xy,
            initial_time=t0,
            aspect_ratio=None,
            angle_editable=False,
            corner_dirs=CORNER_DIR_PRESETS,
            corner_src_w=_bw, corner_src_h=_bh,
            allow_upscale=True,
            coord_box=True,
            start_end=start_end,
            # 🔴 2026-10-16（用户第 2 条）：节点/组语境背景帧走**解析器给的画面源**
            #   （节点 = 时间轴取帧器；组 = 合成帧 PNG）而不是源文件（组父行 = 组内主文件）。
            #   ▸ `resolve_material_ctx` 是判据唯一出处；plain ⇒ 两者皆 None ⇒
            #     旧行为逐字节不变（背景 = `_vf` 源文件）。
            frame_extractor=_ctx_extract,
            # 组语境：用一次性合成帧当内容帧（透明叠在背景上），框内即组内合成画面
            # 🔴 2026-10-17：改成传**字节**（`frame_ppm`）⇒ 零磁盘（既不 seek 源文件、
            #   也不写任何临时文件）；拿不到才回落到旧的 `.frame_png` 路径。
            content_file=(_ctx_png or None),
            content_ppm=_ctx_ppm,
            content_chroma_settings=None,
            content_time=t0,
            content_alpha=bool(_ctx_png or _ctx_ppm),
            draw_diagonal=True)
        try:
            apply_xy(float(vx.get()), float(vy.get()))
        except Exception:
            pass

    def on_type_change(self, event=None):
        ftype = self.type_var.get()
        _spec = self._strength_spec().get(ftype)
        if _spec:
            # 切换类型时始终填入该类型的默认值，保证下拉选项与强度值联动
            self.strength_var.set(_spec[1])
        else:
            # delogo 与无强度的区域效果：强度清空
            self.strength_var.set("")
        # delogo 恒区域，开关关掉；其余类型保留当前 局部/全帧 选择（换类型不打断）
        if ftype == "delogo":
            self.region_var.set(False)
        self.update_strength_state()
        self.update_coord_state()

    def on_region_toggle(self):
        self.update_coord_state()

    def quick_region_blur(self):
        """一键切换到「局部应用」：启用 + 勾「仅应用到选定区域」+ 自动补坐标
        （delogo 会自动换成 boxblur，其余类型保持不动只勾局部）"""
        self.enabled_var.set(True)
        if self.type_var.get() == "delogo":
            self.type_var.set("boxblur")
            self.strength_var.set("5")
        self.region_var.set(True)
        # 坐标缺失时尝试从「裁剪」设置带入
        if not (self.w_var.get().strip() and self.h_var.get().strip()):
            self.copy_from_crop(silent=True)
        if not self.strength_var.get().strip():
            self.strength_var.set("5" if self.type_var.get() == "boxblur" else "2.0")
        self.update_strength_state()
        self.update_coord_state()
        if getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                _("已切换为局部应用（仅作用选定区域）：应用后 -vf 将自动生成 "
                "split→crop→滤镜→overlay 滤镜图，"
                "并排在裁剪/旋转/缩放等滤镜之前（坐标以原始画面为准）"))
    
    def _resolve_crop_coord(self, expr):
        """把裁剪坐标表达式（可能含 iw/ih，如 iw/2、ih-100）按输入文件原始尺寸换算成数字。

        delogo 滤镜不支持表达式（x/y/w/h 只认像素数字），而裁剪参数常填 iw/2 等相对式，
        复制到 delogo 前必须求值。纯数字直接返回；取不到尺寸或求值失败则保留原样（与旧行为一致）。"""
        expr = expr.strip()
        if not expr:
            return expr
        if expr.lstrip("-").isdigit():
            return expr
        app = getattr(self.filter_frame, "app", None)
        file_path = ""
        if app is not None:
            inp = getattr(app, "input_file", None)
            if inp is not None:
                file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
            if not file_path:
                file_path = getattr(self.filter_frame, "current_file", "") or ""
        if file_path and os.path.exists(file_path) and app is not None:
            try:
                ow, oh = app._get_video_dimensions_cached(file_path)
            except Exception:
                ow = oh = None
            if ow and oh:
                # iw/ih 按原始尺寸求值（不再在此减 2：delogo 的边界安全化由
                # _delogo_safe 统一处理——仅减宽高不解决 x=0/y=0 贴边失败）
                if expr == "iw":
                    return str(ow)
                if expr == "ih":
                    return str(oh)
                val = safe_eval_expr(expr, {"iw": ow, "ih": oh})
                if val is not None:
                    return str(val)
        return expr

    def _delogo_safe(self, x, y, w, h, ow, oh):
        """delogo 区域必须四周留 ≥1 像素边界，否则滤镜失败（实测 ffmpeg 8.1：
        x/y=0 贴边、x+w≥iw、y+h≥ih 均报 Error reinitializing filters）。
        对复制/框选来的坐标统一缩进到安全范围。返回 (x,y,w,h)。"""
        if x < 1:
            w -= (1 - x)
            x = 1
        if y < 1:
            h -= (1 - y)
            y = 1
        if w > ow - x - 1:
            w = ow - x - 1
        if h > oh - y - 1:
            h = oh - y - 1
        return x, y, w, h

    def copy_from_crop(self, silent: bool = False):
        crop_w = self.filter_frame.crop_width.get().strip()
        crop_h = self.filter_frame.crop_height.get().strip()
        crop_x = self.filter_frame.crop_left.get().strip()
        crop_y = self.filter_frame.crop_top.get().strip()
        if not crop_w or not crop_h:
            if not silent:
                messagebox.showwarning(_("提示"), _("裁剪未启用或参数为空，请先在「视频滤镜」中启用裁剪并设置区域。"))
            return
        # delogo 不支持表达式：iw/ih 按输入文件原始尺寸换算成数字后填入
        # delogo 的 x/y/w/h 不允许为 0（w/h=0 滤镜无效），凡解析为 0 一律改为 1
        def _nonzero(v):
            try:
                if int(v) == 0:
                    return "1"
            except (ValueError, TypeError):
                pass
            return v
        x = self._resolve_crop_coord(crop_x)
        y = self._resolve_crop_coord(crop_y)
        w = self._resolve_crop_coord(crop_w)
        h = self._resolve_crop_coord(crop_h)
        # delogo 区域必须四周留 ≥1px 边界（x/y=0 贴边或右/下越界 → 滤镜失败）。
        # 框选整画面 (0,0,720,405) 会被缩进为 (1,1,718,403)；数字与 iw/ih 表达式统一处理。
        if self.type_var.get() == "delogo":
            app = getattr(self.filter_frame, "app", None)
            file_path = ""
            if app is not None:
                inp = getattr(app, "input_file", None)
                if inp is not None:
                    file_path = inp.get().strip() if hasattr(inp, "get") else str(inp)
                if not file_path:
                    file_path = getattr(self.filter_frame, "current_file", "") or ""
            if file_path and os.path.exists(file_path) and app is not None:
                try:
                    ow, oh = app._get_video_dimensions_cached(file_path)
                except Exception:
                    ow = oh = None
                if ow and oh:
                    try:
                        xi, yi, wi, hi = int(x), int(y), int(w), int(h)
                    except (ValueError, TypeError):
                        pass  # 含无法求值的表达式 → 保持原样
                    else:
                        xi, yi, wi, hi = self._delogo_safe(xi, yi, wi, hi, ow, oh)
                        x, y, w, h = str(xi), str(yi), str(wi), str(hi)
        self.x_var.set(_nonzero(x))
        self.y_var.set(_nonzero(y))
        self.w_var.set(_nonzero(w))
        self.h_var.set(_nonzero(h))
        if not self.enabled_var.get():
            self.enabled_var.set(True)
        # 已开启局部模糊时保持当前模糊类型，不再强制切回 delogo
        switched = False
        if self.type_var.get() != "delogo" and not self.region_var.get():
            self.type_var.set("delogo")
            self.on_type_change()
            switched = True
        else:
            self.update_coord_state()
        if not silent and getattr(self.filter_frame, "app", None):
            self.filter_frame.app._append_info_ui(
                _("已从裁剪复制坐标，并自动切换到 delogo 模式") if switched else _("已从裁剪复制坐标"))
    
    # ---------- 多区域列表 ----------
    def _refresh_blur_tree(self):
        sel = None
        if self.tree.selection():
            sel = self.tree.selection()[0]
        self.tree.delete(*self.tree.get_children())
        for i, it in enumerate(self.items):
            _en = "☑" if it.get("enabled", True) else "☐"
            _t = it.get("type", "delogo")
            if it.get("full_frame", False) and _t in self._REGION_EFFECTS:
                _sum = _("全帧")
            else:
                _sum = f"({it.get('x','0')},{it.get('y','0')}) {it.get('w','100')}x{it.get('h','100')}"
            _s = it.get("strength", "")
            if _s and _t in self._strength_spec():
                _sum += f" r={_s}"
            self.tree.insert("", "end", iid=str(i), values=(_en, _t, _sum))
        if sel is not None and self.tree.exists(sel):
            self.tree.selection_set(sel)

    def _sync_current_to_tree(self, *args):
        """表单变量 trace 回调：把当前选中项表单值写回列表并刷新（实时联动）。

        2026-08-26 修复「新加 delogo 填完坐标列表数值不变」：坐标/类型/强度/
        启用任一变化即时更新当前项的列表行。加载表单期间由 _loading_form 守卫
        跳过（避免 set() → trace → 刷新 → selection 事件 → set() 死循环）。"""
        if getattr(self, "_loading_form", False):
            return
        idx = self._current_item_idx()
        if idx is None or not (0 <= idx < len(self.items)):
            return
        self._collect_form_to_item(idx)
        # ⚠️ 不再额外 selection_set：_refresh_blur_tree 已把选中行还原，
        # 再设一次只是多派发一轮 <<TreeviewSelect>>（白白多一次表单回读）。
        self._refresh_blur_tree()

    def _current_item_idx(self):
        s = self.tree.selection()
        if not s:
            return None
        try:
            return int(s[0])
        except (ValueError, TypeError):
            return None

    def _load_item_to_form(self, idx):
        """把第 idx 项读进表单。

        ⚠️ 2026-09-02 修复「半径 / sigma 输入框打字错乱」（回灌统一尝试版）：
        这里**绝不能**调 on_type_change()——那个方法会把 strength_var 无条件重置成
        类型默认值（boxblur→5、gblur→2.0）。用户敲一个键就会走
        「trace → _sync_current_to_tree → 刷列表 → selection_set → 选中事件
          → 本函数 → on_type_change → set(默认值)」，
        于是框里的值被冲回 5 / 2.0、光标跑到末尾，下一个字符追加到后面 →
        列表出现 51、2.01 这类怪值。加载表单只该同步**控件状态**，不该改数据。
        """
        # 加载期间置守卫，避免 var.set() → trace(_sync_current_to_tree) → 刷新 → 死循环
        self._loading_form = True
        try:
            it = self.items[idx]
            # 航点内存态：从该项读入（仅 delogo 消费；其他类型存着无害）
            self._current_waypoints = [dict(w) for w in (it.get("waypoints") or [])
                                       if isinstance(w, dict)]
            # ⚠️ enabled_var 是「启用去水印/模糊」总开关，单项启用由列表「启用」列点击管理——
            # 加载项时绝不覆盖总开关，否则点过启用列的项会被表单值覆盖回 True。
            # ⚠️ 一律走 _tk_setv：值没变就不写，避免把用户正在敲的框冲掉、光标跳到末尾。
            _tk_setv(self.type_var, it.get("type", "delogo"))
            _tk_setv(self.strength_var, it.get("strength", ""))
            _tk_setv(self.x_var, it.get("x", "1"))
            _tk_setv(self.y_var, it.get("y", "1"))
            _tk_setv(self.w_var, it.get("w", "100"))
            _tk_setv(self.h_var, it.get("h", "100"))
            if it.get("type", "delogo") in self._REGION_EFFECTS:
                # 区域效果：勾=局部（旧行为，full_frame 缺省/False），不勾=全帧（full_frame=True）
                _tk_setv(self.region_var, not bool(it.get("full_frame", False)))
            else:
                _tk_setv(self.region_var, it.get("region_only", False))
            _tk_setv(self.enable_start_var, it.get("enable_start", ""))
            _tk_setv(self.enable_end_var, it.get("enable_end", ""))
            _tk_setv(self.enable_cycle_var, it.get("enable_cycle", ""))
            _tk_setv(self.enable_show_var, it.get("enable_show", ""))
            # 不再调 on_type_change()：它只负责「类型下拉变动」时的联动，加载表单不该改数据
            self.update_strength_state()
            self.update_coord_state()
        finally:
            self._loading_form = False
        # ⚠️ 选中任意一项后都要重渲右侧预览（2026-10-04 用户报「点列表里那条也没帧」）：
        # 全部 _tk_setv 都是「值不变就不写」，而点已有项时表单值往往与该项完全一致
        # ⇒ 12 个表单变量的 trace 一个都不响 ⇒ 预览停在上一个项/空白。
        # 这里是所有选中路径（首次加载 / 点列表 / 新建 / 删除 / 上移下移）的唯一收口，
        # 在这里补一次 schedule()，五条路径一次覆盖。
        with suppress(Exception):
            self.preview.schedule()

    def _collect_form_to_item(self, idx):
        it = self.items[idx]
        # enabled 不收集：单项启用只由列表「启用」列点击切换（_on_tree_click），
        # 表单保存（apply）不得用总开关覆盖它——这正是「取消启用后保存又恢复」的根因。
        # 映射本体在 _form_to_item_dict（右侧预览共用同一份，避免两处漂移）。
        it.update(self._form_to_item_dict())

    def _on_tree_select(self, ev):
        idx = self._current_item_idx()
        if idx is None:
            return
        # ⚠️ 回环保卫：_refresh_blur_tree 重建行后会把选中行重新设回去，于是再派发一次
        # 本事件。若选中的还是同一行，说明这只是「刷新回声」——表单本来就是这行的数据，
        # 再回读一次会把用户正在敲的字符冲掉（radius 敲 1→1、再敲 1→51 的元凶之一）。
        if idx == self._last_sel:
            return
        # 先写回上一个选中项的表单值，再加载新选中项
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        self._load_item_to_form(idx)
        self._last_sel = idx

    def _on_tree_click(self, ev):
        with suppress(Exception):
            if self.tree.identify_column(ev.x) == "#1":
                iid = self.tree.identify_row(ev.y)
                if iid:
                    idx = int(iid)
                    self.items[idx]["enabled"] = not self.items[idx].get("enabled", True)
                    self._refresh_blur_tree()
                    self.tree.selection_set(iid)

    def _add_blur_item(self):
        if self._last_sel is not None and 0 <= self._last_sel < len(self.items):
            self._collect_form_to_item(self._last_sel)
        # ⚠️ 默认坐标必须是 (1,1) 而不是 (0,0) / 居中大数（2026-10-06 用户报「delogo 首帧
        # 一直失败」）：delogo 要求区域**四周留 ≥1 像素** —— x=0/y=0 贴边、x+w≥iw、
        # y+h≥ih 都会让滤镜配置失败（ffmpeg 原文 `Failed to configure input pad on
        # Parsed_delogo_1`），而 ffmpeg **不打印任何坐标相关说明**，用户只看到一句看不懂的报错。
        # ⚠️ `Parsed_delogo_1` 里的 `1` **不是「第 2 条去水印」**，是滤镜图里的实例序号 ——
        # 预览链的 `setpts=PTS+…/TB` 是 `Parsed_setpts_0`，delogo 就顺延成 `_1`。
        # 只要是单条 delogo 就会显示 `Parsed_delogo_1`，别按「第 2 条」去查列表（2026-10-06 踩过）。
        # 实测（320x180 素材）：x=y=0 失败、x=y=1 通过；x+w=319 通过、x+w=320 失败。
        # 与 `_delogo_safe` 的夹紧口径逐字一致 —— 新建条目就落在安全域内，不必等框选修正。
        self.items.append({"enabled": True, "type": "delogo", "x": "1", "y": "1",
                           "w": "100", "h": "100", "strength": "", "region_only": False,
                           "full_frame": False,
                           "enable_start": "", "enable_end": "", "enable_cycle": "",
                           "enable_show": "", "waypoints": []})
        self._refresh_blur_tree()
        self.tree.selection_set(str(len(self.items) - 1))
        self._last_sel = len(self.items) - 1
        self._load_item_to_form(self._last_sel)

    def _del_blur_item(self):
        idx = self._current_item_idx()
        if idx is None or not self.items:
            return
        del self.items[idx]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(False)
            self.type_var.set("delogo")
            self.x_var.set("0"); self.y_var.set("0")
            self.w_var.set("100"); self.h_var.set("100")
            self.strength_var.set(""); self.region_var.set(False)
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.on_type_change()
            self.update_strength_state()
            self.update_coord_state()

    def _move_blur_item(self, d):
        idx = self._current_item_idx()
        if idx is None:
            return
        if 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        ni = idx + d
        if ni < 0 or ni >= len(self.items):
            return
        self.items[idx], self.items[ni] = self.items[ni], self.items[idx]
        self._refresh_blur_tree()
        self.tree.selection_set(str(ni))
        self._last_sel = ni
        self._load_item_to_form(ni)

    def load_settings(self):
        # 多区域列表：优先 filter_frame._blur_items，无则旧键迁移
        items = list(getattr(self.filter_frame, "_blur_items", None) or [])
        if not items:
            _fe = self.filter_frame._blur_enabled.get()
            _fx = self.filter_frame._blur_x.get()
            _fw = self.filter_frame._blur_w.get()
            if _fe or _fx or _fw:
                items = [{
                    "enabled": _fe,
                    "type": self.filter_frame._blur_type.get() or "delogo",
                    "strength": self.filter_frame._blur_strength.get(),
                    "x": _fx,
                    "y": self.filter_frame._blur_y.get(),
                    "w": _fw,
                    "h": self.filter_frame._blur_h.get(),
                    "region_only": self.filter_frame._blur_region_only.get(),
                    "full_frame": False,
                    "enable_start": "", "enable_end": "", "enable_cycle": "",
                    "enable_show": "",
                    "waypoints": [],
                }]
        self.items = [dict(i) for i in items]
        self._last_sel = None
        self._refresh_blur_tree()
        if self.items:
            self.tree.selection_set("0")
            self._last_sel = 0
            self._load_item_to_form(0)
        else:
            self.enabled_var.set(self.filter_frame._blur_enabled.get())
            self.type_var.set(self.filter_frame._blur_type.get())
            self.x_var.set(self.filter_frame._blur_x.get())
            self.y_var.set(self.filter_frame._blur_y.get())
            self.w_var.set(self.filter_frame._blur_w.get())
            self.h_var.set(self.filter_frame._blur_h.get())
            self.strength_var.set(self.filter_frame._blur_strength.get())
            self.region_var.set(self.filter_frame._blur_region_only.get())
            self.enable_start_var.set(""); self.enable_end_var.set("")
            self.enable_cycle_var.set(""); self.enable_show_var.set("")
            self.update_strength_state()
            self.update_coord_state()

    def apply(self):
        # 当前选中项表单写回列表
        idx = self._current_item_idx()
        if idx is not None and 0 <= idx < len(self.items):
            self._collect_form_to_item(idx)
        # 校验所有启用项
        for it in self.items:
            if not it.get("enabled", True):
                continue
            ftype = it.get("type", "delogo")
            region = it.get("region_only", False)
            # 全帧仅对区域效果类型有效；勾了全帧不需要坐标
            full = bool(it.get("full_frame", False)) and ftype in self._REGION_EFFECTS
            if not full and (ftype == "delogo" or ftype in self._REGION_EFFECTS or region):
                if ftype == "delogo":
                    label = "delogo"
                elif region:
                    label = _("局部滤镜")
                else:
                    label = ftype
                for nm in ("x", "y", "w", "h"):
                    if alert_if(not (str(it.get(nm, "")).strip()), _("错误"), _('{0} 需要完整的区域坐标，{1} 不能为空').format(label, nm.upper()), 'error'):
                        return
            _spec = self._strength_spec().get(ftype)
            if _spec and not str(it.get("strength", "")).strip():
                it["strength"] = _spec[1]
            # delogo 轨迹段墙预检（2026-10-09）：撞墙直接报错，不做降级 Route B
            if ftype == "delogo":
                _wps = it.get("waypoints") or []
                if _wps:
                    try:
                        _delogo_waypoints_to_exprs(_wps)
                    except ValueError as _e:
                        if alert_if(True, _("错误"), str(_e), 'error'):
                            return
        # 写回
        self.filter_frame._blur_items = [dict(i) for i in self.items]
        self.filter_frame._blur_enabled.set(self.enabled_var.get())  # 总开关
        # 兼容：旧单键同步第一项（旧版读取路径/预览仍可用）
        if self.items:
            it0 = self.items[0]
            self.filter_frame._blur_type.set(it0.get("type", "delogo"))
            self.filter_frame._blur_strength.set(it0.get("strength", ""))
            self.filter_frame._blur_x.set(it0.get("x", "1"))
            self.filter_frame._blur_y.set(it0.get("y", "1"))
            self.filter_frame._blur_w.set(it0.get("w", "100"))
            self.filter_frame._blur_h.set(it0.get("h", "100"))
            self.filter_frame._blur_region_only.set(it0.get("region_only", False))
        if self.enabled_var.get() and getattr(self.filter_frame, "app", None):
            _n = len([i for i in self.items if i.get("enabled", True)])
            if _n:
                self.filter_frame.app._append_info_ui(
                    _('[去水印/模糊] 已启用 {0} 个区域（{1}）').format(_n, '、'.join((i.get('type', '') for i in self.items if i.get('enabled', True)))))
        if hasattr(self.filter_frame, 'app') and self.filter_frame.app:
            self.filter_frame.app.update_command_preview()
        # 撤销：delogo / 区域滤镜编辑入栈（复用 convert scope；快照口径与 load_preset /
        # 导入项目一致，_restore_convert_state_dict 会回写 blur_items）。此前此处只写
        # filter_frame._blur_items 未 push → 撤销栏不显示、Ctrl+Z 回不去。
        _app = getattr(self.filter_frame, "app", None)
        _before = getattr(self, "_blur_undo_before", None)
        if _app is not None and _before is not None and hasattr(_app, "_push_history"):
            _after = _app._build_convert_state_dict()
            if _after != _before:  # 防无变化入栈（与 merge 页守卫一致）
                _app._push_history(
                    "convert", _("去水印/模糊编辑"),
                    lambda: _app._restore_convert_state_dict(copy.deepcopy(_before)),
                    lambda: _app._restore_convert_state_dict(copy.deepcopy(_after)),
                )
        self.destroy()


# ================== 音频组件 ==================
# ================== 音频分段效果（公共件：转换页与封装页共用） ==================
# 机制：FFmpeg 滤镜的通用 timeline 选项 enable='表达式'，表达式里的 t = 该滤镜入口处的时间。
# 分段滤镜统一追加在所有音频滤镜的最末尾 → t 恒等于「输出时间线」（atrim / adelay / atempo /
# areverse 都已经在它前面生效），用户填的时间就是听到的第几秒，不需要做任何换算。
#
# 硬约束（2026-09-04 本机 ffmpeg n9.0.1 实测，改动前必读）：
#  1. T 标志闸门：只有 `ffmpeg -filters` 里带 T(Timeline support) 的滤镜才接受 enable，
#     否则 ffmpeg 直接硬报错「Timeline ('enable' option) not supported with filter 'xxx'」
#     导致整条命令失败。因此下表只收录带 T 的滤镜。
#     已实测不可用：acompressor / aecho / chorus / flanger / pan / atempo / loudnorm /
#     rubberband / asetrate / aphaser（段内压限·回声·消人声·变声·响度标准化均做不了）。
#  2. afade 串联做软边缘是死路：fade out 的包络结束后恒为 0，串联其后的 fade in 乘上去
#     永远回不来（实测整段静音）。软边缘只能用 volume=eval=frame:volume='表达式'，
#     且 eval=frame 必须写（漏写则表达式只在首帧求值一次、完全无效，同 scale 的 eval=init 陷阱）。
#  3. 该表达式按「帧」求值，软边缘的过渡精度约为一个音频帧（1024 采样 ≈ 23ms @44.1kHz）。

