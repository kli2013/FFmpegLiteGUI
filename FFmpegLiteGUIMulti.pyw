        ttk.Button(btn_frame, text=_("取消"), command=self.destroy).pack(side=tk.LEFT, padx=5)

        # ---- 右侧实时预览（2026-10-04 用户要求：学「高级增强」在右边显示画面）----
        # 挂在 paned 右 pane（不是 grid 第 3 列）—— 见 create_widgets 开头「为什么必须用
