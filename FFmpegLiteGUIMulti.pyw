    def _apply_fade_all_tracks(self, current_track_obj=None, current_fade_vars=None):
        """一键为所有已启用的视频/音频轨道启用淡入淡出。

        淡入淡出时长取自视频编辑窗口「淡入淡出」页的「一键淡入淡出(all)」时长框（self.oneclick_fade_duration），默认 1.0s，
        可自由填写不再死板；超过片段时长 40% 时自动钳制，避免过短片段淡入淡出互相覆盖。

        current_track_obj / current_fade_vars：当从视频编辑窗口内点击时传入「当前正在编辑的轨道对象」与
        「窗口内淡入淡出页的局部变量 (fade_enabled_var, fade_in_var, fade_out_var)」。函数会直接写回轨道对象的
        enc_settings，并同步窗口局部变量，避免点击「保存」时局部变量（仍为未启用）把刚写入的淡入淡出覆盖掉。
        """
        enabled = [t for t in self.merge_tracks if t.enabled]
        if alert_if(not enabled, _("提示"), _("没有已启用的轨道。"), 'info'):
            return
        # 取「一键淡入淡出」时长框的数字作为淡入淡出基准时长（可自定义）
        try:
            fade_base = float(self.oneclick_fade_duration.get().strip() or "1.0")
        except ValueError:
            fade_base = 1.0
        if fade_base <= 0:
            fade_base = 1.0
        count = 0
        for t in enabled:
            if t.type == "video":
                if self._is_static_image(t.file_path):
                    # 图片轨没有媒体时长（ffprobe 对图片 format=duration 返回 N/A →
                    # _get_media_duration 返 None），必须用「截取」面板的「显示时长(秒)」
                    # (img_duration) 作基准，与串行命令端同一真源 _eff_image_display_duration。
                    # 2026-09-22 修：此前走 _get_effective_duration → None → 兜底成 fade_base(1.0)
                    # → 再被 40% 钳制打成 0.4s，与用户填的时长框对不上。
                    dur = _eff_image_display_duration(t.enc_settings)
                else:
                    dur = self._get_effective_duration(t.enc_settings, input_path=t.file_path)
                if dur is None or dur <= 0:
                    dur = fade_base
                f = min(fade_base, dur * 0.4)
                t.enc_settings["fade_enabled"] = True
                t.enc_settings["fade_in"] = f"{f:.2f}"
                t.enc_settings["fade_out"] = f"{f:.2f}"
                count += 1
            elif t.type == "audio":
                dur = self._get_media_duration(t.file_path) or fade_base
                f = min(fade_base, dur * 0.4)
                t.enc_settings["fade_enabled"] = True
                t.enc_settings["fade_in"] = f"{f:.2f}"
                t.enc_settings["fade_out"] = f"{f:.2f}"
                count += 1
        # 从编辑窗内点击时，同步窗口局部淡入淡出变量，确保「保存」不会覆盖刚写入的淡入淡出
        if current_track_obj is not None and current_fade_vars is not None:
            cs = current_track_obj.enc_settings
            if cs.get("fade_enabled"):
                en_var, in_var, out_var = current_fade_vars
                en_var.set(True)
                in_var.set(str(cs.get("fade_in", "")))
                out_var.set(str(cs.get("fade_out", "")))
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(_('[淡入淡出] 已为 {0} 个视频/音频轨道启用淡入淡出（时长取自一键淡入淡出框：{1:.2f}s，短片段自动钳制）').format(count, fade_base))


    def _apply_transition_all_tracks(self, current_track_obj=None, current_transition_vars=None):
        """一键为所有已启用的视频轨道（除末段）开启串行转场。

        转场挂本段（段 i 控制 i↔i+1 的过渡），末段无下一段自动跳过。
        类型取编辑窗当前下拉框（transition_type_var），时长取自「一键转场」时长框
        （self.oneclick_transition_duration），默认 1.0s；命令生成时自动钳制为相邻两段较短者的一半。

        current_track_obj / current_transition_vars：从视频编辑窗口内点击时传入，用于同步窗口局部变量，
        避免点「保存」时局部变量（仍为未启用）覆盖刚写入的转场设置。
        """
        vids = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        if alert_if(not vids, _("提示"), _("没有已启用的视频轨道。"), 'info'):
            return
        # 画中画模式：主视频也可以是链首（与「起始≈主视频时长」的子视频转场），故不排除 vids[0]
        _pip_only = bool(getattr(self, "pip_enabled", None) and self.pip_enabled.get()) \
            and not self.concat_enabled.get()
        _src = vids
        # 末段无下一段，不参与
        targets = _src[:-1] if len(_src) > 1 else []
        if alert_if(not targets, _("提示"), _("至少需要 2 个视频片段才能启用转场。"), 'info'):
            return
        # 类型：优先取窗口当前下拉框值，否则默认 fade
        ttype = "fade"
        if current_transition_vars is not None:
            _unused, _type_var, _dur_var = current_transition_vars
            ttype = (_type_var.get().strip() or "fade")
        if ttype not in XFADE_TRANSITIONS:
            ttype = "fade"
        # 时长：取「一键转场」时长框
        try:
            td = float(self.oneclick_transition_duration.get().strip() or "1.0")
        except ValueError:
            td = 1.0
        if td <= 0:
            td = 1.0
        for t in targets:
            t.enc_settings["transition_enabled"] = True
            t.enc_settings["transition_type"] = ttype
            t.enc_settings["transition_duration"] = f"{td:.2f}"
        # 从编辑窗内点击时，同步窗口局部转场变量
        if current_track_obj is not None and current_transition_vars is not None:
            cs = current_track_obj.enc_settings
            en_var, type_var, dur_var = current_transition_vars
            en_var.set(bool(cs.get("transition_enabled", False)))
            type_var.set(cs.get("transition_type", "fade") or "fade")
            dur_var.set(str(cs.get("transition_duration", "1.0") or "1.0"))
        # ⚠️ 2026-09-27：这里原本在画中画下顺带跑一次「转场对齐」（等价「一键设置开始」的
        #    起点重排），2026-09-27 用户拍板去掉 —— 点「一键转场」不该偷偷改各段的显示时段起点。
        #    现在本函数只动转场开关/类型/时长；要重排起点请显式点「转场对齐」或「一键设置开始」。
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            _('[转场] 已为 {0} 个视频轨道开启{1}（类型 {2}，时长 {3:.2f}s，末段自动跳过）；起点不变，需要按转场让位请点「转场对齐」').format(len(targets), '转场（含主视频→子视频）' if _pip_only else '串行转场', xfade_display_name(ttype), td)
        )

    def _clear_fade_transition_all_tracks(self, current_track_obj=None,
                                          current_fade_vars=None,
                                          current_transition_vars=None):
        """一键重置：关掉所有轨道的淡入淡出 + 串行转场（与「一键淡入淡出(all)/一键转场(all)」配对）。

        「关开关」而不是「清数值」：fade_in / fade_out / transition_type /
        transition_duration 原样保留 —— 重新勾「一键淡入淡出 / 一键转场」时还是你
        上次选的那套数值，不用重填。显示时段（show_start / show_end）也不动，
        那是「时间分配总览」管的事。

        current_track_obj / current_fade_vars / current_transition_vars：从视频编辑窗口
        「淡入淡出」页点这个按钮时传入，把窗口里的勾选框 / 输入框同步成刚关掉的状态，
        否则点「保存」时局部变量（还是旧的 True）会把设置再写回去。
        """
        n_fade = n_tr = 0
        for t in self.merge_tracks:
            cs = t.enc_settings
            if not isinstance(cs, dict):
                continue
            if cs.get("fade_enabled"):
                n_fade += 1
            if cs.get("transition_enabled"):
                n_tr += 1
            cs["fade_enabled"] = False
            cs["fade_in"] = ""
            cs["fade_out"] = ""
            cs["transition_enabled"] = False
        if not n_fade and not n_tr:
            self._append_info_ui(_("[淡入淡出] 当前没有开启的淡入淡出 / 转场，无需重置。"))
            return
        if current_track_obj is not None and current_fade_vars is not None:
            en_var, in_var, out_var = current_fade_vars
            en_var.set(False)
            in_var.set("")
            out_var.set("")
        if current_track_obj is not None and current_transition_vars is not None:
            en_var, _t_var, _d_var = current_transition_vars
            en_var.set(False)      # 类型 / 时长保留，重新一键开启时还是原值
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            f"[淡入淡出] 已重置：关掉 {n_fade} 条轨道的淡入淡出、{n_tr} 条串行转场"
            f"（数值保留，重新一键开启时还是原值）")

    def _apply_image_duration_all_tracks(self, current_track_obj=None, current_img_var=None):
        """一键把所有已启用图片轨道的「显示时长(秒)」统一为本行时长框的数值。

        图片本身没有时间长度，显示几秒只能由用户指定（命令端按它给图片段限时：
        `-loop 1 -framerate fps -t 显示时长 -i 图`）。多图串行（相册 / 幻灯片）时逐张改很慢，
        故提供与「一键淡入淡出(all) / 一键转场(all)」同款的批量入口。

        时长取自 self.oneclick_image_duration（编辑窗「截取片段」页本行「时长(秒)」框，默认 10s）。

        current_track_obj / current_img_var：从视频编辑窗口内点击时传入，用于把新值同步回
        窗口内「显示时长」输入框（trim_frame.img_duration），避免点「保存」时局部变量
        （仍是旧值）把刚写入的时长覆盖掉。
        """
        try:
            dur = float(self.oneclick_image_duration.get().strip() or "10")
        except ValueError:
            dur = 10.0
        if dur <= 0:
            dur = 10.0
        txt = f"{dur:g}"
        targets = [t for t in self.merge_tracks
                   if t.enabled and t.type == "video" and self._is_static_image(t.file_path)]
        # 当前轨是图片但未启用时不在 targets 里 —— 单独补写，保证「当前这张图」也被改到
        cur = current_track_obj
        if cur is not None and cur not in targets and self._is_static_image(getattr(cur, "file_path", "")):
            targets = list(targets) + [cur]
        if alert_if(not targets, _("提示"), _("没有图片轨道（图片素材的显示时长才需要设置）。"), 'info'):
            return
        for t in targets:
            t.enc_settings["img_duration"] = txt
        # 同步编辑窗局部变量（保存时不会覆盖）
        if current_img_var is not None:
            current_img_var.set(txt)
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(_('[显示时长] 已把 {0} 个图片轨道的显示时长统一为 {1}s').format(len(targets), txt))

    def _copy_filter_from_selected(self):
        """从选中的第一个轨道复制滤镜参数。

        采用「默认全复制 + 显式排除」策略：遍历 enc_settings，仅跳过
        _COPY_FILTER_EXCLUDE_KEYS 中声明的结构/身份/编码器/运行时键，
        其余键（含新增滤镜参数）一律复制。深拷贝字典/列表避免共享引用。
        """
        selected = self.merge_tree.selection()
        if not selected:
            return
        idx = self._merge_iid_idx(selected[0])
        if idx >= len(self.merge_tracks):
            return
        track = self.merge_tracks[idx]
        track_type = track.type

        params = {}
        for key, val in track.enc_settings.items():
            if key in _COPY_FILTER_EXCLUDE_KEYS:
                continue
            if val is None:
                continue
            if isinstance(val, (dict, list)):
                params[key] = copy.deepcopy(val)   # 深拷贝字典/列表，避免共享引用
            else:
                params[key] = val

        self._clipboard_filter_params = {
            "type": track_type,
            "params": params
        }
        self._append_info_ui(_('已复制 {0} 滤镜设置: {1}').format(track_type, os.path.basename(track.file_path)))
    
    def _paste_filter_to_selected(self):
        """将剪贴板中的滤镜参数粘贴到选中的轨道（跳过 None 值）"""
        if self._clipboard_filter_params is None:
            return
        selected = self.merge_tree.selection()
        if alert_if(not selected, _("提示"), _("请先选择要应用滤镜的目标轨道"), 'info'):
            return
        
        clip_type = self._clipboard_filter_params["type"]
        clip_params = self._clipboard_filter_params["params"]
        
        applied_count = 0
        for iid in selected:
            idx = self._merge_iid_idx(iid)
            if idx >= len(self.merge_tracks):
                continue
            track = self.merge_tracks[idx]
            if track.type != clip_type:
                self._append_info_ui(_('跳过 {0} 轨道（类型不匹配）').format(track.type))
                continue
            
            # 应用参数，跳过 None
            for key, value in clip_params.items():
                if value is None:
                    continue  # 跳过 None，保留目标原有值
                if key == "enhance":
                    track.enc_settings[key] = copy.deepcopy(value)
                else:
                    track.enc_settings[key] = value
            
            # 同步视频轨道的独立属性
            if track.type == "video":
                track.overlay_enabled = track.enc_settings.get("overlay_enabled", True)
                track.overlay_x = track.enc_settings.get("overlay_x", DEFAULT_OVERLAY_X)
                track.overlay_y = track.enc_settings.get("overlay_y", DEFAULT_OVERLAY_Y)
                track.pad_enabled = track.enc_settings.get("pad_enabled", False)
                track.pad_width = track.enc_settings.get("pad_width", "")
                track.pad_height = track.enc_settings.get("pad_height", "")
                track.offset_x = track.enc_settings.get("offset_x", "0")
                track.offset_y = track.enc_settings.get("offset_y", "0")
            
            applied_count += 1
        
        if applied_count:
            self._append_info_ui(_('已将滤镜设置应用到 {0} 个轨道').format(applied_count))
            self.merge_refresh_ui()
        else:
            self._append_info_ui(_("没有可应用的轨道（类型不匹配或已跳过）"))

    def _has_selected_video_track(self):
        """选中轨道中是否存在视频轨道（V→A 复制菜单启用判断）"""
        for iid in self.merge_tree.selection():
            idx = self._merge_iid_idx(iid)
            if idx < len(self.merge_tracks) and self.merge_tracks[idx].type == "video":
                return True
        return False

    def _copy_va_filter_from_selected(self):
        """从选中的第一个视频轨道复制「截取/变速/倒放」到 V→A 专用剪贴板。

        只快照三组参数（映射到音频键名），不动其它滤镜；粘贴后音频仍可自由修改。
        """
        selected = self.merge_tree.selection()
        if not selected:
            return
        src = None
        for iid in selected:
            idx = self._merge_iid_idx(iid)
            if idx < len(self.merge_tracks) and self.merge_tracks[idx].type == "video":
                src = self.merge_tracks[idx]
                break
        if src is None:
            self._append_info_ui(_("请先选择视频轨道再复制 (V→A)"))
            return
        es = src.enc_settings
        self._clipboard_va_filter = {
            "trim_enabled": es.get("trim_enabled", False),
            "trim_start": es.get("trim_start", ""),
            "trim_end": es.get("trim_end", ""),
            "precise_trim": es.get("precise_trim", False),
            "speed_enabled": es.get("speed_enabled", False),
            "speed_factor": es.get("speed_factor", "1.0"),
            "reverse_enabled": es.get("reverse_enabled", False),
        }
        self._append_info_ui(_('已复制视频截取/变速/倒放 (V→A): {0}').format(os.path.basename(src.file_path)))

    def _paste_va_filter_to_selected(self):
        """把 V→A 剪贴板粘贴到选中的音频轨道。

        写入明确值（等价于用户自己重新设置一次截取/变速/倒放），粘贴后可自由取消。
        安全保护：音频源时长小于视频截取时间点时先告警，由用户决定是否仍要粘贴。
        """
        if self._clipboard_va_filter is None:
            return
        selected = self.merge_tree.selection()
        if alert_if(not selected, _("提示"), _("请先选择要应用的目标音频轨道"), 'info'):
            return
        clip = self._clipboard_va_filter

        # —— 安全保护：时长越界告警（一次确认，确定则全部粘贴，取消则中止）——
        if clip.get("trim_enabled"):
            bad = []
            for iid in selected:
                idx = self._merge_iid_idx(iid)
                if idx >= len(self.merge_tracks):
                    continue
                t = self.merge_tracks[idx]
                if t.type != "audio":
                    continue
                dur = self._get_media_duration(t.file_path)
                if dur is None:
                    continue
                try:
                    start = time_to_seconds(clip.get("trim_start", "").strip()) if clip.get("trim_start") else 0.0
                    end = time_to_seconds(clip.get("trim_end", "").strip()) if clip.get("trim_end") else None
                except Exception:
                    start, end = 0.0, None
                if end is not None and end > dur:
                    bad.append((os.path.basename(t.file_path), dur, end))
                elif start > dur:
                    bad.append((os.path.basename(t.file_path), dur, start))
            if bad:
                fname, dur, tsec = bad[0]
                if not messagebox.askyesno(
                    _("时长超出告警"),
                    _('音频轨 {0} 的源时长只有 {1:.1f} 秒，\n而视频截取时间点为 {2:.1f} 秒，超出音频时长，\n粘贴后 atrim 可能报错或产生静音。\n\n仍要粘贴吗？').format(fname, dur, tsec)):
                    self._append_info_ui(_("已取消粘贴 (V→A)（音频时长不足）"))
                    return

        applied_count = 0
        for iid in selected:
            idx = self._merge_iid_idx(iid)
            if idx >= len(self.merge_tracks):
                continue
            track = self.merge_tracks[idx]
            if track.type != "audio":
                self._append_info_ui(_('跳过 {0} 轨道（仅音频轨可粘贴 V→A）').format(track.type))
                continue
            es = track.enc_settings
            # 写明确值：等价于用户手动重新设置，未勾选也显式写 False，可自由取消
            es["trim_enabled"] = clip.get("trim_enabled", False)
            es["trim_start"] = clip.get("trim_start", "")
            es["trim_end"] = clip.get("trim_end", "")
            es["precise_trim"] = clip.get("precise_trim", False)
            es["audio_speed_enabled"] = clip.get("speed_enabled", False)
            es["audio_speed_factor"] = clip.get("speed_factor", "1.0")
            es["audio_reverse"] = clip.get("reverse_enabled", False)
            applied_count += 1

        if applied_count:
            self._append_info_ui(_('已将视频截取/变速/倒放应用到 {0} 个音频轨道（可自由取消）').format(applied_count))
            self.merge_refresh_ui()
        else:
            self._append_info_ui(_("没有可应用的音频轨道"))

    def _find_src_video_track(self, audio_track):
        """返回与音频轨同源（file_path 相同）的启用视频轨；没有则返回 None。

        仅在「同源音频轨」（拖入视频文件时选添加音频的轨道）才有对应视频轨；
        外部单独拖入的纯音频文件无对应视频轨。
        """
        if audio_track.type != "audio":
            return None
        for t in self.merge_tracks:
            if t.type == "video" and t.enabled and t.file_path == audio_track.file_path:
                return t
        return None

    def _batch_apply_src_video_to_audio(self):
        """批量：把选中的同源音频轨各自套用对应视频轨的截取/变速/倒放。

        仅作用于当前选中的轨道（选中音频轨取其同源视频；选中视频轨取其同源音频），
        不影响其他未选中的轨道。写入明确值（等价于用户手动重新设置，可自由取消）。
        安全保护：视频截取结束时间超出音频源时长时，自动钳制到音频时长，
        结束后一次性汇总提示被钳制的轨道（不逐条弹窗）。
        """
        selected = self.merge_tree.selection()
        if alert_if(not selected, _("提示"), _("请先选择要套用的同源音频轨（或对应视频轨）"), 'info'):
            return
        pairs = []
        seen = set()
        for iid in selected:
            idx = self._merge_iid_idx(iid)
            if idx >= len(self.merge_tracks):
                continue
            t = self.merge_tracks[idx]
            if t.type == "audio":
                src = self._find_src_video_track(t)
                if src is not None and id(t) not in seen:
                    pairs.append((t, src)); seen.add(id(t))
            elif t.type == "video":
                # 选中视频轨时，套用其同源（同 file_path）音频轨
                for at in self.merge_tracks:
                    if at.type == "audio" and at.file_path == t.file_path and id(at) not in seen:
                        pairs.append((at, t)); seen.add(id(at))
        if not pairs:
            self._append_info_ui(_("所选轨道中无可套用的同源音频轨（外部音频轨请用右键『复制/粘贴 截取、变速、倒放 (V→A)』）"))
            return

        clamped = []
        for a, s in pairs:
            ss = s.enc_settings
            trim_enabled = ss.get("trim_enabled", False)
            trim_start = ss.get("trim_start", "")
            trim_end = ss.get("trim_end", "")
            precise_trim = ss.get("precise_trim", False)
            speed_enabled = ss.get("speed_enabled", False)
            speed_factor = ss.get("speed_factor", "1.0")
            reverse_enabled = ss.get("reverse_enabled", False)

            # —— 越界钳制（仅处理 end 超出音频源时长的情况）——
            if trim_enabled:
                dur = self._get_media_duration(a.file_path)
                if dur is not None:
                    try:
                        end = time_to_seconds(trim_end.strip()) if trim_end else None
                        st = time_to_seconds(trim_start.strip()) if trim_start else 0.0
                    except Exception:
                        end, st = None, 0.0
                    if end is not None and end > dur:
                        new_end = dur
                        new_start = "0" if st >= new_end else trim_start
                        a.enc_settings.update({
                            "trim_enabled": True,
                            "trim_start": new_start,
                            "trim_end": _ffsec(new_end),
                            "precise_trim": precise_trim,
                            "audio_speed_enabled": speed_enabled,
                            "audio_speed_factor": str(speed_factor),
                            "audio_reverse": reverse_enabled,
                        })
                        clamped.append((os.path.basename(a.file_path), end, dur))
                        continue

            # 正常套用（写明确值，可自由取消）
            a.enc_settings.update({
                "trim_enabled": trim_enabled,
                "trim_start": trim_start,
                "trim_end": trim_end,
                "precise_trim": precise_trim,
                "audio_speed_enabled": speed_enabled,
                "audio_speed_factor": str(speed_factor),
                "audio_reverse": reverse_enabled,
            })

        self.merge_refresh_ui()
        if clamped:
            lines = "\n".join(f"• {name}：原 {e:.1f}s → 钳制到 {d:.1f}s" for name, e, d in clamped)
            messagebox.showinfo(
                _("批量套用完成（部分已钳制）"),
                _('已将 {0} 个同源音频轨套用对应视频轨的截取/变速/倒放。\n其中 {1} 个音频轨截取结束时间超出源时长，已自动钳制到音频时长：\n\n{2}').format(len(pairs), len(clamped), lines))
            self._append_info_ui(_('批量同源套用完成：{0} 个，其中 {1} 个越界已钳制').format(len(pairs), len(clamped)))
        else:
            self._append_info_ui(_('{0} 个音频轨已套用同源视频（截取/变速/倒放，可自由取消）').format(len(pairs)))

    def _reset_filter_settings(self):
        """将选中的轨道滤镜设置重置为默认状态（清空所有滤镜）"""
        selected = self.merge_tree.selection()
        if not selected:
            return
        
        if not messagebox.askyesno(_("确认还原"), _("将清除选中轨道的所有滤镜设置（裁剪、缩放、旋转、增强、截取、变速、倒放等），确定继续吗？")):
            return
        
        # 定义各类轨道的默认值
        video_defaults = {
            "crop_enabled": False, "crop_left": "0", "crop_top": "0", "crop_width": "iw/2", "crop_height": "ih",
            "scale_enabled": False, "scale_width": "", "scale_height": "", "scale_method": "width",
            "rotate": "none", "vflip": False, "hflip": False,
            "deinterlace_filter": "none",
            "speed_enabled": False, "speed_factor": "1.0",
            "reverse_enabled": False,
            "trim_enabled": False, "trim_start": "0", "trim_end": "", "precise_trim": False,
            "overlay_enabled": True, "overlay_x": DEFAULT_OVERLAY_X, "overlay_y": DEFAULT_OVERLAY_Y,
            "blend_mode": "normal", "overlay_free_layout": False,
            # 画中画/水印子视频的旋转(spin)与轨迹(move)：还原时必须一并清空，否则残留导致仍旋转/移动
            "spin_enabled": False, "spin_speed": 60.0, "rotate_angle": 0.0,
            "move_mode": "", "move_cycle": 4.0, "move_amp": "W*0.1",
            "move_dwell": 2.0, "move_margin": "W*0.03",
            "pad_enabled": False, "pad_width": "", "pad_height": "", "offset_x": "0", "offset_y": "0",
            "loop_enabled": False, "loop_mode": "infinite", "loop_count": 3,
            "chroma_enabled": False, "chroma_color": "#3fff08", "chroma_similarity": 0.2, "chroma_blend": 0.1,
            "alpha_enabled": False, "alpha_value": 1.0, "chroma_filter_type": "chromakey",
            "enhance": {},
            "audio_source_type": "self",
        }
        audio_defaults = {
            "trim_enabled": False, "trim_start": "0", "trim_end": "", "precise_trim": False,
            "audio_reverse": False,
            "audio_speed_enabled": False, "audio_speed_factor": "1.0",
            "volume_enabled": False, "volume": 1.0,
            "mix_enabled": False,
            "audio_out_mode": "stream",
            "audio_free_end": "",
        }
        # 如果音频还有 reverse_enabled 字段（兼容），一并清除
        audio_defaults["reverse_enabled"] = False
        
        applied_count = 0
        for iid in selected:
            idx = self._merge_iid_idx(iid)
            if idx >= len(self.merge_tracks):
                continue
            track = self.merge_tracks[idx]
            if track.type == "video":
                # 重置视频轨道
                for key, value in video_defaults.items():
                    track.enc_settings[key] = value
                # 同步独立属性
                track.overlay_enabled = True
                track.overlay_x = DEFAULT_OVERLAY_X
                track.overlay_y = DEFAULT_OVERLAY_Y
                track.pad_enabled = False
                track.pad_width = ""
                track.pad_height = ""
                track.offset_x = "0"
                track.offset_y = "0"
            elif track.type == "audio":
                # 重置音频轨道
                for key, value in audio_defaults.items():
                    track.enc_settings[key] = value
            else:
                self._append_info_ui(_('跳过 {0} 轨道（不支持还原）').format(track.type))
                continue
            applied_count += 1
        
        if applied_count:
            self._append_info_ui(_('已还原 {0} 个轨道的滤镜设置').format(applied_count))
            self.merge_refresh_ui()
        else:
            self._append_info_ui(_("没有可还原的轨道"))



    def merge_smart_tile(self, main_track_idx, pad_enabled_var=None, pad_width_var=None, pad_height_var=None,
                         items_per_row=4, items_per_col=4, orientation='auto', filt_frame=None):
        """
        智能平铺：所有视频（主视频+子视频）统一按行列排列。
        :param items_per_row: 横向优先时，每行视频数
        :param items_per_col: 纵向优先时，每列视频数
        :param orientation: 'auto' / 'horizontal' / 'vertical'
        :param filt_frame: 可选，主视频的 VideoFilterFrame 控件，用于读取未保存的缩放/裁剪设置
        """
        if alert_if(main_track_idx is None or main_track_idx >= len(self.merge_tracks), _("错误"), _("无效的主视频轨道索引"), 'error'):
            return
    
        main_track = self.merge_tracks[main_track_idx]
        if alert_if(main_track.type != "video", _("错误"), _("选中的不是视频轨道"), 'error'):
            return
    
        # 获取所有启用的视频轨道（排除主视频自身）
        sub_tracks = [t for t in self.merge_tracks if t.type == "video" and t.enabled and t != main_track]
        # 强制启用所有子视频的叠加
        for t in sub_tracks:
            t.enc_settings['overlay_enabled'] = True
            t.overlay_enabled = True
    
        # 构建总视频列表：主视频 + 子视频
        all_tracks = [main_track] + sub_tracks
        n = len(all_tracks)
        if alert_if(n == 1, _("提示"), _("没有可用于平铺的视频（至少需要一个子视频）"), 'info'):
            return
    
        # ---- 获取主视频渲染尺寸：优先从 filt_frame 读取实时值 ----
        if filt_frame is not None:
            main_settings = {
                "crop_enabled": filt_frame.crop_enabled.get(),
                "crop_width": filt_frame.crop_width.get(),
                "crop_height": filt_frame.crop_height.get(),
                "scale_enabled": filt_frame.scale_enabled.get(),
                "scale_method": filt_frame.scale_method.get(),
                "scale_width": filt_frame.scale_width.get(),
                "scale_height": filt_frame.scale_height.get(),
                "rotate": filt_frame.rotate.get()
            }
            orig_w, orig_h = self._cached_video_dimensions(main_track.file_path)
            if orig_w is None or orig_h is None:
                orig_w, orig_h = 1280, 720
            main_w, main_h = self.compute_final_size_with_order(orig_w, orig_h, main_settings)
        else:
            main_w, main_h = self._get_video_render_size(main_track)
            if main_w is None or main_h is None:
                main_w, main_h = 1280, 720
    
        # ---- 获取所有子视频的渲染尺寸（仍从 enc_settings 读取） ----
        infos = [(main_w, main_h, main_track)]
        for t in sub_tracks:
            w, h = self._get_video_render_size(t)
            if w is None or h is None:
                orig_w, orig_h = self._cached_video_dimensions(t.file_path)
                if orig_w and orig_h:
                    w, h = compute_rendered_size(orig_w, orig_h, t.enc_settings)
                else:
                    w, h = 320, 240
            infos.append((w, h, t))
    
        # ---- 核心改进：方向决策与智能排列 ----
        def calculate_layout(cols):
            """按行优先（每行 cols 个）排列 infos，返回 (row_groups, 画布宽, 画布高)。"""
            cols = max(1, min(cols, n))
            rows = (n + cols - 1) // cols
            row_groups = []
            for r in range(rows):
                start = r * cols
                end = min(start + cols, n)
                row_groups.append(infos[start:end])
            # 计算该布局下的画布真实宽高
            c_w = max((sum(w for w, h, t in row) for row in row_groups), default=0) if row_groups else 0
            c_h = sum((max((h for w, h, t in row), default=0) for row in row_groups), 0) if row_groups else 0
            return row_groups, c_w, c_h

        def eval_grid(cols):
            """评估某个列数下的布局得分：空单元格越少、画布比例越接近 16:9 越好。"""
            _unused, cw, ch = calculate_layout(cols)
            rows = (n + cols - 1) // cols
            empty = rows * cols - n
            ratio = (cw / ch) if ch > 0 else float('inf')
            # 空单元格权重最高，其次看画布比例接近 16:9 程度
            return empty * 5 + abs(ratio - 16.0 / 9.0)

        if orientation == 'auto':
            # 枚举所有可能的列数，挑「空单元格最少 + 画布比例最接近 16:9」的网格，
            # 而不是固定用「每行/每列」微调框的 4×4（那样 n=6 会得到 4×2 留 2 空格）。
            best = None
            for cols in range(1, n + 1):
                sc = eval_grid(cols)
                if best is None or sc < best[0]:
                    best = (sc, cols)
            cols = best[1]
            horizontal_priority = (calculate_layout(cols)[1] >= calculate_layout(cols)[2])
            row_groups, canvas_w, canvas_h = calculate_layout(cols)
        elif orientation == 'horizontal':
            # 横排优先：用「每行」微调框作为列数（保护手动指定）
            cols = max(1, min(items_per_row, n))
            horizontal_priority = True
            row_groups, canvas_w, canvas_h = calculate_layout(cols)
        else:  # vertical 竖排优先：列数尽量少、行尽量多（由「每列」微调框换算）
            rows = max(1, min(items_per_col, n))
            cols = max(1, min((n + rows - 1) // rows, n))
            horizontal_priority = False
            row_groups, canvas_w, canvas_h = calculate_layout(cols)
    
        if alert_if(canvas_w == 0 or canvas_h == 0, _("错误"), _("计算画布尺寸失败"), 'error'):
            return

        # 偶数保险：向下取整为偶数
        if canvas_w % 2 != 0:
            canvas_w -= 1
        if canvas_h % 2 != 0:
            canvas_h -= 1
        canvas_w = max(2, canvas_w)
        canvas_h = max(2, canvas_h)
    
        # ---- 更新主视频的 pad 设置 ----
        main_track.enc_settings['pad_enabled'] = True
        main_track.enc_settings['pad_width'] = str(canvas_w)
        main_track.enc_settings['pad_height'] = str(canvas_h)
        main_track.enc_settings['offset_x'] = "0"
        main_track.enc_settings['offset_y'] = "0"
        main_track.pad_enabled = True
        main_track.pad_width = str(canvas_w)
        main_track.pad_height = str(canvas_h)
        main_track.offset_x = "0"
        main_track.offset_y = "0"
        if pad_enabled_var is not None:
            pad_enabled_var.set(True)
        if pad_width_var is not None:
            pad_width_var.set(str(canvas_w))
        if pad_height_var is not None:
            pad_height_var.set(str(canvas_h))
    
        # ---- 计算每行的高度（用于垂直偏移） ----
        row_heights = []
        for row in row_groups:
            if row:
                row_heights.append(max(h for w, h, t in row))
            else:
                row_heights.append(0)
    
        # ---- 更新所有视频的叠加位置 ----
        y_offset = 0
        for row_idx, row in enumerate(row_groups):
            x_offset = 0
            row_h = row_heights[row_idx]
            for w, h, t in row:
                if t != main_track:
                    t.enc_settings['overlay_x'] = str(x_offset)
                    t.enc_settings['overlay_y'] = str(y_offset)
                    t.overlay_x = str(x_offset)
                    t.overlay_y = str(y_offset)
                x_offset += w
            y_offset += row_h
    
        # ---- 刷新界面 ----
        self.merge_refresh_ui()
        direction_str = _("横向") if horizontal_priority else _("纵向")
        self._append_info_ui(_('✅ 智能平铺完成（{0}优先）：画布 {1}x{2}，总视频 {3} 个').format(direction_str, canvas_w, canvas_h, n))
        messagebox.showinfo(_("成功"), _('智能平铺完成\n方向: {0}优先\n画布: {1}×{2}\n总视频数: {3}').format(direction_str, canvas_w, canvas_h, n))
    

    def merge_smart_tile_inside(self, main_track_idx, filt_frame=None):
        """主视频内平铺：主视频铺底不动（不新增 pad 画布），子视频在主视频画布内
        规则网格平铺（保持各自比例缩放到格子内、格子内居中）。放不下时提示数量过多，
        保持原状不修改任何设置，让用户调小缩放后重试。"""
        if alert_if(main_track_idx is None or main_track_idx >= len(self.merge_tracks), _("错误"), _("无效的主视频轨道索引"), 'error'):
            return
        main_track = self.merge_tracks[main_track_idx]
        if alert_if(main_track.type != "video", _("错误"), _("选中的不是视频轨道"), 'error'):
            return
        sub_tracks = [t for t in self.merge_tracks if t.type == "video" and t.enabled and t != main_track]
        if alert_if(not sub_tracks, _("提示"), _("没有可用于平铺的子视频（至少需要一个子视频）"), 'info'):
            return

        # ---- 主视频渲染尺寸（优先从 filt_frame 读实时值，与 merge_smart_tile 一致） ----
        if filt_frame is not None:
            main_settings = {
                "crop_enabled": filt_frame.crop_enabled.get(),
                "crop_width": filt_frame.crop_width.get(),
                "crop_height": filt_frame.crop_height.get(),
                "scale_enabled": filt_frame.scale_enabled.get(),
                "scale_method": filt_frame.scale_method.get(),
                "scale_width": filt_frame.scale_width.get(),
                "scale_height": filt_frame.scale_height.get(),
                "rotate": filt_frame.rotate.get()
            }
            orig_w, orig_h = self._cached_video_dimensions(main_track.file_path)
            if orig_w is None or orig_h is None:
                orig_w, orig_h = 1280, 720
            main_w, main_h = self.compute_final_size_with_order(orig_w, orig_h, main_settings)
        else:
            main_w, main_h = self._get_video_render_size(main_track)
            if main_w is None or main_h is None:
                main_w, main_h = 1280, 720
        if alert_if(main_w <= 0 or main_h <= 0, _("错误"), _("主视频尺寸无效"), 'error'):
            return

        # ---- 子视频渲染尺寸（已含各自缩放/裁剪） ----
        subs = []
        for t in sub_tracks:
            w, h = self._get_video_render_size(t)
            if w is None or h is None:
                ow, oh = self._cached_video_dimensions(t.file_path)
                if ow and oh:
                    w, h = compute_rendered_size(ow, oh, t.enc_settings)
                else:
                    w, h = 320, 240
            subs.append((max(w, 1), max(h, 1), t))
        n = len(subs)

        # ---- 统一尺寸：所有子视频缩放到同一个尺寸（第一个子视频的渲染尺寸）----
        # 不做逐子视频自适应 fit——大家都一样大，按统一网格排布。
        u_w, u_h = subs[0][0], subs[0][1]
        margin = 10          # 格子间距

        # ---- 网格容量：按统一尺寸在画布内能排几列几行 ----
        cols = max(1, (main_w + margin) // (u_w + margin))
        rows = max(1, (main_h + margin) // (u_h + margin))
        cap = cols * rows

        # ---- 先计算完整布局：有超过画布的才提示，超出的子视频自然抛弃（不应用位置）----
        overflow = n - cap
        apply_n = n if overflow <= 0 else cap
        if overflow > 0:
            warn_msg = (_('子视频数量 {0} 超过主视频内可容纳的 {1} 个（{2}x{3} 网格，统一尺寸 {4}x{5}），已忽略 {6} 个（保持原状）。\n请调小统一尺寸（缩小第一个子视频）或减少数量后重试。').format(n, cap, cols, rows, u_w, u_h, overflow))
        else:
            warn_msg = ""

        # ---- 应用：前 apply_n 个按统一尺寸 + 统一网格位置 ----
        for idx in range(apply_n):
            _w, _h, t = subs[idx]
            r, c = divmod(idx, cols)
            x = margin + c * (u_w + margin)
            y = margin + r * (u_h + margin)
            t.enc_settings['overlay_enabled'] = True
            t.overlay_enabled = True
            t.enc_settings['overlay_x'] = str(x)
            t.enc_settings['overlay_y'] = str(y)
            t.overlay_x = str(x)
            t.overlay_y = str(y)
            t.enc_settings['scale_enabled'] = True
            t.enc_settings['scale_width'] = str(u_w)
            t.enc_settings['scale_height'] = ''
            t.enc_settings['scale_method'] = 'width'

        self.merge_refresh_ui()
        if warn_msg:
            self._append_info_ui("⚠️ " + warn_msg)
            messagebox.showwarning(_("提示"), warn_msg)
        else:
            self._append_info_ui(_('✅ 主视频内平铺完成：{0}x{1} 网格，{2} 个子视频（统一尺寸 {3}x{4}，主视频 {5}x{6} 内）').format(cols, rows, n, u_w, u_h, main_w, main_h))
            messagebox.showinfo(_("成功"), _('主视频内平铺完成\n网格: {0}×{1}\n子视频: {2} 个\n统一尺寸: {3}×{4}\n（主视频铺底不动，未新增画布）').format(cols, rows, n, u_w, u_h))


    def save_merge_project(self):
        """手动保存合并项目到 .fflgproject 文件。

        返回值（2026-09-16 修复「保存取消仍误报发送成功」）：
          True  = 已成功写入项目文件
          False = 用户取消（未选路径）或写入失败
        调用方据此决定是否提示「发送成功 / 已保存」。
        """
        file_path = filedialog.asksaveasfilename(
            title=_("保存合并项目"),
            defaultextension=".fflgproject",
            filetypes=[(_("fflgproject 项目文件"), "*.fflgproject"), (_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")]
        )
        if not file_path:
            return False            # 用户取消保存
        
        # 构造状态字典（复用之前的序列化逻辑）
        state = self._build_merge_state_dict()
        
        try:
            with open(file_path, 'w', encoding='utf-8') as f:
                json.dump(state, f, indent=2, ensure_ascii=False)
            self._append_info_ui(_("✅ 项目已保存到: {0}").format(os.path.basename(file_path)))
            return True             # 保存成功
        except Exception as e:
            self._append_info_ui(_("❌ 保存项目失败: {0}").format(e))
            messagebox.showerror(_("保存失败"), str(e))
            return False            # 保存失败
    
    def _build_merge_state_dict(self):
        state = {
            "version": "1.0",
            "merge_video": self.merge_video.get(),
            "merge_output": self.merge_output.get(),
            "merge_container": self.merge_container.get(),
            "merge_output_suffix": self.merge_output_suffix.get(),
            "merge_custom_name": self.merge_custom_name.get(),
            "merge_output_dir": self.merge_output_dir.get(),

            "pip_enabled": self.pip_enabled.get(),
            "concat_enabled": self.concat_enabled.get(),
            "concat_norm_global": self._concat_norm_global_on(),
            "oneclick_fade_duration": self.oneclick_fade_duration.get(),
            "oneclick_image_duration": self.oneclick_image_duration.get(),
            # 页面级参数（2026-10-13 补齐）：本方法是**手写枚举**，新加「页面级变量」
            # （不像轨道参数住在 enc_settings 里）没人提醒 ⇒ 天然会漏。加变量时记得回头补这里。
            "oneclick_loop_count": self.oneclick_loop_count.get(),
            "oneclick_transition_duration": self.oneclick_transition_duration.get(),
            "merge_skip_probe": self.merge_skip_probe.get(),
            "merge_only_audio": self.merge_only_audio.get(),
            "merge_manual_duration_enabled": self.merge_manual_duration_enabled.get(),
            "merge_manual_duration": self.merge_manual_duration.get(),
            "copy_chapters": self.copy_chapters.get(),
            "chapter_file": self.chapter_file.get(),
            "generate_chapters": self.generate_chapters.get(),
            "merge_verify": self.merge_verify.get(),
            "merge_delete_source": self.merge_delete_source.get(),
            "end_handling": dict(self._merge_end_handling),
            # 封装页独立文字水印（2026-08-26）；主轨 enc_settings 里那份是
            # _apply_merge_text_watermark 运行时写入的，不落盘
            "text_watermark": dict(self._merge_tw.get("text_watermark") or {}),
            "text_watermark_items": copy.deepcopy(self._merge_tw.get("text_watermark_items") or []),
            # 挂在处理链节点上的效果（2026-09-26「视频节点」）。
            # ⚠️ 逐个自查可序列化：混进 Tk 变量/非 JSON 类型时只丢这一个节点效果，
            # 绝不能让整个「保存项目」失败（保存失败比丢失一个效果严重得多）。
            "node_fx": _jsonable_node_fx(self),
            "node_audio_fx": _jsonable_node_audio_fx(self),
            "tracks": []
        }
        for track in self.merge_tracks:
            if track.enc_settings.get("_placeholder", False):
                continue
            enc_settings_copy = track.enc_settings.copy()
            enc_settings_copy.pop("_file_path", None)  # 移除临时字段
            enc_settings_copy.pop("text_watermark", None)       # 封装页文字水印统一存 state 级
            enc_settings_copy.pop("text_watermark_items", None)
            track_dict = {
                "type": track.type,
                "source": track.source,
                "codec": track.codec,
                "file_path": track.file_path,
                "index": track.index,
                "enabled": track.enabled,
                "language": track.language,
                "title": track.title,
                "enc_settings": enc_settings_copy
            }
            state["tracks"].append(track_dict)
        return state

    def load_merge_project(self):
        """从 .fflgproject 文件加载合并项目"""
        # ⚠️ 撤销快照：先拍下加载前的整页状态（任何对话框之前），供右上「↶ 撤销」还原
        _undo_snap = self._build_merge_state_dict()
        # 如果有未保存的更改，提示是否保存当前项目
        if self.merge_tracks and messagebox.askyesno(_("未保存的项目"), _("当前有轨道，是否先保存当前项目？\n（选“是”保存，选“否”直接加载新项目）")):
            self.save_merge_project()
            # 用户可能取消保存，但继续加载，没问题
        
        file_path = filedialog.askopenfilename(
            title=_("加载合并项目"),
            filetypes=[(_("fflgproject 项目文件"), "*.fflgproject"), (_("JSON 文件"), "*.json"), (_("所有文件"), "*.*")]
        )
        if not file_path:
            return
        
        # 🩹 2026-10-14：改走 read_json_file_guarded。旧写法 `json.load(f)` 会把**整个
        # 文件**读进内存再解码 ⇒ 手滑把视频路径粘到这里就是读几百 MB ~ 几 GB（实测
        # 720MB mp4 = 5.894 秒）⇒ 像卡死、只能结束进程。现在最多读 32 MB，
        # 且非文本文件立刻给明确说明。
        state, _err = read_json_file_guarded(file_path)
        if _err:
            self._append_info_ui(_("❌ 读取项目文件失败: %s") % _err)
            messagebox.showerror(_("读取失败"), _err)
            return

        # 转换页项目互斥识别（2026-09-06）：带 convert 标记的是转换页项目，
        # 旧版封装页项目没有此键，照常加载（向后兼容）
        if alert_if(isinstance(state, dict) and state.get("project_type") == "convert", _("无法加载"), _("这是转换页面的项目文件（含转换页标识），\n" "请在转换页「参数预设」区用「导入项目」打开。")):
            return

        # 恢复状态
        self._restore_merge_state_dict(state)
        _after_snap = self._build_merge_state_dict()
        self._push_history("merge", _("加载项目"),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_undo_snap)),
                           lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))
        self._append_info_ui(_('✅ 项目已加载: {0}').format(os.path.basename(file_path)))

    def _restore_merge_state_dict(self, state):
        # 项目文件来自磁盘，可能被手改/截断 ⇒ 顶层非对象直接拒绝，别把整个加载打成异常
        if not isinstance(state, dict):
            self._append_info_ui(_("❌ 项目文件格式无效（顶层不是对象），已取消加载"))
            return
        self._suppress_main_video_trace = True
        self._batch_update = True          # 抑制所有中间刷新
        try:
            # 恢复基本设置（先恢复 merge_video 和 merge_output）
            self.merge_video.set(state.get("merge_video", ""))
            # 输出三字段（2026-08-26 新格式）：后缀默认 _merged 保持旧自动名
            self.merge_output_suffix.set(state.get("merge_output_suffix", "_merged"))
            self.merge_custom_name.set(state.get("merge_custom_name", ""))
            self.merge_output_dir.set(state.get("merge_output_dir", ""))
            _has_new_out_fields = any(k in state for k in
                                      ("merge_output_suffix", "merge_custom_name", "merge_output_dir"))
            if _has_new_out_fields:
                # 新格式：merge_output 是派生值，由字段 + 主视频名重算（末尾统一刷新）
                self.merge_output.set("")
            else:
                # 旧格式：直接用保存的完整输出路径（用户曾自定义过目录/名字）
                self.merge_output.set(state.get("merge_output", ""))
            self.merge_container.set(state.get("merge_container", "mkv"))
            self.pip_enabled.set(state.get("pip_enabled", False))
            self.concat_enabled.set(state.get("concat_enabled", False))
            if hasattr(self, "concat_norm_global"):
                self.concat_norm_global.set(state.get("concat_norm_global", False))
            self.oneclick_fade_duration.set(state.get("oneclick_fade_duration", "1.0"))
            self.oneclick_image_duration.set(state.get("oneclick_image_duration", "10"))
            # 页面级参数（2026-10-13 补齐；默认值 == 控件初值，见 _build 处注释）
            # ⚠️ oneclick_transition_duration 是 Entry 的 textvariable ⇒ set 即同步到输入框
            self.oneclick_loop_count.set(state.get("oneclick_loop_count", "1"))
            self.oneclick_transition_duration.set(state.get("oneclick_transition_duration", "1.0"))
            self.merge_skip_probe.set(state.get("merge_skip_probe", False))
            self.merge_only_audio.set(state.get("merge_only_audio", False))
            self.merge_manual_duration_enabled.set(state.get("merge_manual_duration_enabled", False))
            self.merge_manual_duration.set(state.get("merge_manual_duration", ""))
            self.copy_chapters.set(state.get("copy_chapters", True))
            self.chapter_file.set(state.get("chapter_file", ""))
            self.generate_chapters.set(state.get("generate_chapters", False))
            self.merge_verify.set(state.get("merge_verify", True))
            self.merge_delete_source.set(state.get("merge_delete_source", False))
            # 末端处理设置（缺失时保持默认）
            _eh = state.get("end_handling")
            if isinstance(_eh, dict):
                for _k, _v in _eh.items():
                    if _k in self._merge_end_handling:
                        self._merge_end_handling[_k] = _v

            # 封装页独立文字水印（缺失时保持当前默认）
            _twm = state.get("text_watermark")
            if isinstance(_twm, dict):
                self._merge_tw["text_watermark"] = dict(_twm)
            _twmi = state.get("text_watermark_items")
            if isinstance(_twmi, list):
                self._merge_tw["text_watermark_items"] = [dict(i) for i in _twmi]

            # 节点效果（2026-09-26）。缺失时**清空**而不是保留 —— 否则载入新项目后
            # 上一个项目的节点效果还挂在实例上，会按指纹插进新项目的图里。
            self.node_fx = _node_fx_map_from_state(state.get("node_fx"))
            if self.node_fx:
                self._append_info_ui(
                    _('[节点效果] 已载入 {0} 个；链的结构没变就会自动插回，变了会跳过并提示重选（视频节点里可查看/清除）').format(len(self.node_fx)))

            # 音频节点效果（2026-09-26）：与 node_fx 同口径，缺失时清空。
            self.node_audio_fx = _node_fx_map_from_state(state.get("node_audio_fx"))
            if self.node_audio_fx:
                self._append_info_ui(
                    _('[音频节点] 已载入 {0} 个；链的结构没变就会自动插回，变了会跳过并提示重选（音频节点里可查看/清除）').format(len(self.node_audio_fx)))
    
            # 恢复轨道（⚠️ 项目文件可能被手改/截断 ⇒ 一律 .get，缺 enc_settings 只跳过该条，
            # 不让一条坏记录把整个加载打成 KeyError 半加载；转换页那侧同理全程 .get）
            self.merge_tracks = []
            _skipped_tracks = 0
            _tracks_raw = state.get("tracks")
            for track_dict in (_tracks_raw if isinstance(_tracks_raw, list) else []):
                if not isinstance(track_dict, dict):
                    _skipped_tracks += 1
                    continue
                _enc = track_dict.get("enc_settings")
                if not isinstance(_enc, dict):
                    _skipped_tracks += 1
                    continue
                _fp = track_dict.get("file_path", "")
                track = Track(
                    track_dict.get("index", 0),
                    track_dict.get("type", "video"),
                    track_dict.get("codec", ""),
                    _fp,
                    track_dict.get("enabled", True),
                    copy.deepcopy(_enc)
                )
                track.file_path = _fp
                track.language = track_dict.get("language", "")
                track.title = track_dict.get("title", "")
                track.source = track_dict.get("source",
                                              _virtual_source_kind(track.file_path) or "file")
                if track.type == "video":
                    track.overlay_enabled = track.enc_settings.get("overlay_enabled", True)
                    track.overlay_x = track.enc_settings.get("overlay_x", DEFAULT_OVERLAY_X)
                    track.overlay_y = track.enc_settings.get("overlay_y", DEFAULT_OVERLAY_Y)
                    track.pad_enabled = track.enc_settings.get("pad_enabled", False)
                    track.pad_width = track.enc_settings.get("pad_width", "")
                    track.pad_height = track.enc_settings.get("pad_height", "")
                    track.offset_x = track.enc_settings.get("offset_x", "0")
                    track.offset_y = track.enc_settings.get("offset_y", "0")
                self.merge_tracks.append(track)
            if _skipped_tracks:
                self._append_info_ui(_('[项目] 已跳过 {0} 条无效或缺少 enc_settings 的轨道记录').format(_skipped_tracks))
    
        finally:
            self._suppress_main_video_trace = False
            self._batch_update = False
    
        if self.pip_enabled.get():
            # 项目是以【画中画】保存的 → 等同「切进画中画」，一次性补齐从未启用叠加的子视频。
            # ⚠️ 必须放在轨道恢复之后：上方 self.pip_enabled.set（L36685）触发的 _on_pip_toggle
            # 此刻 merge_tracks 还是空的，迁移跑了个寂寞（老项目加载后子视频仍然不显示）。
            self._migrate_sub_overlay_enabled_on_pip()

        # 「禁用解析」复选框的可用性依赖串行模式 ⇒ 轨道恢复后按当前 concat_enabled 重算一次
        # （set 阶段在 _batch_update 抑制区内，trace 不一定跑到这里）
        self._refresh_skip_probe_state()

        # 手动刷新（新格式项目：重算派生输出路径，内部带出命令预览；
        # 旧格式项目 merge_output 已恢复为保存的完整路径，不可覆盖）
        self.merge_update_track_list()
        if _has_new_out_fields:
            self.merge_update_output_preview()
        else:
            self.merge_update_command_preview()

    def merge_sort_tracks(self, key_func):
        """按文件分组排序轨道（同一文件的所有轨道保持在一起）"""
        if not self.merge_tracks:
            self._append_info_ui(_("[排序] 轨道列表为空，无需排序"))
            return
        # ⚠️ 撤销快照：排序会重排整条轨道列表，改前拍、改后登记
        _undo_snap = self._build_merge_state_dict()

        # 按文件路径分组
        file_groups = {}
        for track in self.merge_tracks:
            file_path = track.file_path
            if file_path not in file_groups:
                file_groups[file_path] = []
            file_groups[file_path].append(track)
    
        # 对文件排序
        sorted_files = sorted(file_groups.keys(), key=key_func)
    
        # 重建轨道列表
        new_tracks = []
        for f in sorted_files:
            new_tracks.extend(file_groups[f])
    
        self.merge_tracks = new_tracks
        self.merge_refresh_ui()
        self._append_info_ui(_('[排序] 已按选择顺序重新排序，共 {0} 个轨道').format(len(self.merge_tracks)))
        _after_snap = self._build_merge_state_dict()
        if _undo_snap != _after_snap:
            self._push_history("merge", _("排序轨道"),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_undo_snap)),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))
    
    def merge_sort_by_filename(self):
        """按文件名自然排序（仅在串联模式下可用）"""
    
        def natural_key(text):
            parts = [p for p in re.split(r'(\d+)', text) if p]  # 过滤空字符串
            def convert(part):
                return int(part) if part.isdigit() else part.lower()
            return [convert(p) for p in parts]
    
        self.merge_sort_tracks(key_func=lambda p: natural_key(os.path.basename(p)))
    
    def merge_sort_by_mtime(self):
        """按修改时间排序（仅在串联模式下可用）"""
        def get_mtime(p):
            try:
                return os.path.getmtime(p)
            except OSError:
                return 0
        self.merge_sort_tracks(key_func=get_mtime)


    def _migrate_sub_overlay_enabled_on_pip(self):
        """切到画中画时，把「未启用叠加」的子视频位一次性补成启用（只补一次，之后不干预）。

        背景（2026-09-24 用户拍板）：串联（拼接）模式添加图片/视频的入口不设
        overlay_enabled（Track 里该键曾默认 False）→ 这些轨道切到画中画后成片里整条消失：
        正式命令 _build_overlay_filter_complex（L26707）严格读此键，为假就走 L26882 的
        else → [v_temp_N]nullsink，输出只剩主视频；而预览此前不读该键 →「预览有、成片没有」。
        用户实测工程（F:/Temp/抖音工具/k绿幕/张玉琼.fflgproject）里两条子图轨道就是 False。

        ⚠️ 只在【勾选「启用画中画」的那一刻】补一次，且只补当前为假的；之后用户怎么勾
        都不再干预（用户明确要求：后续不再检查）。主视频（第一个视频轨道）不参与。
        """
        video_tracks = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        if len(video_tracks) < 2:
            return
        fixed = []
        for i, t in enumerate(video_tracks):
            if i == 0:
                continue      # 第一个视频轨道 = 主视频（画中画的底），不叠加
            if t.enc_settings.get("overlay_enabled", True):
                continue
            t.enc_settings["overlay_enabled"] = True
            t.overlay_enabled = True
            fixed.append(os.path.basename(t.file_path))
        if fixed:
            self._append_info_ui(
                _("[画中画] 已自动勾选 %d 个子视频的「启用叠加」（原本是关的，成片里不会显示）：%s。\n"
                "  如需隐藏其中某条，到该轨道的「视频轨道设置」里取消勾选即可（之后不再自动改）。")
                % (len(fixed), _("、").join(fixed)))

    def _on_pip_toggle(self, *args):
        if self.pip_enabled.get() and self.concat_enabled.get():
            self.concat_enabled.set(False)
        if self.pip_enabled.get():
            # 切进画中画：一次性补齐「从未启用叠加」的子视频（见 _migrate_sub_overlay_enabled_on_pip）
            self._migrate_sub_overlay_enabled_on_pip()
        # 当画中画被禁用时（切回普通模式），重置水印提示
        if not self.pip_enabled.get():
            self._trim_precise_hint_shown = False
        self.merge_update_command_preview()
        self.merge_update_track_list()

    def _on_concat_toggle(self, *args):
        if self.concat_enabled.get() and self.pip_enabled.get():
            self.pip_enabled.set(False)
        if not self.concat_enabled.get():
            self._trim_precise_hint_shown = False
        # 控制"生成章节"复选框状态
        if hasattr(self, '_gen_chapters_cb'):
            state = 'normal' if self.concat_enabled.get() else 'disabled'
            self._gen_chapters_cb.config(state=state)
            if not self.concat_enabled.get():
                self.generate_chapters.set(False)
        self.merge_update_command_preview()
        self.merge_update_track_list()

    def _add_pip_video_forced(self, path, add_audio=True):
        """
        强制添加视频作为画中画（不弹出询问对话框）。
        - add_audio: 是否同时添加该文件的所有音频流
        """
        if os.path.isdir(path):
            self._append_info_ui(_("[封装] 忽略文件夹: {0}，请选择文件").format(os.path.basename(path)))
            return
        info = self._get_cached_stream_info(path)
        if not info:
            self._append_info_ui(_("[封装] 无法解析文件: {0}").format(path))
            return

    
        # 检测是否为图片
        img_exts = ('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')
        is_image = os.path.splitext(path)[1].lower() in img_exts
    
        if is_image:
            track = Track(0, "video", "image2", path, True)
            _apply_default_watermark_overlay(track)
            self.merge_tracks.append(track)
            self._append_info_ui(_("[封装] 已添加图片水印: {0}").format(os.path.basename(path)))
            return
    
        # 视频处理
        video_streams = [s for s in info["streams"] if s.get("codec_type") == "video"]
        if not video_streams:
            self._append_info_ui(_("[封装] 所选文件不包含视频流"))
            return
    
        # 添加视频轨道
        s = video_streams[0]
        track = Track(s["index"], "video", s.get("codec_name", "unknown"), path, True)
        _apply_default_watermark_overlay(track)
        self.merge_tracks.append(track)
        self._append_info_ui(_("[封装] 已添加画中画视频: {0}").format(os.path.basename(path)))
    
        # 添加音频（如果 add_audio 为 True）
        if add_audio:
            audio_streams = [s for s in info["streams"] if s.get("codec_type") == "audio"]
            for s_audio in audio_streams:
                audio_track = Track(s_audio["index"], "audio", s_audio.get("codec_name", "unknown"), path, True)
                self.merge_tracks.append(audio_track)
                self._append_info_ui(_("[封装] 已添加音频流: {0}").format(s_audio.get('codec_name', 'unknown')))
    
    
    def _add_concat_video_forced(self, path):
        """
        强制添加视频作为串联片段（不弹出询问对话框，自动添加所有音频和字幕流）
        """
        if os.path.isdir(path):
            self._append_info_ui(_('[封装] 忽略文件夹: {0}，请选择文件').format(os.path.basename(path)))
            return
        info = self._get_cached_stream_info(path)
        if not info:
            self._append_info_ui(_('[封装] 无法解析文件: {0}').format(path))
            return

        # 图片素材：作为串联的一段（2026-09-22 开放「添加外部视频(串联)」的图片选择后补，
        # 与拖拽路径同款 → codec 标 image2、无音轨）。裸 -i 图片只有 1 帧无法拼接，
        # 命令端会按「显示时长」烘焙成 `-loop 1 -framerate fps -t N -i 图` 的有限时长流。
        # ⚠️ 判定必须用 _MEDIA_IMAGE_EXTS（含 gif），不能用 _is_static_image /
        # _STATIC_IMAGE_EXTS（那是可视化抽帧口径，不含 gif）→ 否则 gif 会掉进视频分支，
        # 与拖拽添加同一文件的行为不一致（2026-09-22 审计修复）。
        if os.path.splitext(str(path))[1].lower() in _MEDIA_IMAGE_EXTS:
            self.merge_tracks.append(Track(0, "video", "image2", path, True))
            self._append_info_ui(_('[串联] 已添加图片素材: {0}（显示时长默认 10 秒，可在轨道编辑窗「截取片段」页改）').format(os.path.basename(path)))
            return

        # 添加所有视频流（通常只有一个）
        video_streams = [s for s in info["streams"] if s.get("codec_type") == "video"]
        for s in video_streams:
            track = Track(s["index"], "video", s.get("codec_name", "unknown"), path, True)
            # 串联模式不需要 overlay 属性
            self.merge_tracks.append(track)
            self._append_info_ui(_('[封装] 已添加串联视频流: {0}').format(os.path.basename(path)))
    
        # 添加所有音频流
        audio_streams = [s for s in info["streams"] if s.get("codec_type") == "audio"]
        for s_audio in audio_streams:
            audio_track = Track(s_audio["index"], "audio", s_audio.get("codec_name", "unknown"), path, True)
            self.merge_tracks.append(audio_track)
            self._append_info_ui(_('[封装] 已添加音频流: {0}').format(s_audio.get('codec_name', 'unknown')))
    
        # 添加所有字幕流
        subtitle_streams = [s for s in info["streams"] if s.get("codec_type") == "subtitle"]
        for s_sub in subtitle_streams:
            sub_track = Track(s_sub["index"], "subtitle", s_sub.get("codec_name", "unknown"), path, True)
            self.merge_tracks.append(sub_track)
            self._append_info_ui(_('[封装] 已添加字幕流: {0}').format(s_sub.get('codec_name', 'unknown')))

    def _expand_files_and_folders(self, file_paths):
        """
        将文件路径列表中的文件夹递归展开为所有文件路径。
        只返回文件，不返回文件夹本身。
        """
        expanded = []
        for item in file_paths:
            if os.path.isdir(item):
                # 递归遍历文件夹
                for root, dirs, files in os.walk(item):
                    for f in files:
                        expanded.append(normalize_path(os.path.join(root, f)))
            else:
                expanded.append(item)
        return expanded


    def _handle_drop_pip_mode(self, files):
        """
        画中画模式下的拖拽处理 —— 瞬间添加占位，后台解析，无卡顿。
        - 视频文件：先添加占位轨道，后台解析后替换为真实流。
        - 图片文件：直接添加为图片水印（无需解析，但为了统一也可占位）。
        - 音频文件：直接添加为独立音轨（无需解析）。
        """

        if not files:
            return
    
        # 展开文件夹
        all_files = self._expand_files_and_folders(files)
        if not all_files:
            self._append_info_ui(_("[封装] 拖拽内容中未找到任何文件"))
            return
    
        # 分类（不再判断 isdir，因为 all_files 已是文件列表）
        video_files = []
        audio_files = []
        image_files = []
        other_files = []
        video_exts = ('.mp4', '.mkv', '.avi', '.mov', '.flv', '.ts', '.webm')
        img_exts = ('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')
        audio_exts = ('.mp3', '.aac', '.m4a', '.wav', '.flac', '.ogg', '.opus', '.ac3', '.dts')
    
        for f in all_files:  # 注意：使用 all_files，而不是 files
            ext = os.path.splitext(f)[1].lower()
            if ext in video_exts:
                video_files.append(f)
            elif ext in img_exts:
                image_files.append(f)
            elif ext in audio_exts:
                audio_files.append(f)
            else:
                other_files.append(f)
    
        # ---- 立即添加占位轨道（仅对视频文件） ----
        original_batch = self._batch_update
        self._batch_update = False
        try:
            # 图片：先判断有无主视频——无主视频自动设该图片为主视频（不缩放不叠加），
            # 有主视频则作为子视频/图片水印（缩放叠加）
            _has_main = bool(self.merge_video.get().strip()) or any(t.type == "video" for t in self.merge_tracks)
            # 2026-09-14：本次拖拽前列表为空（无主视频、无任何视频轨道）→ 首个视频/图片会直接成为主视频；
            # 此时**不再**弹「添加音频」询问（对齐普通/串行模式：空列表加文件=直接设为主视频，音频随主视频加入）。
            _pip_auto_main = not _has_main
            for img in image_files:
                if not _has_main:
                    track = Track(0, "video", "image2", img, True)
                    self.merge_tracks.insert(0, track)   # 插最前，确保是第一个视频=主视频
                    _has_main = True   # 后续图片作为子视频
                    self._append_info_ui(_('[封装] 无主视频，已将图片设为主视频: {0}').format(os.path.basename(img)))
                else:
                    self._add_pip_video_forced(img, add_audio=False)
            # 音频直接添加
            for audio in audio_files:
                self.merge_add_external("audio", audio)
            # 视频：添加占位轨道
            for vf in video_files:
                track = Track(0, "video", "unknown", vf, True)
                track.enc_settings["_placeholder"] = True
                # 画中画默认启用叠加并缩放到320宽（与原有行为一致）
                _apply_default_watermark_overlay(track)
                self.merge_tracks.append(track)
            # 立即刷新列表
            self.merge_update_track_list()
            if video_files:
                self._append_info_ui(_('[封装] 已添加 {0} 个视频文件（正在后台解析…）').format(len(video_files)))
            if image_files:
                self._append_info_ui(_('[封装] 已添加 {0} 个图片水印').format(len(image_files)))
            if audio_files:
                self._append_info_ui(_('[封装] 已添加 {0} 个音频轨道').format(len(audio_files)))
            if other_files:
                self._append_info_ui(_('[拖拽] 忽略不支持的文件类型: {0}').format(', '.join((os.path.basename(f) for f in other_files))))
        finally:
            self._batch_update = original_batch
    
        # 自动确保主视频已设置：第一个视频/图片设为主视频并禁用其缩放
        # （拖拽路径之前缺这步——图片被 _apply_default_watermark_overlay 缩放 320 后直接当主视频）
        with suppress(Exception):
            self._ensure_main_video(disable_scale=True)
    
        # ---- 如果有视频文件，启动后台解析 ----
        if video_files:
            # 询问是否添加音频（仅一次）
            if _pip_auto_main:
                # 2026-09-14：空列表首次拖入 → 文件直接作为主视频，**不询问**（对齐普通/串行模式）。
                # 音频随主视频一并加入（与普通模式"设为主视频"后自动带出音频一致）。
                add_audio = True
                self._append_info_ui(_("[封装] 空列表：已将首个视频直接设为主视频（不再询问音频）"))
            elif len(video_files) > 1:
                add_audio = messagebox.askyesno(
                    _("添加音频"),
                    _('是否同时添加这 {0} 个视频文件的音频流？\n选“是”将添加所有音频流，选“否”仅添加视频作为水印。').format(len(video_files))
                )
            else:
                add_audio = messagebox.askyesno(
                    _("添加音频"),
                    _('是否同时添加文件「{0}」的音频流？\n选“是”将添加音频，选“否”仅添加视频作为水印。').format(os.path.basename(video_files[0]))
                )
    
            def parse_and_add():
                try:
                    self._parse_files_concurrently(video_files, description=_("画中画视频文件"))
                    self.root.after(0, lambda: self._finish_drop_pip(video_files, add_audio))
                except Exception as e:
                    self.root.after(0, lambda e=e: self._append_info_ui(_('[封装] 解析异常: {0}').format(e)))
    
            threading.Thread(target=parse_and_add, daemon=True).start()
        else:
            # 纯图片素材（画中画模式：首个图片已自动设为主视频）：无后台解析步骤，
            # 但必须像普通/串行模式那样刷新【输出路径 + 命令预览】——否则 merge_output 为空，
            # merge_build_cmd_list 直接返回 []，命令区显示「参数不完整，无法生成命令」，
            # 且切换模式也救不回来（输出空是三种模式的公共前提）。
            # （用户 2026-09-19 反馈：画中画拖图片作主视频后，任何模式都报参数不足。）
            try:
                self.merge_auto_recommend_container()
                self.merge_update_output_preview()
            except Exception as e:
                self._append_info_ui(_('[封装] 刷新输出路径失败: {0}').format(e))
            self.merge_update_command_preview()
    
    def _finish_drop_pip(self, video_files, add_audio):
        """
        画中画模式后台解析完成后的回调：删除视频占位轨道，添加真实视频流，并根据 add_audio 添加音频。
        允许重复添加（不去重）。
        """
        self._batch_update = True
        try:
            # 1. 删除本次添加的视频占位轨道（使用规范化路径比较）
            normalized_video_files = [normalize_path(f) for f in video_files]
            to_remove = []
            for idx, track in enumerate(self.merge_tracks):
                if (normalize_path(track.file_path) in normalized_video_files and 
                    track.enc_settings.get("_placeholder", False)):
                    to_remove.append(idx)
            for idx in reversed(to_remove):
                del self.merge_tracks[idx]
    
            # 2. 添加真实视频流和（可选）音频流（不去重）
            for vf in video_files:
                info = self._get_cached_stream_info(vf)
                if not info:
                    # 解析失败：添加错误标记轨道
                    error_track = Track(0, "video", "error", vf, True)
                    error_track.enc_settings["_error"] = _("解析失败")
                    self.merge_tracks.append(error_track)
                    self._append_info_ui(_("[封装] 文件 {0} 解析失败，已标记为错误").format(os.path.basename(vf)))
                    continue
    
                # 添加视频流（取第一个视频流）
                video_streams = [s for s in info['streams'] if s.get('codec_type') == 'video']
                if video_streams:
                    s = video_streams[0]
                    track = Track(s['index'], "video", s.get('codec_name', 'unknown'), vf, True)
                    # 保留画中画默认设置
                    _apply_default_watermark_overlay(track)
                    # 直接添加，不再检查重复
                    self.merge_tracks.append(track)
                    self._append_info_ui(_("[封装] 已解析并添加画中画视频: {0}").format(os.path.basename(vf)))
                else:
                    self._append_info_ui(_("[封装] {0} 不包含视频流，跳过").format(os.path.basename(vf)))
    
                # 如果需要添加音频（不去重）
                if add_audio:
                    audio_streams = [s for s in info['streams'] if s.get('codec_type') == 'audio']
                    for s_audio in audio_streams:
                        audio_track = Track(s_audio['index'], "audio", s_audio.get('codec_name', 'unknown'), vf, True)
                        self.merge_tracks.append(audio_track)
                        self._append_info_ui(_("[封装] 已添加音频流: {0}").format(s_audio.get('codec_name', 'unknown')))
    
        finally:
            self._batch_update = False
            self.merge_update_track_list()
            self.merge_auto_recommend_container()
            self._ensure_main_video(disable_scale=True)
            self.merge_update_output_preview()
            self.merge_update_command_preview()
            self._append_info_ui(_("[封装] 画中画文件解析完成，轨道列表已更新"))
            

    
    def _handle_drop_concat_mode(self, files):
        """
        串行合并模式拖拽 —— 瞬间添加占位，后台解析，无卡顿。
        """
        if not files:
            return
    
        all_files = self._expand_files_and_folders(files)
        if not all_files:
            self._append_info_ui(_("[封装] 拖拽内容中未找到任何文件"))
            return
    
        # 分类（使用 all_files）
        video_exts = ('.mp4', '.mkv', '.avi', '.mov', '.flv', '.ts', '.webm')
        img_exts = ('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')
        audio_exts = ('.mp3', '.aac', '.m4a', '.wav', '.flac', '.ogg', '.opus', '.ac3', '.dts')
        subtitle_exts = ('.srt', '.ass', '.ssa', '.vtt', '.idx', '.sup')
    
        video_files = []
        image_files = []
        other_files = []
        for f in all_files:
            ext = os.path.splitext(f)[1].lower()
            if ext in video_exts:
                video_files.append(f)
            elif ext in img_exts:
                image_files.append(f)   # 图片：直接作为串行段（无需后台解析）
            else:
                other_files.append(f)  # 音频/字幕稍后处理
    
        if not video_files and not image_files:
            self._append_info_ui(_("[封装] 未检测到视频或图片文件"))
            return
    
        # ---- 立即添加图片轨道（图片作为串行段，与画中画一样接纳图片素材） ----
        if image_files:
            _orig_batch_img = self._batch_update
            self._batch_update = False
            try:
                _has_main = bool(self.merge_video.get().strip()) or any(
                    t.type == "video" for t in self.merge_tracks)
                for img in image_files:
                    _img_trk = Track(0, "video", "image2", img, True)
                    if not _has_main:
                        self.merge_tracks.insert(0, _img_trk)   # 首个图片=主视频
                        _has_main = True
                        self._append_info_ui(_('[串联] 无主视频，已将图片设为主视频: {0}').format(os.path.basename(img)))
                    else:
                        self.merge_tracks.append(_img_trk)
                self.merge_update_track_list()
                self._append_info_ui(_('[串联] 已添加 {0} 个图片素材').format(len(image_files)))
            finally:
                self._batch_update = _orig_batch_img
            self._ensure_main_video()
            self.merge_auto_recommend_container()
            self.merge_update_output_preview()

        if not video_files:
            # 纯图片素材：无需后台解析，刷新命令预览后直接收尾
            self.merge_update_command_preview()
            return

        # ========== 禁用解析快路径（2026-10-07）==========
        # 用户场景：已知这批文件同规格、出自同一个 m3u8 → 不需要 ffprobe，
        # 直接按路径建轨道，concat txt 立刻可生成（几百个文件瞬间完成）。
        # ⚠️ 两个关键点，缺一不可：
        #   1) 轨道**不带** `_placeholder` —— 否则 merge_build_cmd_list(L51296) 直接
        #      return []、merge_update_command_preview(L51560) 只显示「正在解析…」，
        #      命令根本出不来；
        #   2) 打 `_no_probe` 标记 —— 列表规格列据此跳过尺寸/时长探测，
        #      _check_video_params_consistent 据此直接放行。
        if self._merge_probe_skipped():
            _orig_batch_sp = self._batch_update
            self._batch_update = False
            try:
                for vf in video_files:
                    _sp_track = Track(0, "video", "unknown", vf, True)
                    _sp_track.enc_settings["_no_probe"] = True
                    self.merge_tracks.append(_sp_track)
                self.merge_update_track_list()
                self._append_info_ui(
                    _('[串联] 已禁用解析：直接添加 {0} 个视频文件（未探测，按同规格流复制拼接）').format(len(video_files)))
            finally:
                self._batch_update = _orig_batch_sp
            self._ensure_main_video()
            self.merge_auto_recommend_container()
            # 含 merge_update_command_preview（内部会调 merge_build_cmd_list(preview=True)）
            self.merge_update_output_preview()
            self._append_info_ui(_("[串联] 禁用解析：concat 列表已就绪，命令可直接生成"))
            # 音频/字幕文件仍需真实 stream 信息才有意义 → 单独后台解析，
            # 复用 _finish_drop_concat（video_files 传空 → 逐条 video 循环空转、只处理 other_files）
            if other_files:
                def _parse_extras_only():
                    try:
                        self._parse_files_concurrently(other_files, description=_("音频/字幕文件"))
                        self.root.after(0, lambda: self._finish_drop_concat([], other_files))
                    except Exception as e:
                        self.root.after(0, lambda e=e: self._append_info_ui(_('[封装] 解析异常: {0}').format(e)))
                threading.Thread(target=_parse_extras_only, daemon=True).start()
            return

        # ========== 关键修改：强制立即刷新 ==========
        # 保存原有批处理标志，临时关闭以确保立即刷新
        original_batch = self._batch_update
        self._batch_update = False
        try:
            for vf in video_files:
                track = Track(0, "video", "unknown", vf, True)
                track.enc_settings["_placeholder"] = True
                self.merge_tracks.append(track)
            # 立即刷新列表（此时会显示“解析中…”）
            self.merge_update_track_list()
            self._append_info_ui(_('[封装] 已添加 {0} 个视频文件（正在后台解析…）').format(len(video_files)))
        finally:
            self._batch_update = original_batch
    
        # ========== 后台解析线程 ==========
        def parse_and_add():
            try:
                self._parse_files_concurrently(video_files, description=_("串联视频文件"))
                self.root.after(0, lambda: self._finish_drop_concat(video_files, other_files))
            except Exception as e:
                self.root.after(0, lambda e=e: self._append_info_ui(_('[封装] 解析异常: {0}').format(e)))
    
        threading.Thread(target=parse_and_add, daemon=True).start()
    
    
    def _finish_drop_concat(self, video_files, other_files):
        """
        串联模式后台解析完成后的回调：删除占位，添加真实流，处理错误。
        允许重复添加（不去重）。
        """
        audio_exts = ('.mp3', '.aac', '.m4a', '.wav', '.flac', '.ogg', '.opus', '.ac3', '.dts')
        subtitle_exts = ('.srt', '.ass', '.ssa', '.vtt', '.idx', '.sup')
    
        self._batch_update = True
        try:
            # 1. 删除占位轨道（使用规范化路径比较）
            normalized_video_files = [normalize_path(f) for f in video_files]
            to_remove = []
            for idx, track in enumerate(self.merge_tracks):
                if normalize_path(track.file_path) in normalized_video_files and track.enc_settings.get("_placeholder", False):
                    to_remove.append(idx)
            for idx in reversed(to_remove):
                del self.merge_tracks[idx]
    
            # 2. 添加真实流（视频、音频、字幕）（不去重）
            for vf in video_files:
                info = self._get_cached_stream_info(vf)
                if not info:
                    error_track = Track(0, "video", "error", vf, True)
                    error_track.enc_settings["_error"] = _("解析失败")
                    self.merge_tracks.append(error_track)
                    self._append_info_ui(_("[封装] 文件 {0} 解析失败，已标记为错误").format(os.path.basename(vf)))
                    continue
    
                streams = info.get('streams', [])
                for s in streams:
                    st = s.get('codec_type')
                    if st not in ('video', 'audio', 'subtitle'):
                        continue
                    track = Track(s['index'], st, s.get('codec_name', 'unknown'), vf, True)
                    self.merge_tracks.append(track)
                self._append_info_ui(_("[封装] 已解析并添加串联视频: {0}").format(os.path.basename(vf)))
    
            # 3. 处理其他文件（音频/字幕）（不去重）
            for f in other_files:
                ext = os.path.splitext(f)[1].lower()
                if ext in audio_exts:
                    self._add_external_streams_silent(f, "audio")
                elif ext in subtitle_exts:
                    self._add_external_streams_silent(f, "subtitle")
                else:
                    self._append_info_ui(_("[拖拽] 忽略不支持的文件: {0}").format(os.path.basename(f)))
    
        finally:
            self._batch_update = False
            self.merge_update_track_list()
            self.merge_auto_recommend_container()
            self._ensure_main_video()
            self.merge_update_output_preview()
            self.merge_update_command_preview()
            self._append_info_ui(_("[封装] 所有文件解析完成，轨道列表已更新"))
    
    
    def _add_external_streams_silent(self, file_path, stream_type):
        """
        静默添加外部音频/字幕流（不触发刷新），允许重复添加。
        """
        info = self._get_cached_stream_info(file_path)
        if not info:
            self._append_info_ui(_("[封装] 无法解析外部文件: {0}").format(os.path.basename(file_path)))
            return
        added = 0
        for s in info.get('streams', []):
            if s.get('codec_type') != stream_type:
                continue
            track = Track(s['index'], stream_type, s.get('codec_name', 'unknown'), file_path, True)
            self.merge_tracks.append(track)
            added += 1
        if added:
            self._append_info_ui(_("[封装] 已添加 {0} 条{1}轨道: {2}").format(added, stream_type, os.path.basename(file_path)))
        else:
            self._append_info_ui(_("[封装] 未添加新轨道: {0}").format(os.path.basename(file_path)))
    
    

    
    

    def merge_add_external_video(self):
        # ⚠️ 撤销快照：添加视频/图片轨道前拍整页状态，添加后登记
        #    （取消选择则前后一致，_undo_snap != _after_snap 守卫不入栈）
        _undo_snap = self._build_merge_state_dict()
        if self.concat_enabled.get():
            self._add_concat_video()
        elif self.pip_enabled.get():
            self._add_pip_video()
        else:
            messagebox.showinfo(_("提示"), _("请先勾选「串行合并」或「启用画中画」"))
            return
        _after_snap = self._build_merge_state_dict()
        if _undo_snap != _after_snap:
            self._push_history("merge", _("添加视频/图片"),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_undo_snap)),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))


    def _add_pip_video(self):
        path = filedialog.askopenfilename(
            title=_("选择视频或图片文件（画中画）"),
            filetypes=media_filetypes()
        )
        if not path:
            return


        info = ffprobe_json(self.ffprobe_cmd, path)
        if not info:
            self._append_info_ui(_('[封装] 无法解析文件: {0}').format(path))
            return
    
        # 检测是否为图片
        img_exts = ('.png', '.jpg', '.jpeg', '.bmp', '.gif', '.webp')
        is_image = os.path.splitext(path)[1].lower() in img_exts
    
        if is_image:
            # 图片直接添加（无音频）
            self._add_pip_video_forced(path, add_audio=False)
            self._append_info_ui(_('[封装] 已添加图片水印: {0}').format(os.path.basename(path)))
        else:
            # 视频：询问是否添加音频
            add_audio = messagebox.askyesno(
                _("添加音频"),
                _('是否同时添加文件「{0}」的音频流？\n选“是”将添加音频，选“否”仅添加视频作为水印。').format(os.path.basename(path))
            )
            self._add_pip_video_forced(path, add_audio=add_audio)
            self._append_info_ui(_('[封装] 已添加画中画视频: {0}').format(os.path.basename(path)))
    
        # 统一更新界面
        self.merge_update_track_list()
        self.merge_auto_recommend_container()
        self._ensure_main_video(disable_scale=True)
        self.merge_update_output_preview()

    
    def _add_concat_video(self):
        path = filedialog.askopenfilename(
            title=_("选择视频或图片文件（串联）"),
            # 图片也可作为串联的一段（命令端按「显示时长」把它烘焙成有限时长流后拼接），
            # 此前只列视频 → 图片选不到（2026-09-22 开放，与拖拽路径口径一致）。
            filetypes=media_filetypes()
        )
        if not path:
            return

        info = ffprobe_json(self.ffprobe_cmd, path)
        if not info:
            self._append_info_ui(_('[封装] 无法解析文件: {0}').format(path))
            return
    
        # 串联模式：直接添加所有流（不询问）
        # 判定与 _add_concat_video_forced / 拖拽同集合（_MEDIA_IMAGE_EXTS，含 gif），
        # 保证「图片/视频」回执文案与轨道构建口径一致（不用 _is_static_image：那是抽帧口径）。
        _is_img = os.path.splitext(str(path))[1].lower() in _MEDIA_IMAGE_EXTS
        self._add_concat_video_forced(path)
        self._append_info_ui(
            _('[封装] 已添加串联{0}: {1}').format(_('图片') if _is_img else _('视频'), os.path.basename(path)))
    
        # 统一更新界面
        self.merge_update_track_list()
        self.merge_auto_recommend_container()
        self._ensure_main_video()
        self.merge_update_output_preview()

    def browse_chapter_file(self):
        path = filedialog.askopenfilename(
            title=_("选择章节文件"),
            filetypes=[(_("章节文件"), "*.txt *.cue *.edl *.csv *.chapters *.ffmeta"),
                       ("FFmetadata", "*.txt *.chapters *.ffmeta"),
                       (_("所有文件"), "*.*")])
        if path:
            # 尝试解析（多格式）；成功则打开编辑器预览，失败则当作 FFmetadata 原样使用
            with suppress(Exception):
                if chapter_fmts is not None:
                    text = chapter_fmts.read_text_auto(path)
                    fmt = chapter_fmts.detect_format(text)
                    chs = chapter_fmts.parse_text(text, fmt)
                    if chs:
                        self._open_chapter_editor_with(chs, fmt)
                        return
            # 兜底：当作 FFmetadata 原样使用
            self.chapter_file.set(normalize_path(path))
            self.copy_chapters.set(False)

    def open_chapter_editor(self):
        """打开章节编辑器：若已有章节文件则先导入作为初始内容。"""
        if alert_if(not chapter_fmts, _("提示"), _("章节模块未加载（缺少 chapter_formats.py）"), 'info'):
            return
        initial = []
        cf_path = self.chapter_file.get().strip()
        if cf_path and os.path.exists(cf_path):
            try:
                text = chapter_fmts.read_text_auto(cf_path)
                fmt = chapter_fmts.detect_format(text)
                initial = chapter_fmts.parse_text(text, fmt)
            except Exception:
                initial = []
        # 串行模式：把轨道章节标签也带进去作为初始（可选增强）
        editor = ChapterEditor(self.root, initial, self)
        self.root.wait_window(editor.window)
        if editor.result is not None and editor.result is not initial:
            self._apply_chapters_result(editor.result)

    def _open_chapter_editor_with(self, chapters, fmt=None):
        editor = ChapterEditor(self.root, chapters, self)
        self.root.wait_window(editor.window)
        if editor.result is not None:
            self._apply_chapters_result(editor.result)

    def _apply_chapters_result(self, chapters):
        """把编辑器确认的章节列表写为 FFmetadata 临时文件并挂到 chapter_file。"""
        if not chapter_fmts or not chapters:
            return
        try:
            tmp_path = chapter_fmts.write_ffmetadata_temp(chapters)
        except Exception as e:
            messagebox.showerror(_("章节应用失败"), str(e))
            return
        # 清理旧临时文件
        old = self.chapter_file.get().strip()
        if old and hasattr(self, "_merge_temp_files") and old in self._merge_temp_files:
            try:
                if os.path.exists(old):
                    os.unlink(old)
                self._merge_temp_files.remove(old)
            except Exception:
                pass
        if not hasattr(self, "_merge_temp_files"):
            self._merge_temp_files = []
        self._merge_temp_files.append(tmp_path)
        self.chapter_file.set(normalize_path(tmp_path))
        self.copy_chapters.set(False)
        self._append_info_ui(_("[章节] 已应用 %d 个章节") % len(chapters))

    def merge_copy_command(self):
        cmd_str = self.merge_cmd_preview.get(1.0, tk.END).strip()
        if cmd_str:
            self.root.clipboard_clear()
            self.root.clipboard_append(cmd_str)
            self._append_info_ui(_("[封装] 命令已复制到剪贴板"))
        else:
            self._append_info_ui(_("[封装] 无命令可复制"))

    def _merge_current_cmd_argv(self):
        """按当前界面设置**重新生成**封装页命令，返回 `(argv, 命令串)`（内部直传用）。

        与 `_do_merge_update_command_preview` 的生成口径逐字一致（都走
        `merge_build_cmd_list(preview=True)`），但**不写回预览框** —— 刷新是编辑器自己的事，
        不该连带触发封装页那套 300ms 防抖重建。

        ⚠️ 与转码页 `_current_cmd_argv` 的差异：封装页**没有** `{input}/{output}` 占位；
        缺输出路径 / 缺启用轨道 / 有占位轨道时 `merge_build_cmd_list` 直接返回 `[]`
        ⇒ 这里给 `(None, "")`，由调用方提示（不静默拿旧串冒充新串）。
        """
        try:
            cmd_list = self.merge_build_cmd_list(preview=True)
            if not cmd_list:
                return None, ""
            return list(cmd_list), format_cmd_for_display(cmd_list)
        except Exception as e:
            self._append_info_ui(_("[命令编辑器] 重新生成封装命令失败: %s") % e)
            return None, ""

    def _merge_current_cmd_str(self):
        """刷新用的封装命令串包装（见 `_merge_current_cmd_argv`；返回 "" 表示生成失败）。"""
        _argv, s = self._merge_current_cmd_argv()
        return s

    def _open_merge_command_editor(self):
        """封装页「复制命令」右键 → 命令编辑器（树形铺平 + 编辑 + 内部运行 + 管道预览）。

        与转码页 `_open_command_editor` 共用同一个 `CommandTreeEditor`，只换数据源
        （`merge_cmd_preview`）。存在意义一样：复制出去要粘进 cmd.exe ⇒ **8191 字符**上限，
        内部 CreateProcess 上限 **32767**；封装页多轨道 + filter_complex 一上量最容易超。

        **内部直传**（2026-10-13）：同转码页 —— `merge_build_cmd_list` 的第一手 argv
        直接进编辑器，不走反解析。判据同样是「重新生成的串与预览框一字不差」。

        **预览口径**（2026-10-13 S1）：封装页不带设置快照（命令由多轨 enc_settings 合成，
        没有单一「当前设置」可言）⇒ 未编辑时预览直接调封装页自己的管道入口
        `_live_preview_pipe`（与界面右键「实时预览（简易时间引擎）」同一调用）；编辑后
        走文本取图兜底（`cmd_preview_target`，pipe_duration 仅串行合并才传）。
        串行命令本身不带 -t/输出 trim ⇒ 兜底路径再问页面要一次成片总时长
        （`dur_cb`，与预览同一来源 `_build_concat_video_graph`），否则引擎只能拿
        **主输入探测时长**（第一段）封顶 -t，多段合并被砍成一段。
        """
        cmd_str = self.merge_cmd_preview.get(1.0, tk.END).strip()
        # ⚠️ 预览框里可能是「参数不完整…」/「正在解析文件信息…」这类**状态文案**而非命令，
        #    直接喂给编辑器会被当成一行 token（程序名 = "参数不完整，无法生成命令"）。
        _bad = (not cmd_str
                or cmd_str.startswith(_("参数不完整"))
                or cmd_str.startswith(_("正在解析文件信息")))
        if alert_if(_bad, _("提示"),
                    _("当前还没有生成有效的封装命令（需要至少一个启用的轨道 + 输出路径）。\n"
                    "请在封装页配好轨道与输出后再打开命令编辑器。"), 'info'):
            return
        argv, fresh = self._merge_current_cmd_argv()
        direct = bool(argv) and fresh.strip() == cmd_str
        if not direct:
            argv = None      # 预览框与生成口径不一致 ⇒ 回退反解析（忠实于用户所见）
        with suppress(Exception):
            CommandTreeEditor(self.root, self, cmd_str,
                              source_title=_("封装页当前命令"),
                              refresh_cb=self._merge_current_cmd_argv,
                              argv=argv,
                              preview_core_cb=self._live_preview_pipe,
                              dur_cb=self._merge_last_total_dur,
                              page="merge")

    def _merge_last_total_dur(self):
        """串行合并最近一次建图/建命令得到的成片总时长（秒）；没有 ⇒ None。

        与三条预览入口同一来源（`_build_concat_video_graph` 的 total_dur），在
        `_build_concat_cmd`（每次生成/刷新命令）与 `merge_preview_concat_lavfi`
        （每次预览）两处刷新。命令编辑器的文本兜底预览用它封顶 -t / 定时间轴长度
        —— 串行命令本身不带时长信息，不给的话引擎回退用主输入探测时长（仅第一段）。
        非串行模式 / 从未构建过 ⇒ None，调用方按旧行为回退并明说。
        """
        try:
            v = getattr(self, "_last_merge_total_dur", None)
            return float(v) if v else None
        except (TypeError, ValueError):
            return None

    def _merge_copy_command_right_menu(self):
        """封装页「复制命令」右键菜单（与转码页共用 `_cmd_preview_right_menu`）。"""
        self._cmd_preview_right_menu(self.merge_copy_command,
                                     self._open_merge_command_editor)


    def _prepare_tracks_and_inputs(self, enabled_tracks):
        """准备输入文件、文件索引，并计算所有轨道的 _type_index"""
        input_files = []
        for t in enabled_tracks:
            if t.file_path not in input_files:
                input_files.append(t.file_path)

        file_index = {f: i for i, f in enumerate(input_files)}

        # 文件流映射 + 类型索引
        file_stream_map = {}
        for f in input_files:
            if _is_virtual_source(f):
                # 颜色/虚拟源：跳过 ffprobe，给出单视频流假数据
                file_stream_map[f] = {'video': [0], 'audio': [], 'subtitle': []}
                continue
            info = ffprobe_json(self.ffprobe_cmd, f)
            if info:
                streams = info.get('streams', [])
                video_indices = [s['index'] for s in streams if s.get('codec_type') == 'video']
                audio_indices = [s['index'] for s in streams if s.get('codec_type') == 'audio']
                subtitle_indices = [s['index'] for s in streams if s.get('codec_type') == 'subtitle']
                file_stream_map[f] = {
                    'video': video_indices,
                    'audio': audio_indices,
                    'subtitle': subtitle_indices,
                }
            else:
                file_stream_map[f] = {'video': [0], 'audio': [0], 'subtitle': [0]}

        def get_type_index(track):
            typ = track.type
            file_path = normalize_path(track.file_path)
            indices = file_stream_map.get(file_path, {}).get(typ, [])
            try:
                return indices.index(track.index)
            except ValueError:
                return 0

        for t in enabled_tracks:
            t._type_index = get_type_index(t)

        return input_files, file_index


    def _add_input_options(self, cmd, input_files, main_video, sub_videos=None):
        """添加 -i 及前置参数（-ss/-to、循环等）"""
        main_video_path = normalize_path(main_video.file_path)
        sub_paths = [normalize_path(sv.file_path) for sv in (sub_videos or [])]

        for f in input_files:
            f_norm = normalize_path(f)

            if _is_virtual_source(f_norm):
                # 虚拟颜色源：走 lavfi 输入（透明靠 format=rgba 保 alpha 通道）
                _spec = _virtual_lavfi_spec(f_norm)
                if _spec:
                    cmd.extend(["-f", "lavfi", "-i", _spec])
                continue

            if f_norm == main_video_path:                                   # 主视频截取
                if (main_video.enc_settings.get("trim_enabled", False) and
                    not main_video.enc_settings.get("precise_trim", False) and
                    not self._is_static_image(f_norm)):
                    start = main_video.enc_settings.get("trim_start", "").strip()
                    end = main_video.enc_settings.get("trim_end", "").strip()
                    if start:
                        cmd.extend(["-ss", start])
                    if end:
                        cmd.extend(["-to", end])
                # 主视频静态图片：image2 循环（否则只有 1 帧；输出时长由「截取」面板的
                # 「显示时长」(img_duration) 经后续 -t 控制，默认 10s）
                if self._is_static_image(f_norm):
                    fps = main_video.enc_settings.get("frame_rate_custom", "30") \
                          if main_video.enc_settings.get("frame_rate_type") == "custom" else "30"
                    # 把本图「显示时长」烘焙进输入：每张图成为有限长的独立素材标签，
                    # 总时长由 concat/xfade 自然得出，不再依赖末尾单一 -t 钳制。
                    _img_dur = _eff_image_display_duration(main_video.enc_settings)
                    cmd.extend(["-loop", "1", "-framerate", fps, "-t", f"{_img_dur:.3f}"])

            elif sub_videos and f_norm in sub_paths:                        # 子视频循环
                sv = next((sv for sv in sub_videos if normalize_path(sv.file_path) == f_norm), None)
                if sv and not sv.enc_settings.get("trim_enabled", False):
                    ext = os.path.splitext(f_norm)[1].lower()
                    if ext == '.gif':
                        # GIF 动画，使用 -stream_loop -1 保证无限循环，不加 -loop 和 -framerate
                        cmd.extend(["-stream_loop", "-1"])
                    elif ext in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
                        # 静态图片，使用 image2 循环；同样把本图「显示时长」烘焙进输入，
                        # 使每张图成为有限长的独立素材标签。
                        fps = main_video.enc_settings.get("frame_rate_custom", "30") \
                              if main_video.enc_settings.get("frame_rate_type") == "custom" else "30"
                        _img_dur = _eff_image_display_duration(sv.enc_settings)
                        cmd.extend(["-loop", "1", "-framerate", fps, "-t", f"{_img_dur:.3f}"])
                    else:
                        # 其他视频
                        cmd.extend(["-stream_loop", "-1"])

            cmd.extend(["-i", f_norm])
        return cmd


    def _handle_audio_trim(self, cmd, audio, audio_map_count: int) -> bool:
        """处理音频截取，返回是否已处理"""
        if not audio.enc_settings.get("trim_enabled", False):
            return False

        start_str = audio.enc_settings.get("trim_start", "").strip()
        end_str = audio.enc_settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start_str) if start_str else 0.0
        end_sec = time_to_seconds(end_str) if end_str else None

        total_duration = self._get_media_duration(audio.file_path)
        duration = (end_sec - start_sec) if end_sec is not None else \
                   (total_duration - start_sec if total_duration is not None else None)

        if duration is None or duration <= 0:
            return False

        enc = audio.enc_settings.get("encoder", "aac")
        if enc == "copy":
            enc = "aac"
            self._append_info_ui(_("音频截取启用，轨道 {0} 编码器已从 copy 改为 {1}").format(audio_map_count+1, enc))

        sfx = audio_stream_suffix(audio_map_count)
        af_filter = f"atrim=start={_ffsec(start_sec)}:duration={_ffsec(duration)},asetpts=PTS-STARTPTS"
        cmd.extend(["-filter:a" + sfx, af_filter])
        # 走 build_audio_encoder_args 统一处理 auto/无损/opus(-strict -2) 边界（与 base 一致）
        cmd.extend(build_audio_encoder_args(enc, audio.enc_settings, stream_tag=sfx))
        return True


    def _opus_copy_fallback(self, enc, audio_track):
        """opus 音轨以 -c:a copy 封装进 MP4/MOV 会触发 muxer 警告 "codec frame size is not set"，
        且 mp4/mov+opus 兼容性差（系统播放器/手机相册/网页可能不出声）。
        检测到此组合时自动转 aac（消除警告并提升兼容性）。
        返回 (final_enc, fallback_hint)：fallback_hint 为 None 表示无需兜底，
        否则为提示信息片段（不含轨号），供调用方拼装完整提示。"""
        if enc == "copy" and self.merge_container.get().lower() in ("mp4", "mov"):
            src_codec = (getattr(audio_track, "codec", "") or "").lower()
            if src_codec == "opus":
                return "aac", _("源编码为 opus，MP4/MOV 容器不支持 copy，已自动转码为 aac")
        return enc, None


    def _append_pip_single_audio(self, a_maps, a_enc, audio, file_index, map_count):
        """画中画音频：把单条音频轨道的 -map + 编码参数追加进列表（与原多音轨逐轨逻辑一致）。
        a_maps/a_enc 为列表，调用方在合适位置 cmd.extend 它们。"""
        a_idx = file_index[audio.file_path]
        a_maps.append("-map")
        a_maps.append(f"{a_idx}:a:{audio._type_index}")
        # _file_path 是 _build_audio_filters / _audio_effective_duration 查「源时长」的入口：
        # 只填开始（无结束）时算 atrim 的 duration、算 afade 淡出起点，都靠它。原 _add_audio_tracks
        # 在 -map 之后立刻写入；这里必须同样写入，否则画中画下音频截取/淡出会静默失效。
        audio.enc_settings["_file_path"] = audio.file_path
        track_reverse = audio.enc_settings.get("audio_reverse", False)
        af_str = self._build_audio_filters(
            audio.enc_settings, include_trim=True, include_volume=True,
            include_speed=True, include_reverse=track_reverse)
        enc = audio.enc_settings.get("encoder", "copy")
        sfx = audio_stream_suffix(map_count)
        if af_str:
            if enc == "copy":
                enc = "aac"
                self._append_info_ui(_("音频轨 {0} 应用了滤镜，编码器自动改为 aac").format(map_count+1))
            a_enc.append("-filter:a" + sfx)
            a_enc.append(af_str)
        enc, fb = self._opus_copy_fallback(enc, audio)
        if fb:
            self._append_info_ui(_("音频轨 {0} {1}").format(map_count+1, fb))
        if enc == "copy":
            a_enc.extend([f"-c:a:{map_count}", "copy"])
        else:
            a_enc.extend(build_audio_encoder_args(
                enc, audio.enc_settings, stream_tag=sfx,
                skip_ar=bool(audio_soxr_resample_filter(audio.enc_settings))))
        _disp = audio.enc_settings.get("disposition", "")
        if _disp:
            a_enc.extend([f"-disposition:a:{map_count}", _disp])
        elif map_count == 0:
            a_enc.extend([f"-disposition:a:{map_count}", "default"])

    def _pip_sub_video_enc(self, enabled_tracks, sub_audio):
        """查子视频音频轨对应的 video 轨 enc_settings（audio_mode/loop/显示时段都挂在那里）。"""
        _p = normalize_path(sub_audio.file_path)
        for t in enabled_tracks:
            if t.type == "video" and normalize_path(t.file_path) == _p:
                return t.enc_settings
        return {}

    @staticmethod
    def _pip_audio_mode(venc):
        _m = str(venc.get("audio_mode", "default") or "default")
        return _m if _m in ("default", "ignore", "mix", "replace") else "default"


    def _pip_sub_audio_node(self, sub_audio, file_index, venc, main_duration, label="subX",
                            total_duration=None, audio_shift=None):
        """子视频音频 → filter_complex 段（标签 [label]），或 None（子视频无音轨/查不到输入）。
        含：子声自身滤镜 + 显示时段起始延迟(adelay) + loop 镜像(aloop) + 采样率/声道对齐(aformat+aresample)。

        total_duration：时间轴总长（子素材摆到主视频之后时的延长值）。子声必须**有界**到它，
        否则无界子声（aloop=-1）在 amix duration=longest 下永不结束。窗外部分由调用方
        volume=enable 静音，截断本身不改变可闻内容。

        audio_shift：{normalize_path(文件): 秒} —— 转场链内该段的音频偏移（≤0）。
        xfade 吞掉 d 秒让**画面**提前出现，音频必须同步提前，否则声画错开一个转场时长。
        """
        _idx = file_index.get(sub_audio.file_path)
        if _idx is None:
            return None
        # PiP 子声的 enc_settings 不自带 _file_path，_audio_effective_duration 取不到源时长
        # → afade=t=out 落到 st=0 兜底（子声只开头 1s 有声）。按转换页惯例注入源路径。
        sub_audio.enc_settings["_file_path"] = sub_audio.file_path
        _af = self._build_audio_filters(
            sub_audio.enc_settings, include_trim=True, include_volume=True,
            include_speed=True, include_reverse=sub_audio.enc_settings.get("audio_reverse", False))
        _parts = [_af] if _af else []
        # ⚠️ 归一必须在 aloop **之前**：aloop 的 size 按样本数计，采样率固定成 48000 后才
        # 算得出精确 size；沿用旧的 size=2000000000 会让每遍循环之间出现空档（实测 2s 静音洞）。
        _parts.append("aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000")
        # 原声独立（2026-10-17，audio_detached）：位置/长度由本轨 audio_offset /
        # audio_free_end 决定，两者已在 _build_audio_filters 内生效（起始 adelay / 链尾
        # atrim=end）。此时**不再跟视频显示窗口派生** —— 不套 aloop（不循环铺满窗口）、
        # 不再 adelay(show_start)，分离后原声只播一遍，与 Shotcut 分离音频一致。
        if venc.get("audio_detached", False):
            _parts.append("asetpts=PTS-STARTPTS")   # adelay 负 pts 静音头归零（同下）
            _T = total_duration if (total_duration and total_duration > 0) else main_duration
            if _T and _T > 0:
                _parts.append(f"atrim=0:{_ffsec(_T)}")
            return f"[{_idx}:a]" + ",".join(_parts) + f"[{label}]"
        # loop 镜像视频决策（与 _resolve_display_window 同判定）：
        # 有界窗口 → 有限遍（正好铺满窗口）；无界 → 无限（由下方 atrim 收口）。
        _sub_dur = self._get_media_duration(sub_audio.file_path) or 0.0
        _ws, _we, _bounded = self._resolve_display_window(venc, _sub_dur, input_path=sub_audio.file_path)
        if _bounded and _we is not None and _we > _ws and _sub_dur > 0:
            _win_ms = max(1, int(round((_we - _ws) * 1000)))
            _src_ms = max(1, int(round(_sub_dur * 1000)))
            _w = min(64, max(1, -(-_win_ms // _src_ms)))   # 覆盖窗口所需遍数（向上取整）
            _size = max(1, int(_sub_dur * 48000))
            _parts.append(f"aloop=loop={_w - 1}:size={_size}")
            # 精确裁到窗口长度：窗外天然没有内容 → 调用方不必再用 volume=enable 静音窗外。
            # （不重叠的地方本来就没声，静音表达式只算重叠部分就够了。）
            _parts.append(f"atrim=0:{_ffsec(_we - _ws)}")
        else:
            _parts.append("aloop=loop=-1:size=2000000000")
        # 显示时段起始 → 子声整体延迟（与视频 overlay enable='gte(t,START)' 对齐）
        # ⚠️ 必须在循环**之后**：放在前面会让每遍循环都重复那一段前导静音，窗口内出现静音洞。
        _start = time_to_seconds(venc.get("show_start", "") or "") or 0.0
        # 转场链偏移：画面被 xfade 提前了 Σd → 声音跟着提前同样的量
        _sh = 0.0
        if audio_shift:
            _sh = _opt_float(audio_shift.get(normalize_path(sub_audio.file_path), 0.0) or 0.0, 0.0)
        _start = max(0.0, _start + _sh)
        if _start > 0:
            _parts.append(f"adelay=delays={_start*1000:.0f}:all=1")
            # ⚠️ adelay 的静音头 pts 为负（n9.0.1 实测：内容右移、头部静音 pts<0）——
            # 下方 atrim=0:T 会把负 pts 静音头整段剥掉 ⇒ 流只剩内容长 ⇒ amix 逐样本
            # 叠加**不看 pts** ⇒ 子声从输出 0s 开始混（用户实测「最后一段混进第一段、
            # 自己位置没声」；最小复现 tests/_dbg_adelay_amix_probe.py，两链序均复现，
            # adelay 后接 asetpts=PTS-STARTPTS 归零后 23s/23.8s 静音头完整保留）。
            # 预览侧同款坑见 43676 注释（amovie 源 adelay 负 pts）。
            _parts.append("asetpts=PTS-STARTPTS")
        # 有界化到时间轴总长：无界子声是无限流，amix duration=longest 下永不结束。
        _T = total_duration if (total_duration and total_duration > 0) else main_duration
        if _T and _T > 0:
            _parts.append(f"atrim=0:{_ffsec(_T)}")
        return f"[{_idx}:a]" + ",".join(_parts) + f"[{label}]"

    def _pip_window_seconds(self, venc, main_duration, sub_path=None, aenc=None):
        """替换窗 [start, end]：与视频显示窗口一致（_resolve_display_window 同判定，声画共窗口）。
        start=显示时段起始；end=显示时段结束（bounded 取窗口尾，无界取主视频时长）。

        aenc：该子音频轨的 enc_settings。原声独立（venc.audio_detached）时，窗口改由
        audio_offset（输出轴开始）/ audio_free_end（输出轴结束）决定 —— 与
        `_pip_sub_audio_node` 的独立分支同源，避免「替换静音窗」与子声实际落位错开。"""
        if venc.get("audio_detached", False):
            _ae = aenc if isinstance(aenc, dict) else {}
            _s = _opt_float(_ae.get("audio_offset", 0) or 0, 0.0)
            _e = _opt_float(_ae.get("audio_free_end", "") or 0, 0.0)
            if _e <= _s:
                _e = main_duration if (main_duration and main_duration > 0) else _s + 1.0
            return max(0.0, _s), _e
        _ws, _we, _bounded = self._resolve_display_window(
            venc, self._get_media_duration(sub_path) if sub_path else None, input_path=sub_path)
        _s = _ws if _ws is not None else 0.0
        if _bounded and _we is not None and _we > _s:
            _e = _we
        else:
            _e = main_duration if (main_duration and main_duration > 0) else _s + 1.0
        return _s, _e

    @staticmethod
    def _audio_out_mode(audio_track):
        """独立音频轨输出方式（2026-09-30「分离音频自由」）：mix=混音进主音频 / ignore=忽略 / stream=独立音轨(默认)。
        canonical 键 audio_out_mode；旧工程无此键时回退 mix_enabled（True→mix），保证旧设置语义不丢。"""
        _enc = getattr(audio_track, "enc_settings", None) or {}
        _v = str(_enc.get("audio_out_mode", "") or "")
        if _v in ("stream", "mix", "ignore"):
            return _v
        if _enc.get("mix_enabled", False):
            return "mix"
        return "stream"

    def _free_audio_mix_node(self, audio_track, file_index, total_duration, label="fx0",
                             norm_str="aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000"):
        """独立音频轨「混音进主音频」→ filter_complex 节点（标签 [label]）；None=查不到输入。

        与 _pip_sub_audio_node 同链序口径：自身滤镜(截取→adelay→变速→分段→soxr) → 归一 →
        asetpts=PTS-STARTPTS → 有界化到时间轴总长。
        ⚠️ asetpts 必须在归一之后、atrim 之前：_build_audio_filters 内的 adelay(audio_offset=开始)
        静音头 pts 为负（n9.0.1 实测，见 _pip_sub_audio_node 内 41641 注释）——atrim=0:T 会把
        负 pts 静音头整段剥掉 ⇒ amix 逐样本叠加不看 pts ⇒ 内容从输出 0s 开始混（位置错）。
        asetpts 归零后静音头完整保留，内容落在 [开始, 开始+时长]。
        自身窗口 = audio_offset(开始/延迟) 与 audio_free_end(结束/输出时间轴，链尾 atrim 截断)，
        均已在 _build_audio_filters 内生效；trim_end 仅在启用截取时作文件内内容裁剪（与结束互不影响）。
        """
        _idx = file_index.get(audio_track.file_path)
        if _idx is None:
            return None
        audio_track.enc_settings["_file_path"] = audio_track.file_path
        _af = self._build_audio_filters(
            audio_track.enc_settings, include_trim=True, include_volume=True,
            include_speed=True, include_reverse=audio_track.enc_settings.get("audio_reverse", False))
        _parts = [_af] if _af else []
        _parts.append(norm_str)
        _parts.append("asetpts=PTS-STARTPTS")
        _T = total_duration if (total_duration and total_duration > 0) else None
        if _T:
            _parts.append(f"atrim=0:{_ffsec(_T)}")
        return f"[{_idx}:a]" + ",".join(_parts) + f"[{label}]"

    def _build_pip_audio(self, enabled_tracks, file_index, main_video,
                         bgm_on, bgm_idx, bgm_vol, main_duration,
                         total_duration=None, audio_shift=None):
        """画中画音频组装（方案 A：BGM 仅垫主视频音频之下，子视频音频保持独立音轨）。

        total_duration：画中画「时间轴跨度」（`_pip_timeline_extent` 算得，含子素材被摆到
        主视频之后所需的延长）。None = 按 main_duration（旧调用方行为）。
        ⚠️ 参与 amix 的每条音频都必须**有界**到它，否则：
          · 主音频短于时间轴 → amix 输出被截断，延长段子声凭空消失（混音/替换失效）；
          · 无界子声（aloop=-1）→ amix 永不结束。

        audio_shift：{normalize_path(文件): 秒} —— 转场链的音频偏移（见
        `_pip_transition_chains`）。子声延迟与「替换窗静主声」的窗口都要跟着偏移，
        否则画面已转场、声音还在原位置（用户实测：转场后声音滞后）。

        返回 (audio_parts, a_maps, a_enc)：
          audio_parts : 需追加进 -filter_complex 的音频滤镜段（列表）
          a_maps      : -map 参数列表（如 ["-map","[afinal]","-map","2:a:0"]）
          a_enc       : 音频输出编码参数列表
        BGM 开启：主视频音频(+其滤镜, 归一到 44100 立体声) 与 [bgm](循环铺满+压音量) amix → [afinal]，
                  作为输出首条音轨；子视频音频仍逐条独立 -map（保持独立音轨）。
        BGM 关闭：沿用原多音轨行为（主+子各自独立 -map）。
        无任何音频且无 BGM：返回空列表，调用方追加 -an。
        """
        audio_tracks = [t for t in enabled_tracks if t.type == "audio"]
        main_path = normalize_path(main_video.file_path)
        main_audio = next((t for t in audio_tracks if normalize_path(t.file_path) == main_path), None)
        # 主音频条目「忽略」→ 静音底子（anullsrc 垫底，混音/替换/自由音频照常；2026-09-30）：
        # 忽略 = 不输出主声，但混音仍要有一个「底」来承载时间轴落位语义。
        if main_audio is not None and self._audio_out_mode(main_audio) == "ignore":
            main_audio = None
        sub_audios = [t for t in audio_tracks if normalize_path(t.file_path) != main_path]

        # 音频时间轴总长：子素材摆到主视频之后时，音频床要跟画面一起延长，
        # 否则 amix 只出到主音频长度、延长段静音（混音/替换看起来"没生效"）。
        _aud_total = total_duration if (total_duration and total_duration > 0) else main_duration
        # 主声床截断段：apad 补静音到无限 → atrim 精确截到总长（主声短于时间轴时后半静音）。
        _apad_trim = (f",apad,atrim=0:{_ffsec(_aud_total)}"
                      if (_aud_total and _aud_total > 0) else "")

        def _sh_of(_p):
            """转场链给该文件的音频偏移（秒，≤0）；无转场链 → 0。"""
            if not audio_shift:
                return 0.0
            try:
                return float(audio_shift.get(normalize_path(_p), 0.0) or 0.0)
            except (TypeError, ValueError):
                return 0.0

        a_parts, a_maps, a_enc = [], [], []

        if bgm_on:
            # BGM 链：归一 + 文件内片段精准截取(可选) + 无限循环 + 按主视频时长截断 + 压音量
            # 背景音乐文件内片段截取：默认整段；填开始/结束则只取该段循环铺满（无需预先处理长度）
            _bs = main_video.enc_settings.get("bgm_trim_start", "") or ""
            _be = main_video.enc_settings.get("bgm_trim_end", "") or ""
            _bs_sec = time_to_seconds(_bs) if _bs else None
            _be_sec = time_to_seconds(_be) if _be else None
            _src_trim_parts = []
            if _bs_sec is not None:
                _src_trim_parts.append(f"start={_ffsec(_bs_sec)}")
            if _be_sec is not None:
                _src_trim_parts.append(f"end={_ffsec(_be_sec)}")
            # 帧精确片段截取必须带 atrim= 滤镜名；bare 的 start=/end= 会被 ffmpeg 当成孤立选项而报
            # "No option name near '...'"。只填开始→atrim=start=X；只填结束→atrim=end=Y；都填→atrim=start=X:end=Y。
            _bgm_src_trim = ("atrim=" + ":".join(_src_trim_parts) + ",asetpts=PTS-STARTPTS,") if _src_trim_parts else ""
            _bgm_trim = f"atrim=0:{_ffsec(main_duration)}," if (main_duration and main_duration > 0) else ""
            _bgm_chain = (
                f"[{bgm_idx}:a]aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000,"
                f"{_bgm_src_trim}"
                f"aloop=loop=-1:size=2000000000,"
                f"{_bgm_trim}"
                f"volume={bgm_vol:.3f},"
                f"asetpts=PTS-STARTPTS[bgm]"
            )
            a_parts.append(_bgm_chain)
            if main_audio is not None:
                # 主视频音频：施加其逐轨滤镜（trim/volume/speed/reverse），并归一到与子视频链一致的
                # 48000 立体声 fltp，否则 amix 会因采样率/声道不匹配报错。
                main_audio.enc_settings["_file_path"] = main_audio.file_path  # 供查源时长（同上）
                af = self._build_audio_filters(
                    main_audio.enc_settings, include_trim=True, include_volume=True,
                    include_speed=True, include_reverse=main_audio.enc_settings.get("audio_reverse", False))
                _mi = file_index[main_audio.file_path]
                if af:
                    a_parts.append(
                        f"[{_mi}:a]{af},"
                        f"aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000"
                        f"{_apad_trim}[amain]")
                else:
                    a_parts.append(
                        f"[{_mi}:a]aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000"
                        f"{_apad_trim}[amain]")
            else:
                # 主视频无音频：静音源垫底（替换窗内主声本就静音；混音=仅子声）；
                # BGM 留到子视频混音/替换之后才叠加（见函数末）。
                # anullsrc 是无限源 → 必须 atrim 到时间轴总长，否则 amix 永不结束。
                _anull_trim = (f",atrim=0:{_ffsec(_aud_total)}"
                               if (_aud_total and _aud_total > 0) else "")
                a_parts.append(f"anullsrc=r=48000:cl=stereo{_anull_trim}[amain]")
            a_maps.append("-map")
            a_maps.append("[afinal]")
            # [afinal] 编码：amix 输出必须重编码；沿用主音频设置（无主音频则 aac）
            _enc_src = main_audio.enc_settings if main_audio is not None else main_video.enc_settings
            enc = _enc_src.get("encoder", "aac")
            if enc == "copy":
                enc = "aac"
            a_enc.extend(build_audio_encoder_args(enc, _enc_src, stream_tag="", skip_ar=False))
            # [afinal] 是首条输出音轨，标记 default（与原 _add_audio_tracks 首轨行为一致）
            _disp = _enc_src.get("disposition", "")
            if _disp:
                a_enc.extend([f"-disposition:a:0", _disp])
            else:
                a_enc.extend([f"-disposition:a:0", "default"])
            self._append_info_ui(
                _('[封装-画] 已叠加背景音乐（{0}，音量 {1:.2f}，混在主视频音频之下）').format(os.path.basename(main_video.enc_settings.get('bgm_audio_path', '')), bgm_vol))
            # 子视频音频：按 audio_mode 派发（默认=独立流；忽略=跳过；混音/替换=amix 进 [afinal]）
            # —— 多子视频同时 混音/替换 的正确模型（对齐 NLE「片段声画共窗」）：
            #   · 主声在【所有 replace 窗的并集】内一次性静音（BGM 不在此静音，最后才叠加）；
            #   · 每个 混音/替换 子声各自在自身窗内生效（窗外用 1-between 静音）；
            #   · 全部 additively amix 进 [afinal]：重叠区自然求和（主声已静音、各子声叠加）。
            #   旧写法对每个 replace 子声单独 mute 整个 [afinal]，会把已混入的其它子声在重叠区抹掉 → 已废弃。
            _dc = 0
            _mix_subs, _rep_subs, _free_mix = [], [], []
            for sub in sub_audios:
                _om = self._audio_out_mode(sub)
                _venc = self._pip_sub_video_enc(enabled_tracks, sub)
                if not _venc:
                    # 无视频控制（BGM 类外置音频轨道）→ 自身输出方式直接生效，
                    # 不进「绑定优先」判断（2026-09-30 用户拍板：绑定优先只约束
                    # 有视频控制的子视频同文件音频）。
                    if _om == "ignore":
                        continue
                    if _om == "mix":
                        _free_mix.append(sub)
                        continue
                    _dc += 1
                    self._append_pip_single_audio(a_maps, a_enc, sub, file_index, _dc)
                    continue
                # 有视频控制（子视频同文件）→ 视频绑定（跟随窗口）永远优先；
                # 绑定未选（default）时音频条目自身的输出方式才生效。
                _mode = self._pip_audio_mode(_venc)
                if _mode == "ignore":
                    continue
                if _mode == "default":
                    if _om == "ignore":
                        continue
                    if _om == "mix":
                        _free_mix.append(sub)
                        continue
                    _dc += 1
                    self._append_pip_single_audio(a_maps, a_enc, sub, file_index, _dc)
                    continue
                (_rep_subs if _mode == "replace" else _mix_subs).append((sub, _venc))
            # replace 窗并集 → 主声一次性静音（仅当存在 replace 子声；BGM 不在此列）
            if _rep_subs:
                # ⚠️ 原写法是嵌套生成器表达式 + f-string 里写 `_s/_e`，但循环变量叫 `_rs/_re`
                # → py3.12+（PEP 709 推导式内联）直接抛 NameError，「替换」命令构建崩溃、
                # 命令预览出不来。改为显式循环。
                _terms = []
                for (_rp, _rv) in _rep_subs:
                    _ws_, _we_ = self._pip_window_seconds(_rv, main_duration, _rp.file_path,
                                                         aenc=_rp.enc_settings)
                    _sh_ = _sh_of(_rp.file_path)
                    # 2026-10-01：定点 3 位 → _ffsec（9 位）。窗口边界落进命令层，
                    # 按 _ffsec 铁律「切点/区间阈值一律 9 位」；3 位会让边界差最多 0.5ms
                    # （实测偶发差 1 帧），且与其他 between(t,...) 构造点口径不一致。
                    _terms.append(f"between(t,{_ffsec(max(0.0, _ws_ + _sh_))},"
                                  f"{_ffsec(max(0.0, _we_ + _sh_))})")
                _union = "+".join(_terms)
                a_parts.append(f"[amain]volume=enable='{_union}':volume=0[amain]")
            # 所有 混音/替换 子声：窗外静音后叠加（主声已按并集静音，重叠区自然求和）
            _k = 0
            _made = False   # 是否真的产出过子声节点（全为 None 时 [afinal] 不会被创建）
            for (sub, _venc) in (_mix_subs + _rep_subs):
                _lbl = f"sub{_k}"
                _node = self._pip_sub_audio_node(sub, file_index, _venc, main_duration,
                                                 label=_lbl, total_duration=_aud_total, audio_shift=audio_shift)
                if _node is None:
                    continue  # 子视频无音轨 → 降级忽略
                a_parts.append(_node)
                # 子声已由 _pip_sub_audio_node 裁到自身显示窗口（窗外无内容），
                # 不再需要 volume=enable 静音窗外 —— 不重叠的地方本来就没声。
                # ⚠️ duration=first 会把输出锁死成「第一条输入(主声)」的长度 → 子素材摆到
                # 主视频之后时，延长段的子声被整段切掉（混音/替换看起来完全没生效）。
                # 各输入已各自 atrim 到时间轴总长 → longest 才是正确语义。
                a_parts.append(f"[amain][{_lbl}]amix=inputs=2:duration=longest:normalize=0[afinal]")
                _k += 1
                _made = True
            # 独立音频轨「混音进主音频」（自由音频，无视频窗口绑定）：
            # 自身窗口已由 audio_offset(开始)/trim_end(结束) 在链内生效，additively 叠加进 [afinal]。
            # 放在子声级联之后、BGM 之前（BGM 仍垫最上层之下的最后叠加位）。
            _fk = 0
            for _fa in _free_mix:
                _flbl = f"fx{_fk}"
                _fnode = self._free_audio_mix_node(_fa, file_index, _aud_total, label=_flbl)
                if _fnode is None:
                    continue  # 查不到输入 → 降级忽略
                a_parts.append(_fnode)
                a_parts.append(f"[afinal][{_flbl}]amix=inputs=2:duration=longest:normalize=0[afinal]")
                _fk += 1
            # BGM 最后叠加（方案 A 修正）：子视频混音/替换已汇入 [afinal]，此时才与
            # 主声/子声床叠加 BGM。替换窗内只静主声（[amain] 并集静音），BGM 在静音之后
            # 才加入 → 替换窗内仍保留 BGM 垫底（旧写法把 BGM 与主声同节点一起被静掉）。
            if not _made:
                # 无 混音/替换 子声（或子声全部查不到输入）时未产出 [afinal] → 透传 [amain]
                a_parts.append(f"[amain]anull[afinal]")
            a_parts.append(f"[afinal][bgm]amix=inputs=2:duration=longest:normalize=0[afinal]")
            return a_parts, a_maps, a_enc

        # BGM 关闭
        _any_mix = (
            any(self._pip_audio_mode(self._pip_sub_video_enc(enabled_tracks, s)) in ("mix", "replace")
                for s in sub_audios)
            or any(self._audio_out_mode(s) == "mix" for s in sub_audios))
        if not _any_mix:
            # 与原 _add_audio_tracks 逐字等价 —— 严格按「轨道列表顺序」逐条 map（零回归）。
            # 仅新增：忽略模式跳过该子视频音频轨（无忽略时 _mc 与原文 enumerate 索引一致）。
            _mc = 0
            for _audio in audio_tracks:
                if _audio is not main_audio:
                    if self._audio_out_mode(_audio) == "ignore":
                        continue
                    _vm = self._pip_sub_video_enc(enabled_tracks, _audio)
                    if self._pip_audio_mode(_vm) == "ignore":
                        continue
                self._append_pip_single_audio(a_maps, a_enc, _audio, file_index, _mc)
                _mc += 1
            return a_parts, a_maps, a_enc
        # 有子视频用混音/替换：主视频音频需作为 filter_complex 节点 [amain] 参与 amix。
        # ⚠️ 此分支仅在存在 mix/replace 时激活；纯默认/忽略用户走上方零回归路径。
        if main_audio is not None:
            main_audio.enc_settings["_file_path"] = main_audio.file_path
            _maf = self._build_audio_filters(
                main_audio.enc_settings, include_trim=True, include_volume=True,
                include_speed=True, include_reverse=main_audio.enc_settings.get("audio_reverse", False))
            _mi = file_index[main_audio.file_path]
            if _maf:
                a_parts.append(
                    f"[{_mi}:a]{_maf},"
                    f"aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000"
                    f"{_apad_trim}[amain]")
            else:
                a_parts.append(
                    f"[{_mi}:a]aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000"
                    f"{_apad_trim}[amain]")
        else:
            # 主视频无音频：用静音源垫底（替换窗内主声本就静音；混音=仅子声）
            _anull_trim2 = (f",atrim=0:{_ffsec(_aud_total)}"
                            if (_aud_total and _aud_total > 0) else "")
            a_parts.append(f"anullsrc=r=48000:cl=stereo{_anull_trim2}[amain]")
        a_maps.append("-map")
        a_maps.append("[amain]")
        _enc_src = main_audio.enc_settings if main_audio is not None else main_video.enc_settings
        enc = _enc_src.get("encoder", "aac")
        if enc == "copy":
            enc = "aac"
        a_enc.extend(build_audio_encoder_args(enc, _enc_src, stream_tag="", skip_ar=False))
        _disp = _enc_src.get("disposition", "")
        if _disp:
            a_enc.extend(["-disposition:a:0", _disp])
        else:
            a_enc.extend(["-disposition:a:0", "default"])
        # 子视频音频派发（默认=独立流；忽略=跳过；混音/替换=amix 进 [amain]）
        # 多子视频 混音/替换 正确模型（同 BGM 开分支）：replace 窗并集一次性静音主声，
        # 所有 混音/替换 子声窗外静音后 additively 叠加（重叠区自然求和）。
        _dc = 0
        _mix_subs, _rep_subs, _free_mix = [], [], []
        for sub in sub_audios:
            _om = self._audio_out_mode(sub)
            _venc = self._pip_sub_video_enc(enabled_tracks, sub)
            if not _venc:
                # 无视频控制（BGM 类外置音频轨道）→ 自身输出方式直接生效（同上）。
                if _om == "ignore":
                    continue
                if _om == "mix":
                    _free_mix.append(sub)
                    continue
                _dc += 1
                self._append_pip_single_audio(a_maps, a_enc, sub, file_index, _dc)
                continue
            # 有视频控制（子视频同文件）→ 视频绑定（跟随窗口）永远优先；
            # 绑定未选（default）时音频条目自身的输出方式才生效。
            _mode = self._pip_audio_mode(_venc)
            if _mode == "ignore":
                continue
            if _mode == "default":
                if _om == "ignore":
                    continue
                if _om == "mix":
                    _free_mix.append(sub)
                    continue
                _dc += 1
                self._append_pip_single_audio(a_maps, a_enc, sub, file_index, _dc)
                continue
            (_rep_subs if _mode == "replace" else _mix_subs).append((sub, _venc))
        if _rep_subs:
            # 同上方 BGM 分支：改为显式循环（原嵌套生成器 + 错名 `_s/_e` 会 NameError）
            _terms = []
            for (_rp, _rv) in _rep_subs:
                _ws_, _we_ = self._pip_window_seconds(_rv, main_duration, _rp.file_path,
                                                     aenc=_rp.enc_settings)
                _sh_ = _sh_of(_rp.file_path)
                # 同上方 BGM 分支：定点 3 位 → _ffsec（9 位），理由同上。
                _terms.append(f"between(t,{_ffsec(max(0.0, _ws_ + _sh_))},"
                              f"{_ffsec(max(0.0, _we_ + _sh_))})")
            _union = "+".join(_terms)
            a_parts.append(f"[amain]volume=enable='{_union}':volume=0[amain]")
        _k = 0
        for (sub, _venc) in (_mix_subs + _rep_subs):
            _lbl = f"sub{_k}"
            _node = self._pip_sub_audio_node(sub, file_index, _venc, main_duration,
                                             label=_lbl, total_duration=_aud_total, audio_shift=audio_shift)
            if _node is None:
                continue  # 子视频无音轨 → 降级忽略
            a_parts.append(_node)
            # 子声已裁到自身窗口（窗外无内容），无需 volume=enable 静音窗外
            # duration=longest（同 BGM 分支）：first 会把输出锁死成主声长度、切掉延长段子声
            a_parts.append(f"[amain][{_lbl}]amix=inputs=2:duration=longest:normalize=0[amain]")
            _k += 1
        # 独立音频轨「混音进主音频」（自由音频，无视频窗口绑定）：叠加进 [amain]。
        _fk = 0
        for _fa in _free_mix:
            _flbl = f"fx{_fk}"
            _fnode = self._free_audio_mix_node(_fa, file_index, _aud_total, label=_flbl)
            if _fnode is None:
                continue  # 查不到输入 → 降级忽略
            a_parts.append(_fnode)
            a_parts.append(f"[amain][{_flbl}]amix=inputs=2:duration=longest:normalize=0[amain]")
            _fk += 1
        return a_parts, a_maps, a_enc


    def _pip_main_duration(self, main_video):
        """画中画输出主视频时长（秒）：静态图默认 10s；启用截取则按起止裁剪。
        供 BGM 循环截断与 _add_pip_duration_control 的 -t 保持一致。"""
        # 帧对齐（floor 到源帧格）：与 _pip_main_effective_duration / -t 三处同口径
        raw_duration = self._get_media_duration(
            main_video.file_path,
            frame_align_fps=self._get_video_framerate(main_video.file_path))
        if (raw_duration is None or raw_duration <= 0) and self._is_static_image(main_video.file_path):
            raw_duration = 10.0
        main_duration = _trimmed_duration(main_video, raw_duration)
        return main_duration if (main_duration and main_duration > 0) else 0.0

    def _pip_main_effective_duration(self, main_video):
        """画中画主视频有效时长（秒）：与 `_add_pip_duration_control` 的 -t 口径严格一致
        （静态图片取「截取」面板的显示时长，而非 `_pip_main_duration` 的 10.0 兜底）。

        ⚠️ 时间轴延长（见 `_pip_timeline_extent`）必须以此为基准算补帧量，
        两处口径不同会导致「底补的长度」与「-t 截断的长度」错位。
        """
        # 帧对齐（floor 到源帧格）：主视频段长（进链 trim=0:len0 / tpad 基准）帧格化
        raw_duration = self._get_media_duration(
            main_video.file_path,
            frame_align_fps=self._get_video_framerate(main_video.file_path))
        if (raw_duration is None or raw_duration <= 0) and self._is_static_image(main_video.file_path):
            raw_duration = _eff_image_display_duration(main_video.enc_settings)
        main_duration = _trimmed_duration(main_video, raw_duration)
        return main_duration if (main_duration and main_duration > 0) else 0.0

    def _pip_sub_window_end(self, sub_settings, sub_file):
        """子视频「有界显示窗口」的结束时刻（输出时间线秒）；无界 / 取不到 → None。

        口径复用 `_resolve_display_window`（与 enable 表达式同源），避免两处判定漂移。
        无界（无限循环 / 仅设起始且无次数）不参与延长——它本来就会一直显示到输出结束。
        """
        try:
            # 帧对齐（floor 到源帧格）：窗口结束喂 _pip_timeline_extent → tpad/-t，
            # 与图层供帧窗口同源，防「底比内容多 1 帧」的交界瑕疵
            _dur = self._get_media_duration(
                sub_file, frame_align_fps=self._get_video_framerate(sub_file))
            _ws, _we, _bounded = self._resolve_display_window(
                sub_settings, _dur, input_path=sub_file)
        except Exception:
            return None
        if _bounded and _we is not None and _we > 0:
            return float(_we)
        return None

    def _pip_timeline_extent(self, main_duration, sub_items):
        """画中画「时间轴实际跨度」（秒）= max(主视频有效时长, 所有启用子视频的有界窗口结束)。

        ⚠️ 为什么必须延长底（实测见 `research/concat-overlay-alt` §13.1）：
        overlay 的**主输入 EOF = 整条链 EOF**——子素材被摆到主视频之后时，只把 `-t`
        加大**拿不到后面的帧**（输出仍在主视频结束处终止，超出部分静默丢失）。
        所以底必须真的接长（`tpad=stop_mode=add` 补黑帧），不能只改 `-t`。

        sub_items: `[(file_path, enc_settings), ...]`；未启用叠加的子视频跳过。
        无任何子视频窗口超出主视频时长 → 返回 main_duration（调用方据此不补帧 = 零行为变化）。
        """
        end = float(main_duration or 0.0)
        for _f, _s in (sub_items or []):
            if not _s.get("overlay_enabled", True):
                continue
            we = self._pip_sub_window_end(_s, _f)
            if we is not None and we > end:
                end = we
        return end

    def _pip_warn_cut_off_subs(self, sub_infos, extent):
        """提示「起点 ≥ 输出时长」的启用子视频——这些段完全落在输出之外（会被 -t 整段截掉）。

        根因几乎总是**显示窗口无限**（没填「显示 结束」且无限循环 → 探不到长度，
        不参与时间轴延长、也不参与转场链）。此前全程静默（用户实测 4/5/6 段被截掉、
        5&6 没成链，日志无一提示，只能靠对比命令才发现）→ 在时长计算点点名提醒。
        只提示不改行为：无界窗口「一直显示到输出结束」的语义保持不变。
        """
        _hits = []
        for _i, (_p, _s) in enumerate(sub_infos or []):
            if not _s.get("overlay_enabled", True):
                continue
            try:
                _dur = self._get_media_duration(_p)
                _ws, _we, _bd = self._resolve_display_window(_s, _dur, input_path=_p)
            except Exception:
                continue
            if _bd and _we is not None:
                continue      # 有界窗口已被 extent 计入，不可能整段落在输出之外
            if float(_ws or 0.0) >= float(extent or 0.0) - 1e-6:
                _hits.append(_i + 1)
        if _hits:
            self._append_info_ui(
                _('[封装-画] ⚠️ 子视频 %s 的起点在输出时长之外，但显示窗口无限（没填「显示 结束」也没设有限循环次数）→ 探不到长度，未计入输出时长、也无法与相邻段合成转场，整段不会出现在成片里。是否有素材忘了开有限时长？')


                % "、".join(str(_h) for _h in _hits))

    def _pip_segment_span(self, track, is_main=False):
        """画中画：某视频轨在时间轴上的 (显示起点, 显示长度)；长度 None = 探不到。

        口径与命令端严格一致：子视频走 `_resolve_display_window`（显示时段 + 循环次数），
        主视频走 `_pip_main_effective_duration`（trim 后有效时长，起点恒 0）。
        无界窗口（无限循环 / 只设起点且无次数）→ 长度回退「素材有效时长（一次播放）」：
        对齐只是摆位置，给个近似值比直接失败好用（转场链那边无界仍然不参与）。
        """
        try:
            if is_main:
                _ln = self._pip_main_effective_duration(track)
                return 0.0, (float(_ln) if (_ln and _ln > 0) else None)
            if self._is_static_image(track.file_path):
                _eff = _eff_image_display_duration(track.enc_settings)
            else:
                # 帧对齐 raw 时长（floor 到源帧格）：段长/接缝/画布 d 全链帧格化
                _raw = self._get_media_duration(
                    track.file_path, frame_align_fps=self._get_video_framerate(track.file_path))
                _eff = self._get_effective_duration(track.enc_settings, raw_duration=_raw)
            _ws, _we, _bd = self._resolve_display_window(
                track.enc_settings, _eff, input_path=track.file_path)
            _ws = float(_ws or 0.0)
            if _bd and _we is not None and _we > _ws:
                return _ws, float(_we) - _ws
            return _ws, (float(_eff) if (_eff and _eff > 0) else None)
        except Exception:
            return 0.0, None

    def _pip_trans_duration(self, track):
        """画中画：某段「挂在本段的转场」时长（未启用 / 非法 → 0.0）。"""
        if not bool(track.enc_settings.get("transition_enabled", False)):
            return 0.0
        try:
            _d = float(str(track.enc_settings.get("transition_duration", "1.0") or "1.0").strip())
        except (ValueError, TypeError):
            return 0.0
        return _d if _d > 0 else 0.0

    def _pip_audio_follow_shift(self, sub_videos, chains, sub_infos, main_video):
        """音频跟随转场：每个子视频独立的相对偏移（delta，秒）。

        开启「音频跟随转场」的视频：其音频直接落在它进入画面那一刻的**转场链真实输出位置**
        P_k（xfade 的交叉起点，逐帧对齐，类似 concat 的音频跟随），而非「显示起点 + 手动偏移」。
            delta = P_k − 该段显示起点 ws
        这样即使手动把显示起点摆错，音频也会被自动校正回画面位置（声画逐帧对齐）。

        未开启 / 未成链（前段没开转场、或与前后段不相邻） → delta = 0.0（留在原显示位置，
        声画可能错开 —— 这是用户显式不选「跟随」时的预期行为）。

        返回 {normalize_path(子视频文件): delta}。主视频是链首（P=0，无入口转场），
        不在返回表内（其音频恒从 0 起，无需偏移）。
        """
        _pos = {}
        for _ch in (chains or []):
            _mem = _ch["members"]
            _lens = _ch["lens"]
            _trans = _ch["trans"]
            _p = float(_ch["start"])
            for _mi, _m in enumerate(_mem):
                _afp = (normalize_path(main_video.file_path) if _m < 0
                        else normalize_path(sub_infos[_m][1]))
                _pos[_afp] = _p
                if _mi < len(_mem) - 1:
                    _p = _p + float(_lens[_m]) - float(_trans[_mi][1])
        _out = {}
        for _sv in sub_videos:
            _fp = normalize_path(_sv.file_path)
            # 原声独立（audio_detached）：位置由用户摆，不能再被转场自动校正，
            # 否则拖好的位置会被拉回交叉点（分离音频的语义就是"不跟"）。
            if (not _sv.enc_settings.get("pip_audio_follow_transition", False)
                    or _sv.enc_settings.get("audio_detached", False)):
                _out[_fp] = 0.0
                continue
            if _fp in _pos:
                try:
                    _ws = self._resolve_display_window(
                        _sv.enc_settings, self._get_media_duration(_sv.file_path),
                        input_path=_sv.file_path)[0] or 0.0
                except Exception:
                    _ws = 0.0
                # delta 夹在 [-ws, +∞)：ws 为负（非法）时也不让 adelay 变负
                _out[_fp] = max(-_ws, _pos[_fp] - _ws)
            else:
                _out[_fp] = 0.0
        return _out

    def _pip_align_transition_starts(self, only_track=None, current_start_var=None,
                                     current_end_var=None):
        """画中画：按转场重排各段「显示时段起点」。

        公式（用户拍板）：本段起点 = 前一段起点 + 前一段长度 − 前一段转场时长。
        xfade 吞掉转场时长 d（后段在链内提前 d 秒出现）—— 按「前段末尾」摆放时画面其实
        提前 d 秒切换，界面数字与真实切换时刻差一个 d。对齐即把起点改成真实切换时刻，
        之后手动微调 / 简易时间预览粘贴才不会错位（顺带修掉尾部多出的黑帧：链实际比
        摆放位置短 Σd，底却按摆放位置补长）。

        ⚠️ 只在画中画生效：concat 段落首尾天然相接，改起点无意义（且会破坏现有行为）。
        ⚠️ 平移必须连 show_end 一起平移：段长 = 结束 − 起始，只改起始会把段拉长 d 秒。

        only_track：只对齐这一段（编辑窗 / 总览窗口「转场对齐」按钮 = 作用于选中片段）；
                    None = 对齐全部（预留入口，不弹窗只写日志）。
        ⚠️ 2026-09-27：「一键转场」不再调用本函数（原为画中画下顺带对齐）。
           要重排起点就显式点「转场对齐」或「一键设置开始」。
        current_start_var / current_end_var：编辑窗「显示 起始/结束」输入框变量，
                    对齐当前轨时同步回写，避免点「保存」时旧局部变量把新值覆盖。
        """
        vids = [t for t in self.merge_tracks
                if getattr(t, "type", None) == "video" and (t.enabled or t is only_track)]
        _msg_noseg = _("画中画需要至少 2 个视频（主视频 + 子视频）才能对齐。")
        if len(vids) < 2:
            if only_track is not None:
                messagebox.showinfo(_("提示"), _msg_noseg)
            else:
                self._append_info_ui(_('[转场对齐] {0}').format(_msg_noseg))
            return 0
        # 主视频 = track 顺序里第一个视频轨（恒为时间轴起点，起点 0，不参与重排）。
        # ⚠️ 参考段一律按「track 顺序的紧邻前一段」取，不按当前 show_start 排序 ——
        # 否则某段被摆到后面（show_start 偏大）时，排序会把它的「前一段」错认成更后面的段
        # （表现：第2个视频对齐却用了第3个的时间；第3个对齐把自己当第2个、拿主视频当参考）。
        _main = vids[0]
        spans = {}
        for _t in vids:
            spans[_t] = self._pip_segment_span(_t, _t is _main)

        if only_track is not None:
            # 单段对齐（编辑窗「转场对齐」按钮 = 作用于当前视频）：
            # 参考 = track 顺序里紧邻的前一段，按它「当前起点 + 长度 - 转场时长」算。
            try:
                _idx = vids.index(only_track)
            except ValueError:
                return 0
            if alert_if(_idx <= 0, _("提示"), _("主视频是时间轴起点，前面没有可参考的片段，无需对齐。"), 'info'):
                return 0
            _pt = vids[_idx - 1]
            _pws, _pln = spans[_pt]
            if alert_if(_pln is None, _("提示"), _("前一段的显示长度探不到（无限循环 / 没设显示时段又取不到时长），无法对齐；\n" "给前一段填「显示 起始+结束」（或设有限循环次数）后重试。"), 'info'):
                return 0
            _d = self._pip_trans_duration(_pt)
            _new = max(0.0, _pws + _pln - _d)
            _es = only_track.enc_settings
            _cws = spans[only_track][0]
            _oe = _opt_float(_es.get("show_end"))
            if _oe is not None and _oe > _cws:
                _es["show_end"] = _ffsec(_oe + (_new - _cws))   # 整体平移，段长不变
            _es["show_start"] = _ffsec(_new)
            if current_start_var is not None:
                current_start_var.set(_ffsec(_new))
            if current_end_var is not None:
                current_end_var.set(str(_es.get("show_end", "") or ""))
            self.merge_refresh_ui()
            self._refresh_at_total_ref()
            self._append_info_ui(
                _('[转场对齐] 本段显示起点 = {0:g} + {1:g} - {2:g} = {3:g}s（段长不变，已同步「循环/绿幕控制」页）').format(_pws, _pln, _d, _new))
            return 1

        # 全量对齐（「一键转场」顺带对齐，不弹窗只写日志）：按 track 顺序串行累计，
        # 每段 = 前一段(新)起点 + 前一段长度 - 前一段转场时长；前一段长度探不到则跳过本段续算。
        prev_ws, prev_ln = spans[_main]
        prev_trans = self._pip_trans_duration(_main)
        changed, skipped = 0, 0
        for _t in vids[1:]:
            if prev_ln is None:
                # 前一段长度探不到：以本段当前起点续算，不重排本段
                _cws, _cln = spans[_t]
                prev_ws, prev_ln = _cws, _cln
                prev_trans = self._pip_trans_duration(_t)
                skipped += 1
                continue
            _cws, _cln = spans[_t]
            _new = max(0.0, prev_ws + prev_ln - prev_trans)
            _es = _t.enc_settings
            _oe = _opt_float(_es.get("show_end"))
            if _oe is not None and _oe > _cws:
                _es["show_end"] = _ffsec(_oe + (_new - _cws))
            _es["show_start"] = _ffsec(_new)
            prev_ws, prev_ln = _new, _cln
            prev_trans = self._pip_trans_duration(_t)
            changed += 1
        if changed == 0:
            _msg = (_("前一段的显示长度探不到，无法对齐；给前一段填「显示 起始+结束」"
                    "（或设有限循环次数）后重试。") if skipped else _("没有可对齐的片段。"))
            self._append_info_ui(_('[转场对齐] {0}').format(_msg))
            return 0
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            _('[转场对齐] 已按转场重排 {0} 个片段的显示起点（起点 = 前一段起点 + 前一段时长 - 转场时长）').format(changed))
        return changed

    def _pip_finite_loop_all(self, count_str=None):
        """画中画「一键有限循环」：所有子视频启用循环控制并设次数（count 模式）。

        子视频窗口有界（有限次数 / 显示结束）才能被转场链收录、时长统计才算得准；
        本按钮把「启用循环控制 + 次数」一次铺到全部子视频（不含主视频）。
        count_str 取「子视频控制」页次数框；不传 = 1（只播一遍）。
        """
        try:
            n = int(str(count_str if count_str is not None else "1").strip())
        except (ValueError, TypeError):
            messagebox.showinfo(_("提示"), _("循环次数需为正整数。"))
            return
        if alert_if(n < 1, _("提示"), _("循环次数需为正整数。"), 'info'):
            return
        vids = [t for t in self.merge_tracks
                if getattr(t, "type", None) == "video" and t.enabled]
        if alert_if(len(vids) < 2, _("提示"), _("画中画需要至少 2 个视频（主视频 + 子视频）。"), 'info'):
            return
        subs = vids[1:]     # 主视频 = 第一个视频轨，不参与
        for _t in subs:
            _t.enc_settings["loop_enabled"] = True
            _t.enc_settings["loop_mode"] = "count"
            _t.enc_settings["loop_count"] = n
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            _('[子视频控制] 已为 {0} 个子视频启用有限循环 ×{1}（次数 = 每段播放遍数，1 = 只播一遍；窗口有界后转场链/时长统计才能收录）').format(len(subs), n))

    def _pip_mix_all(self):
        """画中画「一键混音」：所有子视频（不含主视频）的音频模式切到「混音」(audio_mode=mix)。

        与「音频跟随转场」勾选框自动切混音同源（都写 enc_settings["audio_mode"]，
        即循环/绿幕控制页那条「音频:」下拉）；批量版一次铺到全部子视频。
        子视频无音轨时由 _build_pip_audio 自动降级为忽略，零副作用。
        """
        vids = [t for t in self.merge_tracks
                if getattr(t, "type", None) == "video" and t.enabled]
        if alert_if(len(vids) < 2, _("提示"), _("画中画需要至少 2 个视频（主视频 + 子视频）。"), 'info'):
            return
        subs = vids[1:]     # 主视频 = 第一个视频轨，不参与
        for _t in subs:
            _t.enc_settings["audio_mode"] = "mix"
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            _('[子视频控制] 已为 {0} 个子视频把音频模式设为「混音」（不含主视频；子视频本身无音轨时自动降级为忽略）').format(len(subs)))

    def _pip_chain_show_starts(self):
        """画中画「一键设置开始」（硬切接龙）：子视频按列表顺序首尾相接。

        第 1 个子视频接在主视频之后，之后每段 =
        前一段(新)起点 + 前一段显示长度 − 前一段转场时长（2026-09-26 用户拍板：考虑转场，
        与「转场对齐」同公式——前段挂了转场时画面会提前 d 秒切换，接龙摆位同步让位；
        硬切项目前段转场时长=0，公式自然退化为首尾相接，行为不变）；
        前一段长度探不到则跳过本段续算。
        show_end 有值时随起点整体平移（段长不变）。
        音频（混音/替换/跟随）读 show_start 派发 → 画面接龙后声音自动跟上。
        """
        vids = [t for t in self.merge_tracks
                if getattr(t, "type", None) == "video" and t.enabled]
        if alert_if(len(vids) < 2, _("提示"), _("画中画需要至少 2 个视频（主视频 + 子视频）才能接龙。"), 'info'):
            return
        _main = vids[0]     # 主视频 = 时间轴起点（起点恒 0），只当参考段
        prev_ws, prev_ln = self._pip_segment_span(_main, is_main=True)
        prev_trans = self._pip_trans_duration(_main)
        changed, skipped, _placed = 0, 0, []
        for _t in vids[1:]:
            _cws, _cln = self._pip_segment_span(_t)
            if prev_ln is None:
                # 前一段长度探不到：本段不动，以它当前起点续算
                prev_ws, prev_ln = _cws, _cln
                prev_trans = self._pip_trans_duration(_t)
                skipped += 1
                continue
            # 2026-09-26 用户拍板：接龙考虑转场——前段挂了转场时画面提前 d 秒切换，
            # 摆位同步让位（与「转场对齐」同公式）；硬切项目 prev_trans=0 退化首尾相接。
            _new = max(0.0, prev_ws + prev_ln - prev_trans)
            _es = _t.enc_settings
            _oe = _opt_float(_es.get("show_end"))
            if _oe is not None and _oe > _cws:
                _es["show_end"] = _ffsec(_oe + (_new - _cws))   # 整体平移，段长不变
            _es["show_start"] = _ffsec(_new)
            _placed.append(f"{os.path.basename(_t.file_path)[:18]}→{_ffsec(_new)}s")
            prev_ws, prev_ln = _new, _cln
            prev_trans = self._pip_trans_duration(_t)
            changed += 1
        if changed == 0:
            self._append_info_ui(
                _("[子视频控制] 没有可接龙的片段：主视频时长探不到。"))
            return
        self.merge_refresh_ui()
        self._refresh_at_total_ref()
        self._append_info_ui(
            _('[子视频控制] 已按列表顺序接龙 {0} 个子视频的显示起点（第 1 个接在主视频之后，之后每段 = 前一段起点 + 前一段时长 − 前一段转场时长；跳过 {1} 段：前一段时长探不到）').format(changed, skipped)
            + (_("；落位：") + _("、").join(_placed) if _placed else ""))

    def open_timeline_overview(self):
        """封装页「时间分配总览」入口：一条时间轴看全部片段（画中画专用）。

        窗口本身只读/写各视频轨的「显示时段」(show_start / show_end)，
        与 `_resolve_display_window` / `_pip_timeline_extent` 同源。
        """
        if not self.pip_enabled.get():
            messagebox.showinfo(
                _("提示"),
                _("时间分配总览面向【画中画】模式：子视频按「显示时段」摆在主视频的时间轴上，\n"
                "这个窗口就是那条时间轴（拖动粗调 + 数值微调）。\n\n"
                "当前未启用画中画，请先在封装页勾选「启用画中画」并加入子视频。"))
            return
        _vids = [t for t in (self.merge_tracks or [])
                 if getattr(t, "type", None) == "video" and t.enabled]
        if alert_if(len(_vids) < 2, _("提示"), _("画中画至少需要 2 个视频（主视频 + 子视频）才有时间可分配。"), 'info'):
            return
        try:
            _win = TimelineOverviewDialog(self.root, self)
            _win.transient(self.root)
            _win.grab_set()
            self.root.wait_window(_win)
        except Exception as _e:
            self._append_info_ui(_('[时间分配] 打开总览窗口失败：{0}').format(_e))

    def _add_subtitles_and_chapters(self, cmd, enabled_tracks, file_index, input_files):
        """字幕 + 章节处理"""
        # 字幕
        subtitle_tracks = [t for t in enabled_tracks if t.type == "subtitle"]
        container = self.merge_container.get().lower()
        sub_map_count = 0
        first_sub_default = False

        for sub in subtitle_tracks:
            s_idx = file_index[sub.file_path]
            cmd.extend(["-map", f"{s_idx}:s:{sub._type_index}"])

            enc = sub.enc_settings.get("encoder", "copy")
            if container == "mp4":
                if enc == "copy":
                    orig_codec = getattr(sub, 'codec', '').lower()
                    if orig_codec not in ("mov_text", "mp4s"):
                        enc = "mov_text"
                        self._append_info_ui(_('[封装] 字幕格式 {0} 不兼容 MP4，自动转换为 mov_text').format(orig_codec))
                elif enc not in ("mov_text", "mp4s"):
                    enc = "mov_text"
                    self._append_info_ui(_('[封装] 字幕编码 {0} 不兼容 MP4，自动转换为 mov_text').format(enc))

            cmd.extend([f"-c:s:{sub_map_count}", enc])

            if lang := sub.enc_settings.get("language", ""):
                cmd.extend([f"-metadata:s:s:{sub_map_count}", f"language={lang}"])
            if title := sub.enc_settings.get("title", ""):
                cmd.extend([f"-metadata:s:s:{sub_map_count}", f"title={title}"])

            disp = sub.enc_settings.get("disposition", "")
            if disp:
                cmd.extend([f"-disposition:s:{sub_map_count}", disp])
                first_sub_default = True
            elif not first_sub_default:
                cmd.extend([f"-disposition:s:{sub_map_count}", "default"])
                first_sub_default = True
            sub_map_count += 1

        # 章节
        if self.copy_chapters.get() and input_files:
            cmd.extend(["-map_chapters", "0"])
        elif input_files:
            # 未勾选「从源文件复制章节」-> 显式丢弃源章节。切勿只"不拼"：ffmpeg 默认从
            # 第一个输入复制章节，开关会失效（2026-09-14 实测确认）。若另有章节文件或
            # 「生成章节」，其 -map_chapters <idx> 在后方追加，以最后一个为准（实测）。
            cmd.extend(["-map_chapters", "-1"])

        chapter_file = self.chapter_file.get().strip()
        if chapter_file and os.path.exists(chapter_file):
            chapter_file_norm = normalize_path(chapter_file)
            try:
                first_i = cmd.index("-i")
                pos = first_i + 2
                cmd.insert(pos, "-i")
                cmd.insert(pos + 1, chapter_file_norm)
                cmd.extend(["-map_chapters", "1"])
            except ValueError:
                cmd.extend(["-i", chapter_file_norm, "-map_chapters", "1"])


    def _add_container_optimization(self, cmd, settings=None):
        """容器优化。settings=该输出用的编码设置（封装页取主视频轨道 enc_settings）；
        为 None（纯流复制等无编码参数的路径）时按「开」处理，保持旧行为。"""
        _container = self.merge_container.get().lower()
        if _container in ("mp4", "mov") and _faststart_on(settings):
            cmd.extend(["-movflags", "+faststart"])
        # HEVC 苹果兼容标记（2026-10-07）：封装页容器取自 merge_container
        cmd = append_apple_compat_tag(cmd, settings, _container)


    def _add_pip_duration_control(self, cmd, main_video, enabled_tracks, total_duration=None):
        """PIP 时长控制：根据主音频和子视频音频存在情况选择 -shortest 或 -t

        total_duration：画中画「时间轴跨度」（由 `_pip_timeline_extent` 算得，含子素材
        摆到主视频之后所需的延长）。None = 内部按子视频窗口自行算一遍（旧调用方行为）。
        """
        # 如果启用了手动时长，则跳过内部时长控制
        if self.merge_manual_duration_enabled.get():
            dur_str = self.merge_manual_duration.get().strip()
            if dur_str and time_to_seconds(dur_str) is not None:
                # 可选：打印一次提示（但每次刷新会重复，可改为只在第一次或使用标志）
                self._append_info_ui(_("[封装] 手动时长已启用，将使用用户指定的时长。"))
                return
        sub_videos = [t for t in enabled_tracks if t.type == "video"][1:]
        # 主视频启用「画布偏移(pad)」或「画布模式(canvas)」时，filtergraph 会引入
        # color=c=black:s=WxH 无限源（无 d=），若无任何时长限制会无限输出；
        # 即使没有子视频，也必须按主视频时长补 -t 截断。
        _has_infinite_canvas = bool(main_video.enc_settings.get("pad_enabled")) or \
            (bool(main_video.enc_settings.get("canvas_mode")) and
             bool(main_video.enc_settings.get("canvas_segments")))
        if not sub_videos and not _has_infinite_canvas:
            return  # 没有子视频、也没有无限画布源，主视频自身为有限流，无需时长控制
    
        # 判断主视频是否包含音频
        main_video_path = normalize_path(main_video.file_path)
        has_main_audio = any(
            normalize_path(t.file_path) == main_video_path and t.type == "audio"
            for t in enabled_tracks
        )
    
        # 判断子视频是否包含音频（任何子视频有音频即认为有子音频）
        sub_paths = [normalize_path(sv.file_path) for sv in sub_videos]
        has_sub_audio = any(
            normalize_path(t.file_path) in sub_paths and t.type == "audio"
            for t in enabled_tracks
        )
    
        # ---- 统一按主视频有效时长用 -t 精确截断 ----
        # 多子视频流(-stream_loop/loop 无限) + filter_complex 下，-shortest 依赖 muxer
        # 在最短流 EOF 时截断，实测在部分 ffmpeg 版本无法收尾（卡在结尾不结束）。
        # -t 强制在 T 秒结束最可靠，与主音频时长一致，不影响音频长度。
        # 帧对齐（floor）：与 _pip_main_effective_duration（tpad 基准）同口径，防 -t 错位
        raw_duration = self._get_media_duration(
            main_video.file_path,
            frame_align_fps=self._get_video_framerate(main_video.file_path))
        # 主视频静态图片：无时长概念（探测为 0/None），改用「截取」面板的「显示时长」
        # (img_duration)，否则回退 -shortest 会被无限循环的子视频拖到不结束。
        # （曾硬编码 10s，导致图片设了显示时长在画中画模式也一直是 10 秒。）
        if (raw_duration is None or raw_duration <= 0) and self._is_static_image(main_video.file_path):
            raw_duration = _eff_image_display_duration(main_video.enc_settings)
            self._append_info_ui(
                _('[封装] 主视频为静态图片，已按「显示时长」{0:.3f} 秒输出；可在主视频「截取」面板调整。').format(raw_duration))
        main_duration = _trimmed_duration(main_video, raw_duration)

        # ---- 时间轴延长：子素材被摆到主视频之后 → -t 用「时间轴跨度」----
        # 底已由 `_build_overlay_filter_complex` 的 tpad 补黑帧，两者必须同源，
        # 否则「补的长度」与「截断的长度」错位（画面尾部被切 / 多出黑帧）。
        # total_duration 由 `_build_pip_cmd` 单点计算传入；None 时自行按子视频窗口算一遍。
        if total_duration is None:
            total_duration = self._pip_timeline_extent(
                main_duration or 0.0, [(sv.file_path, sv.enc_settings) for sv in sub_videos])
            # 兜底路径（上游未单点传入时）同样点名无界段（正常路径已在 _build_pip_cmd 提示过）
            self._pip_warn_cut_off_subs(
                [(sv.file_path, sv.enc_settings) for sv in sub_videos], total_duration)
        if total_duration and main_duration and total_duration > main_duration + 1e-6:
            self._append_info_ui(
                _('[封装-画] 输出时长已按子素材显示时段延长：{0:.3f}s → {1:.3f}s').format(main_duration, total_duration))
        if total_duration and total_duration > 0:
            main_duration = total_duration

        if main_duration and main_duration > 0:
            cmd.extend(["-t", f"{main_duration:.3f}"])
            if has_sub_audio:
                self._append_info_ui(_('[封装] 检测到子视频音频，使用 -t {0:.3f}s 控制输出时长。').format(main_duration))
            elif has_main_audio:
                self._append_info_ui(_('[封装] 使用 -t {0:.3f}s 控制输出时长（多无限子流下 -shortest 不可靠）。').format(main_duration))
            else:
                self._append_info_ui(_('[封装] 主视频无音频，使用 -t {0:.3f}s 控制输出时长。').format(main_duration))
        else:
            # 无法计算时长，回退 -shortest
            cmd.append("-shortest")
            self._append_info_ui(_("[封装] 无法计算主视频时长，使用 -shortest 控制输出。"))

    def _build_audio_filters(self, track_settings, include_trim=True, include_volume=True,
                             include_speed=True, include_reverse=False,
                             include_fade=True, include_loudnorm=True,
                             include_denoise=True, include_channel=True,
                             include_hp=True, include_lp=True,
                             include_segments=True):
        """
        根据单个音频轨道的设置构建音频滤镜链（不含 -af 前缀）。
        返回滤镜字符串，若无滤镜则返回空字符串。
        include_reverse 作为默认倒放标志，若轨道有 audio_reverse 则优先使用。
        三种合并模式（普通封装/画中画/串行重编码）共用此函数以保证音频能力一致。

        include_segments=False 的唯一用途：串行 concat 模式会在本函数返回的链之后
        再追加「段级时长钳制 atrim+apad」与「段级淡入淡出」，链尾会被改变，
        此时分段滤镜由调用方自行追加到最末尾，保证 t 的时间基准正确。
        """
        filters = []
        # 截取起点（atrim 把 t 归零到此处），供分段滤镜换算输出时间线；默认 0（未截取）
        start_sec = 0.0
        # 截取
        if include_trim and track_settings.get("trim_enabled", False):
            start = track_settings.get("trim_start", "").strip()
            end = track_settings.get("trim_end", "").strip()
            start_sec = time_to_seconds(start) if start else 0.0
            end_sec = time_to_seconds(end) if end else None
            file_path = track_settings.get("_file_path", "")
            total = self._get_media_duration(file_path) if file_path else None
            if end_sec is not None:
                duration = end_sec - start_sec
            elif total is not None:
                duration = total - start_sec
            else:
                duration = None
            if duration is not None and duration > 0:
                filters.append(f"atrim=start={_ffsec(start_sec)}:duration={_ffsec(duration)}")
                filters.append("asetpts=PTS-STARTPTS")

        # 时间偏移对齐（音频整体延后 N 秒，用于配音与原声对齐）
        off = track_settings.get("audio_offset", 0)
        try:
            off_s = float(off) if off not in (None, "", 0) else 0.0
        except (ValueError, TypeError):
            off_s = 0.0
        if off_s > 0:
            filters.append(f"adelay=delays={off_s*1000:.0f}:all=1")

        # 音量
        if include_volume and track_settings.get("volume_enabled", False):
            vol = track_settings.get("volume", 1.0)
            if vol != 1.0:
                filters.append(f"volume={vol:.2f}")

        # 变速（音频）
        if include_speed and track_settings.get("audio_speed_enabled", False):
            factor = float(track_settings.get("audio_speed_factor", "1.0"))
            if factor != 1.0 and factor > 0:
                atempo = build_atempo_chain(factor)
                if atempo:
                    filters.append(atempo)

        # 降噪
        if include_denoise and track_settings.get("denoise_enabled", False):
            if track_settings.get("denoise_method") == "arnndn":
                filters.append("arnndn")
            else:
                nr = track_settings.get("denoise_nr", 12)
                nf = track_settings.get("denoise_nf", -30)
                filters.append(f"afftdn=nr={nr}:nf={nf}")

        # 高频/低频截止（去喷麦/去隆隆声）
        if include_hp and track_settings.get("hp_enabled"):
            filters.append(f"highpass=f={track_settings.get('hp_freq', 200)}")
        if include_lp and track_settings.get("lp_enabled"):
            filters.append(f"lowpass=f={track_settings.get('lp_freq', 3000)}")

        # 响度标准化
        if include_loudnorm and track_settings.get("loudnorm_enabled", False):
            i = track_settings.get("loudnorm_i", -23)
            lra = track_settings.get("loudnorm_lra", 7)
            tp = track_settings.get("loudnorm_tp", -2)
            filters.append(f"loudnorm=I={i}:LRA={lra}:TP={tp}")

        # 声道 / 单声道
        if include_channel:
            mode = track_settings.get("channel_mode", "stereo")
            if mode == "mono":
                filters.append("pan=mono|c0=0.5*c0+0.5*c1")
            elif mode == "left":
                filters.append("pan=mono|c0=c0")
            elif mode == "right":
                filters.append("pan=mono|c0=c1")
            elif mode == "swap":
                filters.append("pan=stereo|c0=c1|c1=c0")

        # 均衡器（EQ）：低/中/高 三段增益（dB）
        if track_settings.get("eq_enabled", False):
            eq_low = _opt_float(track_settings.get("eq_low", 0) or 0, 0.0)
            eq_mid = _opt_float(track_settings.get("eq_mid", 0) or 0, 0.0)
            eq_high = _opt_float(track_settings.get("eq_high", 0) or 0, 0.0)
            if eq_low != 0:
                filters.append(f"bass=g={eq_low:.1f}")
            if eq_mid != 0:
                filters.append(f"equalizer=f=1000:width_type=h:width=200:g={eq_mid:.1f}")
            if eq_high != 0:
                filters.append(f"treble=g={eq_high:.1f}")

        # 淡入淡出
        if include_fade and track_settings.get("fade_enabled", False):
            fin = track_settings.get("fade_in", "")
            fout = track_settings.get("fade_out", "")
            fin_s = time_to_seconds(fin) if fin else 0.0
            fout_s = time_to_seconds(fout) if fout else 0.0
            if fin_s > 0:
                filters.append(f"afade=t=in:st=0:d={fin_s:.3f}")
            if fout_s > 0:
                eff_dur = self._audio_effective_duration(track_settings, include_trim, include_speed)
                if eff_dur:
                    st = max(0.0, eff_dur - fout_s)
                    filters.append(f"afade=t=out:st={st:.3f}:d={fout_s:.3f}")
                else:
                    filters.append(f"afade=t=out:st=0:d={fout_s:.3f}")

        # 倒放：优先使用轨道独立设置，否则使用传入的 include_reverse
        track_reverse = track_settings.get("audio_reverse")
        if track_reverse is None:
            track_reverse = include_reverse
        if track_reverse:
            filters.append("areverse")

        # 音频分段效果：统一追加在所有音频滤镜的最末尾（含 areverse 之后），
        # 使 enable 表达式里的 t 恒等于「本轨输出时间线」，与转换页语义一致。
        # 时间基准换算：链序 trim→adelay→atempo→分段，t=((src-trim_start)+offset)/speed。
        if include_segments:
            _seg_sp = float(track_settings.get("audio_speed_factor", "1.0"))
            if not track_settings.get("audio_speed_enabled", False):
                _seg_sp = 1.0
            filters.extend(build_audio_segment_filters(
                track_settings.get("audio_segments"), start_sec, _seg_sp, off_s))

        # soxr 高质量重采样（对标 HandBrake）：非 auto 采样率时追加到链尾
        _sx = audio_soxr_resample_filter(track_settings)
        if _sx:
            filters.append(_sx)

        # 分离音频自由·结束（2026-09-30）：输出时间轴上的结束点，独立于「截取-结束时间」。
        # 语义（用户拍板 A）：内容从 开始(delay) 起播一次——内容比结束长 → 在结束处截断；
        # 内容比结束短 → 自然播完、后段静音（不循环，与跟随模式的 aloop 铺满相区分）。
        # 链序口径：置于链尾（分段/soxr 之后）不打乱分段 t 基准；先 asetpts 归零
        # （adelay 负 pts 静音头 → [0,开始) 静音 + 内容 [开始,..]）再 atrim=end=结束，
        # 截在输出时钟上。留空=不限（混音侧另有时间轴总长收口）。
        _fe = str(track_settings.get("audio_free_end", "") or "").strip()
        if _fe:
            _fe_s = _opt_float(_fe, 0.0)
            if _fe_s > 0:
                filters.append("asetpts=PTS-STARTPTS")
                filters.append(f"atrim=end={_ffsec(_fe_s)}")

        return ",".join(filters) if filters else ""

    def _audio_effective_duration(self, track_settings, include_trim=True, include_speed=True):
        """计算音频经 截取/偏移/变速 处理后的实际时长（用于定位 afade 淡出起点）。
        与 _build_audio_filters 内的滤镜顺序严格对应：截取 → 偏移(加头静音) → 变速(缩放)。
        """
        file_path = track_settings.get("_file_path", "")
        total = self._get_media_duration(file_path) if file_path else None
        dur = total
        # 截取
        if include_trim and track_settings.get("trim_enabled", False):
            start = track_settings.get("trim_start", "").strip()
            end = track_settings.get("trim_end", "").strip()
            start_sec = time_to_seconds(start) if start else 0.0
            end_sec = time_to_seconds(end) if end else None
            if end_sec is not None:
                dur = end_sec - start_sec
            elif total is not None:
                dur = total - start_sec
            else:
                dur = None
        # 偏移（adelay 在段头加 N 秒静音）
        off = track_settings.get("audio_offset", 0)
        try:
            off_s = float(off) if off not in (None, "", 0) else 0.0
        except (ValueError, TypeError):
            off_s = 0.0
        if dur is not None and off_s > 0:
            dur = dur + off_s
        # 变速（atempo 缩放时长）
        if include_speed and track_settings.get("audio_speed_enabled", False):
            factor = _opt_float(track_settings.get("audio_speed_factor", "1.0"), 1.0)
            if dur is not None and factor > 0:
                dur = dur / factor
        # 分离音频自由·结束：输出时间轴结束点上限（与 _build_audio_filters 链尾 atrim 同时钟）
        _fe = str(track_settings.get("audio_free_end", "") or "").strip()
        if _fe:
            _fe_s = _opt_float(_fe, 0.0)
            if _fe_s > 0 and dur is not None:
                dur = min(dur, _fe_s)
        return dur


    def _build_afade_suffix(self, settings, duration):
        """按 settings 的淡入淡出设置构建 afade 串（用于段级钳制之后，淡出精确落在段末）。"""
        if not settings.get("fade_enabled", False):
            return ""
        fin = settings.get("fade_in", "")
        fout = settings.get("fade_out", "")
        fin_s = time_to_seconds(fin) if fin else 0.0
        fout_s = time_to_seconds(fout) if fout else 0.0
        parts = []
        if fin_s > 0:
            parts.append(f"afade=t=in:st=0:d={fin_s:.3f}")
        if fout_s > 0 and duration and duration > 0:
            st = max(0.0, duration - fout_s)
            parts.append(f"afade=t=out:st={st:.3f}:d={fout_s:.3f}")
        return ",".join(parts)


    def _apply_merge_text_watermark(self, video_tracks):
        """封装页独立文字水印（2026-08-26 起封装页不再从转换页注入）：

        把封装页自己的文字水印（self._merge_tw，由「封装/合并」页底部「文字水印」
        按钮编辑）写入主视频轨道 enc_settings，供封装页 3 个模式（普通/画中画/串行）
        命令构建与各预览使用；无启用项时清除该键，避免污染。"""
        if not video_tracks:
            return
        main = video_tracks[0]
        items = self._merge_tw.get("text_watermark_items") or []
        if not items:
            _tw0 = self._merge_tw.get("text_watermark") or {}
            if _tw0.get("enabled") or _tw0.get("text"):
                items = [_tw0]
        if items:
            main.enc_settings["text_watermark_items"] = copy.deepcopy(items)
            main.enc_settings["text_watermark"] = copy.deepcopy(items[0])
        else:
            main.enc_settings.pop("text_watermark_items", None)
            main.enc_settings.pop("text_watermark", None)

    def _merge_context_main_video(self):
        """封装页上下文主视频（叠加层时间线基准）：顶部「主视频文件」框优先，
        空/无效时取轨道列表第一条启用视频（画中画直接拖轨道未填框的场景）。"""
        try:
            p = self.merge_video.get().strip()
            if p and os.path.exists(p):
                return p
        except Exception:
            pass
        try:
            main_track = next((t for t in self.merge_tracks if t.enabled and t.type == "video"), None)
            if main_track is not None and main_track.file_path and os.path.exists(main_track.file_path):
                return main_track.file_path
        except Exception:
            pass
        return ""

    def open_merge_text_watermark_dialog(self):
        """封装页独立文字水印入口（2026-08-26）：编辑 self._merge_tw，
        不再走转换页的「注入到封装页」。对话框关闭后刷新封装命令预览。"""
        parent = getattr(self, "_merge_tab_widget", None) or self.notebook
        # 主视频设置语境（轨迹编辑器背景帧预处理同源，问题④）：主轨 enc_settings
        _mctx_s = None
        try:
            mt = next((t for t in self.merge_tracks if t.enabled and t.type == "video"), None)
            if mt is not None:
                _mctx_s = mt.enc_settings
        except Exception:
            _mctx_s = None
        TextWatermarkDialog(parent, self,
                            settings_target=self._merge_tw.get("text_watermark") or {},
                            settings_container=self._merge_tw,
                            refresh_cb=self.merge_update_command_preview,
                            position_editor_cb=self._open_merge_text_wm_position_editor,
                            canvas_file=self._merge_context_main_video(),
                            canvas_settings=_mctx_s,
                            canvas_scope="merge")

    def _open_merge_text_wm_position_editor(self, dlg):
        """封装页文字水印位置编辑器：直接编辑对话框当前选中项（dlg.settings）。

        画布优先取封装页当前主视频轨道渲染尺寸，其次封装页主视频输入文件，兜底 1280x720。"""
        tw = dlg.settings
        canvas_w = canvas_h = None
        try:
            main_track = next((t for t in self.merge_tracks if t.enabled and t.type == "video"), None)
            if main_track is not None:
                canvas_w, canvas_h = self._get_canvas_size(main_track)
        except Exception:
            canvas_w = canvas_h = None
        if not canvas_w or not canvas_h:
            try:
                canvas_w, canvas_h = self._get_video_dimensions_cached(self.merge_video.get().strip())
            except Exception:
                canvas_w = canvas_h = None
        if not canvas_w or not canvas_h:
            canvas_w, canvas_h = 1280, 720
        # 背景帧语境：封装页主视频（主轨 enc_settings 与画布/背景预处理同源，2026-09-03 问题④）
        _ctx_f = self._merge_context_main_video()
        _ctx_s = None
        # 2026-09-23 pad 几何：画布=_get_canvas_size（pad 时=pad 尺寸），主视频内容必须按
        # 自身渲染尺寸 (main_render_size) 摆到 (offset_x, offset_y)，超出画布的部分留黑——
        # 与子视频位置编辑器 open_visual_overlay_editor 完全同口径。此前不传这两个参数，
        # 背景帧被拉伸铺满 pad 画布 → 「尺寸是 pad 尺寸、画面却是主视频拉伸版」。
        _ctx_off = (0, 0)
        _ctx_rsz = None
        try:
            mt = next((t for t in self.merge_tracks if t.enabled and t.type == "video"), None)
            if mt is not None:
                _ctx_s = mt.enc_settings
                _rw, _rh = self._get_video_render_size(mt)
                _ctx_rsz = (int(_rw), int(_rh))
                if mt.enc_settings.get("pad_enabled", False):
                    _ox = safe_eval_expr(str(mt.enc_settings.get("offset_x", "0") or "0"),
                                         {"W": canvas_w, "H": canvas_h}) or 0
                    _oy = safe_eval_expr(str(mt.enc_settings.get("offset_y", "0") or "0"),
                                         {"W": canvas_w, "H": canvas_h}) or 0
                    _ctx_off = (int(_ox), int(_oy))
        except Exception:
            _ctx_off, _ctx_rsz = (0, 0), None
        _open_tw_position_editor_impl(self, tw, int(canvas_w), int(canvas_h),
                                      self.merge_update_command_preview, dlg,
                                      ctx_file=_ctx_f or None, ctx_settings=_ctx_s,
                                      scope="merge",
                                      main_offset=_ctx_off, main_render_size=_ctx_rsz)

    def _build_normal_cmd(self, enabled_tracks, output_norm, only_audio=False):
        """
        普通封装模式：支持视频滤镜、多音频/字幕、音频截取、音频混合（amix）与音量调整。
        若 only_audio=True，则仅处理音频流，忽略视频和字幕。
        """
        cmd = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]
    
        # 获取所有音频轨道（无论是否仅音频模式）
        audio_tracks = [t for t in enabled_tracks if t.type == "audio"]
    
        if only_audio:
            input_files = []
            file_index = {}
            audio_tracks = [t for t in enabled_tracks if t.type == "audio"]
            for audio in audio_tracks:
                if audio.file_path not in file_index:
                    file_index[audio.file_path] = len(input_files)
                    input_files.append(audio.file_path)
            # 为每个音频轨道设置 _type_index
            for audio in audio_tracks:
                info = self._get_cached_stream_info(audio.file_path)
                if info:
                    audio_indices = [s['index'] for s in info['streams'] if s.get('codec_type') == 'audio']
                    try:
                        audio._type_index = audio_indices.index(audio.index)
                    except ValueError:
                        audio._type_index = 0
                else:
                    audio._type_index = 0
            # 然后添加输入
            for f in input_files:
                cmd.extend(["-i", normalize_path(f)])
            main_video = None
            video_reverse = False
            video_tracks = []
        else:
            # 完整模式
            input_files, file_index = self._prepare_tracks_and_inputs(enabled_tracks)
            video_tracks = [t for t in enabled_tracks if t.type == "video"]
            if not video_tracks:
                self._append_info_ui(_("[封装] 没有启用的视频轨道"))
                return []
            main_video = video_tracks[0]
            # 封装页独立文字水印：self._merge_tw 写入主轨 enc_settings（封装普通模式）
            self._apply_merge_text_watermark(video_tracks)

            # 在添加输入之前插入硬件解码参数（使用主视频设置）
            self._add_hwaccel_params(cmd, main_video.enc_settings)
    
            # 准备输入文件和索引
            input_files, file_index = self._prepare_tracks_and_inputs(enabled_tracks)
    
            # 添加输入选项（-i 及前置 -ss/-to）
            cmd = self._add_input_options(cmd, input_files, main_video)
    
            # 视频处理
            v_idx = file_index[main_video.file_path]
            v_settings = main_video.enc_settings
            vcodec = v_settings.get("encoder", "copy")
            if _is_virtual_source(main_video.file_path):
                # 颜色虚拟源不支持流复制，强制重编码（避免 -c:v copy 失败）
                vcodec = "libx264"
                v_settings["encoder"] = vcodec
            # 2026-10-09：透明输出——**主视频**颜色源 alpha<255 / 抠像 / 遮罩 / 输入带 alpha
            # ⇒ 强制 yuva420p（保留 alpha），禁用流复制；用副本避免污染原轨道设置。
            # （子视频带透明不算，见 _merge_needs_alpha 的 main-only 判据。）
            _needs_alpha = self._merge_needs_alpha(enabled_tracks)
            if _needs_alpha:
                v_settings = dict(v_settings)
                v_settings["pix_fmt_enabled"] = True
                v_settings["pix_fmt"] = "yuva420p"
                if vcodec in ("copy",):
                    vcodec = "libx264"
                    v_settings["encoder"] = vcodec
                # 2026-10-09：容器升到 .mov 还不够 —— H.264/H.265 不承载 alpha（静默丢弃，
                # 导出后透明变实色）。换成承载 alpha 的编码器（prores_ks 4444）。
                vcodec, v_settings = self._merge_alpha_encoder(vcodec, v_settings)
                self._append_info_ui(_("[封装] 检测到透明需求，主视频输出强制 yuva420p 以保留 alpha"))
            video_reverse = v_settings.get("reverse_enabled", False)
            if vcodec == "copy" and video_reverse:
                video_reverse = False
                self._append_info_ui(_("[封装] 主视频为流复制模式，已自动禁用视频倒放"))

            # 文字水印旋转判定（提前，决定是否走 filter_complex 并跳过原始视频 -map）。
            # 2026-08-26 多实例：_tw_rotate 按「首个启用项」判定；多条启用项（>1）一律走
            # filter_complex 链（build_text_watermark_chain 逐项处理旋转/非旋转）。
            _tw = v_settings.get("text_watermark", {})
            _tw_items = v_settings.get("text_watermark_items") or []
            _tw_active = [i for i in _tw_items
                          if i.get("enabled", True) and str(i.get("text", "") or "").strip()]
            _tw_any = bool(_tw_active)
            _tw_multi = len(_tw_active) > 1
            _tw0 = _tw_active[0] if _tw_active else _tw
            _tw_enabled, _tw_rotate = text_watermark_active(_tw0)
            if not (_tw_rotate or _tw_multi):
                cmd.extend(["-map", f"{v_idx}:v:{main_video._type_index}"])

            # 文字水印需要滤镜，流复制无法支持 → 强制重编码
            if vcodec == "copy" and _tw_any:
                vcodec = "libx265"
                v_settings["encoder"] = vcodec
                self._append_info_ui(_("[封装] 文字水印需要重新编码，已自动改为 libx265。"))
            # 字幕烧录需要滤镜，流复制无法支持 → 强制重编码，
            # 普通封装模式补全：主视频烧录字幕 + charenc，走 build_video_filter_chain）
            _sub_burn = v_settings.get("subtitle_enabled", False) and bool(
                (v_settings.get("subtitle_path", "") or "").strip())
            if vcodec == "copy" and _sub_burn:
                vcodec = "libx265"
                v_settings["encoder"] = vcodec
                self._append_info_ui(_("[封装] 字幕烧录需要重新编码，已自动改为 libx265。"))
            
            if vcodec == "copy":
                cmd.extend(["-c:v", "copy"])
            else:
                video_filters = build_video_filter_chain(
                    v_settings,
                    include_subtitle=_sub_burn,
                    include_speed=True,            # 主视频变速生效（音频变速由 _build_audio_filters 处理）
                    enhance_settings=v_settings.get("enhance", {}),
                    reverse=video_reverse,
                    clip_duration=self._get_media_duration(main_video.file_path),
                    # 2026-10-09：主视频也支持绿幕抠像（抠图 → 输出透明素材）。未启用时
                    # chroma_settings=None，行为与旧调用方逐字一致（零回归）。
                    chroma_settings=v_settings if v_settings.get("chroma_enabled", False) else None,
                    include_alpha=True,   # 主视频透明度（子视频走 overlay 构建器，不受影响）
                )
                if _tw_rotate or _tw_multi:
                    # 旋转或多条文字水印：主视频先接出临时标签，文字链接在后面。
                    # 时间基准统一：主视频 PTS 归零（文字子图 color 源从 0 开始，防止 overlay 前几帧黑屏）
                    main_vlabel = f"[{v_idx}:v:{main_video._type_index}]"
                    base_vf = video_filters if (video_filters and video_filters != "null") else "null"
                    fc = f"{main_vlabel}setpts=PTS-STARTPTS,{base_vf}[v_tw_base];" + build_text_watermark_chain(
                        main_video.enc_settings, main_label="[v_tw_base]", out_label="[v_tw]")
                    cmd.extend(["-filter_complex", fc])
                    cmd.extend(["-map", "[v_tw]"])
                else:
                    # 显示时段=主视频原始时间 → 按截取/变速换算输出时间线（与转换页同套，
                    # 2026-09-13 前漏传 trim_start/speed_factor，截取后窗口整体右偏）
                    _ts0, _sp0 = _trim_speed_from_settings(v_settings)
                    dt = build_drawtext_filter(_tw0, trim_start=_ts0, speed_factor=_sp0, tag="twm")
                    if dt:
                        video_filters = f"{video_filters},{dt}" if video_filters and video_filters != "null" else dt
                    if video_filters and video_filters != "null":
                        # 时间基准统一：主视频 PTS 归零（drawtext enable 时段 based 时间基准一致）
                        cmd.extend(["-vf", f"setpts=PTS-STARTPTS,{video_filters}"])
                strategy = get_encoder_strategy(vcodec)
                cmd = strategy.build_params(cmd, v_settings)
                cmd = append_video_output_extras(cmd, v_settings)
                if _needs_alpha:
                    cmd.extend(["-pix_fmt", "yuva420p"])
    
                # ---- 视频元数据 ----
                lang = main_video.language
                title = main_video.title
                if lang:
                    cmd.extend(["-metadata:s:v:0", f"language={lang}"])
                if title:
                    cmd.extend(["-metadata:s:v:0", f"title={title}"])
    
        # ---- 音频处理（所有模式） ----
        # 输出方式（2026-09-30「分离音频自由」）：mix=混音进主音频 / ignore=忽略 / stream=独立音轨(默认)。
        mix_tracks = [t for t in audio_tracks if self._audio_out_mode(t) == "mix"]

        if not mix_tracks:
            _map_list = [t for t in audio_tracks if self._audio_out_mode(t) != "ignore"]
            audio_map_count = 0
            for audio in _map_list:
                a_idx = file_index[audio.file_path]
                cmd.extend(["-map", f"{a_idx}:a:{audio._type_index}"])
                audio.enc_settings["_file_path"] = audio.file_path
                track_reverse = audio.enc_settings.get("audio_reverse", False)
                af_str = self._build_audio_filters(
                    audio.enc_settings,
                    include_trim=True,
                    include_volume=True,
                    include_speed=True,
                    include_reverse=track_reverse
                )
                enc = audio.enc_settings.get("encoder", "copy")
                sfx = audio_stream_suffix(audio_map_count)
                if af_str:
                    if enc == "copy":
                        enc = "aac"
                        self._append_info_ui(_('音频轨 {0} 应用了滤镜，编码器自动改为 aac').format(audio_map_count + 1))
                    cmd.extend(["-filter:a" + sfx, af_str])
                enc, fb = self._opus_copy_fallback(enc, audio)
                if fb:
                    self._append_info_ui(_('音频轨 {0} {1}').format(audio_map_count + 1, fb))
                if enc == "copy":
                    cmd.extend([f"-c:a:{audio_map_count}", "copy"])
                else:
                    cmd.extend(build_audio_encoder_args(
                        enc, audio.enc_settings, stream_tag=sfx,
                        skip_ar=bool(audio_soxr_resample_filter(audio.enc_settings))))
    
                # ---- 音频元数据 ----
                lang_audio = audio.language
                title_audio = audio.title
                if lang_audio:
                    cmd.extend([f"-metadata:s:a:{audio_map_count}", f"language={lang_audio}"])
                if title_audio:
                    cmd.extend([f"-metadata:s:a:{audio_map_count}", f"title={title_audio}"])
                    cmd.extend([f"-metadata:s:a:{audio_map_count}", f"handler_name={title_audio}"])
    
                audio_map_count += 1
            if audio_map_count == 0:
                cmd.append("-an")
            else:
                # 默认轨标记（disposition）：每轨可单独设置；未设置时首轨为 default
                for _mi, _a in enumerate(_map_list):
                    _disp = _a.enc_settings.get("disposition", "")
                    if _disp:
                        cmd.extend([f"-disposition:a:{_mi}", _disp])
                    elif _mi == 0:
                        cmd.extend([f"-disposition:a:{_mi}", "default"])
        else:
            # 「混音进主音频」（2026-09-30 分离音频自由）：主视频音频（若存在）作为混音底，
            # 全部混音轨 additively amix（normalize=0 求和，与画中画/串联级联同口径）；
            # 未混音轨（stream）照常独立 -map —— 旧实现「有混音时未勾选轨道被丢弃」已废除。
            _main_path = normalize_path(main_video.file_path) if main_video is not None else None
            _main_a = next((t for t in audio_tracks
                            if _main_path and normalize_path(t.file_path) == _main_path), None)
            if _main_a is not None and self._audio_out_mode(_main_a) == "ignore":
                _main_a = None   # 主视频音频条目被设为忽略 → 不输出也不作混音底
            _stream_tracks = [t for t in audio_tracks
                              if self._audio_out_mode(t) == "stream" and t is not _main_a]
            # ---- 独立音轨照常 -map（含元数据/disposition） ----
            _smap = 0
            for audio in _stream_tracks:
                a_idx = file_index[audio.file_path]
                cmd.extend(["-map", f"{a_idx}:a:{audio._type_index}"])
                audio.enc_settings["_file_path"] = audio.file_path
                track_reverse = audio.enc_settings.get("audio_reverse", False)
                af_str = self._build_audio_filters(
                    audio.enc_settings,
                    include_trim=True,
                    include_volume=True,
                    include_speed=True,
                    include_reverse=track_reverse
                )
                enc = audio.enc_settings.get("encoder", "copy")
                sfx = audio_stream_suffix(_smap)
                if af_str:
                    if enc == "copy":
                        enc = "aac"
                        self._append_info_ui(_('音频轨 {0} 应用了滤镜，编码器自动改为 aac').format(_smap + 1))
                    cmd.extend(["-filter:a" + sfx, af_str])
                enc, fb = self._opus_copy_fallback(enc, audio)
                if fb:
                    self._append_info_ui(_('音频轨 {0} {1}').format(_smap + 1, fb))
                if enc == "copy":
                    cmd.extend([f"-c:a:{_smap}", "copy"])
                else:
                    cmd.extend(build_audio_encoder_args(
                        enc, audio.enc_settings, stream_tag=sfx,
                        skip_ar=bool(audio_soxr_resample_filter(audio.enc_settings))))
                lang_audio = audio.language
                title_audio = audio.title
                if lang_audio:
                    cmd.extend([f"-metadata:s:a:{_smap}", f"language={lang_audio}"])
                if title_audio:
                    cmd.extend([f"-metadata:s:a:{_smap}", f"title={title_audio}"])
                    cmd.extend([f"-metadata:s:a:{_smap}", f"handler_name={title_audio}"])
                _adisp = audio.enc_settings.get("disposition", "")
                if _adisp:
                    cmd.extend([f"-disposition:a:{_smap}", _adisp])
                _smap += 1
            # ---- 混音图：主音频底（若存在）+ 全部混音轨 ----
            _mix_ins = list(mix_tracks)
            if _main_a is not None and not any(t is _main_a for t in _mix_ins):
                _mix_ins = [_main_a] + _mix_ins   # 主音频作为混音底（「混音进主音频」的目标）
            # 主音频底缺失（主视频无音频条目或条目被设为「忽略」）→ anullsrc 静音底子
            # （有界到主视频时长）：混音轨的「开始」落位仍落在输出时间轴上
            # （用户 2026-09-30：忽略 = 静音的底子，不是退化成独立输出）。
            _silent_bed = False
            if _main_a is None and _mix_ins:
                _bed_T = None
                try:
                    if main_video is not None:
                        _bed_T = self._get_media_duration(main_video.file_path)
                except Exception:
                    _bed_T = None
                if _bed_T and _bed_T > 0:
                    _silent_bed = True
            if len(_mix_ins) <= 1 and not _silent_bed:
                # 无可混对象（主视频无音频且只有一条混音轨）→ 退化为该轨独立输出
                audio = _mix_ins[0] if _mix_ins else None
                if audio is not None:
                    a_idx = file_index[audio.file_path]
                    cmd.extend(["-map", f"{a_idx}:a:{audio._type_index}"])
                    audio.enc_settings["_file_path"] = audio.file_path
                    af_str = self._build_audio_filters(
                        audio.enc_settings,
                        include_trim=True,
                        include_volume=True,
                        include_speed=True,
                        include_reverse=audio.enc_settings.get("audio_reverse", False)
                    )
                    enc = audio.enc_settings.get("encoder", "copy")
                    sfx = audio_stream_suffix(_smap)
                    if af_str:
                        if enc == "copy":
                            enc = "aac"
                            self._append_info_ui(_("单流混合（音量/截取/倒放）强制编码为 aac"))
                        cmd.extend(["-filter:a" + sfx, af_str])
                    enc, fb = self._opus_copy_fallback(enc, audio)
                    if fb:
                        self._append_info_ui(_('[封装] {0}').format(fb))
                    if enc == "copy":
                        cmd.extend([f"-c:a:{_smap}", "copy"])
                    else:
                        cmd.extend(build_audio_encoder_args(
                            enc, audio.enc_settings, stream_tag=sfx,
                            skip_ar=bool(audio_soxr_resample_filter(audio.enc_settings))))
                    lang = audio.language
                    title = audio.title
                    if lang:
                        cmd.extend([f"-metadata:s:a:{_smap}", f"language={lang}"])
                    if title:
                        cmd.extend([f"-metadata:s:a:{_smap}", f"title={title}"])
                        cmd.extend([f"-metadata:s:a:{_smap}", f"handler_name={title}"])
                    disp = audio.enc_settings.get("disposition", "")
                    if disp:
                        cmd.extend([f"-disposition:a:{_smap}", disp])
                    _smap += 1
            else:
                filter_parts = []
                _base = 0
                if _silent_bed:
                    filter_parts.append(f"anullsrc=r=48000:cl=stereo,atrim=0:{_ffsec(_bed_T)}[a0]")
                    _base = 1
                for i, audio in enumerate(_mix_ins):
                    a_idx = file_index[audio.file_path]
                    audio.enc_settings["_file_path"] = audio.file_path
                    af_str = self._build_audio_filters(
                        audio.enc_settings,
                        include_trim=True,
                        include_volume=True,
                        include_speed=True,
                        include_reverse=audio.enc_settings.get("audio_reverse", False)
                    )
                    if af_str:
                        filter_parts.append(f"[{a_idx}:a]{af_str}[a{i + _base}]")
                    else:
                        filter_parts.append(f"[{a_idx}:a]asetpts=PTS-STARTPTS[a{i + _base}]")
                _n_in = len(_mix_ins) + _base
                amix_filter = (f"{' '.join(f'[a{i}]' for i in range(_n_in))}"
                               f"amix=inputs={_n_in}:duration=longest:normalize=0[aout]")
                filter_parts.append(amix_filter)
                cmd.extend(["-filter_complex", ";".join(filter_parts)])
                cmd.extend(["-map", "[aout]"])
                first_mix = _mix_ins[0]
                enc = first_mix.enc_settings.get("encoder", "aac")
                if enc == "copy":
                    enc = "aac"
                    self._append_info_ui(_("[封装] 混合模式下编码器不能为 copy，已自动改为 aac"))
                cmd.extend(build_audio_encoder_args(
                    enc, first_mix.enc_settings,
                    skip_ar=bool(audio_soxr_resample_filter(first_mix.enc_settings))))
                # ---- 混音输出流元数据（流索引 = 已映射的独立轨数） ----
                lang = first_mix.language
                title = first_mix.title
                if lang:
                    cmd.extend([f"-metadata:s:a:{_smap}", f"language={lang}"])
                if title:
                    cmd.extend([f"-metadata:s:a:{_smap}", f"title={title}"])
                    cmd.extend([f"-metadata:s:a:{_smap}", f"handler_name={title}"])
                disp = first_mix.enc_settings.get("disposition", "")
                if disp:
                    cmd.extend([f"-disposition:a:{_smap}", disp])
                _smap += 1
            # disposition：尚无显式设置时首条输出轨 default
            if _smap > 0 and "-disposition:a:0" not in cmd:
                cmd.extend(["-disposition:a:0", "default"])
    
        if only_audio:
            cmd.append("-vn")
    
        # 字幕与章节（仅非仅音频模式）
        if not only_audio:
            self._add_subtitles_and_chapters(cmd, enabled_tracks, file_index, input_files)
    
        # 容器优化
        container = self.merge_container.get().lower()
        if container in ("mp4", "mov") and not only_audio and _faststart_on(
                main_video.enc_settings if main_video is not None else None):
            cmd.extend(["-movflags", "+faststart"])
        # HEVC 苹果兼容标记（2026-10-07）：封装页容器取自 merge_container
        cmd = append_apple_compat_tag(
            cmd, main_video.enc_settings if main_video is not None else None, container)
    
        # 文字水印（旋转/spin）无限源时长限制：有音频用 -shortest，无音频用 -t（主视频时长）。
        # ⚠️ only_audio 时 main_video 为 None，且仅音频模式不会注入文字水印（命令无
        # color=c=black@0 标记，函数内部也会自动跳过）——必须跳过，否则访问
        # main_video.file_path 直接 NoneType AttributeError（普通模式选「仅音频」即触发）。
        if not only_audio and main_video is not None:
            _ensure_tw_duration_limit(
                self, cmd, input_path=main_video.file_path,
                # 帧对齐：与 _pip_main_effective_duration / -t 同口径
                main_duration=self._get_media_duration(
                    main_video.file_path,
                    frame_align_fps=self._get_video_framerate(main_video.file_path)),
                audio_enabled=True,
                image_display_duration=_merge_output_total_duration(self, enabled_tracks))

        # 主视频为静态图片（无真实时长概念）：用「截取」面板的「显示时长」控制输出长度，
        # 否则 -loop 1 无限源会无限输出。文字水印路径已由 _ensure_tw_duration_limit 注入 -t，
        # 这里兜底「无文字水印 / 无音频」的情况（与 串行合并 37790、转换页 28901 同源）。
        if (not only_audio and main_video is not None and
                self._is_static_image(main_video.file_path) and
                "-t" not in cmd and "-to" not in cmd and "-shortest" not in cmd):
            _img_dur = _eff_image_display_duration(main_video.enc_settings)
            if _img_dur and _img_dur > 0:
                cmd.extend(["-t", f"{_img_dur:.3f}"])

        cmd.append(output_norm)
        return cmd
    
    
    def _build_pip_cmd(self, enabled_tracks, output_norm):
        """画中画模式（叠加多个视频）"""
        # 强制禁用组合跳转
        for track in enabled_tracks:
            if track.type == "video":
                track.enc_settings["combo_seek"] = False
    
        cmd = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]
        input_files, file_index = self._prepare_tracks_and_inputs(enabled_tracks)
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if not video_tracks:
            self._append_info_ui(_("[封装-画] 没有启用的视频轨道"))
            return []
        main_video = video_tracks[0]
        # 封装页独立文字水印：self._merge_tw 写入主轨 enc_settings（封装画中画模式）
        self._apply_merge_text_watermark(video_tracks)
        # 2026-10-09：透明输出需求（**主视频**是颜色源 alpha<255 / 抠像 / 遮罩 / alpha 输入）
        # → 主视频强制 yuva420p 保留 alpha 通道（覆盖层 overlay 才能透出背景）。
        # 子视频带透明不触发（见 _merge_needs_alpha）。
        # 2026-10-14：「视频节点」里插入的效果也算（`_graph_alpha_from_node_fx`）——
        # 它不进 settings / 轨道，旧判据看不见 ⇒ 节点遮罩要手选像素格式。
        # （画中画是本判据唯一合法的调用场景，见其 docstring；只算一次，别重复探图。）
        _nfx_alpha = self._graph_alpha_from_node_fx()
        _needs_alpha = (self._merge_needs_alpha(enabled_tracks) or _nfx_alpha)
        if _needs_alpha:
            if _nfx_alpha:
                self._log_alpha_once(
                    "pip_yuva_nfx",
                    _("[封装-画] 检测到「视频节点」里插入的透明效果，输出强制 yuva420p 以保留 alpha"))
            main_video.enc_settings["pix_fmt_enabled"] = True
            main_video.enc_settings["pix_fmt"] = "yuva420p"
            self._append_info_ui(
                _("[封装-画] 检测到透明需求（主视频透明，或主视频之后那段里显示的子视频带透明），"
                "输出强制 yuva420p 以保留 alpha"))
        sub_videos = video_tracks[1:]

        # 画中画 BGM 全局叠加：主视频启用且文件有效时，把 BGM 作为额外输入挂载（仅垫主视频音频之下）
        _bgm_path = (main_video.enc_settings.get("bgm_audio_path", "") or "").strip()
        _bgm_on = bool(main_video.enc_settings.get("bgm_enabled", False)) and bool(_bgm_path) and os.path.isfile(_bgm_path)
        if _bgm_on:
            _bgm_norm = normalize_path(_bgm_path)
            if _bgm_norm not in input_files:
                input_files.append(_bgm_norm)
                file_index = {f: i for i, f in enumerate(input_files)}

        # 画中画模式下强制使用精准截取（由滤镜处理）
        self._add_hwaccel_params(cmd, main_video.enc_settings)
        main_video.enc_settings["precise_trim"] = True
        cmd = self._add_input_options(cmd, input_files, main_video, sub_videos)

        main_idx = file_index[main_video.file_path]

        
        # ---- 构建子视频信息列表（临时复制设置，避免修改原轨道） ----
        sub_infos = []
        for sv in sub_videos:
            sv_settings = sv.enc_settings.copy()   # 复制一份，不影响原轨道
            
            if sv_settings.get("encoder") == "copy":
                sv_settings["encoder"] = "libx265"
                self._append_info_ui(f"[封装-画] 从视频 {os.path.basename(sv.file_path)} copy 已临时改为 libx265（画中画必须重新编码）")
            
            sub_infos.append((file_index[sv.file_path], sv.file_path, sv_settings))
    
        # 获取倒放标志，同时检测视频编码器（画中画强制重新编码，但为保险仍做检测）
        vcodec = main_video.enc_settings.get("encoder", "libx265")
        # 2026-10-09 透明真生效：H.264/H.265 等不承载 alpha（yuva420p 输入被静默降为 yuv420p、
        # alpha 全填 255）⇒ 透明输出换成 prores_ks 4444。_alpha_enc_settings 只喂给
        # build_params，不写回轨道设置（避免把用户选的编码器持久改掉）。
        _alpha_enc_settings = None
        if _needs_alpha:
            vcodec, _alpha_enc_settings = self._merge_alpha_encoder(vcodec, main_video.enc_settings)
        reverse_flag = main_video.enc_settings.get("reverse_enabled", False)
        if vcodec == "copy" and reverse_flag:
            reverse_flag = False
        #    self._append_info_ui("[封装] 画中画模式视频为 copy（理论上不会发生），已禁用音频倒放")
            # 但画中画模式已经强制将 copy 改为 libx265，所以此分支通常不会执行
    
        # 构建叠加滤镜（传递 reverse_flag 用于视频倒放） 检查主视频是否启用字幕烧录
        # （2026-08-27 曾临时恒 False 隐藏接口，用户澄清要的是 UI 隐藏——恢复读取；
        #  封装页 UI 已隐藏烧录字幕行，enc_settings 无来源，恒 False 等效）
        include_subtitle_main = main_video.enc_settings.get("subtitle_enabled", False) and bool(main_video.enc_settings.get("subtitle_path", "").strip())
        # ---- 画中画时间轴跨度：子素材被摆到主视频之后时，底补黑帧 + 输出 -t 跟着延长 ----
        # 单点计算（这里算一次，传给滤镜构建与 -t 两处），避免两处口径漂移。
        _pip_main_dur = self._pip_main_effective_duration(main_video)
        _pip_total_dur = self._pip_timeline_extent(
            _pip_main_dur, [(_p, _s) for (_i, _p, _s) in sub_infos])
        # 起点 ≥ 输出时长的无界段 = 整段会被截掉 → 点名提醒（忘了开有限时长）
        # ⚠️ 函数按 (path, settings) 二元组解包 → 必须先剥掉 file_index（与上行 extent 同口径）
        self._pip_warn_cut_off_subs(
            [(_p, _s) for (_i, _p, _s) in sub_infos], _pip_total_dur)
        _pip_tail_pad = max(0.0, _pip_total_dur - _pip_main_dur)
        if _pip_tail_pad > 0:
            self._append_info_ui(
                f"[封装-画] 子素材显示时段超出主视频时长（{_pip_main_dur:.3f}s），"
                f"已自动延长输出时间轴到 {_pip_total_dur:.3f}s（主视频尾部补黑帧）")
        complex_filter, final_v_label = self._build_overlay_filter_complex(
            main_idx, main_video.enc_settings, sub_infos,
            include_subtitle_main=include_subtitle_main,
            enhance_settings=main_video.enc_settings.get("enhance", {}),
            reverse=reverse_flag,
            main_file_path=main_video.file_path,
            main_tail_pad=_pip_tail_pad,
            main_effective_duration=(_pip_main_dur if _pip_main_dur > 0 else None),
            node_fx_record_raw=True,
            wp_sendcmd=True,
            # 需要 alpha 时，主视频之后的补帧改**透明**补（否则那段子视频的透明被黑垫掉，
            # 导出的 .mov alpha 全填 255 = 白升 alpha 编码器）。见 _pip_needs_alpha。
            tail_pad_alpha=_needs_alpha
        )
        # 音频跟随转场（每个子视频独立开关，默认取消）：
        # 开启的视频，其音频按转场链真实输出位置 P_k（xfade 交叉起点）定位 —— 与画面逐帧对齐，
        # 类似 concat 的音频跟随。delta = P_k − 该段显示起点 ws（手动错位也能自动校正）；
        # 未开启 / 未成链 → delta=0（原位置）。
        # ⚠️ 旧实现用 shift_of=−Σ转场时长，与 xfade 已压缩的时间轴**重复扣减**，导致音频比画面
        # 提前一截（用户实测 2nd→3rd 子声早 6s、口型对不上）。改为直接用链的真实位置 P_k。
        try:
            _chains = self._pip_transition_chains(
                sub_infos, main_video.enc_settings, main_video.file_path,
                _pip_main_dur)[0]
        except Exception:
            _chains = []
        _pip_audio_shift = self._pip_audio_follow_shift(
            sub_videos, _chains, sub_infos, main_video)
        # 追加文字水印（在 overlay 之后；旋转时走透明层+rotate+overlay 子图）
        tw_settings = main_video.enc_settings.get("text_watermark", {})
        tw_frag = build_text_watermark_chain(main_video.enc_settings, main_label=final_v_label, out_label="[v_dtext]")
        if tw_frag:
            complex_filter = f"{complex_filter};{tw_frag}"
            final_v_label = "[v_dtext]"
        # ---- 音频组装（方案 A：BGM 仅垫主视频音频之下，子视频音频保持独立音轨） ----
        # 须在 -filter_complex 之前算好音频滤镜段，并拼进 complex_filter；
        # a_maps / a_enc 在视频编码后挂到 cmd。
        _bgm_idx = None
        _bgm_vol = 0.3
        _pip_dur = self._pip_main_duration(main_video)
        # 时间轴被延长时 BGM 也跟着铺满（否则后半段静音）。
        # 零延长时 _pip_total_dur == 主视频时长口径 → 本行不触发，BGM 行为逐字不变。
        if _pip_total_dur and _pip_total_dur > _pip_dur:
            _pip_dur = _pip_total_dur
        if _bgm_on:
            _bgm_idx = file_index.get(normalize_path(_bgm_path))
            _bgm_vol = _opt_float(main_video.enc_settings.get("bgm_volume", 0.3) or 0.3, 0.3)
        # 音频床与画面同源：时间轴延长后，参与 amix 的各条音频都要跟着有界到 _pip_total_dur，
        # 否则延长段静音（子素材摆到主视频之后时「混音/替换」看起来没生效）。
        a_parts, a_maps, a_enc = self._build_pip_audio(
            enabled_tracks, file_index, main_video, _bgm_on, _bgm_idx, _bgm_vol, _pip_dur,
            total_duration=(_pip_total_dur if (_pip_total_dur and _pip_total_dur > 0) else None),
            audio_shift=(_pip_audio_shift or None))
        if a_parts:
            complex_filter = complex_filter + ";" + ";".join(a_parts)
        # 「音频节点」定稿：PiP 音频段由上方 _build_pip_audio 追加进 complex_filter，
        # 必须等音频拼进来后，才能把完整图（视频+音频）存为 self._last_graph
        # —— 它是右键「节点」对话框（视频/音频节点列表）的数据源，也是音频节点效果
        # 的插入基准。提前在 _build_overlay_filter_complex 里快照只会拿到纯视频图
        # ⇒ 对话框读不到音频节点、音频效果也插不进音频链（2026-09-26 修复）。
        self._last_graph = complex_filter
        self._last_graph_sig = self._graph_media_signature()
        self._last_graph_gen = getattr(self, "_graph_gen", 0)
        self._graph_dirty = False      # 本次构图产出 ⇒ 缓存重新可信
        if getattr(self, "node_audio_fx", None):
            try:
                complex_filter, _fx_final_lbl = self._apply_node_audio_fx(
                    complex_filter, "out", anchor_nodes=None)
            except Exception as _e:
                self._append_info_ui(f"[音频节点] 应用失败（按原图继续）: {_e}")
        cmd.extend(["-filter_complex", complex_filter])
        cmd.extend(["-map", final_v_label])

        # 视频编码（PIP强制不使用 copy）
        if vcodec == "copy":
            self._append_info_ui(_("[封装-画] 画中画模式不支持 copy，自动改为 libx265"))
            vcodec = "libx265"
            main_video.enc_settings["encoder"] = vcodec
        strategy = get_encoder_strategy(vcodec)
        cmd = strategy.build_params(
            cmd, _alpha_enc_settings if _alpha_enc_settings is not None else main_video.enc_settings)
        cmd = append_video_output_extras(
            cmd, _alpha_enc_settings if _alpha_enc_settings is not None else main_video.enc_settings)
        if _needs_alpha:
            cmd.extend(["-pix_fmt", "yuva420p"])

        # 音频输出映射与编码（取代原 _add_audio_tracks 的多音轨直挂）
        # BGM 关闭时 a_maps/a_enc 仍由原多音轨逻辑填充；两者皆空则禁音。
        if a_maps:
            cmd.extend(a_maps)
            cmd.extend(a_enc)
        else:
            cmd.append("-an")

        self._add_subtitles_and_chapters(cmd, enabled_tracks, file_index, input_files)
        self._add_pip_duration_control(cmd, main_video, enabled_tracks,
                                       total_duration=_pip_total_dur)
        self._add_container_optimization(
            cmd, main_video.enc_settings if main_video is not None else None)
        cmd.append(output_norm)
        return cmd

    def _compute_concat_transitions(self, video_tracks):
        """复算串行合并各段「处理后时长」与「生效转场」(type, dur)，与 _build_concat_video_graph 完全对齐。
        供 _generate_concat_chapters 复用，使章节起点与 xfade offset 公式一致。
        返回 (seg_durations, trans_effective)：
          - seg_durations[i]：段 i 处理后时长（秒，含图片显示时长 / 截取 / 变速；<=0 回退 10.0）
          - trans_effective[i]：(type, dur) 或 None（段 i 未开转场 / 末段 / 被钳制丢弃）
        """
        seg_durations = []
        for _t in video_tracks:
            if self._is_static_image(_t.file_path):
                _d = _eff_image_display_duration(_t.enc_settings)
            else:
                _d = self._get_effective_duration(_t.enc_settings, input_path=_t.file_path)
            if _d is None or _d <= 0:
                _d = 10.0
            seg_durations.append(_d)
        n = len(video_tracks)
        trans_effective = [None] * n
        for i in range(n):
            if i >= n - 1:
                break
            _ts = video_tracks[i].enc_settings
            if not _ts.get("transition_enabled", False):
                continue
            _ttype = str(_ts.get("transition_type", "fade") or "fade").strip()
            if _ttype not in XFADE_TRANSITIONS:
                _ttype = "fade"
            try:
                _td = float(str(_ts.get("transition_duration", "1.0") or "1.0").strip())
            except ValueError:
                _td = 1.0
            if _td <= 0 or seg_durations[i] <= 0 or seg_durations[i + 1] <= 0:
                continue
            _td = min(_td, min(seg_durations[i], seg_durations[i + 1]) / 2.0)
            if _td < 0.05:
                continue
            trans_effective[i] = (_ttype, _td)
        return seg_durations, trans_effective

    def _generate_concat_chapters(self, video_tracks):
        """为串行合并生成 FFmetadata 临时文件，返回 (path, cleanup_list)。
        根据每个视频轨道的 chapter_label 和时长自动创建章节条目。"""
        import tempfile
        if not video_tracks:
            return None, []
        
        fd, meta_path = tempfile.mkstemp(suffix='.txt', prefix='chapters_', text=True)
        try:
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                f.write(";FFMETADATA1\n")
                cumulative_ms = 0
                # 与 _build_concat_video_graph 对齐：复算各段时长与生效转场，
                # 段 i(i>=1) 的章节起点回退「前一段」转场时长，消除 xfade 重叠导致的章节后移。
                seg_durations, trans_effective = self._compute_concat_transitions(video_tracks)
                for i, track in enumerate(video_tracks):
                    label = track.enc_settings.get("chapter_label", "").strip()
                    # 该片段的处理后时长（秒），与成片视频链一致（含图片/截取/变速）
                    effective_dur = seg_durations[i]
                    dur_ms = int(effective_dur * 1000)
                    # 转场重叠：段 i 起点 = 前段累计 - 前一段转场时长（xfade offset 公式）
                    start_ms = cumulative_ms
                    if i > 0 and trans_effective[i - 1] is not None:
                        start_ms = max(0, start_ms - int(trans_effective[i - 1][1] * 1000))
                    title = label if label else _('片段 {0}').format(i+1)
                    end_ms = start_ms + dur_ms
                    f.write("[CHAPTER]\n")
                    f.write("TIMEBASE=1/1000\n")
                    f.write(f"START={start_ms}\n")
                    f.write(f"END={end_ms}\n")
                    f.write(f"title={title}\n")
                    cumulative_ms = end_ms
        except Exception as e:
            try:
                os.unlink(meta_path)
            except OSError:
                pass
            self._append_info_ui(_("[章节] 生成 FFmetadata 失败: {0}").format(e))
            return None, []
        
        cleanup_list = [meta_path]
        self._append_info_ui(_("[章节] 已生成 {0} 个章节标记 ({1})").format(len(video_tracks), os.path.basename(meta_path)))
        return meta_path, cleanup_list

    def _inject_chapters_into_cmd(self, cmd_list, meta_path):
        """将 FFmetadata 章节文件注入到已构建的命令中。"""
        if not cmd_list:
            return cmd_list
        
        # 统计现有输入文件数（以 -i 计数）
        input_count = sum(1 for a in cmd_list if a == "-i")
        
        # 找到最后一个输入文件后的位置，在 -filter_complex / -map 之前插入
        insert_pos = len(cmd_list) - 1  # 默认在输出文件前
        # 倒找最后一个输出文件（以最后一个非选项参数为输出，通常是扩展名结尾）
        # 更可靠的做法：在 -filter_complex 或 -map 之前插入 metadata 输入
        for idx, arg in enumerate(cmd_list):
            if arg in ("-filter_complex", "-map", "-c:v", "-c:a", "-vn", "-an"):
                insert_pos = idx
                break
        
        # 在当前 insert_pos 处插入 -i meta_path -map_chapters N
        inject = ["-i", normalize_path(meta_path), "-map_chapters", str(input_count)]
        new_cmd = cmd_list[:insert_pos] + inject + cmd_list[insert_pos:]
        return new_cmd

    def _build_concat_cmd(self, enabled_tracks, output_norm, preview=False):
        """
        生成串行合并（Concat）命令。
        支持两种模式：
        1. 流复制模式（最高效，使用 concat demuxer）
        2. 重新编码模式（使用 filter_complex concat）
        """
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if not video_tracks:
            self._append_info_ui(_("[串联] 没有启用的视频轨道"))
            return []

        audio_tracks = [t for t in enabled_tracks if t.type == "audio"]
        main_video = video_tracks[0]
        # 封装页独立文字水印：self._merge_tw 写入主轨 enc_settings（封装串行模式）
        self._apply_merge_text_watermark(video_tracks)

        # 判断使用哪种模式
        vcodec = main_video.enc_settings.get("encoder", "copy")
        acodec = audio_tracks[0].enc_settings.get("encoder", "copy") if audio_tracks else "copy"

        use_copy_mode = (vcodec == "copy") and (acodec == "copy" or not audio_tracks)

        # 2026-10-08：「禁用解析」反向强制 concat demuxer（concat.txt）流复制模式。
        # 等同手动把主视频编码器设为 copy —— 优先走 concat.txt（不解码、只按容器拼接，速度最快），
        # 且**不破坏任何滤镜**：下方文字水印/画布/混音/图片四类硬需求仍会照常把模式翻回重编码，
        # 与「手动选 copy + 挂滤镜」的表现逐字一致。仅「串行合并模式 且 开关已勾」时生效。
        if self._merge_probe_skipped():
            use_copy_mode = True

        # 文字水印或图片水印需要滤镜，流复制无法支持 → 强制重编码
        # 2026-08-26 多实例：任一启用项有文字即需重编码（不只看首条 enabled）
        _tw_items_c = main_video.enc_settings.get("text_watermark_items") or []
        _tw_any_c = any(i.get("enabled", True) and str(i.get("text", "") or "").strip()
                        for i in _tw_items_c) or bool(
            main_video.enc_settings.get("text_watermark", {}).get("enabled", False))
        if use_copy_mode and _tw_any_c:
            self._append_info_ui(_("[串联] 文字水印需要重新编码，自动切换到重新编码模式。"))
            use_copy_mode = False

        # 画布模式（位置、尺寸、旋转）需要滤镜（color/scale/rotate/overlay），流复制无法支持 → 强制重编码。
        # 与文字水印同一先例：任一启用画布的段即需重编码（不只看首条 enabled）。
        _canvas_any_c = any(
            bool(t.enc_settings.get("canvas_mode")) and bool(t.enc_settings.get("canvas_segments"))
            for t in video_tracks)
        if use_copy_mode and _canvas_any_c:
            self._append_info_ui(_("[串联] 画布模式（位置、尺寸、旋转）需要重新编码，自动切换到重新编码模式。"))
            use_copy_mode = False

        # 独立音频轨「混音进主音频」需要 filter_complex amix，流复制无法支持 → 强制重编码。
        _free_mix_any_c = any(self._audio_out_mode(t) == "mix" for t in audio_tracks)
        if use_copy_mode and _free_mix_any_c:
            self._append_info_ui(_("[串联] 自由音频「混音进主音频」需要重新编码，自动切换到重新编码模式。"))
            use_copy_mode = False

        # 图片素材无法走 concat demuxer 流复制（-c:v copy 只能拼视频流）→ 强制重编码。
        _img_any_c = any(self._is_static_image(t.file_path) for t in video_tracks)
        if use_copy_mode and _img_any_c:
            self._append_info_ui(_("[串联] 含图片素材，自动切换到重新编码模式（图片无法流复制拼接）。"))
            use_copy_mode = False

        # 透明输出（任一轨命中，见 `_merge_needs_alpha` 的 concat 口径）无法流复制：需要
        # `-pix_fmt yuva420p` + 承载 alpha 的编码器，二者都要求重新编码；且透明段多来自
        # 透明色块 / 抠像 / 遮罩这类**滤镜**，流复制会把它们整段丢掉（静默）。→ 强制重编码。
        # 2026-10-12 补齐：此前默认 encoder=copy 的串联工程带透明时走 copy 模式 ⇒ 上面
        # `_build_concat_reencode_mode` 那套 alpha 处理根本不执行，导出必错。
        if use_copy_mode and self._merge_needs_alpha(video_tracks):
            self._append_info_ui(_("[串联] 检测到透明需求（任一段），自动切换到重新编码模式以保留 alpha。"))
            use_copy_mode = False

        cmd = [self.ffmpeg_cmd, "-y", "-fflags", "+genpts"]

        # 硬件解码参数（流复制模式通常无需，但保留以兼容）
        if video_tracks:
            self._add_hwaccel_params(cmd, video_tracks[0].enc_settings)

        if use_copy_mode:
            if not self._check_video_params_consistent(video_tracks, silent=True):  # silent=True 避免内部打印
                self._append_info_ui(_("[串联] 检测到视频参数不一致，可在规格列查看，自动切换到重新编码模式以确保兼容性。"))
                use_copy_mode = False
        
        if use_copy_mode:
            cmd_list = self._build_concat_copy_mode(cmd, video_tracks, audio_tracks, output_norm, preview=preview)
        else:
            cmd_list = self._build_concat_reencode_mode(cmd, video_tracks, audio_tracks, main_video, output_norm)

        # 生成章节：如果勾选了"生成章节"，注入 FFmetadata 文件（跳过预览模式）
        if self.generate_chapters.get() and not preview:
            meta_path, cleanup = self._generate_concat_chapters(video_tracks)
            if meta_path:
                cmd_list = self._inject_chapters_into_cmd(cmd_list, meta_path)
                if not hasattr(self, '_temp_concat_lists'):
                    self._temp_concat_lists = []
                self._temp_concat_lists.extend(cleanup)
        return cmd_list

    def _build_concat_copy_mode(self, cmd, video_tracks, audio_tracks, output_norm, preview=False):
        """流复制模式 - 使用 concat demuxer（最高性能）"""
        import tempfile
    
        if preview:
            # 预览模式：使用占位符，不创建实际文件
            list_path = "concat_random.txt"
            self._append_info_ui(_("[串联-流] 预览命令，txt列表使用占位名，点击开始合并后随机生成"))
        else:
            # 实际执行：创建临时文件
            fd, list_path = tempfile.mkstemp(suffix='.txt', prefix='concat_', text=True)
            try:
                with os.fdopen(fd, 'w', encoding='utf-8') as f:
                    for track in video_tracks:
                        safe_path = normalize_path(track.file_path).replace("'", "'\\''")
                        f.write(f"file '{safe_path}'\n")
            except Exception as e:
                # with 语句已关闭 fd，切勿再次 os.close（会抛 OSError 并掩盖真实异常）
                self._append_info_ui(_('[串联-流] 生成文件列表失败: {0}').format(e))
                try:
                    os.unlink(list_path)
                except OSError:
                    pass
                return []
            # 存储真实路径以便后续清理
            if not hasattr(self, '_temp_concat_lists'):
                self._temp_concat_lists = []
            self._temp_concat_lists.append(list_path)
    
        cmd.extend(["-f", "concat", "-safe", "0", "-i", list_path])
        cmd.extend(["-c:v", "copy"])
        # opus→aac 自动兜底（串行流复制模式）：源音频含 opus 且输出为 mp4/mov 时，
        # 仅音频重编码为 aac（视频仍 copy），消除 muxer 警告并提升兼容性。
        # 2026-10-07：禁用解析的轨道从未探测过 → 跳过这段逐文件 ffprobe
        # （否则预览时也会对几百个文件全探一遍）。
        # 2026-10-08：复选框「禁用解析」(_merge_probe_skipped) 为准 —— 事后勾选时轨道未必带
        # _no_probe 标记，仍应跳过逐文件 ffprobe（否则几百个文件全探一遍，禁用解析形同虚设）。
        _no_probe_any = self._merge_probe_skipped() or any(
            _vt.enc_settings.get("_no_probe", False) for _vt in video_tracks)
        concat_opus_fallback = False
        if (not _no_probe_any) and self.merge_container.get().lower() in ("mp4", "mov"):
            for _vt in video_tracks:
                _info = self._get_cached_stream_info(_vt.file_path)
                if _info:
                    for _s in _info.get("streams", []):
                        if _s.get("codec_type") == "audio" and (_s.get("codec_name") or "").lower() == "opus":
                            concat_opus_fallback = True
                            break
                if concat_opus_fallback:
                    break
        if audio_tracks:
            if concat_opus_fallback:
                cmd.extend(["-c:a", "aac", "-b:a", "192k", "-ar", "44100"])
                self._append_info_ui(_("[串联-流] 检测到源音频含 opus，MP4 不支持 copy，音频已自动转码为 aac"))
            else:
                cmd.extend(["-c:a", "copy"])
        elif _no_probe_any:
            # 2026-10-07 禁用解析：没探测过音频 ⇒ audio_tracks 必为空，但**不能走 -an**
            # （那会把 m3u8 分片的声音整轨丢掉）。按「同规格、同来源 ⇒ 带音频」假设走流复制；
            # 源真没音频时 -c:a copy 是空操作，不报错。
            cmd.extend(["-c:a", "copy"])
        else:
            cmd.append("-an")
    
        # 串联-流复制：无编码参数 → 传 None（按「开」处理，保持旧行为）
        self._add_container_optimization(
            cmd, video_tracks[0].enc_settings if video_tracks else None)
        cmd.append(output_norm)
    
        self._append_info_ui(_("[串联-流] 使用流复制模式（concat demuxer）"))
        return cmd


    def _probe_audio_params(self, file_path):
        """探测文件首个音频流的采样率 / 声道数 / 采样格式，返回 dict 或 None。"""
        info = self._get_cached_stream_info(file_path)
        if not info:
            return None
        for s in info.get("streams", []):
            if s.get("codec_type") == "audio":
                sr = s.get("sample_rate")
                if not sr:
                    return None
                ch = s.get("channels") or 2
                fmt = s.get("sample_fmt") or "s16"
                return {"sr": int(sr), "ch": int(ch), "fmt": fmt}
        return None


    def _build_audio_normalize(self, video_tracks, audio_tracks):
        """
        计算串行合并的音频归一串（concat / acrossfade 要求各段采样率 / 声道 / 采样格式一致）。
        策略：
          1 段   → 不归一（单段无 concat 约束，避免无谓重采样/下混）
          2 段   → 跟随主视频（首段）音频参数
          ≥3 段  → 跟随多数轨（采样率 / 声道 / 采样格式逐维度取众数）
        返回归一串；无需归一（或探测失败）时返回空字符串。
        """
        src_files = []
        if audio_tracks:
            src_files = [a.file_path for a in audio_tracks]
        else:
            src_files = [t.file_path for t in video_tracks
                         if t.enc_settings.get("audio_source_type", "self") != "silence"]
        params = []
        for fp in src_files:
            p = self._probe_audio_params(fp)
            if p:
                params.append(p)
        if len(params) <= 1:
            return ""  # 1 段（或无可探测音频）不归一
        if len(params) == 2:
            target = params[0]  # 跟随主视频（首段）
        else:
            target = _majority_audio_params(params)  # 跟随多数轨
        sr = target.get("sr")
        if not sr:
            return ""
        fmt = target.get("fmt") or "s16"
        cl = _channel_layout_name(target.get("ch", 2))
        # 注意：本机 ffmpeg 的 aresample 不接受 channel_layout 选项，声道统一由 aformat 完成。
        parts = [f"aresample={int(sr)}"]
        if cl:
            parts.append(f"aformat=sample_fmts={fmt}:channel_layouts={cl}")
        else:
            parts.append(f"aformat=sample_fmts={fmt}")
        return ",".join(parts)


    def _concat_norm_global_on(self):
        """串行合并「参数归一」开关状态：True = 精简命令（format/fps/settb 挪到 concat 之后只写一次）。

        开关在「末端处理」弹窗底部（仅封装页 + 串行合并模式下显示）。
        默认 False = 历史命令（逐段 6 个归一滤镜），两条路径共存观察一段时间，
        确认输出一致后再考虑反转默认值。开关缺失（转码页/队列等非封装页上下文）恒返回 False。
        """
        _v = getattr(self, "concat_norm_global", None)
        return bool(_v is not None and _v.get())

    def _build_concat_video_graph(self, video_tracks, global_norm=False, preview_work_cap=None,
                                  alpha=False):
        """构建串行合并「纯视频」filter_complex：主视频规格计算 + 逐轨滤镜 + 强制归一 + 逐轨转场/硬切拼接。

        供 _build_concat_reencode_mode（正式命令）与 merge_preview_concat_lavfi（串行合并
        lavfi 预览）复用，保证预览画面与最终成片的视频链完全一致（单一来源，避免两处逻辑漂移）。
        （注：串行缩略图早已不走本图 —— 现为按段 -ss seek 抽帧 + 纯内存拼图，见
        _show_concat_contact_sheet_async；同名的 _build_concat_contact_sheet_cmd 已于 2026-09-24 删除。）

        global_norm：False（默认）= 历史行为，6 个归一滤镜逐段写；
                     True = 精简命令，只把 concat 的硬门槛留在段前，其余挪到 concat 后写一次。
                     由「末端处理 → 串行合并·参数归一（实验）」开关控制，落位规则见
                     build_concat_norm_plan 的 docstring（有实测依据，勿凭直觉改）。
        alpha：透明开关（2026-10-12）——True 时把逐段归一的像素格式改成 yuva420p，让「某段是
               透明素材（透明色块 / 抠像 / 遮罩 / 带 alpha 的文件）」的 alpha 能活到图尾
               （管道预览才有东西可垫棋盘格；正式导出才有真 alpha 可写）。
               ⚠️ 归一格式本图只有**一个**全局值（build_concat_norm_plan 的 target_pix_fmt），
               故任一命中即整图带 alpha；不透明段自己把 alpha 写满 255，最终画面不受影响。
               调用方判据：预览走 `and pipe_engine` 门控（mpv/ffplay 路线没有透明指示 ⇒ 保持旧图）；
                          导出走 `_merge_needs_alpha`（concat 口径 = 任一轨命中），见 §6。
               ⛔ 默认 False ⇒ 不透明工程的预览图与导出命令均与旧版**逐字节一致**。
        返回 (filter_parts, v_labels, seg_durations, trans_effective, total_dur)：
          - filter_parts：视频侧 filter_complex 分句列表（末句输出标签 [vout]）
          - v_labels：各段视频标签 [v0]...[vn-1]
          - seg_durations：各段处理后时长（秒）
          - trans_effective[i]：(transition_type, duration) 或 None（段 i 未开转场 / 末段）
          - total_dur：拼接后总时长（Σ段长 - Σ转场重叠）
        """
        main_video = video_tracks[0]
        n = len(video_tracks)

        # ----- 1. 主视频最终输出规格（强制统一） -----
        main_orig_w, main_orig_h = self._cached_video_dimensions(main_video.file_path)
        if main_orig_w is None or main_orig_h is None:
            main_orig_w, main_orig_h = 1280, 720
        main_target_w, main_target_h = self.compute_final_size_with_order(
            main_orig_w, main_orig_h, main_video.enc_settings)
        if main_target_w <= 0 or main_target_h <= 0:
            main_target_w, main_target_h = main_orig_w, main_orig_h
        # 预览管道引擎工作分辨率上限（仅 pipe_engine 预览传入 preview_work_cap=上限宽；
        # 其余路径 None → 与旧行为逐字节一致）。主视频宽超上限时把「目标输出尺寸」整体
        # 等比降到上限 → pre_norm 的逐段 scale 同步变小，图计算量按 f² 下降（xfade/concat
        # 是时间维、不吃空间；只有逐段 scale 吃空间）。调用方须用同一 capped 值做 color 基源
        # /边框几何，否则图片基源与逐段 scale 尺寸不一致 → 画面错位。
        if preview_work_cap and main_target_w > preview_work_cap and main_target_h > 0:
            _cf = preview_work_cap / float(main_target_w)
            main_target_w = max(2, int(main_target_w * _cf) // 2 * 2)
            main_target_h = max(2, int(main_target_h * _cf) // 2 * 2)

        if main_video.enc_settings.get("pix_fmt_enabled", False):
            target_pix_fmt = main_video.enc_settings.get("pix_fmt", "yuv420p")
        else:
            target_pix_fmt = self._get_video_pix_fmt(main_video.file_path, 0) or "yuv420p"
        # 透明预览（2026-10-12，仅 alpha=True 的预览路径）：逐段归一**必须**带 alpha，否则
        # 段链里的 `format=yuv420p` 会在 concat 之前就把 alpha 抹平成黑底 —— 管道预览再垫棋盘
        # 也永远看不见（实测：透明色块首段 + 棋盘 ⇒ 全黑；改 yuva420p ⇒ 透出 200/150 格）。
        # 只在现算值本就**不**带 alpha 时才覆盖（用户显式选了 gbrap 等则尊重其选择）。
        if alpha and not self._pix_fmt_has_alpha(target_pix_fmt):
            target_pix_fmt = "yuva420p"

        if main_video.enc_settings.get("frame_rate_type") == "custom":
            try:
                target_fps = float(main_video.enc_settings.get("frame_rate_custom", "30"))
            except Exception:
                target_fps = 30.0
        else:
            raw_fps = self._get_video_framerate(main_video.file_path)
            target_fps = raw_fps if raw_fps is not None else 30.0

        # ----- 2. 每段处理后时长 -----
        seg_durations = []
        for _t in video_tracks:
            if self._is_static_image(_t.file_path):
                # 图片素材：时长取自「截取」面板的「显示时长(秒)」(img_duration)；
                # 图片无媒体时长，_get_effective_duration 会返回 None。
                _d = _eff_image_display_duration(_t.enc_settings)
            else:
                _d = self._get_effective_duration(_t.enc_settings, input_path=_t.file_path)
            if _d is None or _d <= 0:
                _d = 10.0
            seg_durations.append(_d)

        # ----- 3. 逐轨转场（挂本段：段 i 控制 i↔i+1 的过渡，末段无效） -----
        trans_effective = [None] * n
        for i in range(n):
            if i >= n - 1:
                break
            _ts = video_tracks[i].enc_settings
            if not _ts.get("transition_enabled", False):
                continue
            _ttype = str(_ts.get("transition_type", "fade") or "fade").strip()
            if _ttype not in XFADE_TRANSITIONS:
                _ttype = "fade"
            try:
                _td = float(str(_ts.get("transition_duration", "1.0") or "1.0").strip())
            except ValueError:
                _td = 1.0
            if _td <= 0 or seg_durations[i] <= 0 or seg_durations[i + 1] <= 0:
                continue
            _td = min(_td, min(seg_durations[i], seg_durations[i + 1]) / 2.0)
            if _td < 0.05:
                continue
            trans_effective[i] = (_ttype, _td)

        # ----- 4. 逐轨视频滤镜 + 强制归一（与淡入淡出互斥） -----
        # 归一参数的落位由 build_concat_norm_plan 决定（规则与实测依据见其 docstring）。
        # global_norm=True 时段前只留硬门槛 scale/setsar（xfade 时额外留 fps），
        # format/fps/settb 统一挪到 concat 之后只写一次 → 命令长度 6×N 降到 2×N+3。
        _has_xfade = any(t is not None for t in trans_effective)
        pre_norm, post_norm = build_concat_norm_plan(
            main_target_w, main_target_h, target_pix_fmt, target_fps,
            has_xfade=_has_xfade, global_norm=global_norm)
        filter_parts = []
        v_labels = []
        for i, track in enumerate(video_tracks):
            settings = track.enc_settings.copy()
            if settings.get("fade_enabled", False):
                if trans_effective[i] is not None:
                    settings["fade_out"] = ""
                if i > 0 and trans_effective[i - 1] is not None:
                    settings["fade_in"] = ""
            # ---- 串行画布模式（位置、尺寸、旋转）----
            # 与 delogo / 局部滤镜同构：先把「本段」处理成一个独立标签（内容=分段自身画面，
            # 贴在分段自有尺寸的黑色画布上做运动），再由现有 forced(scale=主视频尺寸、setsar…)
            # 拉到主视频尺寸、接入 concat/xfade。见 build_canvas_filtergraph docstring 与
            # _build_overlay_filter_complex（主视频画布）的实现，二者同一套注入逻辑。
            _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
            if _canvas_on:
                # 画布接管位置/尺寸/旋转 → 关闭链内静态缩放/裁剪/旋转（否则双重变换、尺寸错配）
                settings_sw = dict(settings)
                settings_sw["hw_filter_mode"] = "cpu"
                settings_sw["crop_enabled"] = False
                settings_sw["scale_enabled"] = False
                settings_sw["rotate"] = "none"
            else:
                settings_sw = settings
            video_filters = build_video_filter_chain(
                settings_sw,
                include_subtitle=False, include_speed=True, include_trim=True,
                include_format=False, include_scale=False,
                enhance_settings=settings.get("enhance", {}),
                reverse=settings.get("reverse_enabled", False),
                graph_id=f"c{i}", include_fade=True,
                # clip_duration=源全时长（淡出起点由链内按 截取/变速 重算，2026-09-13）；
                # 勿传 seg_durations[i]（已折算成输出时长，链内再算会二次扣减）
                clip_duration=self._get_media_duration(track.file_path),
                # 2026-10-09：串联分段也支持绿幕抠像（分段可为抠好的透明素材）。
                chroma_settings=settings if settings.get("chroma_enabled", False) else None,
                include_alpha=True,   # 分段=并列主视频，透明度同样生效
            )
            forced = list(pre_norm)
            # setpts 只能段前：后置是整体平移，救不回段内偏移（实测总时长会多出偏移量）。
            # 历史路径 pre_norm 已含 setpts。精简路径下通常不必补——唯一会让段内 pts 起点非 0
            # 的「精准截取」，build_video_filter_chain 自己已在 trim 后紧跟 setpts=PTS-STARTPTS
            # （见 3910 行），未截取的段起点本就是 0（输入级 -ss 由 ffmpeg 自动归零）。
            # 这里只在极端情况（链里有 trim 却没有 setpts）兜底补一次，避免重复也避免漏判。
            if global_norm and "trim=" in video_filters and "setpts=" not in video_filters:
                forced.append("setpts=PTS-STARTPTS")
            if _canvas_on:
                # 第 1 段：前置链（trim/增强/变速/倒放…）→ 时间归零 → 喂画布
                # （color 画布从 0 开始，overlay 与内容 PTS 必须对齐，否则开头几帧黑屏）
                _proc_lbl = f"[v{i}_proc]"
                if video_filters and video_filters != "null":
                    filter_parts.append(f"[{i}:v]setpts=PTS-STARTPTS,{video_filters}{_proc_lbl}")
                else:
                    filter_parts.append(f"[{i}:v]setpts=PTS-STARTPTS{_proc_lbl}")
                # 第 2 段：画布（内容基准=分段自身尺寸）→ 独立数据流
                # 不传 filter_trim_start/trim_duration → 不重复 trim（trim 已由前置链完成）；
                # 仅传 trim_start/speed_factor 供运动关键帧按输出时间线换算（见 _timeline_convert）。
                try:
                    _sw, _sh = self._cached_video_dimensions(track.file_path)
                    if not _sw or not _sh:
                        _sw, _sh = 1280, 720
                    _mts, _msp = _trim_speed_from_settings(settings)
                    _cg = build_canvas_filtergraph(
                        settings, _sw, _sh, _mts, _msp,
                        src_label=_proc_lbl, out_label=f"v{i}_canvas",
                        canvas_color="black", base_vf="", tag=f"c{i}")
                except Exception:
                    _cg = None
                if _cg:
                    filter_parts.append(_cg)
                    # forced（含 scale=主视频尺寸、setsar=1、format、settb…）作用于画布输出，
                    # 把分段自有尺寸的画布统一到主视频规格后接入 concat/xfade。
                    if forced:
                        filter_parts.append(f"[v{i}_canvas]{','.join(forced)}[v{i}]")
                    else:
                        filter_parts.append(f"[v{i}_canvas]null[v{i}]")
                    with suppress(Exception):
                        self._append_info_ui(
                            _("[画布模式] 串行段 %d 已启用（位置、尺寸、旋转）：内容基准 %dx%d，"
                            "已由统一参数拉到主视频尺寸") % (i + 1, _sw, _sh))
                else:
                    # 画布生成失败 → 退化为本段普通处理（forced 直接作用前置链），不影响整条命令
                    if video_filters and video_filters != "null":
                        filter_parts.append(f"[{i}:v]{video_filters},{','.join(forced)}[v{i}]")
                    else:
                        filter_parts.append(f"[{i}:v]{','.join(forced)}[v{i}]")
                    with suppress(Exception):
                        self._append_info_ui(
                            _("[画布模式] 串行段 %d 画布生成失败（尺寸/段数据异常），已按普通段处理") % (i + 1))
            else:
                if video_filters and video_filters != "null":
                    full_vf = f"{video_filters},{','.join(forced)}"
                else:
                    full_vf = ",".join(forced)
                filter_parts.append(f"[{i}:v]{full_vf}[v{i}]")
            v_labels.append(f"[v{i}]")

        # ----- 5. 视频拼接 / 逐轨交叉溶解转场 -----
        # 精简路径下拼接结果先进 [vcat]，后置归一后再回到 [vout]（调用方零感知）；
        # 历史路径 post_norm 为空 → join_out 直接是 [vout]，输出与改动前逐字符一致。
        prev = v_labels[0]
        cumulative = seg_durations[0]
        join_out = "[vcat]" if post_norm else "[vout]"
        for k in range(1, n):
            tr = trans_effective[k - 1]
            out_label = join_out if k == n - 1 else f"[vx{k}]"
            if tr is not None:
                _ttype, _td = tr
                offset = max(0.0, cumulative - _td)
                filter_parts.append(
                    f"{prev}[v{k}]xfade=transition={_ttype}:duration={_ffsec(_td)}:offset={_ffsec(offset)}{out_label}")
                cumulative = cumulative + seg_durations[k] - _td
            else:
                filter_parts.append(f"{prev}[v{k}]concat=n=2:v=1:a=0{out_label}")
                cumulative = cumulative + seg_durations[k]
            prev = out_label
        if n == 1:
            filter_parts.append(f"{v_labels[0]}null{join_out}")
        if post_norm:
            filter_parts.append(f"{join_out}{','.join(post_norm)}[vout]")

        total_dur = sum(seg_durations) - sum(t[1] for t in trans_effective if t is not None)
        return filter_parts, v_labels, seg_durations, trans_effective, total_dur

    def _build_concat_reencode_mode(self, cmd, video_tracks, audio_tracks, main_video, output_norm):
        """
        重新编码模式 - 使用 filter_complex concat。
        每个片段独立控制：裁剪、旋转、翻转、反交错、截取、倒放、增强、变速。
        强制统一分辨率、像素格式、帧率、SAR。
        全局阶段仅应用：视频字幕烧录；音频音量调整。
        """
        # 串行重编码模式不再使用「独立外部音轨」的 1:1 段映射：该功能未实现绑定语义，
        # 且音频轨数量与视频段数不匹配时会导致部分段丢失音频（原 L14661 分支）。
        # 外部音频统一改为「主视频音频绑定页 -> 背景音乐 (BGM)」全局叠加，见下方 6b 节。
        # 2026-09-30：独立音频轨「混音进主音频」例外——混进最终 [aout]（整段时间轴的最终混音）。
        _free_mix_tracks = [t for t in audio_tracks if self._audio_out_mode(t) == "mix"]
        _concat_stream_left = [t for t in audio_tracks if self._audio_out_mode(t) == "stream"]
        audio_tracks = []

        # ----- 2. 添加输入文件（视频 + 全局 BGM） -----
        # 注意：串行模式已不使用 audio_tracks（见函数开头），外部音频统一走 BGM。
        concat_input_files = [t.file_path for t in video_tracks]
        # 全局背景音乐（主视频音频绑定页启用时）
        _bgm_path = (main_video.enc_settings.get("bgm_audio_path", "") or "").strip()
        if (main_video.enc_settings.get("bgm_enabled", False)
                and _bgm_path and os.path.isfile(_bgm_path)):
            _bgm_norm = normalize_path(_bgm_path)
            if _bgm_norm not in concat_input_files:
                concat_input_files.append(_bgm_norm)
        # 独立音频轨「混音进主音频」：输入文件补进 concat 输入列表
        for _fa in _free_mix_tracks:
            if _fa.file_path not in concat_input_files:
                concat_input_files.append(_fa.file_path)
        file_index = {p: i for i, p in enumerate(concat_input_files)}
        for p in concat_input_files:
            _pn = normalize_path(p)
            if self._is_static_image(p):
                # 图片素材：把本图「显示时长」烘焙成有限时长流（与普通/转换页图片输入一致）。
                # 裸 -i 图片只产生 1 帧，concat/xfade 无法拼接。
                _img_trk_c = next((t for t in video_tracks
                                   if normalize_path(t.file_path) == _pn), None)
                _img_set_c = _img_trk_c.enc_settings if _img_trk_c is not None else {}
                _img_dur_c = _eff_image_display_duration(_img_set_c)
                _img_fps_c = self._get_video_framerate(p) or 30
                cmd.extend(["-loop", "1",
                            "-framerate", f"{_img_fps_c:.6f}".rstrip('0').rstrip('.'),
                            "-t", f"{_img_dur_c:.3f}", "-i", _pn])
            else:
                cmd.extend(["-i", _pn])
    
        # ----- 3. 构建纯视频 filter_complex（复用公共函数 _build_concat_video_graph） -----
        n = len(video_tracks)
        # 2026-10-12 透明导出打通：串行各段**并列**拼成输出 ⇒ 任一段透明都要带 alpha
        # （concat 口径 = `_merge_needs_alpha` 任一轨命中，与管道预览同一判据）。
        # 图侧必须同步升 yuva420p：否则逐段归一的 `format=yuv420p` 会在 concat 之前就把
        # alpha 抹平，图尾再声明 `-pix_fmt yuva420p` 也只是给一通道填满 255（导出成实色）。
        _needs_alpha = self._merge_needs_alpha(video_tracks)
        filter_parts, v_labels, seg_durations, trans_effective, total_dur = self._build_concat_video_graph(
            video_tracks, global_norm=self._concat_norm_global_on(), alpha=_needs_alpha)
        # 成片总时长落一份「最近值」：命令编辑器的文本兜底预览（用户已编辑 ⇒ 走不了核心
        # 路径）靠它封顶 -t / 时间轴。串行命令本身不带 -t，不记的话预览只能拿**主输入
        # 探测时长**（第一段）封顶 ⇒ 多段合并被砍成一段（用户实测 23.487s 工程只播 11.3s）。
        # 与预览入口同源（_build_concat_video_graph），两处都刷，保证至少一个是新的。
        self._last_merge_total_dur = total_dur
        n_trans = sum(1 for t in trans_effective if t is not None)
        if n_trans:
            self._append_info_ui(f"[串联-编] 使用逐轨 xfade 交叉溶解转场（{n_trans} 处）")

        # 串行合并音频归一：concat / acrossfade 都要求各音频段采样率 / 声道布局 / 采样格式一致。
        # 策略：1 段不归一；2 段跟随主视频（首段）；≥3 段跟随多数轨（逐维度众数）。
        # 返回空串表示无需归一（1 段或探测失败）。
        audio_concat_normalize = self._build_audio_normalize(video_tracks, audio_tracks)

        # ----- 4b. 音频拼接 -----
        # 优先使用「独立音频轨道」的逐轨设置（与其它模式统一，音频完全独立控制）；
        # 若未添加任何独立音频轨道，则回退到各视频自带音轨，此时嵌入音轨跟随其视频段的
        #   截取/变速/倒放（保持音画同步），避免被段级钳制静默截断或拖尾。
        # 音频独立截取（不分段）跨分段接管：主视频开启时优先于上面两者，从【源文件】音频
        #   单独截取一段，整段作为合并输出音频，忽略各分段自身嵌入音频（对齐分段拼接窗口左下同款功能）。
        #   程序不检测是否同源文件，仅 UI 提示 + 勾选时双重确认，由用户自行确认列表文件一致。
        a_labels = []
        _at_set = main_video.enc_settings if main_video is not None else {}
        _use_global_audio_trim = bool(_at_set.get("audio_trim_enabled", False))
        if _use_global_audio_trim and main_video is not None and main_video.file_path:
            _astr = (_at_set.get("audio_trim_start", "") or "").strip()
            _aend = (_at_set.get("audio_trim_end", "") or "").strip()
            _as = time_to_seconds(_astr) if _astr else 0.0
            _ae = time_to_seconds(_aend) if _aend else None
            _at_parts = []
            if _as is not None and _ae is not None and _ae > _as:
                _at_parts.append(f"atrim=start={_ffsec(_as)}:end={_ffsec(_ae)}")
            elif _as is not None and _as > 0:
                _at_parts.append(f"atrim=start={_ffsec(_as)}")
            else:
                _at_parts.append("anull")
            _at_parts.append("asetpts=PTS-STARTPTS")
            _at_chain = ",".join(_at_parts)
            if audio_concat_normalize:
                _at_chain = f"{audio_concat_normalize},{_at_chain}"
            # 主视频即输入 0（video_tracks[0]），其嵌入音频为 [0:a]
            filter_parts.append(f"[0:a]{_at_chain}[amain]")
            a_labels.append("[amain]")
            self._append_info_ui(
                f"[串联-编] 音频独立截取（不分段）已接管全部音频输出（源文件 {os.path.basename(main_video.file_path)}，"
                f"起始 {_astr or '0'} 结束 {_aend or '末尾'}）")
        elif audio_tracks:
            for j, audio in enumerate(audio_tracks):
                a_idx = file_index[audio.file_path]
                audio.enc_settings["_file_path"] = audio.file_path
                af_str = self._build_audio_filters(
                    audio.enc_settings,
                    include_trim=True,
                    include_volume=True,
                    include_speed=True,
                    include_reverse=audio.enc_settings.get("audio_reverse", False),
                    include_fade=False,     # 淡入淡出改在段级钳制之后统一追加，精确定位到段末
                    include_segments=False  # 串行 concat 模式屏蔽音频分段效果（见下方注释）
                )
                # 段级时长钳制：让每段音频总时长 = 对应视频段的处理后时长 seg_durations[j]，
                # 这样 concat 顺序拼接后，各段音频与视频的累计时间一致，不会因偏移(adelay)/
                # 变速/截取而逐段错位（连得越多越歪）。
                # atrim=0:T 切掉超长的尾巴（偏移过大时配音尾被裁，合理）；
                # apad=whole_dur=T 把不足 T 的用静音补到正好 T（否则下一段音频会提前开始，漂移照旧）。
                # 严格 1:1 映射：音频轨 j 对应视频段 j。
                tgt = seg_durations[j] if j < len(seg_durations) else (seg_durations[-1] if seg_durations else 0.0)
                clamp = f"atrim=0:{_ffsec(tgt)},apad=whole_dur={_ffsec(tgt)}"
                if af_str:
                    chain = f"{af_str},{clamp}"
                else:
                    chain = f"asetpts=PTS-STARTPTS,{clamp}"
                if audio_concat_normalize:
                    chain = f"{audio_concat_normalize},{chain}"
                # 逐轨转场与音频淡入淡出互斥（音频段 j 对应视频段 j）
                _aset = audio.enc_settings.copy()
                if _aset.get("fade_enabled", False) and j < len(trans_effective):
                    if trans_effective[j] is not None:
                        _aset["fade_out"] = ""
                    if j > 0 and trans_effective[j - 1] is not None:
                        _aset["fade_in"] = ""
                f_suffix = self._build_afade_suffix(_aset, tgt)
                if f_suffix:
                    chain = f"{chain},{f_suffix}"
                # 串行 concat 模式不应用音频分段效果（2026-09-04 用户定版：超级边缘场景，
                # 段级钳制 atrim=0:T 会截断分段时间轴，且无可靠手段确认音频时间 → 直接屏蔽）。
                filter_parts.append(f"[{a_idx}:a]{chain}[a{j}]")
                a_labels.append(f"[a{j}]")
            self._append_info_ui(f"[串联-编] 音频段已逐段钳制到对应视频段时长（防止偏移/变速导致累计错位）")
        else:
            for i, track in enumerate(video_tracks):
                settings = track.enc_settings.copy()
                audio_type = settings.get("audio_source_type", "self")
                if self._is_static_image(track.file_path):
                    # 图片段：静音底噪时长跟随「显示时长」，否则 10s 兜底会让音画长度错位
                    effective_duration = _eff_image_display_duration(settings)
                else:
                    effective_duration = self._get_effective_duration(settings, input_path=track.file_path)
                if effective_duration is None or effective_duration <= 0:
                    effective_duration = 10.0
                has_audio = False
                info = self._get_cached_stream_info(track.file_path)
                if info:
                    has_audio = any(s.get('codec_type') == 'audio' for s in info.get('streams', []))
                if audio_type == "silence" or not has_audio:
                    norm_suffix = f",{audio_concat_normalize}" if audio_concat_normalize else ""
                    filter_parts.append(f"anullsrc=r=44100:cl=stereo:duration={effective_duration:.3f}{norm_suffix}[a{i}]")
                else:
                    audio_filters = []
                    # 视频自带音轨跟随视频段截取（音频独立截取跨分段接管时由上方 4b 全局分支处理，
                    # 此处仅负责逐段嵌入音频的常规视频段跟随截取）。
                    if settings.get("trim_enabled", False):
                        start = settings.get("trim_start", "").strip()
                        end = settings.get("trim_end", "").strip()
                        start_sec = time_to_seconds(start) if start else 0.0
                        end_sec = time_to_seconds(end) if end else None
                        total = self._get_media_duration(track.file_path) if track.file_path else None
                        if end_sec is not None:
                            trim_dur = end_sec - start_sec
                        elif total is not None:
                            trim_dur = total - start_sec
                        else:
                            trim_dur = None
                        if trim_dur is not None and trim_dur > 0:
                            audio_filters.append(f"atrim=start={_ffsec(start_sec)}:duration={_ffsec(trim_dur)}")
                            audio_filters.append("asetpts=PTS-STARTPTS")
                    # 视频自带音轨应与其视频段保持音画同步：跟随视频的变速与倒放，
                    # 使嵌入音轨自然时长 == 视频段时长，避免被段级钳制静默截断/拖尾。
                    _append_audio_speed_reverse(settings, audio_filters)
                    # 段级时长钳制：嵌入音轨也对齐到视频段处理后时长 effective_duration，
                    # 避免嵌入音轨比视频段短/长导致 concat 后累计错位。
                    audio_filters.append(f"atrim=0:{_ffsec(effective_duration)}")
                    audio_filters.append(f"apad=whole_dur={effective_duration:.3f}")
                    audio_chain = ",".join(audio_filters)
                    if audio_concat_normalize:
                        audio_chain = f"{audio_concat_normalize},{audio_chain}"
                    # 逐轨转场与音频淡入淡出互斥（视频自带音轨跟随其视频段）
                    if settings.get("fade_enabled", False):
                        if trans_effective[i] is not None:
                            settings["fade_out"] = ""
                        if i > 0 and trans_effective[i - 1] is not None:
                            settings["fade_in"] = ""
                    f_suffix = self._build_afade_suffix(settings, effective_duration)
                    if f_suffix:
                        audio_chain = f"{audio_chain},{f_suffix}"
                    filter_parts.append(f"[{i}:a]{audio_chain}[a{i}]")
                a_labels.append(f"[a{i}]")
    
        # ----- 5. 视频全局滤镜：字幕、文字水印 drawtext -----
        global_video_filters = []
        # 字幕烧录，三模式（普通封装/画中画/串行）charenc 全部支持）
        if main_video.enc_settings.get("subtitle_enabled", False):
            sub_path = main_video.enc_settings.get("subtitle_path", "").strip()
            if sub_path:
                safe_sub_path = sub_path.replace("'", "\\'")
                _ch_m = str(main_video.enc_settings.get("subtitle_charset", "auto") or "auto").strip().lower()
                if _ch_m and _ch_m != "auto":
                    global_video_filters.append(f"subtitles=filename='{safe_sub_path}':charenc={_ch_m}")
                else:
                    global_video_filters.append(f"subtitles=filename='{safe_sub_path}'")
        # 文字水印（跟随主视频设置；旋转时走透明层+rotate+overlay 子图）。
        # 2026-08-26 多实例：多条启用项一律走 filter_complex 链（逐项处理旋转）。
        tw_settings = main_video.enc_settings.get("text_watermark", {})
        _tw_c_items = main_video.enc_settings.get("text_watermark_items") or []
        _tw_c_active = [i for i in _tw_c_items
                        if i.get("enabled", True) and str(i.get("text", "") or "").strip()]
        _tw_c_multi = len(_tw_c_active) > 1
        _tw_c0 = _tw_c_active[0] if _tw_c_active else tw_settings
        _tw_enabled, _tw_rotate = text_watermark_active(_tw_c0)
        if _tw_rotate or _tw_c_multi:
            # 旋转/多条：global_video_filters 先接到临时标签，文字子图接在后面
            video_global_chain = ",".join(global_video_filters) if global_video_filters else "null"
            if global_video_filters:
                filter_parts.append(f"[vout]{video_global_chain}[v_pre]")
                tw_in = "[v_pre]"
            else:
                tw_in = "[vout]"
            filter_parts.append(build_text_watermark_chain(main_video.enc_settings, main_label=tw_in, out_label="[v_tw]"))
            vmap = "[v_tw]"
        else:
            dt = build_drawtext_filter(_tw_c0, tag="twc")
            if dt:
                global_video_filters.append(dt)
            if global_video_filters:
                video_global_chain = ",".join(global_video_filters)
                filter_parts.append(f"[vout]{video_global_chain}[vfinal]")
                vmap = "[vfinal]"
            else:
                vmap = "[vout]"

        # ----- 6. 音频拼接 / 逐轨交叉溶解转场（acrossfade，跟随对应视频段的转场开关） -----
        # 音频段与视频段 1:1 对应：段 k-1 开了转场 → 音频段 k-1↔k 之间 acrossfade；否则硬切。
        # acrossfade 的 overlap=true（默认）会让第二段开头与第一段结尾自动重叠交叉溶解，无需手动 offset。
        prev_a = a_labels[0]
        for k in range(1, len(a_labels)):
            out_label = "[aout]" if k == len(a_labels) - 1 else f"[ax{k}]"
            tr = trans_effective[k - 1] if k - 1 < len(trans_effective) else None
            if tr is not None:
                _td = tr[1]
                filter_parts.append(
                    f"{prev_a}[a{k}]acrossfade=c1=tri:c2=tri:d={_td:.3f}{out_label}"
                )
            else:
                filter_parts.append(f"{prev_a}[a{k}]concat=n=2:v=0:a=1{out_label}")
            prev_a = out_label
        if len(a_labels) == 1:
            filter_parts.append(f"{a_labels[0]}anull[aout]")
        if n_trans:
            self._append_info_ui(f"[串联-编] 音频使用 acrossfade 交叉溶解转场（跟随逐轨转场开关）")

        # ----- 7. 音频映射：音量等已全部下放到每条独立音轨（_build_audio_filters），
        #           不再在此套用全局音量，避免与主视频音量重复叠加 -----
        amap = "[aout]"

        # ----- 6a2. 独立音频轨「混音进主音频」（整段时间轴的最终混音，2026-09-30） -----
        # 自身窗口已由 audio_offset(开始)/trim_end(结束) 在链内生效；归一与各段统一格式一致。
        # 级联回 [aout]（同名标签复用，与画中画 [amain] 级联同款）；BGM 仍在其后叠加。
        if _concat_stream_left:
            self._append_info_ui(
                f"[串联-编] {len(_concat_stream_left)} 条「独立音轨」在串行重编码模式下不参与输出"
                f"（可改用「混音进主音频」或 BGM）")
        if _free_mix_tracks:
            _free_total = sum(seg_durations) - sum(t[1] for t in trans_effective if t is not None)
            _free_norm = (audio_concat_normalize
                          if audio_concat_normalize
                          else "aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=44100")
            _fk = 0
            for _fa in _free_mix_tracks:
                _flbl = f"fx{_fk}"
                _fnode = self._free_audio_mix_node(_fa, file_index, _free_total, label=_flbl,
                                                   norm_str=_free_norm)
                if _fnode is None:
                    continue  # 查不到输入 → 降级忽略
                filter_parts.append(_fnode)
                filter_parts.append(
                    f"[aout][{_flbl}]amix=inputs=2:duration=longest:normalize=0[aout]")
                _fk += 1
            if _fk:
                self._append_info_ui(f"[串联-编] 已混入 {_fk} 条自由音频（整段最终混音）")

        # ----- 6b. 全局背景音乐 (BGM) 叠加（仅主视频音频绑定页启用时） -----
        # 外部音频循环铺满整段合并输出，按设定音量降低后混在 [aout] 原音之下。
        _bgm_path = (main_video.enc_settings.get("bgm_audio_path", "") or "").strip()
        if (main_video.enc_settings.get("bgm_enabled", False)
                and _bgm_path and os.path.isfile(_bgm_path)
                and a_labels):
            _bgm_norm = normalize_path(_bgm_path)
            _bgm_idx = file_index.get(_bgm_norm)
            if _bgm_idx is not None:
                _bgm_vol = 0.3
                _bgm_vol = _opt_float(main_video.enc_settings.get("bgm_volume", 0.3) or 0.3, 0.3)
                # BGM 归一：>=2 段跟随各段统一格式；单段则强制立体声 44100，便于与 [aout] 混音
                _bgm_norm_str = audio_concat_normalize if audio_concat_normalize else "aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=44100"
                _total_a = sum(seg_durations)
                _trans_sum = sum(t[1] for t in trans_effective if t is not None)
                _total_a -= _trans_sum
                # 背景音乐文件内片段精准截取（可选）：默认整段；填开始/结束则只取该段循环铺满
                _bs = main_video.enc_settings.get("bgm_trim_start", "") or ""
                _be = main_video.enc_settings.get("bgm_trim_end", "") or ""
                _bs_sec = time_to_seconds(_bs) if _bs else None
                _be_sec = time_to_seconds(_be) if _be else None
                _src_trim_parts = []
                if _bs_sec is not None:
                    _src_trim_parts.append(f"start={_ffsec(_bs_sec)}")
                if _be_sec is not None:
                    _src_trim_parts.append(f"end={_ffsec(_be_sec)}")
                # 帧精确片段截取必须带 atrim= 滤镜名；bare 的 start=/end= 会被 ffmpeg 当成孤立选项而报
                # "No option name near '...'"。只填开始→atrim=start=X；只填结束→atrim=end=Y；都填→atrim=start=X:end=Y。
                _bgm_src_trim = ("atrim=" + ":".join(_src_trim_parts) + ",asetpts=PTS-STARTPTS,") if _src_trim_parts else ""
                _bgm_chain = (
                    f"[{_bgm_idx}:a]{_bgm_norm_str},"
                    f"{_bgm_src_trim}"
                    f"aloop=loop=-1:size=2000000000,"
                    f"atrim=0:{_ffsec(_total_a)},"
                    f"volume={_bgm_vol:.3f},"
                    f"asetpts=PTS-STARTPTS[bgm]"
                )
                filter_parts.append(_bgm_chain)
                filter_parts.append(
                    f"[aout][bgm]amix=inputs=2:duration=longest:normalize=0[afinal]"
                )
                amap = "[afinal]"
                self._append_info_ui(
                    f"[串联-编] 已叠加背景音乐（{os.path.basename(_bgm_path)}，音量 {_bgm_vol:.2f}，混在原音之下）"
                )

        # ----- 8. 组合所有滤镜 -----
        # 音频节点效果（2026-09-26）：拼接完成的音频链上按指纹插入（串行合并也走这张图）。
        # 先把原始图记到 _last_graph —— 既是音频节点对话框的数据源，也是指纹锚点基准
        # （必须在叠加节点效果之前，否则段序号因自己插入的效果而漂移 ⇒ 指纹永远对不上）。
        self._last_graph = ";".join(filter_parts)
        self._last_graph_sig = self._graph_media_signature()
        self._last_graph_gen = getattr(self, "_graph_gen", 0)
        self._graph_dirty = False      # 本次构图产出 ⇒ 缓存重新可信
        # 串行合并也必须写「基准图」：这里记下的图在音频节点效果应用**之前**，
        # 且串行根本不应用视频节点效果 ⇒ 它本身就是干净图，可直接当节点分析基准。
        # 不写 ⇒ 上一代画中画的 base 残留 + 媒体签名没变 ⇒ 切回串行读到画中画的图。
        self._last_graph_base = self._last_graph
        self._last_graph_base_gen = self._last_graph_gen
        if getattr(self, "node_audio_fx", None):
            try:
                all_filters, _fx_final_lbl = self._apply_node_audio_fx(
                    self._last_graph,
                    "afinal" if "[afinal]" in self._last_graph
                    else ("aout" if "[aout]" in self._last_graph else "out"),
                    anchor_nodes=graph_nodes(self._last_graph))
            except Exception as _e:
                self._append_info_ui(f"[音频节点] 串行合并叠加失败（按原图继续）: {_e}")
                all_filters = self._last_graph
        else:
            all_filters = self._last_graph
        cmd.extend(["-filter_complex", all_filters])
        cmd.extend(["-map", vmap, "-map", amap])
    
        # ----- 9. 音频编码参数 -----
        if audio_tracks:
            a_settings = audio_tracks[0].enc_settings
            enc = a_settings.get("encoder", "aac")
            if enc == "copy":
                enc = "aac"
                self._append_info_ui(_("[串联-编] 重新编码模式下音频自动从 copy 改为 aac"))
            cmd.extend(build_audio_encoder_args(
                enc, a_settings, skip_ar=bool(audio_soxr_resample_filter(a_settings))))
        else:
            cmd.extend(build_audio_encoder_args("aac", {"audio_bitrate": "128k", "audio_samplerate": "44100"}))
    
        # ----- 10. 视频编码参数 -----
        v_settings = main_video.enc_settings.copy()
        vcodec = v_settings.get("encoder", "libx265")
        if vcodec == "copy":
            self._append_info_ui(_("[串联-编] 重新编码模式下视频编码器自动改为 libx265"))
            vcodec = "libx265"
            v_settings["encoder"] = "libx265"
        # 2026-10-12 透明导出打通：与普通/画中画同款 —— 输出需要 alpha（任一轨命中，见
        # `_merge_needs_alpha` 的 concat 口径）时强制 yuva420p，并换承载 alpha 的编码器。
        # 容器升 .mov 已在 merge_build_cmd_list 做过，但容器只是「允许装 alpha」，真正决定
        # 有没有 alpha 的是**编码器**（libx264/libx265 收到 yuva420p 会静默降 yuv420p、alpha
        # 全填 255）⇒ 不同步换编码器 = 导出的透明段实为实色（研究 §6 的已知缺口）。
        # v_settings 是副本，不回写轨道（避免把用户选的编码器持久改掉），与普通/画中画一致。
        if _needs_alpha:
            v_settings["pix_fmt_enabled"] = True
            v_settings["pix_fmt"] = "yuva420p"
            vcodec, v_settings = self._merge_alpha_encoder(vcodec, v_settings, _("[串联]"))
            self._append_info_ui(
                _("[串联-编] 检测到透明需求（任一段），输出强制 yuva420p 并切换到承载 alpha 的编码器"))
        strategy = get_encoder_strategy(vcodec)
        cmd = strategy.build_params(cmd, v_settings)
        cmd = append_video_output_extras(cmd, v_settings)
    
        # 容器优化
        self._add_container_optimization(cmd, v_settings)
        # 文字水印（旋转/spin）无限源时长限制：各段有限流，-shortest 正确截断到总时长。
        # 图片主视频无真实时长，用 concat 实际总时长 total_dur（Σ段长 − Σ转场重叠）兜底，
        # 不能用单张图的「显示时长」，否则无限画布会把输出拉长/截短。
        _ensure_tw_duration_limit(
            self, cmd, input_path=main_video.file_path,
            main_duration=None, audio_enabled=True,
            image_display_duration=total_dur)

        cmd.append(output_norm)
        self._append_info_ui(f"[串联-编] 使用 filter_complex 重新编码模式（{n} 个片段）")
        return cmd
    
    def merge_build_cmd_list(self, output_override=None, preview=False) -> List[str]:
        """
        根据当前模式生成合并/封装的 FFmpeg 命令列表。
        """
        # 构代号 +1（节点分析据此判断「两张图是不是同一次构图产出的」，
        # 见 _ensure_node_graphs_current）。放最前面：本次构图写下的图都打同一个号。
        self._graph_gen = getattr(self, "_graph_gen", 0) + 1

        if not self.ffmpeg_cmd:
            self._append_info_ui(_("未找到 ffmpeg，无法生成合并命令。"))
            return []
    
        if output_override is not None:
            output = output_override
        else:
            output = self.merge_output.get().strip()
        if not output:
            return []
    
        only_audio = self.merge_only_audio.get() if hasattr(self, 'merge_only_audio') else False
        enabled_tracks = [t for t in self.merge_tracks if t.enabled]

        if any(t.enc_settings.get("_placeholder", False) for t in enabled_tracks):
            self._append_info_ui(_("[封装] 存在占位轨道，命令生成被推迟"))
            return []

        if not enabled_tracks:
            self._append_info_ui(_("[封装] 没有启用的轨道"))
            return []

        # ⚠️ 2026-08-19 用户拍板：转换页的文字/图片水印设置【不得】影响封装页（3 个模式）。
        # 原先这里把 self.text_watermark_settings 塞进主视频轨道 enc_settings，
        # 导致封装普通/画中画/串行全部被转换页文字水印污染。已删除该种子点。
        # 2026-08-26 起封装页有自己的文字水印（self._merge_tw，页底部「文字水印」按钮），
        # 由各模式入口的 _apply_merge_text_watermark 写入主轨 enc_settings。

        output_norm = normalize_path(output)

        # 2026-10-09：透明输出需求 → 容器须支持 alpha。判据只认**主视频**是否透明
        # （颜色源 alpha<255 / 抠像 / 遮罩 / alpha 输入；子视频带透明不算，见 _merge_needs_alpha）。
        # 非 alpha 容器（mp4/mkv/avi/flv）自动升级为 .mov（QuickTime 支持 yuva420p）。
        # ⚠️ 必须放在 output_norm 定义之后：上方若提前用 output_norm 会触发 NameError，
        # 导致「只要启用半透明/抠像/遮罩就整条命令生成失败」。
        # 2026-10-14：**视频节点里插入的效果**同样算数（`_graph_alpha_from_node_fx`）——
        # 它住在 app 级 self.node_fx、不进 settings / 轨道，旧判据根本看不见
        # ⇒ 用户实测「节点遮罩要自己手选容器与像素格式」。
        # ⚠️ **必须带 `pip_enabled` 门控**（2026-10-14 自查补充）：视频节点是**画中画专属**
        # （`_open_node_tap_dialog` 要求 pip_enabled；`_apply_node_fx` 全仓库只有两处调用——
        # `_build_overlay_filter_complex`（画中画构图）与预览路径）。普通封装 / 串行合成都
        # **不把 node_fx 插进图** ⇒ 若这里不看模式，一个挂着节点遮罩的工程切到普通封装，
        # node_fx 仍非空 ⇒ 会被判成"要 alpha" ⇒ 整条命令白升 ProRes 4444 / .mov（体积暴涨
        # 十倍且毫无透明度收益）。画中画那一支自己也在 `_build_pip_cmd` 里判一次（同一个判据，
        # 幂等），本处保留是为了让**容器扩展名**也跟着升 —— ProRes 4444 塞在 .mp4 里
        # alpha 同样会丢，两处必须同口径。
        _nfx_alpha = bool(self.pip_enabled.get()) and self._graph_alpha_from_node_fx()
        if not only_audio and (self._merge_needs_alpha(enabled_tracks) or _nfx_alpha):
            if _nfx_alpha:
                self._log_alpha_once(
                    "merge_mov_nfx",
                    _("[封装] 检测到「视频节点」里插入的透明效果（遮罩 / 抠像 / 透明度等），"
                    "输出容器自动升级为 .mov 以保留 alpha"))
            _bn, _ex = os.path.splitext(output_norm)
            _ex = _ex.lower()
            if _ex in (".mp4", ".mkv", ".avi", ".flv"):
                output_norm = _bn + ".mov"
                self._append_info_ui(
                    _("[封装] 检测到透明需求，输出容器自动升级为 .mov（支持 alpha），已改扩展名"))
    
        # ---- 仅音频模式：强制普通封装，并自动调整输出扩展名 ----
        if only_audio:
            self._append_info_ui(_("[封装] 已切换为仅音频模式（忽略视频和字幕）"))
            if self.pip_enabled.get() or self.concat_enabled.get():
                self._append_info_ui(_("[封装] 仅音频模式已自动切换到普通封装模式"))
            # 如果扩展名不是常见音频格式，改为 .m4a
            base, ext = os.path.splitext(output_norm)
            if ext.lower() not in ('.m4a', '.mp3', '.flac', '.wav', '.aac', '.opus', '.ac3', '.ogg'):
                output_norm = base + ".m4a"
                self._append_info_ui(_('[封装] 仅音频模式，输出扩展名自动改为 .m4a'))
            cmd_list = self._build_normal_cmd(enabled_tracks, output_norm, only_audio=True)
        else:
            # 根据模式选择命令生成函数
            if self.pip_enabled.get():
                cmd_list = self._build_pip_cmd(enabled_tracks, output_norm)
            elif self.concat_enabled.get():
                cmd_list = self._build_concat_cmd(enabled_tracks, output_norm, preview=preview)
            else:
                cmd_list = self._build_normal_cmd(enabled_tracks, output_norm)
    
        if not cmd_list:
            self._append_info_ui(_("[封装] 命令生成失败，请检查设置"))
            return []

        # 本次构图**没产出图**（普通封装 / 串行 copy 等不带 filter_complex 的模式）⇒ 旧图作废。
        # 不然节点窗会拿上一代（很可能是别的模式）的图列出节点 —— 与「切回串行却看到画中画
        # 的图」是同一类假数据。判据：_last_graph 的构代号不等于本次构代号 = 本次没写过。
        if getattr(self, "_last_graph_gen", -1) != self._graph_gen:
            self._last_graph = ""
            self._last_graph_base = ""
            self._last_graph_sig = ""
            self._graph_dirty = False

        # ---- 帧同步统一注入（2026-09-16「帧设置」；普通/画中画/串行三种模式通用）----
        # 来源 =【主视频轨道】的 enc_settings（与 -g/-keyint_min 同源，见 append_video_output_extras）。
        # 惯例（用户 2026-09-16 确认）：封装页所有视频输出参数一律跟主视频轨道走，不另设输出级变量；
        # 入口即主视频轨道编辑窗口里复用的「帧设置」按钮。
        # 插在末尾的输出路径【之前】：后面还有 -t / 手动时长 / 长滤镜改文件等后处理。
        if not only_audio:
            _mvs = None
            for _t in enabled_tracks:
                if getattr(_t, "type", "video") == "video":
                    _mvs = getattr(_t, "enc_settings", None) or {}
                    break
            _fs = frame_sync_to_ffmpeg(
                str((_mvs or {}).get("frame_sync", "") or "").strip() or "auto",
                self.ffmpeg_cmd)
            if _fs:
                _out_path_tmp = cmd_list.pop()
                cmd_list.extend(_fs)
                cmd_list.append(_out_path_tmp)
    
        # ---- 末端处理统一注入（多画面拼接 / concat 图片/视频；三种模式通用） ----
        # 在图片主视频默认时长/手动时长之前注入：concat 尾部素材会延长输出，需在时长控制前挂好滤镜
        try:
            cmd_list = self._apply_end_handling(cmd_list, enabled_tracks)
        except Exception as e:
            self._append_info_ui(f"[末端] 末端处理注入失败，已跳过: {e}")

        # ---- 图片主视频默认时长：普通模式单视频图片（-loop 1 无限循环）无天然结束点，
        # 未勾选手动时长时自动 -t（取「截取」面板的「显示时长」；画中画由 _add_pip_duration_control 处理） ----
        # ⚠️ 这里的 `"-t" not in cmd_list` 必须是【裸判】、不能改写成 _cmd_has_output_option：
        # 图片素材已把显示时长烘焙成输入级 -t，串行模式多张图（16s+10s）时若改成输出侧判定，
        # 这里会补一个「第一张图的时长」-t 把整条 concat 输出截断掉。裸判在此正好让位给输入级时长。
        if not self.merge_manual_duration_enabled.get():
            try:
                _mv_path = self.merge_video.get().strip()
                if _mv_path and self._is_static_image(_mv_path):
                    if "-t" not in cmd_list and "-shortest" not in cmd_list:
                        # 图片主视频：用「截取」面板设定的「显示时长」(img_duration)，不再硬编码 10 秒
                        _mv_track = next((t for t in enabled_tracks
                                          if getattr(t, "type", "video") == "video"), None)
                        _img_dur = _eff_image_display_duration(
                            _mv_track.enc_settings if _mv_track is not None else None)
                        _out_path = cmd_list.pop()
                        cmd_list.extend(["-t", f"{_img_dur:.3f}"])
                        cmd_list.append(_out_path)
                        self._append_info_ui(
                            f"[封装] 主视频为静态图片，已按 {_img_dur:.3f} 秒输出；可在「截取」面板调整显示时长。")
            except Exception:
                pass
    
        # ---- 手动时长覆盖（最高优先级） ----
        if self.merge_manual_duration_enabled.get():
            dur_str = self.merge_manual_duration.get().strip()
            if dur_str:
                dur_sec = time_to_seconds(dur_str)
                if dur_sec is not None and dur_sec > 0:
                    # 移除已有的【输出级】-t 和 -shortest 及其参数。
                    # 只动输出侧（最后一个 -i 之后）：输入级 -t 是图片素材的「显示时长」
                    # （-loop 1 -framerate fps -t N -i img），剥掉会让该图变回无限源、
                    # 吞掉后面所有素材。
                    _last_i = max((k for k, a in enumerate(cmd_list) if a == "-i"), default=-1)
                    new_cmd = []
                    skip_next = False
                    for i, arg in enumerate(cmd_list):
                        if skip_next:
                            skip_next = False
                            continue
                        if i > _last_i and arg in ('-t', '-shortest'):
                            if arg == '-t':
                                if i+1 < len(cmd_list) and not cmd_list[i+1].startswith('-'):
                                    skip_next = True
                            continue
                        new_cmd.append(arg)
                    if new_cmd and new_cmd[-1] != '-t':
                        output_path = new_cmd.pop()
                        new_cmd.extend(['-t', f'{dur_sec:.3f}'])
                        new_cmd.append(output_path)
                    cmd_list = new_cmd
                else:
                    self._append_info_ui(_("警告：手动时长格式无效，已忽略"))



        if not preview:
            total_len = len(' '.join(cmd_list))
            if total_len > 25000:
                cmd_list, temp_files = self._shorten_long_filters(cmd_list, force=True)
            else:
                cmd_list, temp_files = self._shorten_long_filters(cmd_list)
            if temp_files:
                if not hasattr(self, '_merge_temp_files'):
                    self._merge_temp_files = []
                self._merge_temp_files.extend(temp_files)
        return cmd_list
    
    
    def _check_video_params_consistent(self, video_tracks, silent=False) -> bool:
        """
        检查所有视频轨道的编码参数是否一致（用于串联 copy 模式）。
        对比参数包括编码器名称 (codec_name)、分辨率 (高宽)、像素格式 (pix_fmt)、时间基 (time_base)、帧率 (avg_frame_rate 或 r_frame_rate)、
        这些参数是 流复制模式下 concat 要求一致的关键参数。缺少任一项都可能导致输出异常（如花屏、音画不同步、无法播放）。
        使用缓存避免重复检查，缓存键基于所有文件的路径+修改时间。
        返回 True 表示参数一致，False 表示不一致（建议切换到重新编码模式）。
        """
        if len(video_tracks) < 2:
            return True

        # 2026-10-07 禁用解析：这些轨道从未探测过，用户已声明「同规格、同一来源」。
        # 若照旧逐文件 _get_cached_stream_info，等于把刚省下的 ffprobe 全补回来 →
        # 禁用解析形同虚设。直接当「一致」放行。
        # 2026-10-08：复选框「禁用解析」(_merge_probe_skipped) 是用户当前真实意图，
        # 优先于逐轨 _no_probe 标记 —— 用户事后才勾选复选框时轨道未必带 _no_probe，
        # 若只认标记会真去探测并误判「不一致」，把 _build_concat_cmd 里强制的 copy 模式
        # 翻回重编码（见 L51176）。故此处以复选框为准直接放行。
        if self._merge_probe_skipped() or any(
                t.enc_settings.get("_no_probe", False) for t in video_tracks):
            return True
    
        # ---- 构建缓存键 ----
        # 使用 (文件路径, 修改时间) 元组列表作为键
        cache_key_parts = []
        for track in video_tracks:
            path = track.file_path
            try:
                mtime = os.path.getmtime(path)
            except OSError:
                mtime = 0
            cache_key_parts.append((path, mtime))
        cache_key = tuple(cache_key_parts)  # 元组可哈希
    
        # 检查缓存
        if not hasattr(self, '_concat_params_cache'):
            self._concat_params_cache = {}
        if cache_key in self._concat_params_cache:
            return self._concat_params_cache[cache_key]
    
        # ---- 实际检查 ----
        ref_track = video_tracks[0]
        ref_info = self._get_cached_stream_info(ref_track.file_path)
        if not ref_info:
            self._concat_params_cache[cache_key] = False
            return False
    
        ref_stream = None
        for s in ref_info.get('streams', []):
            if s.get('codec_type') == 'video':
                ref_stream = s
                break
        if not ref_stream:
            self._concat_params_cache[cache_key] = False
            return False
    
        # 提取参考参数
        ref_codec = ref_stream.get('codec_name')          #编码器名称
        ref_w = ref_stream.get('width')                   #宽度
        ref_h = ref_stream.get('height')
        ref_pix_fmt = ref_stream.get('pix_fmt')           #像素格式
        ref_time_base = ref_stream.get('time_base')       #时间基
        ref_frame_rate = ref_stream.get('avg_frame_rate') or ref_stream.get('r_frame_rate')     #帧率
    
        # 逐个比较后续轨道
        for track in video_tracks[1:]:
            info = self._get_cached_stream_info(track.file_path)
            if not info:
                self._concat_params_cache[cache_key] = False
                return False
    
            stream = None
            for s in info.get('streams', []):
                if s.get('codec_type') == 'video':
                    stream = s
                    break
            if not stream:
                self._concat_params_cache[cache_key] = False
                return False
    
            # 比较关键参数
            if stream.get('codec_name') != ref_codec:
                self._concat_params_cache[cache_key] = False
                return False
            if stream.get('width') != ref_w or stream.get('height') != ref_h:
                self._concat_params_cache[cache_key] = False
                return False
            if stream.get('pix_fmt') != ref_pix_fmt:
                self._concat_params_cache[cache_key] = False
                return False
            if stream.get('time_base') != ref_time_base:
                self._concat_params_cache[cache_key] = False
                return False
    
            frame_rate = stream.get('avg_frame_rate') or stream.get('r_frame_rate')
            if frame_rate != ref_frame_rate:
                self._concat_params_cache[cache_key] = False
                return False
    
        # 所有参数一致
        self._concat_params_cache[cache_key] = True
        return True  
    
    
    


    def merge_update_command_preview(self, output_override=None):
        # 「临时关闭刷新」勾选时：自动触发（trace/各设置变化）一律跳过——设置滤镜期间
        # 免去每次停顿都重建命令的卡顿。播放预览/快照独立于本函数，不受影响；
        # 手动点「刷新命令」按钮走 _do_merge_update_command_preview 跳过本开关。
        if getattr(self, "_merge_refresh_paused", None) and self._merge_refresh_paused.get():
            # 自动刷新被关 ⇒ 这次（以及之后到下次手动刷新前）命令预览都不会跑，
            # 缓存里的图就此停在上一代。标记脏 → 节点分析下次必须自己重算，
            # 否则会把上一代的图当成当前的（切模式 / 改设置后节点莫名其妙消失）。
            self._graph_dirty = True
            return
        # 取消之前排队的更新
        if hasattr(self, '_merge_preview_after_id') and self._merge_preview_after_id:
            self.root.after_cancel(self._merge_preview_after_id)
            self._merge_preview_after_id = None
    
        # 延迟执行真正的更新（300ms 足够覆盖连续操作）
        self._merge_preview_after_id = self.root.after(300, self._do_merge_update_command_preview, output_override)
    
    def _do_merge_update_command_preview(self, output_override=None):
        self._merge_preview_after_id = None
        if self._batch_update:
            return

        # ===== 检测是否有占位轨道 =====
        has_placeholder = any(
            t.enc_settings.get("_placeholder", False)
            for t in self.merge_tracks
            if t.type == "video"
        )
        if has_placeholder:
            current_state = self.merge_cmd_preview.cget('state')
            self.merge_cmd_preview.config(state='normal')
            self.merge_cmd_preview.delete(1.0, tk.END)
            self.merge_cmd_preview.insert(tk.END, _("正在解析文件信息，命令预览将在解析完成后生成..."))
            self.merge_cmd_preview.config(state=current_state)
            return

        # 临时启用以便更新内容
        current_state = self.merge_cmd_preview.cget('state')
        self.merge_cmd_preview.config(state='normal')
    
        # 清空并填充
        self.merge_cmd_preview.delete(1.0, tk.END)
        cmd_list = self.merge_build_cmd_list(output_override=output_override, preview=True)
        if not cmd_list:
            self.merge_cmd_preview.insert(tk.END, _("参数不完整，无法生成命令"))
        else:
            cmd_str = format_cmd_for_display(cmd_list)
            self.merge_cmd_preview.insert(tk.END, cmd_str)
    
        # 恢复用户设置的编辑状态
        self.merge_cmd_preview.config(state=current_state)

    def _get_cached_stream_info(self, path):
        """
        获取媒体流信息，带缓存。
        缓存键 = (normalize_path(path), mtime)，文件修改后自动失效。
        """
        # 虚拟颜色源：返回单视频流合成信息（宽高/时长来自哨兵，不出 real 文件）
        if _is_virtual_source(path):
            _p = _parse_color_source(path)
            if _p:
                _, w, h, _d = _p
                return {"streams": [{"index": 0, "codec_type": "video",
                                     "codec_name": "lavfi", "width": w, "height": h}]}
            return None
        norm_path = normalize_path(path)
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            mtime = None
        key = (norm_path, mtime)
        if key in self._stream_info_cache:
            return self._stream_info_cache[key]
        info = ffprobe_json(self.ffprobe_cmd, path)
        if info:
            self._stream_info_cache[key] = info
        return info

    def merge_get_media_info(self, path):
        return self._get_cached_stream_info(path)

    def _cached_video_dimensions(self, file_path):
        """
        获取视频原始宽高（不考虑旋转），优先读解析缓存（拖入文件时已填充 _stream_info_cache），
        未命中回退懒尺寸缓存，再回退未缓存 ffprobe。供构建命令复用，避免对大量文件重复探帧。
        """
        # 虚拟颜色源：宽高直接由哨兵给出（不出 real 文件）
        if _is_virtual_source(file_path):
            p = _parse_color_source(file_path)
            if p:
                return p[1], p[2]
        if not file_path or not os.path.exists(file_path):
            return None, None
        # 1) 解析缓存（命中即 0 次 ffprobe）
        info = self._get_cached_stream_info(file_path)
        if info:
            for s in info.get("streams", []):
                if s.get("codec_type") == "video":
                    w = s.get("width")
                    h = s.get("height")
                    if w and h:
                        return int(w), int(h)
        # 2) 懒尺寸缓存
        w, h = self._get_video_dimensions_cached(file_path)
        if w is not None and h is not None:
            return w, h
        # 3) 终极回退（未缓存）
        return get_video_dimensions(self.ffprobe_cmd, file_path)

    def _cached_video_rotated_dimensions(self, file_path, settings):
        """
        获取考虑元数据旋转与用户旋转后的尺寸，优先读解析缓存。
        缓存未命中时回退现有未缓存实现（保持原始行为完全一致）。

        ⚠️ 旋转语义必须与模块级 get_video_rotated_dimensions 逐字一致：
          1) 元数据旋转：side_data_list.rotation，rot % 180 == 90 时交换宽高；
          2) 用户旋转：settings["rotate"] in ("90","270") 时交换宽高。
        切勿改用不旋转的 _cached_video_dimensions / get_video_dimensions，
        否则会丢掉旋转，导致命令预览与实际转换的尺寸不一致。
        """
        w, h = self._cached_video_dimensions(file_path)
        if w is None:
            return get_video_rotated_dimensions(self.ffprobe_cmd, file_path, settings)
        # 应用元数据旋转（从缓存读取 side_data_list）
        info = self._get_cached_stream_info(file_path)
        if info:
            for s in info.get("streams", []):
                if s.get("codec_type") == "video":
                    for sd in s.get("side_data_list", []):
                        rot = sd.get("rotation")
                        if rot is not None:
                            if int(rot) % 180 == 90:
                                w, h = h, w
                            break
                    break
        # 用户旋转
        rotate = (settings or {}).get("rotate", "none")
        if rotate in ("90", "270"):
            w, h = h, w
        return w, h

    def merge_load_video_info(self):
        if self._suppress_main_video_trace:
            return

        path = self.merge_video.get().strip()
        if _is_virtual_source(path):
            # 颜色虚拟源：不解析、保留现有轨道（避免误清空列表）
            return
        if not path or not os.path.exists(path):
            self.merge_tracks = []
            self.merge_update_track_list()
            self.merge_update_output_preview()
            return
    
        self._batch_update = True
        try:
            ext = os.path.splitext(path)[1].lower().lstrip('.')
            self.original_container = ext if ext in ['mp4', 'mkv', 'mov', 'avi', 'webm'] else 'mp4'
            info = self._get_cached_stream_info(path)
            if not info:
                self._append_info_ui(_('[封装] 无法解析媒体信息: {0}，可能 ffprobe 失败').format(path))
                self.merge_tracks = []
                self.merge_update_track_list()
                self.merge_update_output_preview()
                return
            streams = info.get("streams", [])
            if not streams:
                self._append_info_ui(_('[封装] {0} 中没有发现任何流').format(path))
                return
            self.merge_tracks = []
            for s in streams:
                st = s.get("codec_type")
                if st not in ("video","audio","subtitle"):
                    continue
                track = Track(s["index"], st, s.get("codec_name", "unknown"), path, True)
                self.merge_tracks.append(track)
            if not self.merge_tracks:
                self._append_info_ui(_('[封装] {0} 中未找到视频/音频/字幕轨道').format(path))
            self.merge_update_track_list()
            self.merge_auto_recommend_container()
            self.merge_update_output_preview()
        finally:
            self._batch_update = False
            self.merge_refresh_ui()

    def merge_refresh_ui(self):
        """轨道列表 + 命令预览一起刷新（27 处调用点的固定两连，2026-10-01 抽取）。

        只含两连本身；需要顺带刷 AT 总时长引用的调用点请自行补
        self._refresh_at_total_ref()。
        """
        self.merge_update_track_list()
        self.merge_update_command_preview()

    def merge_update_track_list(self, keep_tracks=None):
        """刷新轨道列表，显示分组编号（同一文件的音频/字幕共享组号）

        ⚠️ 2026-10-12：本函数是**整表重建**（delete 全部行再 insert），而 delete 会清空
        selection ⇒ 任何编辑/保存/启用切换后刷新，选中行都消失，用户「子视频一多就要反复
        确认上次改到哪一个」。故刷新前记住选中轨道、重建后按**轨道对象**还原（见末尾）。

        🔴 还原必须按 **id(track)** 而不是按 iid（`track_{i}`）：删除 / 上移 / 下移后索引会
        漂移、iid 被复用，按 iid 还原会**选中到别的轨道**（删除一行后全部错位）。

        keep_tracks：调用方显式指定「刷新后要保持选中的**轨道对象**」列表。
            · None（默认）⇒ 按当前 selection 解析 —— 用于**行与数据仍一一对应**的常规刷新
              （编辑保存 / 启用切换 / 克隆 / 添加…），零回归；
            · 传列表 ⇒ 用于**行序已变**的操作（删除 / 上移 / 下移）：此刻旧 selection 的 iid
              与 merge_tracks 索引已错位，必须由调用方给出对象；已删除的对象自然落空 ⇒ 不选中。
        """
        if self._batch_update:
            return

        # 记住刷新前选中的轨道对象（delete 会清空 selection ⇒ 必须在此之前取）
        _prev_sel_ids = set()
        if keep_tracks is not None:
            _prev_sel_ids = {id(_t) for _t in keep_tracks}
        else:
            with suppress(Exception):
                for _iid in self.merge_tree.selection():
                    _s = str(_iid)
                    if not _s.startswith("track_"):
                        continue
                    _i = int(_s[6:])
                    if 0 <= _i < len(self.merge_tracks):
                        _prev_sel_ids.add(id(self.merge_tracks[_i]))

        # 清空现有行
        for item in self.merge_tree.get_children():
            self.merge_tree.delete(item)
    
        # 配置标签颜色（主视频、子视频、音频、字幕）
        # 每种类型有两套：偶数行和奇数行（交替）
        self.merge_tree.tag_configure('even_main', background='#d9e8f7')
        self.merge_tree.tag_configure('odd_main', background='#85C1E9')
        self.merge_tree.tag_configure('even_pip', background='#d9f0d9')
        self.merge_tree.tag_configure('odd_pip', background='#bde0bd')
        self.merge_tree.tag_configure('even_concat', background='#fdebd0')
        self.merge_tree.tag_configure('odd_concat', background='#fad7a5')
        self.merge_tree.tag_configure('even_audio', background='#f0f0f0')
        self.merge_tree.tag_configure('odd_audio', background='#e0e0e0')
        self.merge_tree.tag_configure('even_subtitle', background='#e8e0f0')
        self.merge_tree.tag_configure('odd_subtitle', background='#d8cfe8')
        self.merge_tree.tag_configure('even_video', background='#f0f0f0')
        self.merge_tree.tag_configure('odd_video', background='#e0e0e0')
        self.merge_tree.tag_configure('disabled', foreground='#B22222')
        # 画中画分组配色（每组不同色；主视频 / 未编组子视频不染，保持上面斑马纹）。
        # ⚠️ ttk.Treeview 只能「整行」上色（tags），无法只染「序号」一格 —— 故整行背景按组
        # 上色，与现有 even/odd 斑马纹 + 主/画/串 高亮同一种视觉语言（组 tag 置 tags 首位=优先）。
        _grp_palette = ('#f3e5f5', '#d7f0ec', '#fbe4ef', '#fff3cd',
                        '#e6e6fa', '#f0e6dd', '#dceefb', '#eaf4d3')
        for _ci, _col in enumerate(_grp_palette):
            self.merge_tree.tag_configure("grp_c%d" % _ci, background=_col)

        # 确定主视频
        enabled_video_tracks = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        main_video = enabled_video_tracks[0] if enabled_video_tracks else None

        # ----- 画中画分组（嵌套合成）信息：组号 / 组内主（2026-10-15）-----
        _grp_members_ui = {}
        for _i, _t in enumerate(self.merge_tracks):
            if getattr(_t, "type", "") != "video":
                continue
            _g = str((_t.enc_settings or {}).get("grp") or "").strip()
            if _g:
                _grp_members_ui.setdefault(_g, []).append(_i)
        _grp_num = {_g: (_k + 1) for _k, _g in enumerate(_grp_members_ui)}
        _grp_base_ui = {}
        for _g, _ms in _grp_members_ui.items():
            _grp_base_ui[_g] = next(
                (_i for _i in _ms
                 if (self.merge_tracks[_i].enc_settings or {}).get("is_grp_base")), _ms[0])
        _grp_seen = {}
        _grp_parent_done = {}      # 父行是否已输出（**不动 `_grp_seen`** —— 那是组内序号计数）

        # ----- 组：虚拟父行 + 假缩进 + 成员坐标双显示（2026-10-16 用户定案）-----
        # 父行是**虚拟行**（不对应任何轨道），映射「组内最终输出的那个标签」
        # `v_grp_<g>_<n-1>`（组内合成链 `[v_gbase_g]→[v_grp_g_0]→…` 的最后一环）。
        # 缩进用**假缩进**（序号列前缀），不改成 `show="tree headings"` —— 后者会引入 #0
        # 树列，与既有 7 列布局 / 斑马纹 / 组 tag 的 tag 优先级规则全面冲突。
        _grp_ui = {}
        try:
            _canvas_ui = (self._get_canvas_size(enabled_video_tracks[0])
                          if enabled_video_tracks else None)
        except Exception:
            _canvas_ui = None
        if _canvas_ui:
            for _g, _ms in _grp_members_ui.items():
                _geo = None
                with suppress(Exception):
                    _geo = self._group_box_geometry(
                        [(self.merge_tracks[_i].file_path,
                          self.merge_tracks[_i].enc_settings) for _i in _ms],
                        canvas=_canvas_ui)
                if _geo is None:
                    continue
                _base_i = _grp_base_ui.get(_g, _ms[0])
                _ddx, _ddy = self._group_place_delta(
                    self.merge_tracks[_base_i].enc_settings or {})
                _grp_ui[_g] = {
                    "size": _geo["size"],
                    # 落位 = 盒原点 + 组级增量（与渲染 `_group_place_xy` 同口径）
                    "origin": (_geo["origin"][0] + _ddx, _geo["origin"][1] + _ddy),
                    "rel": {_ms[_k]: _geo["rel"][_k] for _k in range(len(_ms))},
                    "label": "v_grp_%s_%d" % (_g, len(_ms) - 1),
                    "first": _ms[0],          # 父行插在组内**列表序最上**成员之前
                }
    
        # ----- 分组编号 -----
        # 为每个不同的 file_path 分配组编号（忽略空路径）
        file_to_group = {}
        next_group = 1
        for track in self.merge_tracks:
            file_path = track.file_path
            if file_path and file_path not in file_to_group:
                file_to_group[file_path] = next_group
                next_group += 1
    
        # 初始化每个组的各类型计数器
        group_counters = {}
        for group in file_to_group.values():
            group_counters[group] = {'video': 0, 'audio': 0, 'subtitle': 0}
        # 用于无文件路径的轨道（回退序号）
        fallback_counter = 0
    
        for i, track in enumerate(self.merge_tracks):
            # ---- 组父行（**虚拟行**）：插在组内「列表序最上」成员之前 ----
            # iid 用 `grp_<gid>`，**刻意不匹配 `track_<i>`** ⇒ `_get_selected_track_indices`
            # 自动跳过它，任何按索引操作的命令（上移/下移/删除/启用/编组）都不会误伤父行。
            # 父行 = 「组内最终输出的那个标签」的宿主：那条 `[主画布][组输出]overlay` 就是
            # 组的整体落位（x/y/enable），也就是父行的语义。
            _g_of = (str((track.enc_settings or {}).get("grp") or "").strip()
                     if track.type == "video" else "")
            _gu = _grp_ui.get(_g_of) if _g_of else None
            if _gu is not None and not _grp_parent_done.get(_g_of):
                if _gu["first"] == i:
                    _grp_parent_done[_g_of] = True
                    _gm = _grp_members_ui.get(_g_of, [])
                    _gon = sum(1 for _x in _gm if self.merge_tracks[_x].enabled)
                    # ---- 轨迹来源标记（2026-10-18 用户定案：「父行的规格」也可承载）----
                    # 整组位移轨迹有两个候选源：父行素材项（**优先**）/ 组内主 enc_settings
                    # （父行没配时生效）。父行窗只预填自己那份 ⇒ 用户看不到组内主那条，
                    # 会以为「父行继承了轨迹」。规格列直接标出当前生效来源，判据与渲染
                    # 同口径（`_group_traj_kind`：列表 **+ 预制四模式**）；都没有 ⇒ 不加后缀。
                    # 🔴 2026-10-18 用户第 1 条：只问列表轨迹（旧 `_group_has_list_traj`）时，
                    #    **预制轨迹**（左右扫/上下扫/菱形/四角）被判成"没轨迹"，可整组明明在动
                    #    ⇒ 这里必须按 `_group_traj_kind` 标出类型（`·预制`）。父行自旋转同理
                    #    单列 `· 自旋:父`（它也是整组姿态，父行才有的东西）。
                    _traj_lbl = ""
                    if _gm:
                        _bi2 = _grp_base_ui.get(_g_of, _gm[0])
                        if 0 <= _bi2 < len(self.merge_tracks):
                            _fkey2 = self._group_final_label_key(_g_of, len(_gm))
                            _row_it2 = self._group_material_item(_fkey2)
                            _k2 = self._group_traj_kind(_row_it2)
                            if _k2:
                                _traj_lbl = _(" · 轨迹:父") + (_("·预制") if _k2 == "预制" else "")
                            else:
                                _k3 = self._group_traj_kind(
                                    self.merge_tracks[_bi2].enc_settings or {})
                                if _k3:
                                    _traj_lbl = (_(" · 轨迹:主")
                                                 + (_("·预制") if _k3 == "预制" else ""))
                            if self._group_material_row_proj(
                                    _fkey2, item=_row_it2).get("spin_enabled"):
                                _traj_lbl += _(" · 自旋:父")
                            # 2026-10-18 用户定案 A：`grp:<gid>` 这个 key 也会被右键
                            # 「视频节点」追加效果（那个入口是"每次套用 = 再挂一条"）。
                            # 滤镜类全项合并 ⇒ 真生效；几何类只读第 0 条 ⇒ 追加项里静默失效。
                            # 规格列只能体现第 0 条 ⇒ 把"还有几条"标出来，否则
                            # 「父行显示没轨迹、画面却在动」无从查起。
                            _n_x2, _geo_x2 = self._group_material_extra(_fkey2)
                            if _n_x2:
                                _traj_lbl += (_(" · 另有%d条(几何不生效)") % _n_x2
                                              if _geo_x2 else _(" · 另有%d条") % _n_x2)
                    self.merge_tree.insert(
                        "", tk.END, iid="grp_%s" % _g_of,
                        values=("▾ " + _g_of,
                                _("启") if _gon == len(_gm) else (_("禁") if not _gon else _("半")),
                                _("组(%d)") % len(_gm),
                                _("盒 %dx%d · 落位(%g,%g)%s") % (
                                    _gu["size"][0], _gu["size"][1],
                                    _gu["origin"][0], _gu["origin"][1], _traj_lbl),
                                "",
                                "→ [%s]" % _gu["label"],
                                ""),
                        tags=("grp_c%d" % ((_grp_num[_g_of] - 1) % len(_grp_palette)),))

            # ----- 生成序号（单条时不添加后缀） -----
            file_path = track.file_path
            group = file_to_group.get(file_path)
            if group is not None:
                # 有文件路径，使用分组编号
                if track.type == 'video':
                    group_counters[group]['video'] += 1
                    cnt = group_counters[group]['video']
                    # 如果该组视频只有1条，不加后缀
                    if cnt == 1:
                        seq = f"V{group}"
                    else:
                        seq = f"V{group}-{cnt}"
                elif track.type == 'audio':
                    group_counters[group]['audio'] += 1
                    cnt = group_counters[group]['audio']
                    if cnt == 1:
                        seq = f"A{group}"
                    else:
                        seq = f"A{group}-{cnt}"
                elif track.type == 'subtitle':
                    group_counters[group]['subtitle'] += 1
                    cnt = group_counters[group]['subtitle']
                    if cnt == 1:
                        seq = f"S{group}"
                    else:
                        seq = f"S{group}-{cnt}"
                else:
                    fallback_counter += 1
                    seq = str(fallback_counter)
            else:
                # 无文件路径（如静音轨道），使用回退序号
                fallback_counter += 1
                seq = str(fallback_counter)

            # 假缩进（2026-10-16）：组成员序号前加树形前缀 ⇒ 父行之下自然成一棵树。
            # 不用 Treeview 真父子（`show="tree headings"` 会插入 #0 树列，与 7 列布局 /
            # 斑马纹 / 组 tag 优先级规则全面冲突；且重排行序会让「按 iid 索引」的既有
            # 命令全部失准）。
            if _g_of and _g_of in _grp_members_ui:
                seq = "└ " + seq

    
            # 确定标签
            if track.type == "video":
                if track == main_video:
                    tag = 'even_main' if i % 2 == 0 else 'odd_main'
                elif self.pip_enabled.get():
                    tag = 'even_pip' if i % 2 == 0 else 'odd_pip'
                elif self.concat_enabled.get():
                    tag = 'even_concat' if i % 2 == 0 else 'odd_concat'
                else:
                    tag = 'even_video' if i % 2 == 0 else 'odd_video'
            elif track.type == "audio":
                tag = 'even_audio' if i % 2 == 0 else 'odd_audio'
            elif track.type == "subtitle":
                tag = 'even_subtitle' if i % 2 == 0 else 'odd_subtitle'
            else:
                tag = 'even' if i % 2 == 0 else 'odd'
    
            # 显示内容
            enabled_text = _("启") if track.enabled else _("禁")
            enc_text = _("复制流") if not track.is_encoding() else track.enc_settings.get("encoder", "?")
            # 画中画分组：组员类型后缀「视频(组)gN-#」+ 组内主标 [主] + 整行按组配色 tag
            _grp_tag = None
            _grp_show = ""
            if track.type == "video" and track != main_video:
                _g = str((track.enc_settings or {}).get("grp") or "").strip()
                if _g and _g in _grp_members_ui:
                    _ord = _grp_seen.get(_g, 0) + 1
                    _grp_seen[_g] = _ord
                    _is_base = (i == _grp_base_ui[_g])
                    _grp_show = _("视频(组)g%d-%d%s") % (
                        _grp_num[_g], _ord, _(" [主]") if _is_base else "")
                    _grp_tag = "grp_c%d" % ((_grp_num[_g] - 1) % len(_grp_palette))
            display_type = track.type
            if track.type == "video" and track == main_video:
                display_type = _("视频(主)")
            elif track.type == "video":
                if _grp_show:
                    display_type = _grp_show
                elif self.pip_enabled.get():
                    display_type = _("视频(画)")
                elif self.concat_enabled.get():
                    display_type = _("视频(串)")
                else:
                    display_type = _("视频(从)")
    
            # ---- 规格 ----
            if track.type == "video":
                if _is_virtual_source(track.file_path):
                    # 虚拟颜色源：规格直接由哨兵给出（不探文件）
                    _cp = _parse_color_source(track.file_path)
                    detail = (_('{0}x{1} · {2} (生成源)').format(_cp[1], _cp[2], seconds_to_time(_cp[3]))
                              if _cp else _("颜色源"))
                # 2026-10-08：复选框「禁用解析」(_merge_probe_skipped) 为准 —— 事后勾选时
                # 轨道未必带 _no_probe 标记，仍应跳过尺寸/时长探测，避免 UI 线程被几百行
                # 同步 ffprobe 卡死。
                if track.enc_settings.get("_no_probe", False) or self._merge_probe_skipped():
                    # 禁用解析添加的轨道（2026-10-07）：**不查尺寸、不查时长**。
                    # 这里若照旧调 _get_video_size_chain + _get_media_duration，
                    # 每行就是 2 次同步 ffprobe（后者是直接 subprocess，不走流缓存），
                    # 几百行会把 UI 线程卡死 —— 比后台解析还糟。
                    detail = _("（已跳过解析）")
                elif track.enc_settings.get("_placeholder", False):
                    detail = _("解析中…")
                elif track.enc_settings.get("_error"):
                    detail = _("❌ 解析失败")
                elif not _is_virtual_source(track.file_path):
                    chain = self._get_video_size_chain(track)
                    if chain:
                        detail = " → ".join(chain)
                    else:
                        detail = _("未知")
                    # 附上时长
                    dur = self._get_media_duration(track.file_path)
                    if dur is not None:
                        detail += f" ({seconds_to_time(dur)})"
            elif track.type == "audio":
                info = self._get_cached_stream_info(track.file_path)
                if info:
                    streams = info.get('streams', [])
                    for s in streams:
                        if s.get('codec_type') == 'audio' and s.get('index') == track.index:
                            bitrate = s.get('bit_rate')
                            if bitrate:
                                try:
                                    bitrate_kbps = int(bitrate) // 1000
                                    detail = f"{bitrate_kbps} kbps"
                                except:
                                    detail = s.get('codec_name', _('音频'))
                            else:
                                # 构建备选信息
                           #     codec_name = s.get('codec_name', '')
                                sample_rate = s.get('sample_rate')
                                channels = s.get('channels')
                                parts = []
                      #          if codec_name:
                      #              parts.append(codec_name)
                                if sample_rate:
                                    parts.append(f"{int(sample_rate)//1000}kHz")
                                if channels:
                                    parts.append(f"{channels}ch")
                                detail = " ".join(parts) if parts else "-"
                            dur = self._get_media_duration(track.file_path)
                            if dur is not None:
                                detail += f" ({seconds_to_time(dur)})"
                            break
                    else:
                        detail = "-"
                else:
                    detail = "-"
            elif track.type == "subtitle":
                info = self._get_cached_stream_info(track.file_path)
                lang = ""
                if info:
                    streams = info.get('streams', [])
                    for s in streams:
                        if s.get('codec_type') == 'subtitle' and s.get('index') == track.index:
                            tags = s.get('tags', {})
                            lang = tags.get('language', '')
                            break
                detail = f"{lang}" if lang else "-"
            else:
                detail = "-"
    
            # ---- 子视频显示时段（开始时间）：只追到「规格」列后面 ----
            # 只有子视频（非主视频的视频轨）才有在主时间线上的可见窗口；
            # 数据来自子视频编辑器的 show_start（显示时段起点，输出时间线秒，
            # 与 enable / 窗口优化同源）。主视频始终铺满、音频/字幕无此概念→不追加，
            # 以免其它模式空占列宽。仅显示开始时间（用户按简短要求）。
            #
            # 仅在画中画模式追加：show_start 出自「循环/绿幕控制」页，而该页只在
            # 画中画模式下的子视频编辑器里出现（见 merge_edit_video_track 的 show_loop），
            # concat/串联模式没有这一页，追加会在非画中画模式凭空多出一串「始于 00:00.00」。
            if track.type == "video" and track != main_video and self.pip_enabled.get():
                _es = track.enc_settings if isinstance(track.enc_settings, dict) else {}
                _ws = (_es.get("show_start", "") or "").strip()
                _ss = time_to_seconds(_ws) if _ws else 0.0
                detail += _('  · 始于 {0}').format(_fmt_window_time(_ss))

            # ---- 组成员：坐标**双显示**（盒内局部 + 主画布绝对，2026-10-16 用户要求）----
            # 两处口径都摊开：`rel` = 盒内相对（= 渲染时组成员层的实际落位，`xy_override`）；
            # 绝对 = 成员 overlay_x/y 原值（主画布域，与位置编辑器 / 时间总览同口径）。
            if _gu is not None and i in _gu["rel"]:
                _rx, _ry = _gu["rel"][i][0], _gu["rel"][i][1]   # rel 是 (x, y, w, h)
                _es_m = track.enc_settings if isinstance(track.enc_settings, dict) else {}
                _ax = str(_es_m.get("overlay_x", "") or "").strip()
                _ay = str(_es_m.get("overlay_y", "") or "").strip()
                detail += _("  · 盒内(%g,%g)%s") % (
                    _rx, _ry,
                    (_("  画布(%s,%s)") % (_ax or "0", _ay or "0")) if (_ax or _ay) else "")

            values = (
                seq,
                enabled_text,
                display_type,
                detail,
                track.codec[:10],
                (self._virtual_source_label(track.file_path)
                 if _is_virtual_source(track.file_path)
                 else (os.path.basename(track.file_path) if track.file_path else _("外部"))),
                enc_text
            )
            iid = f"track_{i}"
            # ⚠️ ttk.Treeview 的 tag 优先级 = **tag_configure 的配置顺序**（先配置者优先），
            #   与 -tags 列表顺序无关！组 tag `grp_c*` 建在 even_pip/odd_pip **之后** ⇒
            #   斑马纹反而更高优先 ⇒ 组色被整行盖掉（2026-10-15 实测：编组后仍显示原斑马绿）。
            #   唯一确定性做法：整行只留**一个**设 background 的 tag —— 组成员只用组 tag，
            #   非组员只用斑马 tag；`disabled` 只设 foreground，可安全并存。
            _tags = [_grp_tag if _grp_tag else tag]
            if not track.enabled:
                _tags.append("disabled")
            row_tags = tuple(_tags)
            self.merge_tree.insert("", tk.END, iid=iid, values=values, tags=row_tags)
    
        if not self.merge_tracks:
            self.merge_tree.insert("", tk.END, values=("", "", "", _("未加载轨道"), "", "", ""))

        # ---- 还原选中（2026-10-12）----
        # 按轨道对象回找新 iid：删除的行找不到（保持未选中，符合预期）、上移/下移的行
        # 跟着轨道走（选中不丢也不错位）。`merge_tree` 未绑定 <<TreeviewSelect>> ⇒
        # 不会触发选中事件回环（区别于轨迹列表那种「重建→事件→再重建」的卡死链）。
        if _prev_sel_ids:
            _restore = ["track_%d" % _i for _i, _t in enumerate(self.merge_tracks)
                        if id(_t) in _prev_sel_ids]
            if _restore:
                with suppress(Exception):
                    self.merge_tree.selection_set(*_restore)
                    self.merge_tree.see(_restore[0])

    def _merge_iid_idx(self, iid):
        """列表项 iid → 轨道索引；**组父行 / 非法 iid → 越界哨兵 `len(merge_tracks)`**。

        为什么是哨兵而不是 None（2026-10-16）：全仓 10+ 处既有写法都是
        `idx = int(iid.split('_')[1])` 紧跟 `if idx >= len(self.merge_tracks): continue`
        （或反向的 `idx < len(...)`）。返回哨兵后这些**既有判定天然把父行当「无效」处理**，
        无需逐点改写；改成 None 反而要在 10+ 处补 `is None` 判空。
        组父行 iid = `grp_<gid>`（虚拟行，不对应任何轨道）—— 旧写法遇到它直接 ValueError。
        """
        _n = len(getattr(self, "merge_tracks", None) or [])
        _s = str(iid)
        if not _s.startswith("track_"):
            return _n
        try:
            return int(_s.split('_')[1])
        except (ValueError, IndexError):
            return _n

    def _get_selected_track_indices(self):
        """获取选中行的轨道索引列表（按实际列表顺序）。

        ⚠️ 组父行（iid = `grp_<gid>`）**不是轨道** —— 走 `_merge_iid_idx` 天然被滤掉
        （否则 `int("grp_g1".split('_')[1])` 直接 ValueError）。
        """
        indices = []
        for iid in self.merge_tree.selection():
            _i = self._merge_iid_idx(iid)
            if 0 <= _i < len(self.merge_tracks):
                indices.append(_i)
        return sorted(indices)
    
    def merge_toggle_selected(self):
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        # 如果所有选中的都启用，则全部禁用；否则全部启用
        all_enabled = all(self.merge_tracks[idx].enabled for idx in indices)
        new_state = not all_enabled
        # 🔴 禁用主视频会把后面的组顺势顶上主视频位（与 _move_selected_tracks 同一硬拦截）
        #    用「启用视图」预览切换结果，先判后改 ⇒ 不留半错态
        _pend = {id(self.merge_tracks[_i]): new_state for _i in indices}
        if self._block_group_as_main(self.merge_tracks,
                                     lambda _t: _pend.get(id(_t), _t.enabled)):
            return
        for idx in indices:
            self.merge_tracks[idx].enabled = new_state
        self.merge_refresh_ui()

    # ---------- 编组（嵌套合成，2026-10-15）----------
    # 组数据存于各视频轨 enc_settings：grp（组标识，空=未编组）+ is_grp_base（组内主）。
    # 组内主缺省 = 组内列表序最上那条（自动），可用右键「设为组内主视频」显式改。
    def _block_group_as_main(self, tracks, enabled_of=None):
        """组不得占据「主视频位」= 首条启用视频轨（输出分辨率 / 表达式 W/H 基准的真相源）。

        组是叠加层：坐标相对画布、自身不提供画布，尺寸＝成员并集（没有合法通用尺寸），
        成员表达式还引用 W/H 且允许负原点 ⇒ 组顶到主视频位，`_group_box_geometry` 拿到的
        画布就变成组基成员自己的尺寸，盒原点与成员 rel 全错。三个入口共用本判定：
        移动（`_move_selected_tracks`）、删除（`merge_delete_selected`）、启用/禁用
        （`merge_toggle_selected`）。命中即弹提示并返回 True（调用方直接 return）。

        enabled_of: 可选「启用视图」（轨道 → bool）。默认读 `t.enabled`；切换启用状态时
        传预览视图，避免先改 `self.merge_tracks` 再回滚（模态期间不留半错态）。
        """
        _en = enabled_of or (lambda _t: _t.enabled)
        for _t in (tracks or []):
            if _t.type != "video" or not _en(_t):
                continue
            if not str((_t.enc_settings or {}).get("grp") or "").strip():
                return False
            alert_if(True, _("提示"),
                     _("组不能放到最上面当主视频：组没有固定尺寸，输出分辨率由主视频决定。\n"
                       "想让组当整屏背景，请先在它上面加一条虚拟素材（「生成 ▸ 颜色背景」）作为主视频占位，尺寸即输出分辨率。"),
                     'info')
            return True
        return False

    def _merge_existing_group_ids(self):
        """当前已有的分组标识（按首次出现顺序）。"""
        _ids = []
        for _t in getattr(self, "merge_tracks", []) or []:
            _es = _t.enc_settings if isinstance(_t.enc_settings, dict) else {}
            _g = str(_es.get("grp") or "").strip()
            if _g and _g not in _ids:
                _ids.append(_g)
        return _ids

    def _next_merge_group_id(self):
        _exist = set(self._merge_existing_group_ids())
        _n = 1
        while ("g%d" % _n) in _exist:
            _n += 1
        return "g%d" % _n

    def _merge_group_selected(self):
        """右键「编组（新建组）」：把选中的视频轨合成一个新组（组内 overlay）。

        ⚠️ **主视频（列表第 1 条启用视频轨）不参与编组**（2026-10-16）：组是「叠加层」
        的概念 —— 构建器只从子视频里取组成员（`sub_infos`），把主视频选进组会得到一个
        **永远建不起来的组**（组内成员数不足 ⇒ 静默降级）。与其让用户对着没反应的组
        猜，不如在入口就说清楚。
        """
        if not self.pip_enabled.get():
            self._append_info_ui(_("[分组] 编组仅画中画模式可用"))
            return
        _evs = self._get_enabled_video_tracks()
        _main = _evs[0] if _evs else None
        _idx = [i for i in self._get_selected_track_indices()
                if self.merge_tracks[i].type == "video"
                and self.merge_tracks[i] is not _main]
        if len(_idx) < 2:
            alert_if(True, _("提示"), _("请选中至少 2 条**子视频**轨再编组（主视频不参与编组）"), 'info')
            return
        _g = self._next_merge_group_id()
        for _k, _i in enumerate(_idx):
            _es = self.merge_tracks[_i].enc_settings
            _es["grp"] = _g
            _es["is_grp_base"] = (_k == 0)   # 组内列表序最上 = 组内主（自动）
        self.merge_refresh_ui()
        self._append_info_ui(
            _("[分组] 已新建组 %s（%d 条；组内最上=组内主，可用右键「设为组内主视频」改）")
            % (_g, len(_idx)))
        # 组员的**位移**轨迹编组后不生效（整组位移由组节点统一承载，来源 = 父行 / 组内主）；
        # 但成员的旋转 / 缩放 / 透明度航点仍在自己的内容腿里照常生效 —— 只提示，不改数据。
        # ⚠️ 判据用 `_group_traj_kind`（列表 **+ 预制**）：组员的预制轨迹位移同样被 A3 的
        #    静态 rel 取代（`xy_override`），只问列表轨迹会漏报（2026-10-18 用户第 1 条）。
        _wp_mem = [self.merge_tracks[_i] for _i in _idx[1:]
                   if self._group_traj_kind(self.merge_tracks[_i].enc_settings)]
        if _wp_mem:
            self._append_info_ui(
                _("[分组] 有 %d 条组员带轨迹（列表/预制）：它们的**位移**在组内不生效"
                "（整组位移由组节点承载），旋转 / 缩放 / 透明度仍按各自生效。")
                % len(_wp_mem))

    def _merge_group_add_selected(self, gid):
        """右键「加入组 ▸ gN」：把选中且未编组的视频轨加入现有组（主视频不参与，同上）。"""
        _evs = self._get_enabled_video_tracks()
        _main = _evs[0] if _evs else None
        _idx = [i for i in self._get_selected_track_indices()
                if self.merge_tracks[i].type == "video"
                and self.merge_tracks[i] is not _main
                and not str((self.merge_tracks[i].enc_settings or {}).get("grp") or "").strip()]
        if not _idx:
            alert_if(True, _("提示"), _("请选中未编组的视频轨"), 'info')
            return
        for _i in _idx:
            self.merge_tracks[_i].enc_settings["grp"] = gid
            self.merge_tracks[_i].enc_settings.setdefault("is_grp_base", False)
        self.merge_refresh_ui()
        self._append_info_ui(_("[分组] 已加入组 %s（%d 条）") % (gid, len(_idx)))
        # 加入的成员一律是**组员**（组内主不变）⇒ 它们的位移轨迹在组内不生效，仅提示。
        _wp_mem2 = [self.merge_tracks[_i] for _i in _idx
                    if self._group_traj_kind(self.merge_tracks[_i].enc_settings)]
        if _wp_mem2:
            self._append_info_ui(
                _("[分组] 有 %d 条加入的组员带轨迹（列表/预制）：它们的**位移**在组内不生效"
                "（整组位移由组节点承载），旋转 / 缩放 / 透明度仍按各自生效。")
                % len(_wp_mem2))

    def _merge_group_remove_selected(self):
        """右键「移出组」：把选中轨道移出各自所在的组（组内主标记一并清除）。"""
        # 🔴 2026-10-16（用户拍板「清空」）：**移出后组若不复存在（剩余成员 < 2），
        #    要连着把该组的「输出态」一起清掉**（组级字段 + 父行素材项）——
        #    否则残留的 grp_dx/dy、grp_rot_angle 与 node_fx[组输出 key] 会在
        #    重建出同 gid（`_next_merge_group_id` 取最小可用号 ⇒ 解散后又从 g1 开始）
        #    且结构相同的组时**原地复活**（用户实测「取消组后重新组合，那些应用的滤镜还在」）。
        #    ⚠️ 只清「真的没了」的组：移出一条但还剩 ≥2 条的组**依然存在**，
        #       它的父行效果必须原样保留（那是还活着的组的设置）。
        _sel = self._get_selected_track_indices()
        _touched = []          # 本次被移出的 gid（保序去重）
        for _i in _sel:
            _g = str((self.merge_tracks[_i].enc_settings or {}).get("grp") or "").strip()
            if _g and _g not in _touched:
                _touched.append(_g)
        # ⚠️ 一切「按组标签/指纹」的计算都必须在 **pop grp 之前** ——
        #    `_node_key_of_label` 要构图，组没了就查不到该节点 ⇒ key 落 None。
        _before = {}
        for _g in _touched:
            _before[_g] = [t for t in self.merge_tracks
                           if str((t.enc_settings or {}).get("grp") or "").strip() == _g]
        _going = [self.merge_tracks[_i] for _i in _sel]
        _cleared = 0
        for _g, _mems in _before.items():
            # 移出后仍 ≥2 条的组 = **还活着** ⇒ 父行效果与组级字段必须原样保留；
            # 名存实亡（剩 <2 条）⇒ 连着输出态一起清。
            _left = [t for t in _mems if not any(t is _x for _x in _going)]
            if len(_left) >= 2:
                continue
            _cleared += self._merge_group_clear_output_state(_g, _mems)
        _n = 0
        for _i in _sel:
            _es = self.merge_tracks[_i].enc_settings
            if str(_es.get("grp") or "").strip():
                _es.pop("grp", None)
                _es.pop("is_grp_base", None)
                _n += 1
        if _n:
            self.merge_refresh_ui()
            self._append_info_ui(_("[分组] 已移出组 %d 条") % _n)
            if _cleared:
                self._append_info_ui(
                    _("[分组] 该组已不复存在 ⇒ 一并清除组落位/角度与组输出效果（共 %d 项）") % _cleared)

    def _merge_group_dissolve_selected(self):
        """右键「解散整组」：解散选中轨所属的整个组（所有成员一起移出）。"""
        _gids = set()
        for _i in self._get_selected_track_indices():
            _g = str((self.merge_tracks[_i].enc_settings or {}).get("grp") or "").strip()
            if _g:
                _gids.add(_g)
        if not _gids:
            return
        # 同上：整组消失 ⇒ 连着清掉「输出态」（组级字段 + 父行素材项）。
        # ⚠️ 必须**先**算 label/key（要原始成员表 + 组还在图里），再 pop grp。
        _before = {_g: [t for t in self.merge_tracks
                        if str((t.enc_settings or {}).get("grp") or "").strip() == _g]
                   for _g in _gids}
        _cleared = 0
        for _g, _mems in _before.items():
            _cleared += self._merge_group_clear_output_state(_g, _mems)
        _n = 0
        for _t in self.merge_tracks:
            _es = _t.enc_settings if isinstance(_t.enc_settings, dict) else {}
            if str(_es.get("grp") or "").strip() in _gids:
                _es.pop("grp", None)
                _es.pop("is_grp_base", None)
                _n += 1
        self.merge_refresh_ui()
        self._append_info_ui(_("[分组] 已解散 %d 个组（共 %d 条）") % (len(_gids), _n))
        if _cleared:
            self._append_info_ui(
                _("[分组] 同时清除组落位/角度与组输出效果（共 %d 项）") % _cleared)

    def _merge_group_clear_output_state(self, gid, mems):
        """组**彻底消失**时清空它的「输出态」（2026-10-16 用户拍板：**清空**，不保留）。

        清两样东西：
          ① **组级字段**（`grp_dx/dy`、`grp_abs_x/y`、`grp_rot_angle`，存在成员身上）——
             它们是**纯组状态**，解组后没有任何归属地；留着 = 成员身上带一把看不见的锁，
             而且重建出同 gid 的组时会**原地复活**（`_next_merge_group_id` 取最小可用号
             ⇒ 全解散后再编组又从 `g1` 开始）。
          ② **父行素材项** `node_fx[组最终输出标签的 key]` —— 父行效果（缩放 / 淡入淡出 /
             透明度 / 抠像 / 角度）寄居在这里。它的 key 是 `node_fingerprint(段序号, 末滤镜名)`，
             **结构相同的组重建后 key 相同** ⇒ 不清就会「凭空复活」，而父行此时已从列表
             消失 ⇒ 用户**看不见、也无处删除**（违反「所见即所得」）。
             ⇒ 清掉，并在调用方信息栏报数（可追溯）。

        ⚠️ 判据用 `_merge_group_row_label` + `_node_key_of_label`（与
           `_merge_edit_group_row` / `_open_node_effect_editor` **同一口径**），
           不另行推断 ⇒ 不会误伤普通节点的同名 key。
        ⚠️ 必须在 **pop `grp` 之前**调用（要通过 label 查图里的节点指纹）。
        返回：被清掉的项数（组级字段个数 + 父行效果项，供日志报数）。
        """
        _n = 0
        for _t in mems or []:
            _es = _t.enc_settings if isinstance(_t.enc_settings, dict) else None
            if not _es:
                continue
            for _k in ("grp_dx", "grp_dy", "grp_abs_x", "grp_abs_y", "grp_rot_angle"):
                if _k in _es:
                    _es.pop(_k, None)
                    _n += 1
        try:
            _mems_ok = [t for t in (mems or [])
                        if isinstance(getattr(t, "enc_settings", None), dict)]
            if _mems_ok:
                _label = self._merge_group_row_label(gid, _mems_ok)
                _key = self._node_key_of_label(_label) if _label else None
                _fx = getattr(self, "node_fx", None)
                if _key and isinstance(_fx, dict) and _key in _fx:
                    _fx.pop(_key, None)
                    _n += 1
        except Exception:
            # 取不到 key（图不完整等）⇒ 宁可不删，也不误删别人的效果
            pass
        return _n


    def _merge_group_set_base_selected(self):
        """右键「设为组内主视频」：把唯一选中的轨道设为它所在组的组内主。"""
        _idx = self._get_selected_track_indices()
        if len(_idx) != 1:
            alert_if(True, _("提示"), _("请只选中 1 条视频轨作为组内主"), 'info')
            return
        _i = _idx[0]
        _g = str((self.merge_tracks[_i].enc_settings or {}).get("grp") or "").strip()
        if not _g:
            return
        _target = id(self.merge_tracks[_i])
        # 🔴 **全部组级字段**都挂在组内主轨道上（`grp_dx/grp_dy` 增量落位、`grp_abs_x/y`
        #    绝对落位、`grp_rot_angle` 整组静态角度），换组内主时必须一起搬家 ——
        #    2026-10-16 只搬了 dx/dy，导致换主后「父行 X/Y 绝对落位」和「组角度」
        #    突然归零（用户视角：组跳回原位、角度凭空消失）。名单取自 `_GROUP_KEYS`
        #    （唯一出处，以后新增组级字段自动跟随；`grp` / `is_grp_base` 是组身份本身，不搬）。
        _move_keys = tuple(_k for _k in _GROUP_KEYS if _k not in ("grp", "is_grp_base"))
        _moved = {}
        for _t in self.merge_tracks:
            _es = _t.enc_settings if isinstance(_t.enc_settings, dict) else {}
            if (str(_es.get("grp") or "").strip() == _g
                    and _es.get("is_grp_base") and id(_t) != _target):
                for _k in _move_keys:
                    if _k in _es:
                        _moved[_k] = _es.pop(_k)
        for _t in self.merge_tracks:
            _es = _t.enc_settings if isinstance(_t.enc_settings, dict) else {}
            if str(_es.get("grp") or "").strip() == _g:
                _es["is_grp_base"] = (id(_t) == _target)
                if id(_t) == _target and _moved:
                    _es.update(_moved)
        self.merge_refresh_ui()
        self._append_info_ui(
            _("[分组] 组 %s 的组内主已设为：%s")
            % (_g, os.path.basename(self.merge_tracks[_i].file_path or "?")))

    def merge_edit_selected(self):
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        # 颜色虚拟轨：双击/编辑走「视频轨道设置窗」（画布尺寸/位置/抠图等通用设置），
        # 仅修改颜色本身走「更多 ▸ 编辑颜色源…」专用对话框（2026-10-09 用户拍板）。
        _sel = self.merge_tracks[indices[0]]
        if _is_virtual_source(_sel.file_path):
            self.merge_edit_video_track(indices[0])
            return
        # ⚠️ 撤销快照：编辑轨道会整块覆盖 enc_settings，改前拍、改后登记
        #    （对话框取消则前后一致，_undo_snap != _after_snap 守卫不入栈）
        _undo_snap = self._build_merge_state_dict()
        # 只编辑第一个选中项
        self.merge_edit_track_settings(indices[0])
        _after_snap = self._build_merge_state_dict()
        if _undo_snap != _after_snap:
            self._push_history("merge", _("编辑轨道"),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_undo_snap)),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))

    def _merge_group_row_label(self, gid, mems):
        """组父行映射的标签 = 组内合成链的**最后一环** `v_grp_<gid>_<n-1>`。

        与构建器阶段 A3 同源：`_order = [组内主] + 其余`，最后一环 k = len(mems)-1
        （见 `_build_overlay_filter_complex` 的 `_acc` 收尾）。列表父行的「来源」列
        显示的也是这个标签 ⇒ UI 与 tap 取帧用的是**同一个字符串**（唯一出处）。
        """
        return "v_grp_%s_%d" % (gid, len(mems) - 1)

    def _group_output_label_for_tap(self, tap_label, sub_videos):
        """组最终输出标签 → **含组落位**的整帧标签 `v_out_<组内主序号>`（2026-10-16）。

        🔴 为什么需要它（用户第 2 条实测：「效果预览里显示的是组内主视频帧拉伸后的画面，
        而且坐标永远以原始位置的左上角为准 —— 我在位置编辑器移动过父行标签，它不动」）：
        `_merge_group_row_label` 给的 `v_grp_<gid>_<n-1>` 是**组内合成链的最后一环**，
        它在「叠到主画布」那一段**之前** —— `_build_pip_snapshot_cmd` 在该标签处截断
        （补 `[v_main_proc]nullsink`）⇒ 拿到的是**包装盒原始画面，不含任何组级落位**
        （`grp_dx/dy` / `grp_abs_x/y` 都在截断点之后的那句 overlay 里）。
        父行是**一条独立素材**（用户心智模型）⇒ 「看这个素材的效果」= 看它**叠到主视频
        之后**的整帧，那才是与外部实时预览 / 管道预览**同口径**的画面。

        ⇒ tap 到 `v_out_<i>`（i = 组内主在 sub_videos 里的序号；构建器阶段 B 用
        `_grp_ok[gid]["base"]` 的索引生成该标签，见 `_build_overlay_filter_complex`）。
        找不到（非组标签 / 组内主不在 sub_videos / 标签不是组最终标签）⇒ 原样返回，
        调用方行为逐字节不变（老入口零回归）。

        ⚠️ gid **直接从标签解析**（`v_grp_<gid>_<n>`），不依赖构图缓存
        `_last_group_label_map`：后者只在构图**跑过之后**才有值（`_ensure_node_graphs_current`
        的产物），而组最终标签这个字符串本身就编了组 id，正则取即可 ⇒ 少一处时序依赖。
        """
        _m = re.match(r"^v_grp_(.+)_\d+$", tap_label or "")
        if not _m or not sub_videos:
            return tap_label
        _gid = _m.group(1)
        try:
            _evs = self._get_enabled_video_tracks()
            _mems = [t for t in _evs
                     if str((t.enc_settings or {}).get("grp") or "").strip() == _gid]
            _base = self._merge_group_base_track(_mems[0] if _mems else None, _evs)
            if _base is None and _mems:
                _base = _mems[0]
            if _base is None:
                return tap_label
            _i = list(sub_videos).index(_base)
        except (ValueError, AttributeError, TypeError):
            return tap_label
        return "v_out_%d" % _i

    def _node_key_of_label(self, tap_label):
        """节点标签 → 节点指纹 key —— 与「视频节点」窗**同一个口径**（唯一出处）。

        key = `node_fingerprint(段序号, 末滤镜名)`；段序号取元组第一项（不是 enumerate
        序号），段集必须是**基准图**（_ensure_node_graphs_current 的 base_graph）——
        与节点窗一致。口径不一致 ⇒ 效果存到错 key，在图里找不到 ⇒ 永久孤儿效果。
        """
        try:
            graph, _full = self._ensure_node_graphs_current()
        except Exception:
            return None
        if not graph:
            return None
        try:
            for _i, _name, _lastf, _body in graph_nodes_full(graph):
                if _name == tap_label and not is_audio_segment(_body):
                    # 🔴 2026-10-17 Point 4 方案A：父行标签 → 稳定语义 key `grp:<gid>`
                    # （node_fx_key_of_node 内按 `v_grp_<gid>_<n>` 识别），其余节点保持
                    # node_fingerprint 不变。保证与存储 / key2seg / 孤儿检测同口径。
                    return node_fx_key_of_node(_i, _name, _lastf)
        except Exception:
            return None
        return None

    def _open_node_effect_editor(self, node_key, tap_label, orig_size, sub_file,
                                 track, sub_videos, title=None, parent=None,
                                 edit_index=None, material=False, role="sub",
                                 post_save=None):
        """把**某个中间节点**当一条**独立素材**打开「视频轨道设置」窗（两处共用）：
        列表里的虚拟组父行（2026-10-16）+「视频节点」窗里选中的节点。

        🔴 心智模型（2026-10-16 用户定案）：**这个标签就是一条素材** —— 尺寸 = 它的输出
        尺寸（组 = 包装盒），画面 = 它自己的输出画面。它在列表里的位置决定角色：
          · `role="sub"`（默认，位于**子视频顺序**）⇒ 它就是一条子视频 ⇒ **应用一切
            子视频滤镜**（缩放 / 旋转 / 淡入淡出 / 透明度 / 抠像 / 遮罩 / 裁剪 …）；
          · `role="main"`（位于**列表第 1**）⇒ 它就是主视频 ⇒ 按主视频口径打开。
        「完整的主视频 ↔ 子视频相互作用滤镜」全部存在 `_save_node_fx` 的那一条设置里，
        而**不是在成员轨道上** ⇒ 父行的任何改动都只是**投影**，绝不反写到组内成员。

        类比**虚拟素材**（color: / gen:）：file_path 不可当真实文件用 ⇒ 画面与尺寸都显式
        给 —— 画面由 `frame_extractor` / `node_preview_cb`（tap 到该标签）产出，
        尺寸由 `frame_orig_size` 给定（组 = **包装盒尺寸**，普通节点 = 节点输出尺寸）。
        ⇒ 窗内所有可视化编辑器（裁剪 / delogo / 画布 / 遮罩 及其右侧预览）看到的都是
        **这一节点自己的输出画面**，而不是某个磁盘文件的原帧。

        保存走 `_save_node_fx(node_key, ..., material=material)` ⇒ 效果**插在该标签之后**
        （组 = 作用于整个合成画面），而不是写回某条成员轨道（那会在合成**之前**生效，
        语义错误）。overlay 页接到该节点对应的真实轨道（组 ⇒ 组内主 + group_box：
        拖整只盒 = 整组平移）。

        edit_index=None：
          · None（**视频节点**窗）= 每次保存往该节点**追加**一条效果（`initial_settings={}`），
            与既有行为逐字节一致；
          · N（**列表虚拟父行**）= 编辑**已存在的第 N 条**：预填它、保存时**替换**它
            ⇒ 反复开关设置窗既不丢失也不堆叠（用户实测「只有位置保存了，其它重开就丢」）。

        material：True ⇒ 这条设置按 `node_material_chain`（独立素材口径）渲染。
        post_save(new_settings)：保存后的**投影后处理**（父行用它把 X/Y 落成组级绝对落位）。
        """
        # 「独立素材口径」的判据就是**标签本身**：只要是组的最终输出标签，不管从列表父行
        # 还是从「视频节点」窗进来，都按独立素材渲染（两条入口口径必须一致）。
        material = bool(material) or tap_label in (
            getattr(self, "_last_group_final_labels", None) or ())
        _items = node_fx_items(self.node_fx.get(node_key))
        _n_prev = len(_items)
        _save_at = ({} if edit_index is None else {"replace_index": edit_index})
        _initial = ({}
                    if not (isinstance(edit_index, int)
                            and 0 <= edit_index < len(_items))
                    else dict(_items[edit_index]))

        def _do_save(new):
            self._save_node_fx(node_key, new, material=material, **_save_at)
            # ⚠️ 投影只由**调用方**显式给（列表虚拟父行 = 那条「一条素材」的设置面）。
            #    「视频节点」窗那条入口刻意**不**投影：它是「每次套用 = 追加一条效果」的
            #    语义（edit_index=None、initial_settings={}），拿它在窗口里看到的 X/Y/角度
            #    去覆盖组级字段会把没动过的组级落位/角度写脏。
            if post_save is not None:
                try:
                    post_save(dict(new or {}))
                except Exception as _e:
                    self._append_info_ui(_("[组] 应用父行设置失败：%s") % _e)
                # 🔴 2026-10-18（用户实测「一直显示轨迹:主，从没看到过轨迹:父」）：
                #   父行窗保存只写 node_fx + 组级字段，**从不刷新列表** ⇒ 父行规格列上的
                #   `· 轨迹:父 / · 轨迹:主·预制 / · 自旋:父` 以及「盒 / 落位」永远停在
                #   打开窗口**之前**那一帧（组内主有轨迹时就是恒显示「主」，看着像标记没实现）。
                #   这里补一次刷新：本窗口改的本来就有列表可见的部分（规格列），不刷新等于
                #   让用户拿不到反馈。⚠️ 只重建 Treeview，不重建轨道对象 ⇒ 窗口绑定的
                #   `overlay_track_obj` / `overlay_track_idx` 仍然有效；失败也不影响保存结果。
                #   ⚠️ 只在**父行入口**（有 post_save）刷新：「视频节点」窗是「每次套用追加
                #   一条效果」，那条路径历来不刷列表，保持逐字节不变。
                with suppress(Exception):
                    self.merge_refresh_ui()

        _extractor = self._make_node_frame_extractor(
            track, sub_videos, node_key, tap_label, orig_size or (1280, 720),
            sub_file=sub_file)
        # 右侧实时预览栏取帧命令：与取帧器同源同参 ⇒ 窗内两处画面同源（2026-10-16）
        _preview_cb = self._make_node_preview_cmd_cb(track, sub_videos, node_key, tap_label)
        _gid = (getattr(self, "_last_group_label_map", {}) or {}).get(tap_label)
        _ov_idx, _ov_obj = self._node_label_track(tap_label, sub_videos)
        self.edit_video_settings(
            # 2026-10-18 标题统一（C）：三入口共用 `素材设置 - <身份><尾巴>`（见 material_win_title）。
            #   此处 = 「视频节点」入口 ⇒ 身份是标签、尾巴是「第 N 条」（每条套用 = 追加一条）。
            title=title or material_win_title(
                "[%s]" % tap_label,
                (_("（第 %d 条）") % (_n_prev + 1) if _n_prev else "")),
            initial_settings=_initial,
            on_save=_do_save,
            file_path=sub_file,
            is_watermark=False,
            parent=parent or self.root,
            overlay_mode=("main" if role == "main" else "sub"),
            pip_enabled_var=self.pip_enabled,
            frame_extractor=_extractor,
            frame_orig_size=orig_size,
            node_preview_cb=_preview_cb,
            overlay_track_idx=_ov_idx,
            overlay_track_obj=_ov_obj,
            overlay_group_box=bool(_gid and _ov_idx is not None),
            # ⚠️ 只给**组最终输出标签**挂 key：组内中间环（v_grp_g_0…）不是素材，
            #    把缩放/角度写进去不会渲染 ⇒ 宁可不挂（老行为：写组内主轨道）。
            overlay_group_fx_key=(node_key if material else None),
            # 🔴 2026-10-16（用户第 3 条）：**label 与 key 是两个不同的东西**，必须都传 ——
            #   key = 节点指纹（`#9:overlay`，给 node_fx 存设置用）；
            #   label = 组最终输出标签（`v_grp_g1_1`，给解析器反查组 id / 算包装盒几何用）。
            #   只传 key ⇒ 解析器拿它当 label 去比 `_merge_group_row_label` 恒不中 ⇒
            #   包装盒尺寸与合成帧全落 None ⇒ 编辑器回落成组内主画面（用户实测）。
            #   条件与 `_group_output_label_for_tap` 同口径：组标签形如 `v_grp_<gid>_<n>`。
            overlay_group_label=(tap_label
                                if re.match(r"^v_grp_(.+)_\d+$", tap_label or "") else None),
        )

    def _group_material_item(self, key):
        """父行（独立素材）的那一份设置 dict；没有 → {}（只读，改它不会落库）。"""
        if not key:
            return {}
        _it = node_fx_items((getattr(self, "node_fx", None) or {}).get(key))
        return dict(_it[0]) if _it else {}

    def _group_material_extra(self, key):
        """父行素材项**之外**的效果条数 + 其中「几何类」的清单（2026-10-18 用户定案 A）。

        🔴 为什么必须说清（三入口评估 P1 的落点）：
          · **滤镜**类效果由 `node_effect_chain_multi` 把 `node_fx[key]` 的**全部项**合并成
            一条链一次插入 ⇒ 从「视频节点」追加的那几条**真的叠加生效**；
          · **几何**类（列表轨迹 / 预制轨迹 / 自旋转 / 旋转角度 / 静态落位）只认**第 0 项** ——
            `_group_material_item` 只返回 items[0]，`_group_material_row_proj` /
            `_group_material_wp_res` / `_group_material_set` 全部落在这一条上。
          ⇒ 追加项里的几何**静默失效**。不说清就是"设了没反应"（与本轮修的「父行开自旋转
            无效」同一类坑，区别是这次数据确实存进去了，查不到原因更难）。

        返回 `(n_extra, geo_names)`；`n_extra == 0` ⇒ `([], [])` 的等价（0, []）。
        `geo_names` 按固定顺序去重：列表轨迹 / 预制轨迹 / 自旋转 / 旋转角度。
        ⚠️ 只看 `items[1:]`：第 0 项是父行自己的，它**会**生效，不提示。
        ⚠️ 判据全部取「**确实配了**」而不是「键存在」—— 设置窗 `get_settings` 每次都会写
           `overlay_x/overlay_y/rotate_angle`（哪怕 0/默认值）⇒ 按键存在判会 100% 假阳性。
        """
        _items = node_fx_items((getattr(self, "node_fx", None) or {}).get(key))
        if len(_items) <= 1:
            return 0, []
        _geo = []
        for _it in _items[1:]:
            if not isinstance(_it, dict):
                continue
            _mv = str(_it.get("move_mode") or "").strip()
            if _mv == "waypoints":
                if [w for w in (_it.get("move_waypoints") or []) if isinstance(w, dict)]:
                    if _("列表轨迹") not in _geo:
                        _geo.append(_("列表轨迹"))
            elif _mv in self._GROUP_MOVE_PRESETS:
                if _("预制轨迹") not in _geo:
                    _geo.append(_("预制轨迹"))
            if _it.get("spin_enabled") and _("自旋转") not in _geo:
                _geo.append(_("自旋转"))
            try:
                if abs(float(_it.get("rotate_angle") or 0.0)) > 1e-6:
                    if _("旋转角度") not in _geo:
                        _geo.append(_("旋转角度"))
            except (TypeError, ValueError):
                pass
        return len(_items) - 1, _geo

    def _group_material_overlay_on(self, key):
        """父行（独立素材）的「启用叠加」是否打开；**素材项不存在 / 缺键 → True**。

        2026-10-18 审计发现（与「自旋转/预制轨迹没消费端」同一类）：父行窗口「叠加/偏移」
        页的 `overlay_enabled` 此前**没有任何消费端** —— 组节点的 overlay 是阶段 B 无条件
        追加的（只受组内主自己的 `overlay_enabled` 影响），于是父行取消勾选"启用叠加"后
        整组照常显示，用户以为勾选失效。

        语义（与子视频同构）：父行 = 一条独立素材 ⇒ 它的「启用叠加」= 整组是否叠到主视频。
        消费端不删 overlay（删了会让组标签悬空 ⇒ ffmpeg "unconnected output" 整条链失败），
        而是把 `enable` 钉成 `'0'`（腿位保留、永不显示，与「启用叠加关闭的组员」同一手法）。
        缺省 True ⇒ 老工程（没有该键）逐字符不变。
        """
        _it = self._group_material_item(key) if key else {}
        if not _it:
            return True
        return bool(_it.get("overlay_enabled", True))

    # 预制轨迹（「叠加/偏移」页轨迹弹窗里除列表之外的四个预设）：消费端是
    # `_pip_overlay_xy` 的 `elif _mv:` → `build_move_xy_expr`。
    _GROUP_MOVE_PRESETS = ("h", "v", "diamond", "corners")
    # 父行素材项里**能被组节点消费**的变换字段（自旋转 + 预制轨迹），见
    # `_group_material_row_proj` / `_group_node_xy(row_settings=…)`。
    _GROUP_ROW_FX_KEYS = ("move_mode", "move_cycle", "move_dwell", "move_margin",
                          "spin_enabled", "spin_speed")

    def _group_has_list_traj(self, settings):
        """这份设置里是否有**生效的列表轨迹**（`move_mode=="waypoints"` 且列表非空 → True）。

        纯判据，与 `_group_material_wp_res` / `_build_sub_layer_node` 对列表轨迹的
        判据同口径（缺一不算：只勾开关不给行 = 不生效）。**只给提示用**，
        不产表达式、不改任何设置（2026-10-18 用户定案：轨迹来源只告知，不迁移）。
        """
        if not isinstance(settings, dict):
            return False
        if str(settings.get("move_mode") or "").strip() != "waypoints":
            return False
        return any(isinstance(_w, dict)
                   for _w in (settings.get("move_waypoints") or []))

    def _group_traj_kind(self, settings):
        """这份设置里**作用于整组位移**的轨迹类型：`"列表"` / `"预制"` / `""`（无）。

        2026-10-18（用户第 1 条「组内主视频的那几个预制轨迹没识别，并在父行标记」）：
        此前提示/标记只问 `_group_has_list_traj`（只认 waypoints）⇒ 组内主或父行配的是
        **预制轨迹**（左右扫 h / 上下扫 v / 菱形 diamond / 四角 corners）时会被判成
        「没有轨迹」，可用户明明看到整组在动 —— 找不到来源。
        判据与渲染**完全同口径**：`_pip_overlay_xy` 的 `elif _mv:` 分支就是消费这四个
        预制模式的（组节点落位必经该函数）；waypoints 且列表非空才算列表轨迹（只勾开关
        不给行 = 不生效，与 `_group_material_wp_res` 同一条否定判据）。

        ⚠️ 返回值 `"列表"` / `"预制"` 是 **canonical 值**（调用方 `== "预制"` 判断、
        日志 `%s` 直出）⇒ multi 侧**绝不包 `_()`**：包了英文界面下判断恒假、
        规格列标记与「预制」后缀全失效（零报错零崩溃，只能靠肉眼发现）。
        """
        if not isinstance(settings, dict):
            return ""
        if self._group_has_list_traj(settings):
            return "列表"           # 判据唯一出处：waypoints + 列表非空
        _mv = str(settings.get("move_mode") or "").strip()
        return "预制" if _mv in self._GROUP_MOVE_PRESETS else ""

    def _group_material_row_proj(self, key, item=None):
        """父行素材项 → 组节点要消费的**变换投影**（自旋转 / 预制轨迹）；无 → {}。

        2026-10-18（用户第 3 条「父行不支持自己的自旋转和那几个预制轨迹，开了无效」）：
        父行 = **独立素材**，它的「叠加/偏移」页里除了列表轨迹（`_group_material_wp_res`
        已接）还有两类整组变换，此前**没有任何消费端** ⇒ 存进了 `node_fx[key][0]` 但
        渲染不认：
          · **自旋转**（`spin_enabled` + `spin_speed`）：组节点 rotate 的角度项；
          · **预制轨迹**（`move_mode` ∈ `_GROUP_MOVE_PRESETS`）：组节点 overlay 的 x/y
            时间表达式（与组内主自己的预制轨迹同一条 `build_move_xy_expr` 路线）。
        优先级与列表轨迹同一条「**父行优先**」：父行列表 > 父行预制 > 组内主。
        只返回那 6 个键，**绝不反写成员**（父行 = 纯投影，成员 enc_settings 一字不动）。
        `item`：调用方已换算过的素材项（预览侧走 `_pipe_scale_pos_settings`）；None =
        现读 `node_fx[key]` 第 0 项。
        """
        _it = item if item is not None else (self._group_material_item(key) if key else {})
        if not _it:
            return {}
        _out = {}
        _mv = str(_it.get("move_mode") or "").strip()
        if _mv in self._GROUP_MOVE_PRESETS:
            # 四个预设参数原样带上；缺省键交给 build_move_xy_expr 自己的默认值
            _out["move_mode"] = _mv
            for _k in ("move_cycle", "move_dwell", "move_margin"):
                if _k in _it:
                    _out[_k] = _it[_k]
        _sp = _opt_float(_it.get("spin_speed", 60.0), 60.0)
        if bool(_it.get("spin_enabled", False)) and _sp != 0:
            # 与 `overlay_rotation_active` 同一条判据：spin = enabled **且** speed≠0
            _out["spin_enabled"] = True
            _out["spin_speed"] = _sp
        return _out

    def _group_material_wp_res(self, key, sw, sh, trim_start=0.0, speed_factor=1.0,
                               item=None):
        """父行素材项里的**列表轨迹** → `build_waypoint_expr` 结果；没有 → None。

        🔴 2026-10-16 第七轮②（用户：「只有简易位置和遮罩的轨迹列表支持了，画布模式 和
        **叠加/偏移页的轨迹**没接入，不支持」）：父行 = 独立素材，它在「叠加/偏移」页里
        配的**列表轨迹**必须落在**组节点 overlay** 上 —— 与非组子视频**同一条投影路线**
        （静态 X/Y → `grp_abs_x/y`；列表轨迹 → overlay 的 **x/y 时间表达式**）。

        **语义（与编辑器同域）**：航点 `xa/ya` / `xb/yb` = **主画布绝对像素**，指的是
        **包装盒左上角** ⇒ 直接当组节点 overlay 的 x/y：
          · **不叠**静态绝对落位（`grp_abs_x/y`）—— 逐帧落位与静态落位是两套来源，相加必漂移
            （与 `_pip_overlay_xy` 里「航点取代 overlay_x/y」同一语义）；
          · **不做**盒原点修正（`geo["base"]`）—— 那条是给「用组内主落位表达整盒」的旧口径用的，
            绝对坐标再减一次会让整盒偏 2·base；
          · `grp_dx/dy`（拖组合盒的**增量**）仍然叠加 —— 它是"整组平移"，对轨迹整体平移是合理的。
        仅当 `move_mode == "waypoints"` **且列表非空**时成立；否则 None（老工程逐字节不变）。

        sw/sh：包装盒尺寸（给轨迹预设 / `move_margin` 之类表达式的 w/h 用；与素材自己同源）。
        trim_start / speed_factor：与组内主轨道同口径（航点时间存在**原始时间轴**上，
        `build_waypoint_expr` 内部换算到输出时间线；预览侧 settings 已禁用 trim ⇒ 不换算）。
        item：调用方**已换算过**的素材项（预览侧走 `_pipe_scale_pos_settings(..., _pwf)`
        把航点绝对坐标缩到预览帧空间）。None = 现读 `node_fx[key]` 第 0 项（导出侧）。
        判据（move_mode / 非空列表）与产表达式**只在这里写一次**，两处共用。
        """
        _it = item if item is not None else (self._group_material_item(key) if key else {})
        if not _it or str(_it.get("move_mode") or "").strip() != "waypoints":
            return None
        _wps = [w for w in (_it.get("move_waypoints") or []) if isinstance(w, dict)]
        if not _wps:
            return None
        try:
            _res = build_waypoint_expr(
                _wps, sw=str(sw), sh=str(sh),
                spin_speed=_opt_float(_it.get("spin_speed", 60.0) or 60.0, 60.0),
                trim_start=trim_start, speed_factor=speed_factor)
        except Exception:
            return None
        # ⚠️ 只管 x/y（[0]）；[2]/[3]/[4]（航点旋转 / 缩放 / 透明度）由调用方按需接进 meta，
        #    接不进的（老调用方）也不会因此让整条列表失效 —— 与子视频同款「能接几段接几段」。
        return _res if (_res and _res[0] is not None) else None

    def _group_material_set(self, key, **fields):
        """把字段写进父行的素材设置（**投影**：只动 node_fx，成员 enc_settings 一字不动）。

        该 key 还没有效果项时**新建第 0 项**（父行本来就是一条素材 ⇒ 第一次拧角度 /
        拖把手时它就该存在）。返回 True = 写入成功。
        """
        if not key:
            return False
        _fx = getattr(self, "node_fx", None)
        if not isinstance(_fx, dict):
            self.node_fx = {}
            _fx = self.node_fx
        _items = node_fx_items(_fx.get(key))
        _items = _items or [{}]
        _items[0].update(fields)
        _fx[key] = _items
        return True

    def _merge_group_apply_row_rot(self, base_track, new):
        """父行窗口里的「角度」→ 组级旋转字段 `grp_rot_angle`（存在组内主）。

        父行是**投影** ⇒ 角度绝不能写成员的 `rotate_angle`（那是成员自己的角度，写了会
        双重旋转：成员自己转一次 + 组再转一次）。
        `grp_rot_angle` 是**渲染侧唯一读取口径**：Stage B 的组节点 `rotate=` 与
        `_group_box_geometry` 的 `rot`（中心对齐补偿）都读它。
        角度为 0 ⇒ 清掉该键（回到"没转过"，与用户把角度拧回 0 的直觉一致）。
        """
        _es = getattr(base_track, "enc_settings", None)
        if not isinstance(_es, dict):
            return False
        _va = _opt_float((new or {}).get("rotate_angle", 0) or 0, 0.0)
        if _va:
            _es["grp_rot_angle"] = _va
            self._append_info_ui(_("[组] 父行角度已保存：%g°（作用于**整组**，成员角度未改动）") % _va)
            return True
        if "grp_rot_angle" in _es:
            _es.pop("grp_rot_angle", None)
            self._append_info_ui(_("[组] 父行角度已清零（整组不再旋转）"))
        return False

    def _merge_group_apply_row_place(self, base_track, initial, new):
        """父行窗口里的「叠加位置 X/Y」→ 组级**绝对落位** `grp_abs_x/grp_abs_y`。

        父行是**投影** ⇒ 落位绝不能写成员的 `overlay_x/y`（那是"用投影改原件"）。
        `grp_abs_x/y` 与 `grp_dx/grp_dy` 同族（存在组内主、语义上是**组**的属性），
        构建器 Stage B 与 `_group_composite_box` 都优先读它。

        只有用户**真的改过** X/Y（与打开时的值不同）才写；没动就不写 ⇒ 保持增量模型
        （可视化编辑器拖动写增量，两个入口互斥、不会互相覆盖）。
        值原样存（可以是 `W-w` 这类表达式，与 overlay_x/y 同域）。
        """
        _es = getattr(base_track, "enc_settings", None)
        if not isinstance(_es, dict):
            return False
        _ox = str((initial or {}).get("overlay_x", "") or "").strip()
        _oy = str((initial or {}).get("overlay_y", "") or "").strip()
        _nx = str((new or {}).get("overlay_x", "") or "").strip()
        _ny = str((new or {}).get("overlay_y", "") or "").strip()
        _hit = False
        if _nx and _nx != _ox:
            _es["grp_abs_x"] = _nx
            _hit = True
        if _ny and _ny != _oy:
            _es["grp_abs_y"] = _ny
            _hit = True
        if _hit:
            self._append_info_ui(
                _("[组] 父行落位已保存：X=%s / Y=%s（成员坐标未改动，属组级绝对落位）")
                % (_es.get("grp_abs_x", _("（沿用）")), _es.get("grp_abs_y", _("（沿用）"))))
        return _hit

    def _merge_edit_group_row(self, gid):
        """双击列表的**虚拟组父行**（`grp_<gid>`）⇒ 把整组当一条**全新独立素材**打开
        「视频轨道设置」窗（2026-10-16 用户定案）。

        🔴 心智模型：父行 = 组内最终输出标签 `v_grp_<gid>_<n-1>` = **一条包装盒大小的
        独立素材**。于是：
          · 画面 = 组的合成画面、尺寸 = 包装盒尺寸、效果 = 插在组输出之后；
          · `material=True` ⇒ 窗里的**缩放 / 淡入淡出 / 透明度 / 抠像**照常生效
            （走 `node_material_chain`，不是被阉割的中间节点口径）；
          · 角色按它在列表里的位置定：组内主是列表第 1 ⇒ `role="main"`（主视频口径），
            否则 `role="sub"`（子视频口径，应用一切子视频滤镜）；
          · **所有改动都只是投影**：写 node_fx 的父行那一项 + 组级字段（grp_dx/dy、
            grp_abs_x/y），**成员的 enc_settings 一个字都不动**。

        此前该入口只能从「视频节点」里选到组节点才进得去，列表上无处可点。

        返回 True = 已处理（调用方不要再走普通轨道编辑）；False = 交还默认流程。
        """
        _gid = str(gid or "").strip()
        _evs = self._get_enabled_video_tracks()
        _mems = [t for t in _evs
                 if t.type == "video"
                 and str((t.enc_settings or {}).get("grp") or "").strip() == _gid]
        if len(_mems) < 2:
            return False
        _base = self._merge_group_base_track(_mems[0], _evs) or _mems[0]
        # 「组内主 = 列表第 1」= 父行落在**主视频位**（用户模型里它就该按主视频口径处理）。
        # 但构建器只从子视频取组成员 ⇒ 这种组**建不起来**（老工程残留才可能出现）⇒
        # 宁可说清楚，也不要开一个改完没反应的窗口。
        if _evs and _base is _evs[0]:
            if alert_if(True, _("提示"),
                        _("该组的组内主是**主视频**（列表第 1 条）。\n"
                        "组的合成节点目前只建立在子视频之上，主视频所在组不会被构图 ——\n"
                        "请把组内主改成某条子视频（右键「设为组内主视频」）后再按组编辑。"),
                        'info'):
                return True
        # ⚠️ 先自检几何：求不出时开编辑器会**降级**成「写组内主 overlay_x/y」（把成员
        #    坐标写脏的老坑）⇒ 宁可不打开。
        _box = self._group_composite_box(_base, _evs)
        if alert_if(_box is None, _("提示"),
                    _("该组的组合包围盒求不出（成员渲染尺寸未知），暂不能按组编辑"), 'info'):
            return True
        _lab = self._merge_group_row_label(_gid, _mems)
        _key = self._node_key_of_label(_lab)
        if alert_if(_key is None, _("提示"),
                    _("没能定位该组的输出节点 [%s]。\n"
                    "请确认：画中画已启用、主视频与子视频都已加载。") % _lab, 'info'):
            return True
        _bw, _bh = int(_box[2]), int(_box[3])
        # 父行窗口里的「叠加位置 X/Y」预填**当前组的真实落位**（表达式原样显示）。
        # 没有这一步 ⇒ 框里是 '0'，用户改一次就把整组甩到左上角（且无法判断"改没改"）。
        #
        # 🔴 2026-10-16（用户第 2 条：「保存后重新打开他的 xy 依然是原始的那个 xy」）：
        #   旧写法 `_initial.setdefault("overlay_x", _seed_x)` 只在**缺键**时才补 ——
        #   而 `node_fx[key]` 第 0 项早在第一次保存时就被 `_do_save` 写进了当时的 X/Y，
        #   ⇒ 此后无论位置编辑器怎么拖（写的是组级 `grp_dx/dy` / `grp_abs_x/y`，**不改
        #   node_fx**），重开父行窗读到的还是那份**陈旧的 node_fx 值**（用户实测）。
        #   病根 = **两份 X/Y 数据没有单一真相源**：
        #     · 位置编辑器 → `grp_dx/dy`（增量）或 `grp_abs_x/y`（绝对），存在**组内主**；
        #     · 父行设置窗 → `node_fx[key]["overlay_x/y"]`（父行素材项）。
        #   修法：**真实落位是唯一真相源** ⇒ 预填时用 `_seed_x/_seed_y`（读 `group_place_abs`
        #   优先、否则读 `_box` 现算的含 delta 落位）**无条件覆盖** node_fx 里的 X/Y，
        #   并同步写回 node_fx（下方 `_group_material_set`）⇒ 两个入口此后永远一致。
        #   ⚠️ `_seed_x/_seed_y` 一定是可求值的常量串（`_box[0..1]` 是 float；`grp_abs_*`
        #      可能是表达式，那种情况 `_group_place_abs` 返回字符串，仍原样显示，语义不变）。
        _items = node_fx_items(self.node_fx.get(_key))
        _cur = dict(_items[0]) if _items else {}
        _ax, _ay = self._group_place_abs(_base.enc_settings)
        _seed_x = _ax if _ax is not None else ("%g" % float(_box[0]))
        _seed_y = _ay if _ay is not None else ("%g" % float(_box[1]))
        _initial = dict(_cur)
        _initial["overlay_x"] = _seed_x
        _initial["overlay_y"] = _seed_y
        # ---- 轨迹来源提示（2026-10-18 用户定案：「只加提示，知道来源就行」）----
        # 组节点只有**一个**落位点 ⇒ 整组的位移轨迹有两个候选源：
        #   ① 父行素材项 `node_fx[key][0]` —— **优先**（列表轨迹 / 预制轨迹 / 自旋转）；
        #   ② 组内主 `enc_settings` —— 编组前就配好的，父行没配时生效。
        # 覆盖关系在导出/预览的组分支里（`_group_material_wp_res` / `_group_material_row_proj`
        # 的结果写进 `_bmeta` 与 `_gs`）—— 本窗口只预填 ① ⇒ 用户看不到 ②，
        # 会以为「父行继承了轨迹」（实测困惑点）。这里只**告知**：不改数据、不迁移、
        # 不改渲染（想在父行接管就直接在轨迹列表 / 预设里配，配了就覆盖）。
        # 🔴 2026-10-18 用户第 1 条：判据必须用 `_group_traj_kind`（列表 **+ 预制**）——
        #    只看列表轨迹时，组内主配的是「左右扫/上下扫/菱形/四角」会被判成没轨迹。
        _kind_row = self._group_traj_kind(_cur)
        _kind_base = self._group_traj_kind(_base.enc_settings)
        _traj_owner = _("父行") if _kind_row else (_("组内主") if _kind_base else "")
        if _kind_base and not _kind_row:
            self._append_info_ui(
                _("[组] 组 %s 的轨迹当前来自 **组内主**（编组前在它身上配的%s轨迹，"
                "组节点按它整体摆位）。本窗口里再配轨迹会**覆盖**它；"
                "想换来源就右键「设为组内主视频」换一条主视频。本窗口的轨迹页"
                "显示的是**父行自己**的轨迹（当前为空），不是继承来的。")
                % (_gid, _kind_base))
        elif _kind_row:
            self._append_info_ui(
                _("[组] 组 %s 的轨迹来自 **父行**（%s轨迹，已覆盖组内主自己的轨迹）。")
                % (_gid, _kind_row))
        # 父行的**自旋转**（2026-10-18 用户第 3 条）：它和轨迹一样是整组姿态，且父行
        # 才配得到；有它时航点角度让位（角度由自旋转驱动）—— 明确打一条，避免又出现
        # 「开了不知道生不生效」。
        if self._group_material_row_proj(_key, item=_cur).get("spin_enabled"):
            self._append_info_ui(
                _("[组] 组 %s 的**自旋转**来自父行（作用于整组；此时列表轨迹里的航点角度"
                "不再叠加）") % _gid)
        # ---- 「视频节点」追加项：滤镜会叠加、几何会失效（2026-10-18 用户定案 A）----
        # 三入口评估 P1 的落地点：同一个 `grp:<gid>` key 被两个入口用**两种项语义**写
        # （父行 = 永远替换第 0 条；视频节点 = 每次追加一条）。渲染侧滤镜是**全项合并**
        # ⇒ 都生效；几何只读第 0 条 ⇒ 追加项里的轨迹 / 自旋转 / 角度**静默失效**。
        # 而本窗口只预填第 0 条 ⇒ 用户在这里看不见那几条，必须明说，否则就是
        # 「我设的东西去哪了」。（不改数据、不迁移、不改渲染：只告知。）
        _n_extra, _geo_extra = self._group_material_extra(_key)
        if _n_extra:
            if _geo_extra:
                self._append_info_ui(
                    _("[组] 组 %s 的这个组节点上还有 **%d 条**效果（在右键「视频节点」里加的）："
                    "滤镜类（裁剪/遮罩/抠像/缩放…）会**照常叠加生效**；"
                    "但其中的 %s **不生效** —— 父行的几何只认本窗口这一条（第 1 条）。"
                    "要把几何搬到父行，就在本窗口里重配一遍。")
                    % (_gid, _n_extra, _("、").join(_geo_extra)))
            else:
                self._append_info_ui(
                    _("[组] 组 %s 的这个组节点上还有 **%d 条**效果（在右键「视频节点」里加的），"
                    "滤镜类会照常叠加生效（与本窗口这一条合并成一条链）。")
                    % (_gid, _n_extra))
        # ---- 父行「能配但渲染侧不支持」的项：一次性说清（2026-10-18 审计）----
        # 父行 = **合成画面**（一条素材），所以「叠加/偏移」页里凡是**改时间轴**或
        # **改与主视频的混合方式**的控件，渲染侧都没有（也不该有）消费端：
        #   · 循环 / 倒放 / 截取 / 变速 ⇒ 改 pts，组画布时长由成员窗口并集承载，再套一层
        #     时间变换会让音频同步与其它节点定位全错（`node_material_chain` 显式关 trim/speed）；
        #   · 混合模式 ⇒ 组节点只有一次普通 overlay（blend 要求同尺寸双输入，得先把整盒
        #     pad 到主画布；组内主为 blend 的组在分组规划阶段就已整组降级）。
        # 以前这些控件能勾、能存，但一个滤镜都不产 ⇒ 用户以为"开了没反应"。这里只提示，
        # **不改渲染、不改控件**（要不要真正支持 blend 属于另一轮设计）。
        _unsup = []
        if str(_cur.get("blend_mode") or "normal").strip().lower() != "normal":
            _unsup.append(_("混合模式"))
        if _cur.get("loop_enabled"):
            _unsup.append(_("循环播放"))
        if _cur.get("reverse_enabled"):
            _unsup.append(_("倒放"))
        if _cur.get("trim_enabled"):
            _unsup.append(_("截取"))
        if _cur.get("speed_enabled"):
            _unsup.append(_("变速"))
        if _unsup:
            self._append_info_ui(
                _("[组] 父行里的 %s **不会生效**：父行是合成画面，时间轴类（循环/倒放/截取/"
                "变速）由成员各自的窗口承载，混合模式只支持普通叠加。"
                "（本次不改你的设置，仅告知。）") % _("、").join(_unsup))
        # ⚠️ 必须**先落库**：edit_index=0 只在"第 0 项已存在"时才是替换（越界会变追加
        # ⇒ 重开又是一条新的，正是用户实测的"其它重开就丢"）。补了默认值也一样要写回，
        # 否则窗口预填的还是缺 X/Y 的旧项。
        self._group_material_set(_key, **_initial)
        _role = "main" if (_evs and _base is _evs[0]) else "sub"
        try:
            self._open_node_effect_editor(
                _key, _lab, (_bw, _bh), _base.file_path, _evs[0], _evs[1:],
                # 2026-10-18 标题统一（C）：三入口共用 `素材设置 - <身份><尾巴>`。
                #   此处 = 「列表父行」入口 ⇒ 身份 = 组 + 包装盒尺寸；尾巴 = 轨迹来源 + 另有N条。
                title=material_win_title(
                    _("组 %s（%dx%d）") % (_gid, _bw, _bh),
                    (_(" · 轨迹:%s") % _traj_owner if _traj_owner else "")
                    + (_(" · 另有%d条") % _n_extra if _n_extra else "")),
                # ⭐ 父行是「一条素材」⇒ 同一份设置只此一条：预填 + 替换（不追加堆叠）
                edit_index=0,
                material=True,
                role=_role,
                post_save=lambda new: (
                    self._merge_group_apply_row_rot(_base, new),
                    self._merge_group_apply_row_place(_base, _initial, new)))
        except Exception as _exc:
            self._append_info_ui(_("[组] 打开组轨道设置失败：%s") % _exc)
        return True

    def _current_main_track(self):
        """只读判定当前主视频轨（主视频 = 首条启用视频轨，与 _node_context /
        滤镜图构建同口径）。

        主视频有两处存源：self.merge_video 字段 + 主视频轨的 file_path，历史靠「路径相等」
        配对（见 merge_replace_track_source 同步段）。该配对在「虚拟颜色源当主视频」场景下
        脆弱：merge_video 按设计为空（颜色哨兵不是真实文件），此时主视频身份只能靠首条启用
        视频轨推断；而替换素材的同步旧逻辑拿 merge_video 与轨道旧路径做字符串相等，一旦
        merge_video 残留成某条子视频路径（难稳定复现的退化态），替换子视频就会误改 merge_video，
        把主视频输入名「劫持」成子视频（用户报过）。本函数直接以「首条启用视频轨」作为主视频，
        彻底绕开脆弱的路径配对，供替换同步安全判断「被替换的这条是不是主视频」——
        子视频（vids[1:]）永远不可能是主视频，故替换子视频恒不触碰 merge_video。"""
        vids = [t for t in getattr(self, "merge_tracks", []) or []
                if getattr(t, "enabled", False) and getattr(t, "type", "") == "video"]
        if not vids:
            return None
        return vids[0]

    def merge_replace_track_source(self):
        """右键「替换素材」：只换选中轨道的源文件，enc_settings 整块保留
        （位置 / 缩放 / 旋转 / 裁剪 / 滤镜 / 截取 / 转场 一律不动）。

        2026-09-11 新增（用户拍板：先只做单轨右键替换；校验只做日志提示，
        **绝不自动改动任何参数**——剪映式「换源后自动适配」不做）。

        ⚠️ 主视频两处存源：self.merge_video 变量 + 主视频轨的 file_path，二者靠
           **路径相等**配对（_ensure_main_video 20683-20707 用 normalize_path 比对）。
           只改一处 → 主视频轨会「自己叠自己」或路径失配，故换主视频轨必须两处同改。

        ⚠️ 设 self.merge_video 必须抑制 trace：merge_video 的 write trace 指向
           merge_load_video_info（33188），它会 self.merge_tracks = [] 后按新文件流
           重建全部轨道（33214-33220）→ 子视频被清空。参照 _ensure_main_video（20693）
           用 _suppress_main_video_trace 门卫。

        布局为何能保留：子视频 overlay_x/y 默认是相对表达式 W-w-10 / H-h-10
        （Track 初始化 19894-19895），crop_width 默认 iw/2（19883）→ 换源后自适应新尺寸。
        """
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        idx = indices[0]
        if not (0 <= idx < len(self.merge_tracks)):
            return
        track = self.merge_tracks[idx]

        path = filedialog.askopenfilename(
            title=_('替换素材 - 轨道 {0}（{1}）：仅换源文件，保留位置/缩放/旋转/滤镜').format(idx + 1, track.type),
            filetypes=media_filetypes(include_audio=True, include_subtitle=True))
        if not path:
            return
        path = normalize_path(path)
        if not os.path.exists(path):
            self._append_info_ui(_('[替换素材] 所选文件不存在，未做改动：{0}').format(path))
            return

        old_path = track.file_path or ""
        if old_path and normalize_path(old_path) == path:
            self._append_info_ui(_("[替换素材] 与当前源相同，未做改动"))
            return

        enc = track.enc_settings if isinstance(track.enc_settings, dict) else {}
        warns = []

        # ---- 校验（只提示，不改参数）----
        if track.type == "subtitle":
            pass  # 字幕轨不做流校验（字幕文件未必有 ffprobe 意义上的流）
        else:
            info = self._get_cached_stream_info(path)   # 顺带预热缓存
            streams = (info or {}).get("streams", [])
            if not streams:
                warns.append(_("无法解析媒体信息或没有任何流（ffprobe 失败 / 文件损坏）"))
            else:
                _want = "video" if track.type == "video" else "audio"
                if not any(s.get("codec_type") == _want for s in streams):
                    warns.append(_('新源没有 {0} 流').format(_want))
                _has_audio = any(s.get("codec_type") == "audio" for s in streams)
                if track.type == "audio" and not _has_audio:
                    warns.append(_("新源无音频流，该音频轨将无输出"))
                elif track.type == "video" and not _has_audio:
                    # 视频轨音源=自身时才引用 0:a:?；silence / external 不受影响
                    if enc.get("audio_source_type", "self") == "self":
                        warns.append(_("新源无音频流，而本轨音源=自身（audio_source_type=self），命令可能失败"))
                if track.type == "video" and enc.get("chroma_enabled", False):
                    warns.append(_("本轨已启用绿幕抠像，抠像颜色 / 相似度需按新素材重调"))
            # 时长相关（绝对秒参数不会自动适配）
            _new_dur = self._get_media_duration(path)
            _old_dur = self._get_media_duration(old_path) if old_path else None
            if _new_dur:
                if enc.get("trim_enabled", False):
                    _te = _opt_float(str(enc.get("trim_end", "") or "").strip(), None)
                    if _te is not None and _te > _new_dur:
                        warns.append(_('截取片段结束 {0:.2f}s 超出新源时长 {1:.2f}s，输出会被静默截断').format(_te, _new_dur))
                if _old_dur and abs(_old_dur - _new_dur) > 0.01:
                    warns.append(_('时长 {0:.2f}s → {1:.2f}s（转场 / 淡入淡出 / 轨迹等绝对秒参数不自动适配）').format(_old_dur, _new_dur))

        # ---- 换源：enc_settings 整块不动 ----
        # ⚠️ 撤销快照：替换素材前拍下整页轨道状态（含主视频路径），还原可回到旧源
        _undo_snap = self._build_merge_state_dict()
        track.file_path = path
        track.source = _virtual_source_kind(path) or "file"

        # 主视频两处同步（见 docstring 门卫说明）。
        # 2026-10-10 加固：改用「轨道对象身份」判定，而非 merge_video 与旧路径的字符串相等。
        # 旧判据在「虚拟颜色源当主视频」时脆弱——merge_video 按设计为空（颜色哨兵不是真实
        # 文件），此时拿它与子视频旧路径比对永不成立，看似无害；但一旦 merge_video 残留成某条
        # 子视频路径（难稳定复现的退化态），替换子视频就会误改 merge_video，把主视频输入名
        # 「劫持」成子视频。改为：先只读判定主视频轨（与 _ensure_main_video 同口径），仅当
        # 「被替换的正是主视频轨」且新源非颜色哨兵时才同步 merge_video。子视频替换恒不触碰。
        _main_tr = self._current_main_track()
        if track is _main_tr and not _is_virtual_source(path):
            self._suppress_main_video_trace = True
            try:
                self.merge_video.set(path)
            finally:
                self._suppress_main_video_trace = False

        self.merge_refresh_ui()
        self._append_info_ui(
            _('[替换素材] 轨道 {0}：{1} → {2}（布局与滤镜已保留）').format(idx + 1, os.path.basename(old_path) or '(空)', os.path.basename(path)))
        for _w in warns:
            self._append_info_ui(_('[替换素材] ⚠️ {0}').format(_w))
        _after_snap = self._build_merge_state_dict()
        if _undo_snap != _after_snap:
            self._push_history("merge", _('替换素材(轨道{0})').format(idx + 1),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_undo_snap)),
                lambda: self._restore_merge_state_dict(copy.deepcopy(_after_snap)))

    def merge_preview_selected(self, with_snapshot: bool = False):
        indices = self._get_selected_track_indices()
        if alert_if(not indices, _("提示"), _("请先选中轨道"), 'info'):
            return
        self.merge_preview_track(indices[0], with_snapshot=with_snapshot)

    def _ffplay_fit_scale(self, out_w, out_h):
        """返回 ffplay 缩放参数列表（按需），口径与旧预览路径（_canvas_fit_scale /
        _preview_with_settings 27477-27520）**完全一致**：预留「更多设置 → 播放预览屏幕边距」
        preview_margin（默认 80，钳制 20-400）—— 覆盖窗口标题栏 + 任务栏 + 左右边框。

        旧实现硬编码 48/16 比 preview_margin 小得多 → 用户实测「缩放还是不够、标题栏被挤出去」。
        仅当输出尺寸超过可用区时才缩放（正常预览不缩，与 mpv/旧路径一致）；缩放后尺寸偶数化
        并二次钳制到可用区以内。返回 [] 表示无需缩放。

        2026-10-13：更多设置勾选「原始大小」（_preview_fit_enabled() == False）时**直接返回 []**，
        ffplay 窗口按成片原始尺寸打开、不再按屏幕缩小 —— 与 mpv 侧纯净源适配同一个开关。"""
        if not self._preview_fit_enabled():
            return []
        try:
            _scr_w = int(self.root.winfo_screenwidth())
            _scr_h = int(self.root.winfo_screenheight())
        except Exception:
            _scr_w, _scr_h = 1920, 1080
        try:
            _margin = int(self.preview_margin.get())
        except Exception:
            _margin = 80
        _avail_w = max(320, _scr_w - _margin)
        _avail_h = max(240, _scr_h - _margin)
        if out_w <= 0 or out_h <= 0 or (out_w <= _avail_w and out_h <= _avail_h):
            return []
        _scale = min(float(_avail_w) / out_w, float(_avail_h) / out_h)
        _dw = max(2, int(round(out_w * _scale / 2) * 2))
        _dh = max(2, int(round(out_h * _scale / 2) * 2))
        # 二次钳制（极端比例时 round 可能越界）
        if _dw > _avail_w:
            _dw = _avail_w - (_avail_w % 2)
        if _dh > _avail_h:
            _dh = _avail_h - (_avail_h % 2)
        return ["-x", str(_dw), "-y", str(_dh)]

    def merge_preview_pip_live(self, pipe_engine=False, extra_kw=None):
        """画中画实时预览（mpv --lavfi-complex）：主视频 + 各子视频走 movie 滤镜真实合成。

        ⚠️ 菜单入口已收敛（2026-09-21）：不再有独立菜单项。外部播放器路线由
        `_live_preview_player`（右键「实时预览（复杂滤镜）」）分派，内置引擎路线由
        `_live_preview_pipe`（右键「实时预览（简易时间引擎）」）分派。
        所有子视频渲染滤镜与正式命令一致（截取/裁剪/缩放/绿幕/透明度/旋转/轨迹）；
        mpv 的 lavfi-complex 多输入只能引用主文件流，子视频必须用 movie 滤镜（防卡顿）。
        子视频最多前 N 个（N = 更多设置「预览轨数上限」，默认 15，防止复杂图过大卡死），
        超出在日志提示（内置时间预览引擎走同一函数体，同样受此上限约束）。

        pipe_engine（2026-09-20 Phase 2，「时间预览引擎」封装页开放）：True 时**不启动
        mpv/ffplay**，把同一张 PiP 合成图改喂内置时间预览窗口（ffmpeg -filter_complex →
        rawvideo 管道）→ 保留标记 / 波形 / 逐帧步进 / 循环 / A-V 仲裁。默认 False ⇒
        mpv / ffplay 两条既有路径行为**完全不变**。
        子视频时间轴口径（用户拍板，与上面两条路径及正式导出一致）：movie= 子输入不吃
        命令行 -ss → 各自从自己文件的 0 起、不跟随主视频 seek（正式命令 _add_input_options
        同样只对主视频加 -ss、子视频只加 -stream_loop -1）。"""
        if not self.pip_enabled.get():
            self._append_info_ui(_("[预览] 实时预览仅画中画模式可用"))
            return
        # mpv 优先；mpv 不可用时（本机常未安装）改走 ffplay -vf：研究 ffplay-preview 实证
        # ffplay 的 -vf 即完整 filtergraph，支持 movie 多子视频合成，无需 mpv 的 lavfi-complex。
        mpv_ok = bool(self.use_mpv.get()) and self._mpv_ready(log=False)
        if not mpv_ok:
            self._append_info_ui(
                _("[预览] mpv 不可用，画中画实时预览改走 ffplay -vf（movie 多子视频合成，"
                "无需 mpv；如想用 mpv 请检查 mpv 路径）"))
        if not self.ffmpeg_cmd:
            self._append_info_ui(_("[预览] 未找到 ffmpeg，无法生成实时预览"))
            return
        enabled_tracks = [t for t in self.merge_tracks if t.enabled]
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if not video_tracks:
            self._append_info_ui(_("[封装-画] 没有启用的视频轨道"))
            return
        main_video = video_tracks[0]
        sub_videos = video_tracks[1:]
        # 透明指示判据（2026-10-12）：与导出**同源**（`_pip_needs_alpha`）—— 主视频透明，或
        # 「主视频之后那段」里显示的子视频带透明 ⇒ 预览也要垫棋盘格 + 主视频之后的补帧改**透明**补。
        # ⚠️ 用**完整** video_tracks（不是被 _sv_max 截断的 sub_videos）：判据应与成片一致。
        try:
            _pv_needs_alpha = self._pip_needs_alpha(video_tracks)
        except Exception:
            _pv_needs_alpha = False
        _sv_max = max(1, min(30, self.sub_video_preview_max.get()))
        if len(sub_videos) > _sv_max:
            self._append_info_ui(
                _('[预览] 子视频数量 {0} 超过 {1} 个，实时预览仅支持前 {2} 个').format(len(sub_videos), _sv_max, _sv_max))
            sub_videos = sub_videos[:_sv_max]
        main_file = normalize_path(main_video.file_path)
        # 2026-10-09：主视频是否为「颜色虚拟源」。颜色源不是真实文件 → 不能把哨兵串当位置输入
        # （mpv 直接报打不开）。下方两条播放器路径分别换输入形态：
        #   · mpv    → `av://lavfi:<spec>`（见 _virtual_mpv_input 真机实测）
        #   · ffplay → `-f lavfi -i <spec>`
        # 两者都让图内 `[vid1]` 照旧指到「主输入」⇒ 既有 filtergraph 一字不改。
        _main_is_color = _is_virtual_source(main_video.file_path)

        # ---- 混音/替换子声预收集：子声走 amovie= 源（本 ffmpeg 版本
        # movie 只有视频输出），建层前就要定好哪些子视频挂音频。派发口径与正式命令
        # _build_pip_audio 一致：按音频轨遍历、audio_mode 读对应视频轨设置；
        # 没有音频轨条目的子视频与导出一致不混。
        # 2026-09-25 放开 pipe_engine 门控：管道视频图会整体删除音频段
        # （_retarget_lavfi_labels drop_amovie 全覆盖 [asub/asw/amain_pv/amovie=/aid1/ao]），
        # 混音段进图对视频侧零影响；而管道 out_mode 的合成音频下传
        # （_lavfi_mix_audio_standalone）必须要图里有混音段可抽——原门控导致管道时间预览
        # 的波形/出声只有主视频（用户实测 123412：12s 转场后子声全无）。
        _pv_audio_plan = {}   # 子视频序号 -> 音频轨
        _pv_audio_src = {}    # 已建 amovie 节点的子视频序号（建层时回填）
        _main_path_n = normalize_path(main_file)
        for _at in [t for t in enabled_tracks if t.type == "audio"]:
            if normalize_path(_at.file_path) == _main_path_n:
                continue
            # 优先级（2026-09-30 用户拍板）：视频绑定（跟随窗口）永远优先——绑定选中
            # （混音/替换）就进本计划；绑定未选（default）时音频条目自身的
            # 输出方式才生效（mix → _pv_free_audio 自由混音）。
            if self._pip_audio_mode(self._pip_sub_video_enc(enabled_tracks, _at)) not in ("mix", "replace"):
                continue
            for _kx, _svx in enumerate(sub_videos):
                if normalize_path(_svx.file_path) == normalize_path(_at.file_path):
                    _pv_audio_plan.setdefault(_kx, _at)
                    break
        # 文件探不到音轨 → amovie 会整图报错，剔除（与「子视频无音轨降级忽略」同口径）
        for _kx in list(_pv_audio_plan.keys()):
            _hasx = False
            try:
                _infox = self._get_cached_stream_info(normalize_path(sub_videos[_kx].file_path))
                _hasx = any(x.get("codec_type") == "audio" for x in (_infox or {}).get("streams", []))
            except Exception:
                _hasx = False
            if not _hasx:
                _pv_audio_plan.pop(_kx)

        # 独立音频轨「混音进主音频」预收集（2026-09-30 分离音频自由）：不绑定子视频窗口，
        # 窗口 = audio_offset(开始) / trim_end(结束)，预览链序与导出端 _free_audio_mix_node 逐字对齐。
        # 文件探不到音轨 → amovie 会整图报错，剔除（与子声计划同口径）。
        _pv_free_audio = []
        for _ft in [t for t in enabled_tracks if t.type == "audio"]:
            if normalize_path(_ft.file_path) == _main_path_n:
                continue
            # 注意：与子视频同文件的轨**不排除**——导出端是「自身输出方式优先」，
            # 自身=mix 的轨走自由混音（不跟随窗口），与文件是否为子视频无关
            # （用户 2026-09-30 实测：子视频同文件音频设「混进主音频」导出能混、
            # 预览不能混 = 排除导致的两端口径不一致）。
            if self._audio_out_mode(_ft) != "mix":
                continue
            # 跟随窗口优先只约束「有视频控制」的轨（子视频同文件）；
            # 无视频对应（BGM 类外置音频轨道）自身输出方式直接生效，不受绑定约束
            # （2026-09-30 用户拍板）。
            _ft_venc = self._pip_sub_video_enc(enabled_tracks, _ft)
            if _ft_venc and self._pip_audio_mode(_ft_venc) != "default":
                continue
            _hasf = False
            try:
                _infof = self._get_cached_stream_info(normalize_path(_ft.file_path))
                _hasf = any(x.get("codec_type") == "audio" for x in (_infof or {}).get("streams", []))
            except Exception:
                _hasf = False
            if _hasf:
                _pv_free_audio.append(_ft)

        fg = FilterGraph("[vid1]")
        # #5（2026-10-08）：列表轨迹面板「重开本管道」时下传的**未提交航点** + 宿主声明的
        # **目标身份**（`_wp_target`）。本图里有多个可能带轨迹的目标（主视频 / 各子视频 /
        # 文字水印）⇒ 只 patch 身份命中的那一个（判据见 _live_wp_target）。
        # 缺省无 `_wp_source` / `_wp_target` ⇒ 不生效，旧入口行为逐字节不变。
        _lw = _live_wp_override(extra_kw)
        _wt = _live_wp_target(extra_kw)
        # #3（2026-10-08）：本次图里**到底有没有**用上未提交航点（主层命中 ∪ 任一子层命中）。
        # 用单元素列表而非嵌套 def 里 `nonlocal` —— 项目铁律「嵌套 def 的局部变量出不来」，
        # 走可变容器（与遮罩 _mask_edit_cb 的 active_flag 同款）。仅供预览窗标记用。
        _lw_hit = [False]
        # ---- 主视频（[vid1]）：支持截取（trim），与正式命令 precise_trim 语义一致 ----
        _ms = dict(main_video.enc_settings)
        # #5：身份命中本层才注入（判据统一在 _wp_target_hit）。主视频层接受 layer 身份，以及
        # 「声明的轨 == 主视频轨」——两个宿主都用 track_obj，主视频轨的画中画设置页也是
        # mode='sub' + track_obj=主视频轨。
        if _lw and _wp_target_hit(_wt, track=main_video, allow_layer=True):
            _ms = _wp_inject_live(_ms, _lw)
            _lw_hit[0] = True
        _ms["hw_filter_mode"] = "cpu"
        # 主视频时长（enable 上限，防 movie 音频截断）——提前探测：截取只设起点时，管道分支
        # 要用它当「素材尾」推相对终点（见下），故必须早于 trim 前缀构建。
        _main_dur = None
        try:
            # 帧对齐：与导出端 _pip_main_duration 同口径（floor 到源帧格）
            _main_dur = self._get_media_duration(
                main_file, frame_align_fps=self._get_video_framerate(main_file))
        except Exception:
            _main_dur = None
        # ---- 转场链规划（提前到主 trim 前缀之前）：pipe_engine 有链时走 out_mode
        # （路线A，research/pipe-pip-chain），其主 trim 前缀必须烘焙绝对 start/end
        # 而非「相对终点」，故 _pv_out_mode 判定必须先于 trim 前缀构建。
        _chain_member_lbl = {}
        _pip_chains, _chain_of = [], {}
        _pv_main_chain_raw = None
        # 时间轴总量提前探测（out_mode 判定要用）：_pv_main_eff/_pv_total 原在下方
        # tpad 段计算，现提前——硬切无链但接龙/循环延长时也要能进 out_mode。
        _pv_main_eff = self._pip_main_effective_duration(main_video)
        try:
            _pv_total = self._pip_timeline_extent(
                _pv_main_eff, [(sv.file_path, sv.enc_settings) for sv in sub_videos])
        except Exception:
            _pv_total = None
        _pv_ext = bool(_pv_total and _pv_total > 0 and _pv_main_eff
                       and _pv_total > _pv_main_eff + 1e-6)
        # ---- 分组规划（嵌套合成；与导出 `_build_overlay_filter_complex` 同源同口径）----
        # 组 = 若干子视频先合成一只**包装盒**透明节点，再整体叠到真主视频。预览此前**完全没有**
        # 这条路径 ⇒ 编组后移动组落位（拖组合盒写 grp_dx/grp_dy、父行 X/Y 写 grp_abs_x/y）
        # 预览图纹丝不动（用户实测「已经把分组最终标签移动位置了，预览出的图还是原始位置」）。
        # 几何 / 落位 / 组节点变换**全部复用导出侧同一批 helper**（唯一出处），预览只复刻
        # 「成员建层 → 组节点合成 → 组节点叠加」三步。
        # 任一环节不成立（<2 成员 / 组内主 blend / 尺寸未知 / 窗口解不出）⇒ 该组**降级**为各自
        # 独立叠加 = 旧行为**逐字节一致**（零回归硬门，与导出同口径）。
        # ⚠️ 几何按**真输出画布**求（与导出 / UI 同域），`_pwf<1` 时再把全部数值乘 f 落到预览帧空间。
        _grp_members = {}
        for _gi, _gv in enumerate(sub_videos):
            _gg = str((_gv.enc_settings or {}).get("grp") or "").strip()
            if _gg:
                _grp_members.setdefault(_gg, []).append(_gi)
        _grp_ok = {}
        if _grp_members:
            _main_span = float(_pv_total or _pv_main_eff or 0.0)
            for _gg, _gm in _grp_members.items():
                if len(_gm) < 2:
                    continue
                _gbi = next((_ii for _ii in _gm
                             if (sub_videos[_ii].enc_settings or {}).get("is_grp_base")), _gm[0])
                _gbss = sub_videos[_gbi].enc_settings or {}
                # 组内主为 blend ⇒ 整组降级（B 语义下组内主是"组的底"，不存在"与主视频像素混合"，
                # 绝不静默忽略用户的 blend 设置）—— 与导出分组规划同一判据。
                if (_gbss.get('blend_mode', 'normal') or 'normal').strip().lower() != 'normal':
                    continue
                try:
                    _geo = self._group_box_geometry(
                        [(sub_videos[_ii].file_path, sub_videos[_ii].enc_settings)
                         for _ii in _gm],
                        main_settings=_ms, main_file_path=main_file)
                except Exception:
                    _geo = None
                if _geo is None:
                    continue
                # 成员时长两趟定（模型 B / E6，与导出**同口径**）：有界窗口成员保留自己的
                # 窗口；无界成员跟随**组窗口 = 成员窗口并集**（组内主有界 → 取所有有界成员
                # 的最大结束；组内主无界 → 主视频时间轴；绝不能退回素材自身时长）。
                _fixed, _unb, _wsa2, _ok = {}, [], {}, True
                for _ii in _gm:
                    _sf2 = sub_videos[_ii].file_path
                    try:
                        _sd2 = self._get_media_duration(
                            _sf2, frame_align_fps=self._get_video_framerate(_sf2))
                        _ws2, _we2, _hw2 = self._resolve_display_window(
                            sub_videos[_ii].enc_settings, _sd2, input_path=_sf2)
                    except Exception:
                        _ok = False
                        break
                    _wsa2[_ii] = float(_ws2 or 0.0)
                    if _hw2 and _we2 and _we2 > 0:
                        _fixed[_ii] = float(_we2)
                    else:
                        _unb.append(_ii)
                if not _ok:
                    continue
                # 「启用叠加」（2026-10-17 P0-2，与导出同一判据）：只影响「叠不叠」，
                # 不参与包装盒几何；窗口/并集只由可见成员 + 组内主决定。
                _vis2 = [_ii for _ii in _gm
                         if (sub_videos[_ii].enc_settings or {}).get("overlay_enabled", True)]
                _win2 = _vis2 if _gbi in _vis2 else (_vis2 + [_gbi])
                if not _vis2:
                    continue
                if _gbi in _fixed:
                    _ceil = max(_fixed[_ii] for _ii in _win2 if _ii in _fixed)  # 并集末
                else:
                    _ceil = _main_span if _main_span > 0 else None
                if not _ceil:
                    continue
                _lens = dict(_fixed)
                for _ii in _unb:
                    _lens[_ii] = float(_ceil)
                if _gbi not in _lens:
                    continue
                # 并集起点同理只由显式有界成员 + 组内主决定（无界成员跟随组窗口）
                _us2 = min([_wsa2.get(_gbi, 0.0)]
                           + [_wsa2[_ii] for _ii in _fixed if _ii in _win2]) \
                    if _fixed else float(_wsa2.get(_gbi, 0.0))
                _grp_ok[_gg] = {"mems": _gm, "base": _gbi, "lens": _lens,
                                "vis": _vis2,
                                "glen": max(_lens[_ii] for _ii in _win2 if _ii in _lens),
                                "us": _us2, "wsa": _wsa2, "geo": _geo}
        _grp_of = {_ii: _gg for _gg, _d in _grp_ok.items() for _ii in _d["mems"]}
        if _grp_ok:
            self._append_info_ui(_("[预览] 已启用嵌套合成：%s") % _("；").join(
                _("%s=%d 条") % (_gg, len(_d["mems"])) for _gg, _d in _grp_ok.items()))
        try:
            # 有生效分组时链让位（[] ⇒ 空链），避免「组员又是链成员」的语义冲突 —— 与导出
            # `_pip_transition_chains(([] if _grp_ok else sub_infos), …)` 同一口径。
            _pip_chains, _chain_of, _shift_pv = self._pip_transition_chains(
                ([] if _grp_ok else
                 [(i, sv.file_path, sv.enc_settings) for i, sv in enumerate(sub_videos)]),
                _ms, main_file, _pv_main_eff)
        except Exception:
            _pip_chains, _chain_of = [], {}
        # pipe_engine 进 out_mode（输出时间轴模式：不 seek 任何输入、拖动走图尾输出侧
        # trim）的两个条件：①有转场链（链图本身=输出时间轴）；②无链但子素材接龙/循环
        # 把时间轴延长到主视频之外——桥接模型时间轴只有主视频时长、主 EOF 即整链断
        # （用户实测 444441 硬切项目「只播放第一个视频」），必须同走 out_mode。
        _pv_out_mode = bool(pipe_engine and (_pip_chains or _pv_ext))

        # 解析主视频截取（起始/结束）→ 起始链 trim 前缀 + 截取后时长
        _main_trim_prefix = ""
        _main_trim_dur = None
        _ts = str(_ms.get("trim_start", "") or "").strip()
        _te = str(_ms.get("trim_end", "") or "").strip()
        _ssec = time_to_seconds(_ts) if _ts else None
        _esec = time_to_seconds(_te) if _te else None
        # pipe_engine（时间预览引擎管道模式）：截取**起点**交给 pipe_start —— 主输入吃输入级 -ss、
        # 图内时间轴已由 [0:v]setpts 桥接归零成「0 基 from pipe_start」（见 _launch_video_pipe），
        # 若再在图内套绝对 trim=start=S 会二次偏移（画面从 2S 处起、越拖越偏），故起点不烘焙。
        # ⚠️ 但**终点与起点无关、必须继续在图内显式收尾**：overlay 默认 eof_action=repeat ⇒ 主链
        # 不结束则子视频无限循环、主画面一路播到素材尾（用户实测「子视频循环填满选段、主视频过了
        # 选段还在放」）。旧实现把起点终点一起跳过 → 整链退化回「源全长」（_main_limit 跟着退化成
        # 源时长 ⇒ pad 黑画布 / 子视频 enable 窗口全部超长）。成片侧同款药见
        # build_tail_concat_filtergraph 的「主链强制收尾 trim=0:main_dur」。
        # 相对终点：图内 t=0 ⇔ 素材 S ⇒ t=(E−S) ⇔ 素材 E（与子链 trim=start/end 同 0 基口径）。
        if _ms.get("trim_enabled", False) and (_ssec is not None or _esec is not None):
            _tp = []
            if pipe_engine and not _pv_out_mode:
                # ⚠️ 起点必须**显式写 start=0**（不能省略、也不能只留 end）：图头
                # `[0:v]setpts=PTS+(pre−pipe_start)/TB` 会带出 2 帧预卷（首帧 PTS=−2帧·负值），
                # 而 trim 的 start 默认 INT64_MAX=无下界 ⇒ **不会**裁掉负 PTS 帧；于是随后共用的
                # `setpts=PTS-STARTPTS` 就以这个预卷帧为基准归零 → 整链内容右移 2 帧
                # （用户实测：主视频比选段起点早 1~2 帧、场景切换残留上一场景的画面）。
                # 写 start=0 后首帧 PTS 恰为 0（STARTPTS 基准=0、平移量 0），与成片路径的
                # `trim=start=S:end=E,setpts=PTS-STARTPTS` 逐帧等价（图内 t=0 ⇔ 素材 S）。
                # 判据：tests/_dbg_pipe_pip_startframe.py（合成 luma 阶梯素材反查输出首帧帧号）。
                _sel_end = _esec
                if _sel_end is None and _main_dur:
                    _sel_end = _main_dur          # 只设起点 → 选段到素材尾
                if _sel_end is not None and (_sel_end - (_ssec or 0.0)) > 0:
                    _tp.append("start=0")
                    _tp.append("end=%s" % _ffsec(_sel_end - (_ssec or 0.0)))
            else:
                if _ssec is not None:
                    _tp.append(f"start={_ssec}")
                if _esec is not None:
                    _tp.append(f"end={_esec}")
            if _tp:
                _main_trim_prefix = f"trim={':'.join(_tp)},setpts=PTS-STARTPTS,"
        # 主视频静态图片：单帧无限循环（loop=-1:size=1）+ setpts 归零；给默认 10s 预览时长
        _main_is_image = self._is_static_image(main_file)
        _IMAGE_PREVIEW_SEC = _eff_image_display_duration(_ms)
        if _main_is_image:
            _main_prefix = "loop=loop=-1:size=1:start=0,setpts=PTS-STARTPTS,"
        else:
            _main_prefix = _main_trim_prefix
        # 主视频画布模式（位置、尺寸、旋转）：2026-09-02 开放（抄统一尝试版 33498），
        # 与正式命令 _build_overlay_filter_complex 的主视频画布分支严格一致（那里已验证）。
        # 画布接管位置/尺寸/旋转 → 前置链关 crop/scale/rotate，内容=完整原始画面；
        # base_vf="" 交给 build_canvas_filtergraph（避免重复构建增强/字幕/变速）。
        # 预览与成片唯一差别：预览下游子视频定位用手工 _ctx={"W":_main_w,"H":_main_h}，
        # 故画布生效后必须把 _main_w/_main_h 同步为画布尺寸（否则子视频定位基准错位）。
        _canvas_on = bool(_ms.get("canvas_mode")) and bool(_ms.get("canvas_segments"))
        # ---- 尺寸基准（帧尺寸）与管道引擎工作分辨率上限 ----
        # 帧尺寸 = 链内 crop→rotate→scale / pad 画布 / 画布模式之后主视频帧的真实产出，与正式命令
        # / 可视化编辑器（compute_final_size_with_order）同源。
        # ⚠️ 绝不能用原始探测尺寸当定位基准，更**不能去掉链内「分辨率」缩放**（主链 base_vf 必须
        # 保留 include_scale 默认 True）：链内已把画面缩到目标尺寸，下游子视频定位/播放器窗口比例
        # 若仍按原尺寸算 → 子视频错位、窗口按原尺寸开（用户实测「主视频很大没缩放、只显示一半
        # （约 2 倍大小、只看到左上 1/4）」，mpv/ffplay/内置管道三条路都在内）。
        _mdim = self._get_video_dimensions_cached(main_file)
        _mw0, _mh0 = (_mdim[0] or 1280), (_mdim[1] or 720)
        _rend_w, _rend_h = self.compute_final_size_with_order(_mw0, _mh0, _ms)
        _pg1 = _pad_canvas_geometry(_ms)
        if _canvas_on:
            _frame_w, _frame_h = _mw0, _mh0        # 画布帧 = 原始尺寸（内容缩放由画布段按 _ms 自算）
        elif _pg1:
            _frame_w, _frame_h = _pg1[0], _pg1[1]  # pad 画布帧 = pad 尺寸
        else:
            _frame_w, _frame_h = _rend_w, _rend_h
        _main_w, _main_h = _frame_w, _frame_h
        # 工作分辨率上限（2026-09-21）：4K+ 主视频在 CPU 滤镜图上跑全分辨率 overlay 极吃力（mpv 走
        # GPU 不显；实测 4K 缩放后 hqdn3d/unsharp 5.2x、nlmeans 15.9x 提速，见 _PIPE_WORK_MAX_W）。
        # 做法：帧尺寸整体乘 f = 上限/帧宽，并**改写链内分辨率**为降采样尺寸（精确模式）→ 图里真实
        # 产出就是降采样尺寸，下游 _main_w/_main_h、子尺寸、pad 画布同步乘 f → 布局逐像素一致、仅
        # 像素变少（图计算量按 f² 下降）。**不能改成在图首另插一个 scale**：链内自带用户「分辨率」
        # scale，插在图首会被它整段顶回去。f=1 时完全不改设置。
        _pwf = 1.0
        # 画布模式（canvas_mode）不降采样（2026-09-21）：画布段由 build_canvas_filtergraph 按
        # canvas_segments 的**绝对像素**生成，输出尺寸无法跟着 f 缩 → 只缩内容基准会让画布与
        # 内容互相错位（用户实测同款「主视频和子视频中间很大空隙」，且随原始尺寸变大）。
        # 保持 f=1 即与 mpv/ffplay 逐像素一致。
        if (not _canvas_on) and pipe_engine and _frame_w > _PIPE_WORK_MAX_W and _frame_h > 0:
            _pwf = _PIPE_WORK_MAX_W / float(_frame_w)
            _frame_w, _frame_h = (max(2, int(_frame_w * _pwf) // 2 * 2),
                                  max(2, int(_frame_h * _pwf) // 2 * 2))
            _main_w, _main_h = _frame_w, _frame_h
            _ms["scale_enabled"] = True
            _ms["scale_method"] = "exact"
            _ms["scale_width"] = str(max(2, int(_rend_w * _pwf) // 2 * 2))
            _ms["scale_height"] = str(max(2, int(_rend_h * _pwf) // 2 * 2))
        _ms_cv = dict(_ms)
        if _canvas_on:
            _ms_cv["crop_enabled"] = False
            _ms_cv["scale_enabled"] = False
            _ms_cv["rotate"] = "none"
        base_vf = build_video_filter_chain(
            _ms_cv, include_subtitle=False, include_speed=False, include_trim=False,
            enhance_settings=_ms.get("enhance", {}), reverse=False,
            # 2026-10-09：画中画实时预览的主视频也要绿幕抠像（用户报「实时预览没接入
            # 主视频抠图」）。未启用时 None → 逐字节旧行为。
            chroma_settings=_ms_cv if _ms_cv.get("chroma_enabled", False) else None,
            # 2026-10-10：主视频透明度同样进画中画实时预览（与绿幕抠图同款接法）。
            include_alpha=True,
        )
        cur = "[vid1]"
        _first_vf = base_vf if (base_vf and base_vf != "null") else "format=yuv420p"
        if _main_is_image:
            # 图片主视频帧率修复（2026-09-21，用户实测 mpv「一跳一跳」）：mpv 对静态图片
            # 输入流的帧率=1fps（编码探针实锤：loop 循环限 5 帧只出 PTS=0/1 两帧、间隔 1s），
            # 直接 loop 它当主时间轴 → overlay 输出帧率跟随主输入 ≈1fps；ffplay image2
            # 默认 25fps 所以同图不卡；转换页不卡是因 wrap 前置了 color r=30 连续基源。
            # 修复=同款口径：前置 color 基源(r=30 d=显示时长)驱动主时间轴，图片降为被保持
            # 次输入 → 输出 30fps（编码探针：同图 90 帧/2.97s）。[vid1] 段保留 loop 前缀：
            # ffplay -autoexit 盯主输入 EOF（图片 1 帧即退窗）必须续命；mpv 下次输入无限流
            # 无副作用（overlay repeatlast 保持）。基源尺寸=首节点帧尺寸 _frame_w/_frame_h
            # （画布模式=原始尺寸、管道 f 降采样=缩放后尺寸，与 [cd_v0] 实际输出逐像素一致）。
            # 三处 color 基源包裹（转换页 mpv / 本处 / 串行合并图片轨）统一走同一份实现；
            # 返回串按 ";" 恰好切成 3 段（基源 / 图片次输入 / overlay），直接落到 parts。
            _img_segs = wrap_image_static_timed_complex(
                f"[vid1]{_main_prefix}{_first_vf}[v0]", _first_vf,
                _frame_w, _frame_h, _IMAGE_PREVIEW_SEC,
                vin="[vid1]", prefix=_main_prefix).split(";")
            fg.prepend(_img_segs[0])
            fg.extend(_img_segs[1:])
            cur = "[v0]"
        else:
            fg.raw(f"[vid1]{_main_prefix}{_first_vf}[v0]")
            cur = "[v0]"
        # 主视频画布段（第 1 段）：内容贴到不透明黑画布 → 独立数据流（与子视频画布同结构）
        if _canvas_on:
            try:
                _mts, _msp = _trim_speed_from_settings(_ms)
                # ⚠️ 预览路径 cur 已是完整带括号标签（"[v0]"），src_label 直接用 cur；
                # 统一尝试版 33530 写成 f"[{cur}]" → "[[v0]]" 双括号（bug），此处已修正。
                _mcg = build_canvas_filtergraph(
                    _ms, _main_w, _main_h, _mts, _msp,
                    src_label=cur, out_label="v_main_canvas",
                    canvas_color="black", base_vf="", tag="mc")
            except Exception:
                _mcg = None
            if _mcg:
                fg.raw(_mcg)
                cur = "[v_main_canvas]"
                # 第 2 段（2026-09-02 修复）：主视频画布此前缺这步 → 主视频自身缩放被忽略，
                # 内容恒按原始 1920 渲染（与正式命令同根因，用户实测「缩放1280 却按1920运动进来」）。
                # 与正式命令完全等价：把画布窗口（原始/裁剪框）按主视频渲染缩放重算内容盒尺寸，
                # 下游子视频定位基准（_main_w/_main_h）同步更新。
                _mcw, _mch = _resolve_crop_size(_ms, _main_w, _main_h) or (_main_w, _main_h)
                _mbbw, _mbbh = compute_rendered_size(
                    _mcw, _mch, {**_ms, "crop_enabled": False, "rotate": "none"})
                _mbbw, _mbbh = max(2, int(_mbbw)), max(2, int(_mbbh))
                if (_mbbw, _mbbh) != (_mcw, _mch):
                    fg.raw(f"{cur}scale={_mbbw}:{_mbbh}[v_main_canvas_s]")
                    cur = "[v_main_canvas_s]"
                _main_w, _main_h = _mbbw, _mbbh
                self._append_info_ui(
                    _('[预览] 主视频画布模式已启用：内容基准 {0}x{1}，画布 {2}x{3}').format(_mdim[0] or 1280, _mdim[1] or 720, _main_w, _main_h))
            else:
                self._append_info_ui(_("[预览] 主视频画布模式生成失败，已按普通主视频处理"))
        # 主视频有效结束时长（结尾强制收尾 trim 用）：截取后时长优先，图片给默认 10s
        # （_main_dur 已在主视频截取解析前探测，见上）
        if _main_trim_prefix:
            if _esec is not None and _ssec is not None and _esec > _ssec:
                _main_trim_dur = _esec - _ssec
            elif _esec is not None:
                _main_trim_dur = _esec
            elif _ssec is not None and _main_dur:
                _main_trim_dur = max(0.0, _main_dur - _ssec)
        _main_end_dur = _main_trim_dur if (_main_trim_dur and _main_trim_dur > 0) else (
            _IMAGE_PREVIEW_SEC if _main_is_image else None)
        # 统一时长上限：结束时长优先（pad 画布 duration / 子视频 enable 都按它）
        _main_limit = _main_end_dur if (_main_end_dur and _main_end_dur > 0) else _main_dur
        # 图片主视频：循环由图内 `loop=loop=-1` 滤镜承担（_main_prefix 已注入，ffplay 实测可持续
        # 出帧），末端 trim=0:N（N=图片显示时长 _IMAGE_PREVIEW_SEC）负责在 N 秒后收尾 → -autoexit
        # 等到【输出】结束自动关闭（不再依赖无效的 -loop 1，后者在 ffplay 下图片不循环、实测 1 秒消失）。
        # 故此处保留 _main_end_dur=显示时长（不置 0）：画布 color 源 / 子视频 enable / 末端 trim / -t
        # 全部按显示时长收敛，ffplay 窗口在 N 秒后正常关闭。
        # ---- 主视频画布偏移（pad）----
        _pg = _pad_canvas_geometry(_ms)
        if _pg:
            _pwc, _phc, _ox, _oy = _pg
            # 工作分辨率上限（2026-09-21）：pad 画布宽/高/偏移是设置里的绝对像素，主视频帧已
            # 按 f 缩放 → 这里必须把同一因子乘上去，否则 pad 比缩小后的主视频大、子叠加基准
            # 错位。f=1 时不缩放（与旧行为一致）。
            # ⚠️ 宽高必须与 _frame_w/_frame_h 同口径（向下取偶）：用 round 会得到奇数尺寸
            # （如 2200×f → 939），yuv420p 奇数高在 rawvideo 管道里会错位，且与 `_main_w/_main_h`
            # 差 1 px → 预览框比例与画布不一致。
            if _pwf < 1.0:
                _pwc = max(2, int(_pwc * _pwf) // 2 * 2)
                _phc = max(2, int(_phc * _pwf) // 2 * 2)
                try:
                    _ox = "%g" % (float(_ox) * _pwf)
                except (ValueError, TypeError):
                    pass
                try:
                    _oy = "%g" % (float(_oy) * _pwf)
                except (ValueError, TypeError):
                    pass
            # 画布必须限制时长：color 默认无限源，主视频播完后会只剩黑画布继续输出
            # （movie 子视频 loop=0 已播完消失）。有主视频时长 → color:duration=主视频时长，
            # 画布与主视频同长一起结束；拿不到时长 → overlay shortest=1（任一输入结束即结束，
            # 基于实际流时长；eof_action=pass 实测此 ffmpeg 版本不生效会卡死）。
            _pad_dur = ""
            if _main_limit and _main_limit > 0:
                _pad_dur = f":duration={_ffsec(_main_limit)}"
            fg.raw(f"color=c=black:s={_pwc}x{_phc}{_pad_dur}[canvas]")
            if _pad_dur:
                fg.raw(f"[canvas]{cur}overlay={_ox}:{_oy}[v_main_pad]")
            else:
                fg.raw(f"[canvas]{cur}overlay={_ox}:{_oy}:shortest=1[v_main_pad]")
            cur = "[v_main_pad]"
            # ⚠️ 画布基准更新（2026-08-25）：overlay 目标流已是 pad 画布，_main_w/_main_h
            # 必须同步为 pad 尺寸——轨迹 clamp / 基准位置求值 ctx / _blend_static_geometry
            # 全用它，否则轨迹被锁死主视频源尺寸、普通叠加基准位置也错位。
            _main_w, _main_h = _pwc, _phc
            self._append_info_ui(_('[预览] 主视频画布偏移：{0}x{1} @ ({2},{3})').format(_pwc, _phc, _ox, _oy))

        # ---- 转场链：主视频进链 split + 真时间轴延长（与正式命令
        # _build_overlay_filter_complex 的「链规划 → 主进链 split → 底 tpad」同序）----
        # 链规划已提前到 _ms 定义处（pipe_engine 有链 → _pv_out_mode，见上）。
        # 主视频进链：split 出「未延长」副本给链（链内 trim=主时长正好等于全部内容）。
        # ⚠️ 让链的 trim 分支与「延长后的底」共享同一中间标签，会让整链在主视频
        # 结束处提前 EOF —— 正式命令同款坑（_verify_pip_transition S8）。
        if _pip_chains and any(_ch["members"][0] < 0 for _ch in _pip_chains):
            fg.raw(f"{cur}split=2[v_pv_mbase][v_pv_mchain]")
            cur = "[v_pv_mbase]"
            _pv_main_chain_raw = "v_pv_mchain"
        # 真时间轴：子素材摆到主视频之后 → 底 tpad 补黑帧。overlay 主输入 EOF=整链
        # EOF，不补的话超出部分静默丢失（用户实测「画面 12 秒就结束、没有持续到 40 秒」）。
        # _pv_main_eff/_pv_total 已提前到 out_mode 判定处（见上）；桥接模型（非 out_mode
        # 的 pipe_engine）不延长：tpad/绝对窗口会随 seek 错位，维持原状（零行为变化）。
        with suppress(Exception):
            self._pip_warn_cut_off_subs(
                [(sv.file_path, sv.enc_settings) for sv in sub_videos], _pv_total)
        if (_pv_total and _pv_total > 0 and _pv_main_eff
                and _pv_total > _pv_main_eff + 1e-6
                and ((not pipe_engine) or _pv_out_mode)):
            # 需要 alpha 时补**透明**帧（与正式命令 _build_overlay_filter_complex 的
            # tail_pad_alpha 同口径）：否则主视频之后那段的子视频透明会被不透明黑垫掉，
            # 预览里既看不到棋盘、导出也没有真 alpha。
            _pv_pad_col = ":color=black@0" if _pv_needs_alpha else ""
            fg.raw(
                f"{cur}tpad=stop_mode=add:stop_duration={_pv_total - _pv_main_eff:.6f}{_pv_pad_col}[v_main_ext_pv]")
            cur = "[v_main_ext_pv]"
            self._append_info_ui(
                _('[预览] 子素材显示时段超出主视频时长（{0:.3f}s），已延长预览时间轴到 {1:.3f}s（尾部补黑帧）').format(_pv_main_eff, _pv_total))

        # ---- 多 blend 子视频区域隔离（需求3）：主视频 split 出原始帧副本 ----
        # 非 normal blend 子视频 ≥2 个时，blend 主区域从主视频【原始帧】副本取
        # （而非已被前面 blend 改过的主干 cur），重叠区互不干涉（与正式命令 _use_regional 一致）。
        # 单 blend / 全 normal 不 split（零行为变化）。split 是帧引用（零拷贝）。
        def _does_blend(es):
            # 与正式命令 _use_regional 计数一致：overlay 启用且 blend≠normal 即算
            # （含 diamond/corners 静态基准位置回退，见 blend 分支）
            if not es.get('overlay_enabled', True):
                return False
            return ((es.get('blend_mode', 'normal') or 'normal').strip().lower() != 'normal')
        _nb = sum(1 for _sv in sub_videos if _does_blend(_sv.enc_settings))
        _regional = _nb >= 2
        if _regional:
            _base_labels = "".join(f"[cur_base{j}]" for j in range(_nb))
            fg.raw(f"{cur}split={_nb + 1}[cur]{_base_labels}")
            cur = "[cur]"  # 运行主干 = split 第一个输出（与正式命令 current_v=v_main_base 一致）
        _bj = 0

        # ---- 子视频图层构建（闭包，与正式命令 _build_sub_layer_node 同源镜像）----
        # 只建层不叠加（cur 不动）；叠加/blend 留在下方主循环。win_override 给链成员传
        # (0, 段长)——链内不位移 + 精确限长（与正式命令 win_override 同语义）。
        # group_base（2026-10-16）：本轨是**组内主** ⇒ 它的透明度 / 旋转 / 轨迹缩放 / 轨迹定位
        # 全部搬到**组节点**上表达（作用于整组），内容腿一律不加（与正式命令
        # `_build_sub_layer_node(group_base=…)` 同口径；否则整组"转两次 / 缩两次"）。
        # force_overlay：组成员建层**不看**「启用叠加」开关 —— 导出阶段 A3 也照样把它烙进组
        # 画布（只有 Stage B 的单层叠加才看该开关）⇒ 预览必须同口径。
        def _pv_build_layer(_k, _sv, win_override=None, group_base=False, force_overlay=False):
            _s = _sv.enc_settings
            # #5：宿主声明**这一条**子视频轨是本次未提交航点的目标时才覆盖（判据统一在
            # _wp_target_hit；allow_layer=False ⇒ 子视频层不接受 layer 身份，防串味 ——
            # 从文字水印轨迹窗开预览时绝不能把文字的轨迹套到这个子视频上）。
            if _lw and _wp_target_hit(_wt, track=_sv, allow_layer=False):
                _s = _wp_inject_live(_s, _lw)
                _lw_hit[0] = True
            _sfile = _sv.file_path
            # ⚠️ 与正式命令 _build_overlay_filter_complex（L26707）同口径：未启用叠加的子视频
            # 预览里也不显示（2026-09-24 修正）。此前本循环**完全不读**这个开关 → 出现
            # 「预览里三个图都叠上了、成片却只剩主图」的假象（用户实测：全图片工程，正式命令
            # 里子图走进 L26882 的 else → [v_temp_N]nullsink）。预览必须与成片同源，否则
            # 用户无从判断到底是设置问题还是渲染问题。
            if not force_overlay and not _s.get('overlay_enabled', True):
                self._append_info_ui(
                    _('[预览] 子视频 {0} 未勾选「启用叠加」：预览与成片都不显示它（如需显示，请到该轨道的「视频轨道设置」里勾选「启用叠加」）').format(_k + 1))
                return None
            try:
                _ow, _oh = get_video_rotated_dimensions(self.ffprobe_cmd, _sfile, _s)
                if _ow is None or _oh is None:
                    _ow, _oh = 320, 240
                _rw, _rh = compute_rendered_size(_ow, _oh, _s)
                if _rw <= 0 or _rh <= 0:
                    _rw, _rh = _ow, _oh
            except Exception:
                _rw, _rh = 320, 240
            # 画布模式（2026-08-31 两段式）：下游定位/blend/对角线的基准尺寸 = 内容盒
            # （= 画布尺寸 × 用户缩放），与不开画布时的叠加尺寸完全等价 → 下游零改动。
            _sub_cv_on = self._sub_canvas_on(_s)
            if _sub_cv_on:
                _rw, _rh = self._overlay_content_size(_sfile, _s)
            # 工作分辨率降采样（2026-09-21）：子尺寸同步乘 f，保持子占画布比例不变
            # （仅 f<1 触发；f=1 不缩放，与旧行为一致）。
            if _pwf < 1.0:
                _rw = max(2, int(round(_rw * _pwf)))
                _rh = max(2, int(round(_rh * _pwf)))
            # 绝对像素坐标同步换算（2026-09-21）：简易位置写死的数字 / 列表轨迹航点 / 四角边距是
            # 「原始画面空间」的量，帧已乘 f → 不换算会让子视频在缩小后的画布里相对更靠右下
            # （用户实测「主视频和子视频中间很大空隙」，只有管道预览有；f=上限/原始宽 → 原始越大
            # 空隙越大）。换算见 _pipe_scale_pos_settings（与转换页水印/文字水印同一实现）。
            _s_pos = _pipe_scale_pos_settings(_s, _pwf)
            _path_esc = self._movie_path_safe(_sfile, _k).replace("\\", "/").replace(":", "\\\\:")
            # 子视频滤镜链：复用主滤镜构建函数（字幕/像素格式等 mpv 预览不支持的排除），
            # trim/loop/裁剪/缩放/绿幕/颜色校正/反色/变速 全在 chain 内（movie 层只载入，chain 统一循环）；
            # 链外仅保留透明度/自旋转。滤镜倒放预览已取消（2026-08-30）：reverse 恒 False。
            _loop_size = self._preview_sub_loop_size(_s, _sfile)
            # 子视频「显示时段」优化（2026-09-02，抄统一尝试版 33636）：与正式命令一致，
            # 用 _resolve_display_window 解析有界窗口 → 有限循环 loop=N + 首帧锚定 show_start。
            # 预览 overlay 已恒带 eof_action=pass（27831 / blend 分支 27785·27803·27822），
            # 故此处只需传窗口。
            # ⚠️ _s_dur 必须先于 _resolve_display_window 绑定（原本只在 overlay 分支内定义，
            # 首个子视频在此引用会 UnboundLocalError，与正式命令同根因）。
            try:
                # 帧对齐（floor）：与正式命令 _build_sub_layer_node 同口径
                _s_dur = self._get_media_duration(
                    _sfile, frame_align_fps=self._get_video_framerate(_sfile))
            except Exception:
                _s_dur = None
            _pwin_start, _pwin_end, _phas_win = self._resolve_display_window(_s, _s_dur, input_path=_sfile)
            if win_override is not None:
                # 转场链成员：链内窗口（不位移 + 精确限长），与正式命令 win_override 同语义
                _pwin_start, _pwin_end, _phas_win = float(win_override[0]), float(win_override[1]), True
            # 有限循环次数：仅覆盖窗口时长（与正式命令一致）。无界窗口不计算。
            # loop 参数 = 重复次数（总供给 = N+1 遍）→ N = ceil - 1；0 = 不加 loop（防回放泄漏闪首帧）
            _pwin_loop = 0
            if _phas_win and _loop_size and _pwin_end is not None:
                _pfps = self._get_video_framerate(_sfile)
                if _pfps:
                    _pwin_frames = max(1, int(round((_pwin_end - _pwin_start) * _pfps)))
                    _pwin_loop = -(-_pwin_frames // int(_loop_size)) - 1
                    if _pwin_loop < 0:
                        _pwin_loop = 0
            _ft_speed_on = bool(self.preview_filter_speed.get())
            # 画布模式：裁剪/旋转/缩放交给画布段 → 前置链三者全关（缩放挪到画布之后，防缩两次）
            _sb_settings = dict(_s, hw_filter_mode="cpu", precise_trim=True)
            if _sub_cv_on:
                _sb_settings["crop_enabled"] = False
                _sb_settings["rotate"] = "none"
                _sb_settings["scale_enabled"] = False
            _sb = build_video_filter_chain(
                _sb_settings, include_subtitle=False,
                include_speed=_ft_speed_on, include_trim=True, include_format=False,
                include_scale=False,
                enhance_settings=_s.get("enhance", {}), reverse=False,
                chroma_settings=_s if _s.get("chroma_enabled", False) else None,
                loop_size=_loop_size,
                window_start=_pwin_start, window_end=_pwin_end, window_loop_count=_pwin_loop,
                force_scale=None if _sub_cv_on else (_rw, _rh),  # 渲染尺寸缩放；画布模式交给第 2 段
            )
            _sp = []
            if _sb and _sb != "null":
                _sp.append(_sb)
            _alpha = bool(_s.get("alpha_enabled", False))
            # 注意：enc_settings["rotate"] 是「视频滤镜」的方向字符串（"90"/"180"/"270"），
            # 已由 build_video_filter_chain 处理成 transpose——不要在这里再当角度追加 rotate
            # （否则 rotate="270" 会 transpose 一次 + rotate 270° 一次 = 双重旋转）。
            # 子视频只有 spin 持续旋转需要显式 rotate（与正式命令 _build_overlay_filter_complex 一致）。
            _spin = bool(_s.get("spin_enabled", False))
            _spd = _opt_float(_s.get("spin_speed", 60.0) or 60.0, 60.0)
            _rad = _opt_float(_s.get("rotate_angle", 0) or 0, 0.0)
            _mv = (str(_s.get("move_mode", "") or "")).strip()
            # 🔴 画布 vs 列表轨迹 缩放共存提示（2026-10-07 复核：互锁已取消，仅提示；
            #    两个缩放都**原样生效并相乘** —— 与正式命令 _build_sub_layer_node 同款）。
            #    预览必须与转换一致，否则预览对、导出错。
            self._sub_canvas_scale_notice(_s, _sfile, where="live_preview")
            _wpP = None
            _wp_rotP = False
            if _mv == "waypoints":
                _ts0, _sp0 = _trim_speed_from_settings(_ms)
                _wpP = build_waypoint_expr(_s_pos.get("move_waypoints"),
                                           sw=str(_rw), sh=str(_rh), spin_speed=_spd,
                                           trim_start=_ts0, speed_factor=_sp0)
                _wp_rotP = (_wpP is not None and _wpP[2] is not None)
            if not group_base and (_alpha or (_spin and _spd != 0) or _rad != 0 or _wp_rotP or
                                   (_wpP is not None and _wpP[4] is not None)):
                _sp.append("format=rgba")
            if _alpha and not group_base:
                _av = _opt_float(_s.get("alpha_value", 1.0), 1.0)
                # 静态透明度：轨迹透明度存在时跳过——由下方 geq 一并折入。
                if 0.0 <= _av <= 1.0 and not (_wpP is not None and _wpP[4] is not None):
                    _sp.append(f"colorchannelmixer=aa={_av:.2f}")
            # 轨迹透明度（oa→ob 段内线性插值 0~1 倍率）：与静态 alpha_value 串联合成（相乘）。
            # 全 1.0 时 _wpP[4] 为 None 跳过 → 与无任何透明度的老工程行为一致。
            # ⚠️ colorchannelmixer=aa 在本构建为 init 模式（拒绝 t/max 时变表达式），改用 geq 承载：
            #    时间戳变量为 T（独立 t 用 re.sub 换 T），上游已挂 format=rgba，静态 _av 折入 a='(_av*255)*(traj_T)'。
            #    geq 表达式取 0~255 平面值（非 0~1），alpha 须 ×255 缩放（见子视频处说明）。
            #    已知限制：geq 读不到输入 alpha，不乘源素材自带 alpha（见子视频处说明）。
            if not group_base and _wpP is not None and _wpP[4] is not None:
                _traj_TP = re.sub(r'\bt\b', 'T', _wpP[4])
                _saP = _av if (_alpha and 0.0 <= _av <= 1.0) else 1.0
                _sp.append(f"geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':a='{_saP*255:.0f}*({_traj_TP})'")
            # 子视频自身的旋转（静态角度 / 持续自旋转 / 列表航点角度）。
            # 🔴🔴 铁律（2026-10-08 用户实测定位）：画布模式下**必须延后到画布段之后**，
            #     与正式命令 _build_sub_layer_node（34744 段：画布 → 第2段 scale → 透明度
            #     → 旋转 → 列表缩放）保持同序。若留在前置链（画布之前）会出现两处几何错：
            #     ① 画布段的 `scale=2*round(W*s(t)/2):2*round(H*s(t)/2)`（W/H=**内容原始
            #        尺寸**）会把 hypot 正方形盒 d×d 当内容缩回 W×H → 非等比压扁（画面变扁）；
            #     ② 画布 overlay 的 `(main_w-overlay_w)/2` 里 overlay_w 变成 d 而非 w
            #        → 内容整体再偏左 (d-w)/2。
            #     症状：子视频「列表轨迹」给航点设角度后，预览整体偏左、能超出画面且画面变扁；
            #     角度改回 0（不挂 rotate）即恢复正常 —— 正是本条漏延后。仅画布模式受影响
            #     （非画布模式 rotate 本来就在叠加前，与正式命令同序）。
            _rot_segP = None
            if not group_base and overlay_rotation_active(_s, wp_rot=_wp_rotP):
                _angle_exprd = ""
                if _rad != 0:
                    _angle_exprd = f"{_rad}*PI/180"
                if _wp_rotP:
                    # 列表自旋转覆盖全局 spin
                    if _angle_exprd:
                        _angle_exprd += " + "
                    _angle_exprd += f"({_wpP[2]})"
                elif _spin and _spd != 0:
                    if _angle_exprd:
                        _angle_exprd += " + "
                    _angle_exprd += f"{_spd}*PI/180*t"
                _rot_segP = (f"rotate=angle='{_angle_exprd}'"
                             f":ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0")
                if not _sub_cv_on:
                    _sp.append(_rot_segP)
            # 列表轨迹缩放（2026-09-04）：必须排在 rotate 之后（变尺寸 scale 在前会把 rotate 的
            # ow/oh 锁死在首帧 → 放大内容被裁）。用 iw/ih 相对表达 → 与旋转画布 d×d / 画布模式
            # 解耦。max(2,...) 防 round 成 0；setsar=1 防 SAR 逐帧漂移。
            _wp_zoomP = bool(_wpP is not None and _wpP[3] is not None)
            # blend 同样支持缩放（方案 A 静态包围盒模型，见 _make_blend_region）：
            # 旧「窗口固定 = 基准内容盒」的前提已随 crop 窗口改为静态包围盒而消失。
            # 🔴⚠️ 铁律（真机 2026-10-07 像素级实证）：blend 路径下**必须把 format=rgba 提到
            #    逐帧 scale 之前**，否则 z(t) 锁死在首帧值（详见 _make_blend_region 铁律）。
            # 🔴🔴 铁律（2026-10-07 真机像素级实证，ffmpeg/mpv 同病）：画布模式下列表轨迹
            #    缩放**必须延后到画布合成之后**做（不能放在 _sub_chain 里、画布之前）。
            #    原因：画布段首段是 `{src}format=rgba`（独立段）。若逐帧变尺寸 scale 的输出
            #    紧跟一个独立 format 段，ffmpeg/mpv 都会把 `eval=frame` 的 z(t) **锁死在首帧**
            #    （A/B：scale 后带 format → 白块 60/60/60 恒定；scale 后不带 format → 66/96/76
            #    随 z 变化）。延后到画布之后后，与正式命令 _build_sub_layer_node 完全同序
            #    （画布 → 第 2 段 → 列表缩放 → 叠加），其后不再有独立 format 段 → 正常。
            if _wp_zoomP and not _sub_cv_on and (str(_s.get('blend_mode', 'normal')
                                                  or 'normal')).strip().lower() != 'normal':
                _sp.append("format=rgba")
            # 画布模式下把列表缩放段**攒起来**，稍后在画布合成之后追加（见下方 _sub_cv_on 块）。
            # group_base：轨迹缩放搬去组节点（见 `_group_node_transform_parts`）⇒ 内容腿不加。
            _wp_scale_segP = None
            if _wp_zoomP and not group_base:
                # 列表轨迹缩放 sendcmd 化（2026-10-07，与正式命令 _build_sub_layer_node
                # 33273 同款）：航点行数 > 阈值时把 zoom scale 改名 scale@slr{_k} 并挂
                # sendcmd 命令文件（值 = max(2,2*round(iw*(s)/2))，s 为倍率因子区间表，
                # BASE=运行时 iw/ih）→ 突破 92 段表达式墙。阈值内/无缩放变化保持表达式路。
                # 🔴 mpv --lavfi-complex 实测支持逗号链内 sendcmd（真机 2026-10-07 验证），
                #    无需拆 ; 分段；路径必须用项目同款 `C\:/` 转义否则 mpv 解析失败。
                # ⚠️ 铁律不变：blend 的 format=rgba 仍必须在逐帧 scale 之前（见上方）。
                _wp_scale_scP = None
                _wp_scale_z0P = None
                if _mv == "waypoints" and _wpP is not None and _wpP[3] is not None \
                        and len([w for w in (_s_pos.get("move_waypoints") or [])
                                 if isinstance(w, dict)]) > _wp_sc_rows_limit():
                    try:
                        _wp_scale_ivP = build_waypoint_scale_intervals(
                            _s_pos.get("move_waypoints"),
                            trim_start=_ts0, speed_factor=_sp0)
                    except Exception:
                        _wp_scale_ivP = None
                    if _wp_scale_ivP:
                        _wp_scale_scP = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                            _wp_scale_ivP, tag=f"slr{_k}", cmd_style="scale",
                            target=f"scale@slr{_k}", scale_base_w="iw",
                            scale_base_h="ih", scale_min=2)
                        _wp_scale_z0P = _wp_scale_ivP[0][3]
                if _wp_scale_scP is not None:
                    # sendcmd 驱动 scale@slr{_k}：首帧占位=首区间倍率（避免首帧 glitch）。
                    # ⚠️ 值含逗号（max(2,...)）必须整体单引号包裹，否则 filtergraph 把逗号
                    # 当滤镜分隔符 → "No option name near 'max(2'"（与非 sendcmd 分支对齐）。
                    _zw0P = f"'max(2,2*round(iw*({_wp_scale_z0P:g})/2))'"
                    _zh0P = f"'max(2,2*round(ih*({_wp_scale_z0P:g})/2))'"
                    _scale_segP = (
                        f"sendcmd=f='{_wp_scale_scP}',"
                        f"scale@slr{_k}=w={_zw0P}:h={_zh0P}:eval=frame,setsar=1")
                else:
                    _scale_segP = (
                        f"scale=w='max(2,2*round(iw*({_wpP[3]})/2))'"
                        f":h='max(2,2*round(ih*({_wpP[3]})/2))':eval=frame,setsar=1")
                if _sub_cv_on:
                    _wp_scale_segP = _scale_segP      # 延后到画布之后
                else:
                    _sp.append(_scale_segP)
            # sendcmd 接入（预览同步 2026-10-01）：航点行数 > 阈值 → 位置改命令文件驱动，
            # 与正式命令 _build_sub_layer_node 同款；zoom 也已 sendcmd 化（见上方 if _wp_zoomP），
            # alpha/angle 仍走表达式。
            # 预览坐标空间 = _s_pos（pipe f 缩放后），区间表必须同源换算，与 _wpP 一致。
            _wp_scP = None
            # ⚠️ 必须在此初始化：未走 sendcmd 分支时 _sc_ivP 从未被绑定，
            # 而下方 return dict 无条件读它 → UnboundLocalError。
            _sc_ivP = None       # 与 _wp_scP 配套的区间表（blend 区域 sendcmd 复用，避免重算）
            _wp_sc_x0P = _wp_sc_y0P = "0"
            if not group_base and _mv == "waypoints" and _wpP is not None and _wpP[0] is not None \
                    and len([w for w in (_s_pos.get("move_waypoints") or [])
                             if isinstance(w, dict)]) > _wp_sc_rows_limit():
                try:
                    # 与 _wpP 同源：直接用原始航点（2026-10-07 互锁取消后不再有 sa/sb 中和副本）
                    _sc_ivP = build_waypoint_position_intervals(
                        _s_pos.get("move_waypoints"), trim_start=_ts0, speed_factor=_sp0)
                except Exception:
                    _sc_ivP = None
                if _sc_ivP:
                    # 旋转偏移后缀（预览版几何：_rw/_rh + 对角线盒；随 z(t) 同乘）——
                    # 与正式命令 _waypoint_sendcmd_offset_suffix 同语义：suffix 折进命令值，
                    # 消费侧（主循环 _rot_pv / 链内画布烙印）不再做中心对齐偏移。
                    _sxP = _syP = ""
                    if overlay_rotation_active(_s, wp_rot=_wp_rotP):
                        _eval_dP = int(round(((_rw * _rw + _rh * _rh) ** 0.5)))
                        _offxP, _offyP = _content_box_shift(_rw, _rh, _eval_dP, _eval_dP)
                        if _wp_zoomP:
                            _sxP = f"- (({_wpP[3]}))*{_offxP:.6g}"
                            _syP = f"- (({_wpP[3]}))*{_offyP:.6g}"
                        else:
                            _sxP = f"- {_offxP:.6g}"
                            _syP = f"- {_offyP:.6g}"
                    _wp_scP = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                        # ⚠️ tag 必须与 overlay 完整别名逐字一致（两处消费：链内画布烙印/
                        # 主循环叠加，同一 _k 只走其一）
                        _sc_ivP, tag=f"wps{_k}", suffix_x=_sxP, suffix_y=_syP)
                    if _wp_scP is not None:
                        if _sc_ivP[0][2] == "hide":
                            _wp_sc_x0P = _wp_sc_y0P = "-100000"
                        else:
                            _wp_sc_x0P = f"{_sc_ivP[0][3]:g}"
                            _wp_sc_y0P = f"{_sc_ivP[0][4]:g}"
            _sub_chain = ",".join(_sp) if _sp else "null"
            # movie 层只载入（无 loop 参数=默认播一次）；循环统一由 chain 的 loop_size 处理。
            # 混音/替换子视频：另挂 amovie= 源出音频（本 ffmpeg 版本 movie 只有视频输出，
            # 视频/音频各开一路；两条路径解码同一文件、pts 同源 0 基，天然对齐）
            if _is_virtual_source(_sfile):
                # 2026-10-09：颜色子视频 —— movie= 不能吃 lavfi，直接以图内 color 源供 [sub{k}]；
                # 与主视频**同一出口** _virtual_source_graph_node（下游 [sub{k}]{chain}[subpre{k}] 零改动）。
                # 颜色源无音轨 → 不走 amovie= 分支（_pv_audio_plan 也本就不会含它）。
                _col_node_sv = _virtual_source_graph_node(_sfile, "sub%d" % _k)
                if _col_node_sv:
                    fg.raw(_col_node_sv)
                else:
                    fg.raw(f"movie={_path_esc}[sub{_k}]")
            elif _k in _pv_audio_plan:
                fg.raw(f"movie={_path_esc}[sub{_k}]")
                fg.raw(f"amovie={_path_esc}[asub{_k}]")
                _pv_audio_src[_k] = True
            else:
                fg.raw(f"movie={_path_esc}[sub{_k}]")
            if _sub_cv_on:
                # 第 1 段：前置链 → 透明画布合成 → 独立数据流；
                # 第 2 段：当独立文件自由缩放。最终一律落回 [subr{k}]，下游零改动。
                fg.raw(f"[sub{_k}]{_sub_chain}[subpre{_k}]")
                _tsc, _spc = _trim_speed_from_settings(_s)
                _scg = self._build_sub_canvas_graph(
                    _s, _sfile, f"p{_k}", f"[subpre{_k}]", f"v_sc_{_k}",
                    trim_start=_tsc, speed_factor=_spc)
                _cur_lbl = f"[subpre{_k}]"
                if _scg:
                    fg.raw(_scg)
                    _cur_lbl = f"[v_sc_{_k}]"
                _scw, _sch = self._sub_canvas_size(_s, _sfile)[2:4]
                if (_rw, _rh) != (_scw, _sch):
                    fg.raw(f"{_cur_lbl}scale={_rw}:{_rh}[v_scs2_{_k}]")
                    _cur_lbl = f"[v_scs2_{_k}]"
                # 自旋转/静态角度/列表航点角度：画布 + 第 2 段之后再挂（与正式命令
                # _build_sub_layer_node 同序：画布 → 第2段 scale → 透明度 → **旋转** → 列表缩放）。
                # 🔴 不能放在 _sub_chain（画布之前）：画布段的 scale 以内容原始尺寸 W×H 为基准，
                #    会把 hypot 正方形盒 d×d 非等比缩回 W×H（画面变扁），且画布 overlay 的
                #    (main_w-overlay_w)/2 用 d 顶替 w → 整体偏左 (d-w)/2（2026-10-08 用户实测：
                #    列表轨迹设角度后预览偏左+变扁，改回 0 即正常）。见 53978 铁律注释。
                if _rot_segP is not None:
                    fg.raw(f"{_cur_lbl}{_rot_segP}[v_srot_{_k}]")
                    _cur_lbl = f"[v_srot_{_k}]"
                # 列表轨迹缩放：画布 + 第 2 段之后再挂（与正式命令 _build_sub_layer_node 同序）。
                # 🔴 不能放在 _sub_chain（画布之前）：逐帧 scale 之后紧跟画布段的独立
                #    format=rgba 段 → z(t) 锁死首帧（见上方铁律，真机实证）。
                # ⚠️ 必须在旋转之后（正式命令同序）：缩放作用在旋转盒上，先缩后转会把
                #    rotate 的 ow/oh 锁死在首帧。
                if _wp_scale_segP is not None:
                    fg.raw(f"{_cur_lbl}{_wp_scale_segP}[v_wzr_{_k}]")
                    _cur_lbl = f"[v_wzr_{_k}]"
                fg.raw(f"{_cur_lbl}null[subr{_k}]")
            else:
                fg.raw(f"[sub{_k}]{_sub_chain}[subr{_k}]")
            return {
                "label": f"subr{_k}", "s": _s, "sfile": _sfile,
                "rw": _rw, "rh": _rh, "s_pos": _s_pos,
                "wpP": _wpP, "wp_rotP": _wp_rotP, "wp_zoomP": _wp_zoomP,
                "spin": _spin, "spd": _spd, "rad": _rad,
                "wp_sc": _wp_scP, "wp_sc_x0": _wp_sc_x0P, "wp_sc_y0": _wp_sc_y0P,
                # ⚠️ blend 区域 sendcmd 也要用这张区间表重写 blendP{_k} 命令文件
                # （crop@cr{_k} + overlay@ov{_k} 双目标）——嵌套函数的局部变量出不去，
                # 必须经返回值传递（2026-10-06 真机 NameError，与 _wp_sc_iv 同类）。
                "wp_sc_iv": _sc_ivP,
            }

        # ---- 转场链：预构建成员图层 + 画布烙印 + xfade 合成（仅外部播放器路线）----
        # 与正式命令 _build_overlay_filter_complex 阶段 A/A2 同源（链规划已在上方完成，
        # 主视频进链的 split 与底 tpad 也已按正式命令同序处理，主视频参与链不再降级）；
        # 主循环在**链首成员的栈位**把整链一次叠入（栈序=列表序，与正式命令阶段 B 一致）。
        if _pip_chains:
            _pv_main_fps = self._get_video_framerate(main_file) or 30.0
            _drop_ci = set()
            for _ci, _ch in enumerate(_pip_chains):
                # 预览口径：链尺寸/帧率对齐本图的底（_main_w/_main_h 已含 pad/画布处理）
                _ch["size"] = (_main_w, _main_h)
                _ch["fps"] = _pv_main_fps
                _mem_bm = _ch["members"]
                _ok_chain = True
                if _mem_bm[0] < 0:
                    # 主视频成员：图层 = split 出的「未延长」副本 + 归一（与正式命令
                    # 阶段 A2 同口径：setpts 归零 → trim=主时长 → fps/SAR/yuva420p）。
                    # xfade 期间子段透明画布与主画面混色 → 转场主画面参与混合。
                    _len0 = float(_ch["lens"][-1])
                    fg.raw(
                        f"[{_pv_main_chain_raw}]setpts=PTS-STARTPTS,"
                        f"trim=0:{_len0:.6g},fps={_pv_main_fps:.6g},"
                        f"setsar=1,format=yuva420p[pmx{_ci}]")
                    _chain_member_lbl[-1] = f"pmx{_ci}"
                for _m in _mem_bm:
                    if _m < 0:
                        continue
                    _Lm = _pv_build_layer(_m, sub_videos[_m],
                                          win_override=(0.0, _ch["lens"][_m]))
                    if _Lm is None:
                        _ok_chain = False
                        break
                    _len_m = float(_ch["lens"][_m])
                    if _Lm["wp_sc"]:
                        # sendcmd 模式：位置由命令文件驱动（旋转偏移已折进命令值），x/y 只作首帧占位
                        _x_cv, _y_cv = _Lm["wp_sc_x0"], _Lm["wp_sc_y0"]
                    else:
                        _x_cv, _y_cv = self._pip_overlay_xy(
                            _Lm["sfile"], _Lm["s"], _Lm["wpP"], _Lm["wp_rotP"],
                            _Lm["spin"], _Lm["rad"], _Lm["wp_zoomP"])
                    # 画布烙印（与正式命令 _build_sub_layer_node canvas= 逐字同口径）
                    fg.raw(
                        f"color=c=black@0:s={int(_main_w)}x{int(_main_h)}"
                        f":r={_pv_main_fps:.6g}:d={_len_m:.6g}"
                        + (f",sendcmd=f='{_Lm['wp_sc']}'" if _Lm["wp_sc"] else "")
                        + f"[cbase{_m}]")
                    _cv_ov = f"overlay@wps{_m}" if _Lm["wp_sc"] else "overlay"
                    # 4.3 alpha 主输入 overlay 负坐标 bug：sendcmd 模式加 format=rgb 绕开
                    _pv_brand_fix = _overlay_sc_fmt_suffix() if _Lm["wp_sc"] else ""
                    fg.raw(
                        f"[cbase{_m}][{_Lm['label']}]{_cv_ov}=x='{_x_cv}':y='{_y_cv}':shortest=1{_pv_brand_fix}[vc{_m}]")
                    # ⚠️ shortest=1 必须有：预览链成员不像正式命令那样有 win_override 终点
                    # 限长，子 movie 比 画布 d 多出的悬摆帧会喂进 xfade 链 ⇒ 下级 xfade
                    # blend 终点与本级 EOF 交界死锁 + 内存爆炸（2026-09-26，正式命令同款
                    # 注释见 _build_sub_layer_node canvas= 分支）。
                    # 转场链归一：统一帧率/SAR/像素格式（限长已由窗口 override 完成）
                    fg.raw(
                        f"[vc{_m}]fps={_pv_main_fps:.6g},setsar=1,format=yuva420p[subx{_m}]")
                    _chain_member_lbl[_m] = f"subx{_m}"
                if not _ok_chain:
                    # 成员建层失败 → 整链降级，成员回到普通叠加
                    for _m in _mem_bm:
                        if _m >= 0:
                            _chain_member_lbl.pop(_m, None)
                    if _mem_bm[0] < 0 and _chain_member_lbl.pop(-1, None) is not None:
                        # 主视频成员已产出归一段 → 悬空输出必须显式消费（防整图报错）
                        fg.raw(f"[pmx{_ci}]nullsink")
                    _drop_ci.add(_ci)
            if _drop_ci:
                _pip_chains = [_ch for _ci, _ch in enumerate(_pip_chains)
                               if _ci not in _drop_ci]
                _chain_of = {}
                for _ci, _ch in enumerate(_pip_chains):
                    for _m in _ch["members"]:
                        _chain_of[_m] = _ci
        if _pip_chains:
                # xfade 链合成（与正式命令阶段 A2 逐字同口径：offset=累计输出长−转场时长）
                for _ci, _ch in enumerate(_pip_chains):
                    _mem = _ch["members"]
                    _acc = _chain_member_lbl.get(_mem[0])
                    if _acc is None:
                        continue
                    _acc_len = float(_ch["lens"][_mem[0]])
                    for _kk in range(1, len(_mem)):
                        _mi = _mem[_kk]
                        _mlbl = _chain_member_lbl.get(_mi)
                        if _mlbl is None:
                            _acc = None
                            break
                        _tt, _dd = _ch["trans"][_kk - 1]
                        _off = max(0.0, _acc_len - _dd)
                        _out_lbl = f"p_tc{_ci}_{_kk}"
                        fg.raw(
                            f"[{_acc}][{_mlbl}]xfade=transition={_tt}"
                            f":duration={_dd:.6g}:offset={_off:.6g}[{_out_lbl}]")
                        _acc = _out_lbl
                        _acc_len = _acc_len + float(_ch["lens"][_mi]) - _dd
                    if _acc is None:
                        continue
                    fg.raw(f"[{_acc}]setpts=PTS+{_ch['start']:.6g}/TB[p_tchain{_ci}]")
                    _ch["plabel"] = f"p_tchain{_ci}"
                    _ch["penable"] = f"between(t,{_ch['start']:.6g},{_ch['start'] + _acc_len:.6g})"
                    with suppress(Exception):
                        self._append_info_ui(
                            _('[预览] 子视频 {0}…{1} 已合成转场链：{2:.2f}s~{3:.2f}s（{4} 段，链内统一 {5}x{6}）').format(_mem[0] + 1, _mem[-1] + 1, _ch['start'], _ch['start'] + _acc_len, len(_mem), _ch['size'][0], _ch['size'][1]))

        # ---- 阶段 A3：分组节点合成（成员层 → overlay 成组节点 [v_grp_<g>_<k>]）----
        # 单画布方案（2026-10-17，与导出 `_build_overlay_filter_complex` 阶段 A3 逐项
        # 同口径）：组节点 = **唯一一张**包装盒尺寸的透明画布（`color=c=black@0`），
        # 按「组内主(base) 在下、其余按列表序在上」，把成员**内容腿**以**包装盒内相对
        # 坐标**（`_group_box_geometry` 的 rel，`_pwf` 换算到预览帧空间）依次叠进组画布
        # —— 定位由这里的 rel overlay 承担（旧注释「成员层=画布、0:0 纯叠加」是照抄
        # 导出旧结构的历史残留，与预览自身代码不符，已废）。`eof_action` 缺省 repeat：
        # 内容腿早 EOF 冻末帧。组节点的**落位 / 旋转 / 透明度 / 轨迹缩放**在下一段统一
        # 表达。⚠️ 成员图层在这里**一次性建好**并缓存（叠加主循环对组员直接 continue，
        # 不重复建层，否则同一 `[sub<k>]` 标签会被声明两次 → ffmpeg "duplicate label"）。
        _pv_main_fps_g = self._get_video_framerate(main_file) or 25.0
        _grp_layer = {}
        # 组几何（**真输出画布**域，与导出/UI 同域）→ 预览帧空间：`_pwf<1`（管道预览对 >1280 宽
        # 的主帧降采样）时全部数值乘 f；f=1 时原样（与导出逐像素同域）。
        def _pv_grp_scale(_wh):
            _w2, _h2 = float(_wh[0]), float(_wh[1])
            if _pwf < 1.0:
                _w2, _h2 = _w2 * _pwf, _h2 * _pwf
            return (max(2, int(round(_w2))), max(2, int(round(_h2))))

        def _pv_grp_off(_xy):
            _x2, _y2 = float(_xy[0]), float(_xy[1])
            if _pwf < 1.0:
                _x2, _y2 = _x2 * _pwf, _y2 * _pwf
            return _x2, _y2

        for _g, _d in _grp_ok.items():
            _order = [_d["base"]] + [_i for _i in _d["mems"] if _i != _d["base"]]
            _d["order"] = _order
            for _i in _order:
                _grp_layer[_i] = _pv_build_layer(
                    _i, sub_videos[_i], group_base=(_i == _d["base"]), force_overlay=True)
            _geo = _d["geo"]
            _geo_pv = {"size": _pv_grp_scale(_geo["size"]),
                       "base": _pv_grp_off(_geo["base"]),
                       "rot": (_pv_grp_scale(_geo["rot"]) if _geo["rot"] else None)}
            _gw, _gh = _geo_pv["size"]
            # 画布长度 = **组窗口并集末**（与导出阶段 A3 同口径；`glen` 缺省回落组内主时段）
            _glen = float(_d.get("glen") or _d["lens"][_d["base"]])
            _acc = "v_gbase_%s" % _g
            fg.raw("color=c=black@0:s=%dx%d:r=%.6g:d=%.6g[%s]"
                   % (_gw, _gh, _pv_main_fps_g, _glen, _acc))
            for _kk, _i in enumerate(_order):
                # 🔴 「启用叠加」关闭的成员（2026-10-17 P0-2，与导出一致）：腿位保留、
                #    永不显示（enable 恒假）。序号必须连续（组父行标签按最后一条腿推导），
                #    内容腿也必须被消费，否则 ffmpeg 报 unconnected output 使整链失败。
                if _i not in (_d.get("vis") or _d["mems"]):
                    fg.raw("[%s][%s]overlay=x='0':y='0':enable='0'[v_grp_%s_%d]"
                           % (_acc, _grp_layer[_i]["label"], _g, _kk))
                    _acc = "v_grp_%s_%d" % (_g, _kk)
                    continue
                _rx, _ry = _pv_grp_off(_geo["rel"][_d["mems"].index(_i)])
                # 🔴 成员可见时段必须钉 enable（与导出阶段 A3 逐字符同口径）：单画布方案下
                # 内容腿没有「成员画布 EOF」兜底 ⇒ 不钉就会越过自己的窗口一直显示
                # （此前预览整段缺这条，与导出不一致）。起点取成员自己的窗口起点（`wsa`）。
                _ln = float(_d["lens"][_i])
                _w0 = min(float((_d.get("wsa") or {}).get(_i, 0.0) or 0.0), _ln)
                fg.raw("[%s][%s]overlay=x='%g':y='%g':enable='between(t,%.6g,%.6g)'"
                       "[v_grp_%s_%d]"
                       % (_acc, _grp_layer[_i]["label"], _rx, _ry, _w0, _ln, _g, _kk))
                _acc = "v_grp_%s_%d" % (_g, _kk)
            _d["node"] = _acc
            # ---- 组节点的变换 + 落位（与导出阶段 B 的组分支逐项同口径）----
            # 组内主的旋转 / 轨迹缩放 / 透明度在**组节点**上表达 ⇒ 作用于整组（阶段 A3 的
            # 内容腿已按 group_base=True 跳过这些段）。
            _bsv = sub_videos[_d["base"]]
            _Lb = _grp_layer[_d["base"]]
            _bmeta = {"wp_res": _Lb["wpP"], "wp_rot": _Lb["wp_rotP"], "spin_on": _Lb["spin"],
                      "ra": _Lb["rad"], "wp_zoom": _Lb["wp_zoomP"]}
            _sess = _bsv.enc_settings or {}
            # 组级静态角度 `grp_rot_angle`（存在组内主，与 grp_dx/grp_dy 同族）：父行 = 独立素材
            # ⇒ 旋转作用于**整组**、且**不写成员自己的 rotate_angle**（否则成员各自再转一次）。
            _gra = _opt_float(_sess.get("grp_rot_angle", 0) or 0, 0.0)
            _gs = _sess
            if _gra:
                _gs = dict(_sess)
                _gs["rotate_angle"] = _gra
                _bmeta = dict(_bmeta)
                _bmeta["ra"] = _gra
            # 组级落位数值（grp_dx/grp_dy 增量 / grp_abs_x/y 绝对）与**组内主 overlay_x/y
            # （= 组的基准落位）都是**真画布像素** ⇒ `_pwf<1`（管道工作分辨率上限）时换算到
            # 预览帧空间（含画布/子尺寸变量的表达式由 ffmpeg 在图内按当前帧求值 → 原样保留）。
            # 漏缩 overlay_x/y 会令整组在缩小后的画布里偏右下（用户实测「管道模式无角度也下偏」）。
            # ⚠️ 传给 `_group_node_xy` 的必须是**未注入 rotate_angle** 的 base 设置（`_sess_pv`），
            # 与导出 `_build_overlay_filter_complex` 同口径（导出传 `sub_settings` 原样、旋转只走
            # `meta["ra"]`）—— 注入 rotate_angle 会让 `_overlay_content_size` 误按成员内容盒算，
            # 与组盒尺寸（shift_content_wh=geo["size"]）口径打架。
            _sess_pv = _sess
            if _pwf < 1.0:
                _sess_pv = dict(_sess)
                for _gk in ("grp_dx", "grp_dy", "grp_abs_x", "grp_abs_y",
                            "overlay_x", "overlay_y"):
                    _gv2 = _sess.get(_gk)
                    if _gv2 not in (None, ""):
                        with suppress(Exception):
                            _sess_pv[_gk] = _pipe_scale_abs_coord(_gv2, _pwf)
            # 组父行缩放（独立素材 scale）⇒ 旋转中心对齐两端须用缩放后尺寸（否则「缩放 +
            # 旋转」整组上偏，用户实测）。先按**未缩放** geo 求用户缩放尺寸，再套 `_pwf` 换算
            # 到预览帧空间（与 _geo_pv 同域）。未缩放 → None 走旧口径。
            _gkey = self._group_final_label_key(_g, len(_d["mems"]))
            # 🔴 2026-10-16 第七轮②：**父行素材项的列表轨迹** —— 与导出同口径（唯一出处
            #    `_group_material_wp_res`；预览必须与转换一致，否则「预览对、导出错」）。
            #    ⚠️ 航点坐标要按 `_pwf` 换算到**预览帧空间**（与 `_sess_pv` 的 overlay_x/y
            #      同一把尺子）：复用 `_pipe_scale_pos_settings`（含 move_waypoints[].xa/ya/
            #      xb/yb），否则缩小画布里整条轨迹偏右下（与 2026-10-08 那个老 bug 同源）。
            _mwp = None
            if _gkey:
                with suppress(Exception):
                    _ts0_m, _sp0_m = _trim_speed_from_settings(_ms)
                    _mwp = self._group_material_wp_res(
                        _gkey, _geo_pv["size"][0], _geo_pv["size"][1],
                        trim_start=_ts0_m, speed_factor=_sp0_m,
                        item=_pipe_scale_pos_settings(
                            self._group_material_item(_gkey), _pwf))
            if _mwp is not None:
                _bmeta = dict(_bmeta)
                _bmeta["wp_res"] = _mwp
                _bmeta["wp_rot"] = _mwp[2] is not None
                _bmeta["wp_zoom"] = _mwp[3] is not None
                # 🔴 2026-10-17（P1-2，与导出阶段 B 同一条投影注入）：父行列表轨迹里画的角度，
                #   `overlay_rotation_active` 的「列表轨迹」分支被 `move_mode=="waypoints"`
                #   门禁卡住，而父行轨迹住在**父行素材项**（node_fx 投影）、不在 `sub_settings`
                #   ⇒ 那个门对父行恒 False ⇒ 航点 ra/rb 在预览里不转（成片转）＝预览导出不一致。
                #   只补进 `_gs`（喂 `_group_node_transform_parts` 的副本）；`_group_node_xy`
                #   仍吃 `_sess_pv`，不会让组内主自己被当成"有轨迹"二次算一遍。
                _gs = dict(_gs or {})
                _gs["move_mode"] = "waypoints"
            # 🔴 2026-10-18（用户第 3 条，与导出阶段 B **逐项同口径**）：父行的**自旋转 /
            #    预制轨迹** —— 此前没有任何消费端（存进 node_fx[key][0] 但渲染不认）。
            #    · 预制轨迹 ⇒ 注入 `_gs` + `_group_node_xy(row_settings=…)`（幅度按包装盒）；
            #      组内主的列表轨迹整体让位；
            #    · 自旋转   ⇒ `_bmeta["spin_on"]=True` + `_gs` 的 spin_speed，航点角度让位。
            #    预览必须与成片同口径，否则「预览动、导出不动」或反向。
            #    ⚠️ 预览帧空间：move_cycle/dwell 是秒、spin_speed 是角度、move_margin 默认
            #      是 `W*0.03` 表达式 ⇒ 都不含绝对像素，无需 `_pwf` 换算。
            _row_fx = self._group_material_row_proj(_gkey)
            if _row_fx:
                _gs = dict(_gs or {})
                _gs.update(_row_fx)
                _bmeta = dict(_bmeta)
                if _row_fx.get("spin_enabled"):
                    _bmeta["spin_on"] = True
                    _bmeta["wp_rot"] = False
                if _row_fx.get("move_mode"):
                    # 与导出阶段 B **同一条**让位语义（见那边注释）：父行预制轨迹存在 ⇒
                    # 组内主列表轨迹整体让位（含 wp_rot/wp_zoom），且 `_mwp` 清空让
                    # `wp_move` 回落 False（恢复盒原点 base 修正）。预览/成片必须一致。
                    _mwp = None
                    _bmeta["wp_res"] = None
                    _bmeta["wp_rot"] = False
                    _bmeta["wp_zoom"] = False
            _user_scaled = self._group_material_scaled_size(_geo["size"], _gkey)
            _pv_scaled = (_pv_grp_scale(_user_scaled) if _user_scaled is not None else None)
            _gx, _gy = self._group_place_xy(
                _sess_pv,
                *self._group_node_xy(_bsv.file_path, _sess_pv, _bmeta, _geo_pv,
                                     grp_scaled_size=_pv_scaled,
                                     wp_move=(_mwp is not None),
                                     row_settings=_row_fx))
            _ax, _ay = self._group_place_abs(_sess_pv)
            if _mwp is not None:
                # 列表轨迹 = 逐帧落位 ⇒ 静态绝对落位不参与（与导出同一条判据；两套相加必漂移）
                _ax = _ay = None
            # 数字按 `%g` 出串（否则 7.0 写成 "7.0"，与用户手填的 "7" 不同形）
            if _ax is not None:
                _gx = ("%g" % _ax) if isinstance(_ax, float) else _ax
            if _ay is not None:
                _gy = ("%g" % _ay) if isinstance(_ay, float) else _ay
            _d["gs"], _d["bmeta"], _d["gxy"] = _gs, _bmeta, (_gx, _gy)

        # ---- 子视频叠加（栈序=列表序）：链在首成员位置整链叠入 ----
        for _k, _sv in enumerate(sub_videos):
            if _k in _grp_of:
                # 组成员：只由「组内主(base)」代表整组叠加**一次**；其余组员已在阶段 A3 被
                # 组节点消费 ⇒ 不单独叠加（与导出阶段 B 同口径）。
                _d = _grp_ok[_grp_of[_k]]
                if _k != _d["base"]:
                    continue
                _gparts, _glbl = self._group_node_transform_parts(
                    _grp_of[_k], _d["node"], _d["gs"], _d["bmeta"])
                for _gp in _gparts:
                    fg.raw(_gp)
                _gx, _gy = _d["gxy"]
                # enable：**组窗口 = 成员窗口并集**（与导出阶段 B 组分支同口径，唯一出处
                # `_group_overlay_enable`）。组内主时段只决定"组从哪开始出现"；并集更长时
                # 结束推到并集末，否则组员被组内主提前砍掉（预览与成片会不一致）。
                # 🔴 2026-10-18 审计：父行「显示时段」也接进来了（`row_item`）—— 父行填了
                #    show_* 就覆盖并集。⚠️ `_gkey` 在上一个循环里是**最后一个组**的局部值，
                #    不能复用 —— 这里按当前 `_k` 所属组重算（纯 gid 派生，不触发构图）。
                _kkey = self._group_final_label_key(_grp_of[_k], len(_d["mems"]))
                _gen = self._group_overlay_enable(
                    _sv.enc_settings, self._get_media_duration(_sv.file_path),
                    (_d["wsa"].get(_d["base"], 0.0), _d["lens"][_d["base"]]),
                    (_d.get("us", 0.0), _d.get("glen")),
                    row_item=self._group_material_item(_kkey))
                # 🔴 2026-10-18 审计（与导出阶段 B 同口径）：父行「启用叠加」关闭 ⇒ enable='0'。
                if not self._group_material_overlay_on(_kkey):
                    _gen = "0"
                # ⚠️ `cur` 本身已带方括号（"[v0]" / "[v_main_pad]"）—— 不能再包一层，
                #    否则拼出 `[[v0]]` 双括号（ffmpeg 直接 "Invalid argument"）。
                fg.raw("%s[%s]overlay=x='%s':y='%s':enable='%s':eof_action=pass[v_out_%d]"
                       % (cur, _glbl, _gx, _gy, _gen, _k))
                cur = "[v_out_%d]" % _k
                continue
            if _k in _chain_member_lbl:
                _ci = _chain_of[_k]
                _ch = _pip_chains[_ci]
                # 链首为主视频(-1)时，由链内第一个真实成员代表整条链做叠加（与正式命令阶段 B 一致）
                _m0 = _ch["members"][0]
                _first_real = _m0 if _m0 >= 0 else _ch["members"][1]
                if _k == _first_real and _ch.get("plabel"):
                    fg.raw(
                        f"{cur}[{_ch['plabel']}]overlay=x='0':y='0':"
                        f"enable='{_ch['penable']}':eof_action=pass[v_pchain{_ci}]")
                    cur = f"[v_pchain{_ci}]"
                continue
            _L = _pv_build_layer(_k, _sv)
            if _L is None:
                continue
            _s, _sfile = _L["s"], _L["sfile"]
            _rw, _rh = _L["rw"], _L["rh"]
            _s_pos = _L["s_pos"]
            _wpP, _wp_rotP, _wp_zoomP = _L["wpP"], _L["wp_rotP"], _L["wp_zoomP"]
            # 位置：move 轨迹或数值化基准
            _mv = (_s.get("move_mode", "") or "").strip()
            _x_raw = str(_s_pos.get("overlay_x", DEFAULT_OVERLAY_X) or DEFAULT_OVERLAY_X)
            _y_raw = str(_s_pos.get("overlay_y", DEFAULT_OVERLAY_Y) or DEFAULT_OVERLAY_Y)
            # 定位语义（2026-08-25 理顺）：overlay_x/y 的 w/h = 内容盒（_rw/_rh）；旋转时
            # 叠加盒 d×d 中心与内容盒中心对齐 → 位置减 (d-w)/2（与正式命令/转换页预览一致）。
            _rot_pv = overlay_rotation_active(_s, wp_rot=_wp_rotP)
            if _rot_pv:
                _eval_d = int(round(((_rw * _rw + _rh * _rh) ** 0.5)))
                _offPx, _offPy = _content_box_shift(_rw, _rh, _eval_d, _eval_d)
            else:
                _offPx = _offPy = 0.0
            _ctx = {"W": _main_w, "H": _main_h, "w": _rw, "h": _rh}
            # 基准数值位置（blend 静态分支/动态分支的静态轴都要用，必须不受 _mv 表达式影响）
            try:
                _bxv = int(round(float(safe_eval_expr(
                    _content_box_expr(_x_raw, _rw, _rh), _ctx))))
            except (ValueError, TypeError):
                _bxv = _main_w - _rw - 10
            try:
                _byv = int(round(float(safe_eval_expr(
                    _content_box_expr(_y_raw, _rw, _rh), _ctx))))
            except (ValueError, TypeError):
                _byv = _main_h - _rh - 10
            _wp_sc_on = bool(_L.get("wp_sc"))
            if _wp_sc_on:
                # sendcmd 模式：位置由命令文件驱动（旋转偏移已折进命令值），x/y 只作首帧占位
                _x, _y = _L["wp_sc_x0"], _L["wp_sc_y0"]
            elif _mv == "waypoints":
                # 列表轨迹：画布绝对像素（数字），直接使用；无效时回退基准数值位置
                if _wpP is not None and _wpP[0] is not None:
                    _x, _y = _wpP[0], _wpP[1]
                else:
                    _x, _y = str(_bxv), str(_byv)
            elif _mv:
                # 轨迹范围/基准按内容盒（sw/sh=内容盒数字，x0/y0 的 w/h 内容盒化）
                _mx, _my = build_move_xy_expr(
                    _mv, _content_box_expr(_x_raw, _rw, _rh),
                    _content_box_expr(_y_raw, _rw, _rh),
                    _s_pos, sw=str(_rw), sh=str(_rh))
                if _mx is not None:
                    # 预览 overlay 约定用 main_w/main_h（ffmpeg overlay 合法变量，与正式命令 W/H 等价）
                    _x = _mx.replace("W", "main_w").replace("H", "main_h")
                    _y = _my.replace("W", "main_w").replace("H", "main_h")
                else:
                    _x, _y = str(_bxv), str(_byv)
            else:
                _x, _y = str(_bxv), str(_byv)
            if _rot_pv and not _wp_sc_on:
                if _wp_zoomP:
                    # 轨迹缩放把叠加盒整体放大 z(t) 倍 → 中心对齐偏移同乘 z(t)
                    _x = f"({_x}) - ({_wpP[3]})*{_offPx:.6g}"
                    _y = f"({_y}) - ({_wpP[3]})*{_offPy:.6g}"
                else:
                    _x = f"({_x}) - {_offPx:.6g}"
                    _y = f"({_y}) - {_offPy:.6g}"
            # enable：显示时段/循环控制（起始/结束/周期/单次）优先，同正式命令 _calc_enable_expr；
            # 未设显示控制时用主视频时长上限 + eof_action=pass（防 movie 音频截断），拿不到才 shortest 兜底
            try:
                # 帧对齐（floor）：enable 窗口与图层供帧同源（与正式命令一致）
                _s_dur = self._get_media_duration(
                    _sfile, frame_align_fps=self._get_video_framerate(_sfile))
            except Exception:
                _s_dur = None
            _ov_expr = self._calc_enable_expr(_s, _s_dur)
            if _ov_expr == "1" and _main_limit and _main_limit > 0:
                # 真时间轴延长后，无界子视频要显示到时间轴总长（不再是主视频时长）。
                # ⚠️ 必须取 max：图片主视频时 _pv_main_eff/_pv_total 来自 _pip_main_effective_duration，
                # 它对静态图取到的是 JPEG 容器的 format duration(0.04s) 而非「图片显示时长」⇒ 直接用
                # _pv_total 会写成 enable='lt(t,0.04)'，子视频只出 1 帧就消失（2026-10-11 修 9db53ac 回归）。
                # 未延长时 = _main_limit，与最后正常版 7dce915 一致。
                _ov_limit = _main_limit
                if ((not pipe_engine) or _pv_out_mode) and _pv_total and _pv_total > _ov_limit:
                    _ov_limit = _pv_total
                _ov_expr = f"lt(t,{_ffsec(_ov_limit)})"
            # blend 混合模式（区域隔离 + RGBA 剥离，与正式命令 _build_overlay_filter_complex 共用 _make_blend_region）
            _blend_mode = (str(_s.get('blend_mode', 'normal') or 'normal')).strip().lower()
            if _blend_mode != 'normal':
                # 降级判定（用户拍板 2026-08-25）：pad 画布大于主视频渲染尺寸 → blend
                # 窗口进入黑边区即脱离主视频像素、与黑混合无意义 → 强制普通叠加
                _dgp = self._blend_downgrade_pad(_ms, main_file)
                if _dgp:
                    self._append_info_ui(
                        _('[混合模式] pad 画布 {0}x{1} 大于主视频渲染尺寸，blend({2}) 已降级为普通叠加（脱离主视频像素的混合无意义）').format(_dgp[0], _dgp[1], _blend_mode))
                    _blend_mode = 'normal'
            if _blend_mode != 'normal':
                # 自旋转/静态角度时子视频链输出为 hypot 正方形画布 → blend 区域必须用对角线
                # 边长 d 扩大（否则旋转甩出的部分被原始矩形切掉，需求2）。非旋转用原始渲染尺寸。
                _rotated = overlay_rotation_active(_s, wp_rot=_wp_rotP)
                _bw_src, _bh_src = _blend_region_size(_rw, _rh, _rotated)
                if _mv:
                    # 动态轨迹 blend：h/v/diamond/corners + 列表轨迹(waypoints) 全部支持
                    # （crop 的 x/y 表达式支持逗号函数与状态变量 → 双轴表达式均可动态跟随）。
                    # 旧模型用 crop 从主视频裁动态窗口再 blend，而 crop 的 w/h 只在 init 求值
                    # 一次 ⇒ 窗口尺寸无法逐帧跟随缩放 z(t)（列表轨迹缩放必崩）。新模型（方案 A）：
                    # 包围盒静态（覆盖轨迹全程扫掠），动的是「落位 overlay」（place_x/y 相对
                    # 包围盒原点），缩放/旋转/轨迹随便动；隔离由透明画布 α 自动锁死（Cairo
                    # bounded blend 语义）。详见 research/blend-isolation/README.md。
                    _bw, _bh = _bw_src, _bh_src
                    # ⚠️ 盒尺寸**不 clamp 到画布、不偶数化**（2026-10-08 修正）：与正式命令同口径
                    # （_overlay_sub_size → sw/sh）。越界裁剪与偶数对齐由下游统一收尾
                    # （_blend_region_bbox / _blend_static_geometry 都自带「夹进画布 + 只缩不增」）
                    # —— 它们只属于 **crop 区域**；而这里先 clamp 会连**中心对齐偏移 (d-w)/2**
                    # 一起算小：d > 画布时预览区域比成片小、落位整体偏下（用户实测 +8px）。
                    # 定位语义：轨迹范围/基准按内容盒（x0/y0 的 w/h 内容盒化，sw/sh=内容盒），
                    # 区域位置 = 内容盒位置 - 中心对齐偏移，再 clamp 到画布内（crop 不越界）。
                    _ms3 = dict(_s_pos)
                    _ms3["overlay_x"] = _content_box_expr(
                        _ms3.get("overlay_x", DEFAULT_OVERLAY_X), _rw, _rh)
                    _ms3["overlay_y"] = _content_box_expr(
                        _ms3.get("overlay_y", DEFAULT_OVERLAY_Y), _rw, _rh)
                    if _mv == "waypoints":
                        # 列表轨迹：x/y 为画布绝对像素（数字）表达式，直接作动态区域位置
                        # （与画中画实时预览普通叠加的 waypoints 分支同源；旋转中心偏移由下方
                        # _content_box_shift 统一处理，zoom 跟随在下方随 z(t) 缩放）。
                        if _wpP is not None and _wpP[0] is not None:
                            _dx, _dy = _wpP[0], _wpP[1]
                        else:
                            _dx, _dy = _blend_move_exprs(_mv, _ms3, _rw, _rh)
                    else:
                        _dx, _dy = _blend_move_exprs(_mv, _ms3, _rw, _rh)
                    # ---- 包围盒模型（方案 A）：bbox 静态，落位 overlay 动态 ----
                    _blend_scP = None
                    _pl_nameP = None
                    _bx0P = _by0P = "0"
                    _bboxP = None
                    if _dx is not None:
                        # 1) 静态包围盒：waypoints 走 _blend_wp_bbox；表达式轨迹走
                        #    _blend_move_envelope + _blend_region_bbox。
                        if _mv == "waypoints":
                            _offP2s, _offP3s = _content_box_shift(_rw, _rh, _bw, _bh)
                            _bboxP = _blend_wp_bbox(_main_w, _main_h, _bw, _bh,
                                                   _s.get("move_waypoints"),
                                                   _offP2s, _offP3s)
                        else:
                            _ctx3 = {"W": _main_w, "H": _main_h, "w": _rw, "h": _rh}
                            _bxb3 = safe_eval_expr(_content_box_expr(
                                str(_s.get("overlay_x", DEFAULT_OVERLAY_X)), _rw, _rh), _ctx3)
                            _byb3 = safe_eval_expr(_content_box_expr(
                                str(_s.get("overlay_y", DEFAULT_OVERLAY_Y)), _rw, _rh), _ctx3)
                            _bxb3 = int(round(float(_bxb3))) if _bxb3 is not None else 0
                            _byb3 = int(round(float(_byb3))) if _byb3 is not None else 0
                            if _rotated:
                                _offP2r, _offP3r = _content_box_shift(_rw, _rh, _bw, _bh)
                                _bxb3 -= int(round(_offP2r)); _byb3 -= int(round(_offP3r))
                            _bboxP = _blend_region_bbox(
                                _blend_move_envelope(_mv, _main_w, _main_h, _bw, _bh,
                                                     _bxb3, _byb3), _main_w, _main_h)
                        if _bboxP is not None:
                            _bxP, _byP, _bbwP, _bbhP = _bboxP
                            # 2) 落位坐标（相对包围盒原点）：内容盒左上（画布绝对） - 包围盒原点。
                            #    waypoints 的 xa/ya 是中心基准，需先减中心对齐偏移；表达式轨迹
                            #    _blend_move_exprs 直接给左上基准，无需再减。
                            _pxP, _pyP = _dx, _dy
                            if _mv == "waypoints":
                                # 中心对齐偏移随 z(t) 同乘（_blend_place_off_exprs）
                                _sxPe, _syPe = _blend_place_off_exprs(
                                    _rw, _rh, _bw, _bh, _wpP)
                                _pxP = f"({_pxP}) {_sxPe}"
                                _pyP = f"({_pyP}) {_syPe}"
                            _place_xP = f"({_pxP}) - {_bxP}"
                            _place_yP = f"({_pyP}) - {_byP}"
                        else:
                            _dx = _dy = None
                    # blend 区域 sendcmd 驱动（长列表突破表达式段数墙）：列表 > 阈值时位置改用
                    # 命令文件驱动「落位 overlay 单节点」（新模型包围盒静态、只有落位 overlay
                    # 要跟随，故 targets 仅 overlay@pl{_k}；后缀在中心对齐偏移之上再减包围盒
                    # 原点 bx/by，把画布绝对位置换算成相对包围盒原点的落位坐标）。base 用首区间常量。
                    # blend 落位 sendcmd（2026-10-08）：解耦非 blend 的 _L["wp_sc"]（旧 gate
                    # 耦合导致「位置恒定、仅 zoom 变」时退回 inline）；直接合并 position+zoom 区间，
                    # zoom 折进区间值，filtergraph 不再含 max(0.01,Z(t))。
                    _blend_ivP = None
                    if (_mv == "waypoints" and _bboxP is not None
                            and len([w for w in (_s_pos.get("move_waypoints") or [])
                                     if isinstance(w, dict)]) > _wp_sc_rows_limit()):
                        _offxP2, _offyP2 = _content_box_shift(_rw, _rh, _bw, _bh)
                        # 本地计算 trim（不依赖外层 _ts0/_sp0：它只在上面 `if _mv=="waypoints"`
                        # 且需要 build_waypoint_expr 的分支里绑定（51738），而本 gate 已解耦，
                        # 「位置恒定、仅 zoom 变」时那个分支的绑定不一定发生 ⇒ NameError）。
                        try:
                            _ts0P, _sp0P = _trim_speed_from_settings(_ms)
                        except Exception:
                            _ts0P, _sp0P = 0.0, 1.0
                        _blend_ivP = build_waypoint_placement_intervals(
                            _s_pos.get("move_waypoints"), _offxP2, _offyP2, _bxP, _byP,
                            trim_start=_ts0P, speed_factor=_sp0P)
                        if _blend_ivP is not None:
                            _pl_nameP = f"pl{_k}"
                            _blend_scP = self._write_waypoint_sendcmd_file(
                                _blend_ivP, tag=f"blendP{_k}", targets=[f"overlay@{_pl_nameP}"])
                            if _blend_scP is not None:
                                if _blend_ivP[0][2] == "hide":
                                    _bx0P = _by0P = "-100000"
                                else:
                                    # 首帧基值 = 合并区间首段端点值（已含 zoom*off - bx）
                                    _bx0P = f"{_blend_ivP[0][3]:g}"
                                    _by0P = f"{_blend_ivP[0][4]:g}"
                    if _dx is not None:
                        # 动态轨迹 blend：落位 overlay 跟随动效表达式 / sendcmd
                        if _blend_scP is not None:
                            # sendcmd 驱动落位：base 用首区间常量（sendcmd 覆盖其余帧）
                            _place_xP = f"{_bx0P}"
                            _place_yP = f"{_by0P}"
                        # 区域隔离（需求3）：≥2 blend 时主区域从 split 出的原始帧 cur_base 取，
                        # 否则单 blend 把 cur 自己 split 出「区域来源/合成目标」两个副本避免双消费
                        if _regional:
                            _crl, _ovl = f"cur_base{_bj}", cur
                        else:
                            fg.raw(f"{cur}split=2[cur_cr{_k}][cur_ov{_k}]")
                            _crl, _ovl = f"cur_cr{_k}", f"cur_ov{_k}"
                        fg.extend(self._make_blend_region(
                            _crl, f"subr{_k}", _ovl, _bxP, _byP, _bbwP, _bbhP,
                            _place_xP, _place_yP, _blend_mode, f"v_sub{_k}", str(_k),
                            ":eof_action=pass", place_name=_pl_nameP, sc_file=_blend_scP,
                            # ⚠️ 带逐帧缩放时必须前置 format=rgba（见 _make_blend_region 第3步铁律）
                            slr_scale_before=bool(_wpP is not None and _wpP[3] is not None)))
                        cur = f"[v_sub{_k}]"
                        _bj += 1
                    else:
                        # mode 未知（理论不发生）→ 兜底静态基准位置 blend
                        self._append_info_ui(
                            _('[预览] 子视频 {0} 混合模式+轨迹控制：轨迹模式不支持，已按基准位置 blend').format(_k + 1))
                        _bbx, _bby, _bbw, _bbh, _bsx, _bsy = self._blend_static_geometry(
                            int(_bxv - _offPx), int(_byv - _offPy), _bw_src, _bh_src, _main_w, _main_h)
                        if _bbw >= 2 and _bbh >= 2:
                            if _regional:
                                _crl, _ovl = f"cur_base{_bj}", cur
                            else:
                                fg.raw(f"{cur}split=2[cur_cr{_k}][cur_ov{_k}]")
                                _crl, _ovl = f"cur_cr{_k}", f"cur_ov{_k}"
                            fg.extend(self._make_blend_region(
                                _crl, f"subr{_k}", _ovl, str(_bbx), str(_bby), _bbw, _bbh,
                                str(_bsx), str(_bsy), _blend_mode, f"v_sub{_k}", str(_k),
                                ":eof_action=pass"))
                            cur = f"[v_sub{_k}]"
                            _bj += 1
                        else:
                            fg.raw(f"{cur}null{cur}")
                else:
                    # 静态位置 blend：基准数值位置（内容盒语义 + 旋转中心偏移）+ 区域隔离
                    # （区域隔离 split 见循环前，需求3）
                    _bbx, _bby, _bbw, _bbh, _bsx, _bsy = self._blend_static_geometry(
                        int(_bxv - _offPx), int(_byv - _offPy), _bw_src, _bh_src, _main_w, _main_h)
                    if _bbw >= 2 and _bbh >= 2:
                        if _regional:
                            _crl, _ovl = f"cur_base{_bj}", cur
                        else:
                            fg.raw(f"{cur}split=2[cur_cr{_k}][cur_ov{_k}]")
                            _crl, _ovl = f"cur_cr{_k}", f"cur_ov{_k}"
                        fg.extend(self._make_blend_region(
                            _crl, f"subr{_k}", _ovl, str(_bbx), str(_bby), _bbw, _bbh,
                            str(_bsx), str(_bsy), _blend_mode, f"v_sub{_k}", str(_k),
                            ":eof_action=pass"))
                        cur = f"[v_sub{_k}]"
                        _bj += 1
                    else:
                        # 子视频完全在画布外，跳过混合（保持主画面）
                        fg.raw(f"{cur}null{cur}")
            else:
                # sendcmd 必须挂 overlay 的【主输入支链】+ overlay 完整别名
                # （与正式命令 29129 同款：挂副链会「跑在主流前面」→ 命令提前生效错位）
                if _wp_sc_on:
                    fg.raw(f"{cur}sendcmd=f='{_L['wp_sc']}'[v_wsm{_k}]")
                    _pv_ovm = f"[v_wsm{_k}]"
                    _pv_ovn = f"overlay@wps{_k}"
                else:
                    _pv_ovm = cur
                    _pv_ovn = "overlay"
                if _ov_expr != "1":
                    fg.raw(f"{_pv_ovm}[subr{_k}]{_pv_ovn}=x='{_x}':y='{_y}':"
                                 f"enable='{_ov_expr}':eof_action=pass[v_sub{_k}]")
                else:
                    fg.raw(f"{_pv_ovm}[subr{_k}]{_pv_ovn}=x='{_x}':y='{_y}':enable='1':shortest=1[v_sub{_k}]")
                cur = f"[v_sub{_k}]"

        # ---- 封装页独立文字水印（self._merge_tw，与正式命令 _build_pip_cmd 一致）----
        # 实时预览不经过 merge_build_cmd_list，这里补写一次主轨 enc_settings 再取片段
        self._apply_merge_text_watermark([main_video])
        _tw_pip = main_video.enc_settings.get("text_watermark", {})
        # #5：宿主声明目标是文字水印时，把弹窗里未提交的航点注入**构建用的副本**
        # （主轨 enc_settings 是真身，绝不能被未提交数据污染）—— 见 _tw_inject_live_wp。
        _tw_in = _tw_inject_live_wp(main_video.enc_settings, _wt, _lw)
        _tw_frag = build_text_watermark_chain(_tw_in, main_label=cur, out_label="[v_tw]")
        if _tw_frag:
            # 旋转子图含 color 无限源：eof_action=pass 主视频结束即停（与转换页预览一致）
            _tw_frag = _tw_frag.replace(":format=auto", ":format=auto:eof_action=pass")
            fg.raw(_tw_frag)
            cur = "[v_tw]"
            self._append_info_ui(_("[预览] 画中画实时预览：已叠加文字水印"))

        # ---- 末端处理（2026-08-27 预览接入）：split 网格（尽力支持，mpv lavfi 支持 hstack/vstack）
        #      + 边框 pad（链尾最外层，包住网格/叠加产物）。concat 预览不支持（需额外输入流）。 ----
        _pip_eh = self._merge_end_handling
        # ⚠️ 2026-10-06 边框随预览缩放等比缩小（与转换页 _preview_with_settings 同款处理）：
        #   pad 是绝对像素且加在降采样之后，而本图已按 _pwf（工作分辨率上限）缩小了主画面
        #   ⇒ 同一个 12px 边框相对变粗、成片却是细的。口径 = 成片：边框 × _pwf。
        #   外部播放器路线（mpv/ffplay）不经 _pwf（f=1，GPU 跑全分辨率）⇒ 零变化。
        _pip_eh = scale_preview_border_px(self._merge_end_handling, float(_pwf))
        _pip_split = bool(_pip_eh.get("split_enabled", False))
        try:
            _pip_rows = max(1, int(_pip_eh.get("split_rows", 1) or 1))
            _pip_cols = max(1, int(_pip_eh.get("split_cols", 1) or 1))
        except (ValueError, TypeError):
            _pip_rows, _pip_cols = 1, 1
        _pip_n = _pip_rows * _pip_cols
        _pip_split_ok = _pip_split and (2 <= _pip_n <= 5)
        _bp_pip = build_preview_border_frag(_pip_eh)
        # 边框位置（2026-08-27）：True=split 之后（网格外框）；False=split 之前（每格带框）
        _bp_pip_before = bool(_bp_pip) and _pip_split_ok and (not bool(_pip_eh.get("border_after_split", True)))

        def _pip_split_parts(_in_label, _out_label, _border=None):
            """实时预览 split 网格段（与正式命令 build_end_split_filters 同逻辑，标签 vsp/vsr 防冲突）。
            _border：间隙模型边框配置 dict → split 之后逐格非对称 pad 再拼网格（外围独占、内缝各半）。"""
            _labels = [f"[vsp{i}]" for i in range(_pip_n)]
            _sp = [f"{_in_label}split={_pip_n}{''.join(_labels)}"]
            _stack = _labels
            if _border:
                _plan, _gx, _gy = build_split_gap_pad_plan(
                    _pip_rows, _pip_cols,
                    _border.get("left", 0), _border.get("right", 0),
                    _border.get("top", 0), _border.get("bottom", 0))
                _bc = (_border.get("color", "") or "").strip()
                if re.fullmatch(r"#[0-9a-fA-F]{6}", _bc):
                    _bc = "0x" + _bc[1:].upper()
                _bc = _bc or "black"
                _stack = []
                for _i in range(_pip_n):
                    _l, _r, _t, _b = _plan[_i]
                    _sp.append(f"{_labels[_i]}{build_split_gap_pad_frag(_l, _r, _t, _b, _bc)}[vsbp{_i}]")
                    _stack.append(f"[vsbp{_i}]")
            if _pip_rows == 1:
                _sp.append(f"{''.join(_stack)}hstack=inputs={_pip_n}{_out_label}")
            elif _pip_cols == 1:
                _sp.append(f"{''.join(_stack)}vstack=inputs={_pip_n}{_out_label}")
            else:
                _rl = []
                for _r in range(_pip_rows):
                    _row_l = f"[vsr{_r}]"
                    _sp.append(f"{''.join(_stack[_r * _pip_cols:(_r + 1) * _pip_cols])}"
                               f"hstack=inputs={_pip_cols}{_row_l}")
                    _rl.append(_row_l)
                _sp.append(f"{''.join(_rl)}vstack=inputs={_pip_rows}{_out_label}")
            return _sp

        if _bp_pip_before:
            # before（间隙模型）：网格段内部自带逐格非对称 pad —— 不再在 split 之前统一 pad 一圈
            # （旧做法会让格间边框背靠背 = 外围 2 倍）。收尾 trim/null 仍照常。
            if _main_end_dur and _main_end_dur > 0:
                fg.raw(f"{cur}trim=0:{_ffsec(_main_end_dur)},setpts=PTS-STARTPTS[v_bp]")
            else:
                fg.raw(f"{cur}null[v_bp]")
            cur = "[v_bp]"
            fg.extend(_pip_split_parts(cur, "[v_po2]", build_split_border_cfg(_pip_eh)))
            cur = "[v_po2]"
            self._append_info_ui(_('[预览] 实时预览：多画面拼接 {0}x{1}（等宽边框）').format(_pip_rows, _pip_cols))
            fg.raw(f"{cur}null[vo]")
        else:
            if _pip_split_ok:
                fg.extend(_pip_split_parts(cur, "[v_split]"))
                cur = "[v_split]"
                self._append_info_ui(_('[预览] 实时预览：多画面拼接 {0}x{1}').format(_pip_rows, _pip_cols))
            if _bp_pip:
                _bp_tail = "," + _bp_pip
                self._append_info_ui(_("[预览] 实时预览：已叠加末端边框"))
            else:
                _bp_tail = ""

            # 结尾强制收尾：主视频启用截取（或为静态图片给默认时长）时，输出按有效结束时长精确截止
            # （movie 子视频无限循环 + color 画布/文字水印无限源时，主视频结束不一定终止输出）。
            # 真时间轴延长（外部播放器路线）时收口到时间轴总长——底已 tpad 到该长度。
            _pv_trim_dur = None
            if _main_end_dur and _main_end_dur > 0:
                if (not pipe_engine) or _pv_out_mode:
                    # out_mode（有链）与外部播放器路线同款：底已 tpad → 收口到时间轴总长；
                    # 素材时间轴模式（无链）不延长（tpad 未应用，维持原状）。
                    _pv_trim_dur = max(_main_end_dur, _pv_total or 0.0)
                else:
                    _pv_trim_dur = _main_end_dur
            elif (not pipe_engine) and _pv_total and _pv_total > 0:
                _pv_trim_dur = _pv_total
            if _pv_trim_dur and _pv_trim_dur > 0:
                fg.raw(f"{cur}trim=0:{_ffsec(_pv_trim_dur)},setpts=PTS-STARTPTS{_bp_tail}[vo]")
            else:
                fg.raw(f"{cur}null{_bp_tail}[vo]")
        # 音频：主视频音频 passthrough；有混音/替换子声时走 amix（与正式命令 _build_pip_audio 同模型）
        _has_audio = False
        try:
            _info = self._get_cached_stream_info(main_file)
            if _info:
                _has_audio = any(x.get("codec_type") == "audio" for x in _info.get("streams", []))
        except Exception:
            _has_audio = False
        # 2026-09-25 去掉 (not pipe_engine)：混音段进图对管道视频侧零影响（drop_amovie 删净），
        # 管道 out_mode 的音频下传靠它才有混音段可抽（见上方 _pv_audio_plan 收集处注释）。
        # 2026-09-30 纳入独立音频轨混音（_pv_free_audio）：仅自由音频混音时同样进混音分支。
        _pv_mix_mode = ((bool(_pv_audio_plan) and bool(_pv_audio_src))
                        or bool(_pv_free_audio))
        # 主音频条目「忽略」→ 静音底子（volume=0 垫底，混音照常；[aid1] 仍被图引用，
        # 防 mpv 把未消费的主音轨当普通轨直通漏声；2026-09-30）
        _main_ignored = False
        try:
            _pv_main_a = next((t for t in enabled_tracks if t.type == "audio"
                               and normalize_path(t.file_path) == _main_path_n), None)
            _main_ignored = (_pv_main_a is not None
                             and self._audio_out_mode(_pv_main_a) == "ignore")
        except Exception:
            _main_ignored = False
        _pm = "volume=0," if _main_ignored else ""
        if not _pv_mix_mode:
            if _has_audio:
                if _main_trim_prefix and not pipe_engine:
                    # 【音频必须与主视频同段同归零】主视频走了 trim=start=_ssec[,end=_esec],setpts=PTS-STARTPTS，
                    # 音频若只 anull 直通 → 从素材 0 秒起播（用户实测：画面跳到 143s，音乐却从头放）。
                    # 本路径不给播放器 --start，主视频与主音频同源同时间轴 → atrim 用与 trim **完全相同**的
                    # start/end 即精确对齐；末端再按 [vo] 的 _main_end_dur 等长收尾（apad 防比画面短）。
                    # 仅在「启用主视频截取 且 非管道模式」时替换：管道模式音频段整段被
                    # _lavfi_complex_to_ffmpeg_pipe 删除、无需校准（无论无链的相对终点还是
                    # 有链 out_mode 的绝对 trim）→ 保持 anull 直通 = 与旧行为逐字节一致；
                    # 未截取同样 anull 直通。
                    _a_tr = []
                    if _ssec is not None:
                        _a_tr.append(f"start={_ssec}")
                    if _esec is not None:
                        _a_tr.append(f"end={_esec}")
                    _a_chain = f"atrim={':'.join(_a_tr)},asetpts=PTS-STARTPTS"
                    if _main_end_dur and _main_end_dur > 0:
                        _a_chain += (f",atrim=0:{_ffsec(_main_end_dur)},"
                                     f"apad=whole_dur={_main_end_dur:.3f}")
                    fg.raw(f"[aid1]{_pm}{_a_chain}[ao]")
                else:
                    fg.raw(f"[aid1]{_pm}anull[ao]")
        else:
            # 混音/替换子声预览：主声床（有界到时间轴总长）+ 各子声（aloop 镜像显示窗口 +
            # adelay 落位）逐条 amix 叠加；替换窗并集内主声静音。时间轴延长时各条一并有界，
            # 否则 amix 截断/永不结束（与正式命令同因）。
            _T = _pv_total if (_pv_total and _pv_total > 0) else (
                _main_end_dur if (_main_end_dur and _main_end_dur > 0) else _main_dur)
            # [ao] 的 0 基基准 = 主声床起点：mpv --start 后主声被 asetpts 归零到截取起点 S，
            # 子声落位要减同一基准（S=0 时与导出的绝对时间轴逐值一致）
            _s_off = _ssec if (_main_trim_prefix and _ssec is not None) else 0.0
            # 音频跟随转场：delta = 链真实位置 P_k − 显示起点 ws（每子视频独立开关）
            try:
                _pv_follow = self._pip_audio_follow_shift(
                    sub_videos, _pip_chains,
                    [(i, sv.file_path, sv.enc_settings) for i, sv in enumerate(sub_videos)],
                    main_video)
            except Exception:
                _pv_follow = {}

            def _pv_shift_of(_kx):
                try:
                    return float(_pv_follow.get(normalize_path(sub_videos[_kx].file_path), 0.0) or 0.0)
                except Exception:
                    return 0.0

            if _has_audio:
                _a_tr = []
                if _ssec is not None:
                    _a_tr.append(f"start={_ssec}")
                if _esec is not None:
                    _a_tr.append(f"end={_esec}")
                _a_chain = f"atrim={':'.join(_a_tr)},asetpts=PTS-STARTPTS" if _a_tr else "anull"
                if _T and _T > 0:
                    _a_chain += f",atrim=0:{_ffsec(_T)},apad=whole_dur={_T:.3f}"
                if _main_ignored:
                    _a_chain = f"volume=0,{_a_chain}"
                fg.raw(f"[aid1]{_a_chain}[amain_pv]")
            else:
                # 主视频无音频：静音源垫底（anullsrc 无限源 → atrim 收口）
                _an = "anullsrc=r=48000:cl=stereo"
                if _T and _T > 0:
                    _an += f",atrim=0:{_ffsec(_T)}"
                fg.raw(f"{_an}[amain_pv]")
            # 替换窗并集 → 主声一次性静音（replace 模式）
            _rep_terms = []
            for _kx, _at in sorted(_pv_audio_plan.items()):
                if _kx not in _pv_audio_src:
                    continue
                if self._pip_audio_mode(self._pip_sub_video_enc(enabled_tracks, _at)) != "replace":
                    continue
                _ws3, _we3 = self._pip_window_seconds(
                    sub_videos[_kx].enc_settings, self._pip_main_duration(main_video),
                    sub_videos[_kx].file_path, aenc=_at.enc_settings)
                _sh3 = _pv_shift_of(_kx)
                _rep_terms.append(
                    f"between(t,{_ffsec(max(0.0, _ws3 + _sh3 - _s_off))},"
                     f"{_ffsec(max(0.0, _we3 + _sh3 - _s_off))})")
            if _rep_terms:
                fg.raw(f"[amain_pv]volume=enable='{'+'.join(_rep_terms)}':volume=0[amain_pv]")
            # 子声节点：aloop 镜像视频循环决策 → atrim 窗口长 → adelay 落位 → 有界到总长
            _pv_mixed = 0
            for _kx, _at in sorted(_pv_audio_plan.items()):
                if _kx not in _pv_audio_src:
                    continue
                _venc3 = sub_videos[_kx].enc_settings
                _ap = []
                # 同导出端：注入源路径让 _audio_effective_duration 取到时长，修正 afade=t=out:st=0
                _at.enc_settings["_file_path"] = sub_videos[_kx].file_path
                _det3 = bool(_venc3.get("audio_detached", False))
                _d_off = _d_fe = 0.0
                _enc3 = _at.enc_settings
                if _det3:
                    # 原声独立（audio_detached）：位置/长度在音频轨 audio_offset /
                    # audio_free_end 上。预览图是 0 基时钟（要减主截取起点 _s_off），
                    # 与自由音频轨同法：先置空这两键，归一后手动 adelay / atrim。
                    _d_off = _opt_float(_enc3.get("audio_offset", 0) or 0, 0.0)
                    _d_fe = _opt_float(_enc3.get("audio_free_end", "") or 0, 0.0)
                    _enc3 = dict(_enc3)
                    _enc3["audio_offset"] = "0"
                    _enc3["audio_free_end"] = ""
                _afx = self._build_audio_filters(
                    _enc3, include_trim=True, include_volume=True,
                    include_speed=True, include_reverse=_at.enc_settings.get("audio_reverse", False))
                if _afx:
                    _ap.append(_afx)
                _ap.append("aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000")
                if _det3:
                    # 原声独立：只播一遍、不 aloop 铺满窗口；落位=audio_offset，长度到
                    # audio_free_end（均减 _s_off 换到预览 0 基时钟）。
                    _d_delay = max(0.0, _d_off - _s_off)
                    if _d_delay > 0:
                        _ap.append(f"adelay=delays={_d_delay * 1000:.0f}:all=1")
                    _ap.append("asetpts=PTS-STARTPTS")
                    if _d_fe > _s_off + 1e-6:
                        _ap.append(f"atrim=end={_ffsec(_d_fe - _s_off)}")
                    if _T and _T > 0:
                        _ap.append(f"atrim=0:{_ffsec(_T)}")
                    fg.raw(f"[asub{_kx}]" + ",".join(_ap) + f"[asw{_kx}]")
                    fg.raw(
                        f"[amain_pv][asw{_kx}]amix=inputs=2:duration=longest:normalize=0[amain_pv]")
                    _pv_mixed += 1
                    continue
                _sdur = 0.0
                try:
                    # 帧对齐：子声窗口与视频图层窗口同源（防音窗比画窗多 1 帧）
                    _sdur = self._get_media_duration(
                        sub_videos[_kx].file_path,
                        frame_align_fps=self._get_video_framerate(sub_videos[_kx].file_path)) or 0.0
                except Exception:
                    _sdur = 0.0
                _ws4, _we4, _bd4 = self._resolve_display_window(
                    _venc3, _sdur, input_path=sub_videos[_kx].file_path)
                if _bd4 and _we4 is not None and _we4 > _ws4 and _sdur > 0:
                    _win_ms = max(1, int(round((_we4 - _ws4) * 1000)))
                    _src_ms = max(1, int(round(_sdur * 1000)))
                    _n4 = min(64, max(1, -(-_win_ms // _src_ms)))
                    _ap.append(f"aloop=loop={_n4 - 1}:size={max(1, int(_sdur * 48000))}")
                    _ap.append(f"atrim=0:{_ffsec(_we4 - _ws4)}")
                else:
                    _ap.append("aloop=loop=-1:size=2000000000")
                _delay = max(0.0, (_ws4 or 0.0) + _pv_shift_of(_kx) - _s_off)
                if _delay > 0:
                    _ap.append(f"adelay=delays={_delay * 1000:.0f}:all=1")
                    # ⚠️ adelay 静音头 pts 为负（n9.0.1 实测，与源是 amovie 还是 [N:a] 文件
                    # 输入**无关**——早先「导出端 [N:a] 无此问题（T4 对照）」的结论是错的：
                    # 2026-09-26 用户实测导出「最后一段混进第一段、自己位置没声」，探针
                    # tests/_dbg_adelay_amix_probe.py 两链序均复现，asetpts 归零后治愈）。
                    # atrim=0:T 会整段剥掉负 pts 静音头 → 流只剩内容 → amix 逐样本叠加
                    # **不看 pts** ⇒ 声音从输出 0s 开始。PTS-STARTPTS 把静音头归到 0 起
                    # 真实帧，amix 到达顺序即时间轴顺序。导出端 _pip_sub_audio_node 同款。
                    _ap.append("asetpts=PTS-STARTPTS")
                if _T and _T > 0:
                    _ap.append(f"atrim=0:{_ffsec(_T)}")
                fg.raw(f"[asub{_kx}]" + ",".join(_ap) + f"[asw{_kx}]")
                fg.raw(
                    f"[amain_pv][asw{_kx}]amix=inputs=2:duration=longest:normalize=0[amain_pv]")
                _pv_mixed += 1
            # 独立音频轨混音（2026-09-30）：amovie 自供源，链序与导出端 _free_audio_mix_node
            # 对齐（自身滤镜→归一→adelay→asetpts→atrim 有界）。audio_offset(开始) 不能留在
            # _build_audio_filters 内：预览图是 0 基模型，落位要减主截取起点 _s_off（同子声），
            # 故复制 enc 置空该键、延迟在归一后手动 adelay。audio_free_end(结束) 同因置空——
            # 链尾 atrim 此刻还在文件 0 基时钟上（delay 尚未手动补），在 adelay+asetpts 之后
            # 按「值 − _s_off」手动 atrim=end 截（预览时钟=主显示起点，与 delay 同基准）。
            for _fn, _ft in enumerate(_pv_free_audio):
                _fenc = dict(_ft.enc_settings)
                _fenc["_file_path"] = _ft.file_path
                _foff = _opt_float(_fenc.get("audio_offset", 0) or 0, 0.0)
                _fenc["audio_offset"] = "0"
                _ffe = str(_fenc.get("audio_free_end", "") or "").strip()
                _fenc["audio_free_end"] = ""
                _fesc = self._movie_path_safe(_ft.file_path).replace("\\", "/").replace(":", "\\\\:")
                fg.raw(f"amovie={_fesc}[afsub{_fn}]")
                _fap = []
                _afx2 = self._build_audio_filters(
                    _fenc, include_trim=True, include_volume=True,
                    include_speed=True, include_reverse=_ft.enc_settings.get("audio_reverse", False))
                if _afx2:
                    _fap.append(_afx2)
                _fap.append("aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=48000")
                _fdelay = max(0.0, _foff - _s_off)
                if _fdelay > 0:
                    _fap.append(f"adelay=delays={_fdelay * 1000:.0f}:all=1")
                    # adelay 静音头 pts 为负 → asetpts 归零（与导出端/子声同款，见上方注释）
                    _fap.append("asetpts=PTS-STARTPTS")
                if _ffe:
                    _ffe_s = _opt_float(_ffe, 0.0)
                    _ffe_pv = _ffe_s - _s_off
                    if _ffe_pv > 0:
                        # 结束=输出时间轴点：预览 0 基=主显示起点 → 同 delay 减 _s_off
                        _fap.append(f"atrim=end={_ffsec(_ffe_pv)}")
                if _T and _T > 0:
                    _fap.append(f"atrim=0:{_ffsec(_T)}")
                fg.raw(f"[afsub{_fn}]" + ",".join(_fap) + f"[afw{_fn}]")
                fg.raw(
                    f"[amain_pv][afw{_fn}]amix=inputs=2:duration=longest:normalize=0[amain_pv]")
                _pv_mixed += 1
            fg.raw("[amain_pv]anull[ao]")
            if _pv_mixed:
                self._append_info_ui(
                    _('[预览] 已混入 {0} 条音频（子视频混音/替换 + 独立音频混音，与导出一致）').format(_pv_mixed))
        graph = fg.build()

        # ---- 「节点标签」同步到预览（2026-09-26）----
        # 为什么要这一步：节点效果此前只作用在「正式命令 / 快照」那张图上，预览一直看不到。
        # 难点：同一个「第 N 步」在**预览图**里的段序号与正式命令图不同（预览多了 movie=
        # 源段、trim 收尾段、末尾 null 段）⇒ 直接按指纹找会全部落空（实测 3 个节点只命中
        # 主链那 1 个）。所以把最近一次命令预览产出的**原始图**交给 _apply_node_fx 当
        # anchor，走 node_key_alias「同名末滤镜第 n 次出现」重锚；数量不对等的层一律不猜、
        # 跳过并提示（宁可不生效，也绝不插到别的节点上）。
        # ⚠️ 位置在 parts 合成之后：管道路线（graph 直接喂 _open_pipe_time_preview）与
        #    mpv/ffplay 路线（下面 _inject_movie_seek_point_per_sub）用的是**同一张图**，
        #    在这里加一次就两条预览路径同时生效。
        # node_fx 为空时 _apply_node_fx 逐字节原样返回 ⇒ 未用过节点标签的项目零回归。
        if getattr(self, "node_fx", None):
            if not (getattr(self, "_last_graph", "") or ""):
                # anchor 还没有（例如刚载入工程、还没刷过命令预览）→ 先跑一次构图拿到原始图
                with suppress(Exception):
                    self.merge_update_command_preview()
            try:
                # anchor 用「应用节点效果前」的原始图（_last_graph_raw_v）：_last_graph
                # 是叠加效果后的图，效果段让同名滤镜计数比预览图多 → node_key_alias
                # 整层拒绝 → 预览看不到插入的局部效果（split 分叉链实测，2026-09-27）。
                # raw 缺失时回退 _last_graph（旧行为兜底）。音频锚点无需对应处理：
                # _last_graph 写入在音频节点效果应用之前，本来就是干净图。
                # anchor_graph（2026-10-09）：把同一张原始图的**字符串**也传进去 ——
                # 只有它才能做「子视频链末端」精确重锚，否则遮罩会被重锚到预览图的
                # 收尾段 [vo]、alpha 无人消费 ⇒ ffplay/mpv 里完全看不见（实测）。
                _pv_anchor = (getattr(self, "_last_graph_raw_v", "")
                              or getattr(self, "_last_graph", "") or "")
                # ⚠️【工作分辨率上限换算】2026-10-16（用户第 5 条）：管道预览把帧整体乘
                # `_pwf` 缩小，但节点效果的**几何参数**（delogo x/y/w/h、crop、遮罩形状、区域
                # 效果框）是在**图建好之后**由 _apply_node_fx 原样插入的，从没乘过 f ⇒ 缩小帧里
                # 坐标按原画面像素解释、越界时 ffmpeg 拒 delogo → 管道预览永远「正在加载预览」。
                # 只在 `_pwf<1`（管道路线且主帧 > 1280）时把整份 node_fx 的几何换算到预览帧空间；
                # f=1（mpv/ffplay 路线、或本身 ≤1280）→ 传 None = 逐字节旧行为（零回归）。
                # 换算只改**数值**、不改 key ⇒ `_apply_node_fx` 的指纹定位/重锚完全不受影响。
                _pv_fx_override = (_pipe_scale_node_fx_map(getattr(self, "node_fx", None), _pwf)
                                   if _pwf < 1.0 else None)
                graph, _pv_node_lbl = self._apply_node_fx(
                    graph, ("vo" if "[vo]" in graph else "out"),
                    override=_pv_fx_override,
                    anchor_nodes=graph_nodes(_pv_anchor),
                    anchor_graph=_pv_anchor)
            except Exception as _e:
                self._append_info_ui(_('[节点] 预览叠加节点效果失败（按原图继续）: {0}').format(_e))
            if getattr(self, "node_audio_fx", None):
                try:
                    graph, _pv_node_lbl = self._apply_node_audio_fx(
                        graph, ("ao" if "[ao]" in graph else "out"),
                        anchor_nodes=graph_nodes(getattr(self, "_last_graph", "") or ""))
                except Exception as _e:
                    self._append_info_ui(_('[音频节点] 预览叠加失败（按原图继续）: {0}').format(_e))

        # ---- 【时间预览引擎】管道合成模式（2026-09-20 Phase 2，用户拍板开放封装页）----
        # 同一张 PiP 合成图改喂内置时间预览窗口：ffmpeg -filter_complex → rawvideo 管道，
        # **不启动 mpv/ffplay** → 保留标记 / 波形 / 逐帧步进 / A-V 仲裁。默认 False ⇒
        # 旧调用方（mpv / ffplay 实时预览）零行为变化。
        # 子视频 seek 同步：_launch_video_pipe 会按「子=主−pipe_start」处理每个视频类 movie=
        # ——优先改写成外部 `-ss -i` 输入（帧精确），改不到的才注入 seek_point 近似；
        # 拖进度条时子视频跟随（与正式导出「主从 pipe_start、子从 0」一致）。
        # 主视频截取在管道模式下**只烘焙相对终点** trim=end=(E−S)：起点交 pipe_start
        # （=截取起点 _ssec；图内时间轴已 0 基归零，再套绝对 trim=start 会二次偏移），
        # 终点仍在此收口 ⇒ 主链不会播过选段、子视频循环窗口也随之收敛（见上方 pipe_engine 分支）。
        if pipe_engine:
            # 2026-10-12：**撤回** 2026-10-09 那道「颜色虚拟主视频不支持内置时间预览引擎」门控。
            # 该结论已过时：管道引擎的主输入早就支持虚拟源 —— `_launch_video_pipe` 对
            # `_is_virtual_source(self.file)` 会换 `-f lavfi -i <spec>`（与 mpv 的
            # `av://lavfi:<spec>`、ffplay 的 `-f lavfi -i` 同口径），图内 [vid1] 照旧指「主输入」
            # ⇒ 合成图一字不改。普通模式管道预览早已能开虚拟主视频（用户实测），另外两处却被
            # 这道 return 挡在门外 ⇒ 观感上「只有普通模式能开」，用户当场指出不合理。
            # 另：`out_mode` 分支原先也漏了虚拟源（只会拼出坏命令 `-i color:…`），已同步补上。
            # #3（2026-10-08）：回报「未保存航点有没有进这张图」→ 预览窗标题 + 顶部横幅
            # （见 _wp_mark_status）。无未保存航点 ⇒ 不写 ⇒ 预览窗零变化。
            if _lw is not None:
                _wp_mark_status(extra_kw, "live" if _lw_hit[0] else "stale")
            # 合成图真实输出画面比：平铺网格会把尺寸乘成 cols×rows 倍 → 不下传会导致预览框
            # 比例错、图被 letterbox（用户实测「2 格平铺没铺满」）。未平铺时用主视频规格。
            _pipe_w, _pipe_h = _main_w, _main_h
            if _pip_split_ok:
                _pipe_w = _main_w * _pip_cols
                _pipe_h = _main_h * _pip_rows
            _pipe_ar = (float(_pipe_w) / _pipe_h) if _pipe_h > 0 else None
            self._append_info_ui(
                _('[时间预览] 画中画管道合成预览：{0} 个子视频 movie 合成（ffmpeg -filter_complex → rawvideo；子视频跟随进度条同步 seek）').format(len(sub_videos)))
            if _pv_out_mode:
                # 路线A（research/pipe-pip-chain）：链图 = 输出时间轴——xfade offset / adelay /
                # enable / cbase d 全是 0 基绝对值，管道的 pts 平移桥接会让整链错位（拖动后
                # offset 钉在原地、链成员 0 基窗口被 _split_sub_trims 误当绝对 trim）⇒ 有链时
                # 整图走 out_mode：不 seek 任何输入、拖动在图尾做输出侧 trim（与串行合并管道
                # 预览同款；代价=每次拖动从 0 解码，串行合并已验证此代价可接受）。
                _pv_out = _pv_total if (_pv_total and _pv_total > 0) else (
                    _pv_main_eff if (_pv_main_eff and _pv_main_eff > 0) else _main_limit)
                self._append_info_ui(
                    _('[时间预览] 含转场链 → 输出时间轴模式（总长 {0:.2f}s；拖动从 0 解码后输出侧裁剪，seek 较慢但与导出逐帧一致）').format(_pv_out))
                # 合成音频图下传（串行合并同款）：out_mode 的输出时间轴与主文件音轨时间轴
                # 不对齐（图内主声床 atrim=_ssec 后 0 基 + 子声 adelay 落位），引擎直读主文件
                # 只会放出「第一个视频的完整音频」（用户实测）→ 抽混音段成独立 lavfi 图，
                # [aid1] 主声床改 amovie 自供，引擎在 [ao] 后接 atrim=at 精定位。
                _pa_graph = self._lavfi_mix_audio_standalone(graph, main_file) or None
                if _pa_graph:
                    self._append_info_ui(_("[时间预览] 合成音频已下传管道引擎（混音段独立 lavfi 图）"))
                self._open_pipe_time_preview(main_file, dict(_ms), graph, None, None,
                                             aspect=_pipe_ar, out_dur=_pv_out, out_start=0.0,
                                             pipe_audio_graph=_pa_graph, pipe_audio_map="[ao]",
                                             # 透明指示棋盘（2026-10-12）：显式下传画中画口径 ——
                                             # 主视频透明，或「主视频之后那段」里显示的子视频带透明。
                                             pipe_alpha=_pv_needs_alpha,
                                             extra_kw=extra_kw)
            else:
                self._open_pipe_time_preview(main_file, dict(_ms), graph, None, _ssec,
                                             aspect=_pipe_ar,
                                             pipe_alpha=_pv_needs_alpha, extra_kw=extra_kw)
            return

        # 【mpv/ffplay 回退路径】子视频 movie= 注入各自 trim 起点的 seek_point：回退分支走
        # 「主/子各经 trim=start,setpts=PTS-STARTPTS 归零」的 0 基对齐模型，子 movie= 注入其
        # 自身 S_sub 即可跳过从 0 空解、又不破坏 pts 对齐（远起点子视频秒开）。输出逐字节不变
        # （tests/kli_ffplay_seek_probe.py md5 校验）。管道引擎(pipe_engine)走自己的改写+uniform
        # 兜底，上面已 return，不在此注入（避免重复 seek / 破坏其外部 -i 改写）。
        graph = SimplePreviewer._inject_movie_seek_point_per_sub(graph)

        if mpv_ok:
            player = self.mpv_path.get().strip() or "mpv"
            # 2026-10-09：颜色主视频 —— 位置输入换成 `av://lavfi:<spec>`（真机实测可播、alpha
            # 保留，图内 [vid1] 直接指到它 ⇒ **既有 filtergraph 一字不改**）。裸哨兵 /
            # lavfi: / ffmpeg://lavfi: 一律 exit 1，这是唯一可行形态（见 _virtual_mpv_input）。
            _mpv_input = ((_virtual_mpv_input(main_video.file_path) or main_file)
                          if _main_is_color else main_file)
            _mpv_ext = []
            cmd = [player, _mpv_input] + _mpv_ext + [f"--lavfi-complex={graph}"]
            # 【主视频截取起点交给播放器原生 seek】否则 mpv 从素材 0 解码到 _ssec 才出首帧：
            # 音频链先出帧驱动时钟、视频帧迟到被丢（画面花），与上方音频段的 atrim 同段口径配合。
            # 真机实测（mpv.com + rc 零帧判据）：seek 后时间戳**不归零** ⇒ 图内 trim=start=_ssec
            # 与 --start 共存、不会二次切（同 L28252「播放器原生 --start 跳转 → 滤镜 t=原始时间戳」）。
            # --start 只作用主输入；子 movie= 仍靠各自 seek_point（上一行的逐子注入）。
            # 颜色主视频同样可给 --start（av://lavfi: 实测接受 --start/--length，H1/H2 无报错）。
            if _main_trim_prefix and _ssec is not None:
                cmd.append(f"--start={_ssec}")
                # 【秒开】关掉 hr-seek（同 preview_with_player 的说明）：图内 trim=start=_ssec
                # 已精确裁切，mpv 不必再消耗 _ssec 秒滤镜输出才出首帧；画面仍逐帧准确。
                cmd.append("--hr-seek=no")
            self._append_info_ui(_('[预览] 画中画实时预览：mpv lavfi-complex（{0} 个子视频 movie 合成，可能卡顿）').format(len(sub_videos)))
            self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
            try:
                flags = _ffmpeg_spawn_flags()
                # 开新预览前先关掉上一次预览的播放器（防两窗口同时出声 = 用户报的「重音」）；
                # 登记句柄供下一次预览关闭。
                self._reap_prev_preview_player()
                self._preview_player_proc = subprocess.Popen(
                    cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=flags)
                _register_preview_proc(self._preview_player_proc)
            except Exception as e:
                # 兜底：Popen 抛 OSError=mpv 进程起不来（不可用），标记标志供后续预览直接回退/提示
                self._mpv_usable = False
                self._mpv_verified = True   # 已实测失败，后续预览直接回退不再重试子进程
                self._append_info_ui(_('[预览] mpv 启动失败: {0}（已标记 mpv 不可用，请检查路径或用快照预览）').format(e))
        else:
            # ffplay 回退：图内 [vid1]→[in]、[vo]→[out]，主音频 passthrough 段([aid1]anull[ao])删除
            # （ffplay 主音轨随 -i 自动播放）。图片主视频的循环由图内 `loop=loop=-1` 滤镜承担
            # （_main_prefix 已注入），末端 trim=0:N 收尾，-autoexit 等到【输出】结束自动关闭；
            # 故此处不再剥 loop 滤镜、也不再给 -loop 1（ffplay 下 -loop 1 图片不生效，实测 1 秒消失）。
            # 缩放尺寸先算（原在 -af 之后，提前供下方 lavfi 路径复用）：ffplay 窗口默认按输出
            # 分辨率，画中画/画布/网格可能远超屏幕 → 标题栏被挤出屏幕。按 preview_margin
            # （默认 80）预留，仅在超界时才缩（与旧预览路径一致）。
            _out_w, _out_h = _main_w, _main_h
            if _pip_split_ok:
                _out_w = _main_w * _pip_cols
                _out_h = _main_h * _pip_rows
            # ---- 方案 A（2026-09-26）：尾垫>0 时改走 -f lavfi 整图形态 ----
            # 真时间轴尾垫（tpad 延长输出）时输出比主文件长 ⇒ 文件当主输入的 -autoexit 盯
            # **主文件 EOF**，主视频一放完就退窗（用户实测 28s 主视频 / 81s 总长，播完首段
            # 即关窗；下方 -t 跟 _pv_total 只是读包上限，救不了 autoexit 的 EOF 判定——
            # 昨天修的就是 -t，今天尾垫场景回归实锤）。与串行合并同款破法：不给主文件输入，
            # 整张图交给 -f lavfi -i ⇒ 主输入 EOF = 图 EOF = 全片播完自动关窗。
            # 改写失败（形态不符）→ 回退下方原 -i 写法，行为与旧版逐字一致（零回归）。
            # 颜色主视频不走尾垫 movie= 改写（会把颜色哨兵塞进 movie= 滤镜 → ffmpeg 打不开）；
            # 颜色源本身即图内 lavfi 输入，直接走下方 -f lavfi -i 主输入路径。
            if (not _main_is_color) and _pv_total and _main_limit and _pv_total > _main_limit + 0.05:
                _main_movie = (self._movie_path_safe(main_file, 0)
                               .replace("\\", "/").replace(":", "\\\\:"))
                _spt = _ssec if (_main_trim_prefix and _ssec is not None) else None
                _ff_graph = self._pip_graph_to_ffplay(graph, _main_movie,
                                                      seek_point=_spt, total=_pv_total)
                if _ff_graph:
                    _lav_cmd = [self.ffplay_cmd, "-autoexit", "-volume",
                                str(self.preview_volume.get())]
                    # ⚠️ 不给 -ss/-t/-af：lavfi 输入不可 seek（给了只会打一行
                    #    "could not seek to position N" 然后从头播）；图 EOF 即关窗，
                    #    -t 是主输入 pts 上限的读包判据，在这里多余且可能误丢包；
                    #    音频已在图内 amovie 自供（含混音段），无需 -af 直挂。
                    _lav_cmd.extend(["-f", "lavfi", "-i", _ff_graph])
                    _lav_cmd.extend(self._ffplay_fit_scale(_out_w, _out_h))
                    _lav_cmd.extend(["-window_title", _('预览(PiP): {0}').format(os.path.basename(main_file))])
                    self._append_info_ui(
                        _('[预览] 画中画实时预览：ffplay -f lavfi 整图（尾垫 {0:.2f}s → {1:.2f}s，autoexit 盯图 EOF 全片播完自动关窗；窗口内不支持 seek）').format(_main_limit, _pv_total))
                    self._append_info_ui(_("执行命令: ") + format_cmd_for_display(_lav_cmd))
                    self._spawn_player_stderr_scan(_lav_cmd, scan_ffplay=True)
                    return
                self._append_info_ui(_("[预览] 画中画实时预览：ffplay 整图改写失败，回退 -i 文件写法"
                                     "（尾垫场景会在主视频放完时提前关窗）"))
            _ff_vf = self._lavfi_complex_to_ffplay(graph)
            if not _ff_vf:
                self._append_info_ui(_("[预览] 画中画实时预览：复杂图转 ffplay -vf 失败，无法预览"))
                return
            cmd = [self.ffplay_cmd, "-autoexit", "-volume", str(self.preview_volume.get())]
            # 【主视频截取起点交给 ffplay 原生 -ss】（与上面 mpv 分支的 --start 同口径）
            # 根因：不给 -ss 时 ffplay 从素材 0 解码，而命令行 -t=_main_limit 会把「素材时间戳 −
            # start_time > _main_limit」的包**直接丢弃**（ffplay read_thread 的 pkt_in_play_range
            # 判据）⇒ 图内 trim=start=_ssec 一帧都拿不到 =【画面永远不出】；与此同时主音轨是原生
            # 直读、照常放满 _main_limit 秒 ⇒ 音频一放完 -autoexit 立刻退窗。
            # 用户实测即此现象：「音乐放完就退出，画面还在 seek」→ 有 seek 时 ffplay 预览等于失效。
            # 加 -ss 后 demuxer 直接定位到截取点（主音频同步从该点起播，-t 也随之变成相对该点计时）。
            # ⚠️ 图内 trim=start=_ssec **必须保留**：ffplay 的 -ss 不归零时间戳（filtergraph 仍拿到
            # 原始时间戳）。真机探针（SDL dummy 无头）：无 -ss + -t 4 + trim=start=8 → 0 帧；
            # 加 -ss 8 后 → 100 帧、首帧 pts=8.000，与「不加 -ss 只去掉 -t」的帧集完全一致；
            # 而同一探针下「-ss 8 + trim=start=0」→ 0 帧（反证 trim 起点不能改成相对 0）。
            # 颜色主视频：输入不可 seek（lavfi color），图内已 0 基 → 跳过 -ss。
            if _main_trim_prefix and _ssec is not None and not _main_is_color:
                cmd.extend(["-ss", f"{_ssec}"])
            if _main_is_color:
                # ffplay 认 `-f lavfi -i <spec>` 作主输入（固定 [in]）；图内 [vid1] 经
                # _lavfi_complex_to_ffplay 已映射成 [in]，故**不前置** color 节点（否则重复定义 [in]）。
                _cspec_ff = _virtual_lavfi_spec(main_video.file_path)
                if not _cspec_ff:
                    self._append_info_ui(_("[预览] 颜色源解析失败，无法生成实时预览"))
                    return
                cmd.extend(["-f", "lavfi", "-i", _cspec_ff, "-vf", _ff_vf])
            else:
                cmd.extend(["-i", main_file, "-vf", _ff_vf])
            # 【主音轨必须同段裁切 + 归零】与图内主视频的 trim=start=_ssec,setpts=PTS-STARTPTS 逐字同口径。
            # 只加 -ss 而不管音频 ⇒ 图内视频已被 setpts 归零、原生音频却仍带**素材绝对时间戳** →
            # ffplay 的 A/V 时钟差恒等于截取起点，音频为主时钟时判定「视频迟到 _ssec 秒」→ 疯狂丢帧追帧。
            # 真机状态行实证（-ss 8 -t 4，不加 -af）：起始 "7.66 A-V: 7.544" → 收尾 "11.94 A-V: 4.418
            # fd=49"（丢了 49 帧）；另 ffplay 的 -ss 只落在「≤截取起点的视频关键帧」上 → 不裁 audio 时
            # 还会**提前最多一个 GOP** 出声。加了 -af 后 A-V≈0、fd=0（见探针 kli_ffplay_seek4）。
            # 【子声混音同步升级】图内有混音段时把主声床 + amovie 子声整体搬进 -af，
            # 与 mpv --lavfi-complex 同口径出声（此前 ffplay 一律删混音段退回主音频直放
            # = 真时间轴后半段子声无声，用户实测「ffplay 只有第一段声音」）。
            _ff_af = self._lavfi_mix_audio_to_ffplay_af(graph) if _has_audio else None
            if _ff_af:
                # 子声链每条一个段（[asubK]…[aswK]）；amix 段以 [amain_pv] 开头也含 "[asw"，
                # 不能按包含计数（会把每条数成 2，9 个报 18）。独立音频轨段前缀 [afsub 同理单计。
                _n_mix = sum(1 for s in _ff_af.split(";") if s.strip().startswith("[asub"))
                _n_mix += sum(1 for s in _ff_af.split(";") if s.strip().startswith("[afsub"))
                self._append_info_ui(
                    _('[预览] ffplay -af 已混入 {0} 条音频（与 mpv 同口径）').format(_n_mix))
                cmd.extend(["-af", _ff_af])
            elif _main_trim_prefix and _ssec is not None and _has_audio:
                cmd.extend(["-af", f"atrim=start={_ssec},asetpts=PTS-STARTPTS"])
            # 缩放到屏幕内（_out_w/_out_h 已在 ffplay 分支开头算好，含画布/网格乘格）
            cmd.extend(self._ffplay_fit_scale(_out_w, _out_h))
            # -t 上限吃延长后的时间轴总长：真时间轴把输出延长到 _pv_total（尾部补黑帧），
            # 仍用 _main_limit 会把画面在主视频时长处截断（用户实测 ffplay 12s 即断、
            # 而 mpv 路线靠图内收口 trim 无此问题）。
            _ff_t = _main_limit
            if _pv_total and _pv_total > 0 and (not _ff_t or _pv_total > _ff_t):
                _ff_t = _pv_total
            if _ff_t and _ff_t > 0:
                cmd.extend(["-t", f"{_ff_t:g}"])
            if "-window_title" not in cmd:
                cmd.extend(["-window_title", _('预览(PiP): {0}').format(os.path.basename(main_file))])
            self._append_info_ui(
                _('[预览] 画中画实时预览：ffplay -vf（{0} 个子视频 movie 合成）').format(len(sub_videos)))
            self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
            self._spawn_player_stderr_scan(cmd, scan_ffplay=True)

    def merge_preview_concat_edl(self):
        """串行合并预览（mpv EDL 内联播放，不重编码、不滤镜）。
          ⚠ 历史局限已拆除（2026-10-03 实测）：旧注释称「内联 edl:// 内部先过一次 URL
          解析，文件名里的 `=` 会截断路径，故跳过含 `=` 的文件」，并靠 `\\,` / `\\;`
          反斜杠转义 `,` `;`。实测这两个判断**都不成立**：反斜杠转义根本不生效
          （`a,b.mp4` 打不开），而真正的问题是 mpv EDL 把裸路径里的第一个 `=` 当
          name=value 分割点（内联、文件版同一个解析器，`;` 只是换行的等价物）。
          现路径统一走 mpv 官方 `%<字节数>%<字面值>` 长度守卫（_edl_escape_path）：
          `=` `,` `;` `!` `%` 空格 中文 全部可播，**不再跳过任何轨道**。
    
        EDL v0 内联格式：`edl://file,start,dur;file,start,dur;...`
          · 路径与内容由 Python 直接传给 mpv 命令行（Windows 走 CreateProcessW，
            中文路径无编码问题）。
          · `start` / `dur` 单位秒；省略 `dur` = 播到该文件末尾。
          · 命令行总长受 Windows 32767 字符上限约束（53 段实测远未触及；若未来
            段数过多导致超限，再考虑退回临时 .edl 文件方案）。
        """
        # ---- 前置检查 ----
        if alert_if(not self.concat_enabled.get(), _("提示"), _("请先勾选「串行合并（首尾拼接）」模式再使用 EDL 预览"), 'info'):
            return
        if alert_if(not self.use_mpv.get(), _("提示"), _("串行合并 EDL 预览依赖 mpv（请在「信息与播放器」页启用 mpv 播放器）")):
            return
        if not self._mpv_ready(log=True):
            return
    
        # ---- 收集启用视频轨（跳过占位/错误/文件不存在）----
        # ⚠ 不再有「含 `=` 就跳过」的门禁（2026-10-03）：mpv EDL 用 %<字节数>%<字面值>
        # 长度守卫即可安全承载任意字符，含 `=` `,` `;` 的路径照样能播。
        video_tracks = []
        for t in self.merge_tracks:
            if not t.enabled or t.type != "video":
                continue
            if t.enc_settings.get("_placeholder", False):
                continue
            if t.enc_settings.get("_error"):
                continue
            if not t.file_path or not os.path.exists(t.file_path):
                self._append_info_ui(_('[EDL 预览] 跳过不存在的文件: {0}').format(t.file_path))
                continue
            video_tracks.append(t)
        if alert_if(not video_tracks, _("提示"), _("没有可用于预览的视频轨道")):
            return
    
        # ---- 组装 EDL 条目（内联 v0：file,start,dur）----
        entries = []
        for t in video_tracks:
            es = t.enc_settings
            path = _edl_escape_path(normalize_path(t.file_path))
            # ↑ 长度守卫一次搞定 `=` `,` `;` `!` `%` 换行；禁再退回 `\\,` `\\;`
            # （实测无效）或「含 `=` 就跳过」（误判成 URL 解析截断，实际是 EDL 的
            # name=value 分割点，2026-10-03 已拆门禁）。

            if es.get("trim_enabled", False):
                start_str = str(es.get("trim_start", "0") or "0").strip()
                end_str = str(es.get("trim_end", "") or "").strip()
                start = time_to_seconds(start_str) if start_str else 0.0
                if start is None or start < 0:
                    start = 0.0
                if end_str:
                    end = time_to_seconds(end_str)
                    if end is not None and end > start:
                        # ⚠ 秒值一律 .6f（定点微秒）：禁 %g —— 后者只有 6 位有效数字，
                        # 长素材会被抹精度（36000.25 → "36000.2"，丢 0.05s），
                        # 违反「忠实传导用户给的时间值」。
                        entries.append(f"{path},{start:.6f},{end - start:.6f}")
                    else:
                        # 结束时间无效/早于起点 → 退化为「从 start 播到结尾」
                        entries.append(f"{path},{start:.6f}")
                else:
                    entries.append(f"{path},{start:.6f}")
            else:
                entries.append(path)
    
        if alert_if(not entries, _("提示"), _("没有可预览的轨道，无法预览。")):
            return
    
        edl_uri = "edl://" + ";".join(entries)
    
        # --hr-seek=yes：精确 seek（解码到目标帧，不是关键帧对齐）；
        # --hr-seek-framedrop=no：精确定位时不丢帧（避免"位置到了但画面没到"）；
        # --keep-open=no：末段播完自动退出（不卡在最后一帧）
        # ⚠️ 这里与两条 lavfi 预览路径（preview_with_player / merge_preview_pip_live）**相反**：
        # EDL 没有滤镜图、也没有图内 trim 兜底，关掉 hr-seek 会直接落到关键帧（最多偏一个
        # GOP）⇒ 本路径必须保持 yes，不要去和那两处「统一」。
        cmd = [
            self.mpv_path.get().strip() or "mpv",
            "--hr-seek=yes",
            "--hr-seek-framedrop=no",
            "--keep-open=no",
            edl_uri,
        ]
    
        self._append_info_ui(
            _('[EDL 预览] 串行合并预览：{0} 段，mpv 顺序播放（不重编码）；⚠ 换段处短暂停顿/闪烁属正常现象（EDL 是「跳读」不是无缝拼接）').format(len(entries)))
        self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
        try:
            flags = _ffmpeg_spawn_flags()
            # 开新预览前先关掉上一次预览的播放器（防两窗口同时出声 = 重音）；登记句柄。
            self._reap_prev_preview_player()
            self._preview_player_proc = subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, creationflags=flags)
            _register_preview_proc(self._preview_player_proc)
        except Exception as e:
            self._append_info_ui(_('[EDL 预览] mpv 启动失败: {0}').format(e))
            messagebox.showerror(_("预览失败"), _('mpv 启动失败:\n{0}').format(e))


    def merge_export_concat_edl(self):
        """串行合并导出为实体 .edl 文件（mpv 原生 EDL 格式，LF 换行，可直接 mpv 播放）。

        与内联预览的区别：
          · 两侧现在**都**允许任意字符路径（同一套 %<字节数>%<字面值> 长度守卫，
            内联的 `=` 跳过门禁 2026-10-03 已拆）；
          · 不以 edl:// 喂 mpv，而是落盘成文件，可长期保存 / 分享 / 二次编辑。
        """
        if alert_if(not self.concat_enabled.get(), _("提示"), _("请先勾选「串行合并（首尾拼接）」模式再导出 EDL"), 'info'):
            return
        segs, skipped = build_concat_segments_from_tracks(self.merge_tracks)
        if alert_if(not segs, _("提示"), _("没有可导出的视频轨道（请检查是否已添加并启用视频轨）")):
            return
        content = format_mpv_edl_file(segs)
        path = filedialog.asksaveasfilename(
            title=_("导出串行合并 EDL 文件"),
            defaultextension=".edl",
            filetypes=[("mpv EDL", "*.edl"), (_("所有文件"), "*.*")])
        if not path:
            return
        try:
            # ⚠ newline="\n" 强制 LF：mpv EDL 文件必须用 UNIX 换行，CRLF 会导致解析失败播不起来
            with open(path, "w", encoding="utf-8", newline="\n") as f:
                f.write(content)
        except Exception as e:
            messagebox.showerror(_("保存失败"), str(e))
            return
        # 导出本身只是写文本文件，不依赖 mpv → 未启用 mpv 也照样导出（不设前置门槛）；
        # 但「导出的文件本机能不能直接播」取决于 mpv 状态，故提示文案分两种写法。
        # ⚠ log=False：_mpv_ready 默认的日志是「已回退 ffplay」，导出场景没有回退，
        #   提示由本方法自己写。
        mpv_ok = self._mpv_ready(log=False)
        self._append_info_ui(
            _('[EDL 导出] 已保存 {0} 段到 {1}').format(len(segs), path))
        if mpv_ok:
            self._append_info_ui(
                _("    mpv 原生 EDL v0（LF 换行），可用 mpv 打开播放（拖进mpv窗口）：mpv ") + os.path.basename(path))
        else:
            self._append_info_ui(
                _("    mpv 原生 EDL v0（LF 换行）；本机未启用 mpv，本 edl 可交给其他程序使用。"))
        if skipped:
            self._append_info_ui(
                _('    ⚠ {0} 个轨道因占位/错误/文件不存在被跳过').format(len(skipped)))
        if mpv_ok:
            messagebox.showinfo(_("已导出"), _('已保存 {0} 段到：\n{1}\n\n可用 mpv 打开播放（拖进mpv窗口）。').format(len(segs), path))
        else:
            messagebox.showinfo(_("已导出"), _('已保存 {0} 段到：\n{1}\n\n本机未启用 mpv，本 edl 可交给其他程序使用。').format(len(segs), path))


    def _build_concat_audio_graph_mpv(self, video_tracks, seg_durations,
                                      trans_effective, total_dur, main_video):
        """构建「滤镜版串行合并预览」的音频链（mpv lavfi-complex 版）。

        与正式串行合并命令 _build_concat_reencode_mode 的音频段【同规则、逐字镜像】
        （源函数见「----- 4b/5/6/6b 音频」各节），唯一差别是**输入标签来源**：
          · 正式命令用 ffmpeg 输入说明符 [{i}:a]（第 i 个 -i 的音轨）；
          · mpv 只能引用 1 个位置文件，且其 [aid1]/[aid2] 编号按「含音轨的文件」独立计数
            ——主文件是图片（无音轨）时第 1 个外部文件的音轨反而叫 [aid1]（真机实测：
            图片主 + 外部视频时 [aid2] 报 "Pad aid2 is not connected" 直接 rc=2）。
            该编号依赖数据、极脆弱 → 本函数统一改用 movie=<路径>:s=a 显式取音频，
            完全不依赖 mpv 的 [aidN] 编号（真机实测 rc=0，PCM 落盘时长精确）。
        ⚠️ 图纸来源单一性：音频「规则」的真源仍是 _build_concat_reencode_mode，
        改那边必须同步改这里（tests/_test_merge_concat_preview.py A 系列锁定镜像结构）。

        分支（与正式命令一一对应；串行模式下正式命令把独立音轨清空 audio_tracks=[] →
        预览同样忽略独立音轨，外部音频统一走 BGM）：
          ① 主视频「音频独立截取」(audio_trim_enabled) → 单段，从主视频源音频截取，接管全部音频；
          ② 逐轨（默认）：图片 / 无音轨 / audio_source_type=silence → anullsrc 铺该段时长；
                        否则源音频跟随该段的 截取/变速/倒放 + 段级钳制 + 淡入淡出；
          ③ 拼接：段间开转场 → acrossfade，否则 concat（与视频段 1:1 对应）；
          ④ 背景音乐(BGM)：循环铺满 + 压音量，amix 混在原音之下。
        末尾统一 atrim+apad 到 total_dur —— 正式命令靠 -shortest 收敛，mpv 预览无 -shortest，
        故显式钳到总时长（保证音画同长、不被 BGM 或跨段重叠拖偏）。

        返回 (src_parts, audio_parts, amap, summary)：
          src_parts   = movie= 音频源分句（需并入图首，供后续引用）
          audio_parts = 音频处理/拼接分句（出口 [aout] 或 [afinal]）
          amap        = 音频出口标签
          summary     = 供日志的一句话（真实音频/静音底噪/是否含 BGM）
        """
        src_parts = []
        audio_parts = []
        at_set = main_video.enc_settings if main_video is not None else {}

        def _add_src(path, idx, lbl):
            """为某文件挂音频源 movie=<path>:s=a[lbl]；图片/无音轨返回 False（由调用方走 anullsrc）。"""
            if not path or self._is_static_image(path):
                return False
            info = self._get_cached_stream_info(path)
            has_a = bool(info) and any(
                s.get("codec_type") == "audio" for s in (info.get("streams") or []))
            if not has_a:
                return False
            safe = self._movie_path_safe(path, idx).replace("\\", "/").replace(":", "\\\\:")
            src_parts.append(f"movie={safe}:s=a[{lbl}]")
            return True

        # 音频归一：concat / acrossfade 要求各段采样率/声道/采样格式一致（与正式命令同函数）
        audio_concat_normalize = self._build_audio_normalize(video_tracks, [])
        a_labels = []
        summary_bits = []

        _use_global_audio_trim = bool(at_set.get("audio_trim_enabled", False))
        _main_file = normalize_path(main_video.file_path) if main_video is not None else ""
        if _use_global_audio_trim and _main_file:
            _astr = (at_set.get("audio_trim_start", "") or "").strip()
            _aend = (at_set.get("audio_trim_end", "") or "").strip()
            _as = time_to_seconds(_astr) if _astr else 0.0
            _ae = time_to_seconds(_aend) if _aend else None
            if _add_src(_main_file, 0, "am_main"):
                _at_parts = []
                if _as is not None and _ae is not None and _ae > _as:
                    _at_parts.append(f"atrim=start={_ffsec(_as)}:end={_ffsec(_ae)}")
                elif _as is not None and _as > 0:
                    _at_parts.append(f"atrim=start={_ffsec(_as)}")
                else:
                    _at_parts.append("anull")
                _at_parts.append("asetpts=PTS-STARTPTS")
                _at_chain = ",".join(_at_parts)
                if audio_concat_normalize:
                    _at_chain = f"{audio_concat_normalize},{_at_chain}"
                audio_parts.append(f"[am_main]{_at_chain}[aout]")
                summary_bits.append(
                    _('音频独立截取（源 {0}，起始 {1} 结束 {2}）').format(os.path.basename(_main_file), _astr or '0', _aend or '末尾'))
            else:
                # 正式命令此处直接取 [0:a]（图片主视频无音轨时会失败）；预览给安全兜底：
                # 静音底噪 + 明确日志，避免整张图因一个不存在的音轨直接挂了。
                audio_parts.append(
                    f"anullsrc=r=44100:cl=stereo:duration={total_dur:.3f}[aout]")
                summary_bits.append(_("音频独立截取已开启但主视频无音轨 → 静音底噪"))
        else:
            for i, trk in enumerate(video_tracks):
                settings = trk.enc_settings.copy()
                audio_type = settings.get("audio_source_type", "self")
                effective_duration = seg_durations[i] if i < len(seg_durations) else 10.0
                if effective_duration is None or effective_duration <= 0:
                    effective_duration = 10.0
                _fp = normalize_path(trk.file_path)
                if audio_type == "silence" or not _add_src(_fp, i, f"am{i}"):
                    norm_suffix = f",{audio_concat_normalize}" if audio_concat_normalize else ""
                    audio_parts.append(
                        f"anullsrc=r=44100:cl=stereo:duration={effective_duration:.3f}"
                        f"{norm_suffix}[a{i}]")
                else:
                    audio_filters = []
                    # 视频自带音轨跟随视频段截取（与正式命令逐字一致）
                    if settings.get("trim_enabled", False):
                        start = settings.get("trim_start", "").strip()
                        end = settings.get("trim_end", "").strip()
                        start_sec = time_to_seconds(start) if start else 0.0
                        end_sec = time_to_seconds(end) if end else None
                        total = self._get_media_duration(trk.file_path) if trk.file_path else None
                        if end_sec is not None:
                            trim_dur = end_sec - start_sec
                        elif total is not None:
                            trim_dur = total - start_sec
                        else:
                            trim_dur = None
                        if trim_dur is not None and trim_dur > 0:
                            audio_filters.append(
                                f"atrim=start={_ffsec(start_sec)}:duration={_ffsec(trim_dur)}")
                            audio_filters.append("asetpts=PTS-STARTPTS")
                    _append_audio_speed_reverse(settings, audio_filters)
                    # 段级时长钳制（同正式命令：短了补静音、长了裁尾，防跨段累计错位）
                    audio_filters.append(f"atrim=0:{_ffsec(effective_duration)}")
                    audio_filters.append(f"apad=whole_dur={effective_duration:.3f}")
                    audio_chain = ",".join(audio_filters)
                    if audio_concat_normalize:
                        audio_chain = f"{audio_concat_normalize},{audio_chain}"
                    # 逐轨转场与音频淡入淡出互斥（与正式命令同规则）
                    if settings.get("fade_enabled", False):
                        if i < len(trans_effective) and trans_effective[i] is not None:
                            settings["fade_out"] = ""
                        if (i > 0 and i - 1 < len(trans_effective)
                                and trans_effective[i - 1] is not None):
                            settings["fade_in"] = ""
                    f_suffix = self._build_afade_suffix(settings, effective_duration)
                    if f_suffix:
                        audio_chain = f"{audio_chain},{f_suffix}"
                    audio_parts.append(f"[am{i}]{audio_chain}[a{i}]")
                a_labels.append(f"[a{i}]")

            # ----- 音频拼接 / 逐轨交叉溶解（跟随对应视频段的转场开关，与正式命令同规则）-----
            prev_a = a_labels[0]
            for k in range(1, len(a_labels)):
                out_label = "[aout]" if k == len(a_labels) - 1 else f"[ax{k}]"
                tr = trans_effective[k - 1] if k - 1 < len(trans_effective) else None
                if tr is not None:
                    audio_parts.append(
                        f"{prev_a}[a{k}]acrossfade=c1=tri:c2=tri:d={tr[1]:.3f}{out_label}")
                else:
                    audio_parts.append(f"{prev_a}[a{k}]concat=n=2:v=0:a=1{out_label}")
                prev_a = out_label
            if len(a_labels) == 1:
                audio_parts.append(f"{a_labels[0]}anull[aout]")

        amap = "[aout]"
        # ----- 背景音乐(BGM)：循环铺满 → 压音量 → amix 混在原音之下（正式命令 6b 节）-----
        _bgm_path = (at_set.get("bgm_audio_path", "") or "").strip()
        if (at_set.get("bgm_enabled", False) and _bgm_path and os.path.isfile(_bgm_path)
                and _add_src(normalize_path(_bgm_path), 900, "am_bgm")):
            _bgm_vol = _opt_float(at_set.get("bgm_volume", 0.3) or 0.3, 0.3)
            _bgm_norm_str = (audio_concat_normalize or
                             "aformat=sample_fmts=fltp:channel_layouts=stereo,aresample=44100")
            _bs = at_set.get("bgm_trim_start", "") or ""
            _be = at_set.get("bgm_trim_end", "") or ""
            _bs_sec = time_to_seconds(_bs) if _bs else None
            _be_sec = time_to_seconds(_be) if _be else None
            _src_trim_parts = []
            if _bs_sec is not None:
                _src_trim_parts.append(f"start={_ffsec(_bs_sec)}")
            if _be_sec is not None:
                _src_trim_parts.append(f"end={_ffsec(_be_sec)}")
            # 帧精确片段截取必须带 atrim= 滤镜名（bare 的 start=/end= 会被当成孤立选项报错）
            _bgm_src_trim = (("atrim=" + ":".join(_src_trim_parts) + ",asetpts=PTS-STARTPTS,")
                             if _src_trim_parts else "")
            audio_parts.append(
                f"[am_bgm]{_bgm_norm_str},{_bgm_src_trim}"
                f"aloop=loop=-1:size=2000000000,"
                f"atrim=0:{_ffsec(total_dur)},"
                f"volume={_bgm_vol:.3f},"
                f"asetpts=PTS-STARTPTS[bgm]")
            audio_parts.append(
                "[aout][bgm]amix=inputs=2:duration=longest:normalize=0[afinal]")
            amap = "[afinal]"
            summary_bits.append(
                _('背景音乐 {0}（音量 {1:.2f}）').format(os.path.basename(_bgm_path), _bgm_vol))

        if not summary_bits:
            summary_bits.append(_("逐轨音频（有音轨段用真实音轨、图片/无音轨段静音底噪）"))
        return src_parts, audio_parts, amap, _("；").join(summary_bits)

    def _concat_graph_to_ffplay(self, graph_str, main_movie, color_spec=None):
        """把「串行合并 lavfi 图」从 mpv 形态改写成 ffplay `-f lavfi -i` 形态（单图字符串版）。

        为什么这条路走得通（2026-09-21 真机定案，见 research/ffplay-preview/README.md §4.5d）：
        ffplay 的 `-autoexit` 盯的是**主 `-i` 输入的 EOF**，而串行合并的输出比「第一个文件」长
        ⇒ 拿文件当主输入时首段一播完就退窗（旧版 2026-09-20 因此把 ffplay 回退整体删掉）。
        破法是**不给主文件输入**：把整张图交给 `-f lavfi -i` —— 此时主输入的 EOF **就是图的
        EOF**（= 整段拼接时长）⇒ 全播完才关窗，且**不需要 `-t`**、也不需要 mpv 的 `--length`。
        真机实测（v1/v2 各 4s）：忠实图（图片主 color 基源+overlay + 视频次 + xfade + **无限
        color 水印源** + 末端 trim + **aloop=loop=-1 BGM** + acrossfade/amix + out0/out1）
        → 图长 7s、进程 7.68s 播完即退；四条不同总长（2/4/7/8s）存活都 = 图长 + 0.3~0.7s 启动。

        与 mpv 图**只差两处**（滤镜本体、顺序、音频图一字不动）：
          ① 主轨源 `[vid1]format=yuv420p[0:v]` → `movie=<同一转义主路径>,format=yuv420p[0:v]`
             （main_movie 由调用方按图内其它 movie= 的同一口径算好：`_movie_path_safe` + 双反斜杠冒号）；
             若主视频轨有 trim（[0:v]trim=start=S），改写后的主 movie 追加 `:seek_point=S` 快进
             （ffplay -f lavfi 不可 --start，只能靠 movie=:seek_point，与 mpv --start 等效）。
             ⚠️ 调用方须先对入参做 `_inject_movie_seek_point_per_sub`（音频 :s=a / 视频轨 i>0 的
             seek_point 已注入）；本函数只补主视频轨（[vid1] 改写后的主 movie）这一处。
          ② 视频末标签 `[vo]` → `[out0]`；音频末标签 `[ao]` → `[out1]`。
        返回可直接当 `-f lavfi -i` 参数用的图串；任一步形态不符（缺 [vid1] / 末段非 [vo]）都返回 None。"""
        try:
            if not graph_str:
                return None
            if not color_spec and not main_movie:
                return None
            if "[vid1]" not in graph_str:
                return None
            # 2026-10-09：颜色虚拟源首轨 —— 直接把 [vid1] 消费者替换成图内 color 源自供
            # （不发 movie=；color 源本就是 lavfi，无需真实文件、也无 seek_point 可言）。
            if color_spec:
                g = graph_str.replace("[vid1]", "%s," % color_spec, 1)
            else:
                g = graph_str.replace("[vid1]", "movie=%s," % main_movie, 1)
            # 主视频轨 trim 起点 → 改写后的主 movie 注入 seek_point（与 mpv --start 等效）
            if not color_spec:
                _mts = re.search(r"\[0:v\]trim=start=([0-9]+(?:\.[0-9]+)?)", g)
                if _mts:
                    _mts_v = _opt_float(_mts.group(1), 0.0)
                    if _mts_v > 0:
                        g = g.replace("movie=%s," % main_movie,
                                      "movie=%s:seek_point=%.6f," % (main_movie, _mts_v), 1)
            # 末段恒 `{vmap}trim=0:T,setpts=PTS-STARTPTS[vo]`（merge_preview_concat_lavfi 步骤5）
            if "[vo]" not in g:
                return None
            g = g.replace("[vo]", "[out0]")
            if "[ao]" in g:
                g = g.replace("[ao]", "[out1]")
            return g
        except Exception:
            return None

    def _pip_graph_to_ffplay(self, graph_str, main_movie, seek_point=None, total=None):
        """把「画中画 lavfi 图」从 mpv 形态改写成 ffplay `-f lavfi -i` 形态（方案 A）。

        为什么要存在（2026-09-26 尾垫退窗修复）：真时间轴尾垫（tpad 延长输出）时输出比
        主文件长 ⇒ 原写法（文件当主输入 + -vf）的 -autoexit 盯**主文件 EOF**，主视频一放
        完就退窗（-t 跟 _pv_total 只是读包上限，救不了 autoexit 的 EOF 判定）。与串行合并
        （_concat_graph_to_ffplay）同款破法：不给主文件输入，整张图交给 `-f lavfi -i` ⇒
        主输入 EOF = 图 EOF = 全片播完自动关窗。代价：lavfi 输入不可 -ss（窗口内无 seek）。

        ⚠️ 隐藏坑（2026-09-26 无头实测 t_old=8.24 / t_new=8.26 抓到）：ffplay 的 autoexit
        在 lavfi 模式下是【任一输出流 EOF 就关窗】——串行侧图里所有轨末端都 atrim+apad
        钳到 total_dur 所以从未暴露。PiP 的音频链（尤其 passthrough 主音频=主文件长度）
        短于尾垫后的视频总长时，音频流先 EOF ⇒ 依旧提前退窗。故本函数在音频末段
        [ao] 之前统一补 `apad=whole_dur=<total>,atrim=0:<total>`（total 由调用方传
        _pv_total；串行同款口径），强制两输出流同时 EOF。

        与 mpv 图的差异（对照 _concat_graph_to_ffplay，PiP 多两条）：
          ① 视频主源 [vid1] → movie=<主>（调用方传 seek_point=主截取起点做关键帧快进，
             图内 trim=start=_ssec,setpts=PTS-STARTPTS 保留负责精确裁切，与 mpv --start
             同口径不二次切）。
          ② 音频主源 [aid1] → amovie=<主> 自供 —— **与串行的关键差异**：PiP 音频主源是
             mpv 提供的 [aid1] 流（串行图音频早已 movie=:s=a 自供），lavfi 模式没有任何
             外部输入，必须 amovie= 主文件。分两形态：
             · passthrough 段（[aid1]anull[ao]）：amovie 自供 + atrim=start=截取起点 +
               asetpts 归零（与 -i 写法的 -af 兜底逐字同口径——mpv 的 [aid1] 与 amovie
               同为素材绝对时间戳、图内视频时间轴已 0 基，不裁则 A/V 时钟差=截取起点）；
             · 混音段（同段含 [amain_pv]/[asub]/[asw]）：内部已含对齐 trim，只换源不改链
               （照抄 _lavfi_mix_audio_standalone 的 amovie 自供手法，管道引擎真机已验证）。
          ③ [vo]→[out0]；[ao]→[out1]（total>0 时经 apad/atrim 钳制段中转，见上）。
        调用方须已对入参做过 _inject_movie_seek_point_per_sub（子 movie seek_point 已注入）。
        形态不符（缺 [vid1] / 改写后缺 [out0]）返回 None，调用方回退原 -i 文件写法。"""
        try:
            if not graph_str or not main_movie or "[vid1]" not in graph_str:
                return None
            _mm = "movie=%s," % main_movie
            g = graph_str.replace("[vid1]", _mm, 1)
            if seek_point and seek_point > 0:
                g = g.replace(_mm, "movie=%s:seek_point=%.6f," % (main_movie, seek_point), 1)
            if "[aid1]" in g:
                _segs2 = []
                for _s in g.split(";"):
                    if "[aid1]" in _s and not ("[amain_pv]" in _s or "[asub" in _s or "[asw" in _s):
                        # passthrough 主音频段：amovie 自供 + atrim 归零（与 -af 兜底同口径）
                        if seek_point and seek_point > 0:
                            _segs2.append("amovie=%s:seek_point=%.6f[pv_amsrc]"
                                          % (main_movie, seek_point))
                            _segs2.append("[pv_amsrc]atrim=start=%.6f,asetpts=PTS-STARTPTS[pv_am0]"
                                          % seek_point)
                        else:
                            _segs2.append("amovie=%s[pv_am0]" % main_movie)
                        _segs2.append(_s.replace("[aid1]", "[pv_am0]"))
                    elif "[aid1]" in _s:
                        # 混音主声床段：内部已含对齐 trim，只换源不改链
                        _segs2.append("amovie=%s[pv_amsrc]" % main_movie)
                        _segs2.append(_s.replace("[aid1]", "[pv_amsrc]"))
                    else:
                        _segs2.append(_s)
                g = ";".join(_segs2)
            if "[vo]" not in g:
                return None
            g = g.replace("[vo]", "[out0]")
            if "[ao]" in g:
                # 音频末端补钳制（与串行「末尾 atrim+apad 钳到 total_dur」同款）：否则音频流
                # 先于视频 EOF ⇒ autoexit 任一流 EOF 即关窗（无头实测 8.26s vs 视频 12s）。
                if total and total > 0:
                    g = g.replace("[ao]", "[ao_pad]")
                    g += (";[ao_pad]apad=whole_dur=%.6f,atrim=0:%.6f[out1]"
                          % (total, total))
                else:
                    g = g.replace("[ao]", "[out1]")
            if "[out0]" not in g:
                return None
            return g
        except Exception:
            return None

    def merge_preview_concat_lavfi(self, pipe_engine=False, extra_kw=None):
        """串行合并预览（mpv lavfi-complex 滤镜版）。

        ⚠️ 菜单入口已收敛（2026-09-21）：不再有独立菜单项（原「串行合并预览 (支持滤镜 lavfi)」
        已删）。外部播放器路线由 `_live_preview_player`（右键「实时预览（复杂滤镜）」）
        分派，内置引擎路线由 `_live_preview_pipe` 分派。

        与右键的「串行合并预览 (mpv EDL)」（仅跳读、
        无滤镜/无转场）互补，本入口渲染【完整 filter_complex】——逐轨视频滤镜 + xfade/concat 转场 +
        文字水印/倒计时 + 静音底噪音频，与正式串行合并命令的视频链【单一来源】（_build_concat_video_graph）
        完全一致（预览即所见，避免两处逻辑漂移）。

        输入挂接（mpv 限制：只能引用 1 个位置文件流 + 其余走 movie 滤镜）：
          · 主视频轨(track 0) = 位置文件 → [vid1]；图片则 color 基源(有限时长 d=显示时长) + overlay 包裹；
          · 其余轨（i>0）= movie 滤镜引入；图片同样 color+overlay 包裹撑出显示时长；
          · 视频轨直接 movie/位置流 + format=yuv420p（连续流，无需 color 包裹）——「扩展到视频类型」即此。
        音频：走 _build_concat_audio_graph_mpv，与正式串行合并命令的音频链同规则（真实音轨 /
        段级钳制 / 淡入淡出 / acrossfade / BGM 混音），源用 movie=<路径>:s=a 显式取（绕开 mpv 的
        [aidN] 编号陷阱）；图片/无音轨段静音底噪，末尾 atrim+apad 钳到 total_dur。
        轨数上限：受「更多设置 → 预览轨数上限」约束（与画中画实时预览、内置时间预览引擎共用同一设置）。
        输出：[vo] = 末端 trim=0:total_dur（防文字水印 color 无限源撑长）+ --length 双保险。

        ffplay 路线（2026-09-21 重开）：mpv 未启用 / 起不来时改走 ffplay —— 用
        `_concat_graph_to_ffplay` 把同一张图改写成 `ffplay -autoexit -f lavfi -i "<图>[out0];<音频>[out1]"`
        （主轨 `[vid1]`→`movie=`、末标签 `[vo]`→`[out0]`/`[ao]`→`[out1]`；**不能加 `-t`**，
        也不给 `-ss`）。因为主输入变成「图本身」，其 EOF = 图 EOF ⇒ 全播完才关窗
        （旧版 2026-09-20 删除回退的病根是「用文件当主输入」）。代价：窗口内**无 seek**。
        真机证据与取舍见 research/ffplay-preview/README.md §4.5d。

        pipe_engine（2026-09-20「时间预览引擎」开放串行合并）：True 时**不启动播放器**，把同一张
        串行合并图（只取视频链，音频段不带入）喂给内置时间预览窗口（ffmpeg -filter_complex →
        rawvideo 管道）→ 保留标记 / 波形 / 逐帧步进 / A-V 仲裁，且无需 mpv 即可预览拼接+转场效果。
        时间轴口径 = **输出时间轴**（pipe_out_mode）：图的 trim/xfade 偏移都是段内素材绝对时间，
        seek 只能走输出侧 trim（正确但比素材时间轴模式慢）。默认 False ⇒ 走 mpv / ffplay 外部播放器。"""
        if alert_if(not self.concat_enabled.get(), _("提示"), _("请先勾选「串行合并（首尾拼接）」模式再使用滤镜版预览"), 'info'):
            return
        # #5（2026-10-08）：串行合并图由 `_build_concat_video_graph` **逐段**构建，轨迹目标是
        # 「某一段」——弹窗里未提交的航点在图里**没有段身份可辨**（每段 settings 各自独立），
        # 注入必然串味。故本入口不做注入，只明确提示（不静默，避免用户以为已生效）。
        if _live_wp_override(extra_kw) is not None:
            self._append_info_ui(
                _("[时间预览] 串行合并预览暂不支持未保存的列表轨迹坐标即时生效，请保存后重开预览"))
        if not self.ffmpeg_cmd:
            self._append_info_ui(_("[预览] 未找到 ffmpeg，无法生成滤镜版预览"))
            return
        # ⚠️ 2026-09-21 **重开 ffplay 回退**（旧版 2026-09-20 因「-autoexit 按主输入 EOF 退窗 →
        # 播完首段即退 / 去掉 -autoexit 又不关窗」把它整体删掉）。病根已定位为**主输入选错**：
        # 改用 `-f lavfi -i "<全 movie= 合成图>"` 后，主输入的 EOF 就是**图的 EOF**（= 整段拼接
        # 时长）⇒ 全播完才自动关窗、且不需要 -t。真机证据见 _concat_graph_to_ffplay docstring
        # 与 research/ffplay-preview/README.md §4.5d。管道模式（pipe_engine）不启动播放器，跳过守卫。
        _mpv_ok = False
        if not pipe_engine:
            if self.use_mpv.get() and self._mpv_ready(log=False):
                _mpv_ok = True
            elif not self.ffplay_cmd:
                messagebox.showwarning(
                    _("提示"),
                    _("串行合并滤镜版预览需要 mpv 或 ffplay：\n"
                    "mpv 不可用（%s 无法启动），且未找到 ffplay。\n"
                    "请在「信息与播放器」页设置播放器路径，"
                    "或改用右键「串行合并预览 (mpv EDL)」查看拼接效果。")
                    % (self.mpv_path.get().strip() or _("未设置")))
                return
            else:
                self._append_info_ui(
                    _("[预览] mpv 不可用（%s 无法启动）→ 串行合并滤镜版预览改用 ffplay"
                    "（-f lavfi 全 movie= 图：播完自动关窗；窗口内不支持 seek）")
                    % (self.mpv_path.get().strip() or _("未设置")))

        enabled_tracks = [t for t in self.merge_tracks if t.enabled]
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if alert_if(not video_tracks, _("提示"), _("没有可用于预览的视频轨道")):
            return
        # 轨数上限：复用「更多设置 → 预览轨数上限」（与画中画实时预览同一设置）。
        # 轨数越多滤镜图越大、mpv 首次加载越慢（实测 60+ 轨要等 20 秒以上，极易被误判成卡死），
        # 故预览只渲染前 N 轨；正式合并输出不受此限制。
        _sv_max = max(1, min(30, self.sub_video_preview_max.get()))
        if len(video_tracks) > _sv_max:
            self._append_info_ui(
                f"[预览] 视频轨 {len(video_tracks)} 个超过上限 {_sv_max}"
                f"（「更多设置 → 预览轨数上限」可调），滤镜版预览仅渲染前 {_sv_max} 轨"
                f"（正式合并输出不受影响）")
            video_tracks = video_tracks[:_sv_max]
        if len(video_tracks) == 1:
            self._append_info_ui(
                _("[预览] 仅 1 个视频轨：滤镜版预览等价于该轨单轨预览（无转场），"
                "建议用主「预览」按钮查看该轨滤镜。"))
        main_video = video_tracks[0]
        main_file = normalize_path(main_video.file_path)
        # 2026-10-09：颜色虚拟源作首轨（color 基源）——不是真实文件，不能走 os.path.exists 判据，
        # 也不当位置输入；下方两路把输入换成 mpv `av://lavfi:<spec>` / ffplay `-f lavfi -i <spec>`，
        # 图内 [vid1] 照旧指「首轨输入」（见 _virtual_mpv_input）。
        _main_is_color = _is_virtual_source(main_video.file_path)
        if not _main_is_color and not os.path.exists(main_file):
            self._append_info_ui(f"[预览] 主视频文件不存在: {main_file}")
            return

        # ---- 主视频规格（color 基源尺寸/帧率用；移到图构建前，供管道引擎上限统一）----
        main_orig_w, main_orig_h = self._cached_video_dimensions(main_video.file_path)
        if (main_orig_w is None or main_orig_h is None or main_orig_w <= 0 or main_orig_h <= 0):
            main_orig_w, main_orig_h = 1280, 720
        main_target_w, main_target_h = self.compute_final_size_with_order(
            main_orig_w, main_orig_h, main_video.enc_settings)
        if main_target_w <= 0 or main_target_h <= 0:
            main_target_w, main_target_h = main_orig_w, main_orig_h
        # 管道引擎工作分辨率上限（与画中画分支同口径，复用 _PIPE_WORK_MAX_W）：
        # 仅 pipe_engine 生效；GPU 路线（mpv/ffplay）全分辨率由硬件跑，不动。
        #
        # ⚠️ 2026-10-06 修 NameError（用户实测「串行合并预览只提示一下、不出画面」）：
        # 末端处理注入块已提到 `if pipe_engine:` 之外（两条路线共用），但缩放倍数**只有管道
        # 路线才会算**（`_pwf` 在下面那个 if 里赋值）⇒ 外部播放器路线（pipe_engine=False）
        # 读 `_pwf` 直接 NameError，整个 merge_preview_concat_lavfi 抛异常 → 窗口不开、
        #   日志正好停在崩溃点前两行。更隐蔽的是：管道路线下若视频 ≤_PIPE_WORK_MAX_W（如
        #   1280x720），`_pwf` 同样没赋值 → 一样崩（只有 4K 侥幸躲过）。
        # 口径统一成 `_eh_scale_f`：**先无条件给默认 1.0（= 不缩放）**，管道分支命中时再更新。
        # 1.0 传给 scale_preview_border_px 是恒等返回 ⇒ GPU 路线零行为变化（硬件全分辨率跑，
        # 边框就该是设置里的绝对像素，与画中画 GPU 路线同口径）。
        _eh_scale_f = 1.0
        _pw_cap_w = None
        if pipe_engine and main_target_w > _PIPE_WORK_MAX_W and main_target_h > 0:
            _pwf = _PIPE_WORK_MAX_W / float(main_target_w)
            _eh_scale_f = _pwf
            main_target_w = max(2, int(main_target_w * _pwf) // 2 * 2)
            main_target_h = max(2, int(main_target_h * _pwf) // 2 * 2)
            _pw_cap_w = _PIPE_WORK_MAX_W
        if main_video.enc_settings.get("frame_rate_type") == "custom":
            target_fps = _opt_float(main_video.enc_settings.get("frame_rate_custom", "30") or "30", 30.0)
        else:
            target_fps = self._get_video_framerate(main_video.file_path) or 30.0

        # ---- 1. 视频链：复用串行合并单一来源（与正式命令一致）----
        # 先给一条「正在构建」日志：多轨时 mpv 首次加载可能数秒以上，没有回执很像卡死
        self._append_info_ui(
            f"[预览] 正在构建滤镜版预览（{len(video_tracks)} 轨）…首次加载可能需数秒，请稍候")
        # 透明预览判据（2026-10-12）：串行各段**并列**拼成输出 ⇒ 任一段透明都要垫棋盘，
        # 故这里必须用 `_merge_needs_alpha`（concat 口径 = 任一轨命中），不能沿用
        # `_open_pipe_time_preview` 的自动判（那是「主视频设置」口径 = 只看首轨 ⇒ 非首段的
        # 透明度会被漏掉，用户报「串行合并管道预览没画棋盘」）。判一次、三处用
        # （源前置格式 / 逐段归一格式 / 管道门控）。
        # ⚠️ 只对**管道预览**生效：棋盘格是 SimplePreviewer 专属，mpv/ffplay 路线没有透明指示
        #    ⇒ 那条路线的图保持旧样（逐字节不变），别顺手放开。
        _alpha_need = bool(pipe_engine) and self._merge_needs_alpha(video_tracks)
        # 源前置 format：默认 yuv420p 会把「透明色块源 / 自带 alpha 的素材」的 alpha 当场抹平，
        # 后面逐段归一再带 alpha 也救不回来（实测：透明首段 + 棋盘 ⇒ 全黑）。
        _src_fmt = "yuva420p" if _alpha_need else "yuv420p"
        (filter_parts, v_labels, seg_durations,
         trans_effective, total_dur) = self._build_concat_video_graph(
            video_tracks, global_norm=self._concat_norm_global_on(),
            preview_work_cap=_pw_cap_w, alpha=_alpha_need)
        # 同 _build_concat_cmd：把成片总时长刷成「最近值」供命令编辑器文本兜底预览封顶
        # （预览优先 workflows：用户先看页面预览再进编辑器，命令构建器还没跑过）。
        self._last_merge_total_dur = total_dur
        if not filter_parts or total_dur is None or total_dur <= 0:
            self._append_info_ui(_("[预览] 视频链构建失败，无法预览"))
            return

        # ---- 2. 输入挂接：为每个 [i:v] 定义源（位置文件 + movie）----
        source_parts = []
        for i, trk in enumerate(video_tracks):
            fp = normalize_path(trk.file_path)
            dur_i = seg_durations[i] if i < len(seg_durations) else 10.0
            if dur_i is None or dur_i <= 0:
                dur_i = 10.0
            if self._is_static_image(fp):
                # 图片：color 基源(有限时长) + overlay 包裹（单帧 eof_action=repeat 撑出 dur_i 秒）；
                # 基源尺寸取图片原生尺寸，再由逐轨 scale 统一到主视频规格（与正式命令一致，避免 overlay 裁切）。
                md = self._get_video_dimensions_cached(fp)
                iw = int(md[0]) if md and md[0] else main_target_w
                ih = int(md[1]) if md and md[1] else main_target_h
                if iw <= 0: iw = main_target_w
                if ih <= 0: ih = main_target_h
                if i == 0:
                    # 主位置文件：图片 → [vid1] 作次输入
                    source_parts.append(f"[vid1]format={_src_fmt}[img{i}]")
                else:
                    safe = self._movie_path_safe(fp, i).replace("\\", "/").replace(":", "\\\\:")
                    source_parts.append(f"movie={safe}[img{i}]")
                # 基源段与图源段互不依赖（filtergraph 按标签拓扑排序）→ 两分支共用一行，
                # 不再各写一遍（旧版 if/else 里两行完全相同）。
                source_parts.append(
                    f"color=c=black@0:s={iw}x{ih}:r={target_fps:g}:d={_ffsec(dur_i)}[base{i}]")
                source_parts.append(
                    f"[base{i}][img{i}]overlay=format=auto:eof_action=repeat,format={_src_fmt}[{i}:v]")
            else:
                # 视频：连续流，movie/位置流 + format 即可（无需 color 包裹——此为「扩展到视频类型」的核心）
                if i == 0:
                    source_parts.append(f"[vid1]format={_src_fmt}[{i}:v]")
                else:
                    safe = self._movie_path_safe(fp, i).replace("\\", "/").replace(":", "\\\\:")
                    source_parts.append(f"movie={safe},format={_src_fmt}[{i}:v]")

        # ---- 3. 文字水印/倒计时（与正式命令同开关；全子图 route [vout]→[v_tw]）----
        # 注：正式命令把非旋转 drawtext 内联进 global_video_filters 以省子图；预览统一走
        # build_text_watermark_chain 全子图（视觉等价，省去与正式命令的重复分叉）。
        self._apply_merge_text_watermark([main_video])
        tw_frag = build_text_watermark_chain(main_video.enc_settings,
                                            main_label="[vout]", out_label="[v_tw]")
        if tw_frag:
            # 旋转子图含 color 无限源：eof_action=pass + 末端 trim 双保险（与画中画预览一致）
            tw_frag = tw_frag.replace(":format=auto", ":format=auto:eof_action=pass")
            filter_parts.append(tw_frag)
            vmap = "[v_tw]"
        else:
            vmap = "[vout]"

        # ---- 4. 音频：镜像正式串行合并音频链（真实音轨/静音底噪 + acrossfade + BGM）----
        # 源用 movie=<路径>:s=a 显式取，绕开 mpv [aidN] 按「含音轨文件」独立计数的编号陷阱。
        (audio_src_parts, audio_parts,
         amap, audio_summary) = self._build_concat_audio_graph_mpv(
            video_tracks, seg_durations, trans_effective, total_dur, main_video)
        # 末端钳到 total_dur：正式命令靠 -shortest 收敛，mpv 预览无 -shortest → 显式等长，
        # 避免跨段重叠/BGM 的 duration=longest 把音频拖得比视频长。
        audio_parts.append(
            f"{amap}atrim=0:{_ffsec(total_dur)},apad=whole_dur={total_dur:.3f},"
            f"asetpts=PTS-STARTPTS[ao]")

        # ---- 5. 末端收尾：trim 到 total_dur（防无限源撑长）+ [vo] ----
        filter_parts.append(f"{vmap}trim=0:{_ffsec(total_dur)},setpts=PTS-STARTPTS[vo]")

        # ---- 末端处理接入（2026-08-27 引入管道路线；2026-10-06 提升为**两条路线共用**）----
        # split 网格不需要额外输入流（split 自复制主画面）→ 管道与外部播放器都能完整支持；
        # 末端 concat 图片/视频需要额外输入文件，预览不支持（两条路线同限），日志明示。
        # 注入点 = 视频链终端段（{vmap}trim=0:T,setpts=PTS-STARTPTS[vo]）末尾，与正式命令
        # 「末端处理链尾最外层」口径一致。split/concat 互斥、concat 优先（同 _apply_end_handling_cmd）。
        #
        # ⚠️ 2026-10-06 提到 `if pipe_engine:` **之外**：原先整块嵌在管道分支里 ⇒
        # 「实时预览（复杂滤镜）」（外部播放器 mpv/ffplay）在串行合并模式下**完全看不到**
        # 末端 split/边框，只显示主视频单画面（用户实测报告）。而这段注入只改`filter_parts`
        # 里的视频链段，两条路线共用同一张 `filter_parts`（外部播放器在下方
        # `graph = ";".join(source_parts + audio_src_parts + filter_parts + audio_parts)` 合图）
        # ⇒ 提到外面后两条路线自动都生效，且**同一张图**、不会出现两套口径。
        # 缩放倍数用 `_eh_scale_f`（无条件有值），**不能直接用 `_pwf`** —— 后者只在管道分支
        # 赋值，外部播放器路线读它会 NameError（详见上方 `_eh_scale_f` 处的说明）。
        _eh_c = scale_preview_border_px(self._merge_end_handling, float(_eh_scale_f))
        _bp_c = build_preview_border_frag(_eh_c)
        try:
            _cr = max(1, int(_eh_c.get("split_rows", 1) or 1))
            _cc = max(1, int(_eh_c.get("split_cols", 1) or 1))
        except (ValueError, TypeError):
            _cr = _cc = 1
        _cn_c = _cr * _cc
        _split_c = (bool(_eh_c.get("split_enabled", False))
                    and not bool(_eh_c.get("concat_enabled", False))
                    and (2 <= _cn_c <= 5))
        _bp_before_c = bool(_bp_c) and _split_c and (not bool(_eh_c.get("border_after_split", True)))
        if (_eh_c.get("concat_enabled", False)
                and (_eh_c.get("concat_path", "") or "").strip()):
            self._append_info_ui(
                _("[预览] 末端 concat（追加图片/视频）在预览中不支持（需额外输入流），仅正式导出生效"))
        if (_split_c or _bp_c) and filter_parts and filter_parts[-1].endswith("[vo]"):
            _seg0 = filter_parts[-1][:-4]     # 去掉末尾 [vo]，末端段以逗号接在其后
            if _split_c and _bp_before_c:
                # before（间隙模型）：网格段自带逐格非对称 pad，直接接在终端段后
                filter_parts[-1] = (_seg0 + ","
                                    + build_end_split_filters(
                                        _cr, _cc, "", "[vo]",
                                        border=build_split_border_cfg(_eh_c)))
            elif _split_c and _bp_c:
                # after（网格外框）：网格段先出 [vo2]，pad 再包在**网格之外** ——
                # 与成片 _apply_end_handling_cmd 同款（split→mid_out、pad→v_end_out），
                # 也与画中画 _pip_split_parts + _bp_tail 的处理一致。
                # ⚠️ 2026-10-06 修复：原先这一档**只出网格、边框被静默丢弃**（用户看不到边框），
                #   因为 pad 片段只挂在「无 split」的 else 档上。
                filter_parts[-1] = (_seg0 + ","
                                    + build_end_split_filters(_cr, _cc, "", "[vo2]")
                                    + ";[vo2]" + _bp_c + "[vo]")
            elif _split_c:
                # in_label 留空 = split 直接逗号接在前链后（无标签链继续，合法）
                filter_parts[-1] = (_seg0 + ","
                                    + build_end_split_filters(_cr, _cc, "", "[vo]"))
            else:
                filter_parts[-1] = _seg0 + "," + _bp_c + "[vo]"
            if _split_c:
                self._append_info_ui(
                    f"[预览] 实时预览：多画面拼接 {_cr}x{_cc}"
                    + (_("（等宽边框）") if _bp_before_c
                       else (_("（网格外框）") if _bp_c else "")))
            elif _bp_c:
                self._append_info_ui(_("[预览] 实时预览：已叠加末端边框"))

        # ---- 【时间预览引擎】管道合成模式（2026-09-20，开放串行合并）----
        # 不启动 mpv：把同一张串行合并图改喂内置时间预览窗口（ffmpeg -filter_complex → rawvideo
        # 管道）→ 保留标记 / 波形 / 逐帧步进 / A-V 仲裁。
        # · 只取**视频链**（source_parts + filter_parts）：音频段整体不带入——管道只出画面，
        #   声音由预览窗口的 ffplay 引擎按主文件播放（带音频段会让 movie=:s=a 源悬挂、图变脏）。
        # · [i:v] 是串行视频图的内部标签，与 ffmpeg 输入流标签 [0:v] 同名 → 先整体改名成 [svi]，
        #   再由 _lavfi_complex_to_ffmpeg_pipe 把主输入 [vid1] 映射成 [0:v]，避免自引用。
        # · 时间轴 = **输出时间轴**（out_dur=total_dur → pipe_out_mode）：拖动进度条走输出侧
        #   trim（慢但正确）；打开时定位在调用方给的 out_start。
        #   🔴 out_start **恒 0.0** ⇒ 进度条/数字**故意从 0 开始**（= 成片时间轴）。别改成
        #   素材轴：多段成品必须 0 基，且合成音频图是 0 基 ⇒ 改轴会让声音错位/断续（2026-10-13
        #   的「素材轴呈现」A 案已整体回退）。见 research/seek-model/README.md §4.1。
        if pipe_engine:
            # 2026-10-12：**撤回** 2026-10-09 那道「颜色虚拟首轨不支持内置时间预览引擎」门控。
            # 已过时：管道引擎主输入支持虚拟源（`-f lavfi -i <spec>`，见 `_launch_video_pipe`），
            # 首轨 [vid1] 经 `_lavfi_complex_to_ffmpeg_pipe` 映到 [0:v] 后正指向该 lavfi 输入
            # ⇒ 合成图一字不改；本分支的 out_mode 输入也已补上虚拟源处理。
            # （虚拟源时长由自身 `d=` 牵引 EOF，out_dur=total_dur 已下传，时间轴照常。）
            _vg = ";".join(source_parts + filter_parts)
            for _i in range(len(video_tracks)):
                _vg = _vg.replace("[%d:v]" % _i, "[sv%d]" % _i)
            # 输出比例（与画中画分支同口径）：网格把输出放大 cols×/rows×，边框再加边距——
            # 不下传真实比例，2 格拼接会被按源比例的预览框 letterbox（用户实测黑边）。
            _bw_c = _bh_c = 0
            if _bp_c:
                try:
                    _bw_c = (max(0, int(_eh_c.get("border_left", 0) or 0))
                             + max(0, int(_eh_c.get("border_right", 0) or 0)))
                    _bh_c = (max(0, int(_eh_c.get("border_top", 0) or 0))
                             + max(0, int(_eh_c.get("border_bottom", 0) or 0)))
                except (ValueError, TypeError):
                    _bw_c = _bh_c = 0
            if _split_c and _bp_before_c:
                # 间隙模型：外围只加一次 + 格间 (cols-1)/(rows-1) 条缝隙（≠ 每格都 +四边距）
                _pow_c, _poh_c = build_split_grid_size(
                    _cr, _cc, main_target_w, main_target_h,
                    max(0, int(_eh_c.get("border_left", 0) or 0)),
                    max(0, int(_eh_c.get("border_right", 0) or 0)),
                    max(0, int(_eh_c.get("border_top", 0) or 0)),
                    max(0, int(_eh_c.get("border_bottom", 0) or 0)))
            else:
                _pow_c = main_target_w * (_cc if _split_c else 1) + _bw_c
                _poh_c = main_target_h * (_cr if _split_c else 1) + _bh_c
            _pipe_ar = (float(_pow_c) / _poh_c) if _poh_c > 0 else None
            # 合成音频图（2026-09-20）：不直读主文件音轨（主文件=第一段 → 播完第一段就无声，
            # 用户实测），把 audio_src_parts + audio_parts 原样拼成**独立 lavfi 图**交给
            # ffplay -f lavfi 播放——声音跨段连续、与 xfade 画面对齐，seek 由 _a_start 在
            # 图末追加 atrim=start=at（输出时间轴，与视频 out_mode 同口径）。
            _a_graph = None
            # 图的**末输出标签恒为 [ao]**（上面音频段最后一截 atrim+apad 钳到 total_dur 的
            # 输出）；amap 是钳制前的中间标签，别在这里用
            _a_map = "[ao]"
            try:
                if audio_src_parts or audio_parts:
                    _a_graph = ";".join(audio_src_parts + audio_parts)
                    # 🔴 2026-10-13 修复「串行管道预览没声（要等几十秒才出声）」：
                    # 本图的声音源是 `movie=<素材>:s=a[amN]`，链上是 `[amN]atrim=start=S段起点`
                    # ——ffplay 必须**从素材 0 解码到 S** 才吐第一个采样（用户素材 S=5052s
                    # ⇒ 空解 ~50s 才有声）。而普通/画中画模式的声音走
                    # `ffplay -ss 粗值 self.file`（_a_start 的 else 分支），天然吃输入级
                    # seek ⇒ 秒出声；mpv/ffplay 回退预览那条路径也早在下方
                    # `graph = ..._inject_movie_seek_point_per_sub(graph)` 注入过（那条图**含
                    # 音频段**）⇒ 唯独管道这条漏了。这里补上完全同款的注入（幂等、异常原样返回）。
                    # ⚠️ 不能指望运行时补：`_a_start` 只给 `amovie=` 补 seek_point，而本图用的是
                    # `movie=...:s=a` ⇒ 运行时补丁够不着，必须在**建图时**注入。
                    try:
                        _a_graph = SimplePreviewer._inject_movie_seek_point_per_sub(_a_graph)
                    except Exception:
                        pass
            except Exception:
                _a_graph = None
            self._append_info_ui(
                f"[时间预览] 串行合并管道合成预览：{len(video_tracks)} 段"
                f"（ffmpeg -filter_complex → rawvideo；总时长 {total_dur:.2f}s；"
                f"含逐轨滤镜 + 转场 + 文字水印"
                + (_("；音频走合成图 ffplay -f lavfi）") if _a_graph else _("；无音频图，预览静音）")))
            self._open_pipe_time_preview(
                main_file, dict(main_video.enc_settings or {}), _vg, None, None,
                aspect=_pipe_ar, out_dur=total_dur, out_start=0.0,
                pipe_audio_graph=_a_graph, pipe_audio_map=(_a_map or "[ao]"),
                # 透明指示棋盘（2026-10-12）：串行合并显式下传 —— 判据是「任一段透明」
                # （_merge_needs_alpha 的 concat 口径），不是 _open_pipe_time_preview 的
                # 自动判（那个只看首轨设置 ⇒ 非首段的透明度会漏，见该处 docstring）。
                pipe_alpha=_alpha_need,
                extra_kw=extra_kw)
            return

        graph = ";".join(source_parts + audio_src_parts + filter_parts + audio_parts)
        # 音频节点效果（2026-09-26）：串行合并预览图同样叠加（与导出同口径；预览图与正式图结构
        # 略异时走 anchor 重锚，对不上就跳过 —— 导出端保证生效）。
        if getattr(self, "node_audio_fx", None):
            try:
                graph, _fx_final_lbl = self._apply_node_audio_fx(
                    graph, "afinal" if "[afinal]" in graph else ("aout" if "[aout]" in graph else "out"),
                    anchor_nodes=graph_nodes(getattr(self, "_last_graph", "") or ""))
            except Exception as _e:
                self._append_info_ui(f"[音频节点] 预览叠加失败（按原图继续）: {_e}")
        # 回退路径提速：给 concat 图内 movie= 子输入（音频 :s=a / 视频轨 i>0）注入各自 trim/atrim
        # 起点的 seek_point（向后关键帧 seek，避免从 0 空解到起点；与正常预览 --hr-seek=no 同效）。
        # 主视频轨(track0) 走位置文件 [vid1]，无法用 seek_point → 改由下方 mpv --start 快进。
        graph = SimplePreviewer._inject_movie_seek_point_per_sub(graph)
        if not _mpv_ok:
            # ---- ffplay 回退（2026-09-21 重开）：`-f lavfi` 当主输入 ----
            # 主输入不再是文件而是**整张图** ⇒ 主输入 EOF = 图 EOF = 整段拼接时长 ⇒
            # -autoexit 全播完才关窗（这正是旧版删掉这条回退的原因，现已破）。
            _main_movie = (None if _main_is_color else
                           self._movie_path_safe(main_file, 0)
                           .replace("\\", "/").replace(":", "\\\\:"))
            # 与 mpv 同图：先注入 movie= 子输入 seek_point，再交给 _concat_graph_to_ffplay
            # 改写 [vid1]→movie（并补主视频轨 seek_point）。ffplay 不可 --start，只靠 seek_point。
            _inj_graph = SimplePreviewer._inject_movie_seek_point_per_sub(
                ";".join(source_parts + audio_src_parts + filter_parts + audio_parts))
            _ff_graph = self._concat_graph_to_ffplay(
                _inj_graph, _main_movie,
                color_spec=(_virtual_lavfi_spec(main_video.file_path) if _main_is_color else None))
            if not _ff_graph:
                self._append_info_ui(
                    _("[预览] 串行合并预览：mpv 不可用且 mpv 图转 ffplay 失败，无法预览"))
                return
            cmd = [self.ffplay_cmd, "-autoexit", "-volume", str(self.preview_volume.get())]
            # ⚠️ 不给 -ss：-f lavfi 的输入不可 seek，给了只会打一行
            #    "could not seek to position N" 然后**从头播**（实测 -ss 2 + 4s 图仍 4.37s）；
            #    缩略图口径与管道引擎的「输出时间轴」一致 —— 要定位只能靠图内输出侧 trim。
            # ⚠️ 不给 -t：图末端 trim 已把时长钳到 total_dur；-t 是「主输入 pts 上限」的读包级
            #    判据，在这里既多余又可能误丢包（见 ffplay-preview README §3b/§4.5d）。
            cmd.extend(["-f", "lavfi", "-i", _ff_graph])
            # 缩放到屏幕内（复用与画中画/PiP 回退同口径的 preview_margin 算法）。
            cmd.extend(self._ffplay_fit_scale(main_target_w, main_target_h))
            cmd.extend(["-window_title", _("预览(串行合并): ") + os.path.basename(main_file)])
            self._append_info_ui(
                f"[预览] 滤镜版串行合并预览：ffplay -f lavfi（{len(video_tracks)} 轨，"
                f"总时长 {total_dur:.2f}s；含逐轨滤镜 + 转场 + 文字水印；音频：{audio_summary}）")
            self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
            # ffplay 滤镜图出错时 rc 仍为 0（README §4.7）→ 必须走 stderr 扫描那条路。
            self._spawn_player_stderr_scan(cmd, scan_ffplay=True)
            return

        # 主视频轨 trim 起点 → mpv --start 快进（位置文件无法走 seek_point，用输入级 seek 等效提速）；
        # --hr-seek=no 落到关键帧（图内 trim 兜底吸收 GOP 偏移，预览「快」优先，与正常预览一致）。
        # ffplay 不可 --start，故回退路径只注入 seek_point（见上方 _inj_graph），不要求本段。
        _mpv_extra = ["--hr-seek=no"]
        _ms0 = main_video.enc_settings if main_video is not None else {}
        # 颜色首轨：输入是 null://（不可 seek），且图内已 0 基 → 跳过 --start（画面不受影响）。
        if _ms0.get("trim_enabled", False) and not _main_is_color:
            _s0 = (_ms0.get("trim_start", "") or "").strip()
            if _s0:
                try:
                    _s0_sec = time_to_seconds(_s0)
                except Exception:
                    _s0_sec = 0.0
                if _s0_sec and _s0_sec > 0:
                    _mpv_extra.insert(0, f"--start={_s0_sec:g}")
        player = self.mpv_path.get().strip() or "mpv"
        # 2026-10-09：颜色首轨 —— 位置输入换 `av://lavfi:<spec>`（真机实测可播、alpha 保留，
        # 图内 [vid1] 直接指到它 ⇒ 既有图一字不改）。裸哨兵 / lavfi: / ffmpeg://lavfi: 皆 exit 1。
        _mpv_main_file = ((_virtual_mpv_input(main_video.file_path) or main_file)
                          if _main_is_color else main_file)
        cmd = [player, _mpv_main_file, f"--lavfi-complex={graph}", f"--length={total_dur:g}"] + _mpv_extra
        self._append_info_ui(
            f"[预览] 滤镜版串行合并预览：mpv lavfi-complex（{len(video_tracks)} 轨，"
            f"总时长 {total_dur:.2f}s；含逐轨滤镜 + 转场 + 文字水印；音频：{audio_summary}）")
        self._append_info_ui(_("执行命令: ") + format_cmd_for_display(cmd))
        try:
            flags = _ffmpeg_spawn_flags()
            # 开新预览前先关掉上一次预览的播放器（防两窗口同时出声 = 重音）；
            # 登记句柄供下一次预览关闭。
            self._reap_prev_preview_player()
            self._preview_player_proc = subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                creationflags=flags)
            _register_preview_proc(self._preview_player_proc)
        except Exception as e:
            # 兜底：Popen 抛 OSError=mpv 进程起不来（不可用），标记标志供后续预览直接回退
            self._mpv_usable = False
            self._mpv_verified = True   # 已实测失败，后续预览直接回退不再重试子进程
            self._append_info_ui(f"[预览] mpv 启动失败: {e}（已标记 mpv 不可用，请检查路径或用 EDL 预览）")
    def _time_preview_pipe_current(self, extra_kw=None):
        """转码页「时间预览引擎」：把当前设置的合成图（图片水印/旋转/裁剪/画布/文字水印/
        变速）喂给内置时间预览窗口 —— ffmpeg -filter_complex → rawvideo 管道渲染合成画面，
        不启动 mpv/ffplay，因此保留标记 / 波形 / 逐帧步进 / 循环预览 / A-V 仲裁。

        为什么这里安全（Phase 1 只开单输入）：转码页是**单文件**，图内除图片水印（`movie=`
        静态图、无时间轴）外没有别的子输入 → 双 -ss 语义完全正确。
        多输入（画中画子视频 / 串行合并）的 seek 对齐属 Phase 2，见
        research/preview/README1.md 修正表 #2/#3。"""
        path = (self.input_file.get() or "").strip()
        if alert_if(not path or not os.path.exists(path), _("提示"), _("请先选择有效的输入文件")):
            return
        if alert_if(not self.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        try:
            settings = self.get_current_settings()
        except Exception as e:
            self._append_info_ui(_('[时间预览] 读取当前设置失败: {0}').format(e))
            return
        try:
            self._preview_with_settings(normalize_path(path), settings, pipe_engine=True,
                                        extra_kw=extra_kw)
        except Exception as e:
            self._append_info_ui(_('[时间预览] 打开失败: {0}').format(e))
            messagebox.showwarning(_("提示"), _('时间预览引擎启动失败：{0}').format(e))

    def _dispatch_merge_preview(self, pipe_engine=False, on_single=None, pip_enabled_gate=True,
                                extra_kw=None):
        """按当前合并模式选合成图并预览 —— 三个预览入口共用的唯一分派点（2026-09-22 收敛）。

        此前 `_live_preview_pipe` / `_live_preview_player` / `_time_preview_pipe_merge` 各写
        了一遍同款的 `if concat_enabled → … elif pip_enabled → …`，改一处忘两处（历史已发生：
        串行合并刚接进管道引擎时只改了其中一个入口）。现把模式判定收成一处：
          · 串行合并 → merge_preview_concat_lavfi(pipe_engine=...)
          · 画中画   → merge_preview_pip_live(pipe_engine=...)
          · 单轨     → 调 on_single()（有传）或返回 False（调用方继续自己的单轨逻辑）
        ⚠️ 两者的**图构建内核**刻意不合并（concat 是多段 + xfade 的输出时间轴，画中画是主 +
        movie= 子视频的叠加图），且命令行三轴也不同（串行走 `-f lavfi -i` 且不给 -ss/-t），
        强行并成一个函数体会变成架构重写 —— 见 `_live_preview_player` docstring 的定案。

        :param pip_enabled_gate: 仅当为 True 时 `pip_enabled` 才触发画中画分派（默认 True）。
            `_time_preview_pipe_merge` 单轨兜底传 False：仅 1 视频轨无可叠加子视频，画中画分派
            无意义，落到 on_single（单轨实现）与旧行为一致；两入口分派器不传则保持「画中画优先」。
        :param extra_kw: 透传给下游（列表轨迹时间预览 #1）的额外 show_time_picker 参数；
            缺省 None ⇒ 旧行为不变。on_single 由调用方闭包捕获 extra_kw，本函数不代传。
        :return: True = 已分派并处理；False = 单轨且无 on_single（调用方自行兜底）
        """
        if self.concat_enabled.get():
            self.merge_preview_concat_lavfi(pipe_engine=pipe_engine, extra_kw=extra_kw)
            return True
        if self.pip_enabled.get() and pip_enabled_gate:
            self.merge_preview_pip_live(pipe_engine=pipe_engine, extra_kw=extra_kw)
            return True
        if on_single is not None:
            on_single()
            return True
        return False

    def _time_preview_pipe_merge(self, extra_kw=None):
        """合并页单轨管道预览实现（_live_preview_pipe 分派器的兜底；原独立菜单入口已删，
        2026-09-20 与「实时预览（简易时间引擎）」合并为一个自动分派入口）。对【主视频轨】的
        合成（滤镜/水印/画布/裁剪/旋转，以及画中画多视频合成）开管道合成预览。

        单个视频轨（Phase 1，2026-09-20）：走 `_preview_with_settings(pipe_engine=True)`
        ——图内除图片水印（movie= 静态图）外无别的子输入，双 -ss 语义完全正确。

        多视频轨（Phase 2，2026-09-20 用户拍板开放）：委托 `merge_preview_pip_live(
        pipe_engine=True)`，复用同一张 PiP 合成图、只把渲染目标换成内置时间预览窗口。
        子视频时间轴口径与 mpv / ffplay 实时预览、以及正式导出**完全一致**。
        需要先勾选「启用画中画」，否则这些轨并不参与合成，预览会与成片不符。

        串行合并（concat，2026-09-20 开放）：勾选了「串行合并（首尾拼接）」时改走
        `merge_preview_concat_lavfi(pipe_engine=True)` —— 多段 + xfade 转场 + 逐轨滤镜 +
        文字水印，时间轴是**输出时间轴**（打开定位在 0，拖动走输出侧 trim）。
        """
        enabled_tracks = [t for t in self.merge_tracks if t.enabled]
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if not video_tracks:
            self._append_info_ui(_("[时间预览] 没有启用的视频轨道"))
            return
        # 先做「多轨但未勾画中画」的守卫（提示必须早于分派，否则用户会看到与成片不符的图）。
        if len(video_tracks) > 1 and not self.pip_enabled.get() and not self.concat_enabled.get():
            self._append_info_ui(
                _('[时间预览] 检测到 {0} 个视频轨——多轨合成需先勾选「启用画中画」（否则这些轨不参与合成，预览与成片不符）；或只启用单个视频轨，走单轨管道预览').format(len(video_tracks)))
            return
        # 分派（串行合并优先：它的图是多段 + xfade 的「输出时间轴」，与画中画的叠加图完全
        # 不同，必须走 concat 专用图；多轨且勾画中画 → 画中画图）。单轨即便勾了「启用画中画」
        # 也无可叠加子视频，应走单轨实现（旧行为）——故 pip 路由以多轨为前提（pip_enabled_gate），
        # 与两入口分派器默认「画中画优先」的口径不同：本条是单轨兜底，单轨+画中画=单轨预览。
        if self._dispatch_merge_preview(pipe_engine=True, extra_kw=extra_kw,
                                        on_single=lambda: self._time_preview_single_track(
                                            video_tracks, extra_kw=extra_kw),
                                        pip_enabled_gate=(len(video_tracks) > 1)):
            return

    def _time_preview_single_track(self, video_tracks, pipe_engine=True, extra_kw=None):
        """单轨预览实现（`_dispatch_merge_preview` 的单轨兜底；原方法体下半段抽出）。

        仅 1 个视频轨（或单轨兜底被触发）时，把该轨当单文件走 `_preview_with_settings`——
        图内除图片水印（`movie=` 静态图）外无别的子输入，双 -ss 语义完全正确。

        :param pipe_engine: True=内置时间预览窗口（ffmpeg 管道）；False=外部播放器
            （mpv / ffplay）。**2026-10-06 参数化**：`_live_preview_player`（实时预览·复杂滤镜）
            此前对单轨只打一行日志「请用预览轨道」，用户要求与另外两个入口对齐
            （管道引擎已三模式全支持，外部播放器没理由落后）→ 本条同时服务两个引擎。
            两个引擎的差别**仅在渲染目标**，`_preview_with_settings` 内部按 pipe_engine
            自行分派（同一套设置 → 同一张合成图），故复用同一函数体、零重复。
        """
        _main = video_tracks[0]
        path = normalize_path(_main.file_path)
        # 虚拟/生成源（color:/gen: 哨兵串）非磁盘文件，os.path.exists 恒 False —— 放行
        if not path or (not _is_virtual_source(path) and not os.path.exists(path)):
            self._append_info_ui(_("[预览] 主视频轨文件不存在"))
            return
        if alert_if(not self.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        # 与画中画实时预览同款：先把合并页的文字水印设置落到该轨 enc_settings，再当单文件预览
        with suppress(Exception):
            self._apply_merge_text_watermark([_main])
        # 末端处理接入（2026-09-20 用户实测：封装页普通模式管道预览看不到末端处理效果）：
        # 正式命令由 _apply_merge_end_handling 在构建后注入 self._merge_end_handling，
        # 轨道 enc_settings 里没有这个键 → 预览图里 split 网格/边框全丢。这里补注入
        # （_preview_with_settings 读 settings["end_handling"] 建末端段，与转换页同一条路径）。
        _s = dict(_main.enc_settings or {})
        with suppress(Exception):
            _s["end_handling"] = copy.deepcopy(self._merge_end_handling)
        try:
            self._preview_with_settings(path, _s, pipe_engine=pipe_engine, extra_kw=extra_kw)
        except Exception as e:
            _tag = _("时间预览引擎") if pipe_engine else _("实时预览")
            self._append_info_ui(_('[{0}] 打开失败: {1}').format(_tag, e))
            messagebox.showwarning(_("提示"), _('{0}启动失败：{1}').format(_tag, e))

    def _live_preview_pipe(self, extra_kw=None):
        """右键「实时预览（简易时间引擎）」：按当前合并模式选合成图，喂给内置时间预览窗口。

        本条的兄弟入口 `_live_preview_player`（右键「实时预览（复杂滤镜）」）走外部
        播放器（mpv / ffplay），性能通常更好，仅子视频过多时才相对吃力；本条是它的**内置引擎版**：
        ffmpeg -filter_complex → rawvideo 管道，由 SimplePreviewer 渲染 → 保留标记 / 波形 /
        逐帧步进 / A-V 仲裁，且不依赖 mpv。注意：内置引擎画面小、性能有限。按模式分派：
          · 串行合并 → merge_preview_concat_lavfi(pipe_engine=True)（多段 + xfade 图）；
          · 画中画   → merge_preview_pip_live(pipe_engine=True)（主 + movie 子视频图）；
          · 普通单轨 → _time_preview_pipe_merge()（该轨自身滤镜/水印/画布合成）。
        判定逻辑已收进 `_dispatch_merge_preview`（三入口共用），本方法只传引擎与单轨兜底。

        extra_kw（2026-10-08）：列表轨迹弹窗（#1）经宿主 `pipe_preview_cb` 调用本入口时下传的
        额外窗口交互参数（标记段 / on_coord_request 等）；缺省 None ⇒ 旧行为不变。
        """
        self._dispatch_merge_preview(pipe_engine=True, extra_kw=extra_kw,
                                     on_single=lambda: self._time_preview_pipe_merge(
                                         extra_kw=extra_kw))

    def _live_preview_player(self):
        """右键「实时预览（复杂滤镜）」：按当前合并模式选合成图，交外部播放器渲染。

        **入口收敛（2026-09-21 用户拍板）**：原为两条独立入口 ——「实时预览（画中画，可能卡顿）」
        → merge_preview_pip_live、「串行合并预览 (支持滤镜 lavfi)」→ merge_preview_concat_lavfi。
        两者本就走同一套外壳（模式守卫 / 取轨 / 轨数上限 / 文字水印注入 / seek_point 注入 /
        播放器启动与回收），差的只是**图构建内核**：
          · 画中画   = 主 `[vid1]` + 每子视频 `movie=` → `overlay` 叠加（overlay 栈）；
          · 串行合并 = `_build_concat_video_graph`（多段 + xfade 转场，与正式命令单一来源）。
        且末端处理、音频链、ffplay/mpv 命令行三处也各不相同（串行走 `-f lavfi -i 图`、**不给**
        `-ss`/`-t`、要 `--length`；画中画走 `-i 文件 -vf 图`、要 `-ss`/`-af`/`-t`）——要真并成
        一个函数体，得抽「图构建器」策略并把上述三轴一并参数化，属架构重写。故本轮**只收敛
        入口，实现体保留两个**（用户确认的方案）。

        与 `_live_preview_pipe` 的差别只在**渲染引擎**：本条走 mpv / ffplay 外部窗口（可能卡顿、
        窗口内无标记/波形/步进）；那条走内置时间预览窗口（ffmpeg 管道，不依赖 mpv）。

        **单轨模式已开放（2026-10-06，用户拍板）**：此前本条对单轨只打一行日志、让人改用
        「预览轨道」，但管道引擎那条（`_live_preview_pipe`）三个模式全支持、且单轨同样走
        `_preview_with_settings` —— 同一个函数体、只差渲染目标，没道理外部播放器落后。
        故单轨兜底改为复用 `_time_preview_single_track(pipe_engine=False)`：
        同样把该轨的滤镜/水印/画布/末端处理合成一张图交外部播放器，**与成片同口径**。
        （`merge_preview_track` 的「预览轨道」是另一回事：它按选中轨逐条预览、不注入
        封装页末端处理设置，两者互补不冲突。）
        """
        if self._dispatch_merge_preview(
                on_single=lambda: self._merge_single_track_player_preview()):
            return

    def _merge_single_track_player_preview(self):
        """`_live_preview_player` 的单轨兜底（2026-10-06 新增）。

        与 `_time_preview_single_track` 共用同一实现，只把渲染目标切到外部播放器。
        取轨口径对齐 `_time_preview_pipe_merge`：仅 1 个**启用的视频轨**才走单轨；
        多轨但未勾画中画/串行 → 明确提示（此时这些轨不参与合成，预览会与成片不符），
        而不是静默拿第一条糊弄过去。
        """
        enabled_tracks = [t for t in self.merge_tracks if t.enabled]
        video_tracks = [t for t in enabled_tracks if t.type == "video"]
        if not video_tracks:
            self._append_info_ui(_("[预览] 没有启用的视频轨道"))
            return
        if len(video_tracks) > 1:
            self._append_info_ui(
                _('[预览] 检测到 {0} 个视频轨——多轨合成需先勾选「启用画中画」或「串行合并」（否则这些轨不参与合成，预览与成片不符）；单轨请只启用一个视频轨').format(len(video_tracks)))
            return
        self._time_preview_single_track(video_tracks, pipe_engine=False)

    def _merge_preview_right_menu(self):
        """合并页预览按钮右键：快照 / 缩略图 / 实时预览 选择菜单"""
        menu = tk.Menu(self.root, tearoff=0)
        menu.add_command(label=_("快照（画中画合成）"), command=lambda: self.merge_preview_selected(with_snapshot=True))
        menu.add_command(label=_("缩略图"), command=self._contact_sheet_selected_track)
        # 「时间预览引擎（主视频轨合成）」入口已删除（2026-09-20 用户确认）：它与下面的
        # 「实时预览（简易时间引擎）」功能重复——后者按模式自动分派（串行合并图 / 画中画图 /
        # 单轨合成图），前者在被覆盖后只剩冗余。_time_preview_pipe_merge 方法保留：
        # 仍是 _live_preview_pipe 的单轨兜底实现（40901 行分派器调用）。
        menu.add_separator()
        # 实时预览（复杂滤镜）：入口收敛（2026-09-21 用户拍板）——原「实时预览（画中画，可能卡顿）」
        # 与「串行合并预览 (支持滤镜 lavfi)」合成一条，由 _live_preview_player 按当前模式自动分派。
        # 置灰口径跟随将要走的分支：串行合并模式需 mpv 或 ffplay；画中画/单轨模式恒可点
        # （单轨 2026-10-06 开放后走 _preview_with_settings 外部播放器路线，不依赖 mpv）。
        menu.add_command(label=_("实时预览（复杂滤镜）"),
                         command=self._live_preview_player,
                         state=("normal" if (not self.concat_enabled.get()
                                             or self.use_mpv.get() or self.ffplay_cmd)
                                else "disabled"))
        # 实时预览（简易时间引擎）：同一张合成图改走内置时间预览窗口（ffmpeg 管道，不依赖 mpv，
        # 但画面小、性能有限，子视频多 / 滤镜重时同样可能卡顿；外部播放器（mpv/ffplay）性能通常更好）
        # —— 按当前模式自动选图：串行合并图 / 画中画图 / 单轨合成图。
        menu.add_command(label=_("实时预览（简易时间引擎，画面小）"), command=self._live_preview_pipe)
        if self.concat_enabled.get():
            # 串行合并模式下追加「整段拼接」预览入口（EDL 轻量无滤镜）。
            # EDL 走 mpv 的 edl:// → 仍按 use_mpv 置灰。
            # （滤镜版入口已由上方统一按钮覆盖 → 该项删除，2026-09-21。）
            menu.add_command(label=_("串行合并预览 (无滤镜 mpv EDL)"), command=self.merge_preview_concat_edl,
                             state=("normal" if self.use_mpv.get() else "disabled"))
        x = self.root.winfo_pointerx()
        y = self.root.winfo_pointery()
        menu.post(x, y)

    def _transcode_preview_right_menu(self):
        """转码页预览按钮右键：快照 / 缩略图 / 时间预览引擎 选择菜单"""
        menu = tk.Menu(self.root, tearoff=0)
        menu.add_command(label=_("快照（水印合成）"), command=lambda: self.preview_current_file(with_snapshot=True))
        menu.add_command(label=_("缩略图"), command=self._contact_sheet_current_file)
        # 时间预览引擎（2026-09-20 Phase 1）：同一张合成图改走 ffmpeg -filter_complex → rawvideo
        # 管道，由内置 SimplePreviewer 渲染 —— 保留标记/波形/步进，且无需 mpv/ffplay。
        menu.add_command(label=_("实时预览（简易时间引擎，画面小）"), command=self._time_preview_pipe_current)
        x = self.root.winfo_pointerx()
