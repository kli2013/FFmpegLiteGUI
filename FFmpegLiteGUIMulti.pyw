    def _set_initial_pane_size(self, paned):
        # 2026-08-28：右栏命令框收进按钮弹窗后 paned 只剩单 pane → sashpos 会越界
        # （TclError: sash index 0 out of range），≥2 个 pane 才设置初始分隔。
        try:
            if len(paned.panes()) < 2:
                return
        except Exception:
            return
        total_width = self.window.winfo_width()
        if total_width > 100:
            paned.sashpos(0, int(total_width * 0.75))
        # ⚠️ 双击绑定已于 2026-09-08 移出本方法（原先在这里，因上面的 return 而从未生效）。

    def _on_precise_mode_change(self):
        """「精确方式」单选联动「分开队列」复选框（2026-09-08）。

        双 -ss（combo）：依赖输入级 -ss，多段无法合并成单命令，恒为逐段发送 →
        把「分开队列」强制勾选并置灰，让 UI 状态如实反映实际行为（避免用户以为没生效）。
        trim：恢复置灰前用户自己选的值（_split_user_value），交还控制权。

        ⚠️ 置灰用 configure(state=...)：ttk.Checkbutton 有 -state 选项，且项目约定禁用
        ttk 控件一律走 configure / config（与 region_chk 等处一致），不用 .state([...])。
        另外 ttk.Checkbutton 的 command 在 variable 翻转「之后」才执行，所以这里不用 command 联动，
        改由 Radiobutton 的 command 显式驱动。
        """
        cb = getattr(self, "cb_split", None)
        if cb is None:
            return
        combo = (self.precise_mode_var.get() == "combo")
        try:
            if combo:
                # 只在第一次进入 combo 时记录用户原值，避免来回切换时被锁定的 True 覆盖
                if not getattr(self, "_split_locked_by_combo", False):
                    self._split_user_value = bool(self.quick_split_queue_var.get())
                    self._split_locked_by_combo = True
                self.quick_split_queue_var.set(True)
                cb.configure(state="disabled")
            else:
                if getattr(self, "_split_locked_by_combo", False):
                    self._split_locked_by_combo = False
                    self.quick_split_queue_var.set(bool(getattr(self, "_split_user_value", False)))
                cb.configure(state="normal")
        except Exception:
            # 置灰失败不能影响模式切换本身（UI 状态只是提示，发送逻辑各自独立判定）
            pass

    def send_quick_to_queue(self):
        input_file = self.app.input_file.get().strip()
        if alert_if(not input_file or not os.path.exists(input_file), _("错误"), _("请先在主界面选择输入文件"), 'error'):
            return
        if alert_if(not self.segments, _("提示"), _("片段列表为空"), 'info'):
            return

        output_dir = self.app.output_dir.get().strip()
        if not output_dir or not os.path.exists(output_dir):
            output_dir = os.path.dirname(input_file)
        basename = os.path.splitext(os.path.basename(input_file))[0]
        container = self.app.get_current_settings().get("output_container", "mp4")

        split = self.quick_split_queue_var.get()

        if split:
            # 分开队列：每个分段独立队列任务，单条命令只含一个 -i（输入路径只出现一次）。
            # 彻底避免合并命令因重复输入路径而长度爆炸；代价是队列多出 N 条任务。
            # 单 -i + 输入级 -ss/-to 是 copy 模式正确切段的稳定写法（短段也不丢视频）。
            count = 0
            for i, seg in enumerate(self.segments, start=1):
                start = time_to_seconds(seg["start"])
                end = time_to_seconds(seg["end"])
                if start is None or end is None or start >= end:
                    self.app._append_info_ui(_('[快速分段] 第 {0} 段时间无效，已跳过: {1}→{2}').format(i, seg['start'], seg['end']))
                    continue
                out = normalize_path(os.path.join(output_dir, f"{basename}_seg{i:03d}.{container}"))
                resolved_out = self.app._resolve_path_conflict(out, show_dialog=False)
                seg_cmd = [self.app.ffmpeg_cmd, "-y", "-ss", _ffsec(start), "-to", _ffsec(end),
                           "-i", input_file, "-map", "0", "-c", "copy", "-map_metadata", "-1", resolved_out]
                if self.app.add_custom_task(resolved_out, resolved_out, seg_cmd):
                    count += 1
            if count:
                self.app.update_task_list()
                self.app._append_info_ui(
                    _('已添加 {0} 个快速分段任务（分开队列，每段单命令流复制）到队列').format(count))
                messagebox.showinfo(_("成功"),
                    _('已添加 {0} 个快速分段任务（分开队列，每段单命令流复制）到队列').format(count))
            else:
                messagebox.showinfo(_("提示"), _("没有有效的分段可发送"))
            return

        # 合并模式（默认）：方案 A（快速/copy）——单条命令、每个分段分别 -ss/-to/-i，
        # 一次流复制切出所有分段，队列只占 1 条。输入级 -ss/-to 保证 copy 切段正确。
        # 注意：命令中每个分段都重复一遍输入路径，片段异常多时可能爆栈，此时勾选「分开队列」。
        cmd = [self.app.ffmpeg_cmd, "-y"]
        out_paths = []
        for i, seg in enumerate(self.segments, start=1):
            start = time_to_seconds(seg["start"])
            end = time_to_seconds(seg["end"])
            if start is None or end is None or start >= end:
                self.app._append_info_ui(_('[快速分段] 第 {0} 段时间无效，已跳过: {1}→{2}').format(i, seg['start'], seg['end']))
                continue
            cmd.extend(["-ss", _ffsec(start), "-to", _ffsec(end), "-i", input_file])
            out_paths.append(normalize_path(os.path.join(output_dir, f"{basename}_seg{i:03d}.{container}")))

        if alert_if(not out_paths, _("提示"), _("没有有效的分段可发送"), 'info'):
            return

        resolved = [self.app._resolve_path_conflict(p, show_dialog=False) for p in out_paths]
        for idx, out in enumerate(resolved):
            cmd.extend(["-map", str(idx), "-c", "copy", "-map_metadata", "-1", out])

        if self.app.add_custom_task(resolved[0], resolved[0], cmd):
            self.app.update_task_list()
            self.app._append_info_ui(
                _('已添加 1 个快速分段任务（合并 {0} 段，单命令流复制）到队列').format(len(resolved)))
            messagebox.showinfo(_("成功"),
                _('已添加 1 个快速分段任务（合并 {0} 段，单命令流复制）到队列').format(len(resolved)))
    
    def send_precise_to_queue(self):
        input_file = self.app.input_file.get().strip()
        if alert_if(not input_file or not os.path.exists(input_file), _("错误"), _("请先在主界面选择输入文件"), 'error'):
            return
        if alert_if(not self.segments, _("提示"), _("片段列表为空"), 'info'):
            return

        mode = self.precise_mode_var.get()

        # 双 -ss（组合跳转）模式：逐段发送（与原行为一致，超长视频解码更快），
        # 因为组合跳转依赖输入级 -ss，难以在单命令里优雅地合并多段。
        if mode == "combo":
            base_settings = self.app.get_current_settings()
            base_settings.pop("watermark", None)   # 移除水印（保留其他滤镜）
            output_dir = self.app.output_dir.get().strip()
            if not output_dir or not os.path.exists(output_dir):
                output_dir = os.path.dirname(input_file)
            basename = os.path.splitext(os.path.basename(input_file))[0]
            container = base_settings.get("output_container", "mp4")
            count = 0
            for i, seg in enumerate(self.segments, start=1):
                settings = base_settings.copy()
                settings["trim_enabled"] = True
                settings["trim_start"] = seg["start"]
                settings["trim_end"] = seg["end"]
                settings["combo_seek"] = True
                settings["precise_trim"] = False
                settings["combo_threshold"] = 30
                settings["output_dir"] = output_dir
                settings["custom_output_name"] = f"{basename}_seg{i:03d}.{container}"
                settings["segment_enabled"] = False
                settings.pop("segments", None)
                self.app._append_info_ui(_('[分段] 片段 {0} 模式: 双-ss, start={1}').format(i, seg['start']))
                if self.app.add_task(input_file, settings):
                    count += 1
            self.app.update_task_list()
            self.app._append_info_ui(_('已添加 {0} 个精确分段任务到队列（模式：双-ss）').format(count))
            messagebox.showinfo(_("成功"), _('已添加 {0} 个精确分段任务到队列（模式：双-ss）').format(count))
            return

        # trim 滤镜模式（方案 A）：单条 filter_complex 一次解码、多段精确裁剪，队列只占 1 条。
        base_settings = self.app.get_current_settings()
        base_settings.pop("watermark", None)   # 移除水印（保留其他滤镜）

        output_dir = self.app.output_dir.get().strip()
        if not output_dir or not os.path.exists(output_dir):
            output_dir = os.path.dirname(input_file)
        basename = os.path.splitext(os.path.basename(input_file))[0]
        container = base_settings.get("output_container", "mp4")

        out_paths = []
        settings_list = []
        for i, seg in enumerate(self.segments, start=1):
            s = base_settings.copy()
            s["trim_enabled"] = True
            s["trim_start"] = seg["start"]
            s["trim_end"] = seg["end"]
            s["combo_seek"] = False
            s["precise_trim"] = True
            s["output_dir"] = output_dir
            s["custom_output_name"] = f"{basename}_seg{i:03d}.{container}"
            s["segment_enabled"] = False
            s.pop("segments", None)
            out_paths.append(normalize_path(os.path.join(output_dir, f"{basename}_seg{i:03d}.{container}")))
            settings_list.append(s)

        resolved = [self.app._resolve_path_conflict(p, show_dialog=False) for p in out_paths]

        # ---- 分开队列（2026-09-08 修复）：trim 模式此前完全没读「分开队列」，
        # 无论勾选与否都只发一条合并命令，勾选形同虚设。现在勾选=逐段发送独立队列任务：
        # 每段单独解码（比单解码慢），但命令短、不受合并失败回退影响。
        if self.quick_split_queue_var.get():
            count = 0
            for i, s in enumerate(settings_list):
                # 用冲突消解后的文件名，保证与合并模式下落盘的名字一致
                s["custom_output_name"] = os.path.basename(resolved[i])
                if self.app.add_task(input_file, s):
                    count += 1
            self.app.update_task_list()
            self.app._append_info_ui(
                _('已添加 {0} 个精确分段任务到队列（模式：trim，分开队列）').format(count))
            messagebox.showinfo(_("成功"),
                _('已添加 {0} 个精确分段任务到队列（模式：trim，分开队列）').format(count))
            return

        merged = self._build_precise_multi_command(input_file, resolved, settings_list)

        if merged is None:
            # 合并失败（如含旋转水印/无限源时长限制等），回退为逐段发送，保证可用。
            self.app._append_info_ui(_("[精确分段] 当前设置无法合并为单命令，已回退为逐段发送"))
            count = 0
            for i, seg in enumerate(self.segments, start=1):
                if self.app.add_task(input_file, settings_list[i - 1]):
                    count += 1
            self.app.update_task_list()
            self.app._append_info_ui(_('已添加 {0} 个精确分段任务到队列（模式：trim，回退逐段）').format(count))
            messagebox.showinfo(_("成功"), _('已添加 {0} 个精确分段任务到队列（模式：trim，回退逐段）').format(count))
            return

        if self.app.add_custom_task(resolved[0], resolved[0], merged):
            self.app.update_task_list()
            self.app._append_info_ui(
                _('已添加 1 个精确分段任务（合并 {0} 段，单解码 filter_complex）到队列').format(len(resolved)))
            messagebox.showinfo(_("成功"),
                _('已添加 1 个精确分段任务（合并 {0} 段，单解码 filter_complex）到队列').format(len(resolved)))

    def _extract_encode_opts(self, cmd):
        """从单段 generate_ffmpeg_command 结果中提取「编码/封装选项」（去掉结构型参数与输出路径），
        供合并命令的每个输出复用。"""
        skip_val = {"-i", "-filter_complex", "-vf", "-af", "-map", "-fflags"}
        opts = []
        i = 0
        n = len(cmd)
        while i < n:
            tok = cmd[i]
            if i == 0 and not tok.startswith("-"):
                # 首元素是 ffmpeg 可执行文件本体，跳过（否则会被误当作编码选项）
                i += 1
                continue
            if tok == "-i":
                i += 2
                continue
            if tok in skip_val or tok.startswith("-filter:a"):
                i += 2
                continue
            if tok == "-an":
                i += 1
                continue
            if tok == "-y":
                i += 1
                continue
            if tok in ("-ss", "-t", "-to", "-shortest"):
                i += (2 if tok in ("-ss", "-t", "-to") else 1)
                continue
            if i == n - 1:  # 输出路径，跳过
                break
            opts.append(tok)
            i += 1
        return opts

    def _build_precise_multi_command(self, input_path, out_paths, settings_list):
        """方案 A（精确/trim 模式）：把 N 个分段的 ffmpeg 命令合并为单条 filter_complex 多输出命令。
        复用 generate_ffmpeg_command 生成每段命令以保证滤镜/编码完全一致，仅共享输入并拼接滤镜图。
        无法合并（含组合跳转 -ss / -shortest / 超长命令）时返回 None，由调用方回退逐段发送。"""
        import re
        try:
            cmds = [self.app.generate_ffmpeg_command(input_path, out_paths[i], settings_list[i], preview=False)
                    for i in range(len(out_paths))]
        except Exception as e:
            self.app._append_info_ui(_('[精确合并] 生成命令失败: {0}').format(e))
            return None
        # 组合跳转 / 无限源时长限制等无法在单命令优雅合并，回退
        for c in cmds:
            if "-shortest" in c or "-ss" in c:
                return None

        has_sub = any("0:s?" in c for c in cmds)
        parsed = []
        for i, c in enumerate(cmds):
            # 视频滤镜图 + 输出标签
            if "-filter_complex" in c:
                fi = c.index("-filter_complex")
                fc = c[fi + 1]
                # 统一给内部标签加 _s{i} 后缀，避免多段同名标签冲突
                fc = re.sub(r'\[([A-Za-z_]\w*)\]', lambda m: f'[{m.group(1)}_s{i}]', fc)
                fc = fc.rstrip(';') + ';'
                vmap = None
                for j, m in enumerate(c):
                    if m == "-map" and j + 1 < len(c) and c[j + 1].startswith("[v"):
                        vmap = c[j + 1]
                        break
                if vmap is None:
                    return None
                vlabel = vmap[:-1] + f"_s{i}]"   # 与上面重命名保持一致
                vgraph = fc
            elif "-vf" in c:
                vi = c.index("-vf")
                vf = c[vi + 1]
                raw = f"[0:v]{vf}[__OUT__{i}]"
                raw = re.sub(r'\[([A-Za-z_]\w*)\]', lambda m: f'[{m.group(1)}_s{i}]', raw)
                raw = raw.replace(f"[__OUT__{i}_s{i}]", f"[v{i}]")
                vlabel = f"[v{i}]"
                vgraph = raw + ";"
            else:
                return None

            # 音频滤镜图 + 标签（-af，或转换页按轨的 -filter:a:N）
            af_idx = next((j for j, tok in enumerate(c)
                           if tok == "-af" or tok.startswith("-filter:a")), None)
            if af_idx is not None and af_idx + 1 < len(c):
                af = c[af_idx + 1]
                alabel = f"[a{i}]"
                agraph = f"[0:a]{af}[a{i}];"
            elif "-an" in c:
                alabel = None
                agraph = None
            else:
                # 沿用该段实际的音频映射（0:a?=首轨 / 0:a=全部原样保留 / 0:a:N），
                # 不能写死 0:a?，否则「全部·原样保留」在精确合并里会退化为只留首音轨。
                alabel = None
                for j, m in enumerate(c):
                    if m == "-map" and j + 1 < len(c) and c[j + 1].startswith("0:a"):
                        alabel = c[j + 1]
                        break
                if alabel is None:
                    alabel = "0:a?"
                agraph = None

            enc = self._extract_encode_opts(c)
            parsed.append((vgraph, vlabel, agraph, alabel, enc))

        fc_all = "".join(p[0] + (p[2] or "") for p in parsed)
        merged = [cmds[0][0], "-y", "-i", input_path, "-filter_complex", fc_all]
        for k, (vgraph, vlabel, agraph, alabel, enc) in enumerate(parsed):
            merged += ["-map", vlabel]
            if alabel is None:
                merged += ["-an"]
            else:
                merged += ["-map", alabel]
            if has_sub:
                merged += ["-map", "0:s?"]
            merged += enc
            merged += [out_paths[k]]

        if len(" ".join(merged)) > 24000:
            return None
        return merged
    def export_quick_script(self):
        input_file = self.app.input_file.get().strip()
        if alert_if(not input_file or not os.path.exists(input_file), _("错误"), _("请先在主界面选择输入文件"), 'error'):
            return
        if alert_if(not self.segments, _("提示"), _("片段列表为空"), 'info'):
            return
    
        # 选择保存路径
        save_path = filedialog.asksaveasfilename(
            title=_("保存快速切割脚本"),
            defaultextension=".bat" if sys.platform == "win32" else ".sh",
            filetypes=[(_("批处理文件"), "*.bat"), (_("Shell脚本"), "*.sh")]
        )
        if not save_path:
            return
    
        output_dir = self.app.output_dir.get().strip()
        if not output_dir or not os.path.exists(output_dir):
            output_dir = os.path.dirname(input_file)
        basename = os.path.splitext(os.path.basename(input_file))[0]
        lines = []
        # 添加文件头
        if save_path.endswith(".sh"):
            lines.append("#!/bin/bash")
        else:
            lines.append("@echo off")
            lines.append("chcp 65001 >nul")
        lines.append("")
    
        for i, seg in enumerate(self.segments, start=1):
            start = seg["start"]
            end = seg["end"]
            out_name = f"{basename}_seg{i:03d}.mp4"
            out_path = os.path.join(output_dir, out_name)
            # 转义路径中的空格和特殊字符（Windows用双引号，Unix用单引号或转义）
            # 这里使用双引号简单处理
            cmd = f'ffmpeg -ss {start} -to {end} -i "{input_file}" -c copy "{out_path}"'
            lines.append(cmd)
    
        with open(save_path, 'w', encoding='utf-8') as f:
            f.write("\n".join(lines))
    
        messagebox.showinfo(_("成功"), _('脚本已保存到:\n{0}').format(save_path))
    
    
