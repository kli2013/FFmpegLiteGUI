        ttk.Label(p_row, text=_("(未启用多画面拼接时无差别)"), foreground="gray").pack(side=tk.LEFT)
        ttk.Label(f3, text=_("边距单位=像素，输出尺寸 = 原画布 + 四边距之和；与 split/concat 可同时启用（边框在最外层）。"),
