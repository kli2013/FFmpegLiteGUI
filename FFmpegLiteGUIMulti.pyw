        self.alpha_spinbox_var.trace_add("write", alpha_spin_changed)

        # ----- 遮罩 / 透明蒙版 -----
        self.mask_enabled = tk.BooleanVar(value=False)
        self.mask_x = tk.StringVar(value="0")
