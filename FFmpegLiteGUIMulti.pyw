                    "  format / fps / settb 挪到 concat 之后统一写一次 —— 10 段只要 20+3 个。\n\n"
                    "实测（ffmpeg n9.0.1）：两种写法输出的分辨率、像素格式、帧率、SAR、\n"
                    "帧数、时长完全一致（含 10bit 源，逐像素 PSNR=inf）。\n"
                    "启用转场（xfade）时 fps 会自动留在段前：xfade 的 offset 按帧数算，\n"
                    "帧率不一致会直接报错，无法后置。\n\n"
                    "实验期默认关闭，发现异常请取消勾选并反馈。"),
                    wraplength=460)

        # ---------- 右侧实时预览（2026-10-06）----------
        # 取帧源按页面语境分流（_page_main_video），禁跨页兜底。preview_page 为空则不挂预览
        # （队列任务编辑拿不到本页主视频，保持旧的单栏布局，行为不变）。
        _pv = [None]      # 闭包容器：嵌套函数里要读它，用 list 免 nonlocal

        def _pv_get_src():
            if not preview_page:
                return ""
            with suppress(Exception):
                _f, _ = _page_main_video(self, preview_page)
                return _f or ""
            return ""

        def _pv_build_cmd(src, t, static, box_w, box_h, mode):
            _bs = None
            if mode == "proc" and preview_page:
                with suppress(Exception):
                    _bs = _page_main_video(self, preview_page)[1]
            try:
                # 与 _on_ok 落盘字段逐字对齐 ⇒ 预览所见即「确定」后的效果
                _eh = {
                    "split_enabled": bool(split_on.get()),
                    "split_rows": max(1, int(rows_var.get() or 1)),
                    "split_cols": max(1, int(cols_var.get() or 1)),
                    "border_enabled": bool(border_on.get()),
                    "border_top": max(0, int(top_var.get() or 0)),
                    "border_bottom": max(0, int(bottom_var.get() or 0)),
                    "border_left": max(0, int(left_var.get() or 0)),
                    "border_right": max(0, int(right_var.get() or 0)),
                    "border_color": (border_color_var.get() or "").strip() or "#000000",
                    "border_after_split": (border_pos_var.get() != _("split 之前（每格带框）")),
                }
            except (ValueError, TypeError):
                _eh = {}
            return build_end_preview_cmd(
                getattr(self, "ffmpeg_cmd", None) or "ffmpeg", src, t,
                end_settings=_eh, base_settings=_bs, static_image=static,
                box_w=box_w, box_h=box_h)

        def _pv_status_extra(t, static):
            if concat_on.get():
                return _("concat（末尾追加）是时间轴行为，静帧预览不体现"), None
            try:
                _n = int(rows_var.get() or 1) * int(cols_var.get() or 1)
            except (ValueError, TypeError):
                _n = 1
            if split_on.get() and not (2 <= _n <= 5):
                return _("总格数需在 2-5 之间，当前 {0}").format(_n), None
            return _("边框随整帧等比缩放，比例与成品一致"), None

        if preview_page:
            _pv[0] = LiveFramePreview(
                right_col, self, get_src=_pv_get_src, build_cmd=_pv_build_cmd,
                status_extra=_pv_status_extra,
                time_value="3", title=_("实时预览（内存中）"),
                hint=None,
                tip=_("右侧显示末端处理（多画面拼接 + 边框）的实际效果。\n"
                      "改行列数 / 四边距 / 颜色 / 边框位置都会实时刷新（150ms 防抖）。\n"
                      "取帧时刻默认 3 秒，可自行改；concat（末尾追加）是时间轴行为，静帧看不到。"),
                box_w=320, box_h=250)
            _pv[0].pack(fill=tk.BOTH, expand=True, padx=(0, 10), pady=10)

            def _pv_kick(*_a):
                _p = _pv[0]
                if _p is not None:
                    _p.schedule()

            for _v in (split_on, rows_var, cols_var, concat_on,
                       border_on, top_var, bottom_var, left_var, right_var,
                       border_color_var, border_pos_var):
                with suppress(Exception):
                    _v.trace_add("write", _pv_kick)

            # ⚠️ 开窗必须**显式首渲一次**（2026-10-06 用户报「末端预览刚打开也显示在取帧」）：
            # 组件只在 schedule()/reload() 时才跑 ffmpeg，而 trace 只在**变量变化**时响 ——
            # 开窗这条路上表单是按已有设置回填的（值与初值相同则根本不写），trace 一个都不响
            # ⇒ 永不取帧，画面永远停在 label 初始文案「正在取帧…」。
            # （同一条坑 delogo 窗 2026-10-04 已踩过一次，见 BlurFilterDialog.create_widgets
            #  末尾的同款首渲：有列表项时由回填负责，无列表项时必须靠这一句。）
            with suppress(Exception):
                _pv[0].schedule()

        # ---------- 确定 / 取消 ----------
        btm = ttk.Frame(left_col)
        btm.pack(fill=tk.X, padx=10, pady=(6, 10))

        def _on_ok():
            rows = max(1, int(rows_var.get() or 1))
            cols = max(1, int(cols_var.get() or 1))
            n = rows * cols
            if alert_if(split_on.get() and not (2 <= n <= 5), _("提示"), _('总格数 {0}×{1}={2} 超出限制，需为 2-5。').format(rows, cols, n), parent=win):
                return
            eh["split_enabled"] = bool(split_on.get())
            eh["split_rows"] = rows
            eh["split_cols"] = cols
            eh["concat_enabled"] = bool(concat_on.get())
            p = path_var.get().strip()
            if alert_if(eh["concat_enabled"] and not p, _("提示"), _("请选择要追加的图片或视频文件。"), parent=win):
                return
            eh["concat_path"] = p
            eh["concat_sec"] = max(0.5, float(sec_var.get() or 5.0))
            eh["border_enabled"] = bool(border_on.get())
            eh["border_top"] = max(0, int(top_var.get() or 0))
            eh["border_bottom"] = max(0, int(bottom_var.get() or 0))
            eh["border_left"] = max(0, int(left_var.get() or 0))
            eh["border_right"] = max(0, int(right_var.get() or 0))
            _bc = border_color_var.get().strip()
            eh["border_color"] = _bc if _bc else "#000000"
            eh["border_after_split"] = (border_pos_var.get() != _("split 之前（每格带框）"))
            win.destroy()
            if on_apply is not None:
                on_apply()
            else:
                self.merge_update_command_preview()
            self._append_info_ui(_("[末端] 末端处理设置已更新"))

        _btns = ttk.Frame(btm)
        _btns.pack(anchor=tk.CENTER)
        ttk.Button(_btns, text=_("确定"), command=_on_ok, width=8).pack(side=tk.LEFT, padx=6)
        ttk.Button(_btns, text=_("取消"), command=win.destroy, width=8).pack(side=tk.LEFT, padx=6)

        # 居中显示
        # ⚠️ PanedWindow 的 pane 宽度由 sash 几何决定，**不参与** winfo_reqwidth 的自然计算
        # （这是它不会震荡的原因，也是代价）⇒ 直接用 reqwidth 居中会得到一个偏窄的窗。
        # 改为显式初始尺寸 + 居中（左右分隔条仍可拖，与 delogo 窗同款处理）。
        win.update_idletasks()
        _W = max(int(win.winfo_reqwidth()) or 0, 940)
        _H = max(int(win.winfo_reqheight()) or 0, 660)
        _SW = win.winfo_screenwidth()
        _SH = win.winfo_screenheight()
        _W, _H = min(_W, max(400, _SW - 80)), min(_H, max(300, _SH - 80))
        x = self.root.winfo_rootx() + (self.root.winfo_width() - _W) // 2
        y = self.root.winfo_rooty() + (self.root.winfo_height() - _H) // 3
        win.geometry("%dx%d+%d+%d" % (_W, _H, max(0, x), max(0, y)))
        win.deiconify()


    def _apply_end_handling(self, cmd_list, enabled_tracks):
        """末端处理统一注入（封装页入口）。解析主轨道尺寸/帧率/时长后调通用 _apply_end_handling_cmd。"""
        eh = self._merge_end_handling
        if not (eh.get("split_enabled", False) or eh.get("concat_enabled", False)
                or eh.get("border_enabled", False)):
            return cmd_list
        main_track = None
        for t in enabled_tracks:
            if t.type == "video":
                main_track = t
                break
        main_w, main_h = 1280, 720
        fps = 30.0
        main_dur = 0.0   # 主视频有效时长（考虑截取/变速；concat 前强制收尾用）
        if main_track is not None:
            with suppress(Exception):
                main_w, main_h = self._get_canvas_size(main_track)
            try:
                _f = self._get_video_framerate(main_track.file_path)
                if _f and _f > 0:
                    fps = float(_f)
            except Exception:
                pass
            try:
                _d = self._get_effective_duration(main_track.enc_settings, input_path=main_track.file_path)
                if _d and _d > 0:
                    main_dur = float(_d)
            except Exception:
                pass
        return self._apply_end_handling_cmd(cmd_list, eh, main_w, main_h, fps, main_dur)

    def _probe_end_handling_dims(self, input_path, settings):
        """转换页/队列主视频末端处理对齐参数：画布尺寸/帧率/有效时长。
        与封装页 _get_canvas_size 同构（pad 优先 → compute_final_size_with_order）。"""
        main_w, main_h = 1280, 720
        pad_on = bool(settings.get("pad_enabled", False))
        if pad_on:
            try:
                _pw = int(str(settings.get("pad_width", "")).strip())
                _ph = int(str(settings.get("pad_height", "")).strip())
                if _pw > 0 and _ph > 0:
                    main_w, main_h = _pw, _ph
            except (ValueError, TypeError):
                pass
        if (main_w, main_h) == (1280, 720) or not pad_on:
            _w, _h = self._cached_video_dimensions(input_path)
            if _w is not None and _h is not None:
                _w2, _h2 = self.compute_final_size_with_order(_w, _h, settings)
                if _w2 and _w2 > 0 and _h2 and _h2 > 0:
                    main_w, main_h = _w2, _h2
        try:
            _f = self._get_video_framerate(input_path)
            fps = float(_f) if (_f and _f > 0) else 30.0
        except Exception:
            fps = 30.0
        try:
            _d = self._get_effective_duration(settings, input_path=input_path)
            main_dur = float(_d) if (_d and _d > 0) else 0.0
        except Exception:
            main_dur = 0.0
        return main_w, main_h, fps, main_dur

    def _apply_end_handling_cmd(self, cmd_list, eh, main_w, main_h, fps, main_dur):
        """末端处理统一注入（封装页/转换页/队列三处共用）。
        在 cmd_list 生成后调用：
        ①多画面拼接（split 网格）→ 在最终视频输出标签上追加 split/hstack/vstack 段；
        ②末端 concat 图片/视频 → 额外输入文件 + scale/pad 适配输出尺寸后 concat 到主视频末尾。
        eh：末端处理设置 dict（三处各自独立：_merge_end_handling / _trans_end_handling /
            task.settings["end_handling"]）。
        main_w/main_h/fps/main_dur：主视频对齐参数（封装页从轨道、转换页从 _probe_end_handling_dims）。

        ⚠️ 本方法修改的是 cmd_list（就地重建），需要找到「最终视频输出标签」：
        - 有 -filter_complex → filtergraph 末尾的输出标签（-map [xxx] 的目标，排除音频 [a...]）
        - 只有 -vf（普通模式无旋转）→ 视频输出是主视频输入流，需把 -vf 链并入新的 filter_complex 再追加末端段
        - 纯 copy（普通/串行流复制）→ 强制升级为 filter_complex + 重编码（末端处理必须重编码）
        返回新 cmd_list；未启用末端处理或解析失败时原样返回。"""
        split_on = bool(eh.get("split_enabled", False))
        concat_on = bool(eh.get("concat_enabled", False))
        # 边框（2026-08-27）：pad 画布外扩，四边距像素 + 颜色；链尾最外层，包住 split/concat 产物。
        # 全 0 边距 = 无边框（border_effective 用于统一判定，避免空 pad）
        border_on = bool(eh.get("border_enabled", False))
        b_top = max(0, int(eh.get("border_top", 0) or 0))
        b_bottom = max(0, int(eh.get("border_bottom", 0) or 0))
        b_left = max(0, int(eh.get("border_left", 0) or 0))
        b_right = max(0, int(eh.get("border_right", 0) or 0))
        border_effective = border_on and (b_top + b_bottom + b_left + b_right) > 0
        if not split_on and not concat_on and not border_effective:
            return cmd_list
        split_rows = max(1, int(eh.get("split_rows", 1) or 1))
        split_cols = max(1, int(eh.get("split_cols", 1) or 1))
        concat_path = (eh.get("concat_path", "") or "").strip()
        concat_sec = float(eh.get("concat_sec", 5.0) or 5.0)
        if split_on and concat_on:
            # 互斥兜底（弹窗已联动，这里防残留/外部设置的旧值）：concat 优先，split 忽略
            split_on = False
            self._append_info_ui(_("[末端] 多画面拼接与末端 concat 互斥，已优先 concat（split 忽略）"))
        if split_on and not (2 <= split_rows * split_cols <= 5):
            split_on = False
        if concat_on and (not concat_path or not os.path.isfile(concat_path)):
            concat_on = False
        if not split_on and not concat_on and not border_effective:
            return cmd_list

        # ---- 解析 cmd_list：-filter_complex / -vf / 视频 -map / 输入计数 / copy 标记 ----
        fc_idx = None; fc_val = ""
        vf_idx = None; vf_val = ""
        vmap_idx = None; vmap_val = ""    # 视频 -map（[label] 或 N:v:M）
        input_count = sum(1 for a in cmd_list if a == "-i")
        is_copy = False
        i = 0
        while i < len(cmd_list):
            a = cmd_list[i]
            if a == "-filter_complex" and fc_idx is None:
                fc_idx = i; fc_val = cmd_list[i + 1] if i + 1 < len(cmd_list) else ""
                i += 2
                continue
            if a == "-vf" and vf_idx is None:
                vf_idx = i; vf_val = cmd_list[i + 1] if i + 1 < len(cmd_list) else ""
                i += 2
                continue
            if a == "-map" and i + 1 < len(cmd_list):
                tgt = cmd_list[i + 1]
                # 视频映射：[label]（排除 [a...] 音频）或 N:v / N:v? / N:v:M
                if vmap_idx is None and self._is_video_map_target(tgt):
                    vmap_idx = i; vmap_val = tgt
            if a == "-c:v" and i + 1 < len(cmd_list):
                if cmd_list[i + 1] == "copy":
                    is_copy = True
            i += 1

        # ---- 构建末端滤镜段（输入标签统一用 [v_end_in]，注入时替换为实际标签） ----
        end_parts = []
        cur_label = "[v_end_in]"
        # 边框位置（2026-08-27）：True=split 之后（网格外框，默认）；False=split 之前（每格带框）。
        # before 仅 split 启用时生效（concat 场景保持 after——边框应包住追加段，split/concat 已互斥）。
        border_after_split = bool(eh.get("border_after_split", True))
        _border_before = border_effective and split_on and (not border_after_split)
        # 边框在链尾最外层：split/concat 输出标签在边框生效（after）时改 [v_end_pre]，最后 pad → [v_end_out]
        mid_out = "[v_end_pre]" if (border_effective and not _border_before) else "[v_end_out]"
        # pad 片段（iw/ih 表达式，与预览共用 build_preview_border_frag；#RRGGBB→0xRRGGBB/颜色名/trunc 偶数化）
        _pad_frag = build_preview_border_frag(eh) if border_effective else ""
        if split_on:
            if _border_before:
                # 间隙模型（2026-10-06）：split 之后逐格按所在位置非对称 pad ——
                # 外围四条边框归单格独占，内部缝隙由相邻两格各占一半 ⇒ 外围与格间等宽。
                # 旧做法是「先给整段视频统一 pad 一圈再切网格」，导致格间边框背靠背 = 外围的 2 倍。
                # 每格视频内容尺寸不变（不缩放、不裁切）。细节见 build_split_gap_pad_plan。
                end_parts.append(build_end_split_filters(
                    split_rows, split_cols, in_label=cur_label, out_label="[v_end_out]",
                    border={"left": b_left, "right": b_right, "top": b_top, "bottom": b_bottom,
                            "color": (eh.get("border_color", "") or "#000000")}))
                cur_label = "[v_end_out]"
            else:
                end_parts.append(build_end_split_filters(split_rows, split_cols,
                                                         in_label=cur_label, out_label=mid_out))
                cur_label = mid_out
        if concat_on:
            is_img = os.path.splitext(concat_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp')
            tail_label = f"[{input_count}:v]"
            end_parts.append(build_end_concat_filters(
                concat_path, concat_sec, in_label=cur_label, tail_label=tail_label,
                out_label=mid_out, main_w=main_w, main_h=main_h, fps=fps,
                main_dur=main_dur))
            cur_label = mid_out
            # 输入级循环：图片加 -loop 1 -framerate fps -t sec（有限时长流）；视频直接 -i
            if is_img:
                extra_in = ["-loop", "1", "-framerate", f"{fps:.6f}".rstrip('0').rstrip('.'),
                            "-t", f"{concat_sec:.3f}", "-i", normalize_path(concat_path)]
            else:
                extra_in = ["-i", normalize_path(concat_path)]
        else:
            extra_in = []
        if border_effective and not _border_before:
            # pad 画布外扩（HandBrake Pad 同款）：输出 = iw+L+R : ih+T+B，内容偏移 (L,T)，填 border_color
            end_parts.append(f"{cur_label}{_pad_frag}[v_end_out]")
        end_frag = ";".join(end_parts)

        # ---- 注入（三种形态） ----
        new_cmd = list(cmd_list)
        # 形态 A：有 -filter_complex → 在 filtergraph 末尾追加末端段
        if fc_idx is not None and fc_val:
            if vmap_val and vmap_val.startswith("["):
                base_label = vmap_val
            else:
                # 无 -map：取 filtergraph 最后一个输出标签作为末端段输入
                # （如 [0:v]...drawtext=...[v_base] → [v_base]）
                _tags = re.findall(r"\[([^\]]+)\](?=\s*(?:;|$))", fc_val)
                base_label = f"[{_tags[-1]}]" if _tags else "[v_end_in]"
            frag = end_frag.replace("[v_end_in]", base_label)
            # 保证 base_label 存在：若 fc 里没有该标签则回退 [v_end_in]（理论上不会）
            new_fc = fc_val + ";" + frag
            new_cmd[fc_idx + 1] = new_fc
            # 视频 -map 改指向 [v_end_out]
            if vmap_idx is not None:
                new_cmd[vmap_idx + 1] = "[v_end_out]"
            if extra_in:
                # 新输入追加到最后一个 -i 及其路径值之后（不改变已有输入索引；input_count 指向新文件）
                pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
                if pos > 0 and pos + 1 < len(new_cmd):
                    pos += 2  # 跳过 -i 与路径值
                new_cmd[pos:pos] = extra_in
            if is_copy:
                # filter_complex 强制重编码：把 -c:v copy 改为 libx265
                for k, a in enumerate(new_cmd):
                    if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                        new_cmd[k + 1] = "libx265"
                        break
            # 无视频 -map 时补映射（转换页普通命令；否则 [v_end_out] unconnected）
            new_cmd = self._ensure_end_video_map(new_cmd)
            return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

        # 形态 B：只有 -vf（普通模式无旋转，视频直接 map 源流）→ 并入 filter_complex
        if vf_idx is not None and vf_val:
            v_idx = vmap_val.split(":")[0] if vmap_val and ":" in vmap_val else "0"
            base_vf = vf_val if vf_val != "null" else "null"
            frag = end_frag.replace("[v_end_in]", "[v_base]")
            new_fc = f"[{v_idx}:v]{base_vf}[v_base];{frag}"
            # 删除 -vf 及其值
            del new_cmd[vf_idx:vf_idx + 2]
            # 找插入点：第一个 -map 之前；无 -map（转换页普通命令）→ 输出文件前
            ins = next((k for k, a in enumerate(new_cmd) if a == "-map"), None)
            if ins is None:
                ins = self._find_end_output_pos(new_cmd)
            new_cmd[ins:ins] = ["-filter_complex", new_fc]
            # 插入后视频 -map 索引偏移 2；统一重新查找视频 -map 改为 [v_end_out]
            for k, a in enumerate(new_cmd):
                if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                    new_cmd[k + 1] = "[v_end_out]"
                    break
            if extra_in:
                pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
                if pos > 0 and pos + 1 < len(new_cmd):
                    pos += 2  # 跳过 -i 与路径值
                new_cmd[pos:pos] = extra_in
            if is_copy:
                for k, a in enumerate(new_cmd):
                    if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                        new_cmd[k + 1] = "libx265"
                        break
            new_cmd = self._ensure_end_video_map(new_cmd)
            return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

        # 形态 C：纯 copy（无 -vf 无 filter_complex）→ 新建 filter_complex + 强制重编码
        v_idx = vmap_val.split(":")[0] if vmap_val and ":" in vmap_val else "0"
        frag = end_frag.replace("[v_end_in]", f"[{v_idx}:v]")
        new_fc = frag
        ins = next((k for k, a in enumerate(new_cmd) if a == "-map"), None)
        if ins is None:
            # 无 -map（转换页普通命令）：插到输出文件之前，绝不能插到输出文件后
            # （ffmpeg 会把 -filter_complex 认作下一输出、图输出不映射）
            ins = self._find_end_output_pos(new_cmd)
        new_cmd[ins:ins] = ["-filter_complex", new_fc]
        # 插入后视频 -map 索引偏移 2；统一重新查找视频 -map 改为 [v_end_out]
        for k, a in enumerate(new_cmd):
            if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                new_cmd[k + 1] = "[v_end_out]"
                break
        if extra_in:
            pos = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=0)
            if pos > 0 and pos + 1 < len(new_cmd):
                pos += 2  # 跳过 -i 与路径值
            new_cmd[pos:pos] = extra_in
        if is_copy:
            for k, a in enumerate(new_cmd):
                if a == "-c:v" and k + 1 < len(new_cmd) and new_cmd[k + 1] == "copy":
                    new_cmd[k + 1] = "libx265"
                    break
        new_cmd = self._ensure_end_video_map(new_cmd)
        return self._adjust_end_concat_duration(new_cmd, main_dur, concat_sec, concat_path, concat_on)

    @staticmethod
    def _is_video_map_target(tgt):
        """-map 目标是否指向视频流：`[label]`（排除 [a…]/[A…] 音频标签）或 `0:v` / `0:v?` / `1:v:2`。
        ⚠️ 必须容忍可选流后缀 `?`——转码页普通路径映射写的是 `-map 0:v?`，本方法曾用
        `parts[1] == "v"` 精确比对，导致 `0:v?` 被误判为"非视频映射"。"""
        if tgt.startswith("["):
            return not (tgt.startswith("[a") or tgt.startswith("[A"))
        if ":" in tgt:
            return tgt.split(":")[1].rstrip("?") == "v"
        return False

    def _find_end_output_pos(self, new_cmd):
        """找输出文件路径在命令中的位置（倒序第一个非选项参数，跳过 -filter_complex/-vf
        的滤镜图值——用户命令里 filter_complex 可能出现在输出文件之后）。返回索引。"""
        i = len(new_cmd) - 1
        while i >= 0:
            a = new_cmd[i]
            if not a.startswith("-") and not a.startswith("["):
                # 非选项参数：若它是 -filter_complex/-vf 的值（前一项是指令）则跳过
                if i > 0 and new_cmd[i - 1] in ("-filter_complex", "-vf"):
                    i -= 2
                    continue
                return i
            i -= 1
        return len(new_cmd) - 1

    def _ensure_end_video_map(self, new_cmd):
        """末端处理注入后确保输出映射完整：
        转换页普通命令**没有 -map**（默认 map 输入流），而 filter_complex 的输出流不会
        自动映射 → 注入的 [v_end_out] 会 unconnected 报错。此处扫描：已有视频 -map 则
        不动；否则在输出文件前显式补 `-map [v_end_out] -map 0:a?`（视频用合成结果、
        音频保持源可选流）。"""
        for k, a in enumerate(new_cmd):
            if a == "-map" and self._is_video_map_target(new_cmd[k + 1] if k + 1 < len(new_cmd) else ""):
                return new_cmd  # 已有视频 -map
        out_idx = self._find_end_output_pos(new_cmd)
        new_cmd[out_idx:out_idx] = ["-map", "[v_end_out]", "-map", "0:a?"]
        return new_cmd

    def _adjust_end_concat_duration(self, new_cmd, main_dur, concat_sec, concat_path, concat_on=False):
        """concat 尾部素材启用时调整输出时长：
        - 仅当 concat_on=True 且 concat_path 有效时生效（否则直接返回，绝不干扰 -t/-shortest）
        - 移除 -shortest（concat 尾部为有限流，自然结束即可；-shortest 会被音频长度截断导致尾部丢失）
        - 图片尾部：必须给 -t = 主视频有效时长 + 尾部秒数（图片 -loop 无限/主视频无限循环时无天然终点）
        - 视频尾部：有限流自然结束，无需额外 -t（若已存在 -t 则保留用户手动时长）
        main_dur：主视频有效时长（封装页从轨道算、转换页从 settings 算；None/<=0 时默认 10s）。"""
        if not concat_on or not concat_path or not os.path.isfile(concat_path):
            return new_cmd
        is_img = os.path.splitext(concat_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp')
        if not is_img:
            # 视频尾部有限流：移除 -shortest 即可，不追加 -t
            if "-shortest" in new_cmd:
                new_cmd = [a for a in new_cmd if a != "-shortest"]
            return new_cmd
        # ---- 图片尾部：确保输出级有 -t = 主时长 + 尾部秒数 ----
        if main_dur is None or main_dur <= 0:
            # 图片主视频默认 10s（与 merge_build_cmd_list 的图片默认时长逻辑一致）
            main_dur = 10.0
        total = main_dur + concat_sec
        # 移除 -shortest
        new_cmd = [a for a in new_cmd if a != "-shortest"]
        # 找已有输出级 -t（排除输入级：输入级 -t 必在最后一个 -i 之前，输出级在最后一个 -i 之后）
        last_i = max((k for k, a in enumerate(new_cmd) if a == "-i"), default=-1)
        t_idx = None
        for k, a in enumerate(new_cmd):
            if k <= last_i:
                continue
            if a == "-t" and k + 1 < len(new_cmd) and not new_cmd[k + 1].startswith("-"):
                t_idx = k
                break
        if t_idx is not None:
            new_cmd[t_idx + 1] = f"{total:.3f}"
        else:
            # 追加输出级 -t：插到输出文件路径前（跳过 -filter_complex/-vf 的滤镜图值）
            out_idx = self._find_end_output_pos(new_cmd)
            new_cmd[out_idx:out_idx] = ["-t", f"{total:.3f}"]
        with suppress(Exception):
            self._append_info_ui(_('[末端] 图片尾部已设置输出总时长 -t {0:.3f}s（主视频 {1:.1f}s + 尾部 {2:.1f}s）').format(total, main_dur, concat_sec))
        return new_cmd


