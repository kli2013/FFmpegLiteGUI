                            value=initial_settings.get("audio_trim_start", "") or "")
                        audio_trim_end_var = tk.StringVar(
                            value=initial_settings.get("audio_trim_end", "") or "")

                        at_frame = ttk.LabelFrame(bind_frame, text=_("音频独立截取（不分段）"), padding="4")
                        at_frame.grid(row=4, column=0, columnspan=2, sticky="we", padx=5, pady=4)

                        # 拼接后视频总时长参考（各启用视频轨「截取+变速」视频时间相加 − 转场重叠）
                        _at_ref = self._merge_at_total_ref()

                        at_r0 = ttk.Frame(at_frame)
                        at_r0.pack(fill=tk.X, pady=(0, 3))
                        at_chk = ttk.Checkbutton(at_r0, text=_("启用音频独立截取"),
                                                 variable=audio_trim_enabled_var,
                                                 command=lambda: self._merge_at_confirm_toggle(
                                                     audio_trim_enabled_var, at_start_entry, at_end_entry))
                        at_chk.pack(side=tk.LEFT)
                        ToolTip(at_chk,
                                _("跨分段生效：开启后从【主视频源文件】音频中单独截取一段，\n"
                                "整段接管合并输出的所有音频（忽略各分段自身的嵌入音频）。\n"
                                "本功能完全对齐转换页面分段拼接窗口内的模块，不是为不同文件列表设计的。\n"
                                "目的还是在重新整合视频片段时不打断原始背景音乐的连续性。\n"
                                "⚠ 程序不自动检测源文件是否一致——请自行确认本列表所有分段来自同一源文件，\n"
                                "否则音频与画面会对不上。音频起止以【源文件】时间轴为准。"),
                                wraplength=420)
                        # 蓝字参考：放启用复选框右边，简短（作为音频截取长度参考）
                        # 常驻标签 + 句柄，供「一键淡入淡出(all)/一键转场(all)」即时刷新
                        # （这两个操作直接写回 merge_tracks.enc_settings，无需保存重开即可重算总时长）
                        self._at_total_ref_label = ttk.Label(at_r0, text="", foreground="blue")
                        self._at_total_ref_label.pack(side=tk.LEFT, padx=(10, 0))
                        self._refresh_at_total_ref()

                        at_r1 = ttk.Frame(at_frame)
                        at_r1.pack(fill=tk.X, pady=(2, 0))
                        _lbltt38 = ttk.Label(at_r1, text=_("音频起始:"))
                        _lbltt38.pack(side=tk.LEFT)
                        at_start_entry = ttk.Entry(at_r1, textvariable=audio_trim_start_var, width=12)
                        at_start_entry.pack(side=tk.LEFT, padx=3)
                        ToolTip(_lbltt38, _("音频开始时间（源文件时间轴），格式：秒数 (如 0) 或 HH:MM:SS.ms"))
                        _lbltt39 = ttk.Label(at_r1, text=_("音频结束:"))
                        _lbltt39.pack(side=tk.LEFT, padx=(15, 0))
                        at_end_entry = ttk.Entry(at_r1, textvariable=audio_trim_end_var, width=12)
                        at_end_entry.pack(side=tk.LEFT, padx=3)
                        ToolTip(_lbltt39, _("音频结束时间（源文件时间轴），格式：秒数 或 HH:MM:SS.ms。留空=到文件末尾"))

                        # 初始禁用状态
                        self._merge_at_toggle(audio_trim_enabled_var, at_start_entry, at_end_entry)

                # 静音流说明已移至「生成静音流」单选按钮的 ToolTip，不再占用界面空间

                # 预留外部文件控件（暂时隐藏）
                # external_frame = ttk.Frame(bind_frame)
                # external_frame.grid(row=2, column=0, columnspan=2, sticky="we", padx=5, pady=5)
                # external_frame.grid_remove()
    
            # ================== 新增结束 ==================

            # ---- 窗口居中 ----
            center_window(win, 700, 310)

            # ---- 保存按钮 ----
            def save():
                try:
                    new_settings = {}
                    new_settings.update(enc_frame.get_settings())
                    new_settings.update(filt_frame.get_settings())
                    new_settings.update(trim_frame.get_settings())
                    new_settings["fade_enabled"] = fade_enabled_var.get()
                    new_settings["fade_in"] = fade_in_var.get().strip()
                    new_settings["fade_out"] = fade_out_var.get().strip()
                    # 串行转场（逐轨常驻）：转场挂本段，末段写回无效（命令生成会忽略末段）
                    new_settings["transition_enabled"] = transition_enabled_var.get()
                    new_settings["transition_type"] = transition_type_var.get().strip() or "fade"
                    new_settings["transition_duration"] = transition_duration_var.get().strip() or "1.0"
                    if loop_chroma_frame is not None:
                        new_settings.update(loop_chroma_frame.get_settings())
                    if overlay_frame is not None:
                        new_settings.update(overlay_frame.get_settings())
                    if is_watermark:
                        new_settings["enabled"] = True
                        new_settings["file_path"] = initial_settings.get("file_path", "")
                        new_settings["duration"] = initial_settings.get("duration", None)
                    else:
                        # 音频绑定设置：画中画 + 串行模式的主视频均收集 BGM；音频源类型 / 音频独立截取仅串行
                        if (is_concat_mode or is_pip) and track_obj is not None and track_obj.type == "video":
                            if is_concat_mode:
                                new_settings["audio_source_type"] = audio_source_type_var.get()
                            if is_main_video and bgm_enabled_var is not None:
                                new_settings["bgm_enabled"] = bgm_enabled_var.get()
                                new_settings["bgm_audio_path"] = bgm_path_var.get().strip()
                                new_settings["bgm_volume"] = bgm_volume_var.get()
                                new_settings["bgm_trim_start"] = bgm_trim_start_var.get().strip()
                                new_settings["bgm_trim_end"] = bgm_trim_end_var.get().strip()
                            if pip_aft_var is not None:
                                new_settings["pip_audio_follow_transition"] = pip_aft_var.get()
                            if is_concat_mode and is_main_video:
                                # 音频独立截取（不分段）：仅主视频 concat 模式
                                new_settings["audio_trim_enabled"] = audio_trim_enabled_var.get()
                                new_settings["audio_trim_start"] = audio_trim_start_var.get().strip()
                                new_settings["audio_trim_end"] = audio_trim_end_var.get().strip()
                            # 以下两项暂不支持，留作未来扩展
                            # new_settings["external_audio_path"] = ""
                            # new_settings["external_audio_stream"] = "0:a:0"

                    new_settings["enhance"] = filt_frame.get_enhance_settings()

                    if track_obj is not None and not is_watermark:
                        # 优先使用自定义输入框，否则使用下拉框值
                        raw_lang = custom_lang_var.get().strip() or lang_var.get().strip()
                        # 尝试映射为标准码
                        if raw_lang:
                            # 如果下拉框选了显示名，但自定义框为空，这里 raw_lang 可能是显示名，需要映射
                            # 我们只对纯代码进行映射，显示名通过下拉框关联
                            # 但为了安全，先尝试从 COMMON_LANGUAGES 反向查找
                            found_code = None
                            for display, code in self.COMMON_LANGUAGES:
                                if display == raw_lang:
                                    found_code = code
                                    break
                            if found_code:
                                new_settings["language"] = found_code
                            else:
                                # 否则视为代码，应用映射表
                                new_settings["language"] = self.LANGUAGE_MAP.get(raw_lang.lower(), raw_lang)
                        else:
                            new_settings["language"] = ""
                        new_settings["title"] = title_var.get().strip()
                        # 章节标签（仅串行模式）
                        if is_concat_mode:
                            new_settings["chapter_label"] = chapter_label_var.get().strip()

                    on_save(new_settings)
                except Exception as e:
                    import traceback
                    traceback.print_exc()
                    messagebox.showerror(_("保存错误"), _('发生错误：{0}\n请查看控制台详细错误。').format(e))
                finally:
                    try:
                        win.destroy()
                    except:
                        pass

            # ---- 效果预览（仅子视频 / 水印；不透明度·混合模式·色度键都是子视频专用）----
            # 用户 2026-10-04：这扇弹窗是**跨分页**生效的（位置/叠加、抠像、滤镜各在一页），
            # 单页里的小预览看不清叠加后的样子 → 统一开一个共享小窗实时显示整帧效果。
            if show_overlay:
                def _open_effect_preview():
                    # 2026-10-09：颜色虚拟源（主 / 子）也要能进效果预览 —— 它俩没有真实文件，
                    # 旧判据 `os.path.exists` 直接把整条预览挡掉（用户报「效果预览里拿不到
                    # 颜色主/子视频」）。修法：① 判据放行哨兵；② 纯颜色项目里 merge_video 字段
                    # 按设计为空 → 回退到首条启用视频轨（可能就是颜色源）。
                    def _file_ok(_p):
                        return bool(_p) and (_is_virtual_source(_p) or os.path.exists(_p))

                    _main_file = (canvas_file or "").strip() if canvas_file else ""
                    if not _main_file:
                        with suppress(Exception):
                            _main_file = (self.merge_video.get() or "").strip()
                    if not _main_file:
                        with suppress(Exception):
                            _vts = [t for t in (getattr(self, "merge_tracks", None) or [])
                                    if getattr(t, "enabled", False)
                                    and getattr(t, "type", "") == "video"]
                            if _vts:
                                _main_file = (getattr(_vts[0], "file_path", "") or "").strip()
                    if not _main_file:
                        with suppress(Exception):
                            _main_file = (self.input_file.get() or "").strip()
                    if not _file_ok(_main_file):
                        alert_if(True, _("提示"), _("请先选择主视频文件（预览要以它为画布）"), 'info')
                        return
                    _sub_file = ""
                    if is_watermark:
                        _sub_file = (initial_settings.get("file_path", "") or "").strip()
                    elif track_obj is not None:
                        _sub_file = (getattr(track_obj, "file_path", "") or "").strip()
                    if not _sub_file:
                        _sub_file = (file_path or "").strip()
                    if not _file_ok(_sub_file):
                        alert_if(True, _("提示"), _("找不到子视频/水印文件，无法预览叠加效果"), 'info')
                        return

                    def _pv_sub_settings():
                        """本弹窗**当前未保存**的画面相关设置（只取画面，音频/编码不进预览）。"""
                        _d = {}
                        with suppress(Exception):
                            _d.update(filt_frame.get_settings())
                        if overlay_frame is not None:
                            with suppress(Exception):
                                _d.update(overlay_frame.get_settings())
                        if loop_chroma_frame is not None:
                            with suppress(Exception):
                                _d.update(loop_chroma_frame.get_settings())
                        with suppress(Exception):
                            _d["enhance"] = filt_frame.get_enhance_settings()
                        if is_watermark:
                            _d["enabled"] = True
                        _d["file_path"] = _sub_file
                        # ⚠️ 此处**刻意不接**列表轨迹实时快照（live_wp_snapshot）。
                        # 2026-10-05 用户拍板：效果预览的语义 = 透明度 / 抠图 / 混合的颜色
                        # 变化，**不该用来反映位置变化**——位置由位置编辑器的虚拟框自己反映
                        # （框内渲染真实帧，拖动天然跟随）。曾在此注入未提交航点 ⇒ 预览跟着
                        # 拖拽乱跳，且航点是时间分段数据、预览停在固定取帧点 ⇒ 表现为
                        # 「永远只有起始点」。方向错误，已回退。
                        return _d

                    def _pv_merge_main_enc():
                        """封装页主视频轨的 enc_settings —— **与成片命令同源**。

                        成片（画中画/平铺）用 `main_video.enc_settings`（= 第一条启用的视频
                        轨道）调 `_build_overlay_filter_complex`（见 `_build_pip_cmd`
                        L49601/49660）。效果预览必须拿**同一份**设置，否则预览里的主视频
                        与成片不是同一个画幅：

                        · 2026-10-05 用户报「平铺到主视频位置外的子视频完全看不到」——
                          缺的正是**主轨 pad 画布**（`pad_enabled/pad_width/pad_height/
                          offset_*`），当时只补了这几个键（旧 `_pv_pad_main_settings`）。
                        · 2026-10-07 用户报「主视频精确缩放到 1600x1600（画布也是
                          1600x1600），外部 ffplay/mpv 里已是新尺寸，效果预览里还是小尺寸
                          主视频 + 大黑画布底」——**同一处缺口**的另一个键族：主视频自身的
                          缩放/裁剪/旋转/画布模式（scale_*/crop_*/rotate/canvas_*）同样只在
                          主轨 enc_settings 里。只补 pad 不够，索性整份取用（同源）。
                          继续按白名单补键 ⇒ 每漏一族就再报一次 bug，不可取。

                        ⚠️ 只去掉 `precise_trim`：预览的「取帧点」是**源时间轴**上的时刻
                        （build_seek_frame_cmd 对主输入下 `-ss t`），若把主轨的精准截取一起
                        套上去，t 落在 trim 区间外时整帧被裁掉 ⇒ 预览全黑（转换页语境天然
                        没有这个键，行为一致）。其余键一律透传 = 与成片同源。
                        返回 None = 当前语境不是封装页 / 没有可用的主视频轨道。
                        """
                        with suppress(Exception):
                            _tracks = [t for t in (getattr(self, "merge_tracks", None) or [])
                                       if getattr(t, "enabled", False)
                                       and getattr(t, "type", "") == "video"]
                            if not _tracks:
                                return None
                            _s = dict(getattr(_tracks[0], "enc_settings", None) or {})
                            _s.pop("precise_trim", None)
                            return _s
                        return None

                    def _pv_main_settings():
                        # 主视频画布：调用方显式给的优先（队列任务）
                        if isinstance(main_settings_ctx, dict) and main_settings_ctx:
                            return dict(main_settings_ctx)
                        # 封装页语境：主视频 = 第一条启用的视频轨道，设置取它的 enc_settings
                        # （与成片命令同源）。⚠️ 语境判定必须用调用方显式声明的 `page_scope`
                        # （edit_video_settings 的入参，转换页传 "convert"），**不能**再拿
                        # 「有没有启用的主轨」当代理——转换页里 merge_tracks 照样有内容，
                        # 旧判据会把封装页设置错灌进转换页预览（preview.md 铁律：禁跨页兜底）。
                        if page_scope == "merge":
                            _m = _pv_merge_main_enc()
                            if _m is not None:
                                return _m
                        with suppress(Exception):
                            return dict(self.get_current_settings() or {})
                        return {}

                    def _pv_build_cmd(src, t, static, bw, bh, mode):
                        # 🔴 2026-10-16（用户第 2 条）：**组父行语境**整条预览改走
                        #   `_build_pip_snapshot_cmd` tap 到 `v_out_<组内主序号>`。
                        #   病根（用户实测两句）：
                        #     ① 「画面帧是组内主视频帧拉伸后的, 而不是我选择的这个组内合成
                        #        节点父行标签的合成帧」—— 旧路径 `_sub_file` = 组内主文件 +
                        #        `_pv_sub_settings()` = 组内主控件的 overlay ⇒ 画面 = 主视频 +
                        #        组内主拉伸图，与「组」无关；
                        #     ② 「坐标一直是原始坐标的 x y，我在位置编辑器移动过父行标签，
                        #        它永远在原始位置的左上角坐标为准」—— 同理，坐标来自组内主
                        #        控件（原始值），组级落位 `grp_dx/dy` / `grp_abs_x/y` 压根没进图。
                        #   修法：与外部实时预览 / 管道预览**同口径** —— 重建整图、tap 到
                        #   **含组落位**的 `v_out_<i>`（组节点 overlay 之后那一环），尾接
                        #   `_pv_fit_scale` 装框。画面/位置都与外部预览一致 ⇒ 用户「希望他
                        #   能和外部的预览位置一样」。
                        #   ⚠️ 判据 = 本窗是**组父行**（`overlay_group_box` 且拿到 key）；
                        #      非组父行逐字节走旧路径（老行为零回归）。
                        #   ⚠️ 取帧点 t 是**源时间轴**上的时刻 —— `_build_pip_snapshot_cmd`
                        #      的 `tap_seek` 正是这个语义（它内部让主/子各自 -ss），可直接用。
                        if overlay_group_box and overlay_group_fx_key:
                            with suppress(Exception):
                                _evs2 = self._get_enabled_video_tracks()
                                if _evs2:
                                    _gt = overlay_track_obj
                                    _gid2 = str(((getattr(_gt, "enc_settings", None) or {})
                                                 .get("grp") or "")).strip()
                                    if _gid2 and _gt is not None:
                                        _mems2 = [x for x in _evs2
                                                  if str((x.enc_settings or {}).get("grp") or "").strip() == _gid2]
                                        _lab2 = self._merge_group_row_label(_gid2, _mems2)
                                        _tap2 = self._group_output_label_for_tap(_lab2, _evs2[1:])
                                        _ncmd, _ = self._build_pip_snapshot_cmd(
                                            _evs2[0], _evs2[1:], tap_label=_tap2,
                                            tap_seek=t, append_vf=_pv_fit_scale(bw, bh),
                                            pipe_ppm=True, tap_seek_exact=True)
                                        if _ncmd:
                                            return _ncmd
                        # 主视频带 alpha（绿幕抠像/遮罩/描边/透明度<1.0）→ 预览叠棋盘格透明指示。
                        # 与成片输出判据同源（_settings_needs_alpha）；不透明主视频不触发（负控）。
                        _pv_alpha = self._settings_needs_alpha(_pv_main_settings())
                        # ⚠️ 主视频是静态图片时也要合成叠加层：原先 `or static` 会让 proc 也走
                        # 无叠加路径，导致「主视频是图片」时效果预览只显示原图、水印/子视频
                        # 完全不出现（build_seek_frame_cmd / _build_overlay_filter_complex 已对
                        # 静态主输入做恒等 setpts 处理，叠加上图可正常合成，实测 rc=0）。
                        if mode != "proc":
                            # 「按住看原帧」必须与「松开看效果」**同画幅**，否则对比的是两张
                            # 不同画幅的图、什么都没比出来。
                            # · 2026-10-05：补了主轨 **pad 画布**（当时只拼一句 pad）。
                            # · 2026-10-07：只拼 pad 不够 —— 主视频自身的几何（缩放/裁剪/
                            #   旋转/画布模式）同样只在主轨 enc_settings 里，用户把主视频缩放
                            #   到 1600x1600 时 proc 铺满画布、orig 还是小尺寸原图。
                            #   现改为与 proc **同一个主设置、同一个构图函数**，只把
                            #   enhance_settings 换成空 {}（原帧=不含「增强」段的底）⇒ orig 与
                            #   proc 之间只剩「叠加层 + 增强」这一组变量，画幅/黑底/偏移完全一致。
                            # ⚠️ 仍不要手拼 `color=c=black[can];[can][0:v]overlay`：
                            #   build_seek_frame_cmd 会 replace **首个** `[0:v]` 注入
                            #   `setpts=PTS+t/TB,`（输入级 -ss 后恢复时间戳，铁律 16），而多输入
                            #   写法里 `[0:v]` 是 overlay 的第 2 个输入 ⇒ 注入串会插进 overlay
                            #   的参数位 → "Invalid argument"（实测踩坑）。走
                            #   `_build_overlay_filter_complex`（无子视频）则 `[0:v]` 只出现在
                            #   主链首、注入点正确，pad 由它内部的 color+overlay 拼出，rc=0。
                            _cf_o, _lb_o = None, None
                            with suppress(Exception):
                                _cf_o, _lb_o = self._build_overlay_filter_complex(
                                    0, _pv_main_settings(), [], include_subtitle_main=False,
                                    enhance_settings={}, reverse=False, main_file_path=src)
                            if _cf_o and _lb_o:
                                return self.build_seek_frame_cmd(
                                    src, [], _cf_o, _lb_o, t,
                                    scale_w=bw, scale_h=bh, fit_box=True, main_alpha=_pv_alpha)
                            return self.build_seek_frame_cmd(src, [], None, None, t,
                                                             scale_w=bw, scale_h=bh,
                                                             fit_box=True, main_alpha=_pv_alpha)
                        # 主设置 = 同一份（封装页=主轨 enc_settings，与成片命令同源；
                        # 转换页=get_current_settings；队列=main_settings_ctx），
                        # 详见 _pv_main_settings / _pv_merge_main_enc 的 docstring。
                        _pv_main = _pv_main_settings()
                        _cf, _lb = None, None
                        with suppress(Exception):
                            _cf, _lb = self._build_overlay_filter_complex(
                                0, _pv_main, [(1, _sub_file, _pv_sub_settings())],
                                include_subtitle_main=False,
                                enhance_settings=_pv_main.get("enhance", {}),
                                reverse=False, main_file_path=src)
                        # ⚠️ fit_box=True：`scale=W:H` 是硬拉伸 → 16:9 会被压成正方形
                        # （2026-10-04 用户报「主视频和子视频都压扁」）。等比装框，
                        # 与 build_enhance_preview_cmd / build_blur_preview_cmd 同一口径。
                        return self.build_seek_frame_cmd(
                            src, [(1, _sub_file, _pv_sub_settings())], _cf, _lb, t,
                            scale_w=bw, scale_h=bh, fit_box=True, main_alpha=_pv_alpha)

                    # 刷新触发（三路，缺一不可）：
                    #   ① filt_frame._preview_callback —— 滤镜/增强页的滑块与勾选会走它（下面链式接管）
                    #   ② loop_chroma_frame 全部 tk 变量 —— 抠像/遮罩/形状页没有回调钩子
                    #   ③ overlay_frame 全部 tk 变量 ——「叠加/偏移」页
                    # ⚠️ 2026-10-04 用户报「下拉叠加效果不刷新，其它勾选都刷新」：混合模式下拉
                    #    的选择处理 `_on_blend_selected`（OverlayPositionFrame 内）**只做**
                    #    `self.blend_mode.set(...)`，既不触发 _preview_callback、其变量也不在
                    #    watch 名单里 → 唯独它不刷新（同页的 X/Y 位置等因走 _preview_callback
                    #    而侥幸能刷新，掩盖了这条缺口）。这里补 ③ 把它整页变量纳进来。
                    # ②③ 的取变量逻辑收敛到 `_frame_tk_vars`（转换页命令预览刷新同款，
                    # 一处改两处受益；跨帧按 id 去重，重复 trace 会让同一次改动重渲两遍）。
                    _watch = _frame_tk_vars(loop_chroma_frame, overlay_frame)
                    _old_cb = getattr(filt_frame, "_preview_callback", None)
                    _pv = open_effect_preview_window(
                        win, self, lambda: _main_file, _pv_build_cmd,
                        watch_vars=tuple(_watch), keep=id(win),
                        title=_("效果预览（实时 · 跨分页）"),
                        tip=_("显示的是本弹窗**当前未保存**的设置叠加到主视频后的整帧效果。\n"
                            "不透明度 / 混合模式 / 色度键 / 模糊半径等任一项改动都会自动重渲。\n"
                            "按住图片看未叠加的原帧。"),
                        status_tip=_("取帧点可改；叠加链与成片/缩略图同源（同一段命令构造代码）。"))
                    if _pv is not None:
                        def _chain_prev(*_a):
                            with suppress(Exception):
                                if callable(_old_cb):
                                    _old_cb(*_a)
                            _pv.schedule()

                        with suppress(Exception):
                            filt_frame._preview_callback = _chain_prev
                        _pv.schedule()

                _row = ttk.Frame(win)
                _row.pack(pady=10)
                ttk.Button(_row, text=_("效果预览"), width=10,
                           command=_open_effect_preview).pack(side=tk.LEFT, padx=(0, 6))
                ToolTip(_row, _("打开共享预览小窗：实时显示本弹窗所有分页设置叠加后的整帧效果。\n"
                              "不透明度 / 混合模式 / 色度键 / 模糊半径改动都会立即重渲。"))
                ttk.Button(_row, text=_("保存"), command=save).pack(side=tk.LEFT, padx=5)
            else:
                ttk.Button(win, text=_("保存"), command=save).pack(pady=10)
            win.wait_window()

    def merge_edit_video_track(self, track_idx, parent=None):
        track = self.merge_tracks[track_idx]
        enabled_videos = [t for t in self.merge_tracks if t.enabled and t.type == "video"]
        is_main = (enabled_videos and enabled_videos[0] == track)
        overlay_mode = 'main' if is_main else 'sub'
        # 2026-10-09：主视频也开放「循环/绿幕控制」面板——绿幕抠像主视频可导出透明素材
        # （面板内「循环播放」等子视频专属项由 main_video_mode 置灰，见 LoopChromaFrame）。
        # 子视频维持「仅在画中画模式显示」的旧行为。
        show_loop = bool(is_main) or self.pip_enabled.get()

        initial_settings = track.enc_settings.copy()
        if "enhance" not in initial_settings:
            initial_settings["enhance"] = {
                "denoise_enabled": False,
                "denoise_spatial": 4.0,
                "denoise_temporal": 3.0,
                "sharpen_enabled": False,
                "sharpen_strength": 1.0,
                "ivtc_enabled": False,
                "deblock_enabled": False,
                "deblock_strength": 4,
                "colorspace_enabled": False,
                "colorspace_matrix": "bt709:bt2020",
            }

        # 颜色虚拟源：file_path 是哨兵串，不能作为真实文件交给滤镜帧取帧/探测；
        # 改传 None 并显式给出画布尺寸（取哨兵里的 W×H），避免设置窗去 stat 不存在的文件。
        if _is_virtual_source(track.file_path):
            _cs = _parse_color_source(track.file_path)
            _cw = _cs[1] if _cs else 1280
            _ch = _cs[2] if _cs else 720
            _edit_file = None
            _canvas_file = None
            _main_video_size = (_cw, _ch)
        else:
            _edit_file = track.file_path
            _canvas_file = self._merge_context_main_video()
            _main_video_size = None

        self.edit_video_settings(
            title=_('视频轨道设置 - {0}').format(track.codec),
            initial_settings=initial_settings,
            on_save=lambda new: self._update_track_enc(track_idx, new),
            file_path=_edit_file,
            is_watermark=False,
            track_idx=track_idx,
            pip_enabled_var=self.pip_enabled,
            overlay_mode=overlay_mode,
            parent=(parent or self.root),
            show_loop_chroma=show_loop,
            main_video_mode=bool(is_main),   # 主视频：循环块/音频/简易预览置灰
            track_obj=track,   # 传递轨道对象
            is_concat_mode=self.concat_enabled.get(),
            canvas_file=_canvas_file,   # 子视频显示时段预览=封装页主视频
            main_video_size=_main_video_size,
            pip_subctrl=(self.pip_enabled.get() and is_main)   # 画中画主视频 → 「子视频控制」页
        )
    
    
    def _update_track_enc(self, idx, new_settings):
        track = self.merge_tracks[idx]  # 先获取 track 对象
        old_encoder = track.enc_settings.get("encoder")
        new_encoder = new_settings.get("encoder")
        # 🔴 2026-10-16：**组归属与组落位必须跨编辑存活**（用户实测「组内编辑任意修改后
        #    都丢失组信息，成员被踢出组，每次改完都要重新编组」）。
        #    根因：设置窗只产出它认识的那批键，`enc_settings` 被**整块替换** ⇒ UI 里看不到
        #    的 `grp` / `is_grp_base` / `grp_dx` / `grp_dy` 全被抹掉。解组走专门的
        #    `_merge_group_*` API（会主动清 key），不会被这里挡住。
        _grp_keep = {_k: _v for _k, _v in (track.enc_settings or {}).items()
                     if _k in _GROUP_KEYS}
        # 原声独立标记同理（2026-10-17）：写在视频轨 enc_settings 上，由「时间分配总览」
        # 置位 —— 视频轨设置窗不认识这个键，整块替换会把它抹掉（同 grp 那次的坑）。
        _det_keep = bool((track.enc_settings or {}).get("audio_detached", False))
        # 分离前的「相对偏移」备份（写在**音频轨**上，同上：窗不认识就整块冲掉）。
        _rel_bak = (track.enc_settings or {}).get("_audio_rel_offset_bak", None)
        track.enc_settings = new_settings
        if _grp_keep:
            for _k, _v in _grp_keep.items():
                # 窗不会再产出这些键 ⇒ 回填不会吞掉用户的编辑
                track.enc_settings[_k] = _v
        if _det_keep:
            track.enc_settings["audio_detached"] = True
        if _rel_bak is not None:
            track.enc_settings["_audio_rel_offset_bak"] = _rel_bak
        # 更新字幕元数据
        track.language = new_settings.get("language", "")
        track.title = new_settings.get("title", "")

        if "enhance" in new_settings:
            track.enc_settings["enhance"] = new_settings["enhance"]
        # 同步属性（兼容旧代码）

        # 缺键时按 True（与 Track 默认一致）：编辑器没产出该键（如 overlay_frame 为 None）
        # 不该把轨道悄悄变成「不叠加」（2026-09-24 修正，原为 False）。
        track.overlay_enabled = new_settings.get("overlay_enabled", True)
        track.overlay_x = new_settings.get("overlay_x", DEFAULT_OVERLAY_X)
        track.overlay_y = new_settings.get("overlay_y", DEFAULT_OVERLAY_Y)
        track.pad_enabled = new_settings.get("pad_enabled", False)
        track.pad_width = new_settings.get("pad_width", "")
        track.pad_height = new_settings.get("pad_height", "")
        track.offset_x = new_settings.get("offset_x", "0")
        track.offset_y = new_settings.get("offset_y", "0")

        # 检测是否切换为 copy（仅在视频轨道且编码器变化时）
        if track.type == "video" and old_encoder != new_encoder:
            if new_encoder == "copy":
                self._append_info_ui(_("[封装] 该视频轨道编码器已设为 copy，视频滤镜将被忽略。"))

        self.merge_refresh_ui()


    def merge_edit_audio_track(self, track_idx=None, node_key=None,
                              initial_settings=None, on_save=None, parent=None):
        is_node = node_key is not None
        if is_node:
            # 节点模式：没有真实轨道，用一个轻量代理承载音频效果设置，
            # 复用整个「音频轨道设置」UI（仅把保存落点改成 on_save，不写回轨道）。
            class _NodeAudioProxy:
                def __init__(self, es):
                    self.enc_settings = dict(es or {})
                    self.language = self.enc_settings.get("language", "")
                    self.title = self.enc_settings.get("title", "")
                    self.codec = _("节点")
                    self.file_path = None
            track = _NodeAudioProxy(initial_settings)
            win_title = _('音频节点效果 [{0}]').format(node_key)
        else:
            track = self.merge_tracks[track_idx]
            win_title = _('音频轨道设置 - {0}').format(track.codec)
        # 宿主窗口（2026-10-18）：None = 主窗（旧行为）；模态二级窗（时间分配总览）
        # 必须把自己的 Toplevel 传进来 —— 见 merge_edit_track_settings 的说明。
        _p = parent or self.root
        with self.SafeToplevel(_p) as win:
            win.title(win_title)
            center_window(win, 880, 570)
            win.transient(_p)
    
            main_frame = ttk.Frame(win, padding="10")
