        self.frame_rate_type.set(settings.get("frame_rate_type", "keep"))
        self.frame_rate_custom.set(settings.get("frame_rate_custom", "30"))
        self.gop_size.set(settings.get("gop_size", ""))
        self.keyint_min.set(settings.get("keyint_min", ""))
        self.frame_sync.set(settings.get("frame_sync", "auto") or "auto")
        self.scale_enabled.set(settings.get("scale_enabled", False))
        self.scale_width.set(settings.get("scale_width", ""))
        self.scale_height.set(settings.get("scale_height", ""))
        self.scale_method.set(settings.get("scale_method", "width"))
        self.scale_algorithm.set(settings.get("scale_algorithm", _("自动")) or _("自动"))
        self.crop_enabled.set(settings.get("crop_enabled", False))
        self.crop_left.set(settings.get("crop_left", "0"))
        self.crop_top.set(settings.get("crop_top", "0"))
        self.crop_width.set(settings.get("crop_width", "iw/2"))
        self.crop_height.set(settings.get("crop_height", "ih"))
        # 简易位置：深拷贝导入（与导出对称），避免共享引用被外部篡改
        _cps = settings.get("crop_pos_segments")
        self.crop_pos_segments = [dict(s) for s in _cps] if _cps else []
        # 简易位置总开关导入（与导出对称）
        self.crop_pos_enabled.set(settings.get("crop_pos_enabled", False))
        # 画布模式：深拷贝导入（与导出对称）
        self.canvas_mode.set(settings.get("canvas_mode", False))
        _ccs = settings.get("canvas_segments")
        self.canvas_segments = [dict(s) for s in _ccs] if _ccs else []
        self.rotate.set(settings.get("rotate", "none"))
        self.vflip.set(settings.get("vflip", False))
        self.hflip.set(settings.get("hflip", False))
        self.speed_enabled.set(settings.get("speed_enabled", False))
        self.speed_factor.set(settings.get("speed_factor", "1.0"))
        self.deinterlace_filter.set(normalize_deinterlace_filter(settings.get("deinterlace_filter", "none")))
        self.pix_fmt_enabled.set(settings.get("pix_fmt_enabled", False))
        self.pix_fmt.set(settings.get("pix_fmt", "yuv420p"))
        self.subtitle_enabled.set(settings.get("subtitle_enabled", False))
        self.subtitle_path.set(settings.get("subtitle_path", ""))
        self.subtitle_charset.set(settings.get("subtitle_charset", "auto") or "auto")
        self.reverse_enabled.set(settings.get("reverse_enabled", False))
        self._blur_enabled.set(settings.get("blur_enabled", False))
        self._blur_type.set(settings.get("blur_type", "delogo"))
        self._blur_strength.set(settings.get("blur_strength", "5"))
        self._blur_x.set(settings.get("blur_x", "1"))
        self._blur_y.set(settings.get("blur_y", "1"))
        self._blur_w.set(settings.get("blur_w", "100"))
        self._blur_h.set(settings.get("blur_h", "100"))
        self._blur_region_only.set(settings.get("blur_region_only", False))
        # 多区域列表：优先取列表；无列表则从旧单键迁移（兼容旧预设/旧快照）
        items = settings.get("blur_items")
        if items:
            self._blur_items = [dict(i) for i in items]
        elif (settings.get("blur_enabled") or settings.get("blur_x") or settings.get("blur_w")):
            self._blur_items = [{
                "enabled": settings.get("blur_enabled", False),
                "type": settings.get("blur_type", "delogo") or "delogo",
                "x": settings.get("blur_x", "1"),
                "y": settings.get("blur_y", "1"),
                "w": settings.get("blur_w", "100"),
                "h": settings.get("blur_h", "100"),
                "strength": settings.get("blur_strength", "5"),
                "region_only": settings.get("blur_region_only", False),
                "enable_start": settings.get("blur_enable_start", ""),
                "enable_end": settings.get("blur_enable_end", ""),
                "enable_cycle": settings.get("blur_enable_cycle", ""),
                "enable_show": settings.get("blur_enable_show", ""),
            }]
        else:
            self._blur_items = []


def _open_tw_position_editor_impl(app, tw, canvas_w, canvas_h, refresh_cb, parent_widget,
                                  ctx_file=None, ctx_settings=None, scope=None,
                                  main_offset=None, main_render_size=None):
    """文字水印位置编辑器公共实现（AdvancedFrame 转换页/队列 与 封装页共用）。

    - tw：要编辑的文字水印设置 dict（写回 overlay_x/overlay_y/font_size/rotate）
    - canvas_w/h：画布尺寸（调用方各自计算：转换页/队列/封装页主视频渲染尺寸）
    - refresh_cb：应用后的刷新回调（命令预览）
    - parent_widget：通用编辑器的宿主控件（AdvancedFrame 自身 / 文字水印对话框）
    - ctx_file/ctx_settings：背景帧语境主视频（2026-09-03 问题②③：队列=task.input+
      task.settings、封装页=主轨 file_path+enc_settings）；
      None → _resolve_editor_bg 按 scope 在本页内兜底（2026-09-23：转换页/封装页
      禁止互相兜底，本页没主视频=纯黑；封装页已有独立文字水印，「注入到封装页」已下线，
      两页不再互相掺）。绝不再无条件封装页优先。
    - main_offset/main_render_size：封装页 pad 时主视频内容在画布中的偏移与渲染尺寸。
      2026-09-23：此前封装页不传 → 画布已是 pad 尺寸、背景帧却被拉伸铺满 → 画面变形；
      与子视频位置编辑器（open_visual_overlay_editor）同款传参后主视频按自身尺寸摆放、
      pad 留黑区保持黑色。None=铺满画布（旧行为，转换页无 pad 功能）。
    """
    text = tw.get("text", "")
    fs = _opt_int(tw.get("font_size", 48), 48)
    # 内容盒估算（2026-09-03 统一为 estimate_text_size，与渲染端 build_text_watermark_filtergraph
    # 同源）：渲染端内容盒 = estimate + 2×pad(8) → 编辑器矩形必须含 pad，否则
    # 「编辑时旋转中心看着居中、渲染后文字中心偏移」；旧 0.7/字符×1.3fs 估算偏宽偏矮。
    # 2026-09-25：与渲染端统一用 _tw_effective_text —— multiline 开保留换行（高盒）、
    # 关拼成一行（矮盒），编辑器矩形与最终渲染严格一致。
    _eff_text = _tw_effective_text(tw)
    _est_w, _est_h = estimate_text_size(_eff_text, "", fs)
    wm_w = _est_w + 16
    wm_h = _est_h + 16
    # 2026-10-05：框内渲染真实文字（drawtext → 透明 PNG），让位置编辑框不再是空参考框。
    # 文字改了才会重新打开本编辑器，故每次进编辑器重渲一次即可；失败则回落旧行为（空框）。
    # ⚠️ 全局开关「位置编辑器显示框内真实帧」关闭时跳过（省一次 ffmpeg，编辑器回退虚拟框）。
    _tw_preview_png = None
    with suppress(Exception):
        _rf_var0 = getattr(app, "editor_real_frame", None)
        if _rf_var0 is None or bool(_rf_var0.get()):
            _tw_preview_png = _render_text_watermark_preview_png(
                app.ffmpeg_cmd, tw, int(wm_w), int(wm_h))
    x_var = tk.StringVar(value=tw.get("overlay_x", "10"))
    y_var = tk.StringVar(value=tw.get("overlay_y", "10"))
    def on_apply(nx, ny, nw, nh, ncw, nch):
        x_var.set(str(nx))
        y_var.set(str(ny))
        tw["overlay_x"] = str(nx)
        tw["overlay_y"] = str(ny)
        # 矩形高度反推字体大小（wm_h = est_th+16 = fs*1.2×行数 + 16 → fs=(nh−16)/(1.2×行数)；
        # 单行即 (nh−16)/1.2，2026-09-03 与 estimate_text_size 行高 1.2fs 对齐）
        if nh > 0:
            _nlines = max(1, _eff_text.count("\n") + 1)
            new_fs = max(8, int(round((nh - 16) / (1.2 * _nlines))))
            old_fs = int(tw.get("font_size", 48))
            if new_fs != old_fs:
                tw["font_size"] = new_fs
                app._append_info_ui(_('[文字水印] 字体大小已更新: {0} → {1}').format(old_fs, new_fs))
        if refresh_cb:
            refresh_cb()
        app._append_info_ui(_('[文字水印] 位置已设置: ({0}, {1})').format(nx, ny))
    title = _("可视化编辑文字水印位置")
    # 文字水印静态旋转角度（-180..180），旋转后为 hypot 正方形包围盒
    _tw_ra = _opt_float(tw.get("rotate", 0) or 0, 0.0)
    _tw_spin = bool(tw.get("spin_enabled", False))
    # 定位语义（2026-08-26 统一）：overlay_x/y 的 w/h 恒为内容盒（wm_w/wm_h），
    # 旋转时 d×d 正方形由编辑器内部自动居中（锚点=内容盒左上角），
    # 不再按正方形包围盒 d 求值（否则初始显示偏左上 (d-w)/2）。
    # 初始坐标：safe_eval_expr 可能返回 0（合法位置），必须用 None 判断而非 `or 10`，
    # 否则 y=0 会被 `0 or 10` 顶成 10，看起来「y 没返回数值」。
    _init_x = safe_eval_expr(x_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})
    _init_y = safe_eval_expr(y_var.get(), {"W": canvas_w, "H": canvas_h, "w": wm_w, "h": wm_h})

    def apply_tw_angle(new_angle):
        tw["rotate"] = float(new_angle or 0.0)
        # 同步回写文字水印对话框内的「旋转角度」数值框（对话框实例存于 app.text_wm_dialog）
        _dlg = getattr(app, "text_wm_dialog", None)
        if _dlg is not None:
            with suppress(Exception):
                if _dlg.winfo_exists():
                    _dlg.rotate_var.set(float(new_angle or 0.0))
        if refresh_cb:
            refresh_cb()
        app._append_info_ui(_('[文字水印] 旋转角度已更新: {0}°').format(new_angle))

    # ---- 背景帧源（2026-09-03 统一）：显式 ctx（队列 task / 封装页主轨）→ 按 scope
    # ---- 在本页内兜底（2026-09-23：转换页/封装页禁止互相兜底，本页没主视频=纯黑）。
    # ---- 旧代码无条件「封装页 merge_video 优先」是问题②③根因（转换页/队列文字水印
    # ---- 第一顺位错取封装页主视频）。
    _bg_file, _main_settings = _resolve_editor_bg(app, ctx_file, ctx_settings, scope=scope)
    _bg_filter = _main_bg_pre_filter(_main_settings) if _main_settings else None

    app._generic_overlay_editor(
        parent_widget, canvas_w, canvas_h,
        10 if _init_x is None else _init_x,
        10 if _init_y is None else _init_y,
        wm_w, wm_h, on_apply, title, None,
        bg_draw_func=None, rect_label=_('文字水印'),
        min_visible_pixels=0, show_scale_tip=False,
        rotate_angle=_tw_ra, angle_cb=apply_tw_angle,
        show_nudge=False,   # 文字水印位置编辑器：看不到画布，无微调按钮
        main_video_file=_bg_file or None,   # 背景帧=实际主视频当前帧
        main_offset=main_offset,            # pad 时主视频内容偏移（超出画布部分留黑）
        main_render_size=main_render_size,  # pad 时主视频自身渲染尺寸（None=铺满画布）
        bg_pre_filter=_bg_filter,           # 主视频 crop/rotate（防背景帧变形）
        # 2026-10-05：框内渲染真实文字（不再是空参考框）；content_rgba=带 alpha 透明 PNG。
        content_file=_tw_preview_png, content_alpha=True, content_rgba=True,
        coord_box=True,
        draw_diagonal=False)


# ---------------------------------------------------------------------------
# 对话框内自包含撤销/重做（2026-09-29 Phase 2；2026-10-15 三处实现收口成一个 module）
#
# 🔴 与主窗口 FFmpegBatchGUI 的多栈引擎（_do_undo(scope)，command 模式）
#    **刻意保持独立**：本栈只管单个对话框的列表（items / segments / chapters）
#    增删改与导入，关窗即随对象销毁、自动丢弃，
#    绝不污染主窗口的 convert/merge/tasks 历史。
#    ⛔ 因此不要把它注册成主引擎的一个 scope —— 两者生命周期语义不同。
#
# interface 只有 6 个方法（snapshot / begin_edit / push / undo / redo /
# refresh_buttons），藏在后面的是：前/后态深拷贝、空步骤丢弃
# （before == after 不入栈）、push 后清 redo 栈、按钮文案与可用态同步。
# 三个 adapter：TextWatermarkDialog / SegmentEditor / ChapterEditor。
#
# 用法（各对话框 __init__ 内一句注入，随后 6 个同名方法仅作转发壳）：
#     self._tw_undo = DialogUndoStack(self, "items", self._tw_after_restore,
#                                     "_tw_undo_btn", "_tw_redo_btn")
# ---------------------------------------------------------------------------
class DialogUndoStack:
    """对话框级 snapshot 撤销栈：begin_edit() → 改 state → push(label)。

    owner            持有被撤销列表的对话框实例
    state_attr       该列表的属性名（"items" / "segments" / "chapters"）
    after_restore    回写 state 之后重建 UI 的回调（各对话框自己的树/表单刷新）
    undo_btn_attr / redo_btn_attr
                     撤销/重做按钮的属性名（按钮在 __init__ 之后才建好，
                     故存属性名、用时再取，避开初始化顺序耦合）
    """

    def __init__(self, owner, state_attr, after_restore, undo_btn_attr, redo_btn_attr):
        self._owner = owner
        self._state_attr = state_attr
        self._after_restore = after_restore
        self._undo_btn_attr = undo_btn_attr
        self._redo_btn_attr = redo_btn_attr
        self._undo_stack = []
        self._redo_stack = []
        self._pending_before = None

    def snapshot(self):
        return copy.deepcopy(getattr(self._owner, self._state_attr))

    def begin_edit(self):
        """在任意破坏性编辑前调用，记录「前态」到待提交位。"""
        self._pending_before = self.snapshot()

    def push(self, label):
        """编辑完成后调用：以 pending_before 为前态、当前为后态登记一步撤销。"""
        before = self._pending_before
        self._pending_before = None
        if before is None:
            return
        after = self.snapshot()
        if before == after:
            return
        self._undo_stack.append({"label": label, "before": before, "after": after})
        self._redo_stack.clear()
        self.refresh_buttons()

    def undo(self):
        if not self._undo_stack:
            return
        entry = self._undo_stack.pop()
        setattr(self._owner, self._state_attr, copy.deepcopy(entry["before"]))
        self._redo_stack.append(entry)
        self._after_restore()
        self.refresh_buttons()

    def redo(self):
        if not self._redo_stack:
            return
        entry = self._redo_stack.pop()
        setattr(self._owner, self._state_attr, copy.deepcopy(entry["after"]))
        self._undo_stack.append(entry)
        self._after_restore()
        self.refresh_buttons()

    def refresh_buttons(self):
        if self._undo_stack:
            getattr(self._owner, self._undo_btn_attr).configure(
                state="normal", text=_("撤销：{0}").format(self._undo_stack[-1]['label']))
        else:
            getattr(self._owner, self._undo_btn_attr).configure(state="disabled", text=_("撤销"))
        if self._redo_stack:
            getattr(self._owner, self._redo_btn_attr).configure(
                state="normal", text=_("重做：{0}").format(self._redo_stack[-1]['label']))
        else:
            getattr(self._owner, self._redo_btn_attr).configure(state="disabled", text=_("重做"))


class FilterGraph:
    """filter_complex 标签流汇编器：收口预览路径里反复手搓的「取 label → 拼 filter → 改名 cur」idiom。

    四个预览入口里，仅 _preview_with_settings 与 merge_preview_pip_live 在方法体内手搓
    cur 游标 + parts 列表（重复同一套写法），现已接入本汇编器：cur 自动推进、join 统一、
    消除手搓游标导致的 [[v0]] 双括号 class bug
    （见 merge_preview_pip_live 约 L60313 的注释：统一尝试版 33530 写成 f"[{cur}]" → 双括号）。
    ⚠️ 另两个入口不接：
      · merge_preview_track 走 wrap_image_static_timed_complex 不同 sink、仅 3 op，
        强套抽象收益极小且有碰歪逐字契约风险；
      · merge_preview_concat_lavfi 不手搓 cur/parts，而是复用「单一来源」
        _build_concat_video_graph（L58436，与正式导出命令同源）：其装配是「逐段循环 + xfade
        转场」拓扑，与本项目线性 cur 推进模型不契合，且改动会波及真实导出命令，故不接。

    接口（9 方法）：chain 线性 / link 显式单输入 / combine 二元(src+cur) /
    source 源(不引用 cur) / split 多输出(不前进) / raw 完整串 / extend 批量 /
    prepend 头部插入(画中画首段) / build 拼装。
    ⚠️ 语义铁律：只有「主视频流且输出成为新主游标」的 chain/combine 才 advance=True；
    子视频流（link）与 split/audio（advance=False）不得前进 cur，否则下游引用错位。
    """

    def __init__(self, start="[VIN]"):
        self._parts = []
        self.cur = start

    def chain(self, frag, out, advance=True):
        """线性：cur + frag → [out]，并推进 cur。"""
        self._parts.append(f"{self.cur}{frag}[{out}]")
        if advance:
            self.cur = f"[{out}]"
        return self

    def link(self, src, frag, out, advance=False):
        """显式单输入（子视频流）：src + frag → [out]，默认不前进 cur。"""
        self._parts.append(f"{src}{frag}[{out}]")
        if advance:
            self.cur = f"[{out}]"
        return self

    def combine(self, src, frag, out, advance=True):
        """二元（overlay/blend）：src + cur + frag → [out]，默认推进 cur。"""
        self._parts.append(f"{src}{self.cur}{frag}[{out}]")
        if advance:
            self.cur = f"[{out}]"
        return self

    def source(self, frag, out):
        """源不引用 cur（color=/movie=），不前进 cur。"""
        self._parts.append(f"{frag}[{out}]")
        return self

    def split(self, n, labels):
        """cur → n 个输出（split=2[cur_cr2][cur_ov2]），cur 不前进。"""
        self._parts.append(f"{self.cur}split={n}{labels}")
        return self

    def raw(self, frag, advance_to=None):
        """已含完整标签的串（build_canvas_filtergraph / build_text_watermark_chain 返回）。"""
        self._parts.append(frag)
        if advance_to is not None:
            self.cur = f"[{advance_to}]"
        return self

    def extend(self, frags):
        """批量原始串（_make_blend_region 返回的列表）。"""
        self._parts.extend(frags)
        return self

    def prepend(self, frag):
        self._parts.insert(0, frag)
        return self

    def build(self):
        return ";".join(self._parts)


class TextWatermarkDialog(tk.Toplevel):
    """文字水印设置窗口（drawtext）

    settings_target: 要编辑的文字水印设置 dict。默认 None → 编辑 app.text_watermark_settings
        （主界面全局）。队列任务编辑必须传入任务自己的 text_watermark dict，
        否则「队列里改文字水印」会改到转换主界面、且对任务不生效。
    refresh_cb: 设置变化后刷新命令预览的回调。默认 None → 用主界面 adv_frame 的回调；
        队列任务编辑传入任务编辑窗口的 update_preview。
    """
    def __init__(self, parent, app, settings_target=None, refresh_cb=None,
                 settings_container=None, position_editor_cb=None, canvas_file=None,
                 canvas_settings=None, canvas_scope=None):
        super().__init__(parent)
        self.withdraw()
        self.app = app
        self.parent = parent
        # 上下文主视频（叠加层时间线基准，时间预览/轨迹/位置编辑器共用）：
        # 队列任务编辑=task.input、封装页=merge_video/主轨道；None=回退转换页 app.input_file。
        self.canvas_file = (canvas_file or "").strip()
        # 上下文主视频设置（画布渲染/背景帧 crop+rotate 预处理同源，问题④）：队列=task.settings、
        # 封装=主轨 enc_settings；None → 轨迹编辑器回退转换页 get_current_settings。
        self.canvas_settings = canvas_settings
        # 宿主页作用域（2026-09-23）：'convert'/'merge' —— canvas_file 为空时只在本页
        # 内找主视频，绝不用另一页的主视频兜底抽帧（本页没主视频=纯黑背景帧）。
        # None → 按 'convert' 处理（旧调用点行为）。
        self.canvas_scope = canvas_scope
        self.settings = settings_target if settings_target is not None else app.text_watermark_settings
        self.tw_refresh = refresh_cb
        # 位置编辑器回调（封装页独立文字水印入口传入）：None → 委托 parent._open_text_wm_position_editor
        self._pos_editor_cb = position_editor_cb
        # 多文字水印容器（2026-08-26）：None → 主界面（app.text_watermark_items）；
        # 队列任务编辑 → task.settings（写 text_watermark_items）；封装页 → self._merge_tw dict
        self.items_container = settings_container if settings_container is not None else app
        # 多实例列表：优先容器.text_watermark_items，空则迁移当前单条。
        # ⚠️ 2026-08-26 修复：主界面容器是 App 对象（非 dict），原来只对 dict 容器读列表，
        #   导致「保存后重开只剩最开始那条空白项」——列表写进了 app.text_watermark_items
        #   却从未读回。这里统一支持 dict 与对象两种容器。
        if isinstance(self.items_container, dict):
            _items = self.items_container.get("text_watermark_items")
        else:
            _items = getattr(self.items_container, "text_watermark_items", None)
        if not _items:
            # 容器还没建列表（新启用 / 旧存档）⇒ 以 legacy 单条设置作第一项迁移。
            # ⚠️ 2026-10-11：这里统一交给下一行的 deepcopy，**不要**先 dict() 浅拷贝 ——
            #   浅拷贝会让 items[0] 与源 settings 共享 move_waypoints 等列表字段
            #   （同一个坑 2026-08-27 在 _add_tw_item 踩过：多条共享一条轨迹列表）。
            #   原写法里 dict() 的结果立刻被下面的 deepcopy 覆盖，纯属多余且误导。
            _items = [self.settings]
        self.items = [copy.deepcopy(i) for i in _items]
        self.settings = self.items[0] if self.items else {}
        self._tw_last_sel = None
        # 对话框内自包含撤销/重做栈（关窗即弃，不污染主窗口历史）；仅覆盖水印项列表增删移
        # 🔴 实现在模块级 DialogUndoStack；本类 6 个 _tw_* 方法仅作转发壳（调用点零改动）。
        self._tw_undo = DialogUndoStack(
            self, "items", self._tw_after_restore, "_tw_undo_btn", "_tw_redo_btn")
        # 2026-08-26：_load_tw_form 期间置守卫，避免 var.set() → trace(_tw_sync_x 等)
        # → _refresh_tw_tree → selection 事件 → _load_tw_form 递归
        self._tw_loading = False
        # 保存到主应用，便于位置编辑器「应用」时同步回写本窗口的旋转角度数值框
        with suppress(Exception):
            app.text_wm_dialog = self
        self.title(_("文字水印"))
        self.transient(parent)
        self.grab_set()
        self.resizable(False, False)

        # 2026-09-19：新增「倒计时（滚动小窗）」控件组（约 +120px），780 → 905
        width, height = 500, 905
        center_window(self, width, height)

        self.create_widgets()
        self._refresh_tw_tree()
        # 默认选中第 0 项：表单初始即对应 items[0]，且 _tw_last_sel 有值，
        # 之后「添加/切换/确定」能把表单编辑正确收集回列表（否则编辑内容丢失）
        if self.items:
            with suppress(Exception):
                self.tw_tree.selection_set("0")
            self._tw_last_sel = 0
        self.deiconify()

    def create_widgets(self):
        from tkinter.colorchooser import askcolor
        main = ttk.Frame(self, padding="10")
        main.pack(fill=tk.BOTH, expand=True)

        s = self.settings

        # ---- 多文字水印列表（2026-08-26：可添加多个文字水印）----
        list_frame = ttk.LabelFrame(main, text=_("多条文字水印（选中项编辑下方参数）"), padding="3")
        list_frame.grid(row=0, column=0, columnspan=4, sticky="ew", pady=3)
        self.tw_tree = ttk.Treeview(list_frame, columns=("en", "txt", "pos"), show="headings", height=3)
        self.tw_tree.heading("en", text=_("启用"))
        self.tw_tree.heading("txt", text=_("文字内容"))
        self.tw_tree.heading("pos", text=_("位置"))
        self.tw_tree.column("en", width=42, anchor="center")
        self.tw_tree.column("txt", width=220)
        self.tw_tree.column("pos", width=150)
        self.tw_tree.pack(fill=tk.X, padx=3, pady=(3, 1))
        self.tw_tree.bind("<<TreeviewSelect>>", self._on_tw_select)
        self.tw_tree.bind("<ButtonRelease-1>", self._on_tw_click)
        self.tw_tree.bind("<Button-1>", self._on_tw_blank_click)  # 点空白取消选中（未选中→预览回溯全部）
        tw_btn = ttk.Frame(list_frame)
        tw_btn.pack(fill=tk.X, padx=3, pady=(0, 3))
        self._tw_undo_btn = ttk.Button(tw_btn, text=_("撤销"), state="disabled", width=5, command=self._tw_do_undo)
        self._tw_undo_btn.pack(side=tk.LEFT, padx=1)
        self._tw_redo_btn = ttk.Button(tw_btn, text=_("重做"), state="disabled", width=5, command=self._tw_do_redo)
        self._tw_redo_btn.pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text=_("添加"), width=5, command=self._add_tw_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text=_("删除"), width=5, command=self._del_tw_item).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text=_("上移"), width=5, command=lambda: self._move_tw_item(-1)).pack(side=tk.LEFT, padx=1)
        ttk.Button(tw_btn, text=_("下移"), width=5, command=lambda: self._move_tw_item(1)).pack(side=tk.LEFT, padx=1)
        ttk.Label(tw_btn, text=_("点「启用」列可切换"), foreground="gray").pack(side=tk.LEFT, padx=8)

        # ---- 启用（当前项）----
        self.enabled_var = tk.BooleanVar(value=s.get("enabled", False))
        ttk.Checkbutton(main, text=_("启用文字水印"), variable=self.enabled_var).grid(
            row=1, column=0, sticky="w", pady=5)

        # ---- 基础参数区（文字内容 → 描边颜色）----
        # 2026-09-04 布局改造：这一整段原为 grid 单行排布，但 grid 的列宽由该列「最宽控件」
        # 决定——文字内容输入框(width=28)与透明度滑块(length=150)会把 col1 撑到最宽，
        # 于是字号/颜色这类短控件右侧留下一大片空白，视觉上对不齐。
        # 现改为「每行一个 Frame + 行内 pack」：间隔完全由 padx 控制，标签定宽对齐，
        # 与下方「显示时段」seg_frame 的既有做法（8952 行注释）保持一致。
        # ⚠️ 整段占用 row=2 一个格子、内部自行 pack，故下方 row=9 起的 14 处行号无需改动。
        basic = ttk.Frame(main)
        basic.grid(row=2, column=0, columnspan=4, sticky="ew")
        # 标签统一宽度（英文字符单位；最长标签「描边颜色:」约为 11），保证控件左边缘对齐
        LBL_W = 12

        def _tw_row():
            """建一个参数行（行内 pack，规避 grid 列宽被最长控件撑大导致的列间空白）"""
            _f = ttk.Frame(basic)
            _f.pack(fill=tk.X, pady=3)
            return _f

        # ---- 文字内容 ----
        _r = _tw_row()
        ttk.Label(_r, text=_("文字内容:"), width=LBL_W, anchor="w").pack(side=tk.LEFT)
        self.text_var = tk.StringVar(value=s.get("text", ""))
        text_entry = ttk.Entry(_r, textvariable=self.text_var, width=30)
        text_entry.pack(side=tk.LEFT, padx=(0, 5))
        # 富文本（2026-09-19）：多行编辑入口。普通模式把多行拼成一行显示；
        # 倒计时模式按行拆分逐行排版（见 countdown_lines / build_tw_countdown_subgraph）。
        ttk.Button(_r, text=_("富文本"), width=6,
                   command=self._open_rich_text_editor).pack(side=tk.LEFT, padx=(0, 4))
        # 富文本换行（2026-09-25）：勾选后渲染保留换行（竖排 / @字体式），不再拼成一行；
        # 与「启用倒计时」互斥（见 _tw_sync_multiline / _tw_sync_countdown）。
        self.multiline_var = tk.BooleanVar(value=bool(s.get("multiline", False)))

        def _tw_sync_multiline(*_a):
            if getattr(self, "_tw_loading", False):
                return
            st = self.settings
            _on = bool(self.multiline_var.get())
            st["multiline"] = _on
            if _on and getattr(self, "cd_enabled_var", None) is not None and self.cd_enabled_var.get():
                # 与倒计时互斥：勾选富文本换行 → 关掉倒计时
                self.cd_enabled_var.set(False)
                st["countdown_enabled"] = False
            self._sync_item_to_container()
            self._refresh_tw_tree()
            self._refresh()

        ttk.Checkbutton(_r, text=_("富文本换行"), variable=self.multiline_var,
                        command=_tw_sync_multiline).pack(side=tk.LEFT)
        self.multiline_var.trace_add("write", _tw_sync_multiline)

        # ---- 字体（内置中文在前 → 常用英文 → 系统扫描字体，2026-09-04）----
        _r = _tw_row()
        ttk.Label(_r, text=_("字体:"), width=LBL_W, anchor="w").pack(side=tk.LEFT)
        self.font_var = tk.StringVar(value=s.get("font_name", _("微软雅黑")))
        try:
            _font_values = merged_font_names()      # 触发/复用字体缓存（~30ms，无感）
        except Exception:
            _font_values = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
        self.font_combo = ttk.Combobox(_r, textvariable=self.font_var, state="readonly",
                                       values=_font_values, width=18)
        self.font_combo.pack(side=tk.LEFT, padx=(0, 5))
        # 原选中值若不在新列表（极端情况：缓存重建后名称变化），回落到内置第一项
        if self.font_var.get() not in _font_values:
            self.font_var.set(_font_values[0] if _font_values else _("微软雅黑"))

        # 「检测本地」：强制重扫系统字体并刷新上方下拉（正常情况无需点——
        # 启动时已自动扫描并缓存；装了新字体后下拉没出现时才需要。扫描 ~30ms）。
        def _rescan_system_fonts():
            try:
                _lst = force_rescan_fonts()
            except Exception as _e:
                _lst = []
            _names = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
            _seen = set(_names)
            for _f in _lst:
                if _f.get("name") not in _seen:
                    _seen.add(_f["name"])
                    _names.append(_f["name"])
            self.font_combo.config(values=_names)
            if self.font_var.get() not in _names:
                self.font_var.set(_names[0] if _names else _("微软雅黑"))
            messagebox.showinfo(_("检测本地字体"),
                                _('已重新检测系统字体，共 {0} 个可选项。').format(len(_names)),
                                parent=self)

        ttk.Button(_r, text=_("检测本地"), command=_rescan_system_fonts,
                   width=8).pack(side=tk.LEFT)
        ToolTip(_r, _("重新扫描 C:\\Windows\\Fonts 下的全部字体并刷新上方下拉。\n"
                "安装新字体后下拉未出现时点一下即可（无需重启程序）。"),
                wraplength=340)

        # ---- 外部字体文件（留空则用上方「字体」下拉的系统字体）----
        # 2026-09-04：Entry → Combobox，下拉=最近用过的外部字体路径（来自
        # fonts_cache.json 的 recent_external），历史路径点选即填，也可继续手改。
        _r = _tw_row()
        _lbltt5 = ttk.Label(_r, text=_("外部字体:"), width=LBL_W, anchor="w")
        _lbltt5.pack(side=tk.LEFT)
        # 仅回填「用户显式指定」的外部字体；不能用 font_path（它含系统字体解析结果，
        # 回填后编辑框非空会覆盖后续所有下拉选择）。详见 resolve_ext_font_path。
        self.ext_font_var = tk.StringVar(value=resolve_ext_font_path(s))
        try:
            _recent = get_recent_external_fonts()
        except Exception:
            _recent = []
        self.ext_font_combo = ttk.Combobox(_r, textvariable=self.ext_font_var,
                                           values=_recent, width=30)
        self.ext_font_combo.pack(side=tk.LEFT, padx=(0, 5))

        def _browse_ext_font():
            _p = filedialog.askopenfilename(
                title=_("选择字体文件"),
                filetypes=[(_("字体文件"), "*.ttf *.ttc *.otf"), (_("所有文件"), "*.*")],
                parent=self)
            if _p:
                self.ext_font_var.set(_p)

        ttk.Button(_r, text=_("浏览"), command=_browse_ext_font, width=6).pack(side=tk.LEFT)

        def _clear_ext_font():
            self.ext_font_var.set("")

        ttk.Button(_r, text=_("清空"), command=_clear_ext_font, width=6).pack(side=tk.LEFT)
        ToolTip(_lbltt5,
                _("留空则使用上方「字体」下拉所选的系统字体。\n"
