        # --- 统一坐标（左 / 上） ---
        btn_unify_xy = ttk.Button(row1, text=_("统一坐标"), command=self._apply_unified_coords, width=10)
        btn_unify_xy.pack(side=tk.LEFT, padx=(12, 2))
