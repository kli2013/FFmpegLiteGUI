STYLE_ORDER = ["warm", "cool", "cold_noir", "vintage", "mono", "sepia", "tealorange",
               "green_fade", "airy", "drama", "vibrant", "vignette", "grain",
               "soft", "sharpen", "colorize", "duotone", "thermal"]

# 需要 FFmpeg 5+ 才跑得起来的 look（2026-10-04 实证，见 research/ffmpeg-colorbalance-43/）：
#   warm/cool 用 `colortemperature` —— 4.3 根本没有这个滤镜（No such filter）
#   thermal   用 `pseudocolor=preset=…` —— 4.3 的 pseudocolor 没有 `preset` 选项
# ⚠️ 2026-10-04 用户拍板：**不在下拉里加任何标注**（加了下拉框显示不全，"暖阳（需 FFmpeg
#    FFmpeg" 被截断）。显示名一律用 style_choices() 的干净名字，兼容原因只走两条出口：
#    ① 滤镜灰字标签 `_look_blocked_reason`；② 预览/导出失败时的报错文案
#       （`ffmpeg_preview_failure_reason` 点名缺失滤镜 + 版本 + 升级出路）。
#    因此这里**允许选中**，不回落 —— 选了照实失败并说清为什么，比「不让点但没说明」好。
STYLE_PRESETS_NEED_FFMPEG5 = ("warm", "cool", "thermal")


def _style_display_to_token(display):
    """显示名 → token；认不出来返回空串（＝不选预设）。

    ⚠️ 双版同构：**不建模块级中文反查表**（历史上的 STYLE_DISPLAY_TO_TOKEN）——
    那种表在导入期就把中文显示名冻住，英文界面下拉会退回中文。改为每次调用时
    走 `style_display_name()` 现算（它内部包 `_()`，随界面语言变化）。
    base 侧同名函数结构相同、只是不包 `_()`（恒等返回中文）⇒ 归一化后逐字一致。
    同款写法见 xfade（`xfade_display_name` / `xfade_display_choices`）。
    改这一处务必同步另一版，反之亦然。
    """
    _d = display or ""
    if not _d or _d == _("无"):
        return ""
    for _t in STYLE_ORDER:
        if style_display_name(_t) == _d:
            return _t
    return ""




def _look_needs_newer_ffmpeg(token, ffmpeg_cmd):
    """当前 ffmpeg 跑不了这个 look 吗（4.x 缺 colortemperature / pseudocolor 的 preset=）。

    版本认不出来（None）时一律返回 False —— 宁可让它照实失败，也不无端禁掉一个可能的风格。
    """
    if token not in STYLE_PRESETS_NEED_FFMPEG5:
        return False
    _ver = ffmpeg_version(ffmpeg_cmd) or ""
    _m = re.match(r"(\d+)", _ver)
    return (not _m) or (int(_m.group(1)) < 5)


def _look_blocked_reason(token, ffmpeg_cmd):
    """「为什么这个 look 当前跑不起来」的中文说明。

    只显示在**滤镜灰字标签**上（不再混进下拉显示名，见 STYLE_PRESETS_NEED_FFMPEG5 处
    的说明）：选了照实跑，失败时另有 `ffmpeg_preview_failure_reason` 点名缺失滤镜。
    """
    _ver = ffmpeg_version(ffmpeg_cmd) or _("未知版本")
    if token == "thermal":
        _why = _("当前 FFmpeg {} 的 pseudocolor 没有 preset 选项").format(_ver)
    else:
        _why = _("当前 FFmpeg {} 没有 colortemperature 滤镜").format(_ver)
    return _("{}：{}，预览/导出会失败（升级 FFmpeg 5+ 或换其他风格）").format(
        STYLE_PRESETS.get(token, ("", ""))[0], _why)


def style_display_name(token):
    """返回预设的中文显示名（带 _() 包裹，随界面语言翻译）。"""
    return _(STYLE_PRESETS[token][0])


def style_choices():
    """下拉框可用项：无 + 各预设显示名（按 STYLE_ORDER）。"""
    return [_("无")] + [style_display_name(t) for t in STYLE_ORDER]


def _look_with_enable(chain, enable_expr):
    """给风格 look 链逐个子滤镜挂同一份时间段 enable 表达式（接入 enh_seg，2026-10-03）。

    为什么要单独写（而不是把 look 塞进 enh 段统一包裹）：链里的 `format=`
    **不支持 timeline** —— 实测 n9.0.1 报

        Timeline ('enable' option) not supported with filter 'format'
        （4.3 报 Use '|' to separate the filters）

    挂上去整条链都跑不起来。故对 `format=` 跳过（常开），其余滤镜照常挂 enable，
    链尾补一枚 `format=yuv420p` 把像素格式收回。跳过 format 的判据与
    `_scale_look_chain` 同款（按 '=' 前的名字比较）。

    ⚠️ 别拿「窗口外帧 == 原帧」当验收判据 —— 多滤镜链的 yuv420p↔rgb 静态格式协商会带来
    max=2 / mean=0.35 的往返舍入（80750 个差异字节全是它，肉眼不可见），写了会假 FAIL。
    正确判据见 tests/_test_look_seg_enable.py E1–E5：窗口外**逐字节 == 同链挂恒假 enable
    （gte(t,9999)）** → 证明被真正关闭；窗口内 max 差 >8 → 证明真的生效。

    ⚠️ 链拆分依赖「选项值里没有裸逗号」：现 18 个预设的选项一律用 ':' 分隔参数、
    curves 的点对用空格分隔，成立；新增预设不得在选项值里写裸逗号。
    """
    if not chain or not enable_expr:
        return chain
    out = []
    _has_fmt = False
    for part in chain.split(','):
        _p = part.strip()
        if not _p:
            continue
        if _p.split('=', 1)[0].strip() == "format":
            _has_fmt = True
            out.append(_p)
            continue
        out.append(_p + _region_enable_suffix(enable_expr, _p))
    if _has_fmt:
        out.append("format=yuv420p")
    return ','.join(out)


def _preserve_colorbalance_lightness(chain):
    """给链里每条 `colorbalance=` 补 `:pl=1`（preserve lightness），纯函数、不改别的。

    ⚠️ 2026-10-04 实证（research/ffmpeg-colorbalance-43/）：**FFmpeg 4.x 的 colorbalance 在
    默认 `pl=false` 时不保持亮度** —— 同一段 `colorbalance=bs=0.25:bm=0.12`，
    4.3 把整帧平均亮度从 124.7 推到 **191.8**（加蓝就整体提亮），n7.1/n9 只到 125.3。
    两版 `pl` 默认值相同（false），是 4.3 那个实现自身的缺陷（该滤镜后来被重写过）。
    补 `pl=1` ⇒ 4.3=125.6 / n9=125.7，**完全重合**。

    ▸ 为什么**无条件补、不做版本判断**：`pl=1` 在新 ffmpeg 上的漂移只有 ≤6 平均亮度
      （cold_noir 55.6→58.3、green_fade 121.3→116.5、vintage 120.6→123.0，肉眼几乎不可见），
      换来的是「所有版本行为一致 + 预览与导出天然同源」；而按主版本号门控就得把 ffmpeg
      路径透传给 build_video_filter_chain 的 16 个调用点——漏一个，那次导出还是过曝。
      宁可让新版轻微趋同，也不要留一条「有的路径修了、有的没修」的暗缝。

    ▸ 只补 pl、不碰别的：本函数唯一的副作用就是给 colorbalance 加一个保持亮度的选项，
      不与「预览链不许改」的铁律冲突（那条规定禁止的是**按能力删滤镜**导致链尾归一化段被截掉）。
      已在 tests/_test_look_colorbalance_pl.py 用真机亮度对齐守着。
    """
    if not chain or "colorbalance=" not in chain:
        return chain
    _out = []
    for _seg in chain.split(","):
        _p = _seg.strip()
        if _p.startswith("colorbalance=") and "pl=" not in _p:
            _p = _p + ":pl=1"
        _out.append(_p)
    return ",".join(_out)


def build_video_filter_chain(settings: Dict[str, Any], include_subtitle: bool = True, include_speed: bool = True,
                              include_trim: bool = True, include_format: bool = True, include_scale: bool = True,
                              enhance_settings=None, reverse=False, graph_id: str = "",
                              include_fade: bool = True, clip_duration=None,
                              include_negate: bool = True,
                              include_mask: bool = True,
                              chroma_settings=None, loop_size=None, force_scale=None,
                              motion_trim_start=None, motion_speed_factor=None,
                              window_start=None, window_end=None, window_loop_count=None,
                              include_alpha: bool = False) -> str:
    """
    从设置字典构建视频滤镜链。
    include_subtitle: 是否包含字幕滤镜
    include_speed: 是否包含变速滤镜
    include_trim: 是否包含精准截取（trim+setpts）滤镜
    include_format: 是否包含像素格式转换（format）滤镜
    enhance_settings:高级一点的滤镜
    graph_id: 当本滤镜链会被拼进同一个 filter_complex（画中画/串联合并等多路场景）时，
              调用方传入唯一标识，用于给「局部模糊」等带标签的子图生成互不冲突的标签名。
    顺序优化：
    精准截取 → 局部模糊/去水印 → 裁剪 → 旋转/翻转 → 缩放 → IVTC（反胶卷过带） → 反交错 →
    去块滤波 → 降噪 → 锐化 → 色彩空间转换 → 颜色校正+色相 → 像素格式 → 变速 → 倒放
    绿幕/纯色抠像默认插在缩放之后（小图抠）；与去水印/区域效果同时启用时改前置到
    链首（精准截取/loop 之后、去水印之前），保证抠像取样以原始画面为准。

    注意：「局部模糊」会生成带标签的分支子图（split/overlay），返回值可能是包含 ';' 的
    完整 filtergraph，而不再是单纯的逗号串。-vf 与 filter_complex 均支持该语法。
    """
    filters = []

    # 绿幕/纯色抠像滤镜串（公共拼装，见 _build_chroma_filter）：默认插在缩放后；
    # 与区域滤镜（delogo/局部效果）同时启用时前置到链首——区域链里带颜色处理的
    # 类型会改写区域色度，抠像若排在区域链之后会吃到被改过的像素 → 抠不干净。
    _chroma_f = _build_chroma_filter(chroma_settings)
    _chroma_front = bool(_chroma_f) and _has_region_fx(settings)

    # 2026-10-09：主视频「透明度」(include_alpha)。子视频的透明度由 overlay 构建器单独处理
    # （见 _build_overlay_filter_complex 的 colorchannelmixer），故默认 False → 子视频零回归。
    # 仅当显式 requesting 且 alpha_enabled 且值<1.0 才生效（=1.0 无视觉变化，不必写 alpha）。
    _alpha_on = False
    _alpha_av = 1.0
    if include_alpha and settings.get("alpha_enabled", False):
        try:
            _alpha_av = float(settings.get("alpha_value", 1.0))
        except (ValueError, TypeError):
            _alpha_av = 1.0
        _alpha_on = (0.0 <= _alpha_av < 1.0)

    # 提前确定硬件滤镜模式与「帧是否已在显存」（供像素格式处理使用）
    _filter_mode = settings.get("hw_filter_mode")
    if not _filter_mode:
        if settings.get("wrap_cpu_nvidia"):
            _filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            _filter_mode = "vaapi"
        else:
            _filter_mode = "cpu"
    _hw_active = _filter_mode in ("cuda", "qsv", "vaapi")
    _native = _hw_active and settings.get("hwaccel_enabled", False) and _decoder_matches_api(settings.get("hwaccel_decoder", ""), _filter_mode)

    # ----- 精准截取（trim + setpts）-----
    if include_trim and settings.get("precise_trim", False) and settings.get("trim_enabled", False):
        start = settings.get("trim_start", "").strip()
        end = settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start) if start else None
        end_sec = time_to_seconds(end) if end else None
        if start_sec is not None or end_sec is not None:
            trim_parts = []
            if start_sec is not None:
                trim_parts.append(f"start={_ffsec(start_sec)}")
            if end_sec is not None:
                trim_parts.append(f"end={_ffsec(end_sec)}")
            if trim_parts:
                filters.append(f"trim={':'.join(trim_parts)}")
                filters.append("setpts=PTS-STARTPTS")

    # ----- 子视频循环（loop）-----
    # loop_size 非 None 时在 trim 之后、其余滤镜之前插 loop（子视频画中画/水印用：
    # movie 层只载入不循环，由这里统一循环 trim 片段或整段）。非循环场景（主视频/普通转码）
    # 不传 loop_size，行为不变。
    # ⚠️ 2026-09-02 窗口优化（抄统一尝试版）：当 window 生效（有界显示窗口）时，loop 改为
    # 「有限循环，仅覆盖窗口时长」(loop=loop=窗口循环次数:size=片段长)，而非无限 loop=-1 ——
    # 即凡是有限显示都走 loop=N 节省模式；仅「无界窗口」(show_start 无 end / loop_mode=infinite)
    # 才维持无限 loop=-1。窗口外不产生帧、下游重滤镜只在窗口内运行，省掉「enable 隐藏但内部
    # 照跑」的浪费；并把子链首帧锚到输出时间线 show_start，子链在 show_end 正常 EOF，
    # 配合调用方追加 eof_action=pass 避免冻帧/截断。
    # ⚠️ 结构（与统一尝试版 2869 逐字一致）：**window 判定在外层**，loop_size 在内层——
    # 不能写成「loop_size 在外、window 在内」，否则未开截取（loop_size=None）时窗口锚定
    # 不生效，有限显示窗口形同虚设。
    if window_start is not None and window_end is not None and window_end > window_start:
        if loop_size is not None and loop_size > 0:
            # window_loop_count = **重复次数**（总供给 = N+1 遍）。显式 0 = 窗口一遍即满，
            # 不加 loop（防回放帧 pts 回退泄漏进显示边界 → 闪首帧）；None 才兜底 1（旧行为）。
            if window_loop_count is None:
                _wc = 1
            else:
                _wc = int(window_loop_count)
            if _wc > 0:
                filters.append(f"loop=loop={_wc}:size={int(loop_size)}:start=0")
        # 锚定子链首帧到输出时间线 show_start（TB=输入时基，show_start/TB 即 show_start 秒）。
        # 此时 PTS 已归零（截取/loop 保证），setpts 同时完成重置+偏移；窗口外不产生帧。
        filters.append(f"setpts=PTS-STARTPTS+{float(window_start):.6g}/TB")
    else:
        if loop_size is not None and loop_size > 0:
            filters.append(f"loop=loop=-1:size={int(loop_size)}:start=0")

    # ----- 绿幕/纯色抠像（前置模式：与区域滤镜同开时排到滤镜链最前）-----
    # 区域链（delogo/局部效果）中带颜色处理的类型会改写区域色度；抠像若排在区域链之后，
    # 取样吃到的是被改过的像素 → 抠不干净。两者同开时把抠图提到区域链之前（仅在
    # trim/loop 之后），取样以原始画面为准。
    # ⚠️ 2026-09-07 实测 n9.0.1：chromakey/colorkey 输出带 alpha，其后接 delogo / eq /
    # negate / boxblur / lutyuv 及区域子图(split/overlay)，alpha 全程保留（自动插入的
    # 格式转换不丢透明），前置无副作用。
    if _chroma_front:
        filters.append(_chroma_f)

    # ----- 去水印/模糊（必须排在裁剪/旋转/缩放之前，坐标才与原始帧一致）-----
    # 显示时段换算基准（2026-09-13 修复）：本链 trim+setpts 已把滤镜 t 归零，delogo/
    # 区域效果的 enable 窗口若直接用源时间会整体右偏 trim 起点（如 trim=6.567 起、
    # 窗口 between(t,6.567,20) 的前 6.567s 永不命中）。基准解析与 crop_pos 同源
    # （motion_trim_start 优先，否则取 settings 的 trim_start）。
    # ⚠️ 只减 trim 不除 speed：区域链位在变速 setpts 之前（链尾 drawtext 才做全换算）。
    if motion_trim_start is not None:
        _blur_tbase = float(motion_trim_start)
    else:
        _blur_tbase, _unused = _trim_speed_from_settings(settings)
    if settings.get("blur_enabled", False):
        # 多区域列表（2026-08-26）：遍历 blur_items 生成多条；无列表时回退旧单键（统一出口）
        blur_items = _effective_blur_items(settings)
        for _bi in blur_items:
            if not _bi.get("enabled", True):
                continue
            blur_type = str(_bi.get("type", "delogo") or "delogo").strip()
            x = str(_bi.get("x", "1")).strip() or "1"
            y = str(_bi.get("y", "1")).strip() or "1"
            w = str(_bi.get("w", "100")).strip() or "100"
            h = str(_bi.get("h", "100")).strip() or "100"
            strength = _bi.get("strength", "5")
            region_only = _bi.get("region_only", False)

            # 显示时段 / 循环控制（与文字水印同套 enable 表达式；2026-08-26 新增）
            _enable_expr = _build_drawtext_enable(_bi, trim_start=_blur_tbase)
            _sfx_en = f":enable='{_enable_expr}'" if _enable_expr else ""

            if blur_type == "delogo":
                _wps = _bi.get("waypoints") or []
                if _wps:
                    # 表达式轨迹（2026-10-09）：x/y 由航点驱动，w/h 恒静态（只平移 x/y）。
                    # 撞段墙直接抛错（不做降级 Route B——crop 全局贴回参考像素质量差）。
                    _xexpr, _yexpr = _delogo_waypoints_to_exprs(
                        _wps, trim_start=_blur_tbase)
                    filters.append(
                        f"delogo=x='{_xexpr}':y='{_yexpr}':w={w}:h={h}{_sfx_en}")
                else:
                    filters.append(f"delogo=x={x}:y={y}:w={w}:h={h}{_sfx_en}")
            elif blur_type in _REGION_EFFECT_FILTERS:
                # 区域效果（2026-09-07）：局部反色 / 镜像 / 去色 / 纯色 / 锐化 / 描边 …
                # 全部走同一条并行子图，恒局部（不看 region_only）。新增类型只改
                # _REGION_EFFECT_FILTERS，不必动这里。
                _spec = _REGION_EFFECT_FILTERS[blur_type]
                _tpl = _spec["tpl"]
                if "{s}" in _tpl:
                    _sv = str(strength).strip() or str(_spec.get("default", ""))
                    _f = _tpl.format(s=_sv)
                else:
                    _f = _tpl
                # ⚠️ 无参滤镜（negate/hflip…）必须 =enable=，冒号写法 ffmpeg 解析失败
                _f += _region_enable_suffix(_enable_expr, _f)
                if _bi.get("full_frame", False):
                    # 全帧时间段效果（2026-09-07）：不框区域，直接主链追加。
                    # 时间段（enable）照常生效 → 「5~8 秒亮度高一点」这类需求；
                    # 卷积类全帧无裁剪边界 → 无需 bleed。delogo/boxblur/gblur 不走此路
                    #（delogo 必须框区域；boxblur/gblur 不勾「仅应用到选定区域」即全帧）。
                    filters.append(_f)
                else:
                    _sfx = graph_id or ""
                    _idx = blur_items.index(_bi) if blur_items else 0
                    _sfx += f"{_spec.get('tag', 'e')}{_idx}"
                    _bg, _fg, _bl = f"rb{_sfx}bg", f"rb{_sfx}fg", f"rb{_sfx}bl"
                    if _spec.get("neighbor"):
                        # 卷积类：外扩 k px 处理完再裁回原尺寸，消除区域边缘的硬接缝
                        _outer, _inner = _region_bleed_geom(x, y, w, h, int(_spec.get("bleed", 8)))
                        _sub = f"{_outer},{_f},{_inner}"
                    else:
                        _sub = f"crop={w}:{h}:{x}:{y},{_f}"
                    filters.append(
                        f"split=2[{_bg}][{_fg}];"
                        f"[{_fg}]{_sub}[{_bl}];"
                        f"[{_bg}][{_bl}]overlay={x}:{y}"
                    )
            elif blur_type in ("boxblur", "gblur"):
                if blur_type == "boxblur":
                    _blur_f = f"boxblur={strength}:{strength}{_sfx_en}"
                else:
                    _blur_f = f"gblur=sigma={strength}{_sfx_en}"
                if region_only and w and h:
                    # 局部模糊：把原帧一分为二，一路裁出目标区域做模糊，再叠回原位。
                    # 生成的是带标签的分支子图，因此本函数返回值可能含 ';'。
                    # 多条时用序号后缀避免标签冲突。
                    # 2026-09-07：卷积类同样外扩，消除区域边缘的硬接缝（11dB → 65dB）。
                    _sfx = graph_id or ""
                    _idx = blur_items.index(_bi) if blur_items else 0
                    _sfx += f"b{_idx}"
                    _bg, _fg, _bl = f"rb{_sfx}bg", f"rb{_sfx}fg", f"rb{_sfx}bl"
                    _outer, _inner = _region_bleed_geom(x, y, w, h, _REGION_BLUR_BLEED.get(blur_type, 24))
                    filters.append(
                        f"split=2[{_bg}][{_fg}];"
                        f"[{_fg}]{_outer},{_blur_f},{_inner}[{_bl}];"
                        f"[{_bg}][{_bl}]overlay={x}:{y}"
                    )
                else:
                    filters.append(_blur_f)

    # ----- 遮罩 / 透明蒙版：实现见「negate 之后」的链尾区块（2026-09-10 两迁：裁剪前 → 缩放后 → 链尾，抠图兼容）-----
    # ----- 裁剪 -----
    if settings.get("crop_enabled", False):
        w = settings.get("crop_width", "").strip()
        h = settings.get("crop_height", "").strip()
        left = settings.get("crop_left", "0").strip()
        top = settings.get("crop_top", "0").strip()
        if w and h:
            # 简易位置：有分段时 x/y 用按时间 t 插值的单引号表达式（QSV 不支持 → 走软件）
            # 2026-08-29：段时间=主视频原始时间，生成时自动换算输出时间线（滤镜 t）
            # 2026-08-30：画布模式已接管「动态移动」，故开启画布模式时忽略 crop_pos（避免双重位移）
            _cps = settings.get("crop_pos_segments")
            _canvas_on = bool(settings.get("canvas_mode")) and bool(settings.get("canvas_segments"))
            _cpos_on = bool(settings.get("crop_pos_enabled", False))
            if _cps and _cpos_on and not _canvas_on:
                try:
                    if motion_trim_start is not None:
                        _ts0 = float(motion_trim_start)
                        _sp0 = float(motion_speed_factor) if motion_speed_factor is not None else 1.0
                    else:
                        _ts0, _sp0 = _trim_speed_from_settings(settings)
                    _ex, _ey = build_crop_pos_expr(_cps, left, top,
                                                   trim_start=_ts0, speed_factor=_sp0)
                except Exception:
                    _ex = _ey = None
                # sendcmd 接入（行数 > 阈值；2026-10-01 全量接入）：sendcmd 挂 crop 前同链，
                # 命令目标 = crop 完整别名（graph_id 保证同图多链不撞名）；
                # 静态 x/y 占位 = 首命令值（t=0 命令首帧未应用，同列表航点做法）
                _csc = None
                if _ex and _ey and len(_cps) > _wp_sc_rows_limit():
                    try:
                        _civ = build_crop_pos_intervals(_cps, left, top,
                                                        trim_start=_ts0, speed_factor=_sp0)
                    except Exception:
                        _civ = None
                    if _civ:
                        _csc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                            _civ, f"cpp{graph_id or 'm'}", target=f"crop@cpp{graph_id or 'm'}")
                if _csc is not None:
                    filters.append(f"sendcmd=f='{_csc}'")
                    filters.append(f"crop@cpp{graph_id or 'm'}={w}:{h}:"
                                   f"'{_civ[0][3]:g}':'{_civ[0][4]:g}'")
                elif _ex and _ey:
                    filters.append(f"crop={w}:{h}:'{_ex}':'{_ey}'")
                else:
                    filters.append(f"crop={w}:{h}:{left}:{top}")
            else:
                filters.append(f"crop={w}:{h}:{left}:{top}")

    # ----- 旋转/翻转 -----
    rot = settings.get("rotate", "none")
    if rot == "90":
        filters.append("transpose=1")
    elif rot == "180":
        filters.append("transpose=2,transpose=2")
    elif rot == "270":
        filters.append("transpose=2")
    if settings.get("vflip", False):
        filters.append("vflip")
    if settings.get("hflip", False):
        filters.append("hflip")

    # ----- IVTC（反胶卷过带）-----
    # 隔行场信息在缩小后会被平均丢失，fieldmatch/decimate 需在接近原始分辨率做 → 提前到缩放前
    ivtc_enabled = enhance_settings and enhance_settings.get("ivtc_enabled", False)
    if ivtc_enabled:
        filters.append("fieldmatch,decimate")

    # ----- 反交错（仅当 IVTC 未启用时执行）-----
    # 同样提前到缩放前，保留完整场信息（缩放后反交错易拉丝/误判）
    if not ivtc_enabled:  # 添加条件
        deint = normalize_deinterlace_filter(settings.get("deinterlace_filter", "none"))
        # 防御：旧设置/模板可能存 bool（False/True），str 之外一律忽略，否则会被直接
        # append 进滤镜链导致 ",".join 崩溃（expected str instance, bool found）
        if isinstance(deint, str) and deint not in ("none", ""):
            filters.append(deint)

    # ----- 缩放 -----
    if force_scale is not None and isinstance(force_scale, (tuple, list)) and len(force_scale) == 2:
        # 预览强制渲染尺寸：替代调用方外部手动 scale（防双 scale）
        _fw = int(force_scale[0])
        _fh = int(force_scale[1])
        if _fw > 0 and _fh > 0:
            filters.append(f"scale={_fw}:{_fh}")
    elif include_scale and settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        w = settings.get("scale_width", "").strip()
        h = settings.get("scale_height", "").strip()
        # 缩放算法（2026-10-08）：自动/非法 → 空串（不写 flags，走 ffmpeg 默认）
        _alg = _norm_scale_algorithm(settings.get("scale_algorithm", ""))
        _alg_s = (":" + "flags=" + _alg) if _alg else ""
        if method == "width" and w:
            filters.append(f"scale={w}:-2{_alg_s}")
        elif method == "height" and h:
            filters.append(f"scale=-2:{h}{_alg_s}")
        elif method == "exact" and w and h:
            filters.append(f"scale={w}:{h}{_alg_s}")

    # ----- 绿幕/纯色抠像（子视频水印/画中画，默认位置）-----
    # 插在缩放之后 → 小图抠（性能）；且颜色校正/色相/反色在其后 → 不影响抠像。
    # 仅当未与区域滤镜（delogo/局部效果）同时启用时在此插入；同时启用时已在链首
    # 前置（见 _chroma_front），保证抠像取样以原始画面为准。
    # 只有画中画/水印子视频传 chroma_settings（非 None 即启用抠像）；主视频/普通转码不传。
    if _chroma_f and not _chroma_front:
        filters.append(_chroma_f)

    # ----- 增强滤镜统一时间段（2026-09-30）：捕获本块起点，块末统一挂 enable -----
    enh_start_idx = len(filters)

    # ----- 去块滤波（2026-08-27：强度 weak/medium/strong + 块尺寸 4/8，覆盖 HandBrake 式 strength/blocksize） -----
    if enhance_settings and enhance_settings.get("deblock_enabled", False):
        _f = str(enhance_settings.get("deblock_strength", "weak") or "weak")
        # 旧值兼容：旧字段存数值（如 4，当时作 block 用）→ 映射 weak
        if _f not in ("weak", "medium", "strong"):
            _f = "weak"
        _blk = int(enhance_settings.get("deblock_block", 4) or 4)
        if _blk not in (4, 8):
            _blk = 4
        filters.append(f"deblock=filter={_f}:block={_blk}")
    
    # ----- 降噪（2026-08-27：hqdn3d 轻量 / nlmeans 高质量，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("denoise_enabled", False):
        spatial = enhance_settings.get("denoise_spatial", 4.0)
        temporal = enhance_settings.get("denoise_temporal", 3.0)
        mode = str(enhance_settings.get("denoise_mode", "hqdn3d") or "hqdn3d")
        if mode == "nlmeans":
            # nlmeans：非局部均值，去噪强但慢（10~50×hqdn3d）；s 范围 [1-30]（实测 ffmpeg 报错确认），
            # 直接映射空间强度值并 clamp；p/pc/r/rc 保持默认
            _s = max(1.0, min(30.0, float(spatial)))
            filters.append(f"nlmeans=s={_s:.1f}:p=7:pc=3:r=5:rc=2")
        else:
            # hqdn3d 参数：空间亮度, 空间色度, 时间亮度, 时间色度
            filters.append(f"hqdn3d={spatial:.1f}:{spatial*0.75:.1f}:{temporal:.1f}:{temporal*0.75:.1f}")
    
    # ----- 锐化（2026-08-27：unsharp USM / cas 对比度自适应，HandBrake 式双模式） -----
    if enhance_settings and enhance_settings.get("sharpen_enabled", False):
        strength = enhance_settings.get("sharpen_strength", 1.0)
        mode = str(enhance_settings.get("sharpen_mode", "unsharp") or "unsharp")
        if mode == "cas":
            # cas：对比度自适应锐化，强度 0-5 → strength 0-1
            _s = max(0.0, min(1.0, float(strength) / 5.0))
            filters.append(f"cas=strength={_s:.2f}")
        else:
            # unsharp 参数：luma_msize_x:luma_msize_y:luma_amount:chroma_msize_x:chroma_msize_y:chroma_amount
            filters.append(f"unsharp=5:5:{strength:.2f}:5:5:{strength*0.5:.2f}")
    

    
    # ----- HDR→SDR 色调映射（2026-09-09：zscale+tonemap 经典链） -----
    # 本机 n9.0.1 实测：仅支持**已标记** HDR10(PQ)/HLG 源（未标记源用 zscale min/tin
    # 强转会触发 zimg "no path between colorspaces"，本构建 setparams 也无颜色选项）；
    # SDR 标记源过链无副作用（线性往返）。输出恒为 bt709/tv 标记（链内 zscale 完成，
    # 与「输出颜色标记」互补：链内打的是帧标记，容器标记仍由 append_video_output_extras 落）。
    # 末尾 format 用像素格式设置值（yuv420p 默认；alpha 遮罩场景由后续 format=rgba 覆盖）。
    if enhance_settings and enhance_settings.get("tonemap_enabled", False):
        _alg = str(enhance_settings.get("tonemap_mode", "hable") or "hable")
        if _alg not in ("hable", "mobius", "reinhard"):
            _alg = "hable"
        filters.append("zscale=t=linear:npl=100")
        filters.append("format=gbrpf32le")
        filters.append("zscale=p=bt709")
        filters.append(f"tonemap=tonemap={_alg}:desat=0")
        filters.append("zscale=tin=linear:t=bt709:m=bt709:p=bt709:r=tv")
        _tm_pix = "yuv420p"
        if include_format and settings.get("pix_fmt_enabled", False) \
                and not settings.get("mask_enabled", False):
            _tm_pix = str(settings.get("pix_fmt", "yuv420p") or "yuv420p")
        filters.append(f"format={_tm_pix}")

    # ----- 色彩空间转换 -----
    if enhance_settings and enhance_settings.get("colorspace_enabled", False):
        matrix = enhance_settings.get("colorspace_matrix", "bt709:bt2020")
        filters.append(f"colormatrix={matrix}")

    # ----- 颜色校正（eq）-----
    if enhance_settings:
        eq_parts = []
        b = enhance_settings.get("eq_brightness", 0.0)
        if b != 0.0:
            eq_parts.append(f"brightness={b:.2f}")
        c = enhance_settings.get("eq_contrast", 1.0)
        if c != 1.0:
            eq_parts.append(f"contrast={c:.2f}")
        s = enhance_settings.get("eq_saturation", 1.0)
        if s != 1.0:
            eq_parts.append(f"saturation={s:.2f}")
        g = enhance_settings.get("eq_gamma", 1.0)
        if g != 1.0:
            eq_parts.append(f"gamma={g:.2f}")
        if eq_parts:
            filters.append(f"eq={':'.join(eq_parts)}")

    # ----- 色相调整（hue）-----
    # ⚠️ ffmpeg hue 滤镜大小写是两种单位，别写反（2026-10-03 实测，纯红单帧验证）：
    #     小写 h = **度**：hue=h=180 → 青绿（补色）✅ 我们要的
    #     大写 H = **弧度**：hue=H=3.14159 → 青绿；hue=H=6.28319 → 红（转满一圈回原点）
    #   旧代码用大写 H 却喂「度」的滑块值（-180~180）→ 180 弧度≈10313°，整条滑块跑了
    #   约 57 圈色相环（用户反馈「紫色出现两次、感觉循环了」），故必须改回小写 h。
    #   s 的基准是 **1.0**（s=0=全去色、s=-1=色相翻转），UI 滑块是「增减量」(-1~1，0=原样)，
    #   因此要写 1+delta —— 旧代码直接把滑块值当 s 传，导致 0→跳过(原样)、1→也是原样，
    #   非空单调（中段反而变灰），同属 bug。
    if enhance_settings:
        hue_parts = []
        h_angle = enhance_settings.get("hue_angle", 0.0)
        if h_angle != 0.0:
            hue_parts.append(f"h={h_angle:.1f}")          # 度（小写 h）
        h_sat = enhance_settings.get("hue_saturation", 0.0)
        if h_sat != 0.0:
            hue_parts.append(f"s={max(0.0, 1.0 + h_sat):.2f}")  # 基准 1.0 + 增量，下限 0（全灰）
        if hue_parts:
            filters.append(f"hue={':'.join(hue_parts)}")

    # ----- 反色（negate）-----
    # 放在颜色校正/色相之后、像素格式之前（靠后）。绿幕 chromakey 无论默认位置（缩放后）
    # 还是前置模式（链首）都先于 negate，negate 天然在抠图之后生效，不影响抠像——
    # 子视频调用点不再需要 include_negate=False + 外部补丁。
    if include_negate and enhance_settings and enhance_settings.get("negate_enabled", False):
        filters.append("negate")

    # ----- 增强滤镜统一时间段（2026-09-30）-----
    # 本块（deblock→negate）位于 speed(setpts=1/factor*PTS) 之前：滤镜入口 t = 输出t × speed_factor
    # （出口 t = 入口t/factor）。用户填的是输出时间线秒数，故 _build_enh_seg_enable 已把窗口常数
    # 乘 speed_factor 换算回入口时间；trim 已在入口 t 起点归零（与输出时间线同起点），无需再减。
    # 对整段增强滤镜（含 tonemap 6 段与内部 format）统一挂同一 enable —— 各滤镜均支持 T(timeline)，
    # 窗口外帧原样透传，不破坏下游格式/坐标（与 fade/字幕同套机制，方向相反）。
    # 2026-10-03：表达式算到外层变量上 —— 风格预设(look) 不在这个切片里（它在切片之后才追加），
    # 但要挂**同一份**时间口径，故留给 _look_with_enable 单独包裹。
    _enh_en = ""
    if enhance_settings and enhance_settings.get("enh_seg_enabled", False):
        _enh_sp = _opt_float(settings.get("speed_factor", "1.0") or "1.0", 1.0)
        if _enh_sp <= 0:
            _enh_sp = 1.0
        _enh_en = _build_enh_seg_enable(enhance_settings, _enh_sp)
    if _enh_en:
        _enh_slice = filters[enh_start_idx:]
        filters[enh_start_idx:] = [f + _region_enable_suffix(_enh_en, f) for f in _enh_slice]

    # ----- 风格预设（look）-----
    # 纯内置滤镜链、无外部 LUT；强度 i<=0 时跳过（退化为恒等）。
    # 2026-10-03 起接入 enh_seg 时间段：链内每个子滤镜挂同一表达式，窗口外帧原样透传，
    # 行为与其余增强滤镜完全一致。
    # ⚠️ 旧注释称「sepia/duotone/green_fade/thermal 都含 format=gbrp，故独立于 enh_seg」
    #   是错的 —— 实测 STYLE_PRESETS 里**只有 thermal** 带 format=，当年把 4 个预设一起
    #   挡在门外纯属误伤。真正不支持 timeline 的也只有 format 这一个滤镜 → 见 _look_with_enable。
    if enhance_settings:
        _sp = enhance_settings.get("style_preset", "") or ""
        try:
            _raw = enhance_settings.get("style_intensity", 1.0)
            _si = float(_raw) if _raw not in (None, "") else 1.0
        except (TypeError, ValueError):
            _si = 1.0
        if _sp and _si > 0:
            _entry = STYLE_PRESETS.get(_sp)
            if _entry:
                _chain = _scale_look_chain(_entry[1], _si)
                # 4.x 的 colorbalance 默认 pl=false 会整体提亮（124.7→191.8），补 pl=1 修正；
                # 导出链与预览链共用这一段，故成片也一并修正。见 _preserve_colorbalance_lightness。
                _chain = _preserve_colorbalance_lightness(_chain)
                if _chain:
                    filters.append(_look_with_enable(_chain, _enh_en))

    # ----- 遮罩 / 透明蒙版（最终渲染帧空间，WYSIWYG）-----
    # 2026-09-10 两迁记录：裁剪前（原始帧）→ 缩放之后 → 链尾（本位置，抠图兼容见下）。
    # 遮罩始终落在 crop/rotate/scale 之后的最终渲染帧上，与画布/显示/转换三同一坐标系；
    # 编辑器拖出的坐标直接可用，零换算（中间滤镜均不改尺寸，链尾坐标系不变）。
    # ⚠️ 锁色：matte 分支用 format=gray，ffmpeg 自动格式协商会把 scale 输出从 yuv420p 降级为
    #   gray → 主输入在 alphamerge 前丢失色彩（整帧发灰）。故在 split 之前插 format=rgba 锁死主
    #   输入像素格式；matte 的 gray 仅限 [m] 分支局部使用，互不影响（fix: tests/_repro_mask_gray2）。
    # 2026-09-10 抠图兼容（与绿幕 chromakey/colorkey 同开）：整段移到「negate 之后、像素
    # 格式之前」的链尾——绿幕无论默认位置（缩放后）还是前置模式（delogo 同开时链首）都
    # 已在前；下方 3 处 alphamerge 前加 alpha 相乘（alphaextract+blend=multiply），拿到的
    # 既有 alpha 即抠图结果 → 最终 alpha = 抠图 × 遮罩 matte（交集）。无抠图时 format=rgba
    # 补 alpha=255，乘法=matte 本身，与旧「替换」语义逐帧等效——一条链兼容全部组合，
    # 消除「谁后到谁通吃」（旧链序绿幕默认位置遮罩失效 / 前置位置抠图失效）。
    # delogo/区域效果只改像素不改 alpha（见 3218 行实测背书注释），与 matte 相乘零冲突。
    # ----- 遮罩 / 透明蒙版（最终渲染帧空间，WYSIWYG）-----
    # 2026-09-10 两迁记录：裁剪前（原始帧）→ 缩放之后 → 链尾（本位置，抠图兼容见下）。
    # 遮罩始终落在 crop/rotate/scale 之后的最终渲染帧上，与显示/转换同一坐标系；
    # 编辑器拖出的坐标直接可用，零换算（中间滤镜均不改尺寸，链尾坐标系不变）。
    # ⚠️ 锁色：matte 分支用 format=gray，ffmpeg 自动格式协商会把 scale 输出从 yuv420p 降级为
    #   gray → 主输入在 alphamerge 前丢失色彩（整帧发灰）。故在 split 之前插 format=rgba 锁死主
    #   输入像素格式；matte 的 gray 仅限 [m] 分支局部使用，互不影响（fix: tests/_repro_mask_gray2）。
    # ⚠️ 2026-09-12 画布模式（方案 A）：画布模式下遮罩**不在这里**生成 —— 画布把 crop/rotate/scale
    #   全交给画布段，此处若照旧作用在「画布前的内容帧」会与遮罩坐标（按最终渲染帧）错位，
    #   表现为「一开画布模式遮罩就失效」。改由 build_canvas_filtergraph 在画布段产出之后追加，
    #   判据共用 _canvas_defers_mask（两处必须一致，否则双重遮罩 / 遮罩丢失）。
    # ----- 外轮廓描边（2026-10-02 新增）-----
    # ⚠️ 顺序钉死：描边必须在遮罩**之前**。描边沿"当前可见轮廓"走，遮罩是"挖掉一块"，
    #   挖出来的洞口不该长描边；若反序（先遮罩后描边），遮罩的矩形洞口会被描上一圈边。
    # ⚠️ 画布模式下描边**不延后**（与遮罩不同）：遮罩延后是因为它的坐标基准是最终渲染帧；
    #   描边只看 alpha 形状、不消费任何坐标，画布怎么挪都不影响它的形状语义。
    #   副作用：画布模式会把描边连同内容一起缩放（宽度按比例变），已写进入口 tooltip。
    if settings.get("outline_enabled", False):
        _oseg = _build_outline_filter_block(settings, graph_id)
        if _oseg:
            filters.append(_oseg)

    # 段内容（多形状 → 单形状 PNG → 轨迹挡板 → 静态矩形）见 _build_mask_filter_block。
    if include_mask and settings.get("mask_enabled", False) \
            and not _canvas_defers_mask(settings):
        _mseg = _build_mask_filter_block(
            settings, graph_id, None, None, motion_trim_start, motion_speed_factor)
        if _mseg:
            filters.append(_mseg)

    # ----- 透明度（主视频专用；子视频的透明度在 overlay 构建器里处理）-----
    # 排在遮罩/描边之后 → 对整幅最终画面统一乘 alpha；先 format=rgba 确保 alpha 平面存在。
    if _alpha_on:
        filters.append(f"format=rgba,colorchannelmixer=aa={_alpha_av:.2f}")


    # ----- 像素格式 -----
    if include_format and settings.get("pix_fmt_enabled", False):
        # 硬件滤镜模式下，纯硬件/混合链路在边界统一处理像素格式，不在中间插入软件 format
        if not _hw_active or not _native:
            # 遮罩启用时，本滤镜链已写入 alpha，必须用 rgba 保留透明通道
            # （否则默认的 yuv420p 会把刚生成的透明区丢掉）
            # ⚠️ 画布模式下遮罩已延后（_canvas_defers_mask）→ 本链不写 alpha，走普通像素格式。
            # 2026-10-02：描边同样写 alpha（且画布模式下不延后）→ 一并进 rgba 判据。
            # 2026-10-09：主视频透明度同样写 alpha → 一并进 rgba 判据。
            if (settings.get("mask_enabled", False) and not _canvas_defers_mask(settings)) \
                    or settings.get("outline_enabled", False) \
                    or _alpha_on:
                filters.append("format=rgba")
            elif _chroma_f:
                # 2026-10-10 用户报「转换页预览没透明是因为勾选了像素格式（fmt）」：
                # 本链里已有抠图滤镜（chromakey 输出 yuva420p、自带 alpha），若照旧发用户勾的
                # `format=yuv420p`，就把刚抠出来的 alpha 整幅丢掉 ⇒ 预览里被抠掉的区域仍显示
                # 原始底色（看着像「透明没接入」）；不勾像素格式时链尾保持 chromakey 的
                # yuva420p，透明正常 —— 用户实测口径正是如此。
                # 修法与导出**同源**：透明分支本就强制 pix_fmt=yuva420p（转换页
                # _generate_ffmpeg_command_core / 封装页 _build_normal_cmd），这里发同一个
                # yuva420p ⇒ 预览链与成片链逐字一致，播放器/编码器都能拿到 alpha。
                # ⚠️ 画布模式下主视频抠像本就不生效（base 链由 build_canvas_filtergraph 重建）
                # ⇒ 沿用「发用户勾的格式」，画布模式行为逐字节不变。
                filters.append("format=yuva420p")
            else:
                filters.append(f"format={settings.get('pix_fmt', 'yuv420p')}")
    
    # ----- 变速 -----
    if include_speed and settings.get("speed_enabled", False):
        try:
            factor = float(settings.get("speed_factor", "1.0"))
            if factor > 0 and factor != 1.0:
                filters.append(f"setpts={1.0/factor}*PTS")
        except ValueError:
            pass
    
    # ----- 字幕烧录（2026-08-27：支持 charenc 字符编码，解决 GBK/GB18030 中文 SRT 乱码） -----
    if include_subtitle and settings.get("subtitle_enabled", False):
        sub_path = settings.get("subtitle_path", "").strip()
        if sub_path:
            sub_path = sub_path.replace('\\', '/')
            sub_path = sub_path.replace(':', '\\:')
            sub_path = sub_path.replace("'", "\\'")
            _ch = str(settings.get("subtitle_charset", "auto") or "auto").strip().lower()
            if _ch and _ch != "auto":
                filters.append(f"subtitles='{sub_path}':charenc={_ch}")
            else:
                filters.append(f"subtitles='{sub_path}'")

    # ----- 倒放 -----
    if reverse:
        filters.append("reverse")

    # ----- 淡入淡出（片段首尾淡入黑 / 淡出黑，视频） -----
    if include_fade and settings.get("fade_enabled", False):
        fin = settings.get("fade_in", "")
        fout = settings.get("fade_out", "")
        fin_s = time_to_seconds(fin) if fin else 0.0
        fout_s = time_to_seconds(fout) if fout else 0.0
        if fin_s > 0:
            filters.append(f"fade=t=in:st=0:d={fin_s:.3f}")
        if fout_s > 0:
            if clip_duration and clip_duration > 0:
                # 淡出起点按输出时长定位（fade 在变速 setpts 之后，t=输出时间线）。
                # clip_duration 语义=源全时长；本链自身的 截取/变速 会缩短输出，
                # 2026-09-13 前直接用 clip_duration → 截取后淡出点落在输出之外（淡出丢失）。
                _od = clip_duration
                if include_trim and settings.get("precise_trim", False) and settings.get("trim_enabled", False):
                    _fs_raw = settings.get("trim_start", "").strip()
                    _fe_raw = settings.get("trim_end", "").strip()
                    _fs = time_to_seconds(_fs_raw) if _fs_raw else 0.0
                    _fe = time_to_seconds(_fe_raw) if _fe_raw else None
                    if _fe is not None and _fe > _fs:
                        _od = _fe - _fs
                    else:
                        _od = max(0.0, _od - _fs)
                if settings.get("speed_enabled", False):
                    try:
                        _fsp = float(settings.get("speed_factor", "1.0") or "1.0")
                        if _fsp > 0 and _fsp != 1.0:
                            _od = _od / _fsp
                    except ValueError:
                        pass
                st = max(0.0, _od - fout_s)
                filters.append(f"fade=t=out:st={st:.3f}:d={fout_s:.3f}")
            # 未知时长时无法精确定位淡出起点，跳过淡出（淡入仍生效）

    filter_chain = ",".join(filters) if filters else "null"
    
    # ---------- 滤镜硬件加速（软件 / NVIDIA / Intel QSV / AMD） ----------
    filter_mode = settings.get("hw_filter_mode")
    if not filter_mode:
        # 向后兼容：旧版用 wrap_cpu_nvidia / wrap_cpu_amd 标记
        if settings.get("wrap_cpu_nvidia"):
            filter_mode = "cuda"
        elif settings.get("wrap_cpu_amd"):
            filter_mode = "vaapi"
        else:
            filter_mode = "cpu"

    if filter_mode in ("cuda", "qsv", "vaapi"):
        device = (settings.get("hw_filter_device") or "").strip()
        # 1) 尝试把软件滤镜替换为对应硬件滤镜
        hw_filters = []
        has_software_only = False
        for f in filters:
            hf = _map_software_to_hw_filter(f, filter_mode)
            if hf is None:
                has_software_only = True
                hw_filters.append(f)
            else:
                hw_filters.append(hf)
        # 合并相邻的 vpp_qsv 滤镜为单个 VPP 实例：更高效，且确保 denoise 与 procamp 等
        # 处于同一会话（分散到多个 vpp_qsv 实例虽不报错，但 procamp 开关易失效）。
        merged = []
        for f in hw_filters:
            if merged and merged[-1].startswith("vpp_qsv=") and f.startswith("vpp_qsv="):
                merged[-1] = merged[-1] + ":" + f[len("vpp_qsv="):]
            else:
                merged.append(f)
        hw_filters = merged
        # 2) 帧是否已在显存（需开启硬件解码且解码器与该 API 匹配）
        decoder = settings.get("hwaccel_decoder", "")
        native = settings.get("hwaccel_enabled", False) and _decoder_matches_api(decoder, filter_mode)
        enc_gpu = _is_gpu_encoder(settings.get("encoder", ""))
        if native and not has_software_only and hw_filters:
            # 纯硬件链路：数据全程在显存，无需 hwdownload / hwupload
            chain = ",".join(hw_filters)
            if not enc_gpu:
                pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", False) else "nv12"
                chain = f"{chain},hwdownload,format={pix}"
            return chain
        if not native:
            # 没有硬件解码 -> 帧在内存，无法 hwdownload，退回纯软件滤镜链
            return filter_chain
        # 3) 混合链路：软件滤镜用 hwdownload 拉回内存处理，再 hwupload 回显存
        sw_chain = ",".join(filters)
        if not sw_chain or sw_chain == "null":
            # 没有软件滤镜时不生成空白包裹（hwdownload,format=nv12,,hwupload=...）
            return "null"
        up = _hwupload_token(filter_mode, device)
        if enc_gpu:
            return f"hwdownload,format=nv12,{sw_chain},{up}"
        # CPU 编码器：处理完直接留在内存，并显式指定输出像素格式
        pix = settings.get("pix_fmt", "yuv420p") if settings.get("pix_fmt_enabled", False) else "nv12"
        return f"hwdownload,format=nv12,{sw_chain},format={pix}"

    return filter_chain


def _map_software_to_hw_filter(f: str, api: str):
    """把单个软件滤镜字符串映射为硬件滤镜；无解返回 None（表示仍需软件处理）。"""
    if f.startswith("scale="):
        suffix = {"cuda": "scale_cuda", "qsv": "scale_qsv", "vaapi": "scale_vaapi"}.get(api)
        if not suffix:
            return None
        body = f[len("scale="):]
        # 硬件缩放滤镜不支持 -2（软件 scale 的「强制偶数」语法），统一换成 -1。
        # -1 = 按宽高比自动计算另一维；因旋转在缩放之前执行，此时帧已是旋转后尺寸，
        # 所以 -1 自动按当前 iw/ih 计算，天然兼容旋转（无需手动算 540/1706）。
        body = body.replace("-2", "-1")
        # 转成 w=/h= 形式以兼容硬件滤镜（如 scale_cuda=w=1280:h=720）
        if "=" not in body:
            w, h = body.split(":")
            return f"{suffix}=w={w}:h={h}"
        return f"{suffix}={body}"
    if api == "qsv":
        # 旋转/翻转：vpp_qsv 的 transpose 用字符串枚举，不是软件滤镜的数字
        # 软件 transpose=1=90°顺时针 → vpp_qsv transpose=clock
        # 软件 transpose=2=90°逆时针 → vpp_qsv transpose=cclock
        # 软件 180°(transpose=2,transpose=2) → vpp_qsv transpose=reversal
        if f == "transpose=1":
            return "vpp_qsv=transpose=clock"
        if f == "transpose=2":
            return "vpp_qsv=transpose=cclock"
        if f == "transpose=2,transpose=2":
            return "vpp_qsv=transpose=reversal"
        # 翻转（用户实测 qsv 有翻转滤镜，无需走软件包裹）
        if f == "vflip":
            return "vpp_qsv=transpose=vflip"
        if f == "hflip":
            return "vpp_qsv=transpose=hflip"
        if f.startswith("crop="):
            crop_body = f[len("crop="):]
            # 含单引号 = 动态表达式（按时间 t 插值），vpp_qsv 的 cx/cy 不支持 t，
            # 必须走软件 crop（返回 None 让混合链路 hwdownload→crop→hwupload）。
            if "'" in crop_body:
                return None
            # crop=w:h:left:top -> vpp_qsv=cw=w:ch=h:cx=left:cy=top
            parts = crop_body.split(":")
            if len(parts) == 4:
                w, h, x, y = parts
                return f"vpp_qsv=cw={w}:ch={h}:cx={x}:cy={y}"
        if f.startswith("yadif") or f.startswith("bwdif"):
            # 反交错 → vpp_qsv deinterlace（1=Bob, 2=advanced；这里用 1）
            return "vpp_qsv=deinterlace=1"
        if f.startswith("hqdn3d"):
            # 降噪 → vpp_qsv denoise（取空间亮度等级，0..100）
            try:
                lvl = float(f[len("hqdn3d="):].split(":")[0])
            except ValueError:
                lvl = 0.0
            if lvl <= 0:
                return None
            return f"vpp_qsv=denoise={lvl:.0f}"
        if f.startswith("eq="):
            # 颜色校正 → vpp_qsv procamp（无 gamma；brightness 范围 -1..1 需换算成 -100..100）
            pp = []
            for kv in f[len("eq="):].split(":"):
                if "=" not in kv:
                    continue
                k, v = kv.split("=", 1)
                if k == "brightness":
                    try:
                        pp.append(f"brightness={float(v) * 100:.0f}")
                    except ValueError:
                        pass
                elif k in ("contrast", "saturation"):
                    pp.append(f"{k}={v}")
                # gamma 在 vpp_qsv 无对应项，丢弃
            if pp:
                # 关键：vpp_qsv 的亮度/对比度/饱和度都属于 ProcAmp，总开关 procamp 默认 0（关闭），
                # 不显式写 procamp=1 则这些参数被静默忽略（表现为「不报错但无变化」）。
                return "vpp_qsv=procamp=1:" + ":".join(pp)
            return None
    return None


def _decoder_matches_api(decoder: str, api: str) -> bool:
    """判断硬件解码器是否与目标滤镜 API 匹配（帧能否直接在对应显存中）。"""
    decoder = (decoder or "").lower()
    if api == "cuda":
        return ("cuda" in decoder) or ("cuvid" in decoder)
    if api == "qsv":
        return "qsv" in decoder
    if api == "vaapi":
        return ("vaapi" in decoder) or ("amf" in decoder)
    return False


def _is_gpu_encoder(encoder: str) -> bool:
    """判断编码器是否为硬件编码器（输出帧需在显存）。"""
    if not encoder:
        return False
    if encoder in ("nvenc", "qsv", "amf", "vaapi", "videotoolbox"):
        return True
    suffixes = ("_nvenc", "_qsv", "_amf", "_vaapi", "_videotoolbox",
                "_mediacodec", "_omx", "_mfx")
    return any(encoder.endswith(s) for s in suffixes)


def _hwupload_token(api: str, device: str) -> str:
    """返回软件->硬件的上传滤镜；device 非空时显式绑定显卡设备。"""
    if api == "cuda":
        return f"hwupload_cuda=device=cu" if device else "hwupload_cuda"
    if api == "qsv":
        # QSV 上传：derive_device=qsv 显式派生 QSV 设备（等价于用户实测可用的 hwupload=qsv）。
        # extra_hw_frames=64 不能放在这里，必须放在 -init_hw_device qsv=hw,extra_hw_frames=64 中。
        return "hwupload=derive_device=qsv"
    if api == "vaapi":
        return "hwupload=extra_hw_frames=64"
    return "hwupload"

def build_preview_filter_chain(settings: Dict[str, Any], target_height: int = 960, reverse: bool = False) -> str:
    """生成预览用的滤镜链，强制缩放到指定高度"""
    enhance_settings = settings.get("enhance", {})
    preview_settings = dict(settings)
    preview_settings["hw_filter_mode"] = "cpu"  # 预览/外部播放器强制软件滤镜，避免硬件滤镜冲突
    vf = build_video_filter_chain(
        preview_settings,
        include_subtitle=True,
        include_speed=True,
        enhance_settings=enhance_settings,
        reverse=reverse,
        # 2026-10-09：主视频绿幕抠像接入预览（用户要求：效果预览 / 单体预览 / 实时预览
        # 三条路径都要看到抠图结果）。未启用时 None ⇒ 旧调用方行为逐字不变。
        chroma_settings=preview_settings if preview_settings.get("chroma_enabled", False) else None,
        # 2026-10-10：主视频透明度同样接入预览（与绿幕抠图同款接法）。
        include_alpha=True,
    )
    # 追加文字水印 drawtext（多条非旋转项逗号串联；旋转项需 filter_complex，-vf 预览跳过）
    _ts0, _sp0 = _trim_speed_from_settings(settings)
    dt = build_drawtext_chain_vf(settings.get("text_watermark", {}),
                                 settings.get("text_watermark_items"),
                                 trim_start=_ts0, speed_factor=_sp0)
    if dt:
        vf = f"{vf},{dt}" if vf != "null" else dt
    if vf != "null":
        return f"{vf},scale=-2:{target_height}"
    else:
        return f"scale=-2:{target_height}"

def build_atempo_chain(factor: float) -> str:
    """构建音频变速滤镜链，支持大于2倍或小于0.5倍的场景"""
    if factor <= 0 or factor == 1.0:
        return ""
    chain = []
    r = factor
    while r > 2.0:
        chain.append(2.0)
        r /= 2.0
    while r < 0.5:
        chain.append(0.5)
        r /= 0.5
    if abs(r - 1.0) > 1e-6:
        chain.append(r)
    if not chain:
        return ""
    atempo_filters = [f"atempo={v:.10f}".rstrip('0').rstrip('.') for v in chain]
    return ",".join(atempo_filters)

# ================== 文字水印 drawtext 辅助 ==================

# 常见中文字体名称 → Windows Fonts 目录下的文件名映射
CN_FONT_MAP = {
    "微软雅黑": "msyh.ttc",
    "微软雅黑 Bold": "msyhbd.ttc",
    "宋体": "simsun.ttc",
    "黑体": "simhei.ttf",
    "楷体": "simkai.ttf",
    "仿宋": "simfang.ttf",
}

# 常用英文字体名称 → Windows Fonts 目录下的文件名映射（2026-09-04 追加）
# 均为 Windows 系统自带、长期稳定存在的字体文件；在字体下拉中接在中文字体之后显示。
EN_FONT_MAP = {
    "Arial": "arial.ttf",
    "Arial Bold": "arialbd.ttf",
    "Times New Roman": "times.ttf",
    "Georgia": "georgia.ttf",
    "Verdana": "verdana.ttf",
    "Tahoma": "tahoma.ttf",
    "Courier New": "cour.ttf",
    "Impact": "impact.ttf",
}

def resolve_cn_font_path(font_name: str) -> str:
    """将字体名解析为系统字体文件完整路径（先查中文字体表，再查英文字体表），找不到返回空串。

    2026-09-04：英文表在 CN_FONT_MAP 未命中时兜底，故下拉里中/英文字体可混选，
    无需为此改动任何调用点（3437 / 3693 / 9186 / 9475 均走本函数）。"""
    fname = CN_FONT_MAP.get(font_name) or EN_FONT_MAP.get(font_name, "")
    if not fname:
        return ""
    fonts_dir = os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
    return os.path.join(fonts_dir, fname)

def resolve_ext_font_path(settings: dict) -> str:
    """取「用户显式指定的外部字体路径」，仅用于回填 UI 控件。

    ⚠️ 与 font_path 的语义区别（2026-09-04 修 bug）：
      - ext_font_path：用户手填或用「浏览」选的字体文件；空 = 没用外部字体。
      - font_path    ：滤镜侧消费的「最终结果」= ext_font_path or 系统字体解析结果。
    早期版本只存 font_path，且 _collect_tw_form 把「外部字体 or 系统字体解析结果」
    一并写进去，回填时又把 font_path 当成「用户外部字体」塞回编辑框 —— 于是
    「选一次下拉 → 确定 → 再打开」后，编辑框被系统字体路径填满且非空，
    导致后续所有下拉选择都被这个路径覆盖（外部字体优先级高于下拉）。

    本函数负责把两者分开：优先读新字段 ext_font_path；老数据则反推 ——
    若 font_path 恰等于 font_name 的解析结果，说明它是系统字体的解析结果，
    不是用户外部字体，返回空串。
    """
    v = (settings.get("ext_font_path") or "").strip()
    if v:
        return v
    fp = (settings.get("font_path") or "").strip()
    if not fp:
        return ""
    resolved = resolve_cn_font_path(settings.get("font_name", "")) or ""
    if not resolved:
        # font_name 不在内置表中，无法反推；此时 font_path 很可能就是用户外部字体
        return fp
    with suppress(Exception):
        if os.path.normcase(os.path.abspath(fp)) == os.path.normcase(os.path.abspath(resolved)):
            return ""      # 是系统字体的解析结果 → 不算外部字体
    return fp


# ==================== 系统字体扫描（2026-09-04）====================
# 「检测本地」按钮与启动时兜底扫描共用。直接枚举 C:\Windows\Fonts 目录并解析
# 字体文件内部的 name table 取显示名（简体中文名优先）。
# ⚠️ 绝不读注册表 HKLM\...\Fonts：用户会刻意改写其中的名称映射（例如把
# 「微软雅黑」指向 tahoma.ttf 以回避雅黑字体），注册表不是「系统有哪些字体」的事实。
_FONT_ZH_LANGS = (0x0804, 0x0404, 0x0C04, 0x1004, 0x1404, 0x7C04)
_FONT_EN_LANGS = (0x0409, 0x0000, 0x0C09, 0x0809, 0x1009, 0x1409, 0x1809, 0x1C09,
                  0x2009, 0x2409, 0x2809, 0x2C09, 0x3009, 0x3409)
_FONT_SFNT_TAGS = (b"\x00\x01\x00\x00", b"OTTO", b"true")
_FONT_EXTS = (".ttf", ".ttc", ".otf")


def _font_names_from_file(path: str) -> Optional[dict]:
    """解析单个字体文件的 name table，返回 {'zh_full','zh_fam','en_full','en_fam'}。

    采用精确 seek：先读 sfnt 头 + table 目录找到 name table 的偏移，再只读那一段，
    因此对 msyh.ttc(22MB) 这类大文件也只读几百字节（实测全量 151 个字体共 ~0.01s）。
    ⚠️ 不能按字节数截断整文件读取——CJK 字体的 name table 常位于文件后段，
    截断 1MB 会漏掉全部中文字体（2026-09-04 实测踩坑）。
    支持 TTF/OTF/TTC；TTC 只读第一个 face，与 ffmpeg drawtext 行为一致。
    解析失败返回 None。
    """
    try:
        with open(path, "rb") as fh:
            tag = fh.read(4)
            base = 0
            if tag == b"ttcf":
                fh.seek(8)
                n = struct.unpack(">I", fh.read(4))[0]
                if n < 1:
                    return None
                fh.seek(12)
                base = struct.unpack(">I", fh.read(4))[0]
                if base <= 0:
                    return None
            fh.seek(base)
            hdr = fh.read(12)
            if len(hdr) < 12 or hdr[:4] not in _FONT_SFNT_TAGS:
                return None
            num_tables = struct.unpack(">H", hdr[4:6])[0]
            if not 0 < num_tables <= 4096:
                return None
            tdir = fh.read(num_tables * 16)
            if len(tdir) < num_tables * 16:
                return None
            name_off = None
            for i in range(num_tables):
                rec = tdir[i * 16:i * 16 + 16]
                if rec[:4] == b"name":
                    name_off = struct.unpack(">I", rec[8:12])[0]
                    break
            if name_off is None:
                return None
            fh.seek(name_off)
            nb = fh.read(512 * 1024)   # name table 段，足够容纳全部语言记录
            if len(nb) < 6:
                return None
            fmt, count, str_off = struct.unpack(">HHH", nb[:6])
            if count == 0 or count > 2048:
                return None
            recs = []
            q = 6
            for _unused in range(count):
                if q + 12 > len(nb):
                    break
                recs.append(struct.unpack(">HHHHHH", nb[q:q + 12]))
                q += 12

            def pick(langs, nids):
                """严格匹配：语言必须命中（否则英文名会被误当中文名，2026-09-04 踩坑）。"""
                found = []
                for plat, enc, lang, nid, ln, off in recs:
                    if nid not in nids or lang not in langs:
                        continue
                    s = str_off + off
                    if s + ln > len(nb):
                        continue
                    raw = nb[s:s + ln]
                    if plat == 3 or (plat == 0 and enc in (4, 6)):
                        try:
                            txt = raw.decode("utf-16-be")
                        except Exception:
                            continue
                    elif plat == 1:
                        try:
                            txt = raw.decode("latin-1")
                        except Exception:
                            continue
                    else:
                        continue
                    txt = txt.strip("\x00").strip()
                    if txt:
                        found.append((nid, txt))
                if not found:
                    return None
                # nids 内部有序（full 在前），优先返回靠前的 nameID 命中项
                for nid in nids:
                    for n, t in found:
                        if n == nid:
                            return t
                return found[0][1]

            return {
                "zh_full": pick(_FONT_ZH_LANGS, (4,)),
                "zh_fam": pick(_FONT_ZH_LANGS, (1, 16)),
                "en_full": pick(_FONT_EN_LANGS, (4,)),
                "en_fam": pick(_FONT_EN_LANGS, (1, 16)),
            }
    except Exception:
        return None


def scan_system_fonts(fonts_dir: Optional[str] = None) -> list:
    """枚举系统字体目录内全部 TTF/TTC/OTF，解析显示名（中文优先）。

    返回按显示名排序的 [{'name','file','path'}, ...]；
    fonts_dir 默认 C:\\Windows\\Fonts。.fon 位图字体（drawtext 不支持）与
    .compositefont/.xml 等非字体文件被跳过。解析失败的文件用文件名主干兜底，
    保证不漏字体。同名只保留第一个。
    """
    fonts_dir = fonts_dir or os.path.join(
        os.environ.get("WINDIR", r"C:\Windows"), "Fonts")
    try:
        entries = sorted(os.listdir(fonts_dir))
    except OSError:
        return []
    out, seen = [], set()
    for fn in entries:
        if os.path.splitext(fn)[1].lower() not in _FONT_EXTS:
            continue
        full = os.path.join(fonts_dir, fn)
        try:
            if not os.path.isfile(full):
                continue
        except OSError:
            continue
        r = _font_names_from_file(full)
        if r:
            name = (r.get("zh_full") or r.get("zh_fam")
                    or r.get("en_full") or r.get("en_fam")
                    or os.path.splitext(fn)[0])
        else:
            name = os.path.splitext(fn)[0]
        if name in seen:
            continue
        seen.add(name)
        out.append({"name": name, "file": fn, "path": full})
    out.sort(key=lambda x: x["name"].lower())
    return out


# ==================== 字体缓存 fonts_cache.json（2026-09-04）====================
# 与 ffmpeg_presets.json / quick_cmds.json 同级（get_script_dir()）。
# 结构：{version, scanned_at, fonts_dir_mtime, system_fonts:[{name,file,path}],
#        recent_external:[用户最近用过的外部字体路径, 最新在前, 至多 20 条]}
# 作用：① 免每次启动重扫 151 个字体文件；② 记住用户用过哪些外部字体，
#       在文字水印窗口的「外部字体」下拉里直接选，不用再每次浏览。
# 新鲜度判定：json 记录的 fonts_dir_mtime ≠ 当前 C:\Windows\Fonts 目录 mtime 即过期
# （任何字体的增删都会改目录 mtime，不必逐个文件比对）。
FONTS_CACHE_FILE = "fonts_cache.json"
FONTS_CACHE_MAX_RECENT = 20
_fonts_state = {"list": None, "dir_mtime": None, "recent": []}   # 模块级缓存


def _fonts_dir_path() -> str:
    return os.path.join(os.environ.get("WINDIR", r"C:\Windows"), "Fonts")


def _fonts_dir_mtime() -> float:
    try:
        return os.path.getmtime(_fonts_dir_path())
    except OSError:
        return 0.0


def _fonts_cache_path() -> str:
    return os.path.join(get_script_dir(), FONTS_CACHE_FILE)


def _fonts_save_state() -> None:
    """把 _fonts_state 落盘。写失败静默（缓存只是优化，不是关键数据）。"""
    with suppress(Exception):
        with open(_fonts_cache_path(), "w", encoding="utf-8") as f:
            json.dump({
                "version": 1,
                "scanned_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                "fonts_dir_mtime": _fonts_state.get("dir_mtime") or 0.0,
                "system_fonts": _fonts_state.get("list") or [],
                "recent_external": _fonts_state.get("recent") or [],
            }, f, ensure_ascii=False, indent=1)


def _fonts_load_state() -> bool:
    """从磁盘加载缓存到 _fonts_state。返回 True=加载成功且未过期（可直接用）。"""
    try:
        with open(_fonts_cache_path(), encoding="utf-8") as f:
            d = json.load(f)
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("version") != 1:
        return False
    cur_mtime = _fonts_dir_mtime()
    if not cur_mtime or abs((d.get("fonts_dir_mtime") or 0.0) - cur_mtime) > 1e-3:
        return False          # 目录已变 → 缓存过期
    lst = d.get("system_fonts") or []
    if not isinstance(lst, list) or not all(isinstance(x, dict) and x.get("path") for x in lst):
        return False
    rec = d.get("recent_external") or []
    _fonts_state["list"] = lst
    _fonts_state["dir_mtime"] = cur_mtime
    _fonts_state["recent"] = [p for p in rec if isinstance(p, str)] if isinstance(rec, list) else []
    return True


def ensure_fonts_cached() -> list:
    """返回系统字体列表 [{'name','file','path'},...]（模块级缓存）。

    磁盘缓存新鲜 → 直接用；缺失/过期 → 全量扫描并落盘。
    全量扫描实测 ~30ms，故启动可同步调用，无需后台线程。
    """
    if _fonts_state.get("list"):
        cur = _fonts_dir_mtime()
        if _fonts_state.get("dir_mtime") and abs(_fonts_state["dir_mtime"] - cur) < 1e-3:
            return _fonts_state["list"]
    if _fonts_load_state():
        return _fonts_state["list"]
    _fonts_state["list"] = scan_system_fonts(_fonts_dir_path())
    _fonts_state["dir_mtime"] = _fonts_dir_mtime()
    _fonts_save_state()
    return _fonts_state["list"]


def force_rescan_fonts() -> list:
    """「检测本地」按钮强制重扫（不信任任何缓存），返回新列表。"""
    _fonts_state["list"] = scan_system_fonts(_fonts_dir_path())
    _fonts_state["dir_mtime"] = _fonts_dir_mtime()
    _fonts_save_state()
    return _fonts_state["list"]


def get_recent_external_fonts() -> list:
    """用户最近用过的外部字体路径（最新在前，至多 FONTS_CACHE_MAX_RECENT 条）。"""
    ensure_fonts_cached()
    return list(_fonts_state.get("recent") or [])


def merged_font_names() -> list:
    """字体下拉的显示名列表：内置中/英文字体在前（快捷入口），随后接系统扫描字体，
    按显示名去重（内置优先）。不含 .fon（drawtext 不支持）。"""
    names = list(CN_FONT_MAP.keys()) + list(EN_FONT_MAP.keys())
    seen = set(names)
    for f in ensure_fonts_cached():
        nm = (f.get("name") or "").strip()
        if nm and nm not in seen:
            seen.add(nm)
            names.append(nm)
    return names


def record_external_font(path: str) -> None:
    """记录一次「用户显式指定」的外部字体路径（on_ok 时调用）。

    只记录仍存在的文件（路径失效了留着没意义）；已存在则移到最前；
    超过上限裁尾后落盘。
    """
    p = (path or "").strip()
    if not p or not os.path.isfile(p):
        return
    rec = _fonts_state.get("recent") or []
    try:
        rec = [x for x in rec if x != p and os.path.isfile(x)]
    except OSError:
        rec = [x for x in rec if x != p]
    rec.insert(0, p)
    _fonts_state["recent"] = rec[:_GLOBAL_SETTINGS["fonts_recent_max"]]
    _fonts_save_state()


def escape_drawtext_text(text: str) -> str:
    """转义 drawtext 的 text 参数中的特殊字符（: \\ ' , %）。
    不使用单引号包裹，纯靠 \\ 转义，FFmpeg filtergraph 和 mpv 都能正确解析。"""
    text = text.replace("\\", "\\\\")
    text = text.replace(":", "\\:")
    text = text.replace("'", "\\'")
    text = text.replace(",", "\\,")
    text = text.replace("%", "\\%")
    return text

def escape_drawtext_path(path: str) -> str:
    """
    转义 fontfile 路径中的特殊字符。
    - 统一为正斜杠。
    - 将冒号转义
    """
    path = path.replace("\\", "/")
    path = path.replace(":", "\\\\:")   # 双反斜杠 + 冒号，经测试 ffplay 和 mpv 均有效
    return path

def _build_drawtext_enable(s: dict, trim_start=0.0, speed_factor=1.0):
    """
    根据文字水印的显示时段 / 循环设置构建 drawtext 的 enable 表达式。
    返回空字符串表示始终显示。
    2026-08-29：段时间=主视频原始时间 → 换算输出时间线（滤镜 t）：
    绝对时间点(start/end)减 trim 再除 speed；周期/时长(cycle/show)只除 speed。
    预览 settings 已禁用 trim → 不换算。
    """
    _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    start = _f(s.get("enable_start"))
    end = _f(s.get("enable_end"))
    cycle = _f(s.get("enable_cycle"))
    show = _f(s.get("enable_show"))
    if _ts != 0.0 or _sp != 1.0:
        # 绝对时间点：统一换算（减 trim、除 speed、clamp≥0）；周期/时长只除 speed
        if start is not None:
            start, _du = _timeline_convert(start, 0.0, _ts, _sp)
        if end is not None:
            end, _du = _timeline_convert(end, 0.0, _ts, _sp)
        if cycle is not None:
            cycle = cycle / _sp
        if show is not None:
            show = show / _sp
    if start is not None and end is not None and end > start:
        return f"between(t,{_ffsec(start)},{_ffsec(end)})"
    if cycle is not None and show is not None and cycle > 0 and show > 0:
        return f"lt(mod(t,{_ffsec(cycle)}),{_ffsec(show)})"
    if start is not None:
        return f"gte(t,{_ffsec(start)})"
    if end is not None:
        return f"lte(t,{_ffsec(end)})"
    return ""


def _build_enh_seg_enable(s, speed_factor=1.0):
    """主增强链统一时间段：用户填「输出时间线」秒数，换算到 speed(setpts) 之前的滤镜入口时间。

    为什么乘 speed_factor（而非像 _build_drawtext_enable 那样除）：
    增强块位于 setpts=1/factor*PTS 之前 → 出口(输出)t = 入口t / factor → 入口t = 输出t × factor。
    故把用户填的输出时间窗口常数全部乘 speed_factor，即得滤镜入口时间。
    trim 已在入口 t 起点归零（trim setpts=PTS-STARTPTS），输出时间线同样从 0 起 → 无需再减 trim。
    机制与 crop_pos/build_crop_pos_expr、_build_drawtext_enable 同套 trim/speed 换算，方向相反。

    返回空串 = 始终生效（未启用时间段 / 未填任何时间）。
    循环模式（enh_seg_loop 真）用 lt(mod(t,周期),单次) 表达「每隔周期生效单次秒」。
    """
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _f = _opt_float
    start = _f(s.get("enh_seg_start"))
    end = _f(s.get("enh_seg_end"))
    cycle = _f(s.get("enh_seg_cycle"))
    show = _f(s.get("enh_seg_once"))
    if _sp != 1.0:
        # 输出时间 → 入口时间：常数乘 speed_factor
        if start is not None:
            start *= _sp
        if end is not None:
            end *= _sp
        if cycle is not None:
            cycle *= _sp
        if show is not None:
            show *= _sp
    if s.get("enh_seg_loop") and cycle is not None and show is not None and cycle > 0 and show > 0:
        return f"lt(mod(t,{_ffsec(cycle)}),{_ffsec(show)})"
    if start is not None and end is not None and end > start:
        return f"between(t,{_ffsec(start)},{_ffsec(end)})"
    if start is not None:
        return f"gte(t,{_ffsec(start)})"
    if end is not None:
        return f"lte(t,{_ffsec(end)})"
    return ""

def enh_seg_probe_time(s, t, speed_factor=1.0):
    """判定「预览取帧时刻 t」是否落在增强时间段的生效窗口内 —— 供预览面板提示用。

    时间口径（别搞混，否则提示会指错地方）：
    - 用户填的起始/结束/周期/单次是**输出时间线**秒数（见 _build_enh_seg_enable）；
    - 预览命令走输入级 -ss 直 seek 源素材、且 include_trim/include_speed 全关 →
      此刻 t 就是**滤镜入口时间**，同时也是屏幕上那一帧的画面时间。
    故这里照搬 _build_enh_seg_enable 的换算（× speed_factor）把窗口搬到入口轴上再比。

    返回 (covered, suggest)：
      covered —— t 是否落在生效窗口内；未启用 / 未填任何时间 = True（始终生效）
      suggest —— 落在窗口内则为 None；否则给一个「建议取帧秒数」（已站在同一条入口
                 时间轴上，可直接填进预览的「取帧(秒)」框）；算不出建议则为 None

    存在理由：默认取帧 3s，而时间段往往是 1~2s 之类的早段 —— 用户看到预览毫无变化
    会误判「设置没生效」，其实只是取帧点在窗口外（2026-10-03 用户反馈）。
    """
    if not s or not s.get("enh_seg_enabled", False):
        return True, None
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    def _mv(v):
        _n = _opt_float(v)
        return None if _n is None else _n * _sp
    start, end = _mv(s.get("enh_seg_start")), _mv(s.get("enh_seg_end"))
    cycle, show = _mv(s.get("enh_seg_cycle")), _mv(s.get("enh_seg_once"))
    if s.get("enh_seg_loop") and cycle and show and cycle > 0 and show > 0:
        # 每隔 cycle 秒生效 show 秒 → 任一个周期的中点都行，取第一个
        if (t % cycle) < show:
            return True, None
        return False, show / 2.0
    if start is not None and end is not None and end > start:
        if start <= t <= end:
            return True, None
        return False, (start + end) / 2.0
    if start is not None:
        if t >= start:
            return True, None
        return False, start + 1.0        # 只填了起点：给起点后 1 秒
    if end is not None:
        if t <= end:
            return True, None
        return False, max(0.0, end / 2.0)  # 只填了终点：给终点前半程
    return True, None


def _tw_multiline_on(tw_settings) -> bool:
    """文字水印「多行（竖排）」开关：tw['multiline'] 真值判定（容忍 JSON 里的字符串形式）。"""
    v = (tw_settings or {}).get("multiline", False)
    if isinstance(v, str):
        return v.strip().lower() in ("1", "true", "yes", "on")
    return bool(v)


def _tw_effective_text(tw_settings) -> str:
    """文字水印「有效渲染文本」——编辑器矩形估算与 drawtext 共用的唯一真相源。

    - `multiline` 开：保留换行（富文本 / @字体式竖排，drawtext 逐行渲染）。
      真实 0x0A 在 ffmpeg n9 / n71 / 4.3 三版本 drawtext 均渲染多行
      （研究档案 research/vertical-countdown 结论 1）；且**不加引号**的写法同样成立
      （tests/_verify_tw_multiline.py 实测 bands=3）→ 转义链与 mpv 路径无需改动。
    - `multiline` 关：沿用旧行为，多行拼成一行（空格分隔）。

    2026-09-25：编辑器 wm_w/wm_h 与渲染端 crop 盒都取自本函数，二者必须同源，
    否则「编辑器按多行画高框、渲染却压成单行」→ 用户报「设置与显示不符 / 文字没当富文本」。
    """
    raw = str((tw_settings or {}).get("text", "") or "")
    raw = raw.replace("\r\n", "\n").replace("\r", "\n")
    if _tw_multiline_on(tw_settings):
        return raw.strip("\n")
    return " ".join(countdown_lines(raw))


def _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor, tag, wpr=None):
    """文字水印列表轨迹 x/y 的 sendcmd 接入（共用 helper，2026-10-01）。

    两处消费（改一处必查另一处）：build_drawtext_filter（-vf 链/twm/twc）与
    build_text_watermark_filtergraph 非旋转分支（filter_complex 链——封装页多轨
    merge 即此路；此前该分支自拼 drawtext 漏接 sendcmd，用户实测发现）。

    行数 > sendcmd 行数阈值 → x/y 改命令文件驱动（target=drawtext@{tag}），
    返回 (首命令值x, 首命令值y, "sendcmd=f='…',", "drawtext@{tag}", wpr, fs_init)；
    未超阈/写文件失败 → (表达式x, 表达式y, "", "drawtext", wpr, None)（逐字节旧行为）。
    wpr（build_waypoint_expr 5 元组）可由调用方传入复用避免重算；
    alpha/自旋转仍走表达式。返回 None = wpr 无效（调用方维持原回退行为）。

    fs_init（第 6 位，2026-10-07 新增）：**列表轨迹缩放**也切了 sendcmd 时 =
    drawtext 的 fontsize 初始值字面量（形如 "104"）——调用方此时**必须忽略 wpr[3]
    表达式**（两条路都发 ⇒ 表达式照样撞 ~95 段墙，等于没切）；未切 = None（照旧用
    _tw_zoom_fontsize_tok(font_size, wpr[3]) 表达式，逐字节旧行为）。

    ⚠️ 命令形态随 ffmpeg 版本切换（2026-10-04 改，见 research/ffmpeg-95-seg-limit §21）：
      >= 7     → "xy"：`x '值', y '值'` 命令（7.1 / 9 实测生效）
      < 7（4.3）→ "reinit"：`reinit x=值:y=值` 命令（4.3 实测生效；x/y 会被**静默丢弃**）
      探测失败  → None：回退表达式路（4.3 上 flat 无 97 段墙，安全）
    即 **4.3 现在也能用 sendcmd 驱动文字水印轨迹**，不再一律回退。
    fontsize 命令形态与 x/y **同切分**（"fontsize" / "fontsize_reinit"），两个命令文件
    链式串在同一个 drawtext 前，三版本实测互不覆盖（见 _write_waypoint_sendcmd_file）。
    """
    _style = _ffmpeg_xy_cmd_style()
    if _style is None:      # 版本未探测/探测失败 → 不支持，回退表达式路（不静默失效）
        return None
    if wpr is None:
        wpr = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                  trim_start=trim_start, speed_factor=speed_factor)
    if wpr is None or wpr[0] is None:
        return None
    x_expr, y_expr = wpr[0], wpr[1]
    _sc_pre, _dt_name, _fs_init = "", "drawtext", None
    _tw_wps = [w for w in (tw_settings.get("move_waypoints") or []) if isinstance(w, dict)]
    if len(_tw_wps) > _wp_sc_rows_limit():
        _tw_iv = build_waypoint_position_intervals(
            tw_settings.get("move_waypoints"), trim_start=trim_start, speed_factor=speed_factor)
        if _tw_iv:
            _tw_sc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                _tw_iv, tag, target=f"drawtext@{tag}", cmd_style=_style)
            if _tw_sc is not None:
                _sc_pre = f"sendcmd=f='{_tw_sc}',"
                _dt_name = f"drawtext@{tag}"
                x_expr = f"{_tw_iv[0][3]:g}"
                y_expr = f"{_tw_iv[0][4]:g}"
                # ---- 同阈值起，fontsize 也切 sendcmd（2026-10-07）----
                # 不切 ⇒ 缩放仍走 wpr[3] 表达式，而那条表达式与 x/y 表达式**同时**存在于
                # 同一张图里 ⇒ 段数是两者相加，照样撞 ~95 段墙（切了 x/y 也是白切）。
                # ⚠️ 只在确有列表缩放（wpr[3] 非 None）时才写第二个命令文件：无缩放时
                #    fontsize 本就是字面量，多挂一个 sendcmd 纯属浪费且改变旧命令外形。
                if wpr[3] is not None:
                    _z_iv = build_waypoint_scale_intervals(
                        tw_settings.get("move_waypoints"),
                        trim_start=trim_start, speed_factor=speed_factor)
                    if _z_iv:
                        _fb = _opt_int(tw_settings.get("font_size", 48), 48)
                        _fs_sc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                            _z_iv, tag, target=f"drawtext@{tag}",
                            cmd_style=("fontsize" if _style == "xy" else "fontsize_reinit"),
                            fs_base=_fb, fs_cap=_TW_ZOOM_LAYER_MAX)
                        if _fs_sc is not None:
                            _sc_pre += f"sendcmd=f='{_fs_sc}',"
                            # 初始字号 = 首区间起点的实际字号（与命令文件首值同式）。
                            # 夹到 [_TW_ZOOM_LAYER_MAX] 与表达式路一致（见 fs_cap）。
                            _z0 = min(_TW_ZOOM_LAYER_MAX, max(0.01, float(_z_iv[0][3])))
                            _fs_init = f"{max(1, int(round(_fb * _z0)))}"
    return x_expr, y_expr, _sc_pre, _dt_name, wpr, _fs_init


# 文字水印「列表轨迹缩放」透明层预放大的倍率上限（2026-10-08）。
# 旋转子图路把透明层按zmax预放大 → zmax 越大层越大（面积∝zmax²）；给一个 san 上限，
# 同时 fontsize 表达式也夹到同一上限（超限不再继续放大，绝不裁切）。列表 sa/sb 通常 0.5~3。
_TW_ZOOM_LAYER_MAX = 8.0


def _tw_waypoint_zoom_max(waypoints):
    """列表轨迹里的最大缩放倍率（夹到 [1.0, _TW_ZOOM_LAYER_MAX]），供旋转子图
    「透明层按最大缩放预放大」用。只读 sa/sb；缺失/非法 → 1.0（=不放大，旧行为）。

    ⚠️ 只用于**决定透明层尺寸**；真正的逐帧缩放由 fontsize 表达式承担（矢量重绘）。
    """
    _m = 1.0
    for _w in (waypoints or []):
        if not isinstance(_w, dict):
            continue
        for _k in ("sa", "sb"):
            try:
                _v = float(_w.get(_k, 1.0))
            except (TypeError, ValueError):
                continue
            if _v > _m:
                _m = _v
    return max(1.0, min(_m, _TW_ZOOM_LAYER_MAX))


def _tw_zoom_fontsize_tok(font_size, zoom_expr):
    """drawtext 的 fontsize 记号：有列表缩放 → 逐帧表达式（每帧按当前字号**矢量重绘**，
    放大不糊；实测 ffmpeg 4.3/7.1/9.0.1 + mpv 三版一致）；无缩放 → 字面量（旧行为逐字节不变）。

    ⚠️ 锚点=文字左上角，与 waypoint「坐标=缩放后内容盒左上角」语义一致。
    ⚠️ 夹到 _TW_ZOOM_LAYER_MAX：与旋转路透明层预放大上限一致，保证不裁切。
    """
    if zoom_expr is None:
        return f"fontsize={font_size}"
    return (f"fontsize='max(1,{font_size}*min({_TW_ZOOM_LAYER_MAX:g},"
            f"max(0.01,{zoom_expr})))'")


def build_drawtext_filter(tw_settings: dict, trim_start=0.0, speed_factor=1.0, tag="tw"):
    """
    根据文字水印设置构建 drawtext 滤镜字符串。
    返回空字符串表示无需添加。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    2026-10-01：列表航点行数 > sendcmd 行数阈值时，x/y 改用 sendcmd 命令文件驱动
    （机制探针实测：drawtext x/y 支持 t 变量、别名定向、首命令值占位全可行）；
    返回串变为 `sendcmd=…,drawtext@{tag}=…`（调用方按逗号链内联，语义不变）。
    tag 供别名去重（多文字水印循环调用方传序号）。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    # 有效文本（2026-09-25 统一）：multiline 开 → 保留换行（竖排）；关 → 拼成一行。
    # 旧注释「必须拼成一行」已作废：真实换行在 n9/n71/4.3 三版本均能渲染，且不加引号
    # 也成立（tests/_verify_tw_multiline.py），故不再强制压平。
    text = _tw_effective_text(tw_settings)
    if not text:
        return ""
    font_name = tw_settings.get("font_name", _("微软雅黑"))
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    font_size = _opt_int(tw_settings.get("font_size", 48), 48)
    color = tw_settings.get("font_color", "#FFFFFF")
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    x_expr = tw_settings.get("overlay_x", "10").strip() or "10"
    y_expr = tw_settings.get("overlay_y", "10").strip() or "10"
    # 动态轨迹（与图片/视频水印同套逻辑；文字尺寸用 tw/th，主画布用 main_w/main_h）
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    _wpr = None
    _sc_pre = ""       # sendcmd 前缀（列表航点行数 > 阈值时非空）
    _dt_name = "drawtext"
    _fs_init = None    # 缩放也切了 sendcmd 时的 fontsize 初始字面量（None=走表达式）
    if _mv == "waypoints":
        # 列表轨迹：画布绝对像素（数字），drawtext x/y 表达式含 t 每帧求值；
        # 行数 > 阈值 → sendcmd 命令文件驱动（共用 helper，见函数 docstring）
        _r = _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor, tag or "tw")
        if _r is not None:
            x_expr, y_expr, _sc_pre, _dt_name, _wpr, _fs_init = _r
        else:
            # ⚠️ 2026-10-08 补齐：helper 在「版本探测失败」时返回 None，此前这里**静默保留
            #    overlay_x/y** → 整条列表轨迹（含 zoom / 透明度）被丢掉；而
            #    build_text_watermark_filtergraph 的非旋转分支是同款「回退表达式路」。
            #    两处口径必须一致（也是列表缩放能生效的前提）。
            _wpr = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                       trim_start=trim_start, speed_factor=speed_factor)
            if _wpr is not None and _wpr[0] is not None:
                x_expr, y_expr = _wpr[0], _wpr[1]
    elif _mv:
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
        if _mx is not None:
            # drawtext 表达式环境不提供 W/H 别名，用 main_w/main_h 表示主画布
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    border_w = _opt_int(tw_settings.get("border_w", 0), 0)
    border_color = tw_settings.get("border_color", "#000000")

    fc = color.lstrip("#")
    fontcolor = f"0x{fc}@{opacity:.2f}"

    # 列表轨迹缩放：fontsize 每帧按当前字号**矢量重绘**（放大不糊；实测 ffmpeg
    # 4.3/7.1/9.0.1 + mpv 结果一致）。锚点=文字左上角。两种承载方式（同阈值切换）：
    #   · 列表行数 ≤ 阈值 → 逐帧**表达式**（_tw_zoom_fontsize_tok）；
    #   · 行数 > 阈值      → 与 x/y 一起切 **sendcmd**（_fs_init 非 None），此时
    #     fontsize 用初始字面量、后续由命令文件逐帧改写 —— 若还用表达式，那条表达式会与
    #     x/y 表达式同时存在，段数相加照样撞 ~95 段墙（切了 x/y 也白切）。
    #   · 无列表缩放 → 字面量，旧命令逐字节不变。
    if _fs_init is not None:
        _fs_tok = f"fontsize={_fs_init}"
    else:
        _fs_tok = _tw_zoom_fontsize_tok(
            font_size, (_wpr[3] if (_wpr is not None and _wpr[3] is not None) else None))
    parts = [
        f"fontfile={escape_drawtext_path(font_path)}",
        f"text={escape_drawtext_text(text)}",
        _fs_tok,
        f"fontcolor={fontcolor}",
        f"x='{x_expr.replace(chr(39), chr(92)+chr(39))}'",
        f"y='{y_expr.replace(chr(39), chr(92)+chr(39))}'",
    ]
    if border_w > 0:
        bc = border_color.lstrip("#")
        parts.append(f"borderw={border_w}")
        parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
    # 显示时段 / 循环控制 (enable 表达式)
    enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                         speed_factor=speed_factor)
    if enable_expr:
        parts.append(f"enable='{enable_expr}'")
    # 列表轨迹透明度（oa→ob 段内线性插值）：与 fontcolor@opacity 相乘（drawtext alpha × 颜色透明度）
    if _wpr is not None and _wpr[4] is not None:
        parts.append(f"alpha='{_wpr[4].replace(chr(39), chr(92) + chr(39))}'")
    return _sc_pre + _dt_name + "=" + ":".join(parts)


def _render_text_watermark_preview_png(ffmpeg_cmd, tw, box_w, box_h):
    """渲染文字水印预览 PNG（透明背景 + 真实文字），供位置编辑器「框内真实帧」使用。

    与正式渲染（build_drawtext_filter）同源：fontfile / text / fontsize / fontcolor@opacity /
    borderw / bordercolor 全部照搬，文字定位于盒内 (8,8)（与编辑器 wm=est+16 的 8px 内边距一致）。
    背景用 color=c=black@0（透明黑），drawtext 画上去 → 输出 PNG 带 alpha，放进编辑器框内
    即真实文字（透明处透出视频背景），不再是空参考框。
    返回 PNG 路径；失败（无字体/ffmpeg 异常）返回 None（调用方回落旧行为：空框）。
    """
    if not tw:
        return None
    text = _tw_effective_text(tw)
    if not text:
        return None
    font_name = tw.get("font_name", _("微软雅黑"))
    font_path = tw.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return None
    fs = _opt_int(tw.get("font_size", 48), 48)
    if fs <= 0:
        fs = 48
    color = tw.get("font_color", "#FFFFFF")
    opacity = max(0.0, min(1.0, _opt_float(tw.get("opacity", 1.0), 1.0)))
    fc = color.lstrip("#")
    border_w = _opt_int(tw.get("border_w", 0), 0)
    border_color = tw.get("border_color", "#000000")
    parts = [
        f"fontfile={escape_drawtext_path(font_path)}",
        f"text={escape_drawtext_text(text)}",
        f"fontsize={fs}",
        f"fontcolor=0x{fc}@{opacity:.2f}",
        "x=8", "y=8",
    ]
    if border_w > 0:
        bc = border_color.lstrip("#")
        parts.append(f"borderw={border_w}")
        parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
    # 先 format=rgba + colorchannelmixer=aa=0 把底变成「完全透明」，再 drawtext 画文字
    # （color=c=black@0 的 alpha 会被 color 源默认 rgb24 丢掉的坑，详见 research 备注）。
    graph = "format=rgba,colorchannelmixer=aa=0,drawtext=" + ":".join(parts)
    # 2026-10-05 修「新水印仍显示上一条的文字」：文件名按**内容指纹**命名（原来写死
    # _kli_tw_preview.png，所有水印/所有编辑器共用一个文件）。两个叠加 bug：
    #   ① 固定名 ⇒ 第二条水印渲完还是第一条的图（用户实测：新条目写着"测试文字"却显示 "123"）；
    #   ② **没有 -y** ⇒ 目标已存在时 ffmpeg 打印 "Not overwriting - exiting" 却**仍返回 rc=0**，
    #      下面的 returncode 检查拦不住 → 照样把陈旧文件路径返回给调用方。
    # 指纹入名后，即使偶发同名也必然带 -y 覆盖，两道防线都堵上。
    import hashlib
    _sig = "|".join([text, font_path, str(fs), fc, f"{opacity:.3f}", str(border_w),
                     border_color.lstrip("#"), str(int(box_w)), str(int(box_h))])
    _tag = hashlib.md5(_sig.encode("utf-8")).hexdigest()[:12]
    out = os.path.join(tempfile.gettempdir(), f"_kli_tw_preview_{_tag}.png")
    cmd = [ffmpeg_cmd, "-y", "-f", "lavfi", "-i", f"color=c=black@0:s={int(box_w)}x{int(box_h)}:d=1",
           "-vf", graph, "-frames:v", "1", "-f", "image2", out]
    try:
        p = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           creationflags=_ffmpeg_spawn_flags(), timeout=30)
        if p.returncode != 0 or not os.path.exists(out) or os.path.getsize(out) == 0:
            return None
        return out
    except Exception:
        return None


def build_drawtext_chain_vf(tw_settings, tw_items=None, trim_start=0.0, speed_factor=1.0) -> str:
    """构建 -vf 可用的多条 drawtext 逗号串（仅非旋转项）。

    2026-08-26：普通预览（ffplay/SimplePreviewer 的 -vf 链）此前只渲染第一条文字水印。
    多条 drawtext 在 -vf 里可以用逗号链式串联（ffmpeg 支持），旋转/spin 项需要
    filter_complex 子图（color 源 + rotate + overlay），-vf 无法表达 → 跳过（完整合成
    与 mpv 实时预览仍走 build_text_watermark_chain，旋转项不受影响）。
    2026-08-29：trim_start/speed_factor 透传给 build_drawtext_filter（显示时段/轨迹时间
    =主视频原始时间，生成时换算输出时间线）。"""
    if tw_items is None:
        tw_items = [tw_settings]
    elif isinstance(tw_items, list) and not tw_items:
        tw_items = [tw_settings]
    parts = []
    for _tw_i, it in enumerate(tw_items):
        if not it.get("enabled", True):
            continue
        if not str(it.get("text", "") or "").strip():
            continue
        if text_watermark_needs_subgraph(it):
            continue  # 旋转/spin 无法进 -vf → 跳过
        d = build_drawtext_filter(it, trim_start=trim_start, speed_factor=speed_factor,
                                  tag=f"tw{_tw_i}")
        if d:
            parts.append(d)
    return ",".join(parts)


def estimate_text_size(text: str, font_path: str, font_size: int) -> Tuple[int, int]:
    """
    估算文字水印的像素宽高 (tw, th)，用于旋转时裁剪出贴合文字的透明层。
    纯 Python 标准库实现（不依赖 PIL）：
    - 全角区（CJK 等，U+2E80 起）按 1.0 × font_size 计宽；
    - ASCII 可打印按 0.6 × font_size 计宽（略偏大，宁可裁大不裁字）；
    - 其余半角扩展（拉丁扩展/希腊/西里尔等）按 0.9 × font_size 计宽；
    - 行高 = font_size × 1.2；多行取最大行宽。
    估算偏保守（偏大），旋转时 crop 包围盒还含 ±8px 内边距，实际不会裁到字。
    """
    fs = _opt_int(font_size, 48)
    if fs <= 0:
        fs = 48
    lines = (text or "").split("\n")
    th = int(fs * 1.2) * max(1, len(lines))
    tw = 0
    for line in lines:
        w = 0.0
        for ch in (line or " "):
            o = ord(ch)
            if o >= 0x2E80:          # CJK 及全角区（含中文/日韩/注音等）
                w += fs * 1.0
            elif o <= 0x7E:          # ASCII 可打印（含空格）
                w += fs * 0.6
            else:                    # 其余半角扩展字符
                w += fs * 0.9
        if int(w) > tw:
            tw = int(w)
    return max(tw, fs), th


def build_preview_border_frag(eh) -> str:
    """末端边框 → pad 滤镜片段（预览路径共用，iw/ih 表达式，无需知道绝对尺寸）。
    返回 'pad=trunc((iw+L+R+1)/2)*2:trunc((ih+T+B+1)/2)*2:L:T:color=C' 或 ''（未启用/全 0 边距）。
    与正式命令 _apply_end_handling_cmd 的 pad 注入同构（#RRGGBB→0xRRGGBB、颜色名透传、trunc 偶数化）。
    播放预览（-vf/lavfi-complex）、快照（filter_complex）、封装实时预览（lavfi-complex）三处共用。"""
    if not eh:
        return ""
    if not eh.get("border_enabled", False):
        return ""
    try:
        t = max(0, int(eh.get("border_top", 0) or 0))
        b = max(0, int(eh.get("border_bottom", 0) or 0))
        l = max(0, int(eh.get("border_left", 0) or 0))
        r = max(0, int(eh.get("border_right", 0) or 0))
    except (ValueError, TypeError):
        return ""
    if t + b + l + r <= 0:
        return ""
    _bc = (eh.get("border_color", "") or "").strip()
    if re.fullmatch(r"#[0-9a-fA-F]{6}", _bc):
        _pad_c = "0x" + _bc[1:].upper()
    else:
        _pad_c = _bc if _bc else "black"
    return (f"pad=trunc((iw+{l}+{r}+1)/2)*2:trunc((ih+{t}+{b}+1)/2)*2:"
            f"{l}:{t}:color={_pad_c}")


def scale_preview_border_px(eh, factor):
    """预览缩放后把末端边框边距按比例缩小（2026-10-06，用户实测「边框很粗」）。

    背景：预览会把画面**缩小**——`_preview_with_settings` 的屏幕适配 `scale_expr`，以及
    管道引擎的工作分辨率上限 `_pwf`（_PIPE_WORK_MAX_W）——而边框是 `pad` 的**绝对像素**，
    且 pad 加在 scale 之后。两者单位不同步 ⇒ 同一个 12px 边框，缩到半分辨率后相对宽度翻倍，
    观感「很粗」；而成片（不做屏幕适配）始终是 12px 相对原始尺寸 ⇒ 观感「细」。

    成片口径 = 参照系：成片边框就是设置里的绝对像素，所以预览必须
    `边框 × (预览尺寸 / 成片尺寸)` 才与成片观感一致。调用方传的就是这个总倍数
    （`_pwf` × 屏幕适配倍数，两者都在本函数外算）。

    · 四边各自等比缩放（**不强制取偶**）：偶数偏移是 yuv420p 的要求，但那只针对逐格
      pad 的偏移量 x/y，由 `build_split_gap_pad_frag` 内部负责（它会把多出来的 1px 补给对侧）；
      整体外框 `build_preview_border_frag` 从不取偶。这里若再取偶，会把对称的左右边距
      拆成一奇一偶（实测 12/12 @f=0.458 → 4/8），反而引入不对称。
    · 缩到<1px 时钳到 **1px**：保住「边框非空」这一路由判据（`_bp_before` / 是否走复杂图），
      否则缩放会改变命令形状（普通 -vf ↔ 复杂图），比粗一点严重得多。
    · `factor<=1`、未启用边框、或四边本就全 0 → **原样返回同一对象**，零行为变化。
    """
    if not eh or not eh.get("border_enabled", False):
        return eh
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return eh
    if f <= 0 or f >= 1.0:
        return eh
    out = None
    for side in ("left", "right", "top", "bottom"):
        try:
            v = max(0, int(eh.get("border_%s" % side, 0) or 0))
        except (TypeError, ValueError):
            return eh
        if v <= 0:
            continue
        nv = max(1, int(v * f))
        if nv == v:
            continue
        if out is None:
            out = dict(eh)
        out["border_%s" % side] = nv
    return out if out is not None else eh


def build_split_gap_pad_plan(rows: int, cols: int, b_left: int = 0, b_right: int = 0,
                             b_top: int = 0, b_bottom: int = 0):
    """末端多画面拼接边框的「间隙模型」逐格 pad 方案。

    背景（2026-10-06 修正）：旧实现是「split 之前给整段视频统一 pad 一圈边框再切网格」，
    于是每格都带完整四周边框 —— 外围只有 1×B、而相邻两格的边框背靠背变成 2×B，观感不均。

    成熟做法（ffmpeg `xstack` 的 layout+fill 几何、Premiere/剪映 分屏的 gutter 间隙同款）：
    把边框拆成两类「间隙条」，内容尺寸一律不动（不缩放、不裁切）：
      · 外围四条（画布边）：宽度 = 用户设的 border_left/right/top/bottom，归单格独占 → 外围 = B
      · 内部缝隙（cols-1 条竖 + rows-1 条横）：宽度 = 相邻两条外围边距的均值，
        由相邻两格各占一半 → 拼起来正好 = B，与外围等宽
    结果：外圈 B、格间 B，处处均匀；每格视频仍是原始尺寸（区别于「减视频尺寸腾缝隙」的兜底做法）。

    返回 (plan, gap_x, gap_y)：plan 为 rows*cols 个 (L, R, T, B)，行优先（与 split 输出顺序一致）；
    L/R/T/B 是该格 pad 的四边「总量」（pad 后格子尺寸 = iw+L+R × ih+T+B）。

    ⚠️ hstack/vstack 几何约束（已实测，非对称 pad 严格成立）：
      hstack 只要求同一行各输入**高度**相同 → T/B 只依赖行号 r ⇒ 同行天然一致；
      vstack 只要求各行**宽度**相同 → L/R 只依赖列号 c ⇒ 行宽 Σ(iw+L_c+R_c) 与 r 无关 ⇒ 各行天然一致。
      故各格宽高**不必**相等，非对称 pad 安全。
    """
    rows = max(1, int(rows or 1))
    cols = max(1, int(cols or 1))
    b_left = max(0, int(b_left or 0)); b_right = max(0, int(b_right or 0))
    b_top = max(0, int(b_top or 0)); b_bottom = max(0, int(b_bottom or 0))
    # 内部缝隙 = 相邻两条外围边距的均值；向上取偶 ⇒ 两半可整除（半缝 = gx//2 整数）
    gx = (b_left + b_right + 1) // 2
    gx += gx & 1
    gy = (b_top + b_bottom + 1) // 2
    gy += gy & 1
    hx, hy = gx // 2, gy // 2
    plan = []
    for _r in range(rows):
        _t = b_top if _r == 0 else hy
        _b = b_bottom if _r == rows - 1 else hy
        for _c in range(cols):
            _l = b_left if _c == 0 else hx
            _rr = b_right if _c == cols - 1 else hx
            plan.append((_l, _rr, _t, _b))
    return plan, gx, gy


def build_split_gap_pad_frag(l: int, r: int, t: int, b: int, color: str = "black") -> str:
    """间隙模型单格 pad 片段（iw/ih 表达式，无需知道绝对尺寸）。

    · 偏移 x/y 取偶：yuv420p 色度平面要求偶数偏移，奇数偏移会让边框出现半像素色度渗色
      （实测 odd 偏移时格间缝隙比设计值多 2px、底边多 2px）。取偶掉的 1px 落到对侧，总量守恒。
    · 宽高向上取偶：trunc((iw+X+R+1)/2)*2，保证格子尺寸为偶数（yuv420p 要求），
      且因 T/B 只依赖行号、L/R 只依赖列号，同行高仍相同、各行宽仍相同。
    """
    _x = max(0, int(l or 0)); _x -= _x & 1
    _y = max(0, int(t or 0)); _y -= _y & 1
    _r = max(0, int(r or 0)); _b = max(0, int(b or 0))
    _kw = _x + _r + 1
    _kh = _y + _b + 1
    return (f"pad=trunc((iw+{_kw})/2)*2:trunc((ih+{_kh})/2)*2:"
            f"{_x}:{_y}:color={color or 'black'}")


def build_split_border_cfg(eh):
    """从末端处理设置取「间隙模型」边框配置 dict（供 build_end_split_filters 的 border 参数用）。
    未启用边框或四边全 0 时返回 None（调用方据此退回无边框网格）。"""
    if not eh or not eh.get("border_enabled", False):
        return None
    try:
        _l = max(0, int(eh.get("border_left", 0) or 0))
        _r = max(0, int(eh.get("border_right", 0) or 0))
        _t = max(0, int(eh.get("border_top", 0) or 0))
        _b = max(0, int(eh.get("border_bottom", 0) or 0))
    except (ValueError, TypeError):
        return None
    if _l + _r + _t + _b <= 0:
        return None
    _c = (eh.get("border_color", "") or "").strip() or "#000000"
    return {"left": _l, "right": _r, "top": _t, "bottom": _b, "color": _c}


def build_split_grid_size(rows: int, cols: int, base_w: int, base_h: int,
                          b_left: int = 0, b_right: int = 0, b_top: int = 0, b_bottom: int = 0):
    """间隙模型下网格的最终输出尺寸（供预览缩放基准 / 输出比例计算用）。
    逐格独立向上取偶，故总尺寸 = Σ 各格尺寸，而非 ceil_even(总和)。
    rows/cols 为 1 或边距全 0 时退化为 cols*base_w × rows*base_h（与旧口径一致）。"""
    try:
        _bw = max(0, int(base_w or 0))
        _bh = max(0, int(base_h or 0))
    except (ValueError, TypeError):
        return 0, 0
    _plan, _gx, _gy = build_split_gap_pad_plan(rows, cols, b_left, b_right, b_top, b_bottom)
    _cols = max(1, int(cols or 1))
    _rows = max(1, int(rows or 1))
    _w = 0
    for _c in range(_cols):
        _l, _r, _t, _b = _plan[_c]              # 宽度只依赖列号，取第 0 行即可
        _x = _l - (_l & 1)
        _w += (_bw + _x + _r + 1) // 2 * 2
    _h = 0
    for _r2 in range(_rows):
        _l, _r, _t, _b = _plan[_r2 * _cols]     # 高度只依赖行号，取各行的第 0 列
        _y = _t - (_t & 1)
        _h += (_bh + _y + _b + 1) // 2 * 2
    return _w, _h


def build_end_split_filters(rows: int, cols: int, in_label: str = "[v_in]", out_label: str = "[v_out]",
                            border=None) -> str:
    """
    末端多画面拼接滤镜：把输入视频流 split 成 rows×cols 份拼接成网格。
    返回 filter_complex 片段字符串（以 in_label 开头、out_label 结尾），总格数 = rows*cols（限制 2-5）。

    - 行=1（列>1）→ 横排：split=N + hstack=inputs=N
    - 列=1（行>1）→ 竖排：split=N + vstack=inputs=N
    - 行>1 且列>1 → 网格：每行先 hstack，再把各行 vstack
      例 2×2：split=4[v1][v2][v3][v4];[v1][v2]hstack=inputs=2[top];[v3][v4]hstack=inputs=2[bottom];[top][bottom]vstack=inputs=2[vo]

    border（可选 dict，键 left/right/top/bottom/color）：启用「间隙模型」边框 ——
    split 之后逐格按所在位置非对称 pad（外围独占、内部缝隙相邻两格各占一半），再拼网格。
    与「split 之前统一 pad 一圈」的旧做法相比：外围与格间等宽（旧做法格间是外围的 2 倍）。
    细节见 build_split_gap_pad_plan。
    """
    rows = max(1, int(rows or 1))
    cols = max(1, int(cols or 1))
    n = rows * cols
    if n < 2 or n > 5:
        n = max(2, min(5, n))
        # 重新折算：若行=1 保持 n 列；列=1 保持 n 行；否则 2×2
        if rows == 1:
            cols = n
        elif cols == 1:
            rows = n
        else:
            rows, cols = 2, 2
            n = 4
    # 标签用独特前缀（sp/sr）避免与调用方既有 filtergraph 标签冲突
    labels = [f"[sp{i}]" for i in range(n)]
    parts = [f"{in_label}split={n}{''.join(labels)}"]
    # 间隙模型：split 之后逐格非对称 pad → [sbp{i}]，再按网格拼接（每格内容尺寸不变）
    stack_labels = labels
    if border:
        _plan, _gx, _gy = build_split_gap_pad_plan(
            rows, cols,
            border.get("left", 0), border.get("right", 0),
            border.get("top", 0), border.get("bottom", 0))
        _bc = (border.get("color", "") or "").strip()
        if re.fullmatch(r"#[0-9a-fA-F]{6}", _bc):
            _bc = "0x" + _bc[1:].upper()
        _bc = _bc or "black"
        stack_labels = []
        for _i in range(n):
            _l, _r, _t, _b = _plan[_i]
            parts.append(f"{labels[_i]}{build_split_gap_pad_frag(_l, _r, _t, _b, _bc)}[sbp{_i}]")
            stack_labels.append(f"[sbp{_i}]")
    if rows == 1:
        # 横排
        parts.append(f"{''.join(stack_labels)}hstack=inputs={n}{out_label}")
    elif cols == 1:
        # 竖排
        parts.append(f"{''.join(stack_labels)}vstack=inputs={n}{out_label}")
    else:
        # 网格：每行 hstack 再整体 vstack
        row_labels = []
        for r in range(rows):
            row_lbl = f"[sr{r}]"
            row_in = "".join(stack_labels[r * cols:(r + 1) * cols])
            parts.append(f"{row_in}hstack=inputs={cols}{row_lbl}")
            row_labels.append(row_lbl)
        parts.append(f"{''.join(row_labels)}vstack=inputs={rows}{out_label}")
    return ";".join(parts)


def build_end_concat_filters(tail_path: str, tail_sec: float,
                             in_label: str = "[v_in]", tail_label: str = "[tail]",
                             out_label: str = "[v_out]",
                             main_w: int = 1280, main_h: int = 720, fps: float = 30.0,
                             main_dur: float = 0.0) -> str:
    """
    末端 concat 图片/视频滤镜：把一段图片（显示 tail_sec 秒）或视频接到主视频末尾。

    - 图片：输入是 `-loop 1 -framerate {fps} -t {tail_sec} -i {tail_path}`（有限时长流），
      滤镜：scale 保持比例适配 main_w×main_h（不足则 pad 黑底居中）+ fps 对齐 + format + setpts 归零。
    - 视频：输入是 `-i {tail_path}`，同样 scale/pad 适配输出尺寸后 concat。

    tail_label：尾部素材在 filter_complex 中的输入标签（调用方指定，如 [1:v]）。
    main_dur > 0 时：在 concat 前给主链强制 trim=0:{main_dur} 收尾——
      解决画中画 overlay 默认 eof_action=repeat 导致主视频结束后定格、子视频无限循环、
      concat 永远等不到主链结束的问题（主链必须显式结束才能切换到尾部素材）。
    返回 filter_complex 片段（以 tail 链开头、out_label 结尾）：
      [tail_label]scale=...pad=...[v_tail];[in_label]trim=0:D,setpts=PTS-STARTPTS[v_main_trim];[v_main_trim][v_tail]concat=n=2:v=1:a=0[out]
    注意：调用方负责在命令里为 tail 流添加额外输入（-loop 1 ... -i 或 -i）。
    """
    if not tail_path or not os.path.exists(tail_path):
        return ""
    # 图片/视频统一走 scale 保持比例 + pad 黑底居中（图片小或用户 scale 后仍小于输出尺寸时自动黑边居中）
    tail_chain = (
        f"{tail_label}scale={main_w}:{main_h}:force_original_aspect_ratio=decrease,"
        f"pad={main_w}:{main_h}:(ow-iw)/2:(oh-ih)/2:black,"
        f"setsar=1,fps={fps:.6f}".rstrip('0').rstrip('.') + ","
        f"format=yuv420p,setpts=PTS-STARTPTS[v_tail]"
    )
    # 主链强制收尾：overlay 默认 eof_action=repeat（主视频结束后定格最后一帧、子视频继续循环），
    # 不加 trim 时主链永不结束，concat 永远不切换到尾部素材（只能靠 -t 截断 = 定格+子视频循环）。
    if main_dur and main_dur > 0:
        main_trim = f"{in_label}trim=0:{_ffsec(main_dur)},setpts=PTS-STARTPTS[v_main_trim];"
        concat_in = "[v_main_trim]"
    else:
        main_trim = ""
        concat_in = in_label
    # concat 只拼视频（v=1:a=0），音频保持主视频原样；尾部图片段无音频（静音），
    # 视频段自带音频会被 concat 丢弃（与"只拼视频"语义一致）。
    return f"{tail_chain};{main_trim}{concat_in}[v_tail]concat=n=2:v=1:a=0{out_label}"


def build_text_watermark_filtergraph(tw_settings: dict, main_label: str = "", out_label: str = "[v_tw]",
                                     trim_start=0.0, speed_factor=1.0, tag: str = ""):
    """
    构建文字水印的 filter_complex 片段（或单节点 drawtext）。

    - 未启用/无效 → 返回 ""
    - 启用倒计时(countdown_enabled) → 返回「画布 + 滚动 crop 窗口 + overlay」子图
      （2026-09-19 新增；倒计时独占，同时间里的旋转/spin/轨迹不再叠加）
    - 未启用旋转与持续旋转 → 返回 f"{main_label}drawtext=...{out_label}"
      （等价于原 build_drawtext_filter 直接作用于主视频；main_label 为空则用隐式输入）
    - 启用旋转（rotate≠0）或持续旋转（spin_enabled）→ 返回「透明层(color来自主视频alpha清零)
      + drawtext(居中) + rotate(静态角度，可选) + rotate(持续旋转 angle=转速*PI/180*t，可选) + overlay」
      的子图，主视频输入用 main_label（为空则隐式输入，适用预览 lavfi/-filter_complex），
      以 out_label 结尾。调用方负责把该片段接入总 filter_complex（用 ; 分隔，并把 out_label 作为后续视频标签）。

    设计要点：FFmpeg drawtext 原生不支持旋转，故旋转时把文字画到一块透明层上、
    用 rotate 绕文字自身中心旋转、再 overlay 回主视频（与图片/视频水印 rotate 思路一致）。
    2026-08-29：trim_start/speed_factor —— 显示时段/列表轨迹时间=主视频原始时间，
    生成时换算输出时间线（滤镜 t）；预览 settings 已禁用 trim → 不换算。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    # 有效文本（2026-09-25 统一）：multiline 开 → 保留换行（富文本 / @字体式竖排，
    # drawtext 逐行渲染）；关 → 拼成一行（历史行为，旧工程兼容）。
    text = _tw_effective_text(tw_settings)
    if not text:
        return ""
    # 倒计时（滚动小窗）：独占表现形式，优先于旋转/spin/轨迹返回自己的子图。
    # 参数算不出来（无字体等）时由它内部退回普通 drawtext，保证 chain 标签不断链。
    if tw_settings.get("countdown_enabled"):
        _cd = build_tw_countdown_subgraph(tw_settings, main_label=main_label, out_label=out_label,
                                          trim_start=trim_start, speed_factor=speed_factor, tag=tag)
        if _cd:
            return _cd
    font_name = tw_settings.get("font_name", _("微软雅黑"))
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    if not font_path or not os.path.exists(font_path):
        return ""
    font_size = _opt_int(tw_settings.get("font_size", 48), 48)
    color = tw_settings.get("font_color", "#FFFFFF")
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    x_expr = (tw_settings.get("overlay_x", "10") or "10").strip() or "10"
    y_expr = (tw_settings.get("overlay_y", "10") or "10").strip() or "10"

    # 列表轨迹缩放：fontsize 逐帧**矢量重绘**（放大不糊）。两种承载方式：
    #   · 行数 ≤ 阈值 → 逐帧表达式（_tw_zoom_fs，见 _tw_zoom_fontsize_tok）；
    #   · 行数 > 阈值 → 与 x/y 一起切 sendcmd，此处只用初始字面量 _tw_fs_literal
    #     （详见 _tw_waypoint_xy_sendcmd 的 fs_init 说明）。
    # ⚠️ 延迟绑定：两变量都在下方 _wp_res_tw / helper 返回后才赋值，而 _dt_parts 总在其后调用。
    _tw_zoom_fs = None
    _tw_fs_literal = None

    def _dt_parts(xv, yv, alpha_expr=None):
        if _tw_fs_literal is not None:
            _fs = f"fontsize={_tw_fs_literal}"
        else:
            _fs = _tw_zoom_fontsize_tok(font_size, _tw_zoom_fs)
        parts = [
            f"fontfile={escape_drawtext_path(font_path)}",
            f"text={escape_drawtext_text(text)}",
            _fs,
            f"fontcolor=0x{color.lstrip('#')}@{opacity:.2f}",
            f"x='{xv.replace(chr(39), chr(92) + chr(39))}'",
            f"y='{yv.replace(chr(39), chr(92) + chr(39))}'",
        ]
        bw = _opt_int(tw_settings.get("border_w", 0), 0)
        if bw > 0:
            bc = (tw_settings.get("border_color", "#000000") or "#000000").lstrip("#")
            parts.append(f"borderw={bw}")
            parts.append(f"bordercolor=0x{bc}@{opacity:.2f}")
        enable_expr = _build_drawtext_enable(tw_settings, trim_start=trim_start,
                                             speed_factor=speed_factor)
        if enable_expr:
            parts.append(f"enable='{enable_expr}'")
        # 列表轨迹透明度（oa→ob 段内线性插值）：与 fontcolor@opacity 相乘（drawtext alpha × 颜色透明度）
        if alpha_expr is not None:
            parts.append(f"alpha='{alpha_expr.replace(chr(39), chr(92) + chr(39))}'")
        return ":".join(parts)

    rotate = tw_settings.get("rotate", 0)
    rotate = _opt_float(rotate, 0.0)

    # 持续旋转（spin）：绕中心匀速转（angle=转速*PI/180*t），与图片/视频水印同款；
    # 静态旋转（rotate）与 spin 可叠加：先静态转，再持续转。
    spin_on = bool(tw_settings.get("spin_enabled", False))
    sp = tw_settings.get("spin_speed", 60.0)
    sp = _opt_float(sp, 60.0)
    # 列表轨迹（waypoints）：x/y + 分段自旋转 + 到期行为统一由 build_waypoint_expr 生成；
    # 列表存在自旋转段 → needs_rot=True（走旋转子图），且列表自旋转覆盖全局 spin。
    _mv = (tw_settings.get("move_mode", "") or "").strip()
    _wp_res_tw = None
    _wp_rot_tw = False
    _wp_zoom_tw = False
    # 列表轨迹透明度（oa→ob）：默认 None（仅 waypoints 模式赋值）；非 waypoints 时
    # 必须在外层先初始化，否则下方非旋转分支 _dt_parts(..., _tw_alpha_expr_tw) 会触发
    # UnboundLocalError（画中画模式简单单条水印即命中，导致整条命令崩掉、不出命令）。
    _tw_alpha_expr_tw = None
    if _mv == "waypoints":
        _wp_res_tw = build_waypoint_expr(tw_settings.get("move_waypoints"),
                                         spin_speed=sp,
                                         trim_start=trim_start, speed_factor=speed_factor)
        _wp_rot_tw = (_wp_res_tw is not None and _wp_res_tw[2] is not None)
        # 列表轨迹透明度（oa→ob）：与静态 opacity 相乘（drawtext alpha × fontcolor@opacity）
        _tw_alpha_expr_tw = (_wp_res_tw[4] if (_wp_res_tw is not None and _wp_res_tw[4] is not None) else None)
        # 列表轨迹缩放（2026-10-08）：交给 fontsize 逐帧表达式（矢量重绘，放大不糊）。
        _wp_zoom_tw = (_wp_res_tw is not None and _wp_res_tw[3] is not None)
        if _wp_zoom_tw:
            _tw_zoom_fs = _wp_res_tw[3]
    needs_rot = rotate != 0 or (spin_on and sp != 0) or _wp_rot_tw

    # 动态轨迹（move）：旋转时子层尺寸用裁剪后的文字包围盒（含 padding）做钳制；
    # 非旋转时沿用 drawtext 的 tw/th 变量（与原 build_drawtext_filter 行为一致）。
    if not needs_rot:
        if _mv == "waypoints":
            if _wp_res_tw is not None and _wp_res_tw[0] is not None:
                # sendcmd 接入（> 阈值）：与 build_drawtext_filter 共用 helper——
                # 此前该分支自拼 drawtext 漏接 sendcmd（封装页多轨 merge 即此路，
                # 2026-10-01 用户实测 20 行轨迹未切 sendcmd 发现）
                _r = _tw_waypoint_xy_sendcmd(tw_settings, trim_start, speed_factor,
                                             tag or "tw", wpr=_wp_res_tw)
                if _r is not None:
                    # 缩放也切了 sendcmd（_r[5] 非 None）⇒ fontsize 用初始字面量，
                    # 后续由命令文件逐帧改写（两处消费点口径必须一致，见 helper docstring）。
                    if _r[5] is not None:
                        _tw_fs_literal = _r[5]
                    dt = _r[2] + _r[3] + "=" + _dt_parts(_r[0], _r[1], _tw_alpha_expr_tw)
                    return f"{main_label}{dt}{out_label}" if main_label else f"{dt}{out_label}"
                x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
        elif _mv:
            _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw="tw", sh="th")
            if _mx is not None:
                x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
                y_expr = _my.replace("W", "main_w").replace("H", "main_h")
        dt = "drawtext=" + _dt_parts(x_expr, y_expr, _tw_alpha_expr_tw)
        return f"{main_label}{dt}{out_label}" if main_label else f"{dt}{out_label}"

    # ---- 旋转：透明层 + drawtext(居中) + rotate(静态/spin) + overlay ----
    tw, th = estimate_text_size(text, font_path, font_size)
    pad = 8
    tw2 = tw + 2 * pad
    th2 = th + 2 * pad
    # 实际挂了几道 rotate（静态角 与 自旋转/列表自旋转 各算一道）→ 包装盒按 √2 逐级放大。
    # ⚠️ 必须按实际道数求：两道时盒子是 hypot(hypot(w,h),hypot(w,h))，不是 hypot(w,h)。
    # 先算在这里，供下方 _clamp（运动钳制上界）与 _content_box_shift（中心对齐）共用。
    _n_rot_stages = (1 if rotate != 0 else 0) + \
                    (1 if (_wp_rot_tw or (spin_on and sp != 0)) else 0)
    # 持续旋转时 overlay 画布 = 对角线正方形（rotate ow/oh=hypot），钳制用该边长；
    # 仅静态旋转时钳制用 crop 包围盒尺寸（有意：静态旋转越界属用户预期，按内容盒定位）。
    # ⚠️ 2026-09-17：持续旋转分支必须按**实际道数**求盒，不能一律按一道 hypot——
    # 两道时实际占位 707（实测 400x300）却按 500 钳制 → 允许 x 走到 W-505，右边缘落到
    # W+202，水印真跑出画面，与 build_move_xy_expr「钳制到画面内」的意图相悖。
    # stages=0/1 时取值与旧逻辑逐值相同，仅「静态角+自旋转」这一组合有变。
    if (spin_on and sp != 0) or _wp_rot_tw:
        _clamp = int(rotate_box_size(tw2, th2, _n_rot_stages)[0])
    else:
        _clamp = tw2
    if _mv == "waypoints":
        if _wp_res_tw is not None and _wp_res_tw[0] is not None:
            x_expr, y_expr = _wp_res_tw[0], _wp_res_tw[1]
    elif _mv:
        # 用裁剪后的包围盒尺寸（字面量）做钳制，避免旋转后越界
        _mx, _my = build_move_xy_expr(_mv, x_expr, y_expr, tw_settings, sw=str(_clamp), sh=str(_clamp))
        if _mx is not None:
            x_expr = _mx.replace("W", "main_w").replace("H", "main_h")
            y_expr = _my.replace("W", "main_w").replace("H", "main_h")
    ml = main_label if main_label else ""
    # 透明层用独立 color 源（按 crop 尺寸 tw2×th2），不再 fork ml。
    # ⚠️ 关键：原先用 {ml}format=rgba,colorchannelmixer=aa=0[tw_bg] 时，ml（带图片水印的画布）被
    # format=rgba 强制全局转 rgba，最终 overlay 把图片水印内容弄丢。
    # 改用独立 color 源后，ml 只在最终 overlay 作为背景出现，画布内容完整保留。
    # 🔴 列表轨迹缩放（2026-10-08 矢量版）：旋转子图里 fontsize 逐帧变大 ⇒ 透明层必须按
    #    **列表最大缩放** zmax 预放大，并把文字**居中**画在层里 —— 这样层中心恒等于文字中心，
    #    后面 rotate 绕层中心转就是绕文字自身中心转（rotate 段零改动）。仅在确有缩放时启用；
    #    无缩放时下面 tw2×th2 / (pad,pad) 与旧代码**逐字节一致**。
    if _wp_zoom_tw:
        _zmax = _tw_waypoint_zoom_max(tw_settings.get("move_waypoints"))
        _lw = 2 * int(round(tw2 * _zmax / 2.0))
        _lh = 2 * int(round(th2 * _zmax / 2.0))
        base_node = f"color=c=black@0:s={_lw}x{_lh}:d=999999"
        dt_core = "drawtext=" + _dt_parts("(w-text_w)/2", "(h-text_h)/2")
        crop_node = f"crop={_lw}:{_lh}:0:0"
    else:
        base_node = f"color=c=black@0:s={tw2}x{th2}:d=999999"
        dt_core = "drawtext=" + _dt_parts(str(pad), str(pad))
        crop_node = f"crop={tw2}:{th2}:0:0"
    rot_parts = []
    _cur = "[tw_crop]"
    if rotate != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{rotate}*PI/180':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_r1]")
        _cur = "[tw_r1]"
    if _wp_rot_tw:
        # 列表自旋转覆盖全局 spin（仅列表标记的自旋转时段旋转，边移边转）
        rot_parts.append(
            f"{_cur}rotate=angle='({_wp_res_tw[2]})':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    elif spin_on and sp != 0:
        rot_parts.append(
            f"{_cur}rotate=angle='{sp}*PI/180*t':ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[tw_rot]")
        _cur = "[tw_rot]"
    # 中心对齐（2026-09-03 问题①修复）：rotate 输出 d×d（hypot）正方形画布，
    # 而 overlay_x/y 语义=内容盒（tw2×th2，含 pad）左上角（2026-08-26 铁律）→
    # 叠加盒左上角 = 内容盒左上角 − (d−tw2)/2、(d−th2)/2。缺失该减量时整块被向右下
    # 推移 (d−tw2)/2、(d−th2)/2，自旋转中心比预期低很多（与子视频 _content_box_shift
    # 中心对齐、图片水印 L18879 同源）。静态 rotate/spin/列表自旋转共用此 overlay。
    # ⚠️ 2026-09-17 修正：这里可能是**两道** rotate（静态角 + 自旋转/列表自旋转）→
    # 盒子按 √2 逐级放大，必须按实际道数求（见 rotate_box_size），否则少补 ~103px。
    if _wp_zoom_tw:
        # 缩放版中心对齐：内容盒随 z(t) 变（tw2·z × th2·z），而叠加盒 = rotate 输出（固定 _bx×_by，
        # 由 zmax 层决定）→ 叠加盒左上角 = 内容盒左上角 + 内容盒/2 − 叠加盒/2。
        # z≡1 时与 _content_box_shift 逐值等价（(d−tw2)/2 = d/2 − tw2/2）。
        _bx, _by = rotate_box_size(_lw, _lh, _n_rot_stages)
        _zexpr = _wp_res_tw[3]
        ov_node = (f"overlay=x='({x_expr}) + {tw2 / 2.0:.6g}*({_zexpr}) - {_bx / 2.0:.6g}'"
                   f":y='({y_expr}) + {th2 / 2.0:.6g}*({_zexpr}) - {_by / 2.0:.6g}':format=auto")
    else:
        _box_w, _box_h = rotate_box_size(tw2, th2, _n_rot_stages)
        _ov_dx, _ov_dy = _content_box_shift(tw2, th2, _box_w, _box_h)
        ov_node = f"overlay=x='({x_expr}) - {_ov_dx:.6g}':y='({y_expr}) - {_ov_dy:.6g}':format=auto"
    frag = ";".join([
        f"{base_node}[tw_bg]",
        f"[tw_bg]{dt_core}[tw_full]",
        f"[tw_full]{crop_node}[tw_crop]",
    ] + rot_parts + [f"{ml}{_cur}{ov_node}{out_label}"])
    return frag


COUNTDOWN_DIRECTIONS = ("top_bottom", "bottom_top", "left_right", "right_left")
_CD_DIR_IDS = list(COUNTDOWN_DIRECTIONS)


def countdown_direction_display():
    """内部 token（英文，稳定）→ 当前语言显示名。

    ⚠️ 必须是函数（multi 的 _() 依赖启动后装载的 TRANS）：写成「(_("上→下"), "top_bottom")」
    模块级元组会把显示名冻在导入时中文上，反查表就永远对不上译文。
    """
    return {"top_bottom": _("上→下"), "bottom_top": _("下→上"),
            "left_right": _("左→右"), "right_left": _("右→左")}
_CD_AXIS = {"top_bottom": "y", "bottom_top": "y", "left_right": "x", "right_left": "x"}
_CD_REVERSE = {"bottom_top": True, "right_left": True}

COUNTDOWN_PAD = 8      # 画布内边距（给描边/字形溢出留余量，与旋转子图 pad=8 同惯例）


def countdown_direction(tw_settings) -> str:
    """倒计时方向 id（空/非法值回退 top_bottom）。"""
    d = str((tw_settings or {}).get("countdown_direction", "") or "").strip()
    return d if d in _CD_DIR_IDS else "top_bottom"


def countdown_lines(text):
    """富文本 → 参与滚动的行列表：按换行拆分，去掉首尾空行与纯空白行。"""
    raw = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    lines = [ln.strip() for ln in raw.split("\n")]
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    return lines


def _cd_num(v, default, lo=None, hi=None):
    """读数值型倒计时设置：空/非法 → default；lo/hi 为 None 表示不限制该侧。"""
    if v is None or str(v).strip() == "":
        return default
    try:
        f = float(v)
    except (ValueError, TypeError):
        return default
    if lo is not None and f < lo:
        f = lo
    if hi is not None and f > hi:
        f = hi
    return f


def countdown_layout(tw_settings, font_path, font_size):
    """倒计时画布布局（纯计算：无 IO、不碰 ffmpeg）。返回 None 表示无法布局。

    返回 dict：
      lines       参与滚动的文本行
      horizontal  横排（左→右/右→左）还是竖排（上→下/下→上）
      canvas_w/h  画布像素尺寸（已含 COUNTDOWN_PAD 内边距）
      pos         每行 drawtext 的左上角 [(x, y)...]
      pitch       相邻行/列步进（= 单行自然尺寸 + 行距）
      t0/t1       匀速滚动的开始/结束时间（秒）；留空自动 = 0 ~ 行数−1（每秒滑过一格）
      win         显示窗口 (x, y, w, h)，已夹紧到画布内
      limit       窗口在该轴上能走到的最大坐标（停在最后一项完整入窗处）

    窗口四个值缺省（空/0）时按方向自动给：尺寸=单行/单列满幅，起点=首项（反向则是末项）。
    """
    fs = _opt_int(font_size, 48)
    if fs <= 0:
        fs = 48
    lines = countdown_lines((tw_settings or {}).get("text", ""))
    if not lines or not font_path or not os.path.exists(font_path):
        return None
    sizes = [estimate_text_size(ln, font_path, fs) for ln in lines]
    item_w = max(w for w, _h in sizes) or fs
    item_h = max(h for _w, h in sizes) or fs
    raw_gap = (tw_settings or {}).get("countdown_gap")
    gap = int(_cd_num(raw_gap, 0, lo=0, hi=2000))
    if raw_gap is None or str(raw_gap).strip() == "":
        gap = max(2, int(round(fs * 0.2)))     # 没设过 → 按字号给个舒服的默认间距
    _dir = countdown_direction(tw_settings)
    horizontal = _CD_AXIS[_dir] == "x"
    reverse = _CD_REVERSE.get(_dir, False)
    n = len(lines)
    if horizontal:
        pitch = item_w + gap
        canvas_w = (n - 1) * pitch + item_w + 2 * COUNTDOWN_PAD
        canvas_h = item_h + 2 * COUNTDOWN_PAD
        pos = [(COUNTDOWN_PAD + i * pitch + (item_w - w) // 2, (canvas_h - h) // 2)
               for i, (w, h) in enumerate(sizes)]
        win_dw, win_dh = item_w, canvas_h
    else:
        pitch = item_h + gap
        canvas_w = item_w + 2 * COUNTDOWN_PAD
        canvas_h = (n - 1) * pitch + item_h + 2 * COUNTDOWN_PAD
        pos = [((canvas_w - w) // 2, COUNTDOWN_PAD + i * pitch)
               for i, (w, h) in enumerate(sizes)]
        win_dw, win_dh = canvas_w, item_h
    def _win_val(key, auto):
        raw = (tw_settings or {}).get(key)
        if raw is None or str(raw).strip() == "":
            return int(auto)
        try:
            return int(float(raw))
        except (ValueError, TypeError):
            return int(auto)

    # 窗口未设置时的默认尺寸 = 单行 / 单列（另一轴铺满画布）
    ww = _win_val("countdown_win_w", win_dw)
    wh = _win_val("countdown_win_h", win_dh)
    # 窗口夹紧到画布内：越界的 crop 会让 ffmpeg 直接报错/拉黑，归到合法区间更稳
    ww = max(2, min(ww, canvas_w))
    wh = max(2, min(wh, canvas_h))
    # 运动边界：停在「最后一项刚好完整入窗」处（= 内容末端 − 窗口尺寸），而不是画布底。
    # ⚠️ 用画布底的话最后一格会滑出窗口、片尾变成空白块 —— 「到底停住」要的是停在最后一项。
    # 窗口比内容还长时该值会小于起点，再夹回 COUNTDOWN_PAD（此时本来也无处可滚）。
    _item_axis = item_h if not horizontal else item_w
    _canvas_axis = canvas_h if not horizontal else canvas_w
    _win_axis = wh if not horizontal else ww
    _content_end = COUNTDOWN_PAD + (n - 1) * pitch + _item_axis
    far = max(COUNTDOWN_PAD, min(_content_end - _win_axis, _canvas_axis - _win_axis))
    # 起点默认：正向=画布首项处，反向=末项处（用户手填的 win_x/win_y 优先）
    start = far if reverse else COUNTDOWN_PAD
    wx = _win_val("countdown_win_x", start if horizontal else 0)
    wy = _win_val("countdown_win_y", 0 if horizontal else start)
    wx = max(0, min(wx, canvas_w - ww))
    wy = max(0, min(wy, canvas_h - wh))
    return {
        "lines": lines, "horizontal": horizontal, "reverse": reverse,
        "canvas_w": canvas_w, "canvas_h": canvas_h, "pos": pos,
        "pitch": pitch, "start": (far if reverse else COUNTDOWN_PAD),
        "t0": _cd_num((tw_settings or {}).get("countdown_t0"), 0.0, lo=0.0, hi=360000),
        "t1": _cd_num((tw_settings or {}).get("countdown_t1"),
                      max(1.0, float(n - 1)), lo=0.001, hi=360000),
        "win": (wx, wy, ww, wh),
        "limit": far,
    }


def build_tw_countdown_subgraph(tw_settings, main_label: str = "", out_label: str = "[v_tw]",
                                trim_start=0.0, speed_factor=1.0, tag: str = ""):
    """倒计时（滚动小窗）文字水印的 filter_complex 片段。

    与「旋转子图」同级：吃 main_label（主视频）输出 out_label；graph 形如
        color=c=black@0:s=CWxCH:d=999999[cd_bg0];
        [cd_bg0]drawtext=…,drawtext=…,…[cd_strip0];
        [cd_strip0]crop=w=WW:h=WH:x=0:y='8+(601-8)*min(max((t-1)/4,0),1)'[cd_win0];
        [主][cd_win0]overlay=x='(X)':y='(Y)':format=auto[out]

    ⚠️ 基础源必须写成 color=c=black@0 —— _ensure_tw_duration_limit 靠这个子串识别
    「命令里有无限时长源」，从而自动补 -shortest / -t（否则输出被拉到 999999 秒）。
    tag：同图多条时的标签后缀（由 build_text_watermark_chain 按下标传入），防标签重名。
    2026-09-19：显示时段起点作为计时零点（第 5 秒才出现时窗口不该已经滑走）；
    2026-09-19 二稿：运动模型=「开始~结束时间内匀速线性滚动」（弃跳格 floor(t/T)*STEP）——
    开始前钳在起点、结束后钳在终点；t0/t1 是秒（随变速/trim 换算），像素坐标不受变速影响。
    """
    if not tw_settings or not tw_settings.get("enabled", False):
        return ""
    fs = _opt_int(tw_settings.get("font_size", 48), 48)
    font_name = tw_settings.get("font_name", _("微软雅黑"))
    font_path = tw_settings.get("font_path", "") or resolve_cn_font_path(font_name)
    lay = countdown_layout(tw_settings, font_path, fs)
    if not lay:
        return ""
    opacity = _opt_float(tw_settings.get("opacity", 1.0), 1.0)
    opacity = max(0.0, min(1.0, opacity))
    bw = _opt_int(tw_settings.get("border_w", 0), 0)
    _bc = (tw_settings.get("border_color", "#000000") or "#000000").lstrip("#")
    _fc = (tw_settings.get("font_color", "#FFFFFF") or "#FFFFFF").lstrip("#")
    _fp = escape_drawtext_path(font_path)

    # ---- ① 画布：每行一个 drawtext 显式定位（绝不用 text_h 做多行居中）----
    dt_nodes = []
    for i, ln in enumerate(lay["lines"]):
        px, py = lay["pos"][i]
        p = [f"fontfile={_fp}", f"text={escape_drawtext_text(ln)}",
             f"fontsize={fs}", f"fontcolor=0x{_fc}@{opacity:.2f}",
             f"x={px}", f"y={py}"]
        if bw > 0:
            p += [f"borderw={bw}", f"bordercolor=0x{_bc}@{opacity:.2f}"]
        dt_nodes.append("drawtext=" + ":".join(p))

    # ---- ② 滚动时段换算（同 _build_drawtext_enable 口径：秒随 trim 平移、除 speed）----
    _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
    _ts = float(trim_start or 0.0)
    _sp = _opt_float(speed_factor or 1.0, 1.0)
    if _sp <= 0:
        _sp = 1.0
    _e0 = _f(tw_settings.get("enable_start")) or 0.0   # 显示时段起点 = 计时零点
    _a = _e0 + float(lay["t0"])
    _b = _e0 + max(float(lay["t1"]), float(lay["t0"]) + 0.001)
    if _b <= _a:
        _b = _a + 0.001          # 结束≤开始 → 按最小时长兜底（窗口等于不动）
    if _ts != 0.0 or _sp != 1.0:
        # 区间两端都换算（_timeline_convert 是线性映射，端点各自变换即区间变换）
        _a, _du = _timeline_convert(_a, 0.0, _ts, _sp)
        _b, _du = _timeline_convert(_b, 0.0, _ts, _sp)
        if _b <= _a:
            _b = _a + 0.001
    _a = max(0.0, float(_a))
    _b = max(_a + 0.001, float(_b))
    _den = _ffsec(_b - _a)
    _prog = (f"(t/{_den})" if _a <= 0
             else f"((t-{_ffsec(_a)})/{_den})")
    _prog = f"min(max({_prog},0),1)"   # 开始前=0 停在起点；结束后=1 停在终点

    # ---- ③ 显示窗口沿轴匀速滚动：pos = 起点 + (终点−起点)×进度 ----
    # 反向的终点是「首项所在位置」(COUNTDOWN_PAD) 而不是 0 —— 要停在第一个字上，
    # 滑到 0 会多吃掉一个 COUNTDOWN_PAD 的边距，边上的字会偏。
    wx, wy, ww, wh = lay["win"]
    if lay["horizontal"]:
        _end = float(lay["limit"]) if not lay["reverse"] else float(min(wx, COUNTDOWN_PAD))
        _d = _end - float(wx)
        x_expr = f"({wx})+({_d:g})*{_prog}"
        y_expr = str(wy)
    else:
        _end = float(lay["limit"]) if not lay["reverse"] else float(min(wy, COUNTDOWN_PAD))
        _d = _end - float(wy)
        y_expr = f"({wy})+({_d:g})*{_prog}"
        x_expr = str(wx)
    crop_node = f"crop=w={ww}:h={wh}:x='{x_expr}':y='{y_expr}'"

    # ---- ④ 叠加回主视频：X/Y 沿用普通文字水印语义（= 小窗左上角）----
    _q = lambda s: str(s).replace(chr(39), chr(92) + chr(39))
    ov_x = (tw_settings.get("overlay_x", "10") or "10").strip() or "10"
    ov_y = (tw_settings.get("overlay_y", "10") or "10").strip() or "10"
    ov_node = f"overlay=x='{_q(ov_x)}':y='{_q(ov_y)}':format=auto"
    _en = _build_drawtext_enable(tw_settings, trim_start=trim_start, speed_factor=speed_factor)
    if _en:
        ov_node += f":enable='{_q(_en)}'"

    _t = tag or ""
    ml = main_label if main_label else ""
    return ";".join([
        f"color=c=black@0:s={lay['canvas_w']}x{lay['canvas_h']}:d=999999[cd_bg{_t}]",
        f"[cd_bg{_t}]" + ",".join(dt_nodes) + f"[cd_strip{_t}]",
        f"[cd_strip{_t}]{crop_node}[cd_win{_t}]",
        f"{ml}[cd_win{_t}]{ov_node}{out_label}",
    ])


def wrap_image_static_timed_complex(lavfi_complex_str, base_vf, w, h, dur,
                                    vin="[VIN]", prefix="", fps=30, out="v0"):
    """图片主视频 + 带时间滤镜（倒计时/轨迹/旋转）的 mpv 动画修复（纯函数，2026-09-19）。

    2026-09-22 参数化（A5 收敛）：原先只有 `[VIN]` + `[v0]` 一种形态，导致封装页画中画
    （`[vid1]` 且带 loop/trim 前缀）只能内联手抄一遍。现补 4 个可选参数，默认值与旧调用
    逐字等价，故既有调用方零行为变化：
      · vin    主输入标签（画中画传 "[vid1]"）；
      · prefix 主输入标签后的前置滤镜串（画中画传 loop/trim 前缀，需带尾逗号）；
      · fps    基源帧率（默认 30，与旧硬编码一致）；
      · out    输出标签名（不含方括号，默认 "v0"）。

    静态图片在 mpv 里只被解码成「单帧」：若 lavfi-complex 最终输出的主输入是图片
    ([VIN])，整张滤镜图只在该单帧上求值一次，时间变量 t 卡死 → 倒计时/轨迹不动。
    修复 = 前置一个连续 color 基源、把图片作为「被保持的次输入」叠上去（overlay 默认
    eof_action=repeat 保持图片），使 [v0] 变连续流。这精确镜像用户已验证可用的 fade 写法
    （连续 color 作主时间轴驱动，图片作被保持的次输入）。

    仅对 mpv 的 lavfi-complex 路径生效；ffplay 走 -loop 1 天然连续，不走此函数。
    :param base_vf: 主视频前置滤镜链（如 'format=yuv420p' 或 ''/'null'）；
                    与 lavfi_complex_str 首节点 '[VIN]{base_vf}[v0]' 保持一致。
    :param w,h,dur: 图片尺寸与显示时长（秒）；基源 s=WxH、r=30、d=dur。
    :return: 改写后的 lavfi-complex 字符串（首节点变为
             '[VIN]{base_vf}[cd_v0];[cd_base][cd_v0]overlay=format=auto[v0]'，
             前置 'color=c=black@0:s=WxH:r=30:d=dur[cd_base];'）；
             注意 [cd_base] 只能作为 overlay 的主输入，绝不能前置到 format 这类单输入滤镜前
             （否则 filtergraph 报「输入数不符」→ mpv 无画面）；[VIN] 经 format 后只产生 [cd_v0]，
             再由 overlay 叠到连续基源上。若首节点形态不匹配则原样返回（如画布图，其首节点
             不是 [VIN]{base_vf}[v0]）。
    """
    if not lavfi_complex_str:
        return lavfi_complex_str
    try:
        _w = int(w); _h = int(h); _d = float(dur)
    except (ValueError, TypeError):
        return lavfi_complex_str
    if _w <= 0 or _h <= 0 or _d <= 0:
        return lavfi_complex_str
    _bf = base_vf if (base_vf and base_vf != "null") else "format=yuv420p"
    _old = f"{vin}{prefix}{_bf}[{out}]"
    if _old not in lavfi_complex_str:
        return lavfi_complex_str
    _new = (f"{vin}{prefix}{_bf}[cd_v0];"
            f"[cd_base][cd_v0]overlay=format=auto[{out}]")
    _pre = f"color=c=black@0:s={_w}x{_h}:r={fps:g}:d={_ffsec(_d)}[cd_base];"
    return _pre + lavfi_complex_str.replace(_old, _new, 1)


def ffplay_image_main_vf(vf, dur):
    """图片主视频的 ffplay `-vf` 图改写：让单帧图片变成「可循环 + 到点收尾」的连续流（2026-09-21）。

    为什么必须改写（真机实测 ffplay n9.0.1，SDL dummy 无头）：
      - `-loop 1 -i img.jpg` 在 ffplay 下**不循环** ⇒ 1 帧读完即退窗（实测 0.64s）；
      - `-autoexit` 盯的是**主输入 EOF**，图片输入只有 1 帧 ⇒ 立刻 EOF 退窗；
      - 只前置 color 连续基源（mpv 的 wrap）也救不了退窗（实测仍 0.64s）——它解决的是
        「时间变量 t 卡死」（倒计时/轨迹/旋转不动），不是输入 EOF。

    ✅ 破法（与封装页画中画 ffplay 路线同款、已实测）：图首给主输入注入
    `loop=loop=-1:size=1:start=0,setpts=PTS-STARTPTS,` 把主分支变**无限流**，图尾
    `trim=0:N,setpts=PTS-STARTPTS` 收尾 ⇒ `-autoexit` 转而等【输出】结束，窗口在 N 秒正常关。
    实测 6s 图：0.64s → 6.63s（存活 = 图长）。

    :param vf:  ffplay 的 -vf 字符串。两种形态都支持：
                · 分号多段图（含 `[in]`/`[out]` 显式标签，如复杂图改写结果）；
                · 纯逗号链（无标签，如普通滤镜链）。
    :param dur: 图片显示时长（秒）；无效/<=0 时原样返回（调用方保持旧行为）。
    :return: 改写后的 -vf 字符串。
    """
    try:
        _d = float(dur)
    except (ValueError, TypeError):
        return vf
    if not vf or _d <= 0:
        return vf
    _pfx = "loop=loop=-1:size=1:start=0,setpts=PTS-STARTPTS,"
    _tail = f"trim=0:{_ffsec(_d)},setpts=PTS-STARTPTS"
    if "[in]" in vf:
        g = vf.replace("[in]", "[in]" + _pfx, 1)
        if "[out]" in g:
            g = g.replace("[out]", "[v_img_loop]", 1)
        else:
            # 图的末标签不是 [out]（异常形态）→ 取最后一个输出标签接尾
            _tags = re.findall(r"\[([^\]]+)\](?=\s*(?:;|$))", g)
            if not _tags:
                return vf
            g = g.replace(f"[{_tags[-1]}]", "[v_img_loop]", 1)
        return f"{g};[v_img_loop]{_tail}[out]"
    # 分号多段图却拿不到 [in]（异常形态：调用方未用 [VIN]/[vid1] 占位）→ 前缀无处可插，
    # 原样返回（调用方另打日志）。绝不能退化成拼逗号链：`loop=..,<段1>;<段2>,trim=..`
    # 是坏图，ffplay 只会给黑窗 + stderr 噪声。
    if ";" in vf:
        return vf
    # 纯逗号链：直接首尾相接（loop 前缀 + 末端 trim）
    return f"{_pfx}{vf},{_tail}"


def build_text_watermark_chain(tw_input, main_label: str = "", out_label: str = "[v_tw]") -> str:
    """多个文字水印链式生成（2026-08-26）。

    tw_input: 完整 settings（含 text_watermark_items / text_watermark）或单条 tw dict。
    - 完整 settings 且有 text_watermark_items → 遍历启用项逐个调用 build_text_watermark_filtergraph，
      out_label 逐级串联（第 k 项输出接第 k+1 项输入）；
    - 无 items → 退化为单条（text_watermark 或 tw_input 本身），行为与旧版一致。
    """
    if isinstance(tw_input, dict) and ("text_watermark_items" in tw_input or "text_watermark" in tw_input):
        items = tw_input.get("text_watermark_items")
        if not items:
            items = [tw_input.get("text_watermark") or {}]
    else:
        items = [tw_input or {}]
    active = [i for i in items
              if i.get("enabled", True) and str(i.get("text", "")).strip()]
    if not active:
        return ""
    # 2026-08-29：tw_input=完整主视频 settings 时取 trim/speed 换算输出时间线
    # （文字水印显示时段/列表轨迹时间=主视频原始时间）；预览 settings 已禁用 trim → 不换算
    _ts, _sp = _trim_speed_from_settings(tw_input)
    cur_in = main_label
    frags = []
    for k, tw in enumerate(active):
        out = out_label if k == len(active) - 1 else f"[v_tw{k}]"
        f = build_text_watermark_filtergraph(tw, main_label=cur_in, out_label=out,
                                             trim_start=_ts, speed_factor=_sp, tag=str(k))
        if f:
            frags.append(f)
            cur_in = out
    return ";".join(frags)


def text_watermark_needs_subgraph(tw_settings) -> bool:
    """文字水印是否需要 filter_complex 子图：倒计时 / 静态旋转(rotate≠0) / 持续旋转(spin)任一启用。
    ⚠️ 必须与 build_text_watermark_filtergraph 内部的 needs_rot 判定逐字一致——
    各调用点用它决定走 -filter_complex 子图还是普通 -vf drawtext。
    曾因漏查 spin_enabled，导致「只开自旋转、旋转角度=0」时走了普通 drawtext 路径而不转。
    2026-09-19：倒计时=「画布 + 滚动 crop 窗口 + overlay」三段图，-vf 表达不了 → 同样返回 True。"""
    if not tw_settings:
        return False
    if tw_settings.get("countdown_enabled"):
        return True
    try:
        rot = float(tw_settings.get("rotate", 0) or 0) != 0
    except (ValueError, TypeError):
        rot = False
    spin = bool(tw_settings.get("spin_enabled", False))
    sp = _opt_float(tw_settings.get("spin_speed", 0) or 0, 0.0)
    if rot or (spin and sp != 0):
        return True
    # 列表轨迹：存在自旋转段 → 需要旋转子图（判定须与 build_text_watermark_filtergraph 一致）
    if (tw_settings.get("move_mode") or "") == "waypoints":
        try:
            _wpr = build_waypoint_expr(tw_settings.get("move_waypoints"), spin_speed=sp)
            if _wpr is not None and _wpr[2] is not None:
                return True
        except Exception:
            pass
    return False


def text_watermark_active(tw_settings) -> tuple:
    """文字水印是否生效 + 是否需要走旋转子图。返回 (enabled, needs_subgraph)。

    - enabled         = 开启且文字非空
    - needs_subgraph  = enabled 且 (静态旋转 rotate≠0 或 持续旋转 spin_enabled)

    ⚠️ 各命令生成点用它一次性算出 _tw_enabled / _tw_rotate，避免「启用判定」
    与 text_watermark_needs_subgraph 在各处重复书写而漂移。"""
    enabled = bool(tw_settings.get("enabled")) and bool((tw_settings.get("text", "") or "").strip())
    return enabled, (enabled and text_watermark_needs_subgraph(tw_settings))


def _cmd_has_output_option(cmd_list, *opts):
    u"""命令的【输出侧】是否已含指定选项（如 -t / -to / -shortest）。

    ffmpeg 的 -t/-to/-shortest 是位置相关选项：出现在最后一个 -i 之前的是【输入级】，
    只作用于该输入（例如图片素材烘焙出的 "-loop 1 -framerate 30 -t 16 -i img" 只让这张图
    读 16 秒），并不能限制整体输出。所以判断「输出已有时长限制」必须只看最后一个 -i
    之后的部分——否则输入级 -t 会让输出级限制被误判成已存在而漏加，无限源（文字水印旋转
    画布 color=c=black@0）就再也没人截断。
    同口径先例见 _adjust_end_concat_duration 的 last_i 写法。"""
    last_i = -1
    for idx, a in enumerate(cmd_list):
        if a == "-i":
            last_i = idx
    tail = cmd_list[last_i + 1:]
    return any(o in tail for o in opts)


def _ensure_tw_duration_limit(app, cmd_list, *, input_path=None, main_duration=None,
                              audio_enabled=True, tag=None,
                              image_display_duration=None):
    """文字水印旋转/持续旋转(spin)时，build_text_watermark_filtergraph 使用
    color=c=black@0:s=WxH:d=999999 的无限时长透明源；若命令尚未加任何时长限制，
    必须补上时长限制，否则输出会被无限拉长到 999999s（甚至卡死）。

    时长限制策略（经真实 ffmpeg 验证）：
    - 主视频【有音频】且音频输出启用 → 用 -shortest（音频为有限流，可正确截断；
      实测无音频时 -shortest 对 color 无限源会卡死/不截断，故无音频绝不用 -shortest）。
    - 主视频【无音频】或音频禁用 → 必须用 -t 精确截断：优先用调用方传入的 main_duration，
      否则尝试探测主视频时长；两者皆无才无奈回退 -shortest（可能卡，但总比无限输出好）。

    非旋转文字水印（drawtext）不带无限源，命令里不含 color=c=black@0 标记会自动跳过，
    不影响正常有界输出。模块级辅助，app 传入调用方实例（需 _get_cached_stream_info /
    _get_media_duration / _append_info_ui）。只就地 append 到 cmd_list。"""
    # 仅当命令确实包含文字水印的无限透明源时才需要限制
    if tag is None:
        tag = _("[文字水印]")
    if not any("color=c=black@0" in str(a) for a in cmd_list):
        return
    # 输出侧已有限制（别处已加输出级 -t / -shortest）则跳过，避免重复。
    # 注意只看输出侧：输入级 -t（图片素材烘焙时长 -loop 1 -t N -i img）不能截断无限源画布。
    if _cmd_has_output_option(cmd_list, "-shortest", "-t"):
        return
    has_audio_stream = False
    if input_path and os.path.exists(input_path):
        info = app._get_cached_stream_info(input_path)
        if info and any(s.get("codec_type") == "audio"
                        for s in info.get("streams", [])):
            has_audio_stream = True
    # 有音频：优先 -shortest（音频有限流可正确截断）
    if audio_enabled and has_audio_stream:
        cmd_list.append("-shortest")
        return
    # 无音频 / 音频禁用：必须用 -t 精确截断，避免 -shortest 对 color 无限源卡死
    eff = main_duration
    # 静态图片主视频：无真实时长概念（ffprobe 对图片常返回 N/A 或 0.04 等小值），
    # 统一按默认 10s 处理（与 merge_build_cmd_list 的图片默认时长逻辑一致），
    # 避免文字水印旋转/spin 触发的时长限制把 -t 干扰成 -t 0.040。
    if input_path and os.path.exists(input_path) and \
            os.path.splitext(input_path)[1].lower() in ('.png', '.jpg', '.jpeg', '.bmp', '.webp'):
        # 图片主视频：优先用用户设定的「显示时长」(img_duration)，否则回退 10s
        eff = image_display_duration if (image_display_duration and image_display_duration > 0) else 10.0
    elif not (eff and eff > 0) and input_path and os.path.exists(input_path):
        try:
            eff = app._get_media_duration(input_path)
        except Exception:
            eff = None
    if eff and eff > 0:
        cmd_list.extend(["-t", f"{eff:.3f}"])
    else:
        # 兜底：连时长都算不出，退 -shortest（可能卡，但总比无限输出好）
        cmd_list.append("-shortest")
        with suppress(Exception):
            app._append_info_ui(
                _('{0} 警告：无法计算主视频时长，使用 -shortest 控制输出。').format(tag))


def _eff_image_display_duration(settings, default=10.0):
    u"""图片素材的「显示时长(秒)」：优先取用户设置的 img_duration，否则回退 default。

    图片文件本身无时长概念（ffprobe 对图片常返回 N/A 或 0.04s 小值），
    显示时长完全由用户在「截取」面板设定，不依赖文件探测值。"""
    if not settings:
        return default
    d = settings.get("img_duration", "")
    if d:
        try:
            s = time_to_seconds(str(d))
            if s and s > 0:
                return s
        except Exception:
            pass
    return default


def _merge_output_total_duration(app, enabled_tracks):
    u"""串行合并多素材时，整条时间轴的总时长 = 各启用视频轨道有效时长之和。

    图片素材取其「显示时长」(img_duration)；真实视频取探测时长（尊重截取）。
    不含转场重叠扣减——转场由用户后续作为独立文件处理（与 NLE「每张图=自带时长的 clip」一致）。"""
    total = 0.0
    for t in enabled_tracks:
        if getattr(t, "type", "video") != "video":
            continue
        st = getattr(t, "enc_settings", None) or {}
        p = normalize_path(getattr(t, "file_path", "") or "")
        if app._is_static_image(p):
            total += _eff_image_display_duration(st)
        else:
            d = app._get_media_duration(p) if p else None
            if d:
                if st.get("trim_enabled"):
                    try:
                        ss = time_to_seconds(str(st.get("trim_start", "")).strip() or "0") or 0.0
                        es = time_to_seconds(str(st.get("trim_end", "")).strip() or "")
                        if es is not None:
                            d = max(0.0, es - ss)
                    except Exception:
                        pass
                total += d
    return total


# ================== 视频尺寸计算 ==================
def get_video_dimensions(ffprobe_cmd: str, file_path: str) -> Tuple[Optional[int], Optional[int]]:
    """获取视频原始宽高（不考虑旋转）"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None, None
    cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
           "-show_entries", "stream=width,height", "-of", "csv=p=0", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
        if result.returncode == 0 and ',' in result.stdout.strip():
            w_str, h_str = result.stdout.strip().split(',')
            return int(w_str), int(h_str)
    except:
        pass
    return None, None

def get_video_pixel_aspect(ffprobe_cmd: str, file_path: str) -> Optional[Tuple[int, int]]:
    """获取像素宽高比 SAR（sample aspect ratio），如 (9, 16)；方形像素/读取失败返回 None。

    背景（2026-09-07）：HandBrake 默认 Loose anamorphic 会在 crop 后写 SAR 保住源显示
    比例，出现「编码 1080x1080、播放器按 9:16 拉伸成 1080x1920」的文件。ffmpeg 滤镜
    坐标始终按编码像素网格（不受 SAR 影响），但 ffprobe width/height 不含此信息，
    可视化裁剪等「所见即所得」界面需要单独读取来做显示拉伸。
    """
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None
    cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
           "-show_entries", "stream=sample_aspect_ratio", "-of", "csv=p=0", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
        lines = (result.stdout or "").strip().splitlines()
        if not lines:
            return None
        parts = lines[0].strip().split(":")
        if len(parts) != 2:
            return None  # "N/A" 等非 num:den 形式
        num, den = int(parts[0]), int(parts[1])
        if num <= 0 or den <= 0 or num == den:
            return None
        return num, den
    except:
        return None

def _sar_effective_after_prefilter(sar_pair, pre_filter):
    """背景预处理滤镜含奇数个 transpose（90°/270° 旋转）时交换 SAR 拉伸轴。

    实测 n9.0.1：crop 保留 SAR（裁出区域照样按源方向拉伸显示）；
    transpose=1/2 交换 SAR（9:16→16:9，像素转了 90° 拉伸轴必随之转）；
    180° = transpose 两次（偶数）不换轴；hflip/vflip 不改 SAR。
    位置编辑器画布是旋转后坐标空间（compute_rendered_size 已交换宽高），
    拉伸轴必须随旋转交换，否则竖拉/横拉方向与播放器显示相反。
    """
    if not sar_pair:
        return sar_pair
    try:
        _nt = len(re.findall(r"transpose=[12]", pre_filter or ""))
        if _nt % 2 == 1:
            return (sar_pair[1], sar_pair[0])
    except Exception:
        pass
    return sar_pair

def get_video_display_geometry(ffprobe_cmd: str, file_path: str):
    """编码尺寸 + 播放显示几何（SAR 拉伸后）。

    返回 (w, h, full_w, full_h, sar_num, sar_den)；方形像素/读取失败时
    full == w/h、sar 两个 None。坐标空间恒为编码像素，full 只用于「显示」：
    可视化编辑器按 full 等比缩放入屏幕，坐标用 x/y 独立因子反算回编码网格
    （所见即所得：预览拉伸 → 裁剪/选区落在编码网格 → 转出继承 SAR → 播放器同样拉伸）。
    """
    w, h = get_video_dimensions(ffprobe_cmd, file_path)
    if w is None or h is None:
        return None, None, None, None, None, None
    fw, fh = w, h
    sn = sd = None
    sar = get_video_pixel_aspect(ffprobe_cmd, file_path)
    if sar is not None:
        sn, sd = sar
        if sd > sn:
            # 竖向拉伸（如 9:16）：播放器保持宽度、拉高
            fh = max(1, int(round(h * sd / sn)))
        else:
            # 横向拉伸：播放器保持高度、拉宽
            fw = max(1, int(round(w * sn / sd)))
    return w, h, fw, fh, sn, sd

# get_video_rotated_dimensions 原本每次调用要起 2 个 ffprobe 子进程（尺寸 + 元数据旋转），
# 而预览路径（_preview_with_settings）单次会对同一个水印文件重复调用 4 次 ⇒ 这里按
# (路径, mtime) 缓存，源文件一改自动失效。与 FFmpegBatchGUI._get_video_dimensions_cached
# 同口径（都是 path+mtime）。
# ⚠ 失败不进缓存（超时 / rc≠0 / 解析失败下次仍重试），避免把「这次没探到」固化成「没有旋转」。
_PROBE_CACHE_MAX = 256
_PROBE_DIM_CACHE = {}      # (path, mtime) -> (w, h)
_PROBE_ROT_CACHE = {}      # (path, mtime) -> Optional[int] 元数据旋转角

def _probe_cache_key(file_path):
    """取不到 mtime 时返回 None（= 本次不缓存）"""
    try:
        return (file_path, os.path.getmtime(file_path))
    except OSError:
        return None

def _probe_cache_put(cache, key, value):
    if key is None:
        return
    if len(cache) >= _PROBE_CACHE_MAX:
        cache.clear()
    cache[key] = value

def get_video_rotated_dimensions(ffprobe_cmd: str, file_path: str, settings: Dict[str, Any]) -> Tuple[Optional[int], Optional[int]]:
    """获取考虑元数据旋转和用户旋转后的尺寸

    尺寸与元数据旋转各带一层缓存（见上方 _PROBE_*）：重复调用不再重复起 ffprobe。
    用户旋转（settings["rotate"]）**不进**缓存 key —— 它是在返回值上临时叠加的。
    """
    # 🔴 2026-10-17 修复：虚拟源（color:/gen: 哨兵或展开式）无磁盘文件，ffprobe 读不到。
    # 直接从哨兵/展开式解析尺寸，否则返回 None ⇒ 调用方落到 1280x720 兜底，分组画布
    # 尺寸错 ⇒ 组内表达式偏移（W-w-10 等）按错画布算出虚假坐标（组内主偏移错乱 bug）。
    # 元数据旋转对虚拟源恒为 0；仅应用用户旋转（与下方真实路径语义一致）。
    _vd = _virtual_source_dimensions(file_path)
    if _vd is not None:
        w, h = _vd
        rotate = (settings or {}).get("rotate", "none")
        if rotate in ("90", "270"):
            w, h = h, w
        return w, h
    _ckey = _probe_cache_key(file_path)
    if _ckey is not None and _ckey in _PROBE_DIM_CACHE:
        w, h = _PROBE_DIM_CACHE[_ckey]
    else:
        w, h = get_video_dimensions(ffprobe_cmd, file_path)
        if w is not None and h is not None:
            _probe_cache_put(_PROBE_DIM_CACHE, _ckey, (w, h))
    if w is None:
        return None, None
    # 检测元数据旋转
    if ffprobe_cmd:
        rot = None
        if _ckey is not None and _ckey in _PROBE_ROT_CACHE:
            rot = _PROBE_ROT_CACHE[_ckey]
        else:
            cmd = [ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
                   "-show_entries", "stream=side_data_list", "-of", "json", file_path]
            try:
                flags = _ffmpeg_spawn_flags()
                result = subprocess.run(cmd, capture_output=True, text=True,
                                        timeout=_GLOBAL_SETTINGS["ffprobe_timeout"], creationflags=flags)
                if result.returncode == 0:
                    data = json.loads(result.stdout)
                    streams = data.get("streams", [])
                    if streams:
                        side_data = streams[0].get("side_data_list", [])
                        for sd in side_data:
                            if sd.get("rotation") is not None:
                                rot = int(sd.get("rotation"))
                                break
                    # 只有 rc==0 才写入缓存（失败留给下次重试）
                    _probe_cache_put(_PROBE_ROT_CACHE, _ckey, rot)
            except:
                pass
        if rot is not None and rot % 180 == 90:
            w, h = h, w
    # 用户旋转
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    return w, h

def compute_rendered_size(original_w: int, original_h: int, settings: Dict[str, Any]) -> Tuple[int, int]:
    """根据设置（裁剪、旋转、缩放）计算最终渲染尺寸"""
    w, h = original_w, original_h

    # --- 防御性检查，避免除零 ---
    if w == 0 or h == 0:
        return 0, 0

    # 裁剪
    if settings.get("crop_enabled", False):
        crop_w = settings.get("crop_width", "").strip()
        crop_h = settings.get("crop_height", "").strip()
        if crop_w and crop_h:
            def eval_crop(expr):
                if not expr:
                    return None
                expr2 = expr.replace('iw', str(w)).replace('ih', str(h))
                result = safe_eval_expr(expr2, {})
                return result if result is not None else None
            cw = eval_crop(crop_w)
            ch = eval_crop(crop_h)
            if cw and ch and cw > 0 and ch > 0:
                w, h = cw, ch
    # 用户旋转（2026-08-29 补：rotate 90/270 交换宽高，与 compute_final_size_with_order
    # 的 crop→rotate→scale 顺序一致——原版漏 rotate，主视频旋转时文字水印画布宽高
    # 不交换=「编辑框尺寸没旋转但背景帧(transpose)转了」错位）
    rotate = settings.get("rotate", "none")
    if rotate in ("90", "270"):
        w, h = h, w
    # 缩放
    if settings.get("scale_enabled", False):
        method = settings.get("scale_method", "width")
        sw = settings.get("scale_width", "").strip()
        sh = settings.get("scale_height", "").strip()
        try:
            if method == "width" and sw:
                target_w = int(float(sw))
                target_h = int(round(target_w * h / w))
                w, h = target_w, target_h
            elif method == "height" and sh:
                target_h = int(float(sh))
                target_w = int(round(target_h * w / h))
                w, h = target_w, target_h
            elif method == "exact" and sw and sh:
                w, h = int(float(sw)), int(float(sh))
        except:
            pass
    return w, h


def _blend_move_exprs(mode, move_settings=None, sw="w", sh="h"):
    """为 blend 动态区域构造【双轴】轨迹表达式（overlay 版 W/H/w/h；crop 版由调用方 W/H→iw/ih）。

    ⚠️ 2026-08-24 实测纠错：crop 的 x/y 表达式【支持】逗号函数与状态变量
    （min/max/mod/lt/gte/st/ld/分号全可用，ffmpeg 8.1 六项实验全过）——旧认知
    "crop 不支持逗号函数"是当年实测误判。因此 h/v/diamond/corners 所有轨迹均可
    blend 动态跟随（"走到哪混到哪"），不再有仅 h/v 的限制。
    表达式基于 build_move_xy_expr（含 min/max 夹紧到画布内），sw/sh 传区域尺寸数字。
    返回 (x_expr, y_expr)；mode 不支持返回 (None, None)。"""
    ms = move_settings or {}
    if mode not in ("h", "v", "diamond", "corners"):
        return None, None
    x0 = str(ms.get("overlay_x", "0") or "0")
    y0 = str(ms.get("overlay_y", "0") or "0")
    return build_move_xy_expr(mode, x0, y0, ms, sw=str(sw), sh=str(sh))


def _blend_crop_exprs(x_expr, y_expr, bw, bh):
    """动态轨迹 blend 的 crop 版表达式：W/H→iw/ih + 独立 w/h→区域尺寸数字。
    crop 表达式环境只有 iw/ih（无 W/H/w/h 变量）；overlay_x/y 基准可能含 "W-w-10" 等。
    正则 \bw\b/\bh\b 只匹配独立变量，不会误伤 iw/ih 里的 w/h（前接 i 非单词边界）。
    返回 (x_crop, y_crop)。正式命令 / 合并页预览 / 转换页预览 三处共用，勿复制粘贴。"""
    def _conv(e):
        e = e.replace("W", "iw").replace("H", "ih")
        e = re.sub(r"\bw\b", str(bw), e)
        e = re.sub(r"\bh\b", str(bh), e)
        return e
    return _conv(x_expr), _conv(y_expr)


def _blend_region_size(w, h, rotated):
    """blend 叠加盒尺寸：旋转时用对角线 d=round(hypot(w,h))（需求2：不切旋转内容），
    非旋转用渲染尺寸。**逐值等于正式命令的 `_overlay_sub_size`** ⇒ 三处共用，勿复制粘贴。

    ⚠️ 这里**不做偶数化、不做画布 clamp**（2026-10-08 修正）：偶数对齐与越界裁剪由下游
    统一收尾 —— `_blend_region_bbox` / `_blend_static_geometry` 各自都会「夹进画布 + 只缩不增
    的偶数对齐」。此前本函数先偶数化、调用方再 clamp 到画布，而这两个动作只属于 **crop 区域**，
    却被拿来算**中心对齐偏移 (box-content)/2** → 盒被夹小多少，落位就偏多少：
    d=734 > 画布高 720 时偏移按 180 算（应 187）、区域高 500（应 506）（用户 2026-10-08 复核）。
    正式命令一律用未 clamp / 未偶数化的 `sw,sh`，故本函数必须同口径。"""
    if rotated:
        d = int(round(((w * w + h * h) ** 0.5)))
        bw = bh = d
    else:
        bw, bh = int(w), int(h)
    return max(2, bw), max(2, bh)


def _content_box_expr(expr, w, h):
    """把位置表达式里的独立 \bw\b/\bh\b 替换为内容盒尺寸数字。

    旋转时 overlay 的 w/h 变量 = 旋转画布 d×d（overlay 输入尺寸），而 overlay_x/y
    （如 "W-w-10"）的语义是**内容盒**（未旋转 w×h）→ 求值前必须替换，否则内容整体
    偏移 (d-w)/2。正则 \bw\b 不会误伤 iw/ih/ow/oh 里的 w/h（前接 i/o 非单词边界）。
    与 _blend_crop_exprs 的 _conv 同一策略，勿复制粘贴。"""
    e = re.sub(r"\bw\b", str(w), str(expr))
    e = re.sub(r"\bh\b", str(h), e)
    return e


def rotate_box_size(w, h, stages=1):
    """连续 n 道 rotate(ow/oh=hypot(iw,ih)) 之后的包装盒尺寸（正方形，逐级 √2 放大）。

    ⚠️ 必须按「实际挂了几道 rotate」求，不能一律按一道 hypot(w,h) 算：
    第二道 rotate 的输入已是第一道的输出 d1×d1 → 输出 d2=hypot(d1,d1)=d1*√2。
    实测（ffmpeg，内容 400x300）：一道 500x500，两道 707x707 —— 按一道补偿会少补
    (d2-d1)/2 ≈ 103px，内容整体偏右下（预览与导出同错，但用户看到的是「位置不对」）。
    触发场景：文字水印「静态角 rotate≠0 + 自旋转/spin 或列表自旋转」= 两道
    （图片/视频水印把三种角度合并进**单道** rotate，不受影响）。
    """
    bw, bh = float(w), float(h)
    for _unused in range(max(0, int(stages))):
        bw = bh = (bw * bw + bh * bh) ** 0.5
    return bw, bh


def _content_box_shift(content_w, content_h, box_w, box_h):
    """旋转中心对齐偏移：内容盒（未旋转 w×h）→ 叠加盒（旋转画布 d×d 或 clamp 后区域）
    的定位偏移。叠加盒与内容盒中心重合 → 叠加盒左上角 = 内容盒左上角 - (box-w)/2。
    非旋转时 box=内容盒 → 返回 (0,0)。"""
    return (box_w - content_w) / 2.0, (box_h - content_h) / 2.0


# ============== 列表轨迹 blend 的「静态包围盒」纯几何（2026-10-07） ==============
# 背景：旧模型用 crop 从主视频裁一个**小窗口**再与子视频 blend，而 crop 的 w/h 只在
# init 求值（实测铁律，见 ffmpeg-notes.md）⇒ 窗口尺寸无法逐帧跟随缩放 z(t) —— 这就是
# 用户痛点「独立出来的（blend）在列表轨迹上的缩放会报错」。
# 新模型（与 Shotcut/Cairo bounded blend 同语义，实证见 research/blend-isolation/README.md）：
#   隔离改由「上层 α」负责 —— 子视频先铺进一张**静态**包围盒 canvas（矩形外 α=0），
#   再与主视频的同矩形做 blend，最后整体贴回。窗口一旦静态，缩放/旋转/轨迹全部自由。
# 本组函数只算「这张静态包围盒」的几何，纯 Python、不碰 ffmpeg 表达式、不碰 Tk。
# ⚠️ 量化口径必须与 FFmpegBatchGUI._blend_static_geometry **逐值一致**（见 _blend_region_bbox），
#    否则「无轨迹/无缩放」退化时新旧两路不再等价 ⇒ 静止态回归。
_BLEND_WP_HIDE = -100000.0


def _blend_wp_place_rects(waypoints, box_w, box_h, off_x=0.0, off_y=0.0):
    """列表轨迹 → 各采样时刻的「叠加盒占位矩形」列表 [(x0, y0, x1, y1), ...]（浮点）。

    waypoints 结构与 build_waypoint_expr / write_waypoint_sendcmd_file 完全一致
    （xa/ya/xb/yb/sa/sb/oa/ob/mode/start/dur/end_action），字段缺失容错靠 _wp_num。

    ⚠️ **只采样段端点**：段内 x/y 与 zoom 都是线性插值（与 build_waypoint_expr 同款）
    ⇒ 位置与倍率的极值必落在端点 ⇒ O(段数) 而非 O(帧数)，长列表也不炸。

    剔除规则（不剔除会被 crop「必须落在画布内」的约束反噬，把 bbox 顶成整幅画布）：
    - x 或 y = HIDE(-100000) 的隐藏位（显示前 / end_action=hide 之后 / 隐藏段）不参与并集；
    - 首个 end_action in (hide, freeze) 之后的段不再可视（hide 已移出画面、freeze 停在
      其 b 端 —— b 端已由前面的点滴进集合，丢弃后面的段不会漏）。
    ⚠️ 段「时间」换算（trim/speed）**不影响**位置集合，故不在此做 —— 它只影响段的起止
       时刻，而本函数只取端点坐标。

    off_x/off_y：叠加盒相对内容盒的中心对齐偏移（= _content_box_shift 的返回值），
    非旋转时为 (0,0)。左上角 = (x - z·off_x, y - z·off_y)、尺寸 = (box_w·z, box_h·z)
    —— 与 _pip_overlay_xy「旋转偏移随 z(t) 同乘」严格同口径。

    返回 [] = 全程不可见 ⇒ 调用方跳过混合（保持主画面）。
    """
    wps = [w for w in (waypoints or []) if isinstance(w, dict)]
    if not wps:
        return []

    def _za(w):
        _v = _wp_num(w, "sa", 1.0)
        return _v if _v > 0 else 0.01

    def _zb(w):
        _v = _wp_num(w, "sb", 1.0)
        return _v if _v > 0 else 0.01

    # 终点行（UI 限制只能在最后一行）单独处理，其余都是独立段
    end_row = None
    segs = []
    for w in wps:
        if (w.get("mode") or "move") == "end":
            if end_row is None:
                end_row = w
        else:
            segs.append(w)

    # 独立终止点：首个 end_action != keep 的段（之后的段不再可视）
    cut_t = None
    for s in segs:
        if (s.get("end_action") or "keep") in ("hide", "freeze"):
            _d0 = _wp_num(s, "dur", 1.0)
            if _d0 <= 0:
                _d0 = 1.0
            cut_t = _wp_num(s, "start") + _d0
            break
    valid = [s for s in segs if cut_t is None or _wp_num(s, "start") < cut_t - 1e-9]

    pts = []                                    # [(x, y, z)]
    if valid:
        for s in valid:
            _pa = (_wp_num(s, "xa"), _wp_num(s, "ya"), _za(s))
            _pb = (_wp_num(s, "xb"), _wp_num(s, "yb"), _zb(s))
            pts.append(_pa)
            # 静止段（a 端 == b 端，含倍率）只留一份：不影响并集，省一半无意义矩形
            if any(abs(_pa[k] - _pb[k]) > 1e-9 for k in range(3)):
                pts.append(_pb)
        # 尾部：cut 优先（已在 b 端）；无 cut 且有终点行 → 停在终点行坐标
        if cut_t is None and end_row is not None:
            pts.append((_wp_num(end_row, "xa"), _wp_num(end_row, "ya"), _za(end_row)))
    elif end_row is not None:
        # 只有终点行（无任何段）：全程静态停在终点坐标（与 build_waypoint_expr 同款）
        pts.append((_wp_num(end_row, "xa"), _wp_num(end_row, "ya"), _za(end_row)))

    _bw = float(box_w)
    _bh = float(box_h)
    rects = []
    for _x, _y, _z in pts:
        if _x <= _BLEND_WP_HIDE or _y <= _BLEND_WP_HIDE:
            continue
        _x0 = _x - _z * float(off_x)
        _y0 = _y - _z * float(off_y)
        rects.append((_x0, _y0, _x0 + _bw * _z, _y0 + _bh * _z))
    return rects


def _blend_move_envelope(mode, canvas_w, canvas_h, box_w, box_h, base_x=None, base_y=None):
    """表达式轨迹（h/v/diamond/corners）的运动包络矩形 [(x0,y0,x1,y1), ...]（保守上界）。

    这些模式**没有 zoom**（列表缩放只来自 waypoints），所以尺寸恒定；只要把运动走过的
    位置范围框出来即可。与 build_move_xy_expr 的形态一致：
    - h：x 遍历 0→W-sw（钳在画布内），y 恒为 base_y；
    - v：y 遍历 0→H-sh，x 恒为 base_x；
    - diamond / corners：**保守**取全画布可走范围（不解析具体顶点网格与边距表达式）。
    ⚠️ base_x/base_y 由调用方先行求值（含 W/H/w/h 的表达式走 safe_eval_expr）；
       传 None 表示「未知」→ 该轴退化为整条画布范围（安全但面积变大）。
    """
    _mw = int(canvas_w)
    _mh = int(canvas_h)
    _bw = float(box_w)
    _bh = float(box_h)
    if _mw <= 0 or _mh <= 0 or _bw <= 0 or _bh <= 0:
        return []
    _wx = max(0, _mw - _bw)                     # x 可达上限（内容右沿贴画布右沿）
    _hy = max(0, _mh - _bh)
    if mode == "h":
        _y = float(base_y) if base_y is not None else 0.0
        return [(0.0, _y, _wx + _bw, _y + _bh)]
    if mode == "v":
        _x = float(base_x) if base_x is not None else 0.0
        return [(_x, 0.0, _x + _bw, _hy + _bh)]
    if mode in ("diamond", "corners"):
        return [(0.0, 0.0, _wx + _bw, _hy + _bh)]
    return []


def _blend_rect_union(rects):
    """矩形列表 → 外接矩形 (x0, y0, x1, y1)（浮点，未量化）；无有效矩形 → None。

    跳过退化（宽/高 ≤0）与非有限值（NaN/inf —— 航点字段异常时的保护）的矩形；
    浮点安全用 isfinite 先过滤，NaN 进 min/max 会静默污染结果。
    """
    xs0, ys0, xs1, ys1 = [], [], [], []
    for r in (rects or []):
        try:
            x0, y0, x1, y1 = (float(v) for v in r)
        except (TypeError, ValueError):
            continue
        if not all(math.isfinite(v) for v in (x0, y0, x1, y1)):
            continue
        if x1 <= x0 or y1 <= y0:
            continue
        xs0.append(x0)
        ys0.append(y0)
        xs1.append(x1)
        ys1.append(y1)
    if not xs0:
        return None
    return min(xs0), min(ys0), max(xs1), max(ys1)


def _blend_region_bbox(rects, canvas_w, canvas_h):
    """占位矩形列表 → 静态 blend 包围盒 (bx, by, bw, bh)（**整偶、已夹进画布**）。

    None = 无任何有效占位（全程隐藏 / 完全在画布外）⇒ 调用方按现状处理：
    跳过混合（保持主画面），与静态分支「bw/bh<2 时不混合」同语义。

    ⚠️ 量化口径与 FFmpegBatchGUI._blend_static_geometry **逐值一致**
    （越界裁剪 → 奇数向下对齐、只缩不增 → 再次夹紧到画布），这是「无轨迹/无缩放/
    不旋转」时新旧两路等价的前提（research/blend-isolation/README.md P2 已实证
    静止态逐字节全等）。**改任一侧都必须两边同改 + 重跑 tests/_test_blend_bbox.py。**
    """
    _u = _blend_rect_union(rects)
    if _u is None:
        return None
    mw, mh = int(canvas_w), int(canvas_h)
    if mw <= 0 or mh <= 0:
        return None
    x0, y0, x1, y1 = _u
    bx = int(math.floor(x0))
    by = int(math.floor(y0))
    if bx < 0:
        bx = 0
    if by < 0:
        by = 0
    bw = int(math.ceil(x1)) - bx
    bh = int(math.ceil(y1)) - by
    # 1) 夹紧到画布（yuv420p 要求 crop 不能越界）
    if bx + bw > mw:
        bw = mw - bx
    if by + bh > mh:
        bh = mh - by
    # 2) 偶数对齐：只缩不增（避免对齐动作把框推回画布外）
    if bx % 2:
        bx -= 1
    if by % 2:
        by -= 1
    if bx < 0:
        bx = 0
    if by < 0:
        by = 0
    if bw % 2:
        bw -= 1
    if bh % 2:
        bh -= 1
    # 3) 对齐后再次夹紧
    if bx + bw > mw:
        bw = mw - bx
    if by + bh > mh:
        bh = mh - by
    if bw < 2 or bh < 2:
        return None
    return bx, by, bw, bh


def _blend_wp_bbox(canvas_w, canvas_h, box_w, box_h, waypoints, off_x=0.0, off_y=0.0):
    """列表轨迹 → 静态 blend 包围盒：_blend_wp_place_rects + _blend_region_bbox 的便利组合。

    返回 (bx, by, bw, bh) 或 None（无有效占位）。
    """
    return _blend_region_bbox(
        _blend_wp_place_rects(waypoints, box_w, box_h, off_x, off_y), canvas_w, canvas_h)


def _blend_place_off_exprs(content_w, content_h, box_w, box_h, wp_res=None):
    """blend 落位 overlay 的「旋转中心对齐偏移」表达式片段 (sx, sy)。

    waypoints 的 xa/ya 是**内容盒中心**基准，而叠加盒（旋转画布 d×d 或 clamp 后区域）
    比内容盒大 → 落位坐标须先减 (box-content)/2，与 _pip_overlay_xy /
    _waypoint_sendcmd_offset_suffix / _blend_wp_place_rects 的 `x - z·off` 严格同口径。

    ⚠️ 有列表缩放时偏移必须**随 z(t) 同乘**（box_w*z 同理，见 _blend_wp_place_rects）：
    z(t) 把叠加盒整体放大，若只减固定 off，缩放越大内容越偏离航点坐标（真机 2026-10-07）。
    无缩放（wp_res 为 None 或 [3] 为 None）时退化为固定偏移，与旧行为逐值一致。

    三个 blend 落位调用点（正式命令 / 图片水印预览 / 实时预览）× 两条路径
    （表达式 x/y、sendcmd 命令值后缀）共用本函数，改一处必查另一处。
    """
    offx, offy = _content_box_shift(content_w, content_h, box_w, box_h)
    if wp_res is not None and wp_res[3] is not None:
        return f"- ({wp_res[3]})*{offx:.6g}", f"- ({wp_res[3]})*{offy:.6g}"
    return f"- {offx:.6g}", f"- {offy:.6g}"


def overlay_rotation_active(settings, wp_rot=None):
    """叠加层（子视频 / 图片水印）是否**真的**产出了 rotate 包装盒（d×d 对角线正方形）。

    ⚠️ 唯一真相源（2026-09-17）：所有「是否旋转」的判定必须调本函数，禁就地手写
    `spin or rotate_angle != 0`。此前 9 处手写判定互相漂移，最严重的一条：
    正式命令的包装盒尺寸 `_overlay_sub_size` 只认 spin/静态角度，**不认列表轨迹旋转**；
    而封装页预览（37100）算了列表轨迹 → 同一套参数「预览已做中心补偿、导出没做」
    → 开角度后预览与导出错开 (d-w)/2、(d-h)/2（对角线越大越明显）。
    判定口径必须与「是否真的 append 了 rotate 滤镜」逐字一致。

    - spin：spin_enabled **且** spin_speed != 0（项目铁律：spin=spin_enabled and spin_speed!=0）
    - 静态角：rotate_angle != 0
    - 列表轨迹：move_mode=="waypoints" 且 build_waypoint_expr 产出了非空角度表达式
    - wp_rot：调用方已算过 build_waypoint_expr 时直接传入（避免重复解析），None=自行判定
    """
    if not settings:
        return False
    _ra = _opt_float(settings.get("rotate_angle", 0) or 0, 0.0)
    if _ra != 0:
        return True
    # ⚠️ 只在「取值失败」时回落 60，绝不能写 `get(...) or 60.0`——
    # 显式的 spin_speed=0 会被 `or` 当成「没填」而变成 60，谓词误判为旋转
    # （项目口径：spin = spin_enabled and spin_speed != 0）。
    _spv = _opt_float(settings.get("spin_speed", 60.0), 60.0)
    if bool(settings.get("spin_enabled", False)) and _spv != 0:
        return True
    if (settings.get("move_mode") or "") == "waypoints":
        if wp_rot is not None:
            return bool(wp_rot)
        try:
            _r = build_waypoint_expr(settings.get("move_waypoints"), spin_speed=_spv)
            return bool(_r is not None and len(_r) > 2 and _r[2] is not None)
        except Exception:
            return False
    return False


def _pipe_scale_abs_coord(expr, factor):
    """管道预览「工作分辨率上限」下，把**原始画面空间**的绝对像素坐标换算到缩小后的空间。

    背景（2026-09-21 用户实测）：上限把帧整体乘 f=上限/帧宽 缩小后，设置里写死的绝对像素
    （简易位置/水印的数字、列表轨迹航点、四角边距）不会跟着变 → 子视频在缩小后的画布里相对
    更靠右下，表现为「主视频与子视频之间很大空隙」。mpv/ffplay 不做降采样，故只在管道预览出现；
    f = 上限/原始宽 → 原始越大偏得越多（用户实测「原始尺寸越大，空隙越大」）。
    含画布/子视频尺寸变量（W/H/w/h 等）或函数名的表达式由 ffmpeg 在图内按**当前（已缩小的）**
    空间求值，不需要也不应再缩放 → 原样返回。factor>=1 时原样返回（零行为变化）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return expr
    if f == 1.0 or expr is None:
        return expr
    s = str(expr).strip()
    if not s or re.search(r"[A-Za-z_]", s):
        return expr
    try:
        return "%g" % (float(s) * f)
    except (ValueError, TypeError):
        return expr


def _pipe_scale_int(expr, factor):
    """`_pipe_scale_abs_coord` 的**取整变体**（几何类像素计数用：delogo/crop/遮罩框）。

    与 `_pipe_scale_abs_coord` 同判据（纯数字才换算、含字母的表达式原样保留），唯一差别是
    结果 `round()` 成整数 —— delogo / crop 的 x/y/w/h 语义是**像素计数**，乘 f 后会是
    66.6667 这类小数（ffmpeg 能接受，但像素边界上应取整，避免亚像素抖动）。
    """
    _r = _pipe_scale_abs_coord(expr, factor)
    if _r is expr or _r is None:
        return _r
    try:
        return str(int(round(float(_r))))
    except (ValueError, TypeError):
        return _r


def _pipe_scale_pos_settings(settings, factor):
    """把定位类设置的**绝对像素坐标**从「原始画面空间」换算到「工作分辨率上限缩小后的空间」。

    覆盖键：overlay_x / overlay_y（简易位置基准；纯数值才换算）、move_margin（四角边距）、
    move_waypoints[].xa / ya / xb / yb（列表轨迹航点，主画面绝对像素）。含画布/子尺寸变量
    （W/H/w/h）的表达式由 ffmpeg 在图内按**当前（已缩小的）空间**求值 → 原样保留。
    factor>=1（含非数值）时**原样返回同一对象**：零拷贝、零行为变化。

    ⚠️ 2026-10-08 修正：航点键原是 `x` / `y` —— 真实键名是 **xa/ya/xb/yb**
    （见 build_waypoint_expr / 轨迹编辑器写入点），故那段循环**从未命中过一次** =
    空操作。后果：主帧宽 > 1280 的管道预览里，列表轨迹的整体绝对坐标没跟着 f 缩 →
    子视频/图片水印/文字水印三处轨迹一律偏右下（1080p、f=0.667 时应 400、实际 600）。
    与「角度」无关，是纯降采样路径的老 bug。

    三处共用（画中画预览子视频 / 转换页图片水印 / 转换页文字水印）——同一换算只留一份实现，
    避免多处漂移。原 dict 不会被修改（f<1 时先浅拷贝）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return settings
    if f == 1.0 or not settings:
        return settings
    out = dict(settings)
    for _k in ("overlay_x", "overlay_y", "move_margin"):
        if _k in out:
            out[_k] = _pipe_scale_abs_coord(out.get(_k), f)
    _wps = out.get("move_waypoints")
    if isinstance(_wps, list) and _wps:
        _sw = []
        for _w in _wps:
            if not isinstance(_w, dict):
                _sw.append(_w)
                continue
            _w2 = dict(_w)
            for _ax in ("xa", "ya", "xb", "yb"):
                if _ax in _w2:
                    _w2[_ax] = _pipe_scale_abs_coord(_w2.get(_ax), f)
            _sw.append(_w2)
        out["move_waypoints"] = _sw
    return out


def _pipe_scale_node_fx(settings, factor):
    """把**一个节点效果项**里的几何类绝对像素坐标换算到管道预览的缩小空间（_pwf）。

    为什么需要（2026-10-16 用户实测第 5 条）：
      · 管道预览对「帧宽 > _PIPE_WORK_MAX_W(1280)」的主帧整体乘 f=上限/帧宽 降采样；
        子视频层 / 组包装盒 / pad 画布 / 水印 / 列表轨迹……**全部**跟着乘 f（各自有换算），
        图里真实产出的每一帧都是缩小后的尺寸。
      · 唯独「节点效果」(self.node_fx) 的**几何参数**是 `_apply_node_fx` 在**图建好之后**
        按原样插进去的（delogo=x:y:w:h / crop / 遮罩形状 / 区域效果框），**从没乘过 f**。
        ⇒ 缩小帧里这些坐标仍按**原始画面**像素解释：相同数值相对画面更靠右/下，
          越界时 ffmpeg 直接拒 delogo（`x+w > 宽` 非法）→ 管道预览永远「正在加载预览」。
          外部播放器路线（mpv/ffplay，pipe_engine=False）不做降采样 ⇒ 看不出问题，
          用户观察到的「实时预览偏得少 / 管道预览偏得多」正是这个 f 差。

    覆盖键（全部是「原始画面空间」的绝对像素；表达式含字母 → `_pipe_scale_abs_coord` 原样保留）：
      · overlay_x / overlay_y / move_margin / move_waypoints[].xa·ya·xb·yb（复用 __pipe_scale_pos_settings）
      · crop_left / crop_top / crop_width / crop_height（裁掉的宽高本身也是绝对像素）
      · blur_items[].x/y/w/h（delogo / 区域效果框）+ blur_items[].waypoints[].xa·ya·xb·yb
      · mask_x / mask_y / mask_w / mask_h（旧单形状回退链）
      · mask_shapes[].x/y/w/h（形状图列表）+ mask_shapes[].waypoints[].xa·ya·xb·yb

    factor>=1（含非数值）或 settings 为空 → 原样返回同一对象（零拷贝、零行为变化）。
    ⚠️ 只对**几何类**键做乘法；`delogo` 的 w/h、crop 的 w/h 都是「尺寸」而非「位置」，
       但两者都是绝对像素，同样要乘 f（位置乘了、尺寸不乘 → 框大小与画面比例不匹配）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return settings
    if f == 1.0 or not settings:
        return settings
    out = _pipe_scale_pos_settings(settings, f)
    # 浅拷贝（_pipe_scale_pos_settings 已保证 f<1 时是新对象；此处再兜一次，防它早返回）
    if out is settings:
        out = dict(settings)
    # 几何类像素取整：delogo / crop / 区域框的 x/y/w/h 都是**像素计数**，乘 f 后会是
    # 66.6667 这类小数（实测 ffmpeg 能接受，但像素语义上应取整，避免边界亚像素抖动）。
    # 只在本函数取整 —— `_pipe_scale_pos_settings`（overlay_x 等）保持既有 `%g` 口径不动。
    _rint = lambda _v: _pipe_scale_int(_v, f)
    for _k in ("crop_left", "crop_top", "crop_width", "crop_height",
               "mask_x", "mask_y", "mask_w", "mask_h"):
        if _k in out:
            out[_k] = _rint(out.get(_k))
    for _lk in ("blur_items", "mask_shapes"):
        _lst = out.get(_lk)
        if not isinstance(_lst, list) or not _lst:
            continue
        _slist = []
        for _it in _lst:
            if not isinstance(_it, dict):
                _slist.append(_it)
                continue
            _it2 = dict(_it)
            for _ax in ("x", "y", "w", "h"):
                if _ax in _it2:
                    _it2[_ax] = _rint(_it2.get(_ax))
            _wps2 = _it2.get("waypoints")
            if isinstance(_wps2, list) and _wps2:
                _sw2 = []
                for _w in _wps2:
                    if not isinstance(_w, dict):
                        _sw2.append(_w)
                        continue
                    _w2 = dict(_w)
                    for _ax in ("xa", "ya", "xb", "yb"):
                        if _ax in _w2:
                            _w2[_ax] = _rint(_w2.get(_ax))
                    _sw2.append(_w2)
                _it2["waypoints"] = _sw2
            _slist.append(_it2)
        out[_lk] = _slist
    return out


def _pipe_scale_node_fx_map(fx, factor):
    """`self.node_fx`（key → **效果列表**）整体换算：逐 key、逐列表项套 `_pipe_scale_node_fx`。

    node_fx[key] 是**效果列表**（老存档可能是裸 dict，由 `node_fx_items` 包成单元素列表）——
    这里沿用同一出口，避免 `dict(node_fx[key])` 那种把列表当映射的炸法。
    列表为空 / None → 该 key 原样保留（不丢 key，_apply_node_fx 仍能按指纹找到它）。
    """
    try:
        f = float(factor)
    except (TypeError, ValueError):
        return fx
    if f == 1.0 or not fx:
        return fx
    out = {}
    for _k, _v in fx.items():
        _items = node_fx_items(_v)
        if not _items:
            out[_k] = _v
            continue
        out[_k] = [_pipe_scale_node_fx(_it, f) for _it in _items]
    return out


# ==================== #5：列表轨迹「未提交航点」注入（2026-10-08） ====================
# 场景：轨迹弹窗开着时改坐标只落在弹窗的 `_wps`（**未提交**）；管道预览的合成图是**打开那一刻**
# 构建好的字符串（`SimplePreviewer._pipe_graph`），每次取帧只重跑 ffmpeg、不重建图 ⇒ 坐标改完
# 当场看不到变化。修法 = 面板「重开这条管道」时把弹窗实时航点一并带下来，图构建时**临时**用
# 它们覆盖目标设置（只影响这一次渲染用的副本，不动页面数据、不影响弹窗「取消」语义）。
#
# ⚠️ 目标身份（2026-10-08 用户实测后改正）：同一张合成图里可能有**多个**带轨迹的目标 —— 封装页
# = 主视频 + 各子视频（各带自己的列表轨迹），文字水印另有自己的一份轨迹。首版按「图里恰好只有
# 一个带轨迹的目标」猜，结果：从**文字水印**轨迹窗开管道预览时，子视频被套上了**文字的**列表
# 轨迹（用户实测「子视频好像套用了文字的列表轨迹」）。故改为**宿主声明身份**（`_wp_target`）：
# 发起轨迹弹窗的一方告诉图构建「这份未提交航点属于哪个目标」，图构建只 patch 那一个
# （见 `_live_wp_target`）。不声明 ⇒ 不注入 = 旧行为 —— 宁可不刷新，也**绝不串味**。
#
# ⚠️ 只在 `extra_kw` 带 `_wp_source` 时生效（只有列表轨迹面板会带）⇒ mpv/ffplay 外部播放器预览、
# 右键实时预览等既有入口行为逐字节不变。


def _live_wp_override(extra_kw):
    """从 extra_kw 取列表轨迹「未提交航点」源（#5）；返回快照 list[dict] 或 None。

    接受 callable（每次现取，重开时拿到最新）或 list。取不到/为空 → None（不注入）。
    """
    if not isinstance(extra_kw, dict):
        return None
    _g = extra_kw.get("_wp_source")
    if _g is None:
        return None
    try:
        _w = _g() if callable(_g) else _g
    except Exception:
        return None
    _out = [dict(x) for x in _w if isinstance(x, dict)] if _w else []
    return _out or None


def _live_wp_target(extra_kw):
    """从 extra_kw 取「这份未提交航点属于哪个目标」（#5 目标身份）；返回 (kind, ident) 或 None。

    由**宿主**（发起轨迹弹窗的一方：OverlayPositionFrame / TextWatermarkDialog）声明；图构建
    只 patch 命中的那一个目标。不声明（None）⇒ 不注入 = 旧行为，宁可不刷新也绝不串味。

      · ("layer", None)     该层自身设置：封装页主视频轨 / 转换页 settings 本身 / 单轨轨设置；
      · ("track", <track>)  封装页某个视频轨（按**对象身份**比较；主视频轨也可用它）；
      · ("wm", None)        settings["watermark"]（转换页图片/视频水印）；
      · ("tw", None)        settings["text_watermark"]（封装页列表为空时的单条兜底）；
      · ("tw", i)           settings["text_watermark_items"][i]。
    """
    if not isinstance(extra_kw, dict):
        return None
    _t = extra_kw.get("_wp_target")
    return _t if isinstance(_t, tuple) and len(_t) == 2 else None


def _wp_mark_status(extra_kw, status):
    """回报「本次图里弹窗未保存航点」的处置结果，供预览窗加标题 / 顶部横幅标记（#3，2026-10-08）。

    status：
      · "live"  图里**确实**用上了弹窗里尚未保存的航点 ⇒ 预览反映的是弹窗当前值、
                不是工程存档值。不加提示，用户很容易以为「工程文件已经改了」。
      · "stale" 有未保存航点但本入口注不进这张图（目标槽位不存在 / 逐段构建无段身份可辨）
                ⇒ 预览用的是**存档值**。不加提示，用户会以为「改完已经生效了」。
    由**图构建阶段**（`_preview_with_settings` / `merge_preview_pip_live`）回报，
    由 `_open_pipe_time_preview` **取走并 pop**（不摘会作为未知 kwargs 传进 show_time_picker）。
    非 dict / 无 extra_kw（mpv/ffplay、右键实时预览等其余入口）⇒ 空操作，零行为变化。
    """
    if isinstance(extra_kw, dict):
        extra_kw["_wp_status"] = status


def _wp_inject_live(settings, wps):
    """把未提交航点写进**本次构建用**的设置副本（原 dict 不动）。无航点 ⇒ 原样返回同一对象。"""
    if not wps or not isinstance(settings, dict):
        return settings
    _o = dict(settings)
    _o["move_waypoints"] = [dict(x) for x in wps]
    return _o


def _tw_inject_live_wp(settings, target, wps):
    """文字水印槽位的未提交航点注入（返回**构建用副本**，原 settings 不动）。

    `target` = 宿主声明的目标身份（见 `_live_wp_target`）：("tw", None) = 单条 `text_watermark`；
    ("tw", i) = `text_watermark_items[i]`。非 tw 目标 / 槽位不存在 / 无航点 ⇒ 原样返回同一对象。
    """
    if not wps or not isinstance(settings, dict) or not target:
        return settings
    _kind, ident = target
    if _kind != "tw":
        return settings
    if isinstance(ident, int):
        _items = settings.get("text_watermark_items")
        if not (isinstance(_items, list) and 0 <= ident < len(_items)
                and isinstance(_items[ident], dict)):
            return settings
        _o = dict(settings)
        _o["text_watermark_items"] = [
            _wp_inject_live(_x, wps) if _i == ident else _x for _i, _x in enumerate(_items)]
        return _o
    _tw = settings.get("text_watermark")
    if not isinstance(_tw, dict):
        return settings
    _o = dict(settings)
    _o["text_watermark"] = _wp_inject_live(_tw, wps)
    return _o


def _wp_target_hit(target, track=None, allow_layer=True, any_track=False):
    """宿主声明的轨迹目标 `target` 是否命中**当前正在构建的这一层**（#5；Tier1.1 收敛 @2026-10-08）。

    全工程「身份 → 层命中」的判据**只此一处**。此前在 3 个注入点各写一份 if
    （`_kind in ("layer","track")` / `_kind=="track" and ident is X`），新增一种目标类型要改 3 处、
    且极易漏改（本会话「子视频套用文字轨迹」的串味 bug 正是漏改型）。收成一个原语后，
    新增目标类型 = 改这一个函数。

      track       当前层对应的轨对象（封装页有值；转换页 / 单层入口传 None）
      allow_layer ("layer", ·) 是否算命中本层（封装页主视频层 True；子视频层 False）
      any_track   ("track", ·) 是否**不比对轨身份**就命中本层 —— 单层入口（一张图只有一个层
                  设置，那里的 track 身份必然指向本层）用 True；多层入口（封装页画中画
                  主视频 + 各子视频）用 False，必须按对象身份选层，否则串味。
    """
    if not target:
        return False
    _kind, _ident = target
    if _kind == "layer":
        return bool(allow_layer)
    if _kind == "track":
        if any_track:
            return True
        return track is not None and _ident is track
    return False


def _preview_inject_live_wp(app, settings, extra_kw):
    """`_preview_with_settings` 专用：按宿主声明的**目标身份**把未提交航点注入设置副本。

    本入口服务的图只有「一个主层 + 可选图片水印 / 文字水印子设置」——目标身份直接映射到槽位：
      · ("layer", …) / ("track", …) → settings 自身（转换页 settings / 封装页单轨该轨 enc_settings，
        合并页单轨兜底正是把该轨设置当单文件喂本函数）；
      · ("wm", None) → `settings["watermark"]`；
      · ("tw", …) → `settings["text_watermark"]` / `["text_watermark_items"][i]`（_tw_inject_live_wp）。
    未注入（无源 / 无身份 / 槽位不存在）时**返回入参同一对象**（调用方可比身份判断是否生效）；
    槽位明确声明了却找不到时留一行日志（不静默，便于用户分辨「没刷新」还是「没接对」）。
    """
    _lw = _live_wp_override(extra_kw)
    _tg = _live_wp_target(extra_kw)
    if not _lw or _tg is None or not isinstance(settings, dict):
        return settings
    _kind, _ident = _tg
    # 本入口的图只有「一个层设置」⇒ 层族身份（layer/track）一律落到它自身（any_track=True，
    # 因为这里的 track 身份必然指向本层，无需比对）。判据统一在 _wp_target_hit。
    if _wp_target_hit(_tg, any_track=True):
        return _wp_inject_live(settings, _lw)
    if _kind == "wm":
        _wm = settings.get("watermark")
        if isinstance(_wm, dict):
            _o = dict(settings)
            _o["watermark"] = _wp_inject_live(_wm, _lw)
            return _o
    elif _kind == "tw":
        _out = _tw_inject_live_wp(settings, _tg, _lw)
        if _out is not settings:
            return _out
    with suppress(Exception):
        app._append_info_ui(
            _("[时间预览] 本次未保存的坐标没有对应到这张图里的轨迹目标，故未生效"
            "（保存后重开预览即可）"))
    return settings


def _tw_wp_target(dlg):
    """文字水印宿主的 #5 目标身份（`_live_wp_target` 的 ("tw", …) 分支）。

    图构建里文字水印有**两种形态**，必须与 `_apply_merge_text_watermark` / `get_current_settings`
    的实际产出对齐（否则身份写错 = 不刷新，写偏 = 串味）：
      · `text_watermark_items[i]` —— 列表情形（封装页 `_merge_tw` / 转换页 `app.text_watermark_items`）；
      · `text_watermark`         —— 封装页**列表为空**时的单条兜底。
    ⚠️ 转换页 `get_current_settings` **恒**产出 `text_watermark_items`（空列表或 [单条]）⇒ 下标 0；
    封装页只有列表非空时图里才有 items，否则只有单条 ⇒ None。
    列表情形按**对象身份**在弹窗 items 里求下标；弹窗内已增删项（长度与容器不一致）⇒ 返回 None
    （宁可不刷新，也不把 A 项的坐标写进 B 项）。
    """
    _c = getattr(dlg, "items_container", None)
    try:
        _citems = _c.get("text_watermark_items") if isinstance(_c, dict) \
            else getattr(_c, "text_watermark_items", None)
    except Exception:
        _citems = None
    _citems = _citems or []
    if not _citems:
        return ("tw", None) if isinstance(_c, dict) else ("tw", 0)
    _items = getattr(dlg, "items", None) or []
    if len(_items) != len(_citems):
        return None
    _cur = getattr(dlg, "settings", None)
    for _i, _x in enumerate(_items):
        if _x is _cur:
            return ("tw", _i)
    return None


def _pad_canvas_geometry(main_settings) -> Optional[Tuple[int, int, str, str]]:
    """提取 pad 画布几何：返回 (pad_w, pad_h, offset_x, offset_y) 或 None（未启用/无效）。
    正式命令 + 转换页预览 + 合并页预览三处共用，避免 pad 判定分叉。"""
    if not main_settings.get("pad_enabled", False):
        return None
    pw = (main_settings.get("pad_width", "") or "").strip()
    ph = (main_settings.get("pad_height", "") or "").strip()
    if not pw or not ph:
        return None
    try:
        cw, ch = int(float(pw)), int(float(ph))
        if cw <= 0 or ch <= 0:
            return None
    except (ValueError, TypeError):
        return None
    ox = (main_settings.get("offset_x", "0") or "0").strip() or "0"
    oy = (main_settings.get("offset_y", "0") or "0").strip() or "0"
    return cw, ch, ox, oy

# ================== 子进程执行封装 ==================
def run_ffmpeg_command(cmd: List[str], on_output_line: Optional[Callable] = None, timeout: Optional[float] = None) -> Tuple[int, str]:
    """
    执行 FFmpeg 命令，实时输出行。返回 (返回码, 完整stderr文本)
    cmd: 列表形式的命令参数
    """
    full_output = []
    try:
        proc = subprocess.Popen(cmd, shell=False, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=_ffmpeg_spawn_flags())
        for line in proc.stdout:
            full_output.append(line)
            if on_output_line:
                on_output_line(line)
        proc.wait(timeout=timeout)
        return proc.returncode, "".join(full_output)
    except subprocess.TimeoutExpired:
        proc.kill()
        return -1, _("进程超时被终止")
    except Exception as e:
        return -1, str(e)

def ffprobe_json(ffprobe_cmd: str, file_path: str, proc_sink=None) -> Optional[Dict[str, Any]]:
    """调用 ffprobe 获取媒体信息的 JSON 格式。
    proc_sink（可选）：list 容器，创建的 Popen 会追加进去，供调用方 close() 时 kill
    （大文件元数据读取可能比窗口寿命长，不杀会残留 ffprobe 进程）。"""
    if not ffprobe_cmd or not os.path.exists(file_path):
        return None
    cmd = [ffprobe_cmd, "-v", "error", "-print_format", "json", "-show_streams", file_path]
    try:
        flags = _ffmpeg_spawn_flags()
        if proc_sink is None:
            res = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8', errors='replace', creationflags=flags, timeout=10)
            if res.returncode != 0:
                return None
            data = json.loads(res.stdout)
        else:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    creationflags=flags)
            proc_sink.append(proc)
            try:
                out, _err = proc.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                with suppress(Exception):
                    proc.kill()
                with suppress(Exception):
                    proc.communicate()
                return None
            if proc.returncode != 0:
                return None
            data = json.loads(out.decode("utf-8", errors="replace"))
        if "streams" not in data:
            return None
        return data
    except:
        return None

# ================== 入队预检规则 ==================
def _precheck_parse_fps(text):
    """解析 "30000/1001" 形式的帧率为 float；无法解析返回 None"""
    try:
        text = (text or "").strip()
        if not text or text in ("0/0", "N/A"):
            return None
        if "/" in text:
            num, den = text.split("/", 1)
            num, den = float(num), float(den)
            if den == 0:
                return None
            return num / den
        return float(text)
    except Exception:
        return None

def precheck_task_rules(probe, settings, output_path):
    """入队预检（纯函数）：基于 ffprobe streams 信息 + 任务设置，返回风险列表 [(级别, 文案)]。
    级别: "bad"(红/⛔ 硬伤) / "warn"(黄/⚠ 兼容性风险) / "info"(仅详情展示，不计数)。
    probe 为 ffprobe_json() 的返回值（None = 探测失败）；本函数不调用 ffprobe、不碰 UI。
    规则口径（2026-09-08 与用户对齐，6+1 条）：
      🔴 opus/flac 音频 copy 进 MP4/MOV（兼容性差；opus 运行时已自动回退 aac）
      🔴 ffprobe 探测失败 / 时长为 0
      🟡 VFR 源 + 视频流复制（r_frame_rate 与 avg_frame_rate 相差 >5%）
      🟡 SAR≠1 且叠加裁剪/缩放（易拉伸变形）
      🟡 源带旋转元数据 + 手动旋转叠加
      🟡 多音轨（默认仅处理第 1 条）
      ⚪ 输出文件已存在（覆盖策略下将覆盖旧文件）"""
    results = []
    if not probe or not isinstance(probe.get("streams"), list):
        return [("bad", _("无法读取媒体信息（ffprobe 失败或文件损坏）"))]

    streams = probe["streams"]
    settings = settings or {}
    vstream = next((s for s in streams if s.get("codec_type") == "video"
                    and s.get("disposition", {}).get("attached_pic", 0) != 1), None)
    astreams = [s for s in streams if s.get("codec_type") == "audio"]
    video_copy = settings.get("encoder", "copy") == "copy"
    audio_copy = settings.get("audio_codec", "copy") == "copy"
    only_audio = bool(settings.get("only_audio", False))

    # 🔴 音频编码器 copy 进 MP4/MOV 的硬伤组合（容器以最终输出扩展名为准）
    container = os.path.splitext(output_path or "")[1].lstrip(".").lower()
    if container in ("mp4", "mov") and audio_copy:
        src_codecs = {(s.get("codec_name") or "").lower() for s in astreams}
        if "opus" in src_codecs:
            results.append(("bad", _("opus 音频 copy 进 MP4/MOV 兼容性差（转换时将自动回退 aac）")))
        if "flac" in src_codecs:
            results.append(("bad", _("flac 音频 copy 进 MP4/MOV，部分播放器不支持")))

    # 🔴 时长为 0（所有流都没有可解析的 duration 时无法判定，不误报，如 mpegts/"N/A"）
    dur_values = []
    for s in streams:
        try:
            dur_values.append(float(s.get("duration")))
        except (TypeError, ValueError):
            pass
    if dur_values and max(dur_values) <= 0:
        results.append(("bad", _("媒体时长为 0，文件可能不完整或损坏")))

    # 🟡 VFR + 视频流复制：流复制不改时间戳，VFR 源在部分播放器可能卡顿/音画不同步
    if vstream and not only_audio and video_copy:
        r_fps = _precheck_parse_fps(vstream.get("r_frame_rate"))
        avg_fps = _precheck_parse_fps(vstream.get("avg_frame_rate"))
        if r_fps and avg_fps and abs(r_fps - avg_fps) / avg_fps > 0.05:
            results.append((
                "warn",
                _("源为可变帧率 VFR（r_frame_rate={0:.2f} avg_frame_rate={1:.2f}），流复制在部分播放器可能卡顿或音画不同步").format(r_fps, avg_fps)
            ))

    # 🟡 非方形像素 SAR≠1 + 裁剪/缩放：crop/scale 按像素数运算，易产生拉伸变形
    if vstream and not only_audio and (settings.get("crop_enabled") or settings.get("scale_enabled")):
        sar = (vstream.get("sample_aspect_ratio") or "").strip()
        if sar and sar not in ("1:1", "0:1", "N/A"):
            results.append(("warn", _("非方形像素 SAR={0}，叠加裁剪/缩放可能引起拉伸变形").format(sar)))

    # 🟡 源旋转元数据 + 手动旋转叠加：两处旋转会叠加，最终方向可能与预期不符
    if vstream and not only_audio and settings.get("rotate_enabled") \
            and settings.get("rotate", "none") != "none":
        src_rot = 0
        for sd in (vstream.get("side_data_list") or []):
            try:
                src_rot = int(float(sd.get("rotation") or 0))
                break
            except (TypeError, ValueError):
                continue
        if src_rot % 360 != 0:
            results.append(("warn", _("源自带旋转元数据 {0}°，又叠加手动旋转，最终方向可能与预期不符").format(src_rot)))

    # 🟡 多音轨：默认仅处理第 1 条（用户已选「全部」模式则不再警告）
    if len(astreams) > 1 and settings.get("audio_track_mode", "first") == "first":
        results.append(("warn", _("{0} 条音轨，默认仅处理第 1 条（其余不保留）").format(len(astreams))))

    # 🟡 仅音频：编码器×容器不兼容（转码时会自动改容器，提前预告避免困惑）
    if only_audio:
        _ac = settings.get("audio_codec", "aac")
        _pref = settings.get("audio_format", "m4a")
        _safe = compatible_audio_container(_ac, _pref)
        if _safe != _pref:
            results.append((
                "warn",
                _("仅音频：容器 «{0}» 与编码器 «{1}» 不兼容，转换时将自动改用 «{2}»").format(_pref, _ac, _safe)
            ))

    # ⚪ 输出已存在（rename 策略下路径已去重，命中即意味着会覆盖）
    if output_path and os.path.exists(output_path):
        results.append(("info", _("输出文件已存在，转换完成后将覆盖旧文件")))

    return results

def _parse_kbps(text):
    """解析 "5000k"/"128k"/"5M"/"128000" 为 kbps（千比特/秒）；无法解析返回 None。
    裸数字按 ffmpeg 语义视为 bps（-b:v 5000000 = 5Mbps）。"""
    try:
        s = str(text or "").strip().lower()
        if not s:
            return None
        if s.endswith("kbps"):
            return float(s[:-4])
        if s.endswith("k"):
            return float(s[:-1])
        if s.endswith("m"):
            return float(s[:-1]) * 1000.0
        if s.endswith("bps"):
            return float(s[:-3]) / 1000.0
        return float(s) / 1000.0
    except (TypeError, ValueError):
        return None

def _human_size(n_bytes):
    """字节数 → 人类可读（SI 单位：1MB=1e6，1GB=1e9）"""
    if n_bytes >= 1e9:
        return f"{n_bytes / 1e9:.2f}GB"
    if n_bytes >= 1e6:
        return f"{n_bytes / 1e6:.0f}MB"
    return f"{max(1, int(n_bytes / 1e3))}KB"

def estimate_output_size_text(settings, probe):
    """大小预估（#4，纯算术）：视频参与编码时仅限码率模式（rate_control_type=bitrate 且
    encoder 非 copy），计视频项（settings["bitrate_video"]，键名与视频面板 get_settings 一致，
    注意不是 "bitrate"——那是轨道级音频 enc_settings 的键）；crf/cq/视频 copy 码率未知，
    整体不预估。only_audio 模式输出纯音频文件，音频项可单独估算。audio_codec 非 copy 计
    音频项（settings["audio_bitrate"]）。时长取 probe 各流可解析 duration 的最大值。
    返回 "约123MB" 形式文本；算不出一律返回 ""（静默不预估）。
    纯算术不含容器开销，误差通常 ±10% 内。"""
    settings = settings or {}
    vb = 0.0
    if not settings.get("only_audio", False):
        if settings.get("encoder", "copy") == "copy":
            return ""  # 视频流复制：无 -b:v 可算，超出码率预估口径
        if settings.get("rate_control_type", "crf") != "bitrate":
            return ""  # crf/cq/global_quality：码率未知，不预估（2026-09-08 定稿）
        vb = _parse_kbps(settings.get("bitrate_video")) or 0.0
        if vb <= 0:
            return ""  # 码率模式下视频项解析失败 → 预估无意义
    ab = 0.0
    if settings.get("audio_codec", "copy") != "copy":
        ab = _parse_kbps(settings.get("audio_bitrate")) or 0.0
    kbps = vb + ab
    if kbps <= 0 or not isinstance(probe, dict):
        return ""
    dur = 0.0
    for s in probe.get("streams") or []:
        try:
            d = float(s.get("duration"))
            if d > dur:
                dur = d
        except (TypeError, ValueError):
            continue
    if dur <= 0:
        return ""
    return _("约") + _human_size(kbps * 1000.0 / 8.0 * dur)

def _deep_scan_decode_errors(ffmpeg_cmd, path, timeout):
    """全解码深扫：`-v error -i x -f null -`，返回去重后的错误行（最多 3 条）。
    只在轻量校验命中疑似后才调用（2026-09-08 与用户对齐的深度档）。"""
    if not ffmpeg_cmd or not os.path.exists(path):
        return []
    cmd = [ffmpeg_cmd, "-v", "error", "-i", path, "-f", "null", "-"]
    try:
        flags = _ffmpeg_spawn_flags()
        res = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8",
                             errors="replace", creationflags=flags, timeout=timeout)
    except subprocess.TimeoutExpired:
        return [_("深度扫描超时（文件过大或解码过慢）")]
    except Exception:
        return []
    lines = []
    for ln in (res.stderr or "").splitlines():
        ln = re.sub(r'^\[[^\]]*\]\s*', '', ln.strip())
        if ln and ln not in lines:
            lines.append(ln)
    return lines[:3]

def verify_output_file(ffmpeg_cmd, ffprobe_cmd, output_path, expected_sec):
    """转后校验（#2，轻量档）：输出文件存在/可解析/时长 vs 预期；
    命中疑似才追加全解码深扫。返回疑似原因列表（空 = 通过）。不碰 UI。
    expected_sec 为执行期记录的预期输出时长（task.total_sec，已含变速/分段）；
    0/None 表示无预期，跳过时长比对。"""
    if not output_path or not os.path.exists(output_path):
        return [_("输出文件缺失（返回码 0 但没有产物）")]
    try:
        if os.path.getsize(output_path) <= 0:
            return [_("输出文件为 0 字节（返回码 0 但没有有效产物）")]
    except OSError:
        return [_("输出文件无法读取")]

    probe = ffprobe_json(ffprobe_cmd, output_path)
    if not probe or not isinstance(probe.get("streams"), list):
        return [_("输出无法解析（ffprobe 失败，可能不是有效媒体文件）")]

    out_dur = 0.0
    for s in probe["streams"]:
        try:
            d = float(s.get("duration"))
            if d > out_dur:
                out_dur = d
        except (TypeError, ValueError):
            continue
    expected = _opt_float(expected_sec or 0, 0.0)
    issues = []
    if expected > 0 and out_dur > 0:
        if out_dur < expected * 0.98:
            issues.append(_('输出时长 {0:.1f}s 低于预期 {1:.1f}s（可能截断）').format(out_dur, expected))
        elif out_dur > expected * 1.10:
            issues.append(_('输出时长 {0:.1f}s 超出预期 {1:.1f}s').format(out_dur, expected))
    if issues:
        timeout = int(min(900, max(90, expected * 3 + 60)))
        errs = _deep_scan_decode_errors(ffmpeg_cmd, output_path, timeout)
        if errs:
            issues.append(_('深度扫描发现解码错误: {0}').format(errs[0])
                          + (_(' 等{0}处').format(len(errs)) if len(errs) > 1 else ""))
        else:
            issues.append(_("时长/元数据异常，深度扫描未发现解码错误"))
    return issues

def detect_crop(ffmpeg_cmd: str, input_file: str, timeout: float = 15) -> Optional[Tuple[int, int, int, int]]:
    """自动检测黑边，返回 (w, h, x, y) 或 None"""
    if not ffmpeg_cmd or not os.path.exists(input_file):
        return None
    cmd = [
        ffmpeg_cmd, "-i", input_file,
        "-t", "5",
        "-vf", "cropdetect=limit=0.1:round=2",
        "-f", "null", "-"
    ]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, encoding='utf-8', errors='replace',
                                creationflags=_ffmpeg_spawn_flags())
        _unused, stderr = proc.communicate(timeout=timeout)
        pattern = re.compile(r'crop=(\d+):(\d+):(\d+):(\d+)')
        matches = pattern.findall(stderr)
        if not matches:
            return None
        w, h, x, y = map(int, matches[-1])
        return w, h, x, y
    except:
        return None

# ================== 播放器预览 ==================
def launch_player(file_path: str, filters: str = "", audio_only: bool = False, volume: int = 10,
                  extra_args: Optional[List[str]] = None,
                  use_mpv: bool = False, mpv_path: str = "mpv", ffplay_path: Optional[str] = None):
    """安全启动播放器预览，列表模式 + 等号参数（兼容 mpv）"""
    file_path = normalize_path(file_path)
    extra_args = extra_args or []

    if audio_only:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-nodisp", "-autoexit", "-volume", str(volume), file_path]
    else:
        if use_mpv:
            player = mpv_path.strip() or "mpv"
            cmd = [player, file_path]
            if filters and filters.strip():
                # 与预览分支一致：mpv 用 lavfi=[...] 解析 libavfilter 滤镜图，不再用 lavfi=graph 或裸 --vf
                cmd.append(f"--vf=lavfi=[{filters}]")
            if extra_args:
                cmd.extend(extra_args)
        else:
            if not ffplay_path:
                return
            cmd = [ffplay_path, "-i", file_path]
            if filters and filters.strip():
                cmd.extend(["-vf", filters])
            cmd.extend(["-volume", str(volume)])
            if extra_args:
                cmd.extend(extra_args)
            if "-window_title" not in cmd:
                cmd.extend(["-window_title", _("预览: {0}").format(os.path.basename(file_path))])

    flags = _ffmpeg_spawn_flags()
    try:
        _p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=flags)
        _register_preview_proc(_p)
    except Exception as e:
        print(_("预览失败: {0}").format(e))

