    def _save_cmd_templates(self):
        """保存命令模板到 JSON 文件（覆盖写入）"""
        os.makedirs(os.path.dirname(self.cmd_templates_path), exist_ok=True)
        try:
            with open(self.cmd_templates_path, 'w', encoding='utf-8') as f:
                json.dump(self.cmd_templates, f, indent=4, ensure_ascii=False)
        except Exception as e:
            self._append_info_ui(_("保存快速命令模板失败: {0}").format(e))
    
    def _refresh_cmd_preset_list(self):
        """刷新命令预设下拉列表"""
        if hasattr(self, 'cmd_preset_combo'):
            names = list(self.cmd_templates.keys())
            self.cmd_preset_combo['values'] = names
            if names:
                self.cmd_preset_var.set(names[0])
            else:
                self.cmd_preset_var.set("")



    def _add_hwaccel_params(self, cmd_list: List[str], settings: dict):
        """添加硬件解码相关参数（若启用），以及滤镜硬件加速的设备初始化。"""
        # 滤镜硬件加速：设备初始化（单卡留空即可；多卡/必须指定设备时填「设备」框）
        api = settings.get("hw_filter_mode", "cpu")
        if api in ("cuda", "qsv", "vaapi"):
            device = (settings.get("hw_filter_device") or "").strip()
            if api == "cuda":
                # NVIDIA 单卡无需指定；多 GPU 填 GPU 编号（0/1）→ cuda=cu:0
                init_val = f"cuda=cu:{device}" if device else "cuda=cu"
            elif api == "qsv":
                # QSV 核显/单卡固定用 qsv=hw（FFmpeg 自动选平台设备，不需要也不该写数字）。
                # extra_hw_frames=64 必须在这里指定（Intel 官方推荐），不能放到 hwupload=derive_device=qsv 后面。
                # 多 GPU / 需指定时填 child_device 语法：
                #   Windows 填 DirectX 适配器号（如 1）→ qsv=hw,child_device=1
                #   Linux   填 DRM 节点（如 /dev/dri/renderD128）→ qsv=hw,child_device=/dev/dri/renderD128
                init_val = f"qsv=hw,child_device={device},extra_hw_frames=64" if device else "qsv=hw,extra_hw_frames=64"
            else:  # vaapi
                if not device:
                    init_val = "vaapi=amd"
                elif device.startswith("vaapi:") or device.startswith("amd:"):
                    init_val = f"vaapi={device}"
                else:
                    init_val = f"vaapi=amd:{device}"
            cmd_list.extend(["-init_hw_device", init_val])
        if not settings.get("hwaccel_enabled", False):
            return
        # settings 链已统一存命令值（get_settings 经 _hwaccel_disp_to_cmd），
        # 此处必须用同一转换兜底：直接 DECODER_MAP.get(命令值) 恒 miss（键是中文显示值）
        # → 硬解参数永不添加（2026-09-07 修复，base 19032 与 base 存储格式配对故无此问题）。
        # _hwaccel_disp_to_cmd 同时兼容：命令值直通 / 新显示值 / 旧预设中文显示值（DECODER_MAP 兜底）。
        decoder_key = _hwaccel_disp_to_cmd(settings.get("hwaccel_decoder", "none"))
        if decoder_key == "none":
            return

        # 通用硬件加速（专用解码器 cuvid/qsv/amf 已移出下拉，统一用 -hwaccel + 原生解码器）
        if decoder_key in ("cuda", "qsv", "vaapi", "amf", "videotoolbox"):
            if decoder_key == "cuda":
                cmd_list.extend(["-hwaccel", "cuda", "-hwaccel_output_format", "cuda"])
            elif decoder_key == "amf":  # AMD 通用
                cmd_list.extend(["-hwaccel", "amf", "-hwaccel_output_format", "amf"])
            elif decoder_key == "qsv":
                cmd_list.extend(["-hwaccel", "qsv", "-hwaccel_output_format", "qsv"])
            elif decoder_key == "vaapi":
                cmd_list.extend(["-hwaccel", "vaapi", "-hwaccel_output_format", "vaapi"])
            elif decoder_key == "videotoolbox":
                cmd_list.extend(["-hwaccel", "videotoolbox"])

    def _add_trim_params(self, cmd_list: List[str], settings: dict):
        """从设置字典中添加截取参数（-ss, -to）到命令列表"""
        if settings.get("trim_enabled", False):
            start = settings.get("trim_start", "").strip()
            end = settings.get("trim_end", "").strip()
            if start:
                cmd_list.extend(["-ss", start])
            if end:
                cmd_list.extend(["-to", end])


    def _enforce_reencode_for_precise_trim(self, settings: dict, only_audio: bool = False):
        """精准模式下强制重新编码"""
        if settings.get("precise_trim", False) and not only_audio:
            if settings.get("encoder") == "copy":
                settings["encoder"] = "libx265"
                self._append_info_ui(_("精准截取模式下，编码器不能为 copy，已自动改为 libx265。"))

    def _calculate_trim_duration(self, settings: dict, input_path: str) -> Tuple[Optional[float], Optional[float]]:
        """
        根据设置计算精准截取的起始时间（start_sec）和输出时长（duration）。
        :param settings: 设置字典（需包含 trim_start, trim_end, precise_trim）
        :param input_path: 输入文件路径（用于获取总时长）
        :return: (start_sec, duration)，若无法计算则对应为 None
        """
        if not settings.get("trim_enabled", False):
            return None, None
        start = settings.get("trim_start", "").strip()
        end = settings.get("trim_end", "").strip()
        start_sec = time_to_seconds(start) if start else 0.0
        end_sec = time_to_seconds(end) if end else None
        if start_sec is None:
            return None, None
        duration = None
        total_duration = self._get_media_duration(input_path)
        if end_sec is not None:
            duration = end_sec - start_sec
        elif total_duration is not None:
            duration = total_duration - start_sec
        return start_sec, duration



    def _get_video_pix_fmt(self, file_path: str, stream_index: int = 0) -> Optional[str]:
        """获取视频流的像素格式，优先读解析缓存，失败返回None"""
        info = self._get_cached_stream_info(file_path)
        if info:
            for s in info.get('streams', []):
                if s.get('codec_type') == 'video':
                    pf = s.get('pix_fmt')
                    if pf:
                        return pf
                    break
        return None

    def _pix_fmt_has_alpha(self, pix_fmt: str) -> bool:
        """判断像素格式是否带 alpha（透明）通道，用于决定是否需 format=rgba 保留透明。"""
        if not pix_fmt:
            return False
        pf = pix_fmt.lower()
        # 排除无 alpha 但名字含 'a' 的灰度格式（gray/gray16le 等）
        if pf.startswith("gray"):
            return False
        # 常见带 alpha 的格式均含 'a'：rgba/bgra/argb/abgr/yuva*/gbrap/ya*/ayuv/pal8 等
        return "a" in pf

    def _get_video_framerate(self, file_path: str) -> Optional[float]:
        """获取视频文件的平均帧率（fps），优先读解析缓存，失败返回 None"""
        if not self.ffprobe_cmd or not os.path.exists(file_path):
            return None
        # 优先读解析缓存（拖入文件时已填充）
        info = self._get_cached_stream_info(file_path)
        if info:
            for s in info.get("streams", []):
                if s.get("codec_type") == "video":
                    fr = s.get("avg_frame_rate")
                    if fr:
                        try:
                            num, den = str(fr).split('/')
                            val = float(num) / float(den) if float(den) != 0 else None
                            if val:
                                return val
                        except (ValueError, ZeroDivisionError):
                            pass
                    break
        cmd = [self.ffprobe_cmd, "-v", "error", "-select_streams", "v:0",
               "-show_entries", "stream=avg_frame_rate", "-of", "default=noprint_wrappers=1:nokey=1", file_path]
        try:
            flags = _ffmpeg_spawn_flags()
            result = subprocess.run(cmd, capture_output=True, text=True,
                                    timeout=self.ffprobe_timeout.get(), creationflags=flags)
            if result.returncode == 0 and result.stdout.strip():
                num, den = result.stdout.strip().split('/')
                return float(num) / float(den) if float(den) != 0 else None
        except:
            pass
        return None

    def _get_media_duration(self, file_path, frame_align_fps=None):
        """获取媒体文件时长（秒），带缓存，失败返回 None

        frame_align_fps：给定时把时长向下对齐到该帧率的整帧格（floor 到 1/fps）。
        画中画供帧窗口用——format duration 是容器时长（常被音频流撑长 8~19ms），
        不对齐会让窗口比视频真实帧覆盖多 1 帧 → 交界处 loop 回放闪第一帧 /
        eof_action=pass 透出 tpad 黑底。floor 而非 round：宁可窗口短半帧，不可多一帧。
        """
        # 虚拟颜色源：时长直接由哨兵字符串解析（无需探测文件）
        if _is_virtual_source(file_path):
            # color: 返回 (hex8, w, h, dur)；gen: 返回 (type, w, h, dur) —— 索引同构
            _p = _parse_color_source(file_path) or _parse_gen_source(file_path)
            return float(_p[3]) if _p else None
        if not file_path or not os.path.exists(file_path):
            return None
        # 获取文件修改时间作为缓存键的一部分
        try:
            mtime = os.path.getmtime(file_path)
        except OSError:
            mtime = None
        cache_key = (file_path, mtime, frame_align_fps)
        if cache_key in self._duration_cache:
            return self._duration_cache[cache_key]

        # 原有 ffprobe 调用
        if not self.ffprobe_cmd:
            return None
        cmd = [self.ffprobe_cmd, "-v", "error", "-show_entries", "format=duration",
               "-of", "default=noprint_wrappers=1:nokey=1", file_path]
        try:
            result = subprocess.run(cmd, capture_output=True, text=True,
                                    timeout=self.ffprobe_timeout.get(),
                                    creationflags=_ffmpeg_spawn_flags())
            if result.returncode == 0 and result.stdout.strip():
                duration = float(result.stdout.strip())
                if frame_align_fps and frame_align_fps > 0 and duration > 0:
                    duration = int(duration * frame_align_fps + 1e-4) / frame_align_fps
                    # ⚠️ +1e-4 浮点容差（2026-09-26）：841 帧 @30fps 素材 ffprobe 给
                    # 28.033333（6 位小数），×30 = 840.99999 → 裸 int() 砍成 840 帧 = 28.0 整，
                    # 「转场对齐/一键设置开始」跟着填出 27/28 整值（用户观感「省略小数点」，
                    # 实为最后一帧被丢）。ffprobe 截断误差 ≤5e-7s → ×fps（≤120）= 6e-5，
                    # 容差取 1e-4（0.1ms，帧格 33ms 的 1/300）恰好放行；真实半帧位置
                    # （x.5）与「宁短勿长」防交界闪帧的初衷不变。
                self._duration_cache[cache_key] = duration
                return duration
        except:
            pass
        return None
    
    
    def _get_video_dimensions_cached(self, file_path):
        """获取视频原始宽高（不考虑旋转），带缓存"""
        # 虚拟颜色源：宽高直接由哨兵给出（不出 real 文件）—— 与 _cached_video_dimensions 同口径。
        # 2026-10-09：此前只 _cached_video_dimensions 处理了颜色源，本函数漏了 ⇒ 画中画预览
        # 的主视频尺寸回退 1280x720，颜色 1080x1920 被当 1280x720 布局（缩放/子视频虚拟框全错位）。
        if _is_virtual_source(file_path):
            # color: 返回 (hex8, w, h, dur)；gen: 返回 (type, w, h, dur) —— 索引同构
            _pc = _parse_color_source(file_path) or _parse_gen_source(file_path)
            return (_pc[1], _pc[2]) if _pc else (None, None)
        if not file_path or not os.path.exists(file_path):
            return None, None
        try:
            mtime = os.path.getmtime(file_path)
        except OSError:
            mtime = None
        cache_key = (file_path, mtime)
        if cache_key in self._dimension_cache:
            return self._dimension_cache[cache_key]
        
        w, h = get_video_dimensions(self.ffprobe_cmd, file_path)
        if w is not None and h is not None:
            self._dimension_cache[cache_key] = (w, h)
        return w, h

    def _get_video_size_chain(self, track):
        """
        获取视频轨道的尺寸变化链（原始 → 裁剪 → 旋转 → 缩放）。
        返回一个字符串列表，每个元素如 "1920x1080" 或 "裁剪 960x540"。
        若无法获取原始尺寸，返回 None。
        """
        orig_w, orig_h = self._get_video_dimensions_cached(track.file_path)
        if orig_w is None or orig_h is None:
            return None
    
        steps = []
        steps.append(f"{orig_w}x{orig_h}")
        w, h = orig_w, orig_h
    
        # ----- 裁剪 -----
        if track.enc_settings.get("crop_enabled", False):
            crop_w = track.enc_settings.get("crop_width", "").strip()
            crop_h = track.enc_settings.get("crop_height", "").strip()
            crop_left = track.enc_settings.get("crop_left", "0").strip()
            crop_top = track.enc_settings.get("crop_top", "0").strip()
            if crop_w and crop_h:
                # 计算表达式，支持 iw/ih
                cw = safe_eval_expr(crop_w, {"iw": orig_w, "ih": orig_h})
                ch = safe_eval_expr(crop_h, {"iw": orig_w, "ih": orig_h})
                if cw and ch and cw > 0 and ch > 0:
                    w, h = cw, ch
                    steps.append(_('裁剪 {0}x{1}').format(w, h))
                else:
                    # 表达式无效，保留原尺寸（但注明裁剪无效）
                    steps.append(_("裁剪(无效)"))
    
        # ----- 旋转（交换宽高） -----
        rotate = track.enc_settings.get("rotate", "none")
        if rotate in ("90", "270"):
            w, h = h, w
            steps.append(_('旋转 {0}x{1}').format(w, h))
    
        # ----- 缩放 -----
        if track.enc_settings.get("scale_enabled", False):
            method = track.enc_settings.get("scale_method", "width")
            sw = track.enc_settings.get("scale_width", "").strip()
            sh = track.enc_settings.get("scale_height", "").strip()
            try:
                if method == "width" and sw:
                    target_w = int(float(sw))
                    target_h = int(round(target_w * h / w))
                    w, h = target_w, target_h
                elif method == "height" and sh:
                    target_h = int(float(sh))
                    target_w = int(round(target_h * w / h))
                    w, h = target_w, target_h
                elif method == "exact" and sw and sh:
                    w, h = int(float(sw)), int(float(sh))
                steps.append(_('缩放 {0}x{1}').format(w, h))
            except (ValueError, ZeroDivisionError):
                steps.append(_("缩放(无效)"))
    
        return steps


    def _build_video_encoding_params(self, cmd_list: List[str], settings: dict) -> List[str]:
        vcodec = settings.get("encoder", "libx265")
        if vcodec == "copy":
            cmd_list.extend(["-c:v", "copy"])
            return cmd_list
    
        strategy = get_encoder_strategy(vcodec)
        cmd_list = strategy.build_params(cmd_list, settings)
        cmd_list = append_video_output_extras(cmd_list, settings)
    
        if settings.get("frame_rate_type") == "custom" and settings.get("frame_rate_custom"):
            cmd_list.extend(["-r", settings['frame_rate_custom']])

        # 为 WebP 动图默认添加无限循环
        if vcodec == "libwebp":
            cmd_list.extend(["-loop", "0"])

        return cmd_list
    
    def _build_audio_encoding_params(self, cmd_list: List[str], settings: dict, input_path: str = None) -> List[str]:
        if not settings.get("audio_enabled", True):
            cmd_list.append("-an")
            return cmd_list
    
        speed_factor = float(settings.get("audio_speed_factor", "1.0"))
        audio_needs_speed = settings.get("audio_speed_enabled", False) and speed_factor != 1.0
        volume = settings.get("volume", 1.0)
        volume_enabled = settings.get("volume_enabled", False)
        audio_needs_volume = volume_enabled and volume != 1.0
    
        acodec = settings.get("audio_codec", "aac")
        audio_filters = []
        if settings.get("hp_enabled"):
            audio_filters.append(f"highpass=f={settings.get('hp_freq', 200)}")
        if settings.get("lp_enabled"):
            audio_filters.append(f"lowpass=f={settings.get('lp_freq', 3000)}")
        if audio_needs_volume:
            audio_filters.append(f"volume={volume:.2f}")
        if audio_needs_speed:
            atempo = build_atempo_chain(speed_factor)
            if atempo:
                audio_filters.append(atempo)

        # 降噪
        if settings.get("denoise_enabled", False):
            if settings.get("denoise_method") == "arnndn":
                audio_filters.append("arnndn")
            else:
                nr = settings.get("denoise_nr", 12)
                nf = settings.get("denoise_nf", -30)
                audio_filters.append(f"afftdn=nr={nr}:nf={nf}")

        # 响度标准化
        if settings.get("loudnorm_enabled", False):
            i = settings.get("loudnorm_i", -23)
            lra = settings.get("loudnorm_lra", 7)
            tp = settings.get("loudnorm_tp", -2)
            audio_filters.append(f"loudnorm=I={i}:LRA={lra}:TP={tp}")

        # 声道 / 单声道
        mode = settings.get("channel_mode", "stereo")
        if mode == "mono":
            audio_filters.append("pan=mono|c0=0.5*c0+0.5*c1")
        elif mode == "left":
            audio_filters.append("pan=mono|c0=c0")
        elif mode == "right":
            audio_filters.append("pan=mono|c0=c1")
        elif mode == "swap":
            audio_filters.append("pan=stereo|c0=c1|c1=c0")

        # 均衡器（EQ）：低/中/高 三段增益
        if settings.get("eq_enabled", False):
            eq_low = _opt_float(settings.get("eq_low", 0) or 0, 0.0)
            eq_mid = _opt_float(settings.get("eq_mid", 0) or 0, 0.0)
            eq_high = _opt_float(settings.get("eq_high", 0) or 0, 0.0)
            if eq_low != 0:
                audio_filters.append(f"bass=g={eq_low:.1f}")
            if eq_mid != 0:
                audio_filters.append(f"equalizer=f=1000:width_type=h:width=200:g={eq_mid:.1f}")
            if eq_high != 0:
                audio_filters.append(f"treble=g={eq_high:.1f}")

        # 淡入淡出
        if settings.get("fade_enabled", False):
            fin = settings.get("fade_in", "")
            fout = settings.get("fade_out", "")
            fin_s = time_to_seconds(fin) if fin else 0.0
            fout_s = time_to_seconds(fout) if fout else 0.0
            if fin_s > 0:
                audio_filters.append(f"afade=t=in:st=0:d={fin_s:.3f}")
            if fout_s > 0:
                total = self._get_media_duration(input_path) if input_path else None
                if total:
                    st = max(0.0, total - fout_s)
                    audio_filters.append(f"afade=t=out:st={st:.3f}:d={fout_s:.3f}")
                else:
                    audio_filters.append(f"afade=t=out:st=0:d={fout_s:.3f}")
    
        # 音频倒放（放在分段之前，确保分段时间基准为最终输出时间线）
        if settings.get('audio_reverse', False):
            audio_filters.append("areverse")

        # ---- 音频分段效果：统一追加在所有音频滤镜最末尾（含 areverse 之后），
        #      时间基准恒为最终输出时间线 t。用户填的源时间线 → 按截取/变速换算 ----
        _seg_ts = 0.0
        if settings.get("trim_enabled", False):
            _seg_ts = time_to_seconds(settings.get("trim_start", "0") or "0")
        _seg_sp = float(settings.get("audio_speed_factor", "1.0"))
        if not settings.get("audio_speed_enabled", False):
            _seg_sp = 1.0
        seg_filters = build_audio_segment_filters(
            settings.get("audio_segments"), _seg_ts, _seg_sp)
        if seg_filters:
            audio_filters.extend(seg_filters)

        # soxr 高质量重采样（对标 HandBrake）：非 auto 采样率时追加到链尾
        _sx = audio_soxr_resample_filter(settings)
        if _sx:
            audio_filters.append(_sx)

        need_reencode = len(audio_filters) > 0
        if need_reencode and acodec == "copy":
            acodec = "aac"
            self._append_info_ui(_("[音频] 由于应用了音频滤镜，编码器自动从 copy 改为 aac"))

        cmd_list.extend(build_audio_encoder_args(acodec, settings, skip_ar=bool(_sx)))

        if audio_filters:
            cmd_list.extend(["-af", ",".join(audio_filters)])

        return cmd_list

    def _apply_audio_trim_and_encode(self, cmd_list: List[str], settings: dict,
                                      input_path: str, start_sec: float, duration: float,
                                      map_audio: bool = False) -> List[str]:
        """
        为音频流应用精准截取（atrim + asetpts）并设置编码参数。
        :param cmd_list: 命令列表
        :param settings: 设置字典（包含音频编码器、比特率、采样率等）
        :param input_path: 音频来源文件路径（用于获取总时长，但这里我们已经传入了 duration，所以不需要）
        :param start_sec: 起始时间（秒）
        :param duration: 截取时长（秒）
        :param map_audio: 是否添加 -map 0:a:0（水印模式需要）
        :return: 修改后的 cmd_list
        """
        if map_audio:
            cmd_list.extend(["-map", "0:a:0"])
    
        # 强制重新编码
        acodec = settings.get("audio_codec", "aac")
        if acodec == "copy":
            acodec = "aac"
            self._append_info_ui(_("音频截取启用，编码器已从 copy 改为 aac"))
    
        # 构建音频滤镜
        af_filters = []
        if start_sec is not None and duration > 0:
            af_filters.append(f"atrim=start={_ffsec(start_sec)}:duration={_ffsec(duration)}")
            af_filters.append("asetpts=PTS-STARTPTS")
    
        # 合并其他音频滤镜（音量、变速等）
        speed_factor = float(settings.get("audio_speed_factor", "1.0"))
        if settings.get("audio_speed_enabled", False) and speed_factor != 1.0:
            atempo = build_atempo_chain(speed_factor)
            if atempo:
                af_filters.append(atempo)
        volume = settings.get("volume", 1.0)
        if settings.get("volume_enabled", False) and volume != 1.0:
            af_filters.append(f"volume={volume:.2f}")

        # 降噪 / 响度 / 声道 / 淡入淡出 / 倒放
        if settings.get("hp_enabled"):
            af_filters.append(f"highpass=f={settings.get('hp_freq', 200)}")
        if settings.get("lp_enabled"):
            af_filters.append(f"lowpass=f={settings.get('lp_freq', 3000)}")
        if settings.get("denoise_enabled", False):
            if settings.get("denoise_method") == "arnndn":
                af_filters.append("arnndn")
            else:
                af_filters.append("afftdn=nr=12:nf=-30")
        if settings.get("loudnorm_enabled", False):
            _ln_i = settings.get("loudnorm_i", -23)
            _ln_lra = settings.get("loudnorm_lra", 7)
            _ln_tp = settings.get("loudnorm_tp", -2)
            af_filters.append(f"loudnorm=I={_ln_i}:LRA={_ln_lra}:TP={_ln_tp}")
        mode = settings.get("channel_mode", "stereo")
        if mode == "mono":
            af_filters.append("pan=mono|c0=0.5*c0+0.5*c1")
        elif mode == "left":
            af_filters.append("pan=mono|c0=c0")
        elif mode == "right":
            af_filters.append("pan=mono|c0=c1")
        elif mode == "swap":
            af_filters.append("pan=stereo|c0=c1|c1=c0")

        # 均衡器（EQ）：低/中/高 三段增益
        if settings.get("eq_enabled", False):
            eq_low = _opt_float(settings.get("eq_low", 0) or 0, 0.0)
            eq_mid = _opt_float(settings.get("eq_mid", 0) or 0, 0.0)
            eq_high = _opt_float(settings.get("eq_high", 0) or 0, 0.0)
            if eq_low != 0:
                af_filters.append(f"bass=g={eq_low:.1f}")
            if eq_mid != 0:
                af_filters.append(f"equalizer=f=1000:width_type=h:width=200:g={eq_mid:.1f}")
            if eq_high != 0:
                af_filters.append(f"treble=g={eq_high:.1f}")

        if settings.get("fade_enabled", False):
            fin = settings.get("fade_in", "")
            fout = settings.get("fade_out", "")
            fin_s = time_to_seconds(fin) if fin else 0.0
            fout_s = time_to_seconds(fout) if fout else 0.0
            if fin_s > 0:
                af_filters.append(f"afade=t=in:st=0:d={fin_s:.3f}")
            if fout_s > 0:
                # 2026-09-13 修复：本函数链首 atrim+asetpts 已把 t 归零（atempo 变速紧随
                # 其后），淡出起点须按「截取后时长（再除变速）」定位；此前用源全时长，
                # 截取后淡出点落在输出之外 → 淡出丢失。未走 atrim 时保持源全时长口径。
                if start_sec is not None and duration > 0:
                    _ad = duration
                    if settings.get("audio_speed_enabled", False):
                        try:
                            _asp = float(settings.get("audio_speed_factor", "1.0") or "1.0")
                            if _asp > 0 and _asp != 1.0:
                                _ad = _ad / _asp
                        except ValueError:
                            pass
                    st = max(0.0, _ad - fout_s)
                    af_filters.append(f"afade=t=out:st={st:.3f}:d={fout_s:.3f}")
                else:
                    total = self._get_media_duration(input_path) if input_path else None
                    if total:
                        st = max(0.0, total - fout_s)
                        af_filters.append(f"afade=t=out:st={st:.3f}:d={fout_s:.3f}")
                    else:
                        af_filters.append(f"afade=t=out:st=0:d={fout_s:.3f}")
        if settings.get('audio_reverse', False):
            af_filters.append("areverse")

        # ---- 音频分段效果：atrim/asetpts/areverse 之后，t=输出时间线 ----
        # 转换页音频跟随主视频截取：atrim=start=start_sec 已把 t 归零，故按 start_sec 换算
        _seg_sp = float(settings.get("audio_speed_factor", "1.0"))
        if not settings.get("audio_speed_enabled", False):
            _seg_sp = 1.0
        seg_filters = build_audio_segment_filters(
            settings.get("audio_segments"), start_sec or 0.0, _seg_sp)
        if seg_filters:
            af_filters.extend(seg_filters)

        # soxr 高质量重采样（对标 HandBrake）：非 auto 采样率时追加到链尾
        _sx = audio_soxr_resample_filter(settings)
        if _sx:
            af_filters.append(_sx)

        if af_filters:
            cmd_list.extend(["-af", ",".join(af_filters)])

        # 编码参数
        cmd_list.extend(build_audio_encoder_args(acodec, settings, skip_ar=bool(_sx)))

        return cmd_list


    def _adapt_sub_settings(self, sub_settings, current_w, current_h, wm_orig_w=None, wm_orig_h=None):
        """
        根据当前视频尺寸，从基准尺寸缩放位置和大小。
        返回新的设置字典（含 base_width/height 和缩放后的像素值）。
        基准尺寸从 sub_settings 中读取，若不存在则用当前尺寸初始化。

        支持表达式（如 W-w-10、iw/2）自动求值为具体数值：
        - scale_width/scale_height 表达式：用 iw/ih（水印原始尺寸）求值
        - overlay_x/overlay_y 表达式：用 W/H（主视频） + w/h（水印渲染后尺寸）求值
        原表达式保存在 _orig_* 键中。
        """
        if not sub_settings:
            return {}
        import copy
        new_settings = copy.deepcopy(sub_settings)
    
        # 获取基准尺寸
        base_w = new_settings.get("base_width")
        base_h = new_settings.get("base_height")
        if base_w is None or base_h is None:
            # 首次设置，用当前尺寸作为基准
            base_w = current_w
            base_h = current_h
            new_settings["base_width"] = base_w
            new_settings["base_height"] = base_h
            return new_settings
    
        # 计算缩放比例
        scale_w = current_w / base_w
        scale_h = current_h / base_h

        # ---- 2.1 先求值 scale_width/scale_height 表达式（需要水印原始尺寸） ----
        for field in ['scale_width', 'scale_height']:
            val = new_settings.get(field, '').strip()
            if not val:
                continue
            try:
                num = float(val)
                # 纯数字，等比缩放
                if field == 'scale_width':
                    new_settings[field] = str(int(round(num * scale_w)))
                else:
                    new_settings[field] = str(int(round(num * scale_h)))
            except ValueError:
                # 表达式，求值（用 iw/ih = 水印原始尺寸）
                if wm_orig_w is not None and wm_orig_h is not None:
                    ctx = {'iw': wm_orig_w, 'ih': wm_orig_h, 'in_w': wm_orig_w, 'in_h': wm_orig_h,
                           'W': current_w, 'H': current_h}
                    result = safe_eval_expr(val, ctx)
                    if result is not None and result > 0:
                        new_settings['_orig_' + field] = val  # 备份原表达式
                        if field == 'scale_width':
                            new_settings[field] = str(int(round(result * scale_w)))
                        else:
                            new_settings[field] = str(int(round(result * scale_h)))

        # ---- 2.2 计算水印渲染后尺寸（用于 overlay 表达式求值） ----
        if wm_orig_w is not None and wm_orig_h is not None:
            rendered_w, rendered_h = compute_rendered_size(wm_orig_w, wm_orig_h, new_settings)
        else:
            rendered_w, rendered_h = 0, 0

        # ---- 2.3 求值 overlay_x/overlay_y 表达式 ----
        for field in ['overlay_x', 'overlay_y']:
            val = new_settings.get(field, '').strip()
            if not val:
                continue
            try:
                num = float(val)
                # 纯数字，等比缩放
                if field == 'overlay_x':
                    new_settings[field] = str(int(round(num * scale_w)))
                else:
                    new_settings[field] = str(int(round(num * scale_h)))
            except ValueError:
                # 表达式，求值（用 W/H = 主视频尺寸，w/h = 水印渲染尺寸）
                ctx = {'W': current_w, 'H': current_h,
                       'main_w': current_w, 'main_h': current_h,
                       'w': rendered_w, 'h': rendered_h,
                       'n': 0, 't': 0}
                result = safe_eval_expr(val, ctx)
                if result is not None:
                    new_settings['_orig_' + field] = val  # 备份原表达式
                    new_settings[field] = str(int(round(result)))

        return new_settings

    def _generate_segment_concat_command(self, input_path: str, output_path: str, settings: dict, verbose=None) -> List[str]:
        """
        生成分段拼接的 FFmpeg 命令，支持仅音频、硬件解码、增强滤镜等。
        视频变速和倒放现在独立处理，不再依赖增强开关。
        音频变速和倒放现为独立控制（音频有自己的「变速」「音频倒放」开关，不再跟随视频设置）。
        """
        segments = settings.get("segments", [])
        if not segments:
            raise ValueError(_("片段列表为空"))
    
        input_path = normalize_path(input_path)
        output_path = normalize_path(output_path)
    
        # 检测仅音频模式
        only_audio = settings.get("only_audio", False)
        disable_audio = not settings.get("audio_enabled", True)
    
        cmd = [self.ffmpeg_cmd, "-y"]

        self._add_hwaccel_params(cmd, settings)
    
        cmd.extend(["-i", input_path])

        # ----- 检测输入文件是否包含音频流（走缓存）-----
        has_input_audio = False
        info = self._get_cached_stream_info(input_path)
        if info:
            has_input_audio = any(s.get("codec_type") == "audio" for s in info.get("streams", []))
    
        # ----- 构建 filter_complex -----
        n = len(segments)
        v_filters = []
        a_filters = []
        _af_has_soxr = False   # a_filters 链内是否真的追加了 soxr（决定是否跳过 -ar）
    
        # 变速和倒放已改为逐段独立控制，不再读取全局设置
        # 见下方 per-segment loop 中的 seg.get("speed") / seg.get("reverse")

        audio_trim_enabled = settings.get("audio_trim_enabled", False)

        for i, seg in enumerate(segments):
            start = time_to_seconds(seg["start"])
            end = time_to_seconds(seg["end"])
            if start is None or end is None:
                raise ValueError(f"片段 {i+1} 时间无效: start={seg['start']}, end={seg['end']}")
            if start >= end:
                raise ValueError(f"片段 {i+1} 开始时间必须小于结束时间")
    
            flip = seg.get("flip", _("无"))
            flip_filter = ""
            if flip == _("水平翻转"):
                flip_filter = ",hflip"
            elif flip == _("垂直翻转"):
                flip_filter = ",vflip"
            elif flip == _("水平+垂直"):
                flip_filter = ",hflip,vflip"

            # 逐段变速和倒放（每个片段独立控制）
            seg_speed_factor = 1.0
            seg_speed_raw = seg.get("speed", "1.0").strip()
            if seg_speed_raw:
                try:
                    seg_speed_factor = float(seg_speed_raw)
                    if seg_speed_factor <= 0:
                        seg_speed_factor = 1.0
                except ValueError:
                    seg_speed_factor = 1.0
            seg_reverse = seg.get("reverse", False)

            # 视频trim（仅非仅音频模式） + 逐段变速/倒放
            if not only_audio:
                seg_video_chain = f"trim=start={_ffsec(start)}:end={_ffsec(end)},setpts=PTS-STARTPTS{flip_filter}"
                if seg_speed_factor != 1.0:
                    seg_video_chain += f",setpts={1.0/seg_speed_factor}*PTS"
                if seg_reverse:
                    seg_video_chain += ",reverse"
                v_filters.append(f"[0:v]{seg_video_chain}[v{i}]")
    
            # 音频trim（除非完全禁用音频 且 源文件有音频；独立截取模式在循环后单独处理）
            if not disable_audio and has_input_audio and not audio_trim_enabled:
                audio_filter_parts = [
                    f"atrim=start={_ffsec(start)}:end={_ffsec(end)}",
                    "asetpts=PTS-STARTPTS"
                ]
                # 逐段音频变速（不再使用全局变速）
                if seg_speed_factor != 1.0:
                    atempo_chain = build_atempo_chain(seg_speed_factor)
                    if atempo_chain:
                        audio_filter_parts.append(atempo_chain)
                # 逐段音频倒放（不再使用全局倒放）
                if seg_reverse:
                    audio_filter_parts.append("areverse")
                # soxr 高质量重采样（对标 HandBrake）：追加到每段链尾
                _sx = audio_soxr_resample_filter(settings)
                if _sx:
                    audio_filter_parts.append(_sx)
                    _af_has_soxr = True
                a_filters.append(f"[0:a]{','.join(audio_filter_parts)}[a{i}]")

        # 音频独立截取：不分段，单段 atrim（独立于视频片段）
        if not disable_audio and has_input_audio and audio_trim_enabled:
            a_start = time_to_seconds(settings.get("audio_trim_start", "0") or "0")
            a_end_str = settings.get("audio_trim_end", "").strip()
            a_end = time_to_seconds(a_end_str) if a_end_str else None

            audio_trim_parts = []
            if a_start is not None and a_end is not None and a_end > a_start:
                audio_trim_parts.append(f"atrim=start={_ffsec(a_start)}:end={_ffsec(a_end)}")
            elif a_start is not None and a_start > 0:
                audio_trim_parts.append(f"atrim=start={_ffsec(a_start)}")
            else:
                audio_trim_parts.append("anull")
            audio_trim_parts.append("asetpts=PTS-STARTPTS")

            # 全局音频滤镜（音量 / 变速 / 倒放 / EQ / 降噪 / 响度 / 声道 / 淡入淡出）
            speed_factor = float(settings.get("audio_speed_factor", "1.0"))
            if settings.get("audio_speed_enabled", False) and speed_factor != 1.0:
                atempo_chain = build_atempo_chain(speed_factor)
                if atempo_chain:
                    audio_trim_parts.append(atempo_chain)
            volume_val = settings.get("volume", 1.0)
            if settings.get("volume_enabled", False) and volume_val != 1.0:
                audio_trim_parts.append(f"volume={volume_val:.2f}")
            if settings.get("audio_reverse", False):
                audio_trim_parts.append("areverse")
            if settings.get("hp_enabled"):
                audio_trim_parts.append(f"highpass=f={settings.get('hp_freq', 200)}")
            if settings.get("lp_enabled"):
                audio_trim_parts.append(f"lowpass=f={settings.get('lp_freq', 3000)}")
            if settings.get("denoise_enabled", False):
                if settings.get("denoise_method") == "arnndn":
                    audio_trim_parts.append("arnndn")
                else:
                    audio_trim_parts.append("afftdn=nr=12:nf=-30")
            if settings.get("loudnorm_enabled", False):
                _ln_i = settings.get("loudnorm_i", -23)
                _ln_lra = settings.get("loudnorm_lra", 7)
                _ln_tp = settings.get("loudnorm_tp", -2)
                audio_trim_parts.append(f"loudnorm=I={_ln_i}:LRA={_ln_lra}:TP={_ln_tp}")
            mode = settings.get("channel_mode", "stereo")
            if mode == "mono":
                audio_trim_parts.append("pan=mono|c0=0.5*c0+0.5*c1")
            elif mode == "left":
                audio_trim_parts.append("pan=mono|c0=c0")
            elif mode == "right":
                audio_trim_parts.append("pan=mono|c0=c1")
            elif mode == "swap":
                audio_trim_parts.append("pan=stereo|c0=c1|c1=c0")
            if settings.get("eq_enabled", False):
                eq_low = _opt_float(settings.get("eq_low", 0) or 0, 0.0)
                eq_mid = _opt_float(settings.get("eq_mid", 0) or 0, 0.0)
                eq_high = _opt_float(settings.get("eq_high", 0) or 0, 0.0)
                if eq_low != 0.0 or eq_mid != 0.0 or eq_high != 0.0:
                    audio_trim_parts.append(f"equalizer=f=100:width=200:g={eq_low},"
                                            f"equalizer=f=1000:width=1000:g={eq_mid},"
                                            f"equalizer=f=8000:width=4000:g={eq_high}")
            if settings.get("fade_enabled", False):
                fi = settings.get("fade_in", "").strip()
                if fi:
                    audio_trim_parts.append(f"afade=t=in:d={fi}")
                fo = settings.get("fade_out", "").strip()
                if fo:
                    audio_trim_parts.append(f"afade=t=out:st={a_end - float(fo) if a_end else 0}:d={fo}")
            # soxr 高质量重采样（对标 HandBrake）：非 auto 采样率时追加到链尾
            _sx = audio_soxr_resample_filter(settings)
            if _sx:
                audio_trim_parts.append(_sx)
                _af_has_soxr = True

            # 单段音频直接输出为 [aout]（无需 concat）
            a_filters.append(f"[0:a]{','.join(audio_trim_parts)}[aout]")

        filter_parts = []
    
        # 视频处理
        if not only_audio and v_filters:
            filter_parts.extend(v_filters)
            v_concat = f"[{']['.join(f'v{i}' for i in range(n))}]concat=n={n}:v=1:a=0[vout]"
            filter_parts.append(v_concat)
    
            # ----- 全局视频滤镜（缩放、裁剪、旋转、翻转、帧率、像素格式、变速、倒放、增强） -----
            global_filters = []
    
            # 缩放
            if settings.get("scale_enabled", False):
                method = settings.get("scale_method", "width")
                w = settings.get("scale_width", "").strip()
                h = settings.get("scale_height", "").strip()
                # 缩放算法（2026-10-08）：与主转码路径同一判据
                _alg = _norm_scale_algorithm(settings.get("scale_algorithm", ""))
                _alg_s = (":" + "flags=" + _alg) if _alg else ""
                if method == "width" and w:
                    global_filters.append(f"scale={w}:-2{_alg_s}")
                elif method == "height" and h:
                    global_filters.append(f"scale=-2:{h}{_alg_s}")
                elif method == "exact" and w and h:
                    global_filters.append(f"scale={w}:{h}{_alg_s}")
    
            # 裁剪
            if settings.get("crop_enabled", False):
                cw = settings.get("crop_width", "").strip()
                ch = settings.get("crop_height", "").strip()
                cx = settings.get("crop_left", "0").strip()
                cy = settings.get("crop_top", "0").strip()
                if cw and ch:
                    _cps = settings.get("crop_pos_segments")
                    if _cps:
                        try:
                            _ts0, _sp0 = _trim_speed_from_settings(settings)
                            _ex, _ey = build_crop_pos_expr(_cps, cx, cy,
                                                           trim_start=_ts0, speed_factor=_sp0)
                        except Exception:
                            _ex = _ey = None
                        # sendcmd 接入（行数 > 阈值；2026-10-01 全量接入，同 build_video_filter_chain）
                        _csc = None
                        if _ex and _ey and len(_cps) > _wp_sc_rows_limit():
                            try:
                                _civ = build_crop_pos_intervals(_cps, cx, cy,
                                                                trim_start=_ts0, speed_factor=_sp0)
                            except Exception:
                                _civ = None
                            if _civ:
                                _csc = FFmpegBatchGUI._write_waypoint_sendcmd_file(
                                    _civ, "cppg", target="crop@cppg")
                        if _csc is not None:
                            global_filters.append(f"sendcmd=f='{_csc}'")
                            global_filters.append(f"crop@cppg={cw}:{ch}:"
                                                  f"'{_civ[0][3]:g}':'{_civ[0][4]:g}'")
                        elif _ex and _ey:
                            global_filters.append(f"crop={cw}:{ch}:'{_ex}':'{_ey}'")
                        else:
                            global_filters.append(f"crop={cw}:{ch}:{cx}:{cy}")
                    else:
                        global_filters.append(f"crop={cw}:{ch}:{cx}:{cy}")
    
            # 旋转
            rotate = settings.get("rotate", "none")
            if rotate == "90":
                global_filters.append("transpose=1")
            elif rotate == "180":
                global_filters.append("transpose=2,transpose=2")
            elif rotate == "270":
                global_filters.append("transpose=2")
    
            # 翻转（全局）
            if settings.get("vflip", False):
                global_filters.append("vflip")
            if settings.get("hflip", False):
                global_filters.append("hflip")
    
            # 帧率
            if settings.get("frame_rate_type") == "custom":
                fps = settings.get("frame_rate_custom", "").strip()
                if fps:
                    global_filters.append(f"fps={fps}")
    
            # 像素格式
            if settings.get("pix_fmt_enabled", False):
                pix = settings.get("pix_fmt", "yuv420p")
                if pix:
                    global_filters.append(f"format={pix}")

            # 变速和倒放已改为逐段独立控制，不再在此添加全局滤镜

            # ========== 增强滤镜（降噪、锐化、色彩校正等） ==========
            enhance_settings = settings.get("enhance", {})
            if enhance_settings:
                temp_settings = {
                    "crop_enabled": False,
                    "scale_enabled": False,
                    "rotate": "none",
                    "vflip": False,
                    "hflip": False,
                    "speed_enabled": False,        # 已单独处理
                    "deinterlace_filter": "none",
                    "pix_fmt_enabled": False,
                    "subtitle_enabled": False,
                    "reverse_enabled": False,       # 已单独处理
                    "enhance": enhance_settings,
                }
                enhance_filter = build_video_filter_chain(
                    temp_settings,
                    include_subtitle=False,
                    include_speed=False,            # 已单独处理
                    include_trim=False,
                    include_format=False,
                    enhance_settings=enhance_settings
                )
                if enhance_filter and enhance_filter != "null":
                    global_filters.append(enhance_filter)

            # ========== 文字水印 ==========
            # 2026-08-26 多实例：_tw_rotate = 任一启用项需旋转子图；非旋转路径渲染全部非旋转项
            tw_settings = settings.get("text_watermark", {})
            _tw_items = settings.get("text_watermark_items") or []
            _tw_active = [i for i in _tw_items
                          if i.get("enabled", True) and str(i.get("text", "") or "").strip()]
            if not _tw_active:
                _tw_active = [tw_settings] if (tw_settings.get("enabled", False)
                                               and str(tw_settings.get("text", "") or "").strip()) else []
            _tw_enabled = bool(_tw_active)
            _tw_rotate = any(text_watermark_needs_subgraph(i) for i in _tw_active)
            if _tw_rotate:
                # 旋转：global_filters 先接到临时标签，文字子图（透明层+rotate+overlay）接在后面
                global_filter_str = ",".join(global_filters) if global_filters else "null"
                if global_filters:
                    filter_parts.append(f"[vout]{global_filter_str}[v_pre]")
                    tw_in = "[v_pre]"
                else:
                    tw_in = "[vout]"
                filter_parts.append(build_text_watermark_chain(settings, main_label=tw_in, out_label="[v_tw]"))
                map_v = "[v_tw]"
            else:
                _ts0, _sp0 = _trim_speed_from_settings(settings)
                dt = build_drawtext_chain_vf(tw_settings, _tw_items,
                     trim_start=_ts0, speed_factor=_sp0)
                if dt:
                    global_filters.append(dt)
                if global_filters:
                    global_filter_str = ",".join(global_filters)
                    filter_parts.append(f"[vout]{global_filter_str}[final_v]")
                    map_v = "[final_v]"
                else:
                    map_v = "[vout]"
    
        # 音频 concat（如果存在音频片段；独立截取模式只有 [aout] 无需 concat）
        if a_filters:
            filter_parts.extend(a_filters)
            if not audio_trim_enabled:
                a_concat = f"[{']['.join(f'a{i}' for i in range(n))}]concat=n={n}:v=0:a=1[aout]"
                filter_parts.append(a_concat)
    
        all_filters = ";".join(filter_parts)
        if all_filters:
            cmd.extend(["-filter_complex", all_filters])
    
        # ----- 映射流 -----
        if only_audio:
            cmd.extend(["-map", "[aout]"])
            cmd.append("-vn")
        else:
            if v_filters:
                # 视频流已处理
                cmd.extend(["-map", map_v])
                if a_filters:
                    cmd.extend(["-map", "[aout]"])
            else:
                # 不应该发生，因为至少有一个视频片段，但若没有则报错
                raise ValueError(_("没有视频片段"))
            # 视频编码参数
            vcodec = settings.get("encoder", "libx265")
            if vcodec == "copy":
                self._append_info_ui(_("分段拼接模式不支持 copy，自动改为 libx265"))
                vcodec = "libx265"
                settings["encoder"] = vcodec
            strategy = get_encoder_strategy(vcodec)
            cmd = strategy.build_params(cmd, settings)
            cmd = append_video_output_extras(cmd, settings)
    
        # 音频编码参数（如果启用且不是仅音频模式时，音频编码单独处理）
        if not disable_audio:
            if only_audio:
                # 仅音频模式，直接输出音频
                acodec = settings.get("audio_codec", "aac")
                cmd.extend(build_audio_encoder_args(acodec, settings, skip_ar=_af_has_soxr))
            else:
                # 视频模式，音频编码（如果有音频）
                if a_filters:
                    acodec = settings.get("audio_codec", "aac")
                    cmd.extend(build_audio_encoder_args(acodec, settings, skip_ar=_af_has_soxr))
        else:
            cmd.append("-an")
    
        # 自定义参数（含滤镜智能合并）
        custom = settings.get("custom_args", "").strip()
        self._merge_custom_filters_into_cmd(cmd, custom, verbose=verbose)
    
        # 容器优化（faststart 由编码预设「网络优化」控制，默认开 = 旧行为）
        container = settings.get("output_container", "mp4").lower()
        if container in ("mp4", "mov") and _faststart_on(settings):
            cmd.extend(["-movflags", "+faststart"])
        # HEVC 苹果兼容标记（2026-10-07）：必须用本地的 container 判据
        cmd = append_apple_compat_tag(cmd, settings, container)
    
        # 文字水印（旋转/spin）无限源时长限制：有音频用 -shortest，无音频用 -t（分段总时长）
        _ensure_tw_duration_limit(
            self, cmd, input_path=input_path,
            main_duration=self._calc_segments_total_duration(settings),
            audio_enabled=True,
            image_display_duration=_eff_image_display_duration(settings))

        cmd.append(output_path)
        return cmd

    def _blend_static_geometry(self, xv, yv, sw, sh, mw, mh):
        """计算区域化 blend 的「主画面裁切矩形」与「子视频裁切偏移」（静态位置）。
        与 _build_overlay_filter_complex 静态分支逐字一致：越界裁剪 + 偶数对齐（yuv420p）+ 夹紧到画布内。
        返回 (bx, by, bw, bh, sx, sy)。bw/bh<2 表示子视频完全在画布外。"""
        bx = xv if xv > 0 else 0
        by = yv if yv > 0 else 0
        bw = sw + (xv if xv < 0 else 0)
        bh = sh + (yv if yv < 0 else 0)
        if bx + bw > mw:
            bw = mw - bx
        if by + bh > mh:
            bh = mh - by
        # yuv420p 要求偶数尺寸与位置（对齐时只缩小，绝不增大，避免越界）
        if bx % 2:
            bx -= 1
        if by % 2:
            by -= 1
        if bx < 0:
            bx = 0
        if by < 0:
            by = 0
        if bw % 2:
            bw -= 1
        if bh % 2:
            bh -= 1
        # 对齐后再次夹紧到画布内
        if bx + bw > mw:
            bw = mw - bx
        if by + bh > mh:
            bh = mh - by
        sx = -xv if xv < 0 else 0
        sy = -yv if yv < 0 else 0
        return bx, by, bw, bh, sx, sy

    def _make_blend_region(self, src_label, sub_label, ov_label,
                           bx, by, bw, bh, place_x, place_y,
                           blend_mode, out_label, idx_tag,
                           ov_suffix="", place_name=None, sc_file=None,
                           slr_scale_before=None):
        """生成「区域化 blend」子图（包围盒 + α 屏蔽模型，2026-10-07 取代旧「动态 crop 窗口」），
        供正式命令、合并页预览、实时预览共用，勿复制粘贴。

        模型（与 Shotcut 的 Cairo bounded blend 等价，详见 research/blend-isolation/README.md）：
        - 主画面裁出【静态包围盒】(bx,by,bw,bh) → 纯 RGB（blend 无 alpha 可破坏）；
        - 同区域用主画面再裁一份、转 RGBA 后 colorchannelmixer=aa=0 做【透明画布】
          （跟随主视频帧率，规避 color 源错帧率；也避免引入无限源）；
        - 子视频（已含缩放/旋转/alpha）叠到透明画布上，落位 overlay 的 x/y = 子左上角相对
          包围盒原点（可表达式或 sendcmd 驱动，逐帧动 → 缩放/旋转/轨迹全部成立）；
        - split 出 alpha 单提、RGB 参与 blend、blend 后 alphamerge 合并回 alpha；
        - 把混合结果贴回包围盒原点（静态 bx,by）。

        旧「crop 窗口尺寸无法逐帧变」的铁律被彻底绕开：包围盒是静态的，动的是落位 overlay。
        静止态（z=1、无轨迹）下与旧模型逐字节全等（P2 已实证），零回归。

        参数（与旧签名不兼容，调用点已同步改，见 33402/36138/51674）：
        - bx,by,bw,bh：静态包围盒（由调用点经 _blend_wp_bbox / _blend_move_envelope /
          _blend_static_geometry 算得，已整偶、已夹进画布）。
        - place_x,place_y：落位 overlay 的 x/y（子视频左上角相对包围盒原点）；动态时为含 t 的
          表达式或 sendcmd 基值（命令文件后缀已含 -offx-bx），静态时为整数字符串。
        - place_name：落位 overlay 实例别名（sendcmd 按名定向，仅长列表轨迹传）；配套 sc_file。
        - sc_file：sendcmd 命令文件路径（突破长列表表达式段数墙）；仅驱动落位 overlay 单节点
          （旧模型需同时驱动 crop+overlay 两节点，新模型 crop 已静态、只需驱动落位）。
        - ov_suffix：仅实时预览传 ":eof_action=pass"（mpv 无全局 -shortest，主视频播完须收尾）；
          正式命令不传（靠全局 -shortest）。⚠️ 落位 overlay 固定带 eof_action=pass（子视频较
          主视频短时透出透明画布，blend 退化为主画面；不截短最终输出——最终长度由 [ol] 决定）。
        - slr_scale_before：**子链带逐帧航点缩放时必须 True**（把 format=rgba 提到 scale 之前）。
          ⚠️ 见第 3 步的铁律：写在之后会让 z(t) 锁死在首帧值 → 缩放永不缩回
          （用户 2026-10-07 实测「整体都变大」）。无缩放时保持 False（旧行为，逐字节不变）。
          ⚠️ 传 None = **自动判定**（推荐）：直接看 sub_label 上挂没挂逐帧 scale
          （`eval=frame` + `2*round(iw*(`），不依赖调用方手里的 _wp_zoom 标志
          ——那条链上标志与实际生成的 scale 可能不同源（实测踩过）。
        """
        def _lbl(s):
            s = str(s).strip()
            if s.startswith("[") and s.endswith("]"):
                s = s[1:-1]
            return s
        ml = _lbl(src_label)
        sl = _lbl(sub_label)
        ol = _lbl(ov_label)
        mc = f"mcr{idx_tag}"
        mc_src = f"mcs{idx_tag}"
        cv = f"cvb{idx_tag}"
        slr = f"slr{idx_tag}"
        sf = f"sfb{idx_tag}"
        alp = f"alp{idx_tag}"
        rgx = f"rgx{idx_tag}"
        aex = f"aex{idx_tag}"
        blr = f"blx{idx_tag}r"
        bl = f"blx{idx_tag}"
        parts = []
        # 0)⚠️🔴 必须先 split 入参 pad：本函数共消费它**三次**——
        #    第 1/2 步两个 crop 各一次+ 第 8 步「贴回」overlay 一次。
        #    同一 pad 被读超过声明的输出数，多出来的消费 ⇒
        #   · mpv：「Pad xxx is not connected to anything.」+ Exiting ⇒ **预览打不开**
        #     （真机 2026-10-07，用户贴出的 mpv 命令原文报错；ffmpeg 侧静默容忍）
        #   · ffmpeg：⚠️ 不报错但**贴回时拿到的是被 blend 改过的流**，且 EOF 段
        #     拿错源 ⇒ 主视频播完后「定格」在最后一帧而非黑屏（用户报「转换后
        #     行为不对」的第二症状，抽帧实测 t=17/25/40s 像素完全一致）。
        #    ⇒ split 成三路（RGB 画布 / 透明画布 / 贴回目标），各消费 1 次。
        #    ⚠️ 单 blend 时 ml == ol（_src_label=current_v 且第 8 步也传 current_v），
        #    只需 split 一次；多 blend regional 时 ml=v_crop_N（独立标签）、
        #    ol=current_v（上一轮输出，也是独立标签）——两个不同标签各split 一次。
        if ml == ol:
            parts.append(f"[{ml}]split=3[{mc_src}][{cv}_src][{ol}_base]")
        else:
            parts.append(f"[{ml}]split=2[{mc_src}][{cv}_src]")
            parts.append(f"[{ol}]split=2[{ol}_base][{ol}_x]")
            parts.append(f"[{ol}_x]nullsink")
        # 1) 主画面裁出包围盒（RGB，blend 纯 RGB 空间）
        parts.append(f"[{mc_src}]crop={bw}:{bh}:{bx}:{by},format=rgb24[{mc}]")
        # 2) 同区域透明画布：裁主画面 + RGBA + alpha 置 0（跟随主视频帧率，无 color 源）
        parts.append(f"[{cv}_src]crop={bw}:{bh}:{bx}:{by},format=rgba,colorchannelmixer=aa=0[{cv}]")
        # 3) 子视频统一转 RGBA（无 alpha 的普通视频 → 全不透明，行为不变）
        # 🔴⚠️ 铁律（真机 2026-10-07 像素级实证，勿动）：`format=rgba` 若作为**独立段**
        #    排在逐帧 scale **之后**（无论同一 filter_complex 的前后位置，滤镜图按段序执行），
        #    overlay 副输入会走「带 α 的尺寸协商」路径 → **逐帧变尺寸 scale 失效**：
        #    z(t) 锁死在首帧值，缩放永不缩回（用户报「整体都变大、没有缩回」）。
        #    同管线 A/B 对照（320x240 主 + 80x60 白子视频，量白块可见宽度）：
        #      format 独立段在 scale 后 → 160/160/160/**160**（恒 2 倍，锁死）
        #      format 融进 scale 之前的链   → 148/120/88/**80**（随 z(t) 正确缩回）
        # ⇒ 正确做法：format 必须由**子链构建方**（_build_sub_layer_node 等）在逐帧 scale
        #    **之前**就地插入，而不是在这里事后追加一段（本函数拿不到子链内部结构）。
        #    slr_scale_before=True 仅作「自检提示」：调用方漏传时此处补一段（无害但仍锁死），
        #    真正的修复必须在子链侧 —— 见 _build_sub_layer_node 的 wp_zoom 分支。
        if slr_scale_before:
            self._append_info_ui(
                _("[blend] 子链 format=rgba 位置异常：逐帧缩放可能被锁死（见 _make_blend_region 铁律）"))
        _slr_in = f"[{sl}]"
        # 4) 落位：子视频叠到透明画布（x/y 相对包围盒原点）；sendcmd 驱动时先挂命令
        _place_in = f"[{cv}]"
        if sc_file:
            parts.append(f"[{cv}]sendcmd=f='{sc_file}'[{cv}_sc]")
            _place_in = f"[{cv}_sc]"
        # ⚠️ 实例别名必须紧跟**滤镜名**（overlay@plN=...），不能追加在参数末尾
        # （overlay=...@plN → Eval "Invalid chars '@plN'" → rc=-22 整图零帧）。
        # ⚠️⚠️ x/y **必须带单引号**（x='..':y='..'），与普通叠加路径同款（51780）。
        # 表达式含 '(' / ','（如 min(max(..),0)）时，filtergraph 的 ':' 切分会把表达式
        # 打散 → "No option name near 'eof_action'"（真机 2026-10-07 实证，静态态因
        # x/y 是纯数字不触发，一开轨迹立刻 rc=-22 → 用户侧「转换报错」）。
        _ov_spec = ("overlay@%s=" % place_name if place_name else "overlay=") \
            + f"x='{place_x}':y='{place_y}':eof_action=pass"
        parts.append(f"{_place_in}{_slr_in}{_ov_spec}[{sf}]")
        # 5) 拆 alpha / RGB
        parts.append(f"[{sf}]split=2[{alp}][{rgx}]")
        parts.append(f"[{alp}]alphaextract[{aex}]")
        parts.append(f"[{rgx}]format=rgb24[{rgx}b]")
        # 6) 仅包围盒内 blend（RGB 空间）
        parts.append(f"[{mc}][{rgx}b]blend=all_mode={blend_mode}[{blr}]")
        # 7) 子视频 alpha 合并回来（遮罩/透明度原样保留）
        parts.append(f"[{blr}][{aex}]alphamerge,format=rgba[{bl}]")
        # 8) 贴回包围盒原点（静态）——用 split 出来的 {ol}_base（第 0 步已备好），
        #    避免第 3 次消费入参 pad
        parts.append(f"[{ol}_base][{bl}]overlay={bx}:{by}{ov_suffix}[{out_label}]")
        return parts

    def _waypoint_sendcmd_offset_suffix(self, sub_file, sub_settings, wp_res):
        """sendcmd 模式的旋转中心对齐后缀（照抄 _pip_overlay_xy 的 _rot_ov 偏移语义，改一处必查另一处）。

        返回 (suffix_x, suffix_y)：非旋转 ('','')；否则形如 '- 12.5' 或
        '- ((zoom_expr))*12.5'（航点缩放时偏移随 z(t) 同乘）。
        """
        _content_w, _content_h = self._overlay_content_size(sub_file, sub_settings)
        _spv = _opt_float(sub_settings.get("spin_speed", 60.0) or 60.0, 60.0)
        _spin_on = bool(sub_settings.get("spin_enabled", False))
        _ra = _opt_float(sub_settings.get("rotate_angle", 0) or 0, 0.0)
        _wp_rot = (wp_res is not None and wp_res[2] is not None)
        _rot_ov = (_spin_on and _spv != 0) or (_ra != 0) or _wp_rot
        if not _rot_ov:
            return "", ""
        _sw_b, _sh_b = self._overlay_sub_size(sub_file, sub_settings)
        _offx, _offy = _content_box_shift(_content_w, _content_h, _sw_b, _sh_b)
        _wp_zoom = bool(wp_res is not None and wp_res[3] is not None)
        if _wp_zoom:
            return f"- (({wp_res[3]}))*{_offx:.6g}", f"- (({wp_res[3]}))*{_offy:.6g}"
        return f"- {_offx:.6g}", f"- {_offy:.6g}"

    @staticmethod
    def _write_waypoint_sendcmd_file(intervals, tag, suffix_x="", suffix_y="", target=None,
                                     cmd_style="xy", targets=None,
                                     scale_base_w=None, scale_base_h=None, scale_min=None,
                                     fs_base=None, fs_cap=None):
        """把航点区间写成 sendcmd 命令文件（系统临时目录，内容寻址命名），返回 f= 选项用的转义路径。

        cmd_style：命令形态（2026-10-04 新增）——"xy"（>=7.1）/ "reinit"（<7 的 drawtext，
        2026-10-07 起另有 "scale" / "fontsize" / "fontsize_reinit"，
        见 write_waypoint_sendcmd_file docstring）。⚠️ 已纳入 md5 内容寻址：同一套航点
        在两种形态下文件内容不同，不进 md5 会导致切 ffmpeg 版本时命中旧形态的缓存文件；
        fs_base（fontsize 模式的基准字号）同理入 md5，否则改字号会命中旧缓存文件。

        2026-10-01 起不再写输出目录（用户反馈难看）：统一写 %TEMP%\\ff_wp_sendcmd\\，
        文件名 = 参数内容 md5 前 10 位（同内容同名互相覆盖，预览反复刷新不堆积；
        不同任务/不同参数天然不碰撞，并发导出安全）。目录内 7 天前的旧文件顺带清扫
        （拷命令手动复跑在 7 天内有效）。路径转义（n9.0.1 实测可行，含空格）：
        反斜杠→正斜杠 + 盘符冒号转义 `C\\:/...` → 不依赖 ffmpeg 进程 cwd
        （导出/转换各启动点 cwd 不统一）。任何异常 → None（调用方回退表达式路）。
        """
        try:
            base_dir = os.path.join(tempfile.gettempdir(), "ff_wp_sendcmd")
            os.makedirs(base_dir, exist_ok=True)
            _h = hashlib.md5(repr((tag, suffix_x, suffix_y, target, cmd_style,
                                   intervals, scale_base_w, scale_base_h, scale_min,
                                   fs_base, fs_cap)).encode("utf-8")).hexdigest()[:10]
            path = os.path.normpath(os.path.join(base_dir, f"ff_wp_sendcmd_{tag}_{_h}.txt"))
            write_waypoint_sendcmd_file(intervals, path, tag=tag,
                                        suffix_x=suffix_x, suffix_y=suffix_y, target=target,
                                        cmd_style=cmd_style, targets=targets,
                                        scale_base_w=scale_base_w, scale_base_h=scale_base_h,
                                        scale_min=scale_min, fs_base=fs_base, fs_cap=fs_cap)
            try:  # 顺带清扫 7 天前的旧命令文件（预览/导出残留）
                _now = time.time()
                for _n in os.listdir(base_dir):
                    _p2 = os.path.join(base_dir, _n)
                    if os.path.isfile(_p2) and _now - os.path.getmtime(_p2) > 7 * 86400:
                        os.remove(_p2)
            except Exception:
                pass
            p = path.replace("\\", "/")
            if "'" in p:
                return None
            p = re.sub(r"^([A-Za-z]):", r"\1\\:", p)
            return p
        except Exception:
            return None

    def _pip_overlay_xy(self, sub_file, sub_settings, wp_res, wp_rot, spin_on, ra, wp_zoom,
                        shift_content_wh=None, shift_box_wh=None, move_size=None):
        """子视频叠加进「输出画布」的 x/y 表达式（两处共用，改一处必查另一处）：
        ① 阶段 B 非链成员直接叠加到主视频；② 链成员在图层内「烙进透明画布」时的定位。

        语义：返回坐标相对输出画布（主视频渲染尺寸或 pad 画布）左上角。
        overlay_x/y 的 w/h 指**内容盒**（未旋转渲染尺寸）；旋转（spin/静态角度/航点自转）
        时叠加盒是 d×d 包装盒 → 减中心对齐偏移 (d-w)/2；航点缩放时偏移随 z(t) 同乘。
        返回 (x, y) 表达式字符串。

        shift_content_wh / shift_box_wh（2026-10-16，**只有组节点传**）：把「旋转中心对齐」
        的两端改成**包装盒**——组节点上 rotate 作用在整只包装盒上，故「内容」= 包装盒尺寸、
        「叠加盒」= 包装盒的 d×d，而不是组内主自己的内容盒。不传（None）= 旧口径，
        非组路径**逐字节不变**。

        move_size（2026-10-18，**只有组节点传**）：**预制轨迹**（h/v/diamond/corners）的
        运动对象尺寸。`build_move_xy_expr` 用 sw/sh 算「W-sw」「H-sh」这类幅度 —— 子视频
        是自己那份内容盒，而**组节点移动的是整只包装盒** ⇒ 必须传包装盒尺寸，否则预制
        轨迹会把整组往右下多推 (PW-w, PH-h)。⚠️ 只影响 `build_move_xy_expr` 的 sw/sh；
        x0/y0 里 `w`/`h` 的替换仍按**组内主内容盒**（那两个表达式本来就是组内主的落位）。
        None = 旧口径（非组路径逐字节不变）。
        """
        x = sub_settings.get('overlay_x', '0').strip() or '0'
        y = sub_settings.get('overlay_y', '0').strip() or '0'
        _content_w, _content_h = self._overlay_content_size(sub_file, sub_settings)
        _spv = _opt_float(sub_settings.get("spin_speed", 60.0) or 60.0, 60.0)
        _rot_ov = (spin_on and _spv != 0) or (ra != 0) or wp_rot
        _mv = (sub_settings.get('move_mode', '') or '').strip()
        if _mv == "waypoints":
            # 列表轨迹：x/y 为画布绝对像素（数字），直接使用；无效时回退基准位置
            if wp_res is not None and wp_res[0] is not None:
                x, y = wp_res[0], wp_res[1]
            else:
                x = _content_box_expr(x, _content_w, _content_h)
                y = _content_box_expr(y, _content_w, _content_h)
        elif _mv:
            # 轨迹范围/基准都按内容盒（sw/sh=内容盒数字，x0/y0 的 w/h 内容盒化）
            # ⚠️ 组节点传 move_size ⇒ 幅度按**包装盒**算（移动的是整只盒）
            _mw, _mh = ((int(move_size[0]), int(move_size[1]))
                        if move_size is not None else (_content_w, _content_h))
            _mx, _my = build_move_xy_expr(
                _mv, _content_box_expr(x, _content_w, _content_h),
                _content_box_expr(y, _content_w, _content_h),
                sub_settings, sw=str(_mw), sh=str(_mh))
            if _mx is not None:
                x, y = _mx, _my
            else:
                x = _content_box_expr(x, _content_w, _content_h)
                y = _content_box_expr(y, _content_w, _content_h)
        elif _rot_ov:
            # 静态位置：数字求值（内容盒语义），旋转时下面统一减中心偏移
            x = _content_box_expr(x, _content_w, _content_h)
            y = _content_box_expr(y, _content_w, _content_h)
        if _rot_ov:
            # 旋转中心对齐：叠加盒(d×d)中心=内容盒中心 → 减 (d-w)/2
            _sw_b, _sh_b = (self._overlay_sub_size(sub_file, sub_settings)
                            if shift_box_wh is None else shift_box_wh)
            _cw_s, _ch_s = ((_content_w, _content_h) if shift_content_wh is None
                            else shift_content_wh)
            _offx, _offy = _content_box_shift(_cw_s, _ch_s, _sw_b, _sh_b)
            if wp_zoom:
                # 轨迹缩放把叠加盒整体放大 z(t) 倍 → 中心对齐偏移同乘 z(t)，
                # 否则「旋转 + 缩放」时内容会随放大逐渐偏离航点坐标。
                x = f"({x}) - ({wp_res[3]})*{_offx:.6g}"
                y = f"({y}) - ({wp_res[3]})*{_offy:.6g}"
            else:
                x = f"({x}) - {_offx:.6g}"
                y = f"({y}) - {_offy:.6g}"
        return x, y

    def _pip_transition_chains(self, sub_infos, main_settings=None, main_file_path=None,
                               main_duration=None):
        """画中画：规划「转场链」（串行转场字段的画中画版消费端）。

        画中画的子视频本来就是各占一条 overlay 层、摆在时间轴任意位置；当**相邻两段
        首尾相接**且前一段开了转场（transition_enabled/type/duration —— 与串行合并共用
        同一组字段，串行那套 UI 直接复用），就把它们合成一条「转场链」：
        段内各自不位移 → xfade 链 → 整体 setpts 位移回时间轴。

        与串行一致的语义：xfade 吞掉 d 秒 → 后段在链内提前 d 秒出现（非 bug）。

        **主视频也可作为链首**（main_settings 开了转场 且 某子视频的显示时段起点 ≈
        主视频有效时长）：此时 members[0] == -1，链输出直接当「底之上的第一层」。

        画布统一方案（2026-09-25）：**所有链**的尺寸一律=输出画布（_compute_output_canvas）、
        帧率一律=主视频帧率（探不到时回退链首段）；每个成员图层先把内容（含位置/轨迹/旋转）
        烙进统一透明画布（color=black@0，见 _build_sub_layer_node 的 canvas 参数），
        norm 只做 限长/帧率/SAR/format=yuva420p 归一（**不再 scale 拉伸**）——
        链内天然同尺寸，位置随段保留，透明处透出主视频。blend 模式仍不进链
        （需要与主视频像素混合，链是独立流做不到）。

        返回 (chains, chain_of, shift_of)：
          chains   [{members, start, lens, norm, trans, size, fps}]（按时间序，≥2 段）
          chain_of {i: chain_index}（不含 -1）
          shift_of {normalize_path(子视频文件): 音频相对摆放起点的偏移}
                   = −Σ(该段之前所有转场时长)（≤0）。xfade 让视频提前，音频必须同步提前，
                   否则声画错开（用户实测：转场后声音滞后一个转场时长）。
        任一环节探不到参数 → 整链不成立（降级为各自独立叠加，与旧行为逐字节一致）。
        """
        chains, chain_of, shift_of = [], {}, {}
        try:
            cand = []
            for i, (_si, _sf, _ss) in enumerate(sub_infos):
                if not _ss.get('overlay_enabled', True):
                    continue
                if (_ss.get('blend_mode', 'normal') or 'normal').strip().lower() != 'normal':
                    continue          # blend 要和主视频像素混合，链是独立流做不到 → 不进链
                # 旋转 / 子画布 / 航点（含航点缩放）：全部在图层内完成、烙进统一透明画布
                # （2026-09-25 画布统一方案），不再需要排除——位置/轨迹/旋转随段保留。
                # 帧对齐（floor 到源帧格）：链 lens/cbase d/offset 全链帧格化
                _dur = self._get_media_duration(
                    _sf, frame_align_fps=self._get_video_framerate(_sf))
                _ws, _we, _bd = self._resolve_display_window(_ss, _dur, input_path=_sf)
                if not _bd or _we is None or _we <= _ws:
                    continue          # 无界窗口（无限循环）→ 链长算不出来
                cand.append((i, _sf, _ss, float(_ws), float(_we)))
            cand.sort(key=lambda _x: _x[3])
            # ---- 主视频作为链首（可选）：插到「起点 ≈ 主视频时长」的那一段之前 ----
            # ⚠️ 必须插在 sort 之后：主视频头的窗口是 [0, main_len]，按 ws 排序会被顶到最前，
            # 但它在时间轴上接的是 ws≈main_len 的那一段。
            if (main_settings is not None and main_file_path and main_duration
                    and main_duration > 0
                    and bool(main_settings.get('transition_enabled', False))
                    and not self._is_static_image(main_file_path)):
                _mf0 = self._get_video_framerate(main_file_path)
                _mw0, _mh0 = self._compute_output_canvas(main_settings, main_file_path)
                if _mf0 and _mw0 and _mh0:
                    _tol0 = 0.5 / _mf0
                    # 主视频自己挂了转场 → 子视频按「对齐后」的起点摆（= 主时长 - 转场时长），
                    # 也算接在末尾（与下方相邻判定同一条放宽规则，见注释）。
                    try:
                        _md0 = max(0.0, float(str(main_settings.get(
                            'transition_duration', '1.0') or '1.0').strip()))
                    except (ValueError, TypeError):
                        _md0 = 0.0
                    _pos = None
                    for _k, _it in enumerate(cand):
                        if abs(_it[3] - float(main_duration)) <= _tol0 or \
                                abs(_it[3] - (float(main_duration) - _md0)) <= _tol0:
                            _pos = _k
                            break
                    if _pos is not None:
                        cand.insert(_pos, (-1, main_file_path, main_settings,
                                           0.0, float(main_duration)))
            if len(cand) < 2:
                return chains, chain_of, shift_of
            # 相邻相接 + 前段开了转场 → 同一链（主视频头恒为新链起点，不与前面的段合并）
            groups, cur = [], []
            for _it in cand:
                if _it[0] < 0:
                    if cur:
                        groups.append(cur)
                    cur = [_it]
                    continue
                if not cur:
                    cur = [_it]
                    continue
                _p = cur[-1]
                _tol = 0.5 / (self._get_video_framerate(_p[1]) or 25.0)
                # 衔接判定两种都算：
                #   ① 首尾相接（前段结束 ≈ 后段起始）—— 原口径；
                #   ② 转场对齐（后段提前「转场时长」让位，gap ≈ -d）—— 「转场对齐」把界面上的
                #      起点改成画面真正切换的时刻后必然是这种。不放宽的话，一键转场把起点
                #      一改就把链拆了，xfade 静默不生效（看起来像功能没了）。
                _p_on = bool(_p[2].get('transition_enabled', False))
                _dp = 0.0
                if _p_on:
                    try:
                        _dp = max(0.0, float(str(_p[2].get(
                            'transition_duration', '1.0') or '1.0').strip()))
                    except (ValueError, TypeError):
                        _dp = 0.0
                _gap = _it[3] - _p[4]      # 负数 = 后段提前
                if _p_on and (abs(_gap) <= _tol or abs(_gap + _dp) <= _tol):
                    cur.append(_it)
                else:
                    groups.append(cur)
                    cur = [_it]
            if cur:
                groups.append(cur)
            for _g in groups:
                if len(_g) < 2:
                    continue
                # 画布统一方案（2026-09-25）：链尺寸一律=输出画布、帧率一律=主视频帧率。
                # 每段先把内容（含位置/轨迹/旋转）烙进一张透明画布（黑@0）再 xfade，
                # 链内天然同尺寸，不再有「链首是谁就用谁的尺寸」的分支。
                # 回退链：主视频上下文缺失（畸形调用）时退到主视频缓存尺寸，
                # 再退到链首段叠加盒——保证链内至少统一（静默丢链比摆错更糟）。
                _hw = _hh = _hf = None
                if main_settings is not None and main_file_path:
                    try:
                        _hw, _hh = self._compute_output_canvas(main_settings, main_file_path)
                    except Exception:
                        _hw = _hh = None
                if not _hw or not _hh:
                    try:
                        _hw, _hh = self._get_video_dimensions_cached(main_file_path)
                    except Exception:
                        _hw = _hh = None
                if not _hw or not _hh:
                    _hw, _hh = self._overlay_sub_size(_g[0][1], _g[0][2])
                if main_file_path:
                    _hf = self._get_video_framerate(main_file_path)
                if not _hf:
                    _hf = self._get_video_framerate(_g[0][1])
                if not _hw or not _hh or not _hf:
                    continue
                _hw, _hh = int(_hw), int(_hh)
                _lens, _norm, _ok = {}, {}, True
                for _it in _g:
                    _len = float(_it[4]) - float(_it[3])
                    if _len <= 0:
                        _ok = False
                        break
                    _lens[_it[0]] = _len
                    # xfade 硬门槛（实测直接报错）：尺寸/时基/像素格式不同都不行。
                    # 画布统一方案：尺寸由「图层烙进透明画布」保证（不再 scale 拉伸），
                    # 这里只做 限长/帧率/SAR/像素格式 归一（yuva420p 带 alpha，全链一致）。
                    # 主视频头额外加 setpts=PTS-STARTPTS：主的编码链起点不一定归零（trim 等）
                    _pre0 = "setpts=PTS-STARTPTS," if _it[0] < 0 else ""
                    _norm[_it[0]] = (f"{_pre0}trim=0:{_len:.6g},fps={_hf:.6g},"
                                     f"setsar=1,format=yuva420p")
                if not _ok:
                    continue
                _trans = []
                for _k in range(len(_g) - 1):
                    _d = _opt_float(str(_g[_k][2].get('transition_duration', '1.0') or '1.0').strip(), 1.0)
                    # 必须 < min(两段)/2，否则 xfade 退化（T5 实测静默失效）
                    _lim = min(_lens[_g[_k][0]], _lens[_g[_k + 1][0]]) * 0.5 - 0.01
                    if _lim <= 0.02:
                        _ok = False
                        break
                    _d = max(0.01, min(_d, _lim))
                    _tt = str(_g[_k][2].get('transition_type', 'fade') or 'fade').strip()
                    if _tt not in XFADE_TRANSITIONS:
                        _tt = "fade"
                    _trans.append((_tt, _d))
                if not _ok:
                    continue
                _ci = len(chains)
                chains.append({"members": [_it[0] for _it in _g],
                               "start": float(_g[0][3]),
                               "lens": _lens, "norm": _norm, "trans": _trans,
                               "size": (_hw, _hh), "fps": _hf})
                for _it in _g:
                    if _it[0] >= 0:
                        chain_of[_it[0]] = _ci
                # 音频偏移：xfade 吞掉 d 秒 → 链内第 k 段的音频要提前 Σ(前面的转场时长)，
                # 否则画面已经切过去了、声音还在原位置响（用户实测的「延迟」）。
                _acc = 0.0
                for _k, _it in enumerate(_g):
                    if _it[0] >= 0:
                        shift_of[normalize_path(_it[1])] = -_acc
                    if _k < len(_g) - 1:
                        _acc += _trans[_k][1]
        except Exception:
            return [], {}, {}
        return chains, chain_of, shift_of

    def _build_sub_layer_node(self, i, sub_idx, sub_file, sub_settings,
                              main_settings, win_override=None, extra_tail=None,
                              canvas=None, include_fade: bool = True,
                              wp_sendcmd: bool = False, canvas_shortest: bool = True,
                              group_base: bool = False, xy_override=None):
        """构建**单个子视频的图层**（滤镜链 + 最终标签），不含叠加。

        从 _build_overlay_filter_complex 的子循环里整段抽出（逻辑逐行照搬），
        以便主循环拆成「阶段A 建层 → 阶段A2 转场链合成 → 阶段B 叠加」三步：
        转场链需要**先把所有成员的图层都建好**再做 xfade 链，单趟循环做不到。

        win_override=(ws, we)：None=按 sub_settings 原样（含位移到 show_start）；
          给了则改用该窗口——转场链成员传 (0, 段长)，即「不位移 + 精确限长」。
        extra_tail：追加到图层末尾的滤镜串（转场链用它塞 trim/fps/setsar/format 归一）。
        canvas=(W,H,fps,len)：画布统一方案（2026-09-25）——转场链成员把内容
          （含位置/轨迹/旋转，定位走 _pip_overlay_xy）烙进一张统一透明画布
          （color=black@0），链内天然同尺寸，透明处透出主视频；None=不合成。
        canvas_shortest：画布合成 overlay 是否带 `shortest=1`（默认 True，转场链用）。
          转场链必须 True —— 画布是链成员时长的权威，防「素材多 1 帧」喂进 xfade 死锁
          （2026-09-26 实测内存爆炸）。画中画**分组**自 2026-10-17 单画布方案起成员
          **不再传 canvas**（组画布收敛到阶段 A3 唯一一张，成员定位改由组级 overlay
          的 rel 坐标承担，见 `_build_overlay_filter_complex` 阶段 A3）。
        group_base（模型 B / C1 裁剪式，2026-10-15）：本轨是**分组里的组内主**。组内主在该组
          里扮演"主视频"，故：
            · **跳过** 旋转段与轨迹缩放段（它们必须作用于**整组**，由阶段 B 的组节点承担，
              见 `_group_node_transform_parts`）；
            · （2026-10-16～2026-10-17 历史）画布定位曾由 `xy_override` 给出；单画布后
              定位整体移交阶段 A3 组级 overlay，此参数对组成员已不再消费（保留签名兼容）。
          ⇒ 组内主在本层的产物 = 它的内容腿，不含任何自身姿态。
          非组路径（默认 False）**逐字节不变**。
        xy_override=(x, y)（2026-10-16，**只有组成员传**）：**包装盒内相对坐标**
          （= 主画布绝对坐标 − 包装盒原点，见 `_group_box_geometry` 的 "rel"）。
          🔴 2026-10-17 起仅当 `canvas` 非 None 时才被消费（画布分支内的定位）；
          组成员 canvas=None ⇒ 本参数当前**无消费方**（纯透传，阶段 A3 直接读
          `rel_of`），保留只为签名/调用点稳定。
          不传（None）= 旧口径（`_pip_overlay_xy` / group_base 的 0:0）。

        返回 (filter_parts, current_sub, meta)。
        """
        filter_parts = []
        # 判断是否使用 loop 滤镜：截取(trim)循环模式，或「启用循环控制」的有限模式(count)
        # 即使未勾选截取也按整段子视频时长计算 loop_size —— 用户实测旧版只需勾选
        # 「启用循环控制」即可有限循环（2026-09-02 修正：不再强制要求勾选「截取」）。
        _loop_finite = bool(sub_settings.get("loop_enabled", False)) and \
            str(sub_settings.get("loop_mode", "infinite") or "infinite") == "count"
        use_loop = bool(sub_settings.get("trim_enabled", False)) or _loop_finite
        if use_loop:
            if sub_settings.get("loop_enabled", False) and sub_settings.get("loop_mode") == "once":
                use_loop = False

        # 获取子视频的增强设置
        sub_enhance = sub_settings.get("enhance", {})

        # 计算循环帧数：use_loop（trim 循环模式）→ 片段帧数，由 chain 内 trim+loop 处理；
        # once/未启用 → loop_size=None（chain 内单次 trim 或无；正式命令靠 -stream_loop -1 输入级循环整段）
        loop_size = None
        if use_loop:
            # 获取帧率
            fps = self._get_video_framerate(sub_file)
            if fps is None:
                use_loop = False
            else:
                start_str = sub_settings.get("trim_start", "0").strip()
                end_str = sub_settings.get("trim_end", "").strip()
                start_sec = time_to_seconds(start_str) if start_str else 0.0
                end_sec = time_to_seconds(end_str) if end_str else None
                if end_sec is not None and end_sec > start_sec:
                    duration = end_sec - start_sec
                else:
                    # 帧对齐时长（floor 到源帧格）：loop_size = 内容真实帧数，
                    # 不被容器时长（音频撑长）多算 1 帧 → 回放缓冲不闪首帧
                    raw_duration = self._get_media_duration(sub_file, frame_align_fps=fps)
                    if raw_duration is not None:
                        duration = raw_duration - start_sec
                    else:
                        use_loop = False
                if use_loop:
                    loop_size = int(round(duration * fps))
                    if loop_size <= 0:
                        use_loop = False
                        loop_size = None

        # ---- 子视频「显示时段」优化（2026-09-02，抄统一尝试版）：把 show_start/show_end
        # 升级为子链时间边界，窗口外重滤镜不跑（省 CPU）。仅当窗口合法时生效；标记
        # _has_window 供下方 overlay/blend 追加 eof_action=pass（子链在窗口结束正常 EOF，
        # 避免默认 repeat 冻帧/截断）。
        # ⚠️ _sub_dur 必须先于本段绑定（没开「截取」时 use_loop 分支不执行，会导致
        # _resolve_display_window 引用未绑定变量而抛 UnboundLocalError）。
        # 帧对齐（floor 到源帧格）：显示窗口 = 内容真实帧覆盖 → 窗口末格恰好由内容
        # 最后一帧填满，杜绝「窗口多 1 帧 → loop 回放闪首帧 / EOF 后 pass 透黑底」。
        _sub_dur = self._get_media_duration(
            sub_file, frame_align_fps=self._get_video_framerate(sub_file))
        _win_start, _win_end, _has_window = self._resolve_display_window(
            sub_settings, _sub_dur, input_path=sub_file)
        if win_override:
            # 转场链成员：图层**不位移**（PTS 从 0 起），长度取链内窗口长度。
            # xfade 的两个输入必须同起点，整体位移留给链合成后的 setpts。
            _win_start, _win_end = float(win_override[0]), float(win_override[1])
        # 有限循环次数：仅覆盖窗口时长（节 CPU）。
        # loop 参数 = **重复次数**（总供给 = N+1 遍）→ N = ceil(窗口帧/片段帧) - 1：
        # 窗口=一遍时 N=0（不加 loop），多遍时恰好供满，绝不多回放一整遍
        # （旧公式 ceil 多供一遍 → 回放帧 pts 回退泄漏到 enable 闭区间边界 → 闪首帧）。
        _win_loop = 0
        if _has_window and loop_size and _win_end is not None:
            _wfps = self._get_video_framerate(sub_file)
            if _wfps:
                _win_frames = max(1, int(round((_win_end - _win_start) * _wfps)))
                _win_loop = -(-_win_frames // int(loop_size)) - 1
                if _win_loop < 0:
                    _win_loop = 0

        # ---- 列表轨迹（waypoints）提前解析（2026-09-02 回归修复）----
        # ⚠️ 必须早于下方 need_alpha 判定：航点带显式旋转（ra/rb）或自旋转段时，
        # 子视频要走 rotate=...:c=black@0，而 rotate 在「无 alpha 的输入」上不会产生透明，
        # 边角是「不透明黑」→ 叠加到主视频留黑方块。need_alpha 必须先知道 _wp_rot
        # 才能补 format=rgba。原代码把这段放在 rotate 分支前（晚于 need_alpha），
        # need_alpha 因此看不见航点旋转 → 隐藏回归。
        # 解析结果 _wp_res / _wp_rot 由下方旋转分支与叠加分支直接复用，绝不重复调用。
        _wp_res = None
        _wp_sc = None          # sendcmd 命令文件（f= 选项转义路径）；None=表达式路（行为不变）
        _wp_sc_iv = None       # 与 _wp_sc 配套的区间表（blend 区域 sendcmd 复用，避免重算）
        _wp_sc_x0 = _wp_sc_y0 = "0"   # overlay 占位 x/y = 首命令值（t=0 命令在首帧可能未生效，实测）
        _mv_all = (sub_settings.get('move_mode', '') or '').strip()
        # 🔴 画布模式 × 列表轨迹缩放 共存提示（2026-10-07 复核：互锁已取消，仅提示；
        #    两个缩放都**原样生效并相乘** —— 详见 _sub_canvas_scale_notice docstring）。
        self._sub_canvas_scale_notice(sub_settings, sub_file, where="official")
        if _mv_all == "waypoints":
            _wp_spv = _opt_float(sub_settings.get("spin_speed", 60.0) or 60.0, 60.0)
            _cw0, _ch0 = self._overlay_content_size(sub_file, sub_settings)
            _ts0, _sp0 = _trim_speed_from_settings(main_settings)
            _wp_mv_eff = sub_settings.get("move_waypoints")
            _wp_res = build_waypoint_expr(_wp_mv_eff,
                                          sw=str(_cw0), sh=str(_ch0), spin_speed=_wp_spv,
                                          trim_start=_ts0, speed_factor=_sp0)
            # sendcmd 突破单表达式段数上限（2026-10-01 A 方案，research/ffmpeg-95-seg-limit）：
            # 仅导出链（wp_sendcmd=True）且航点行数 > sendcmd 行数阈值（更多设置可调，
            # 默认 15 = 模块级 _WP_SENDCMD_MIN_ROWS）时切换；≤阈值与旧表达式路逐字节一致。
            # zoom/alpha/angle 仍走表达式。
            if wp_sendcmd:
                try:
                    _sc_min = max(1, min(9999, int(self.wp_sendcmd_min_rows.get())))
                except Exception:
                    _sc_min = _WP_SENDCMD_MIN_ROWS
                _wp_rows = len([w for w in (_wp_mv_eff or [])
                                if isinstance(w, dict)])
                if _wp_rows > _sc_min and _wp_res is not None \
                        and _wp_res[0] is not None:
                    _wp_sc_iv = build_waypoint_position_intervals(
                        _wp_mv_eff,
                        trim_start=_ts0, speed_factor=_sp0)
                    if _wp_sc_iv:
                        _sx, _sy = self._waypoint_sendcmd_offset_suffix(
                            sub_file, sub_settings, _wp_res)
                        _wp_sc = self._write_waypoint_sendcmd_file(
                            # ⚠️ tag 必须与 overlay 完整别名逐字一致（sendcmd 按别名定向，
                            # 不匹配=命令全部落空、子视频钉死占位点 2026-10-01 实测）：
                            # 两处 overlay 都叫 overlay@wps{i}（画布分支/非画布分支）
                            _wp_sc_iv, tag=f"wps{i}", suffix_x=_sx, suffix_y=_sy)
                        if _wp_sc is not None:
                            if _wp_sc_iv[0][2] == "hide":
                                _wp_sc_x0 = _wp_sc_y0 = "-100000"
                            else:
                                _wp_sc_x0 = f"{_wp_sc_iv[0][3]:g}"
                                _wp_sc_y0 = f"{_wp_sc_iv[0][4]:g}"
        # 本版 build_waypoint_expr 返回 (x_expr, y_expr, angle_expr)：angle_expr 已把
        # 「航点显式旋转(ra/rb)」与「自旋转段(mode=spin)」合并在一起 → 非 None 即需要 alpha。
        _wp_rot = (_wp_res is not None and _wp_res[2] is not None)

        # 是否需要 alpha 通道：透明度 / 持续旋转 / 遮罩 / 源视频自带 alpha / 列表轨迹旋转。
        # 仅这些场景才需要 format=rgba；普通不透明叠加保持 YUV，避免多余色域往返（4:4:4）与带宽浪费。
        # （绿幕 chromakey 已由 chain 输出 rgba，无需在此判定）
        need_alpha = (
            sub_settings.get("alpha_enabled", False) or
            sub_settings.get("mask_enabled", False)
        )
        if sub_settings.get("spin_enabled", False):
            _sp_val = _opt_float(sub_settings.get("spin_speed", 60.0), 60.0)
            if _sp_val != 0:
                need_alpha = True
        _ra_val = _opt_float(sub_settings.get("rotate_angle", 0) or 0, 0.0)
        if _ra_val != 0:
            need_alpha = True
        # ⚠️ 列表轨迹旋转 → 需要 alpha（2026-09-02 回归修复）：
        # 不透明源 + 航点旋转时，子链不补 format=rgba → rotate=c=black@0 在无 alpha 输入上
        # 不产生透明（实测 alpha 全 255）→ 叠加到主视频留「不透明黑方块」。
        # 适配水印(_wp_rot2) / 画中画预览(_wp_rotP) 两处 need_alpha 早已含航点旋转 → 无此 bug，
        # 仅子视频正式命令漏（_wp_rot 原本算得太晚，need_alpha 看不见）。
        if _wp_rot:
            need_alpha = True
        # 列表轨迹透明度（oa→ob）：轨道 alpha_expr 非 None → 需 rgba 通道承载
        if _wp_res is not None and _wp_res[4] is not None:
            need_alpha = True
        # 源视频本身带 alpha（透明 mov/webm/APNG/pal8 等）
        _src_pf = self._get_video_pix_fmt(sub_file)
        if _src_pf and self._pix_fmt_has_alpha(_src_pf):
            need_alpha = True

        # 构建子视频滤镜串：统一走 chain（trim/loop/裁剪/旋转/缩放/绿幕/色彩校正/反色 全在 chain 内，
        # 顺序：trim→loop→裁剪→旋转→缩放→绿幕→色彩→反色；绿幕在缩放后=小图抠，色彩段在绿幕后不影响抠像）。
        # 仅当 need_alpha 时补 format=rgba。
        # 画布模式（2026-08-31 两段式）：画布段已接管裁剪/旋转/缩放 → 前置链三者全关，
        # 缩放挪到画布之后做（同一个内容只允许缩一次，否则会被缩两次）。
        _sub_cv_on = self._sub_canvas_on(sub_settings)
        _vf_settings = {**sub_settings, "hw_filter_mode": "cpu", "precise_trim": True}
        if _sub_cv_on:
            _vf_settings["crop_enabled"] = False
            _vf_settings["rotate"] = "none"
            _vf_settings["scale_enabled"] = False
        base_vf = build_video_filter_chain(
            _vf_settings,
            include_subtitle=False,
            include_speed=True,                # 子视频变速生效（音频变速已由 _build_audio_filters 处理）
            include_trim=True,                 # trim 由 chain 内处理（precise_trim + trim_enabled）
            include_format=False,
            reverse=sub_settings.get('reverse_enabled', False),
            enhance_settings=sub_enhance,
            graph_id=f"s{sub_idx}",
            include_fade=include_fade,
            chroma_settings=sub_settings if sub_settings.get("chroma_enabled", False) else None,
            loop_size=loop_size,
            window_start=_win_start, window_end=_win_end, window_loop_count=_win_loop,
        )
        if base_vf == "null":
            base_vf = ""
        if base_vf:
            # 时间基准统一：子视频 PTS 归零（与主视频/画布对齐，避免多输入 overlay 同步基准不一致黑屏）
            sub_vf = f"setpts=PTS-STARTPTS,{base_vf},format=rgba" if need_alpha else f"setpts=PTS-STARTPTS,{base_vf}"
        else:
            sub_vf = "setpts=PTS-STARTPTS,format=rgba" if need_alpha else "setpts=PTS-STARTPTS"
        filter_parts.append(f"[{sub_idx}:v]{sub_vf}[v_temp_{i}]")
        current_sub = f"v_temp_{i}"

        # ---- 子视频画布模式 第 1 段：内容贴到透明画布 → 独立数据流 ----
        # 之后 current_sub 指向画布输出，下游（缩放/自旋转/透明度/轨迹/混合/叠加）
        # 一律把它当独立文件消费，与硬盘上加载一个视频没有区别。
        if _sub_cv_on:
            _tsc, _spc = _trim_speed_from_settings(sub_settings)
            # 2026-10-07 复核：互锁已取消 → 画布段缩放原样生效（与列表缩放相乘）。
            _scg = self._build_sub_canvas_graph(
                sub_settings, sub_file, f"s{i}", f"[v_temp_{i}]", f"v_sc_{i}",
                trim_start=_tsc, speed_factor=_spc)
            if _scg:
                filter_parts.append(_scg)
                current_sub = f"v_sc_{i}"
                # ---- 第 2 段：当作独立文件自由缩放（画布尺寸 → 内容盒尺寸）----
                # 内容盒已随画布模式重算（画布尺寸 × 用户缩放），故叠加尺寸与不开画布
                # 时完全等价 → 下游 overlay 定位 / blend 区域 / spin 对角线零改动。
                _scw, _sch = self._sub_canvas_size(sub_settings, sub_file)[2:4]
                _boxw, _boxh = self._overlay_content_size(sub_file, sub_settings)
                if (_boxw, _boxh) != (_scw, _sch):
                    filter_parts.append(f"[{current_sub}]scale={_boxw}:{_boxh}[v_scs_{i}]")
                    current_sub = f"v_scs_{i}"

        # 透明度
        alpha_enabled = sub_settings.get("alpha_enabled", False)
        alpha_val = sub_settings.get("alpha_value", 1.0)
        # 静态透明度：轨迹透明度存在时跳过——由下方 geq 一并折入（避免两道滤镜重复设 alpha）。
        # 🔴 组内主（group_base，C1）：透明度也**不在此层表达** —— 它作用于**整组**（组员一起
        #    变透明），故整段跳过，由组节点承担（_group_node_transform_parts）。
        if alpha_enabled and 0.0 <= alpha_val <= 1.0 and not group_base \
                and not (_wp_res is not None and _wp_res[4] is not None):
            filter_parts.append(f"[{current_sub}]colorchannelmixer=aa={alpha_val:.2f}[v_alpha_{i}]")
            current_sub = f"v_alpha_{i}"

        # 列表轨迹透明度（oa→ob 段内线性插值）：与静态 alpha_value 串联合成（相乘）；
        # 全 1.0 时 _wp_res[4] 为 None → 跳过（与无任何透明度的老工程行为一致）。
        # 置于静态透明度之后：两道 colorchannelmixer=aa 串联 = alpha_val × 轨迹表达式。
        if _wp_res is not None and _wp_res[4] is not None and not group_base:
            # 🔴 组内主（C1）：轨迹透明度同上，搬到组节点作用于整组。
            # ⚠️ colorchannelmixer=aa 在本 ffmpeg 构建为 init 模式，拒绝求值时变表达式
            #   （含 t 或 max() 会被拒，且逗号会被 filtergraph 当成滤镜分隔符 → "No such filter: 'lt(t'"）。
            #   改用 geq（per-frame 求值）承载时变 alpha：
            #     · geq 时间戳变量是 T（非 t），表达式里独立的 t 须替换为 T：
            #       re.sub(r'\bt\b','T',expr) 只换独立的 t（不动 lt/gte 内的 t，也不动 t0/t_first 等变量名）。
            #     · 必须 format=rgba 确保 alpha 平面，并原样拷贝 r/g/b（r='r(X,Y)' 等函数式取输入像素）。
            #     · ⚠️ geq 表达式返回的是 0~255 原始平面值（非 0~1 归一化，实测 a='1'≈全透明隐形），
            #       故 alpha 乘 255 缩放：a='(静态×255)*(traj_T)'，>255 由 ffmpeg 自动钳到不透明。
            #   ⚠️ 已知限制：geq 在本构建无法读取输入 alpha，故 a 直接设为 轨迹×静态（不乘源素材自带 alpha）。
            #     对不透明水印/视频完全正确；透明 PNG 徽标 + 轨迹淡入会让透明底变不透明（边缘情况，后续可换 alphamerge 方案）。
            _traj_T = re.sub(r'\bt\b', 'T', _wp_res[4])
            _sa = alpha_val if (alpha_enabled and 0.0 <= alpha_val <= 1.0) else 1.0
            filter_parts.append(
                f"[{current_sub}]format=rgba,geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':a='{_sa*255:.0f}*({_traj_T})'[v_tralpha_{i}]")
            current_sub = f"v_tralpha_{i}"

        # 持续旋转（绕中心动态旋转）：在 overlay 之前对子视频图层做 rotate。
        # angle = 转速(度/秒) × π/180 × t，t 为帧时间戳 → 匀速连续旋转。
        # 关键：ow/oh 固定为对角线长度 hypot(iw,ih)（以缩放后水印宽高为基准），
        # 使输出是一个恒大小的正方形画布，旋转全程不裁切、且不随角度抖动；
        # 水印在该正方形内居中旋转，边角填充透明 c=black@0，与现有 rgba/遮罩管线兼容。
        # overlay 的 w/h 自动取该正方形（见 _overlay_sub_size），故 W-w-10 等表达式仍正确。
        # 静态角度(自由角度) + 持续旋转：合并为单个 rotate，避免两次 hypot 旋转变大。
        # 静态角度与文字水印旋转一致：透明层上绕中心旋转、边角透明(c=black@0)，叠加无黑边。
        _ra = _opt_float(sub_settings.get("rotate_angle", 0) or 0, 0.0)
        # ⚠️ spin 必须由 spin_enabled 显式启用：只设静态角度(rotate_angle≠0)而 spin 关闭时，
        # 绝不能把 spin_speed 默认值(60)拼进表达式，否则「只转角度」会变成「角度+自旋转」
        # （预览代码按 _spin and _spd != 0 判定，此处分叉会导致预览与转换不一致）。
        _spin_on = bool(sub_settings.get("spin_enabled", False))
        # ⚠️ _wp_res / _wp_rot 已在上方「列表轨迹提前解析」段算好（必须早于 need_alpha，
        # 否则航点旋转不补 format=rgba → 不透明黑方块）。此处只复用，禁止再算一遍。
        # 🔴 组内主（group_base，模型 B / C1）：旋转**不在此层表达** —— 它必须作用于**整组**
        #    （组员随之一起转），故整段跳过，改由阶段 B 的组节点承担
        #    （`_group_node_transform_parts`）。真机 A/B 实证：留在内容腿 ⇒ 组员不跟随旋转。
        if not group_base and (_spin_on or _ra != 0 or _wp_rot):
            _sp = sub_settings.get("spin_speed", 60.0)
            _sp = _opt_float(_sp, 60.0)
            # 判定必须走唯一真相源（与 _overlay_sub_size 的中心补偿同一口径）：
            # 只要真的要挂 rotate，输出就变成 d×d 包装盒，下游必须做中心对齐补偿。
            if overlay_rotation_active(sub_settings, wp_rot=_wp_rot):
                _angle_expr = ""
                if _ra != 0:
                    _angle_expr = f"{_ra}*PI/180"
                if _wp_rot:
                    # 列表自旋转覆盖全局 spin：仅列表标记「自旋转」的时段旋转（边移边转）
                    if _angle_expr:
                        _angle_expr += " + "
                    _angle_expr += f"({_wp_res[2]})"
                elif _spin_on and _sp != 0:
                    if _angle_expr:
                        _angle_expr += " + "
                    _angle_expr += f"{_sp}*PI/180*t"
                filter_parts.append(
                    f"[{current_sub}]rotate=angle='{_angle_expr}':"
                    f"ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[v_spin_{i}]"
                )
                current_sub = f"v_spin_{i}"

        # ---- 列表轨迹缩放（2026-09-04）：必须挂在 rotate 之后 ----
        # 实测（ffmpeg n9.0.1）：逐帧变尺寸的 scale 若排在 rotate 前，rotate 的 ow/oh
        # 锁死在首帧对角线 → 放大后的内容被裁；排在 rotate 之后则 overlay 的 w/h 逐帧
        # 跟随（eval 默认 frame），位置正确。
        # 用 iw/ih **相对**表达 → 不必知道旋转画布 d×d / 画布模式 / 静态角度下盒子的实际尺寸。
        # max(2,...) 兜底：倍率极小时 2*round(iw*z/2) 会被 round 成 0（scale w=0 直接报错）；
        # setsar=1：变尺寸会让 SAR 逐帧漂移（实测 16/15→33/31）。
        _wp_zoom = bool(_wp_res is not None and _wp_res[3] is not None)
        # 列表轨迹缩放 sendcmd 驱动（长列表突破表达式段数墙，2026-10-08）：与 px/py 同阈值
        # （wp_sendcmd + 航点行数 > _sc_min）且存在缩放变化时，把子链 zoom scale 节点改名
        # scale@slr{i} 并挂 sendcmd（值 = max(2,2*round(iw*(s)/2))，s 为倍率因子区间表，
        # BASE=运行时 iw/ih）。阈值内 / 无缩放变化保持原表达式路（max(2,2*round(iw*(zoom)/2))）。
        # 🔴 铁律不变：format=rgba 仍由下方 blend 块在 scale 之前就地插入（见 _make_blend_region
        # 第 3 步）；sendcmd 只驱动 w/h，不移动 format 位置。
        _wp_scale_sc = None
        _wp_scale_z0 = None
        if wp_sendcmd and _wp_zoom and _wp_rows > _sc_min:
            try:
                _wp_scale_iv = build_waypoint_scale_intervals(
                    sub_settings.get("move_waypoints"), trim_start=_ts0, speed_factor=_sp0)
            except Exception:
                _wp_scale_iv = None
            if _wp_scale_iv:
                _wp_scale_sc = self._write_waypoint_sendcmd_file(
                    _wp_scale_iv, tag=f"slr{i}", cmd_style="scale",
                    target=f"scale@slr{i}", scale_base_w="iw", scale_base_h="ih",
                    scale_min=2)
                _wp_scale_z0 = _wp_scale_iv[0][3]
        # blend 也支持列表轨迹缩放（2026-10-07 方案 A）：隔离窗口已改成**静态包围盒**
        # （_make_blend_region），crop w/h 只在 init 求值的铁律不再适用；包围盒由
        # _blend_wp_place_rects 按 z(t) 采样端点放大（box_w*z、左上 = x - z*off），
        # 动的是「落位 overlay」→ z(t) 任意变化都被完整容纳，不再被忽略。
        # 🔴⚠️ 铁律（真机 2026-10-07 像素级实证）：blend 路径下**必须把 format=rgba 提到
        #    逐帧 scale 之前**。blend 的落位是「overlay 到透明画布」，overlay 副输入一旦
        #    带 α，framesync 走带 α 的尺寸协商路径 → 逐帧变尺寸 scale 失效、z(t) 锁死首帧
        #    （用户报「整体都变大、没有缩回」）。A/B 对照（320x240 主 + 80x60 白子视频，
        #    量白块可见宽度）：format 独立段在 scale 后 → 160/160/160/160（锁死）；
        #    提到 scale 前 → 148/120/88/80（随 z(t)=1.93→1 正确缩回）。
        #    ⚠️ 非 blend 的普通叠加不需 format=rgba、同样正常 → 该问题只属 blend 路径。
        if _wp_zoom and (sub_settings.get('blend_mode', 'normal')
                         or 'normal').strip().lower() != 'normal':
            filter_parts.append(f"[{current_sub}]format=rgba[v_zrgba_{i}]")
            current_sub = f"v_zrgba_{i}"
        # 🔴 组内主同理（C1）：轨迹缩放必须作用于**整组**（组节点），不在内容腿表达。
        if _wp_zoom and not group_base:
            if _wp_scale_sc is not None:
                # sendcmd 驱动 scale@slr{i}：首帧占位=首区间倍率（避免首帧 glitch）。
                # ⚠️ 值含逗号（max(2,...)）必须整体单引号包裹，否则 filtergraph 把逗号当
                # 滤镜分隔符 → "No option name near 'max(2'"。与非 sendcmd 分支（下方
                # w='max(2,...)'）保持一致。
                _zw0 = f"'max(2,2*round(iw*({_wp_scale_z0:g})/2))'"
                _zh0 = f"'max(2,2*round(ih*({_wp_scale_z0:g})/2))'"
                filter_parts.append(
                    f"[{current_sub}]sendcmd=f='{_wp_scale_sc}'[v_zsc_{i}];"
                    f"[v_zsc_{i}]scale@slr{i}=w={_zw0}:h={_zh0}:eval=frame,setsar=1[v_zm_{i}]"
                )
            else:
                filter_parts.append(
                    f"[{current_sub}]scale=w='max(2,2*round(iw*({_wp_res[3]})/2))'"
                    f":h='max(2,2*round(ih*({_wp_res[3]})/2))':eval=frame,setsar=1[v_zm_{i}]"
                )
            current_sub = f"v_zm_{i}"
        if canvas:
            # 画布统一方案（2026-09-25）：把内容（含位置/轨迹/旋转，定位走 _pip_overlay_xy）
            # 烙进一张统一透明画布（黑@0，尺寸=输出画布）——xfade 链内天然同尺寸，
            # 各段的位置/轨迹/旋转全部保留；透明处在最终 overlay 时透出主视频。
            _cw, _chh, _cfps, _clen = canvas
            if xy_override is not None:
                # 组成员（2026-10-16）：定位 = **包装盒内相对坐标**（`_group_box_geometry`
                # 的 "rel"）——组画布已是包装盒尺寸，成员坐标必须同步减去包装盒原点。
                # 组内主同样走这里（它的相对坐标 = (dx,dy)，一般 (0,0)）。
                _x, _y = str(xy_override[0]), str(xy_override[1])
            elif group_base:
                # 组内主（C1）：组画布尺寸 = 它的**非旋转内容盒** ⇒ 裸内容正好铺满，
                # 定位固定 0:0。自身姿态（定位/旋转/轨迹）已跳过 → 由组节点作用于整组。
                _x, _y = "0", "0"
            elif _wp_sc is not None:
                # sendcmd 模式：位置由命令文件驱动，overlay x/y 只作首帧占位
                _x, _y = _wp_sc_x0, _wp_sc_y0
            else:
                _x, _y = self._pip_overlay_xy(sub_file, sub_settings,
                                              _wp_res, _wp_rot, _spin_on, _ra, _wp_zoom)
            filter_parts.append(
                f"color=c=black@0:s={int(_cw)}x{int(_chh)}:r={_cfps:.6g}:d={_clen:.6g}"
                + (f",sendcmd=f='{_wp_sc}'" if _wp_sc is not None else "")
                + f"[cbase_{i}]")
            # shortest=1：画布是链成员时长的权威。子 movie 实际帧数可能比画布 d 多 1 帧
            # （帧率取整悬摆，如 14.233s 素材 vs 14.2s 画布），overlay 默认 repeatlast 会把
            # 这 1 帧喂进 xfade 链 ⇒ 下级 xfade 的 blend 终点帧与本级 EOF 交界死锁，
            # ffmpeg/mpv 双双内存爆炸卡死（2026-09-26 实测：41.2s 处 25GB，加 shortest=1 后
            # 全片干净跑完 548MB）。
            # 4.3 alpha 主输入 overlay 负坐标 bug：sendcmd 模式命令值可为负 → format=rgb 绕开
            # （无 sendcmd 时负 x/y 走表达式求值不受影响，保持原样不动）
            _brand_fix = _overlay_sc_fmt_suffix() if _wp_sc is not None else ""
            # canvas_shortest（见函数 docstring）：转场链=True（画布=时长权威，防 xfade
            # 死锁）；画中画分组=False（组内无 xfade，改由画布首输入定长）。
            _sc_opt = ":shortest=1" if canvas_shortest else ""
            filter_parts.append(
                f"[cbase_{i}][{current_sub}]overlay@wps{i}=x='{_x}':y='{_y}'{_sc_opt}{_brand_fix}[vc_{i}]")
            current_sub = f"vc_{i}"
        if extra_tail:
            # 转场链归一：精确限长 + 统一帧率/SAR/像素格式（尺寸已由画布合成保证）
            filter_parts.append(f"[{current_sub}]{extra_tail}[v_xt_{i}]")
            current_sub = f"v_xt_{i}"

        return filter_parts, current_sub, {
            "wp_res": _wp_res, "wp_rot": _wp_rot, "spin_on": _spin_on, "ra": _ra,
            "wp_zoom": _wp_zoom, "has_window": _has_window,
            "need_alpha": need_alpha,
            "win_start": _win_start, "win_end": _win_end,
            # sendcmd 航点（2026-10-01）：阶段 B（_build_overlay_filter_complex）的非画布
            # normal 分支也要用——必须经 _meta 跨函数传递，局部变量过不去（AST 审计抓过）。
            # ⚠️ wp_sc_iv 同理：blend 区域 sendcmd 要用同一张区间表重写 blend{i} 命令文件
            # （crop@cr{i} + overlay@ov{i} 双目标），漏传 → 阶段 B NameError（2026-10-06 真机崩）。
            "wp_sc": _wp_sc, "wp_sc_x0": _wp_sc_x0, "wp_sc_y0": _wp_sc_y0,
            "wp_sc_iv": _wp_sc_iv,
        }

    def _group_node_transform_parts(self, g, in_label, sub_settings, meta):
        """组节点（模型 B / C1 裁剪式，2026-10-15 真机 A/B 定案）的「旋转 + 轨迹缩放」段。

        C1 下组内主的内容腿**跳过**了 定位/旋转/轨迹缩放（调用处传 `group_base=True`），
        这些段改在**组节点**上表达 ⇒ 作用于**整组**（组员随之一起转 / 一起缩）。
        逻辑镜像 `_build_sub_layer_node` 的同名两段（**那里为准，改一处必查另一处**）。
        此处不需要两个特例：
          · sendcmd：只在长航点列表时启用；组内主已强制走表达式路（调用方传 wp_sendcmd=False）；
          · blend 的「format=rgba 提到逐帧 scale 之前」：那是「子视频与主视频像素混合」的补丁，
            而**组内主为 blend 的组已在分组规划阶段整组降级**（B 语义下组内主是"组的底"，
            不与主视频混合）。

        返回 (filter_parts, out_label)（无段可加时 out_label == in_label）。
        """
        parts = []
        cur = in_label
        _wp_res = meta.get("wp_res")
        _wp_rot = meta.get("wp_rot")
        _spin_on = meta.get("spin_on")
        _ra = meta.get("ra")
        _wp_zoom = meta.get("wp_zoom")
        # ---- 透明度（静态 + 轨迹）：C1 下这两段也从内容腿搬到组节点 ⇒ 作用于**整组** ----
        # 顺序与图层一致：静态透明度 → 轨迹透明度 → 旋转 → 轨迹缩放 → 定位。
        _alpha_enabled = sub_settings.get("alpha_enabled", False)
        _alpha_val = sub_settings.get("alpha_value", 1.0)
        _wp_alpha = _wp_res[4] if (_wp_res is not None and len(_wp_res) > 4) else None
        if _alpha_enabled and 0.0 <= _alpha_val <= 1.0 and _wp_alpha is None:
            _nl = f"v_grp_a_{g}"
            parts.append(f"[{cur}]colorchannelmixer=aa={_alpha_val:.2f}[{_nl}]")
            cur = _nl
        if _wp_alpha is not None:
            # 与图层同一手法（geq 承载时变 alpha，T 为时间戳变量；表达式返回 0~255）：
            # ⚠️ 已知限制同图层：geq 读不到输入 alpha，故 a 直接 = 轨迹×静态。
            _traj_T = re.sub(r'\bt\b', 'T', _wp_alpha)
            _sa = _alpha_val if (_alpha_enabled and 0.0 <= _alpha_val <= 1.0) else 1.0
            _nl = f"v_grp_ta_{g}"
            parts.append(
                f"[{cur}]format=rgba,geq=r='r(X,Y)':g='g(X,Y)':b='b(X,Y)':"
                f"a='{_sa*255:.0f}*({_traj_T})'[{_nl}]")
            cur = _nl
        if _spin_on or _ra or _wp_rot:
            _sp = _opt_float(sub_settings.get("spin_speed", 60.0), 60.0)
            if overlay_rotation_active(sub_settings, wp_rot=_wp_rot):
                _angle_expr = ""
                if _ra:
                    _angle_expr = f"{_ra}*PI/180"
                if _wp_rot:
                    if _angle_expr:
                        _angle_expr += " + "
                    _angle_expr += f"({_wp_res[2]})"
                elif _spin_on and _sp != 0:
                    if _angle_expr:
                        _angle_expr += " + "
                    _angle_expr += f"{_sp}*PI/180*t"
                _nl = f"v_grp_spin_{g}"
                parts.append(
                    f"[{cur}]rotate=angle='{_angle_expr}':"
                    f"ow='hypot(iw,ih)':oh='hypot(iw,ih)':c=black@0[{_nl}]")
                cur = _nl
        if _wp_zoom:
            _nl = f"v_grp_zm_{g}"
            parts.append(
                f"[{cur}]scale=w='max(2,2*round(iw*({_wp_res[3]})/2))'"
                f":h='max(2,2*round(ih*({_wp_res[3]})/2))':eval=frame,setsar=1[{_nl}]")
            cur = _nl
        return parts, cur

    def _group_node_xy(self, sub_file, sub_settings, meta, geo, grp_scaled_size=None,
                       wp_move=False, row_settings=None):
        """组节点（整只**包装盒**）在主画布上的 x/y 表达式（模型 B / C1，2026-10-16）。

        两处修正（相对「直接把组内主落位表达式拿来用」）：
          ① **+ 包装盒原点修正 (dx,dy)**：C1 下组的整体落位仍由组内主 overlay_x/y 表达，
             而组节点承载的是整只包装盒（原点 = 各成员矩形并集左上角）；组内主在盒子里
             偏了 (dx,dy) ⇒ 落位必须补上，否则整盒相对组内主错位。
          ② **旋转中心对齐改用包装盒尺寸**：rotate 挂在组节点上、作用在包装盒 (PW×PH)
             ⇒ 中心对齐偏移必须按 (PW,PH)→d×d（d=hypot）算；按组内主自己的内容盒算会
             让整盒偏移 (d_g−d_b)/2（旋转越大越明显）。
          非旋转、且组内主恰在并集左上角（dx=dy=0）时 = 旧表达式**逐字符一致**。

        grp_scaled_size（(sw,sh)|None，2026-10-16 修「缩放组旋转上偏」）：组父行（独立素材）
        缩放后的包装盒尺寸。组节点上的 rotate 作用在**缩放后**的包装盒上（`node_material_chain`
        的 scale 在 rotate 之前插入）⇒ 旋转中心对齐的两端（内容 = 缩放盒、叠加盒 = 缩放盒的
        d×d）都必须按缩放后尺寸算；按未缩放 geo 算会令整盒偏移 (1-scale)·(d-PW)/2（用户实测
        「缩放 + 旋转」上偏）。None = 未缩放（老工程逐字节一致）。

        wp_move（bool，2026-10-16 第七轮②**父行列表轨迹**）：True ⇒ `meta["wp_res"]` 来自
        **父行素材项**（`_group_material_wp_res`），此时：
          · `move_mode` 被强制成 "waypoints" 交给 `_pip_overlay_xy`（只有这个键 gate 航点路；
            该函数里其余尺寸口径一律仍按 **组内主** 的 settings 算，故只覆写这一个键）；
          · **不做** `geo["base"]` 盒原点修正 —— 航点值本身已是「整盒左上角」的主画布绝对
            坐标（与 `grp_abs_x/y` 同域），再减一次会偏 2·base（见 `_group_material_wp_res`）。
        False = 旧口径（**默认**，老工程逐字节一致）。

        row_settings（dict|None，2026-10-18 用户第 3 条**父行自旋转 / 预制轨迹**）：
        `_group_material_row_proj` 的投影（`move_mode` 预制四模式 + 自旋转两键）。只把这
        几个键覆写进喂 `_pip_overlay_xy` 的副本，**不碰** `rotate_angle`/overlay_x/y
        （那两处口径必须保持「组内主原样」，见预览侧对 `_sess_pv` 的同类注释）。
        预制轨迹同时把运动幅度改成**包装盒尺寸**（`move_size=_sc`）—— 移动的是整只盒。
        None = 旧口径（老工程逐字节一致）。
        ⚠️ **契约**：父行自旋转要让本函数的 d×d 补偿生效，调用方必须同时把
        `meta["spin_on"]=True`（导出/预览两处组分支都已注入）—— 判据与
        `_pip_overlay_xy` 的 `_rot_ov` 逐字同口径，只认 meta 不认 settings。

        🔴 旋转判据用 `overlay_rotation_active(_ss_xy, wp_rot=meta["wp_rot"])`（不是只看
        `geo["rot"]`）：父行自旋转 / 父行航点角度都会让组节点产出 d×d 包装盒，此时
        `geo["rot"]` 仍可能是 None（几何只读组内主自己的设置）⇒ 不补 d×d 会让整盒偏
        (d−PW)/2。组内主自身有旋转时两判据同真 ⇒ 与旧结果**逐字符一致**。
        """
        _ss_xy = dict(sub_settings or {})
        if wp_move:
            _ss_xy["move_mode"] = "waypoints"
        if row_settings:
            for _rk in self._GROUP_ROW_FX_KEYS:
                if _rk in row_settings:
                    _ss_xy[_rk] = row_settings[_rk]
        # 🔴 旋转判据必须与 `_pip_overlay_xy` 内的 `_rot_ov` **逐字同口径**（那才是真正
        #   决定插不插 rotate 的地方）：`(spin_on and spv≠0) or (ra≠0) or wp_rot`。
        #   不能用 `overlay_rotation_active(_ss_xy)` 单独判：
        #     · 组级角度走 `meta["ra"]`（`grp_rot_angle` 注入进 `_gs`，**不在** `_ss_xy`）
        #       ⇒ 只看 settings 会漏（D7 实测：geo.rot=None + ra=30 时补偿按 PW×PH 算，
        #          整盒偏 (d−PW)/2 —— 正是用户说的「开角度就撑开/偏移」同类问题）；
        #     · 父行自旋转是 `spin_on`（meta）+ spin_speed（row_settings）两处拼起来的。
        #   `_spv` 与 `_pip_overlay_xy` 同款 `or 60.0`（显式 0 视为未填 → 60）。
        _spv_now = _opt_float(_ss_xy.get("spin_speed", 60.0) or 60.0, 60.0)
        _rot_now = (bool(meta.get("spin_on")) and _spv_now != 0) \
            or (_opt_float(meta.get("ra", 0) or 0, 0.0) != 0) \
            or bool(meta.get("wp_rot"))
        if grp_scaled_size is not None:
            _sw, _sh = float(grp_scaled_size[0]), float(grp_scaled_size[1])
            _sc = (_sw, _sh)
        else:
            _sc = geo["size"]
        if geo["rot"] or _rot_now:
            _d = max(2, int(round((_sc[0] * _sc[0] + _sc[1] * _sc[1]) ** 0.5)))
            _sb = (_d, _d)
        else:
            _sb = _sc
        _x, _y = self._pip_overlay_xy(
            sub_file, _ss_xy, meta["wp_res"], meta["wp_rot"], meta["spin_on"],
            meta["ra"], meta["wp_zoom"],
            shift_content_wh=_sc, shift_box_wh=_sb,
            # 预制轨迹：运动对象 = 整只包装盒（缩放后尺寸，与 shift_* 同域）
            move_size=(_sc if (row_settings or {}).get("move_mode") else None))
        if wp_move:
            return _x, _y
        _dx, _dy = geo["base"]
        # 🔴 盒原点修正**（减，不是加）**：`overlay_x/y` 是**组内主**的落位，`_group_node_xy`
        # 要返回的是**整只包装盒**的落位。盒原点 = 组内主落位 − 组内主相对盒原点偏移
        # （`geo["base"] = 组内主矩形左上 − 盒并集原点`，恒 ≥ 0，因为原点取成员并集最小角）。
        # 故 组节点 X = overlay_x − base_dx（导出/预览共用同一真相源；符号反了会令整盒错位
        # 2·base_dx，旋转后更严重 —— 用户实测「旋转左上偏」即此）。base_dx=0（组内主恰在
        # 并集左上角）时 −0 与旧 +0 逐字符一致 ⇒ 老工程零回归。
        # ⚠️ 原表达式可能含逗号函数（mod/min/max）⇒ 拼接前必须整体括号包裹，
        #    否则 filtergraph 把逗号当滤镜分隔符（同 _pip_overlay_xy 内既有写法）。
        if _dx:
            _x = "(%s) - %g" % (_x, _dx)
        if _dy:
            _y = "(%s) - %g" % (_y, _dy)
        return _x, _y

    def _group_final_label_key(self, gid, mem_count):
        """组最终输出标签 → 节点指纹 key（**不触发** `_ensure_node_graphs_current`）。

        与 `_node_key_of_label` 同口径，但后者会重构图、在构图过程中调用会递归 —— 本函数
        只读缓存的干净图 `_last_graph_base`（上一代构图快照），构图期安全。缓存缺失 / 找不到
        → None（调用方按「未缩放」处理，退化安全）。
        """
        # 🔴 2026-10-17 Point 4 方案A：父行 key 改为**稳定语义 key** `grp:<gid>`
        # （只依赖 gid，永不因图结构位移而漂）。原 `node_fingerprint(段序号,末滤镜名)` 取
        # 图内位置，单画布 A3 重构 / 成员增减会漂 ⇒ 存好的父行效果变孤儿被清。
        # 标签 `v_grp_<gid>_<n>` 本身只依赖 gid，故 key 直接 `grp:<gid>`；与
        # `node_fx_key_of_node` / `_node_key_of_label` / key2seg 构建点同口径。
        # 无需构图（gid 已知）；缓存缺失也照样能算（比旧 `None` 退化更安全）。
        return "grp:%s" % gid

    def _group_material_scaled_size(self, geo_size, key):
        """组父行（独立素材）缩放/裁剪后的包装盒尺寸 (sw,sh)；都没开 / 找不到素材项 → None。

        组节点上的 rotate 作用在**缩放后**的包装盒上（`node_material_chain` 的 scale 在 rotate
        之前插入）⇒ 旋转中心对齐的两端都要用缩放后尺寸（2026-10-16 修「缩放组旋转上偏」）。
        None ⇒ 调用方走旧口径（未缩放 geo），老工程逐字节一致。
        """
        _w, _h = geo_size
        _it = self._group_material_item(key) if key else {}
        if not _it or not (_it.get("scale_enabled", False)
                           or _it.get("crop_enabled", False)):
            return None
        try:
            _rs = {
                # 🔴 2026-10-18 审计：父行 **crop** 也会改变组节点**实际输入尺寸**（裁完的
                #    画面才是 overlay 的输入），而 `_group_node_xy` 的旋转中心补偿必须按
                #    真实输入尺寸算 ⇒ crop 与 scale 一样要折进来。此前只认 scale ⇒
                #    「父行裁边 + 组旋转」时 d×d 补偿按未裁盒算，整组偏移 (裁掉)/2。
                #    `rotate` 恒 "none"：整组角度的旋转由组节点承载（grp_rot_angle），
                #    这里再转一次就是双重旋转。
                "crop_enabled": bool(_it.get("crop_enabled", False)),
                "crop_width": _it.get("crop_width", ""),
                "crop_height": _it.get("crop_height", ""),
                "crop_left": _it.get("crop_left", "0"),
                "crop_top": _it.get("crop_top", "0"),
                "scale_enabled": _it.get("scale_enabled", False),
                "scale_method": _it.get("scale_method", "width"),
                "scale_width": _it.get("scale_width", ""),
                "scale_height": _it.get("scale_height", ""),
                "rotate": "none",
            }
            return self.compute_final_size_with_order(int(_w), int(_h), _rs)
        except Exception:
            return None

    def _group_place_delta(self, base_settings):
        """组的整体落位增量 (dx, dy)（主画布像素）；缺省 / 非法 → (0.0, 0.0)。"""
        _ss = base_settings if isinstance(base_settings, dict) else {}
        _out = []
        for _k in ("grp_dx", "grp_dy"):
            try:
                _out.append(float(str(_ss.get(_k, "") or 0) or 0))
            except (TypeError, ValueError):
                _out.append(0.0)
        return _out[0], _out[1]

    def _group_place_xy(self, base_settings, x_expr, y_expr):
        """组节点落位的**唯一读取口径**：`_group_node_xy` 结果 + 组级增量。

        ⚠️ 表达式可能含逗号函数（mod/min/max）⇒ 加 delta 前必须整体括号包裹
        （同 `_group_node_xy` 内既有写法，否则 filtergraph 把逗号当滤镜分隔符）。
        delta 为 0（缺省）时**返回原串**，与改动前逐字符一致。
        """
        _dx, _dy = self._group_place_delta(base_settings)
        if _dx:
            x_expr = ("(%s) + %g" % (x_expr, _dx)) if _dx > 0 else ("(%s) - %g" % (x_expr, -_dx))
        if _dy:
            y_expr = ("(%s) + %g" % (y_expr, _dy)) if _dy > 0 else ("(%s) - %g" % (y_expr, -_dy))
        return x_expr, y_expr

    def _group_place_abs(self, base_settings):
        """组的**绝对落位** (x, y)（主画布像素）；没设过 → (None, None)。

        与 `_group_place_delta` 是同一族的**组级字段**（存在组内主的 enc_settings，
        语义上是"组"的属性，不是成员的属性）。来源 = 列表虚拟父行设置窗里的
        「叠加位置 X/Y」数字框（2026-10-16）：父行是**投影**，不能去改成员的
        overlay_x/y，只能把"整组该落在哪"记成组自己的绝对坐标。

        ⚠️ 与增量互斥：给了绝对值就**不再叠加** delta（否则两套落位相加必漂移）。
        可视化编辑器拖动组合盒时会把这两个键删掉、改回增量。
        ⚠️ 值可以是表达式（与主画布 overlay_x/y 同域：`W`/`H` = 主画布，`w`/`h` =
        包装盒）—— 所以这里**不求值**，原样交给 filtergraph。纯数字会顺手转成 float
        （UI 画框要用），表达式则保留字符串（画框时回退到增量位置）。
        """
        _ss = base_settings if isinstance(base_settings, dict) else {}
        _out = []
        for _k in ("grp_abs_x", "grp_abs_y"):
            _v = str(_ss.get(_k, "") or "").strip()
            if not _v:
                _out.append(None)
                continue
            try:
                _out.append(float(_v))
            except (TypeError, ValueError):
                _out.append(_v)
        return _out[0], _out[1]


    def _build_overlay_filter_complex(self, main_idx: int, main_settings: dict,
                                       sub_infos: List[Tuple[int, str, dict]],
                                       include_subtitle_main: bool = False,
                                       enhance_settings: Optional[dict] = None,
                                       reverse: bool = False,
                                       main_file_path: str = "",
                                       main_tail_pad: Optional[float] = None,
                                      main_effective_duration: Optional[float] = None,
                                      include_fade: bool = True,
                                      node_fx_override: Optional[dict] = None,
                                      node_fx_record_raw: bool = False,
                                      wp_sendcmd: bool = False,
                                      tail_pad_alpha: bool = False
                                      ) -> Tuple[str, str]:
        """
        构建主视频 + 多个子视频（画中画/水印）的 filter_complex 字符串。
        注意：此函数不会在 overlay 中添加 shortest=1，避免子视频流结束导致输出提前截断。
        输出结束由全局 -shortest 控制。

        main_tail_pad（秒，画中画专用）：主视频尾部需补的黑帧时长——子素材被摆到主视频
        之后时，底必须真的接长（overlay 主输入 EOF = 整链 EOF，只改 -t 无效）。
        None / 0 = 不补帧，行为与旧调用方（缩略图/contact sheet/水印）逐字节一致。

        main_effective_duration（秒，画中画专用）：主视频有效时长（与 -t 同源）。只在该参数
        给出、且主视频自身也勾了转场时，主视频才可能成为转场链的首段。None = 主视频不进链
        （其余 4 处调用方的旧行为，逐字节一致）。

        tail_pad_alpha（画中画专用，2026-10-12）：补的帧用**透明**（`color=black@0`）而不是不透明
        黑。仅当输出需要 alpha（`_pip_needs_alpha`：主视频透明 **或** 主视频之后那段里显示的子
        视频带透明）时由 `_build_pip_cmd` 传 True —— 那段没有主视频垫底，补帧若是不透明黑，子
        视频的透明就被黑垫掉，导出的 .mov 的 alpha 会全填 255（白升 alpha 编码器）。
        默认 False ⇒ 不透明工程与旧版逐字节一致。
        """
        filter_parts = []
        # ---- 多子视频混合模式提示（仅日志，不阻止生成） ----
        # 08:25 起已实现 blend 区域隔离：≥2 个非 normal blend 子视频时，主视频 split 出
        # 原始帧副本，每个 blend 只在自己区域与原始帧混合 → 互不干涉（旧警告「多个叠加
        # 互相干涉、结果不可预测」已过时，勿回退）。此处仅保留一条简短提示说明行为。
        if len(sub_infos) >= 2:
            blended = []
            for _mi, _mf, _ms in sub_infos:
                _bm = (_ms.get("blend_mode", "normal") or "normal").strip().lower()
                if _bm and _bm != "normal":
                    blended.append(_bm)
            if len(blended) >= 2:
                self._append_info_ui(
                    _("ℹ️ 多个子视频使用混合模式(%s)：已启用区域隔离，每个混合只作用于"
                    "自己的矩形区域（互不干涉）；重叠区域按叠加顺序覆盖。混合模式按像素"
                    "重算主+子区域，非透明贴纸语义。") % "/".join(blended)
                )
        # 画中画/水印走 filter_complex，强制软件滤镜避免显存/内存混用导致叠加失败
        # ---- 主视频画布模式（位置、尺寸、旋转）----
        # 2026-09-02 开放（用户拍板，抄统一尝试版 21657）：此前画布段只支持「转换页主视频」与
        # 「子视频」，画中画/水印的**主视频**完全没有 → 想让主视频自己也做入场运动，只能
        # 「克隆一个主视频拖到子视频位、再把真主视频藏起来」绕（用户实测可行但别扭）。
        # 注入点即本函数（画中画/缩略图/contact sheet/转码页图片水印四处共用）。
        _canvas_on = bool(main_settings.get("canvas_mode")) and bool(main_settings.get("canvas_segments"))
        main_settings_sw = dict(main_settings)
        main_settings_sw["hw_filter_mode"] = "cpu"
        if _canvas_on:
            # 画布接管位置/尺寸/旋转 → 链内静态缩放/裁剪/旋转必须关，否则双重变换（尺寸错配）
            main_settings_sw["crop_enabled"] = False
            main_settings_sw["scale_enabled"] = False
            main_settings_sw["rotate"] = "none"
        # 主视频是静态图片（单帧、无时间轴）：setpts=PTS-STARTPTS 会把这张单帧图的时间戳
        # 处理成 overlay 无法与子视频对齐，结果叠加层被整体丢弃（预览只剩原图、水印/子视频
        # 完全不出现）。改用恒等 setpts=PTS+0/TB（与 build_seek_frame_cmd 对静态主输入的
        # 口径一致），让图片原样参与 overlay（实测 rc=0 且叠加层正常出现）。
        _main_static = bool(main_file_path) and _is_static_image_file(main_file_path)
        _main_setpts = "setpts=PTS+0/TB" if _main_static else "setpts=PTS-STARTPTS"
        main_vf = build_video_filter_chain(
            main_settings_sw,
            include_subtitle=include_subtitle_main,
            include_speed=True,
            reverse=main_settings.get('reverse_enabled', False),
            enhance_settings=enhance_settings,
            graph_id=f"m{main_idx}",
            include_fade=include_fade,
            clip_duration=self._get_media_duration(main_file_path) if main_file_path else None,
            # 2026-10-09：画中画/水印主视频也支持绿幕抠像（抠图 → 输出透明素材）。
            # 缩略图/contact sheet 等旧调用方无 chroma 键 → None，行为逐字节一致。
            chroma_settings=main_settings if main_settings.get("chroma_enabled", False) else None,
            include_alpha=True,   # 主视频透明度（子视频走 overlay 构建器，不受影响）
        )
        if main_vf and main_vf != "null":
            # 时间基准统一：主视频 PTS 归零（color 画布从 0 开始），避免源视频起始 PTS 非 0
            # 导致 overlay 前面几帧黑屏（画中画多输入同步基准必须一致）
            filter_parts.append(f"[{main_idx}:v]{_main_setpts},{main_vf}[v_main_proc]")
            current_v = "v_main_proc"
        else:
            filter_parts.append(f"[{main_idx}:v]{_main_setpts}[v_main_proc]")
            current_v = "v_main_proc"

        # ---- 主视频画布段（第 1 段）：内容贴到**不透明黑画布** → 独立数据流 ----
        # ⚠️ 两条钳制（缺一即错位/重复，改前必看 build_canvas_filtergraph）：
        #   1) base_vf="" —— 主视频前置链（trim/增强/字幕/变速/倒放…）已由上方
        #      build_video_filter_chain 构建并生效；base_vf=None 会让画布函数用 settings
        #      **再跑一遍** base chain，增强/变速被应用两次。
        #   2) 主视频画布颜色="black"（不透明，画布本身就是最终背景；子视频才用 black@0）。
        if _canvas_on:
            try:
                _mw, _mh = (None, None)
                if main_file_path:
                    _mw, _mh = self._get_video_dimensions_cached(main_file_path)
                if not _mw or not _mh:
                    _mw, _mh = 1280, 720
                _mts, _msp = _trim_speed_from_settings(main_settings)
                _mcg = build_canvas_filtergraph(
                    main_settings, _mw, _mh, _mts, _msp,
                    src_label=f"[{current_v}]", out_label="v_main_canvas",
                    canvas_color="black", base_vf="", tag="mc")
            except Exception:
                _mcg = None
            if _mcg:
                filter_parts.append(_mcg)
                current_v = "v_main_canvas"
                # ---- 第 2 段（2026-09-02 修复）：主视频画布此前缺这步 → 主视频自身缩放被忽略，
                # 内容恒按原始 1920 渲染（用户实测「缩放1280 却按1920运动进来」）。
                # 与子视频画布第 2 段完全等价：把画布窗口（原始/裁剪框尺寸）按主视频渲染缩放
                # 重算「内容盒尺寸」，使主视频「缩放」在画布模式下被正确尊重，下游零改动。
                try:
                    _mcw, _mch = _resolve_crop_size(main_settings, _mw, _mh) or (_mw, _mh)
                    _mbbw, _mbbh = compute_rendered_size(
                        _mcw, _mch,
                        {**main_settings, "crop_enabled": False, "rotate": "none"})
                    _mbbw, _mbbh = max(2, int(_mbbw)), max(2, int(_mbbh))
                    if (_mbbw, _mbbh) != (_mcw, _mch):
                        filter_parts.append(f"[{current_v}]scale={_mbbw}:{_mbbh}[v_main_canvas_s]")
                        current_v = "v_main_canvas_s"
                except Exception:
                    pass
                with suppress(Exception):
                    self._append_info_ui(
                        _("[画布模式] 主视频画布（画中画）已启用：内容基准 %dx%d，"
                        "运动时间已按 trim/speed 换算到输出时间线") % (_mw, _mh))
            else:
                with suppress(Exception):
                    self._append_info_ui(
                        _("[画布模式] 主视频画布段生成失败（尺寸/段数据异常），已按普通主视频处理"))

        # 主视频画布偏移
        pad_enabled = main_settings.get('pad_enabled', False)
        if pad_enabled:
            pw = main_settings.get('pad_width', '').strip()
            ph = main_settings.get('pad_height', '').strip()
            if pw and ph:
                ox = main_settings.get('offset_x', '0').strip() or '0'
                oy = main_settings.get('offset_y', '0').strip() or '0'
                filter_parts.append(f"color=c=black:s={pw}x{ph}[canvas]")
                filter_parts.append(f"[canvas][{current_v}]overlay={ox}:{oy}[v_main_pad]")
                current_v = "v_main_pad"

        # ---- 分组规划（嵌套合成，2026-10-15，overlay-only）----
        # 组 = 若干子视频先用 overlay 合成一个**满画布透明中间节点**，再整体叠到真主视频。
        # 构建复用 _build_sub_layer_node(canvas=…) 的「透明画布层」（与转场链同机制）：
        #   组员烙进黑@0 满画布层（内容仍按原 overlay_x/y 相对画布 → **编组后视觉不变**），
        #   组节点满画布 @0,0 叠 main。组内只合视频，音频不分组。
        # 任一步不成立（无界窗口/尺寸未知/异常）⇒ 该组**降级**为各自独立叠加（= 旧行为，
        # 逐字节一致）⇒ 零回归。组存在时转场链让位（两者正交，避免语义冲突）。
        _grp_members = {}
        for _i, (_si, _sf, _ss) in enumerate(sub_infos):
            _g = str(_ss.get("grp") or "").strip()
            if _g:
                _grp_members.setdefault(_g, []).append(_i)
        _groups = []
        for _g, _ms in _grp_members.items():
            if len(_ms) >= 2:
                _b = next((_i for _i in _ms if sub_infos[_i][2].get("is_grp_base")), _ms[0])
                _groups.append((_g, _ms, _b))
        _gF = None
        # 主视频时间轴总长（=有效时长 + 尾部补帧）：无界组员的显示时长基准。
        _main_span = float((main_effective_duration or 0.0) + (main_tail_pad or 0.0))
        if _groups and main_file_path:
            _gF = self._get_video_framerate(main_file_path)
        if not _gF:
            _gF = 25.0
        _grp_ok = {}
        if _groups:
            for _g, _ms, _b in _groups:
                # 🔴 模型 B（C1 紧凑包围盒，2026-10-16 用户定案纠正）：**组画布 = 包装盒**
                #    = 组内各成员在真主画布上**矩形的并集**（= 组内主 + 组内子 + 互相最长边
                #    补全），**不是**组内主自己的内容盒 384x528。成员在组内的定位也随之下沉为
                #    「包装盒内相对坐标 = 主画布绝对坐标 − 包装盒原点」。
                #    纠正前的两处错（用户截图指认）：① 画布恒 384x528 ⇒ 摆到画布外的成员被裁；
                #    ② 成员直接用主画布绝对坐标（如 393:1201）当组内坐标 ⇒ 整段不可见。
                #    几何唯一出处 = `_group_box_geometry`（UI 侧同一函数，勿另行现算）。
                # 组内主为 blend 的组：B 语义下组内主是"组的底"，不存在"与主视频像素混合"
                # ⇒ 整组降级（= 旧行为），绝不静默忽略用户的 blend 设置。
                _bss = sub_infos[_b][2]
                if (_bss.get('blend_mode', 'normal') or 'normal').strip().lower() != 'normal':
                    continue
                _bw = _bh = None
                try:
                    _bw, _bh = self._overlay_content_size(sub_infos[_b][1], _bss)
                except Exception:
                    _bw = _bh = None
                if not (_bw and _bh and _bw >= 2 and _bh >= 2):
                    continue      # 组内主尺寸未知 ⇒ 该组降级（各自独立叠加）
                _geo = None
                try:
                    _geo = self._group_box_geometry(
                        [(sub_infos[_i][1], sub_infos[_i][2]) for _i in _ms],
                        main_settings=main_settings, main_file_path=main_file_path)
                except Exception:
                    _geo = None
                if _geo is None:
                    continue      # 包装盒几何求不出（成员尺寸/位置异常）⇒ 该组降级
                # 成员时长两趟定：先各自解析窗口，再定「组窗口」= **成员窗口并集**
                # （模型 B / E6；2026-10-17 用户定案：组窗口**不是**组内主的时段）。
                #   · 有界窗口成员 → 保留自己的窗口（用户给组员设的时段照常生效）；
                #   · 无界成员（无限循环 / 仅 show_start 无结束 / 未设窗口）→ **跟随组窗口**：
                #     组内主有界 → 取**所有有界成员的最大结束**（并集末）；组内主无界 → 主视频
                #     时间轴；再退素材自身时长。
                # 🔴 无界成员绝不能退回「素材自身时长」——那是文件长度，实测：主 20s +
                #    子视频默认无限循环，编组后被裁到素材自身 7s（整个组只剩 7 秒）。
                # 🔴 组画布长度 = 并集末 `glen`：旧口径拿组内主的结束当整组长度 ⇒ 组员
                #    设到 6s、组内主 3s 时，5s 处整组连人带货全消失（用户实测报障）。
                _fixed, _unb, _fb, _wsa, _ok = {}, [], {}, {}, True
                for _i in _ms:
                    _sf = sub_infos[_i][1]
                    _ss = sub_infos[_i][2]
                    _sd = None
                    _ws = _we = None
                    _hw = False
                    try:
                        _sd = self._get_media_duration(
                            _sf, frame_align_fps=self._get_video_framerate(_sf))
                        _ws, _we, _hw = self._resolve_display_window(_ss, _sd, input_path=_sf)
                    except Exception:
                        _ok = False
                        break
                    _fb[_i] = (float(_ws or 0.0) + float(_sd)) if (_sd and _sd > 0) else None
                    # 成员窗口起点（组内 enable 起点；旧实现恒从 0 起 ⇒ 组员 show_start 被吞）
                    _wsa[_i] = float(_ws or 0.0)
                    if _hw and _we and _we > 0:
                        _fixed[_i] = float(_we)
                    else:
                        _unb.append(_i)
                # 🔴 成员「启用叠加」必须在**规划期**就认账（2026-10-17 P0-2）：非组路径由
                #    阶段 B 的 `if overlay_enabled` 判，组成员却在阶段 A3 无条件烙进组画布
                #    ⇒ 开关对组员/组内主静默失效（用户实测：画布框都消失了，成片里还在）。
                #    可见性只决定「叠不叠」，**不参与包装盒几何**（盒子保持稳定，关掉一个
                #    成员不会让组位置/尺寸跳变）。
                _vis = [_i for _i in _ms
                        if (sub_infos[_i][2] or {}).get("overlay_enabled", True)]
                # 窗口（并集末 / 并集起点）只由**可见成员 + 组内主**决定：不可见成员不该
                # 把组拖长（否则会出现「组还在、画面全透明」的尾巴，主视频短时还会延长输出）。
                _win_ms = _vis if _b in _vis else (_vis + [_b])
                _lens = {}
                _glen = None
                _us = 0.0
                if _ok:
                    if _b in _fixed:
                        _ceil = max(_fixed[_i] for _i in _win_ms if _i in _fixed)  # 并集末
                    elif _main_span > 0:
                        _ceil = _main_span                # 组内主无界 → 主视频时间轴
                    else:
                        _ceil = _fb.get(_b)               # 再退素材自身时长
                    if _ceil:
                        _lens.update(_fixed)
                        for _i in _unb:
                            _lens[_i] = float(_ceil)
                        _glen = max(_lens[_i] for _i in _win_ms if _i in _lens)
                        # 并集起点只由**显式有界**成员 + 组内主决定：无界成员（未设窗口 /
                        # 只设起点 / 无限循环）是「跟随组窗口」的一方，不能反过来拉动组入点。
                        _us = min([_wsa.get(_b, 0.0)]
                                  + [_wsa[_i] for _i in _fixed if _i in _win_ms])
                if _vis and _lens and _b in _lens:
                    _grp_ok[_g] = {"mems": _ms, "base": _b, "lens": _lens,
                                   # 可见成员（「启用叠加」为真的那些）：阶段 A3 只叠它们
                                   "vis": _vis,
                                   # 组画布长度（成员窗口并集末）与并集起点/成员窗口起点
                                   "glen": _glen, "us": _us, "wsa": _wsa,
                                   "bw": _bw, "bh": _bh, "geo": _geo,
                                   # 包装盒尺寸 = 组画布尺寸；成员相对坐标按成员索引取
                                   "gsize": _geo["size"],
                                   "rel_of": {_i: _geo["rel"][_k]
                                              for _k, _i in enumerate(_ms)}}
        _grp_of = {_i: _g for _g, _d in _grp_ok.items() for _i in _d["mems"]}
        if _groups and not _grp_ok:
            self._append_info_ui(
                _("[分组] 分组条件不成立（无界窗口/尺寸未知），已按独立叠加处理"))
        if _grp_ok:
            _who = _("；").join(_("%s=%d 条") % (_g, len(_d["mems"])) for _g, _d in _grp_ok.items())
            self._append_info_ui(_("[分组] 已启用嵌套合成：%s（组内 overlay，音频不分组）") % _who)

        # ---- 画中画：转场链规划（未开转场 → 空链，逐字节走原路径）----
        # ⚠️ 必须在「底 tpad 延长」之前：主视频进链时要从**未延长**的主视频 split 出一份给链
        # （理由见下方 _main_in_chain）。
        # 第三个返回值 shift_of（音频偏移）不由本函数消费——音频侧 `_build_pip_audio` 独立
        # 重算一次（同一纯函数、同参数，结果必然一致；本函数签名不返回值以免牵动 5 处调用方）。
        # 有生效分组时链让位（[] ⇒ 空链），避免「组员又是链成员」的语义冲突。
        _chains, _chain_of, _shift_of = self._pip_transition_chains(
            ([] if _grp_ok else sub_infos), main_settings if main_effective_duration else None,
            main_file_path if main_effective_duration else None,
            main_effective_duration)
        _main_in_chain = any(_c["members"][0] < 0 for _c in _chains)
        _v_main_raw = None
        if _main_in_chain:
            # 主视频进链 → 必须先 split。⚠️ 让「延长后的底标签」与「链的 trim 分支」共享
            # 同一个中间标签，会让整链在 trim 结束处（=主视频时长）提前 EOF —— 实测输出被
            # 截回主视频时长（_verify_pip_transition S8 第一轮就炸在这）。split 是帧引用，
            # 零拷贝；且只在主视频真的进链时才插（其余场景逐字节不变）。
            filter_parts.append(f"[{current_v}]split=2[v_main_base0][v_main_chain0]")
            current_v = "v_main_base0"
            _v_main_raw = "v_main_chain0"

        # ---- 画中画时间轴延长：子素材被摆到主视频之后 → 底补黑帧 ----
        # ⚠️ 必须补在「主视频全部处理（滤镜/画布/pad）之后、子视频叠加之前」：
        # 主视频画面本身保持零变化，只是尾部接黑，语义等同 NLE 时间轴空白处。
        # 不补的话 overlay 主输入 EOF 会让整条链提前结束，超出部分静默丢失
        # （实测见 research/concat-overlay-alt §13.1）。
        if main_tail_pad and main_tail_pad > 0:
            # tail_pad_alpha：需要 alpha 时补**透明**帧（不透明黑会把「主视频之后」那段
            # 子视频的透明整段垫掉）。颜色串只影响补出来的帧，主视频自身像素零变化。
            _pad_col = ":color=black@0" if tail_pad_alpha else ""
            filter_parts.append(
                f"[{current_v}]tpad=stop_mode=add:stop_duration={main_tail_pad:.6f}{_pad_col}[v_main_ext]")
            current_v = "v_main_ext"

        # ---- 多混合模式子视频隔离：主视频 split 出原始帧副本 ----
        # 非 normal blend 子视频 ≥2 个时，blend 的主区域必须从主视频【原始帧】取
        # （而不是已被前面 blend 修改过的主干 current_v），否则多个 blend 区域重叠时
        # 会互相干涉（后一个 blend 拿到的"主视频"已被前一个改过）。
        # 单 blend / 全 normal 不 split → 零行为变化；split 是帧引用（零拷贝），性能无感。
        _blend_count = 0
        for _mi, _mf, _ms in sub_infos:
            if _ms.get('overlay_enabled', True) and \
                    ((_ms.get('blend_mode', 'normal') or 'normal').strip().lower() != 'normal'):
                _blend_count += 1
        _use_regional = _blend_count >= 2
        _blend_idx = 0
        if _use_regional:
            _split_out = "".join(
                f"[{_l}]" for _l in (["v_main_base"] + [f"v_crop_{j}" for j in range(_blend_count)]))
            filter_parts.append(f"[{current_v}]split={_blend_count + 1}{_split_out}")
            current_v = "v_main_base"
    
        _layers = {}
        # 图层最终标签 → 子视频序号（2026-10-17 单画布方案）：组成员不再产 `vc_<i>`，
        # 「视频节点」接线（`_node_label_track`）靠这份快照把成员内容腿的**任意尾标签**
        # 映射回真实轨道（旧结构恒为 vc_<i>，正则即可命中；现在腿尾随效果多样）。
        _mem_lbl_map = {}

        # ---- 阶段 A：逐个构建子视频图层（不叠加）----
        # 转场链成员按「链内窗口」构建：不位移（PTS 从 0 起）+ 精确限长，
        # 交由阶段 A2 的 xfade 链合成后，再整体位移回时间轴（xfade 要求两输入同起点）。
        for i, (sub_idx, sub_file, sub_settings) in enumerate(sub_infos):
            _ci = _chain_of.get(i)
            _wo = _xt = _cv = _xy = None
            _gb = False          # 本轨是否「组内主」（模型 B / C1 裁剪式）
            if _ci is not None:
                _wo = (0.0, _chains[_ci]["lens"][i])
                _xt = _chains[_ci]["norm"][i]
                # 画布统一：链成员图层烙进透明画布（尺寸/帧率取链的统一值）
                _cv = (_chains[_ci]["size"][0], _chains[_ci]["size"][1],
                       _chains[_ci]["fps"], _chains[_ci]["lens"][i])
            elif i in _grp_of:
                # 组员（2026-10-17 单画布方案）：**不再各自烙一张包装盒透明画布**。
                # 内容腿原样产出（setpts/缩放/旋转/轨迹缩放等），定位交给阶段 A3 的
                # 组级 overlay（rel 相对坐标）。此前「每成员一张 cbase + 组级 0:0 纯
                # alpha 叠加」与预览管道（`_pv_build_layer` + 组级 rel overlay）不一致，
                # 且 N 人组要出 N+1 张同尺寸 color 源；overlay 的 over 合成满足结合律，
                # 两种结构逐像素等价（tests/_probe_grp_single_canvas.py 实测 Δ=0）。
                # 🔴 不做格式收尾（2026-10-15 结论仍成立，alpha 提供方换成**组画布**）：
                #   alpha 来自阶段 A3 `color=black@0` 画布底本身，不是钉出来的；overlay
                #   与 xfade 不同：xfade 要求两输入格式完全一致才需要归一，overlay 本就
                #   接受混合格式 ⇒ 组内无需任何 format 收尾。
                #   真机像素级实测（tests/_probe_grp_fmt.py，与「未编组直接叠加」基准
                #   逐像素比）：任何无 alpha 格式收尾（format=yuv420p 等）会丢 alpha
                #   ⇒ 画布退化成不透明黑、整块盖死主视频（Δ=252）⇒ **禁用**。
                _d = _grp_ok[_grp_of[i]]
                # 成员定位 = 包装盒内相对坐标（rel = 主画布绝对坐标 − 包装盒原点；
                # 唯一出处 `_group_box_geometry`，UI 侧同一函数）——阶段 A3 消费。
                _gb = (i == _d["base"])
                _xy = _d["rel_of"][i]
            _parts, _lbl, _meta = self._build_sub_layer_node(
                i, sub_idx, sub_file, sub_settings, main_settings,
                win_override=_wo, extra_tail=_xt, canvas=_cv,
                include_fade=include_fade,
                # 组内主强制走**表达式路**：它的定位/旋转/轨迹要整体搬到组节点上表达，
                # 而 sendcmd 是「图层内 overlay」专用的位置驱动，组节点不消费它。
                wp_sendcmd=(wp_sendcmd and not _gb),
                # 组员画布不带 shortest=1 ⇒ 画布（首输入）自己定长，内容较早 EOF 时与
                # 「未编组」一致按 repeat 冻末帧，而不会被裁断（转场链仍用 True，见 docstring）。
                canvas_shortest=(i not in _grp_of),
                group_base=_gb,
                # 组成员（含组内主）：定位 = 包装盒内相对坐标（%g 收敛成 384/0 这种干净数字）
                xy_override=((f"{_xy[0]:g}", f"{_xy[1]:g}") if _xy is not None else None))
            filter_parts.extend(_parts)
            _layers[i] = (_lbl, _meta)
            _mem_lbl_map[_lbl] = i

        # ---- 阶段 A2：转场链合成（xfade 链 + 整体位移）----
        # 段长按用户摆的窗口；xfade 吞掉 d 秒 → 后段在链内提前 d 秒出现
        # （与串行合并的转场语义一致，非 bug）。
        for _ci, _ch in enumerate(_chains):
            _mem = _ch["members"]
            if _mem[0] < 0:
                # 链首 = 主视频层本身，取 split 出的**未延长**副本（_v_main_raw），
                # trim=0:{主时长} 正好等于主视频全部内容。
                _acc = f"v_mxt_{_ci}"
                filter_parts.append(
                    f"[{_v_main_raw or current_v}]{_ch['norm'][-1]}[{_acc}]")
                _acc_len = _ch["lens"][-1]
            else:
                _acc = _layers[_mem[0]][0]
                _acc_len = _ch["lens"][_mem[0]]
            for _k in range(1, len(_mem)):
                _mi = _mem[_k]
                _tt, _dd = _ch["trans"][_k - 1]
                _off = max(0.0, _acc_len - _dd)
                _out_lbl = f"v_tc{_ci}_{_k}"
                filter_parts.append(
                    f"[{_acc}][{_layers[_mi][0]}]xfade=transition={_tt}"
                    f":duration={_dd:.6g}:offset={_off:.6g}[{_out_lbl}]")
                _acc = _out_lbl
                _acc_len = _acc_len + _ch["lens"][_mi] - _dd
            _chain_lbl = f"v_tchain_{_ci}"
            filter_parts.append(f"[{_acc}]setpts=PTS+{_ch['start']:.6g}/TB[{_chain_lbl}]")
            _ch["label"] = _chain_lbl
            _ch["len"] = _acc_len
            _ch["enable"] = f"between(t,{_ch['start']:.6g},{_ch['start'] + _acc_len:.6g})"
            try:
                _who = (_("主视频→子视频 %d") % (_mem[1] + 1)) if _mem[0] < 0 else \
                       (_("子视频 %d…%d") % (_mem[0] + 1, _mem[-1] + 1))
                self._append_info_ui(
                    f"[转场] {_who} 已合成转场链：{_ch['start']:.2f}s~{_ch['start'] + _acc_len:.2f}s"
                    f"（{len(_mem)} 段，链内统一 {_ch['size'][0]}x{_ch['size'][1]}）")
            except Exception:
                pass

        # ---- 阶段 A3：分组节点合成（成员层 → overlay 成组节点 [v_grp_G]）----
        # 单画布方案（2026-10-17）：组节点 = **唯一一张**包装盒尺寸的透明画布
        # [v_gbase_G]（= 各成员在主画布上矩形的并集，见 `_group_box_geometry`）。
        # 成员内容腿按「组内主(base) 在下、其余按列表序在上」，以**包装盒内相对坐标**
        # （`rel_of`）依次叠进组画布 —— 与预览管道阶段 A3 逐项同口径（此前导出是
        # 「每成员一张 cbase + 组级 0:0 纯 alpha 叠加」，N 人组 N+1 张 color 源；
        # over 合成满足结合律，两种结构逐像素等价）。
        # 🔴 成员可见时段必须显式钉 `enable='between(t,ws,lens)'`：旧结构里成员画布
        #    d=lens[i] 是成员时长的权威（组级 overlay eof_action=pass 在画布 EOF 处
        #    放行 ⇒ 成员到点消失）；单画布后内容腿时长≈lens 但没有画布兜底——有界
        #    窗口成员若腿长于窗口会一直显示。enable 补回同一语义；内容腿早于 lens
        #    EOF 时走 overlay 默认 repeat 冻末帧（与旧画布 repeat 行为一致）。
        #    起点取成员自己的窗口起点（`wsa`；0 时与旧串 `between(t,0,…)` 逐字符相同），
        #    否则组员的 show_start 在组内被静默吞掉。
        # 画布时长 = **组窗口 = 成员窗口并集末 `glen`**（2026-10-17 用户定案；旧口径
        # 拿组内主时段当整组长度会截断组员）。它是整条链的长度权威（首输入），较早
        # 结束的成员由 enable/repeat 语义处理，不截断组画布。
        _grp_node = {}
        # 组节点**标签 → 组 id** 映射（2026-10-15）：右键「视频节点」里选中某个组节点时，
        # 要能认出「这个节点属于哪一组」，才能把「叠加/偏移」页接到**组内主轨道**上
        # （拖组合包围盒写回它的 overlay_x/y）。只在 node_fx_record_raw 时快照（见下）。
        _grp_lbl_map = {}
        for _g, _d in _grp_ok.items():
            _order = [_d["base"]] + [_i for _i in _d["mems"] if _i != _d["base"]]
            _glen = float(_d.get("glen") or _d["lens"][_d["base"]])
            _acc = "v_gbase_%s" % _g
            filter_parts.append(
                "color=c=black@0:s=%dx%d:r=%.6g:d=%.6g[%s]"
                % (_d["gsize"][0], _d["gsize"][1], _gF, _glen, _acc))
            _grp_lbl_map[_acc] = _g
            for _k, _i in enumerate(_order):
                _nl = "v_grp_%s_%d" % (_g, _k)
                if _i not in (_d.get("vis") or _d["mems"]):
                    # 🔴 「启用叠加」关闭的成员（2026-10-17 P0-2）：**腿位保留、永不显示**
                    #    —— 组内腿的标签序号必须与成员列表序一致（组父行标签
                    #    `v_grp_<g>_<n-1>` / 节点接线都按「最后一条腿」推导，空号会让
                    #    父行接到错节点）；同时内容腿必须被消费（悬空输出会让 ffmpeg 报
                    #    「has unconnected output」并使整条链失败），故仍叠加但 enable 恒假。
                    filter_parts.append(
                        "[%s][%s]overlay=x='0':y='0':enable='0'[%s]"
                        % (_acc, _layers[_i][0], _nl))
                    _acc = _nl
                    _grp_lbl_map[_nl] = _g
                    continue
                # 🔴 rel 是 **(x, y, w, h) 矩形**（`_group_box_geometry` 的 "rel"），
                #    只要它的原点 —— 成员自己的 w/h 不参与定位（定位只认左上角）。
                #    两元解包必炸 `too many values to unpack (expected 2, got 4)`。
                _rr = _d["rel_of"][_i]
                _rx, _ry = float(_rr[0]), float(_rr[1])
                _ln = float(_d["lens"][_i])
                _w0 = min(float((_d.get("wsa") or {}).get(_i, 0.0) or 0.0), _ln)
                filter_parts.append(
                    "[%s][%s]overlay=x='%g':y='%g'"
                    ":enable='between(t,%.6g,%.6g)'[%s]"
                    % (_acc, _layers[_i][0], _rx, _ry, _w0, _ln, _nl))
                _acc = _nl
                _grp_lbl_map[_nl] = _g
            _grp_node[_g] = _acc

        # ---- 阶段 B：叠加 ----
        for i, (sub_idx, sub_file, sub_settings) in enumerate(sub_infos):
            _ci = _chain_of.get(i)
            if _ci is not None:
                _m0 = _chains[_ci]["members"]
                # 链首为主视频(-1)时，由链内第一个真实成员代表整条链做叠加
                if i != (_m0[1] if _m0[0] < 0 else _m0[0]):
                    continue      # 链内非首成员：图层已被 xfade 消费，不单独叠加
            if i in _grp_of:
                # 组成员：只由「组内主(base)」代表整组叠加一次；其余组员已在阶段 A3
                # 被组节点消费 → 不单独叠加。
                if i != _grp_ok[_grp_of[i]]["base"]:
                    continue
                _gid = _grp_of[i]
                # 🔴 模型 B / C1：组内主的 旋转 / 轨迹缩放 / 定位 在**组节点**上表达
                #    ⇒ 作用于整组（组员一起转 / 一起缩 / 一起移位）。这些段已在内容腿跳过
                #    （阶段 A 传 group_base=True）。_pip_overlay_xy 的旋转中心补偿按组内主
                #    内容盒算 —— 与组画布尺寸同源，故落位与「未编组时组内主」完全一致。
                _bmeta = _layers[_grp_ok[_gid]["base"]][1]
                # 🔴 2026-10-16：父行的**静态角度**是**组级字段** `grp_rot_angle`（存在组内主，
                #    与 grp_dx/grp_dy 同族）—— 父行 = 独立素材 ⇒ 它的旋转必须作用于**整组**，
                #    且**不写成员自己的 rotate_angle**（否则成员各自再转一次 = 双重旋转）。
                #    有点角度时用一份**副本**接管：`_group_node_transform_parts` 判据走
                #    `overlay_rotation_active(sub_settings)`、中心补偿走 `meta["ra"]`，
                #    两处都要看到组级角度；缺省（无此键）逐字符不变（老工程零回归）。
                _gra = _opt_float((sub_settings or {}).get("grp_rot_angle", 0) or 0, 0.0)
                _gs = sub_settings
                if _gra:
                    _gs = dict(sub_settings or {})
                    _gs["rotate_angle"] = _gra
                    _bmeta = dict(_bmeta or {})
                    _bmeta["ra"] = _gra
                # 🔴 2026-10-16 第七轮②：**父行素材项的列表轨迹** → 组节点 overlay 的 x/y
                #    时间表达式（唯一出处 `_group_material_wp_res`）。父行是**独立素材** ⇒
                #    它的静态落位走 `grp_abs_x/y`、列表轨迹走时间表达式，与非组子视频
                #    **同一条投影路线**。航点的旋转/缩放/透明度一并接进 meta —— 消费端
                #    `_group_node_transform_parts` / `_pip_overlay_xy` 本就吃这几个键
                #    （组内主自己的列表也走同一处），接上即作用于**整组**，无需新机制。
                #    无列表（move_mode≠waypoints / 空）⇒ _mwp=None ⇒ 逐字符走老口径。
                _gkey = self._group_final_label_key(_gid, len(_grp_ok[_gid]["mems"]))
                _ts0_m, _sp0_m = _trim_speed_from_settings(main_settings)
                _mwp = self._group_material_wp_res(
                    _gkey, _grp_ok[_gid]["geo"]["size"][0], _grp_ok[_gid]["geo"]["size"][1],
                    trim_start=_ts0_m, speed_factor=_sp0_m)
                if _mwp is not None:
                    _bmeta = dict(_bmeta or {})
                    _bmeta["wp_res"] = _mwp
                    _bmeta["wp_rot"] = _mwp[2] is not None
                    _bmeta["wp_zoom"] = _mwp[3] is not None
                    # 🔴 2026-10-17（用户实测「父行轨迹里重绘的矩形和角度都无效」，角度部分）：
                    #   `overlay_rotation_active`（旋转判据唯一真相源）的「列表轨迹」分支被
                    #   `settings["move_mode"] == "waypoints"` 门禁 —— 而父行的轨迹住在
                    #   **父行素材项**（`node_fx[key]`，投影），**不在** `sub_settings`
                    #   （组内主的 enc_settings）里 ⇒ 那个门对父行恒 False ⇒ 即使
                    #   `wp_rot=True` 传进去了也照样不插 rotate ⇒ 航点 ra/rb 画了也不生效
                    #   （位移/缩放不受影响，它们不吃这个门）。
                    #   修法：与上面 `grp_rot_angle → rotate_angle` **同款投影注入** —— 有
                    #   父行轨迹时把 `move_mode` 补进 `_gs`（只给判据看的副本）。
                    #   ⚠️ 只补进 `_gs`：它只喂 `_group_node_transform_parts`；
                    #      `_group_node_xy` / `_pip_overlay_xy` 仍吃未改的 `sub_settings`
                    #      ⇒ 不会让组内主自己被当成"有轨迹"而二次算一遍。
                    _gs = dict(_gs or {})
                    _gs["move_mode"] = "waypoints"
                # 🔴 2026-10-18（用户第 3 条：「父行不支持自己的自旋转和那几个预制轨迹，
                #    开了无效」）：父行 = **独立素材**，它「叠加/偏移」页里的**自旋转**与
                #    **预制轨迹**（h/v/diamond/corners）此前根本没有消费端 —— 存进
                #    `node_fx[key][0]` 却没人读。这里与列表轨迹同一条「父行优先」投影：
                #      · 预制轨迹 ⇒ 注入 `_gs["move_mode"]`（喂 `_group_node_transform_parts`
                #        的旋转判据）+ `_group_node_xy(row_settings=_row_fx)`（喂 overlay
                #        表达式；运动幅度按**包装盒**算）；组内主的列表轨迹整体让位
                #        （否则 wp_res 的位移会与预制位移混在一起）；
                #      · 自旋转   ⇒ `meta["spin_on"]=True` + `_gs` 里的 spin_speed；
                #        角度由 spin 驱动 ⇒ 清 `wp_rot`（航点角度让位）。
                #    只投影这 6 个键，成员 enc_settings 一字不动。
                _row_fx = self._group_material_row_proj(_gkey)
                if _row_fx:
                    _gs = dict(_gs or {})
                    _gs.update(_row_fx)
                    _bmeta = dict(_bmeta or {})
                    if _row_fx.get("spin_enabled"):
                        _bmeta["spin_on"] = True
                        _bmeta["wp_rot"] = False
                    if _row_fx.get("move_mode"):
                        # 🔴 2026-10-18（审计发现）：父行**预制轨迹**是整组位移的唯一来源 ⇒
                        #   组内主自己的列表轨迹必须**整体让位**（位移/航点角度/航点缩放/
                        #   航点透明度全清）。旧判据 `and _mwp is None` 只在「组内主没有列表」
                        #   时清 ⇒ 组内主与父行都配过时：位移虽被 `_pip_overlay_xy` 的
                        #   预制分支自然忽略，但 `wp_rot/wp_zoom` 仍生效（角度/缩放叠到预制
                        #   位移上）；更糟的是传给 `_group_node_xy` 的 wp_move 仍为 True ⇒
                        #   `_group_node_xy` 跳过**盒原点修正 base** ⇒ 整组偏移 (base_dx,base_dy)。
                        #   清 `_mwp` 同时修掉这两处（wp_move 随之为 False）。
                        _mwp = None
                        _bmeta["wp_res"] = None
                        _bmeta["wp_rot"] = False
                        _bmeta["wp_zoom"] = False
                _gparts, _glbl = self._group_node_transform_parts(
                    _gid, _grp_node[_gid], _gs, _bmeta)
                filter_parts.extend(_gparts)
                _grp_lbl_map[_glbl] = _gid
                # 组节点落位 = 组内主落位 + 包装盒原点修正（几何唯一出处 `_group_node_xy`）
                #              + **组级增量** delta（唯一读取口径 `_group_place_xy`；
                #                缺省 delta=0 ⇒ 与改动前逐字符一致）
                # 组父行缩放（独立素材 scale）会把包装盒放大/缩小 ⇒ 旋转中心对齐两端须用
                # 缩放后尺寸（否则「缩放 + 旋转」整组上偏，用户实测）。未缩放 → None 走旧口径。
                _gscaled = self._group_material_scaled_size(
                    _grp_ok[_gid]["geo"]["size"], _gkey)
                _gx, _gy = self._group_place_xy(
                    sub_settings,
                    *self._group_node_xy(
                        sub_file, sub_settings, _bmeta, _grp_ok[_gid]["geo"],
                        grp_scaled_size=_gscaled, wp_move=(_mwp is not None),
                        row_settings=_row_fx))
                # 组级**绝对落位**（父行 X/Y 数字框）：有就覆盖，且与增量互斥
                # （唯一出处 `_group_place_abs`；缺省 None ⇒ 老工程逐字符不变）
                _absx, _absy = self._group_place_abs(sub_settings)
                if _mwp is not None:
                    # 列表轨迹 = **逐帧**落位 ⇒ 静态绝对落位（X/Y 数字框）不参与
                    # （与 `_pip_overlay_xy` 里「航点取代 overlay_x/y」同一语义；两套相加必漂移）
                    _absx = _absy = None
                # 数字按 `%g` 出串（否则 7.0 会写成 "7.0"，与用户手填的 "7" 不同形）
                if _absx is not None:
                    _gx = ("%g" % _absx) if isinstance(_absx, float) else _absx
                if _absy is not None:
                    _gy = ("%g" % _absy) if isinstance(_absy, float) else _absy
                # enable：**组窗口 = 成员窗口并集**（2026-10-17 用户定案）。组内主自身时段
                # 只决定"组从哪开始出现"，不决定整组何时收工 —— 并集更长时把结束推到并集末
                # （唯一出处 `_group_overlay_enable`；无并集/并集不超出 ⇒ 与旧串逐字符一致）。
                # 组员的窗口已由阶段 A3 各自的 enable 承载。
                _gen = self._group_overlay_enable(
                    sub_settings, self._get_media_duration(sub_file),
                    (_grp_ok[_gid]["wsa"].get(_grp_ok[_gid]["base"], 0.0),
                     _grp_ok[_gid]["lens"][_grp_ok[_gid]["base"]]),
                    (_grp_ok[_gid].get("us", 0.0), _grp_ok[_gid].get("glen")),
                    # 🔴 2026-10-18 审计：父行「显示时段」此前无消费端（父行窗里有该控件）。
                    #   父行填了 show_* 就覆盖成员并集（父行优先，与落位/轨迹同一条语义）。
                    row_item=self._group_material_item(_gkey))
                # 🔴 2026-10-18 审计：父行的「启用叠加」此前无消费端（关闭后整组照常显示）。
                #    关闭 ⇒ enable 钉 `'0'`（腿位保留、不删 overlay，避免 unconnected output）。
                if not self._group_material_overlay_on(_gkey):
                    _gen = "0"
                filter_parts.append(
                    "[%s][%s]overlay=x='%s':y='%s':enable='%s':eof_action=pass[v_out_%d]"
                    % (current_v, _glbl, _gx, _gy, _gen, i))
                _grp_lbl_map["v_out_%d" % i] = _gid
                current_v = f"v_out_{i}"
                continue
            _lbl, _meta = _layers[i]
            current_sub = _chains[_ci]["label"] if _ci is not None else _lbl
            _wp_res = _meta["wp_res"]
            _wp_rot = _meta["wp_rot"]
            _spin_on = _meta["spin_on"]
            _ra = _meta["ra"]
            _wp_zoom = _meta["wp_zoom"]
            _wp_sc = _meta["wp_sc"]
            _wp_sc_x0 = _meta["wp_sc_x0"]
            _wp_sc_y0 = _meta["wp_sc_y0"]
            _wp_sc_iv = _meta["wp_sc_iv"]
            _has_window = _meta["has_window"]
            _chain_enable = _chains[_ci]["enable"] if _ci is not None else None

            # 叠加（不添加 shortest=1）
            blend_mode = (sub_settings.get('blend_mode', 'normal') or 'normal').strip().lower()
            if blend_mode != 'normal':
                # 降级判定（用户拍板 2026-08-25）：pad 画布大于主视频渲染尺寸 → blend 窗口
                # 轨迹一旦进入黑边区就脱离主视频像素、与黑混合无意义 → 强制普通叠加。
                # pad ≤ 主视频（画布是裁剪窗口，无黑边）→ blend 保留。
                _dgp = self._blend_downgrade_pad(main_settings, main_file_path)
                if _dgp:
                    self._append_info_ui(
                        f"[混合模式] pad 画布 {_dgp[0]}x{_dgp[1]} 大于主视频渲染尺寸，"
                        f"blend({blend_mode}) 已降级为普通叠加（脱离主视频像素的混合无意义）")
                    blend_mode = 'normal'
            if sub_settings.get('overlay_enabled', True):
                if blend_mode == 'normal':
                    x = sub_settings.get('overlay_x', '0').strip() or '0'
                    y = sub_settings.get('overlay_y', '0').strip() or '0'
                    if _ci is None:
                        # 定位表达式统一走 _pip_overlay_xy（与链成员「烙进画布」共用同一套）。
                        # 链成员的定位已在图层内画布合成时完成，这里整链铺满即可（见下）。
                        if _wp_sc is not None:
                            # sendcmd 模式：位置由命令文件驱动，overlay x/y 只作首帧占位
                            x, y = _wp_sc_x0, _wp_sc_y0
                        else:
                            x, y = self._pip_overlay_xy(sub_file, sub_settings,
                                                        _wp_res, _wp_rot, _spin_on, _ra, _wp_zoom)
                    if _chain_enable is not None:
                        # 转场链：整条链只有一次叠加，窗口=链的合成时长（非单段的显示时段）。
                        # 画布统一方案（2026-09-25）：每段内容（含位置/轨迹/旋转）已烙进透明画布
                        # → 链尺寸=输出画布，整条链一律铺满 (0,0)，透明处透出主视频。
                        enable_expr = _chain_enable
                        x, y = "0", "0"
                    else:
                        duration = self._get_media_duration(sub_file)
                        enable_expr = self._calc_enable_expr(sub_settings, duration)
                    # x/y 用引号包裹：动效表达式含逗号（mod/min/max），不包会被 filtergraph 当滤镜分隔符
                    # 窗口生效时子链在窗口结束正常 EOF，追加 eof_action=pass 透传主视频，
                    # 避免默认 eof_action=repeat 把末帧定格在主画面上（与统一尝试版一致）。
                    # sendcmd 模式给 overlay 起完整别名（sendcmd target 按名定向，编排器实测坑）。
                    # ⚠️ sendcmd 必须挂 overlay 的【主输入支链】，挂副输入链会被滤镜调度
                    # 「跑在主流前面」（副流 pts 提前推进）→ 命令提前数帧生效、位置整体错位
                    # （2026-10-01 实测：4 命令文件在副链提前 ~3 帧，主链 33 帧全对）。
                    _ov_name = f"overlay@wps{i}" if _wp_sc is not None else "overlay"
                    overlay_filter = f"{_ov_name}=x='{x}':y='{y}':enable='{enable_expr}'"
                    if _has_window or _ci is not None:
                        overlay_filter += ":eof_action=pass"
                    if _wp_sc is not None:
                        filter_parts.append(f"[{current_v}]sendcmd=f='{_wp_sc}'[v_wsm_{i}]")
                        _ov_main = f"v_wsm_{i}"
                    else:
                        _ov_main = current_v
                    filter_parts.append(f"[{_ov_main}][{current_sub}]{overlay_filter}[v_out_{i}]")
                    current_v = f"v_out_{i}"
                else:
                    # ⚠️ x/y 必须先取自**本**子视频（2026-09-30 修）：原来这里直接用上面
                    # normal 分支算好的 x/y，于是 ①第一个子视频就是 blend 时 x/y 还没赋值
                    # → UnboundLocalError 直接崩；②前面有 normal 子视频时，blend 会静默
                    # 复用上一个子视频的坐标（位置错，不报错最难查）。
                    # 取的是**未补偿**的原始 overlay_x/y：下面静态分支自己会做
                    # _content_box_expr + 旋转中心补偿（喂已补偿过的值 = 二次减偏移）；
                    # 动态轨迹走 _blend_move_exprs 的 _dyn 分支，根本不经 x/y。
                    x = sub_settings.get('overlay_x', '0').strip() or '0'
                    y = sub_settings.get('overlay_y', '0').strip() or '0'
                    # 混合模式：仅在子视频所在矩形「局部区域」内做 blend，再贴回原位置。
                    # 这样每种效果只作用于各自的子视频框内，不会铺满全屏；
                    # 也避免了把整张主视频转 RGBA 再转回带来的全屏发绿问题。
                    # 区域隔离（_use_regional，≥2 个 blend 子视频）时，主区域从 split 出的
                    # 主视频【原始帧】副本（v_crop_{idx}）裁取，避免多个 blend 互相干涉；
                    # 单 blend 时 _src_label=current_v（主干=原始帧），行为与旧版一致。
                    _src_label = f"v_crop_{_blend_idx}" if _use_regional else current_v
                    _blend_idx += 1
                    mw, mh = self._compute_output_canvas(main_settings, main_file_path)
                    sw, sh = self._overlay_sub_size(sub_file, sub_settings)
                    # 内容盒尺寸（未旋转渲染尺寸）——overlay_x/y 的 w/h 定位语义基准；
                    # 旋转时叠加盒 d×d 中心与内容盒中心对齐（_content_box_shift）
                    _content_w, _content_h = self._overlay_content_size(sub_file, sub_settings)
                    _spv2 = _opt_float(sub_settings.get("spin_speed", 60.0) or 60.0, 60.0)
                    _rot_ov2 = overlay_rotation_active(sub_settings)
                    _mv = (sub_settings.get('move_mode', '') or '').strip()
                    # 窗口尺寸（动态/静态共用）：偶数化（yuv420p 对齐；动态位置无法保证偶数，
                    # 色度微偏可接受）。静态分支的 bw/bh 在下面越界裁剪处还会再调整。
                    bw = int(sw)
                    bh = int(sh)
                    if bw % 2:
                        bw -= 1
                    if bh % 2:
                        bh -= 1
                    if bw < 2:
                        bw = 2
                    if bh < 2:
                        bh = 2
                    # 动态轨迹 blend：h/v/diamond/corners 全部支持（2026-08-24 实测：crop 的
                    # x/y 表达式支持逗号函数与状态变量 → 双轴表达式均可动态跟随，"走到哪混到哪"）
                    # ⚠️ 旋转时区域 d 可能 > 画布尺寸（竖屏/横屏子视频）→ 必须先 clamp 到画布内，
                    # 否则动态 crop 越界在 ffmpeg 8.1 报 "Invalid too big or non positive size"
                    # （mpv lavfi 桥接包装成 "no media data to loop"）；静态分支由
                    # _blend_static_geometry 的尺寸 clamp 兜底，动态分支必须在这里做。
                    _dyn = None
                    # ---- 包围盒模型（方案 A，2026-10-07）----
                    # 旧模型用 crop 从主视频裁一个动态窗口再 blend，而 crop 的 w/h 只在 init
                    # 求值一次 ⇒ 窗口尺寸无法逐帧跟随缩放 z(t)（列表轨迹缩放必崩）。新模型：
                    # 包围盒静态（覆盖轨迹全程扫掠），动的是「落位 overlay」（place_x/y 相对
                    # 包围盒原点），缩放/旋转/轨迹随便动；隔离由透明画布 α 自动锁死（Cairo
                    # bounded blend 语义）。详见 research/blend-isolation/README.md。
                    _blend_sc = None
                    _pl_name = None
                    _bx0 = _by0 = "0"
                    if _mv:
                        # 1) 静态包围盒：waypoints 走 _blend_wp_bbox（采样段端点算并集，
                        #    O(段数)，长列表不炸）；表达式轨迹走 _blend_move_envelope
                        #    + _blend_region_bbox（保守上界）。
                        if _mv == "waypoints":
                            _offx2_b, _offy2_b = _content_box_shift(
                                _content_w, _content_h, sw, sh)
                            _bbox = _blend_wp_bbox(
                                mw, mh, sw, sh,
                                sub_settings.get("move_waypoints"),
                                _offx2_b, _offy2_b)
                        else:
                            _ctx = {"W": mw, "H": mh, "w": _content_w, "h": _content_h}
                            _bxb = safe_eval_expr(_content_box_expr(x, _content_w, _content_h), _ctx)
                            _byb = safe_eval_expr(_content_box_expr(y, _content_w, _content_h), _ctx)
                            _bxb = int(_bxb) if _bxb is not None else 0
                            _byb = int(_byb) if _byb is not None else 0
                            if _rot_ov2:
                                _ofx, _ofy = _content_box_shift(_content_w, _content_h, sw, sh)
                                _bxb -= int(round(_ofx)); _byb -= int(round(_ofy))
                            _bbox = _blend_region_bbox(
                                _blend_move_envelope(_mv, mw, mh, sw, sh, _bxb, _byb), mw, mh)
                        if _bbox is None:
                            # 全程隐藏 / 完全在画布外 → 跳过混合（保持主画面，消费子视频流）
                            filter_parts.append(f"[{current_v}]null[{current_v}]")
                            filter_parts.append(f"[{current_sub}]nullsink")
                            continue
                        bx, by, bw, bh = _bbox
                        # 2) 落位坐标（相对包围盒原点）：内容盒左上（画布绝对） - 包围盒原点。
                        #    waypoints 的 xa/ya 是中心基准，需先减中心对齐偏移；表达式轨迹
                        #    _blend_move_exprs 直接给左上基准，无需再减。
                        _ms2 = dict(sub_settings)
                        _ms2["overlay_x"] = _content_box_expr(
                            _ms2.get("overlay_x", DEFAULT_OVERLAY_X), _content_w, _content_h)
                        _ms2["overlay_y"] = _content_box_expr(
                            _ms2.get("overlay_y", DEFAULT_OVERLAY_Y), _content_w, _content_h)
                        if _mv == "waypoints":
                            if _wp_res is not None and _wp_res[0] is not None:
                                _dx, _dy = _wp_res[0], _wp_res[1]
                            else:
                                _dx, _dy = _blend_move_exprs(_mv, _ms2, _content_w, _content_h)
                        else:
                            _dx, _dy = _blend_move_exprs(_mv, _ms2, _content_w, _content_h)
                        if _dx is not None:
                            _px, _py = _dx, _dy
                            if _mv == "waypoints":
                                # 中心对齐偏移随 z(t) 同乘（_blend_place_off_exprs）
                                _sx, _sy = _blend_place_off_exprs(
                                    _content_w, _content_h, sw, sh, _wp_res)
                                _px = f"({_px}) {_sx}"
                                _py = f"({_py}) {_sy}"
                            _dyn = (f"({_px}) - {bx}", f"({_py}) - {by}")
                        else:
                            self._append_info_ui(_("[轨迹控制] 混合模式轨迹不支持，已使用基准位置"))
                    # ---- blend 落位 sendcmd 驱动（长列表突破表达式段数墙，2026-10-08）----
                    # 解耦：不再依赖非 blend 的 _wp_sc（旧 gate 要求 X 位置非常数才建，
                    # 导致「位置恒定、仅 zoom 变」的航点列表落位退回 inline、filtergraph
                    # 残留 max(0.01,Z(t))）；改为「waypoints 且航点 > 阈值」即直接 build。
                    # 落位区间 = position + zoom 合并（build_waypoint_placement_intervals）：
                    # 段端点算 位置 - zoom*off - bx，zoom 折进区间值，filtergraph 不再含 zoom 表达式。
                    if wp_sendcmd and _mv == "waypoints" and _dyn:
                        _wps_loc = sub_settings.get("move_waypoints") or []
                        _rows_loc = len([w for w in _wps_loc if isinstance(w, dict)])
                        try:
                            _sc_min_loc = max(1, min(9999, int(self.wp_sendcmd_min_rows.get())))
                        except Exception:
                            _sc_min_loc = _WP_SENDCMD_MIN_ROWS
                        if _rows_loc > _sc_min_loc:
                            _offx_b, _offy_b = _content_box_shift(_content_w, _content_h, sw, sh)
                            # 本地计算 trim（不依赖外层 _ts0/_sp0：旧 gate 被 _wp_sc 短路，
                            # 该分支从未执行过，外层变量在「位置恒定」路径下可能未绑定）。
                            try:
                                _ts0b, _sp0b = _trim_speed_from_settings(main_settings)
                            except Exception:
                                _ts0b, _sp0b = 0.0, 1.0
                            _pl_iv = build_waypoint_placement_intervals(
                                _wps_loc, _offx_b, _offy_b, bx, by,
                                trim_start=_ts0b, speed_factor=_sp0b)
                            if _pl_iv is not None:
                                _pl_name = f"pl{i}"
                                _blend_sc = self._write_waypoint_sendcmd_file(
                                    _pl_iv, tag=f"blend{i}", targets=[f"overlay@{_pl_name}"])
                                if _blend_sc is not None:
                                    if _pl_iv[0][2] == "hide":
                                        _bx0 = _by0 = "-100000"
                                    else:
                                        # 首帧基值 = 合并区间首段端点值（已含 zoom*off - bx，
                                        # 与命令值同语义），sendcmd 生效前 overlay 用它占位。
                                        _bx0 = f"{_pl_iv[0][3]:g}"
                                        _by0 = f"{_pl_iv[0][4]:g}"
                    if _dyn:
                        # ---- 动态轨迹 blend：落位 overlay 跟随动效表达式 / sendcmd ----
                        # （区域隔离子图改用共享 _make_blend_region，与实时预览共用，勿复制粘贴）
                        _x_expr, _y_expr = _dyn
                        if _blend_sc is not None:
                            # sendcmd 驱动落位：base 用首区间常量（sendcmd 覆盖其余帧）
                            _x_expr = f"{_bx0}"
                            _y_expr = f"{_by0}"
                        # ⚠️ 正式命令**不传** ov_suffix（与本方法 docstring 的契约一致：
                        #   ":eof_action=pass" 仅实时预览需要）。实测它在 blend 链上会把
                        #   输出截到主视频 tpad 补帧前的长度（2026-10-06 实证：主 4s+tpad 4s
                        #   → 有 pass 出 4.00s/20 帧，去掉 pass 出 8.00s/40 帧；repeatlast=0
                        #   也救不回）。正式命令靠全局 -shortest 收尾，本就不需要。
                        filter_parts.extend(self._make_blend_region(
                            _src_label, current_sub, current_v, bx, by, bw, bh,
                            _x_expr, _y_expr, blend_mode, f"v_out_{i}", str(i),
                            ov_suffix="", place_name=_pl_name, sc_file=_blend_sc,
                            # ⚠️ 子链带逐帧航点缩放时必须前置 format=rgba，
                            # 否则 z(t) 锁死首帧值、缩放永不缩回（见 _make_blend_region 第3步铁律）
                            slr_scale_before=bool(_wp_res is not None and _wp_res[3] is not None)))
                        current_v = f"v_out_{i}"
                    else:
                        # ---- 静态位置 blend：保持原区域化逻辑（含越界裁剪/偶数对齐） ----
                        # （区域隔离子图改用共享 _make_blend_region，与实时预览共用，勿复制粘贴）
                        # 定位语义：x/y 按内容盒求值，旋转时叠加盒中心对齐内容盒（减偏移）
                        ctx = {"W": mw, "H": mh, "w": _content_w, "h": _content_h}
                        xv = safe_eval_expr(_content_box_expr(x, _content_w, _content_h), ctx)
                        yv = safe_eval_expr(_content_box_expr(y, _content_w, _content_h), ctx)
                        xv = int(xv) if xv is not None else 0
                        yv = int(yv) if yv is not None else 0
                        if _rot_ov2:
                            _offx3, _offy3 = _content_box_shift(_content_w, _content_h, sw, sh)
                            xv -= int(round(_offx3))
                            yv -= int(round(_offy3))
                        bx, by, bw, bh, sx, sy = self._blend_static_geometry(xv, yv, sw, sh, mw, mh)
                        if bw >= 2 and bh >= 2:
                            # ⚠️ alpha 必须与 blend 剥离：实测 ffmpeg 8.1 的 blend 滤镜
                            # c3_mode 无效——alpha 通道实际按 all_mode 公式运算
                            # （difference 时 alpha=|a1-a2| 反相、average 时 alpha=(a1+a2)/2、
                            # screen 时矩形内 alpha=255 挖不出洞），遮罩黑白层被破坏。
                            # 正确做法：RGB 用 rgb24（blend 纯 RGB 空间、无 alpha 可破坏），
                            # 子视频 alpha 用 alphaextract 单独提取、blend 后 alphamerge 合并。
                            # ⚠️ 同动态分支：不传 ov_suffix（eof_action=pass 会把输出截到
                            #   主视频 tpad 补帧前，见上方动态分支的实证记录）。
                            filter_parts.extend(self._make_blend_region(
                                _src_label, current_sub, current_v, bx, by, bw, bh,
                                str(sx), str(sy), blend_mode, f"v_out_{i}", str(i)))
                            current_v = f"v_out_{i}"
                        else:
                            # 子视频完全在画布外，跳过混合（保持主画面，不报错）。
                            # ⚠️ current_sub 必须消费（nullsink），否则子视频链输出悬空
                            # → filtergraph "unconnected" 报错（同 22659 叠加关闭分支）。
                            filter_parts.append(f"[{current_v}]null[{current_v}]")
                            filter_parts.append(f"[{current_sub}]nullsink")
            else:
                # 叠加关闭：主视频直通 + 必须消费子视频流。子视频链（22378 附近）是无条件
                # 生成的——绿幕/遮罩/缩放等滤镜都在里面；不消费会悬空，filtergraph 直接报
                # "Filter 'format:default' has output 0 (v_temp_N) unconnected"，
                # 转换/预览全炸（2026-09-10 用户实测：绿幕+遮罩轨道未勾「启用叠加」）。
                # ⚠️ 本 else 必须缩进在上方 if（overlay_enabled）之下（12 空格）——曾误写成
                # 8 空格挂成 for-else：单子视频歪打正着（循环尾消费了 current_sub），但
                # 多子视频时非末位关叠加的流照样悬空、且勾了叠加也误报日志（2026-09-10 修正）。
                filter_parts.append(f"[{current_v}]null[{current_v}]")
                filter_parts.append(f"[{current_sub}]nullsink")
                self._append_info_ui(
                    f"[封装] 子视频 {i + 1} 未勾选「启用叠加」：其滤镜链（绿幕/遮罩/缩放等）"
                    f"已生成但不会叠加显示；如需显示请到轨道编辑勾选「启用叠加」")
    
        complex_filter = ";".join(filter_parts)
        # 「预览重锚原始图」快照（2026-09-27）：仅 node_fx_record_raw=True 的调用方
        # （目前只有 _build_pip_cmd 正式构图）在应用节点效果**前**留下视频原始图
        # → 实时预览重锚（merge_preview_pip_live）拿它当 anchor，避免 anchor 被
        # 自己插入的效果段污染（同名滤镜计数虚增 → node_key_alias 整层拒绝）。
        # 取帧快照 / 水印预览 / contact sheet 等其它调用方一律 False（不覆盖），
        # 且 override 构图（可视化编辑器替身）也不写 —— 旧调用方零回归。
        if node_fx_record_raw and node_fx_override is None:
            self._last_graph_raw_v = complex_filter or ""
            # 节点分析的「基准图」与预览重锚用的是同一张干净图，但**必须独立存一份**：
            # raw_v 只有画中画正式构图会写，串行构图永远不写 ⇒ 直接拿它当基准会残留
            # 上一代画中画的图，切回串行时复用判据误判"没变"（2026-09-28 实测 bug）。
            self._last_graph_base = complex_filter or ""
            self._last_graph_base_gen = getattr(self, "_graph_gen", 0)
            # 组节点标签 → 组 id（2026-10-15）：与基准图同生共死 —— 「视频节点」只认本图里
            # 真实存在的组节点标签，故必须和 _last_graph_base 一起快照，不能等到应用效果后。
            self._last_group_label_map = dict(_grp_lbl_map)
            # 成员腿标签 → 子视频序号（2026-10-17 单画布方案）：与组映射同生共死
            # （组成员不再产 vc_<i>，`_node_label_track` 靠它命中成员内容腿任意尾标签）。
            self._last_member_lbl_map = dict(_mem_lbl_map)
            # 2026-10-16：**组最终输出标签**集合（= 组内合成链最后一环 `v_grp_<g>_<n-1>`）。
            # 与 _last_group_label_map 分开存：后者含组内中间环 / 组变换 / v_out_ 等所有
            # 组相关标签，而「独立素材口径」**只对最终那一环**成立（中间环仍是一条腿）。
            # 预览那一路（_apply_node_fx 的 anchor 分支）靠这份快照认出组标签。
            self._last_group_final_labels = set(_grp_node.values())
            # 2026-10-16（用户第六轮：「画布模式 … 没接入」）：**组最终输出标签 → 该素材
            #   自己的尺寸**。素材节点勾了画布模式时 `node_material_chain` 必须知道
            #   「自己多大」才产得出画布图（画布=内容=这个尺寸）。
            # 取值口径与编辑器 `_open_canvas_editor` **完全同源**：
            #   `_node_canvas_space_size` =「包装盒作底 + 只套 scale」⇒ 这里就用
            #   `_group_material_scaled_size(盒, 该素材项的 key)`；未缩放 / key 取不到
            #   ⇒ 回落未缩放盒（老工程逐字节不变）。
            # ⚠️ 为什么必须是**缩放后**尺寸：`build_canvas_filtergraph` 的内容腿被强制
            #   `scale_enabled=False`（画布接管位置/尺寸/旋转），但它每次都把内容**重采样到
            #   W·s(t)** ⇒ W,H 就是「这一层的内容基准尺寸」，素材自己那把 scale 必须体现在
            #   这里，否则画布内容与编辑器看到的（= 缩放后盒）对不上。
            _mat_sz = {}
            for _g_id, _g_lab in _grp_node.items():
                try:
                    _d_g = _grp_ok.get(_g_id) or {}
                    _g_sz = (_d_g.get("geo") or {}).get("size") or _d_g.get("gsize")
                    if not _g_sz:
                        continue
                    _g_key = self._group_final_label_key(
                        _g_id, len(_d_g.get("mems") or ()))
                    _g_use = self._group_material_scaled_size(_g_sz, _g_key) or _g_sz
                    _mat_sz[_g_lab] = (int(_g_use[0]), int(_g_use[1]))
                except Exception:
                    continue
            self._last_group_material_size = _mat_sz
        # ⚠️ 「节点标签」的原始图快照（self._last_graph）与音频节点效果，
        #    不能在这里定稿 —— 此刻只有**视频图**，PiP 的音频段（[amain]/[afinal]/[subN]）
        #    是由调用方 _build_pip_cmd 在 _build_pip_audio 之后才拼进 complex_filter 的。
        #    提前快照/应用 ⇒ 对话框读不到音频节点、音频效果也插不进音频链。
        #    正确位置见 _build_pip_cmd（拼完音频后）。串行合并在 _build_concat_reencode_mode
        #    里定稿（那里音频本就在同一张图里）。
        complex_filter, current_v = self._apply_node_fx(
            complex_filter, current_v,
            override=node_fx_override,
            # 2026-10-16：组最终输出标签 = **独立素材** ⇒ 挂在它上面的效果按完整素材口径
            # 渲染（缩放 / 淡入淡出 / 透明度 / 抠像）；其余节点仍走旧的中间节点口径。
            material_labels=set(_grp_node.values()))
        return complex_filter, f"[{current_v}]"

    def _apply_node_fx(self, graph, final_label_name, override=None, anchor_nodes=None,
                       anchor_graph=None, material_labels=None, material_sizes=None):
        """把用户挂在图节点上的效果（self.node_fx）插回这张图里。

        ⚠️ node_fx 为空时逐字节原样返回 —— 老工程/未用该功能的用户零回归。

        按指纹定位：先重解析当前图算出「段序号+末滤镜名 → 标签」的映射，
        再逐个 key 找位置。找不到的（处理链变了）**只日志提示并跳过**，
        绝不静默插到别的节点上 —— 宁可不生效，也不能生效错地方。

        override（2026-09-26「节点效果编辑器按时间取帧」）：调用方临时提供的
        node_fx 替身 dict（只用于本次构图，不写 self）。可视化编辑器取背景帧时
        用它在后台线程排除 crop/delogo/rotate/flip 等几何效果，避免与正在编辑的
        矩形坐标空间冲突；传 None = 用 self.node_fx（默认行为，零回归）。

        anchor_nodes（2026-09-26「节点标签同步到预览」）：给出**另一张图**的 nodes
        （= 产生这些指纹的原始图）时，允许对这里没命中的 key 走 node_key_alias 重锚。
        预览图（mpv/ffplay 与管道引擎）与正式命令图是两套构图，同一个「第 N 步」的
        段序号不同 ⇒ 不重锚就几乎全部落空。None = 只用本图算 key（默认行为，零回归）。

        anchor_graph（2026-10-09「节点遮罩的预览路径」）：与 anchor_nodes 同源的
        **原始图字符串**。给了才启用两道重锚加固（不给 = 旧行为逐字不变）：
          ① 落在「本图最后一段」的重锚一律作废 —— 预览图的末段是构建器自己加的
             收尾（trim/setpts/null），与正式图的中间步没有语义对应，把效果套上去
             等于套在「整幅合成结果」上（遮罩这类产出 alpha 的效果会因此无人消费
             alpha 而彻底看不见）。
          ② 用 node_key_alias_overlay_tip 按「第 k 个 overlay 的第二输入生产者」
             把**子视频链末端**精确对齐 —— 这才是①作废后真正该去的位置。

        material_labels（2026-10-16「组最终标签 = 独立素材」）：落在这批**标签**上的效果
        改用**独立素材口径** `node_material_chain`（开缩放 / 淡入淡出 / 透明度 / 抠像），
        其余节点仍走旧的「中间节点纯像素」口径 ⇒ 老工程零回归。
        None = 回退 `self._last_group_final_labels`（上次构图快照的**组最终输出标签**），
        预览那条路就是靠它拿到组标签的。

        material_sizes（2026-10-16「素材节点画布模式」）：**组最终输出标签 → 该素材自己的
        尺寸 (w,h)**。素材节点勾了画布模式时，`node_material_chain` 必须知道「自己多大」
        才产得出画布图（画布=内容=这个尺寸，与编辑器 `_open_canvas_editor` 看到的同源）。
        形参优先；None = 回退 `self._last_group_material_size` 快照；两者都缺 ⇒ 画布模式
        仍不产图（与改动前逐字节一致，老工程零回归）。
        """
        fx = override if override is not None else getattr(self, "node_fx", None)
        if not fx or not graph:
            return graph, final_label_name
        key2seg = {}
        seg2lbl = {}
        for _i, _name, _lastf in graph_nodes(graph):
            # 🔴 2026-10-17 父行标签修复：组内每个成员腿输出都形如 `v_grp_<gid>_<i>`，
            #   node_fx_key_of_node 一律识别成 `grp:<gid>`。父行 = **最后一个**成员腿
            #   （= 组最终输出），故同 key 取**最大段序号**（构图顺序保证最后一次
            #   overlay 的输出正是父行标签）。setdefault 会让首个成员腿（组内主视频腿）
            #   抢走插入点 ⇒ delogo 被插进组内主视频腿而非父行（用户实测 bug）。
            _k = node_fx_key_of_node(_i, _name, _lastf)
            if _k.startswith("grp:"):
                if _i > key2seg.get(_k, -1):
                    key2seg[_k] = _i
            else:
                key2seg.setdefault(_k, _i)
            seg2lbl.setdefault(_i, _name)
        _mat = set(material_labels) if material_labels is not None \
            else set(getattr(self, "_last_group_final_labels", None) or ())
        # 素材标签 → 尺寸（画布模式要用；缺省从构图快照取，见 _build_overlay_filter_complex）
        _mat_sz = (material_sizes if material_sizes is not None
                   else (getattr(self, "_last_group_material_size", None) or {}))
        _alias = {}
        _anchor = bool(anchor_nodes)
        if _anchor:
            _alias = node_key_alias(anchor_nodes, graph_nodes(graph))
            if anchor_graph:
                # ① 末段不作数（详见 docstring）
                _tgt_last = -1
                for _x in graph_nodes(graph):
                    if _x[0] > _tgt_last:
                        _tgt_last = _x[0]
                _base_last = -1
                for _x in anchor_nodes:
                    if _x[0] > _base_last:
                        _base_last = _x[0]
                _base_seg_of = {}
                for _i, _name, _lastf in anchor_nodes:
                    _base_seg_of.setdefault(node_fingerprint(_i, _lastf), _i)
                _alias = {_k: _v for _k, _v in _alias.items()
                          if not (_v[1] == _tgt_last
                                  and _base_seg_of.get(_k) != _base_last)}
                # ② 子视频链末端精确重锚（只填①之后仍落空的 key）
                _tip = node_key_alias_overlay_tip(anchor_graph, graph)
                if _tip:
                    _lbl_of = {}
                    for _i, _name, _lastf in graph_nodes(graph):
                        _lbl_of.setdefault(_i, _name)
                    for _k in fx:
                        if _k in _alias:
                            continue
                        _bs = _base_seg_of.get(_k)
                        if _bs is None or _bs not in _tip:
                            continue
                        _ts = _tip[_bs]
                        if _ts in _lbl_of:
                            _alias[_k] = (_lbl_of[_ts], _ts)
        cur = graph
        try:
            # 主路径按「段序号」插入（insert_after_at，与 _apply_node_audio_fx 同机制）：
            # 同名标签多段复用时按标签找只会命中第一个；多个效果按段序号降序防漂移。
            # 指纹来自另一张图（anchor_nodes 有值）时一律走 alias 对齐（防序号巧合撞车）。
            def _ord(kv):
                _s = _alias.get(kv[0])[1] if (_anchor and kv[0] in _alias) else key2seg.get(kv[0])
                return (1, 0) if _s is None else (0, -_s)
            for _k, _settings in sorted(fx.items(), key=_ord):
                if _anchor:
                    _hit = _alias.get(_k)
                    _seg = _hit[1] if _hit else None
                    _lbl = _hit[0] if _hit else None
                    # 🔴 2026-10-17：父行 key `grp:<gid>` 是**语义 key**（跨图稳定，不随段
                    #   序号漂），而 _alias 只重锚指纹 → 父行 key 永远命不中 ⇒ 预览图里
                    #   父行效果被「处理链已变化」跳过（永不生效）。两图同构，直接用本图
                    #   key2seg（已取最大段序号 = 父行）定位即可。
                    if _seg is None and _k.startswith("grp:"):
                        _seg = key2seg.get(_k)
                        _lbl = seg2lbl.get(_seg) if _seg is not None else None
                else:
                    _seg = key2seg.get(_k)
                    _lbl = seg2lbl.get(_seg) if _seg is not None else None
                if _seg is None:
                    self._append_info_ui(
                        _('[节点] 处理链已变化，找不到 key「{0}」对应的位置 → 已跳过该节点效果。如需继续，请到右键「视频节点」里重新选择节点插入。').format(_k))
                    continue
                # 2026-10-02 L1：同一节点可挂 N 个效果 → 合并成一条 chain 一次插入
                # （顺序由列表决定；逐项插入会因同段序号漂移而错位）。
                # 2026-10-09：带标签效果（遮罩 / 局部模糊）的标签前缀必须**按节点唯一** ——
                # 否则两个节点同时挂遮罩会得到同名输出，ffmpeg 直接拒整条链。
                # 2026-10-16：落点标签属于「组最终输出」⇒ 走**独立素材口径**。
                #   同一判据也决定「要不要把该素材自己的尺寸交给画布模式」（见 material_sizes）。
                _is_mat = bool(_mat) and _lbl in _mat
                _chain = node_effect_chain_multi(
                    _settings, graph_id=node_fx_graph_id(_k),
                    material=_is_mat,
                    material_size=(_mat_sz.get(_lbl) if _is_mat else None))
                if not _chain:
                    continue
                # 2026-10-03：开放标签后统一走 insert_effect_subgraph（它内部对「单段无标签」
                # 的老形状会直接退回 insert_after_at ⇒ 老工程逐字节等价）；返回的提示照写日志。
                _new, _warn = insert_effect_subgraph(cur, _seg, _chain)
                for _msg in _warn:
                    self._append_info_ui(_("[节点] 自定义命令提示：%s") % _msg)
                if _new is None:
                    self._append_info_ui(
                        _('[节点] key「{0}」插入失败（该段输出不是单标签，可能是分叉）→ 已跳过。').format(_k))
                    continue
                cur = _new
        except Exception as e:
            self._append_info_ui(_('[节点] 应用节点效果失败（已按原图继续）: {0}').format(e))
        return cur, final_label_name

    def node_audio_effect_chain(self, settings):
        """音频节点效果链：复用 _build_audio_filters，但关闭动时间轴的项（与视频节点同口径）。

        关闭：截取 / 变速 / 倒放 / 分段 / 淡入淡出（节点处插这些会改变流向时间轴，语义不对）。
        保留：音量 / 响度标准化(loudnorm) / 降噪 / EQ / 声道 / 高低频截止 —— 即「响度统一」类需求。
        """
        s = dict(settings or {})
        # 与视频节点同口径：自定义命令优先（2026-09-27）。
        _custom = (s.get(NODE_FX_CUSTOM_KEY) or "").strip()
        if _custom:
            return _custom
        return self._build_audio_filters(
            s,
            include_trim=False, include_speed=False, include_reverse=False,
            include_fade=False, include_loudnorm=True, include_denoise=True,
            include_channel=True, include_hp=True, include_lp=True,
            include_segments=False)

    def node_audio_effect_chain_multi(self, v):
        """音频节点的效果列表 → 合并成**一条**纯滤镜串（与 node_effect_chain_multi 同口径）。

        同一节点的多项段序号相同，逐项插入会漂移 ⇒ 必须合并后一次插入，顺序 = 列表顺序。
        """
        _parts = []
        for _it in node_fx_items(v):
            _c = self.node_audio_effect_chain(_it)
            if _c:
                _parts.append(_c)
        return ",".join(_parts)

    def _apply_node_audio_fx(self, graph, final_label_name, override=None, anchor_nodes=None):
        """把音频节点效果（self.node_audio_fx）插回这张图的音频节点后（与 _apply_node_fx 同机制）。

        按指纹定位；找不到的只日志跳过，绝不插到错节点。node_audio_fx 为空时逐字节原样返回。
        """
        fx = override if override is not None else getattr(self, "node_audio_fx", None)
        if not fx or not graph:
            return graph, final_label_name
        key2seg = {}
        for _i, _name, _lastf in graph_nodes(graph):
            # 与 _apply_node_fx 同口径：grp:<gid> 同 key 取最大段序号（父行 = 组最终输出）。
            _k = node_fx_key_of_node(_i, _name, _lastf)
            if _k.startswith("grp:"):
                if _i > key2seg.get(_k, -1):
                    key2seg[_k] = _i
            else:
                key2seg.setdefault(_k, _i)
        _alias = {}
        _anchor = bool(anchor_nodes)
        if _anchor:
            _alias = node_key_alias(anchor_nodes, graph_nodes(graph))
        cur = graph
        try:
            # 同名标签多段复用（PiP 级联 amix 的 [amain]）时按标签插入只会命中第一个
            # → 主路径按「段序号」插入（insert_after_at，指纹里的段序号直接用上）。
            # 多个效果按段序号降序逐个插：先插后面的段，前面段的序号不漂移。
            # 指纹来自另一张图（anchor_nodes 有值）时**一律走 alias 对齐**：本图
            # 「同序号同滤镜」可能只是段序漂移后的巧合（#3:amix 恰好都在，但指向
            # 不同段），直接命中会插错位置；alias 带数量对等 + 第 n 次出现校验。
            def _ord(kv):
                _s = _alias.get(kv[0])[1] if (_anchor and kv[0] in _alias) else key2seg.get(kv[0])
                return (1, 0) if _s is None else (0, -_s)
            for _k, _settings in sorted(fx.items(), key=_ord):
                # 2026-10-02 L1：同一节点可挂 N 个音频效果 → 合并成一条 chain 一次插入
                _chain = self.node_audio_effect_chain_multi(_settings)
                if not _chain:
                    continue
                if _anchor:
                    _hit = _alias.get(_k)
                    _seg = _hit[1] if _hit else None
                else:
                    _seg = key2seg.get(_k)
                if _seg is None:
                    self._append_info_ui(
                        _('[音频节点] 处理链已变化，找不到 key「{0}」对应的位置 → 已跳过。').format(_k))
                    continue
                _new, _warn = insert_effect_subgraph(cur, _seg, _chain)
                for _msg in _warn:
                    self._append_info_ui(_("[音频节点] 自定义命令提示：%s") % _msg)
                if _new is None:
                    self._append_info_ui(
                        _('[音频节点] key「{0}」插入失败（该段输出不是单标签，可能是分叉）→ 已跳过。').format(_k))
                    continue
                cur = _new
        except Exception as e:
            self._append_info_ui(_('[音频节点] 应用失败（已按原图继续）: {0}').format(e))
        return cur, final_label_name

    def _save_node_audio_fx(self, key, settings, replace_index=None):
        """把某个音频节点的效果存进 self.node_audio_fx[key]（按指纹，不是按标签名）。

        2026-10-02 L1：与 `_save_node_fx` 同口径 —— 默认追加一项，replace_index 替换第 N 项。
        """
        try:
            _items = node_fx_items(self.node_audio_fx.get(key))
            _new = dict(settings or {})
            if replace_index is None or not (0 <= int(replace_index) < len(_items)):
                _items.append(_new)
            else:
                _items[int(replace_index)] = _new
            self.node_audio_fx[key] = _items
            self._append_info_ui(
                _('[音频节点] 已记录 {0} 的效果（第 {1} 条，当前共 {2} 个音频节点有效果）。').format(
                    key, len(_items), len(self.node_audio_fx)))
            self.merge_update_command_preview()
        except Exception as e:
            self._append_info_ui(_('[音频节点] 保存失败: {0}').format(e))

    def _compute_output_canvas(self, main_settings, main_file_path):
        """计算最终输出画布尺寸（优先 pad 画布，否则主视频【渲染后】尺寸）。

        供快照缩放与画布尺寸参考使用：主视频启用 pad 后，实际输出画布是
        pad 画布（含主视频偏移），而非主视频自身的渲染尺寸。
        ⚠️ 2026-08-25 修复：非 pad 分支改用 _main_render_size（含 crop/scale），
        旧实现返回源尺寸——主视频链内 scale 后 crop 上下文 iw/ih 与 mw/mh 不一致，
        blend 轨迹 clamp/静态越界判断会错。"""
        pg = _pad_canvas_geometry(main_settings)
        if pg:
            return max(2, pg[0]), max(2, pg[1])
        w, h = self._main_render_size(main_settings, main_file_path)
        if w is None or h is None:
            return 1280, 720
        return max(2, w), max(2, h)

    def _check_image_main_even_size(self, main_file, main_settings, queue_pos=None) -> bool:
        """图片主视频 + 输出尺寸非偶数 → 提示并取消（**不自动偶数化**）。

        只在「开始编码 / 开始合并 / 开始队列」这种真要跑起来的阶段调用；命令预览阶段不拦。

        queue_pos：由「开始队列」调用时传该任务在本次待跑队列里的序号（1 基）；
        None = 单次转换（开始编码 / 开始合并），文案与旧行为完全一致。

        ⚠️ 为什么只提示、绝不自动补 1 像素（用户 2026-09-20 拍板）：
        主视频与子视频常常是同一张图、只有局部不同（例如只差一件衣服），
        自动做偶数化会悄悄把其中一边缩放/裁掉 1 像素，合成时两边错开、对不齐。
        改成偶数的方式（缩放成正确尺寸 / 裁掉 1 像素）必须由用户自己定方向。

        尺寸口径与 _compute_output_canvas 同源（先 pad 画布，否则裁剪/旋转/缩放后的渲染尺寸），
        这样「已经缩放到偶数」的情况不会误报。

        返回 True = 可以继续；False = 已阻断，调用方应直接 return。
        """
        if not main_file or not self._is_static_image(main_file):
            return True
        try:
            w, h = self._compute_output_canvas(main_settings or {}, main_file)
            w, h = int(w), int(h)
        except Exception:
            return True          # 探不到尺寸就不拦，交回给 ffmpeg 自己判
        if w <= 0 or h <= 0 or (w % 2 == 0 and h % 2 == 0):
            return True
        try:
            src_w, src_h = get_video_dimensions(self.ffprobe_cmd, main_file)
        except Exception:
            src_w, src_h = None, None
        _axis = "/".join(n for n, v in ((_("宽"), w % 2), (_("高"), h % 2)) if v)
        _src = "{0}×{1}".format(src_w, src_h) if (src_w and src_h) else _("未知")
        _tag = _("队列任务 #{0}：").format(queue_pos) if queue_pos else ""
        _cancel = _("该任务未启动") if queue_pos else _("本次转换已取消")
        # ⚠️ 刻意【不弹窗】（用户 2026-09-20 要求）：模态弹窗会打断操作、很不友善。
        # 统一打到右上的「信息」区；取消动作由返回值 False 交给调用方 return。
        self._append_info_ui(
            _("[尺寸] {0}主视频是图片、输出尺寸不是偶数 → {1}\n"
              "  文件：{2}\n"
              "  图片原始尺寸：{3}\n"
              "  实际输出尺寸：{4}×{5}（{6}为奇数）\n"
              "  原因：ffmpeg 编码常用像素格式（yuv420p 等）要求宽、高都为偶数，奇数会直接报错。\n"
              "  请自行改成偶数后再转换：\n"
              "    · 缩放：在「缩放」里填一个偶数尺寸（如 1920×1080）\n"
              "    · 裁剪：把宽或高裁掉 1 像素（如 1921×1081 → 1920×1080）\n"
              "  程序不会自动补这 1 像素 —— 主/子视频可能是同一张图只差一点细节，\n"
              "  自动偶数化可能会让两边错开、对不齐，偶数方式只能由你定。").format(
                  _tag, _cancel, os.path.basename(main_file), _src, w, h, _axis))
        return False

    def _main_render_size(self, main_settings, main_file_path):
        """主视频滤镜链后的实际渲染尺寸：源旋转尺寸 + crop/scale。
        与 build_video_filter_chain 的链序（裁剪→旋转→缩放）一致。
        用于 blend 降级判定、画布计算（修复 scale 后 mw/mh 与 crop 上下文一致）。"""
        orig_w, orig_h = get_video_rotated_dimensions(self.ffprobe_cmd, main_file_path, main_settings)
        if not orig_w or not orig_h:
            return None, None
        try:
            w, h = compute_rendered_size(orig_w, orig_h, main_settings)
        except Exception:
            return orig_w, orig_h
        if not w or not h:
            return orig_w, orig_h
        return max(2, int(w)), max(2, int(h))

    def _blend_downgrade_pad(self, main_settings, main_file_path) -> Optional[Tuple[int, int]]:
        """blend 降级判定（用户拍板 2026-08-25）：pad 启用且画布任一轴大于主视频
        渲染尺寸 → 返回 (pad_w, pad_h)（需降级），否则 None。
        pad 比主视频大时画布有黑边区，blend 窗口轨迹一旦进入黑边区就脱离主视频
        像素、与黑色混合无意义（除非时刻计算与其他子视频像素的 blend，未实现）→
        强制降级普通叠加。pad ≤ 主视频（画布只是裁剪窗口，无黑边）→ 保留 blend。"""
        pg = _pad_canvas_geometry(main_settings)
        if not pg:
            return None
        mw, mh = self._main_render_size(main_settings, main_file_path)
        if not mw:
            return None
        if pg[0] > mw or pg[1] > mh:
            return (pg[0], pg[1])
        return None

    def _overlay_content_size(self, sub_file, sub_settings):
        """子视频「内容盒」渲染尺寸（未旋转 w×h，考虑元数据/用户旋转、裁剪、缩放）。

        定位语义基准：overlay_x/y（如 "W-w-10"）里的 w/h 始终指**内容盒**，旋转画布
        d×d 只是姿态载体（中心对齐）。旋转时叠加盒尺寸见 _overlay_sub_size。

        画布模式（2026-08-31）：裁剪/旋转已由画布段接管，这里算的是
        **画布尺寸 × 用户缩放** = 第 2 段缩放的目标尺寸 —— 与未开画布时的叠加尺寸
        完全等价，故下游（overlay 定位的 w/h、blend 区域、spin 对角线）零改动。"""
        if self._sub_canvas_on(sub_settings):
            _W, _H, _cw, _ch = self._sub_canvas_size(sub_settings, sub_file)
            w, h = _cw, _ch
            with suppress(Exception):
                w, h = compute_rendered_size(
                    w, h, {**sub_settings, "crop_enabled": False, "rotate": "none"})
            return max(2, int(w)), max(2, int(h))
        w, h = get_video_rotated_dimensions(self.ffprobe_cmd, sub_file, sub_settings)
        if w is None or h is None:
            w, h = self._get_video_dimensions_cached(sub_file)
            if w is None or h is None:
                w, h = 320, 240
        with suppress(Exception):
            w, h = compute_rendered_size(w, h, sub_settings)
        return max(2, int(w)), max(2, int(h))

    def _overlay_sub_size(self, sub_file, sub_settings):
        """子视频实际叠加尺寸：旋转时返回对角线 d×d（rotate ow/oh=hypot(iw,ih) 的输出
        画布）；非旋转返回内容盒渲染尺寸。

        ⚠️ 旋转判定必须走 overlay_rotation_active（唯一真相源）：此前这里只认
        spin/静态角度、漏了「列表轨迹自带旋转」→ 该场景下输出是 d×d 包装盒却按
        内容盒算中心补偿 → 导出比预览偏右下 (d-w)/2、(d-h)/2（2026-09-17 修复）。"""
        w, h = self._overlay_content_size(sub_file, sub_settings)
        if overlay_rotation_active(sub_settings):
            # 旋转时包围盒 = 对角线长度正方形，需与 rotate 的 ow/oh=hypot(iw,ih) 一致。
            # ffmpeg 对 ow/oh 取整采用四舍五入(lrint)，故这里用 round 对齐，避免混合模式差 1px。
            d = int(round(((w * w + h * h) ** 0.5)))
            w = h = d
        return max(2, int(w)), max(2, int(h))

    def _group_member_rect(self, sub_file, sub_settings, canvas):
        """单个成员在**真输出画布**上的静态矩形 (x, y, w, h)（浮点）；求不出 → None。

        坐标口径与 `_pip_overlay_xy` **同一套**（那是最权威的定位表达式生成器，改一处必查
        另一处）：位置 = overlay_x/y 在主画布域求值（w/h 变量 = **内容盒**）；旋转时叠加盒
        是 d×d ⇒ 矩形随之换成 (x-中心偏移, y-中心偏移, d, d)，与 `_pip_overlay_xy` 的
        「减 (box-w)/2」逐值一致。

        🔴 **组内主（`is_grp_base`）必须用内容盒 w×h，不能用 d×d**（2026-10-18 用户第 2 条
        「组内主开自旋转时组内成员中间有多余空白」）：C1 下组内主的 rotate 段被
        `group_base=True` **跳过**（搬去组节点），组画布内的它**没有旋转** ⇒ 实际占位就是
        内容盒。此前这里对它也走 `_overlay_sub_size`（旋转时 = hypot 正方形 d×d）⇒
        包装盒被凭空撑到 1.41 倍、成员之间多出一大片透明空白，且组内主内容相对盒原点
        偏了 (d−w)/2。组节点那边 `rotate ow/oh=hypot(iw,ih)` 仍会把整盒（= 紧凑盒 PW×PH）
        旋转成 d×d（`_group_node_xy` 的中心对齐按 PW×PH→d 补偿），语义完全一致。

        ⚠️ 只算**静态**几何：列表轨迹 / 轨迹位移的成员按「起点位置」计（全时段极值见
        research/pip-group-nest/README.md §13-5「组画布包围盒必须含旋转包装盒与轨迹全时段
        极值」，未做——需要时在这里补采样求并集）。
        """
        _cw, _ch = self._overlay_content_size(sub_file, sub_settings)
        _W, _H = canvas
        _ctx = {"W": _W, "H": _H, "w": _cw, "h": _ch}
        _x = safe_eval_expr(
            _content_box_expr(sub_settings.get('overlay_x', '0') or '0', _cw, _ch), _ctx)
        _y = safe_eval_expr(
            _content_box_expr(sub_settings.get('overlay_y', '0') or '0', _cw, _ch), _ctx)
        if _x is None or _y is None:
            return None
        if (sub_settings or {}).get("is_grp_base"):
            # 组内主：姿态（旋转/轨迹缩放）在组节点上表达 ⇒ 盒内它占内容盒（无中心偏移）
            return (float(_x), float(_y), float(_cw), float(_ch))
        _sw, _sh = self._overlay_sub_size(sub_file, sub_settings)
        _offx, _offy = _content_box_shift(_cw, _ch, _sw, _sh)
        return (float(_x) - _offx, float(_y) - _offy, float(_sw), float(_sh))

    def _group_box_geometry(self, members, main_settings=None, main_file_path=None,
                            canvas=None):
        """组「包装盒」几何 —— **唯一出处**（组画布尺寸 / 成员相对坐标 / 组节点落位）。

        members：[(file, settings), ...]，按列表序；`is_grp_base` 者 = 组内主（缺省取首个）。
        canvas ：真输出画布 (W, H)（含 pad）；None → `_compute_output_canvas(...)`。
                 两侧（构建器 / UI）必须传同一口径 ⇒ UI 传 `_get_canvas_size(主视频)`。

        返回 None（成员 < 2 / 任一矩形求不出）或 dict：
          "size"   (PW, PH)        包装盒尺寸（已向上偶数化）= **组画布尺寸**
          "origin" (OX, OY)        包装盒左上角（真主画布坐标）= **组节点落位基准**
          "rects"  [(x,y,w,h), ...] 成员矩形（真主画布坐标，与 members 同序）
          "rel"    [(rx,ry,w,h),...] 成员矩形（包装盒坐标 = 减 origin）= **成员定位坐标**
          "base"   (dx, dy)        组内主相对 origin 的偏移 ⇒ 拖盒反向映射（减它得 overlay）
          "rot"    (d, d) | None   组内主带旋转时的包装盒正方形（组节点中心对齐用）
        """
        _ms = [(f, (s or {})) for f, s in members if f]
        if len(_ms) < 2:
            return None
        if canvas is None:
            if main_file_path is None:
                return None
            try:
                canvas = self._compute_output_canvas(main_settings or {}, main_file_path)
            except Exception:
                return None
        if not canvas or canvas[0] < 2 or canvas[1] < 2:
            return None
        _bi = next((k for k, (_f, _s) in enumerate(_ms) if _s.get("is_grp_base")), 0)
        _rects = []
        for _f, _s in _ms:
            _r = self._group_member_rect(_f, _s, canvas)
            if _r is None:
                return None
            _rects.append(_r)
        _ox = min(r[0] for r in _rects)
        _oy = min(r[1] for r in _rects)
        _pw = max(r[0] + r[2] for r in _rects) - _ox
        _ph = max(r[1] + r[3] for r in _rects) - _oy
        # 向上偶数化（yuv420p 色度对齐；只多出的透明边，不挪任何成员）
        _pw = max(2, int(_pw + 0.5)) + (max(2, int(_pw + 0.5)) % 2)
        _ph = max(2, int(_ph + 0.5)) + (max(2, int(_ph + 0.5)) % 2)
        _rot = None
        # 组级角度 `grp_rot_angle`（存在组内主，与 grp_dx/grp_dy 同族）：父行 = **独立素材**
        # ⇒ 它的旋转作用于**整组**、且**不写成员自己的 rotate_angle**（否则成员各自再转一次）。
        # 缺省（老工程）不写这个键 ⇒ 判据与改动前逐字符一致（零回归）。
        _rs = dict(_ms[_bi][1])
        _gra = _opt_float(_rs.get("grp_rot_angle", 0) or 0, 0.0)
        if _gra:
            _rs["rotate_angle"] = _gra
        if overlay_rotation_active(_rs):
            _d = max(2, int(round((_pw * _pw + _ph * _ph) ** 0.5)))
            _rot = (_d, _d)
        return {
            "size": (_pw, _ph),
            "origin": (float(_ox), float(_oy)),
            "rects": _rects,
            "rel": [(r[0] - _ox, r[1] - _oy, r[2], r[3]) for r in _rects],
            "base": (float(_rects[_bi][0] - _ox), float(_rects[_bi][1] - _oy)),
            "rot": _rot,
        }



    # ---- 子视频画布模式（2026-08-31 用户拍板：两段式，画布段产出=独立数据流）----
    # 结构：第 1 段=内容贴到透明画布（NLE 的 Size/Position/Rotate 节点）→ 独立数据流；
    #      第 2 段=把这个数据流当独立文件消费（自由缩放 / 自旋转 / 透明度 / 轨迹 / 混合）
    #      → 贴主视频（NLE 的 Merge 节点）。两次 overlay 不合并。
    def _sub_canvas_on(self, sub_settings):
        """子视频是否启用画布模式（位置、尺寸、旋转）。"""
        return bool(sub_settings.get("canvas_mode")) and bool(sub_settings.get("canvas_segments"))

    def _sub_canvas_scale_notice(self, sub_settings, sub_file=None, where=""):
        """画布模式 × 列表轨迹缩放 的**共存提示**（2026-10-07 复核后由「硬互锁」收敛为纯提示）。

        历史：2026-10-07 早些时候这里是**硬互锁**（两者同开 + 任一方带缩放 ⇒ 两边缩放
        都忽略）。当时的两条理由现**双双失效**：
          ①「画布缩放本身不正常（放大不缩回）」= 画布图内部内容腿挂着「独立段
             `format=rgba` 排在逐帧变尺寸 scale 之后」锁死 z(t) 的 bug —— 已修；
          ②「ffmpeg 崩溃」= 恒零 rotate 节点 + 逐帧变尺寸 scale 共存（已由 `rot≡0 跳过`
             修复），**与列表缩放无关** —— 3333 当年崩溃的真因是它。
        Mode F2 真机复核（`tests/_dbg_canvas_wp_lock_probe.py`）：解锁后画布缩放 / 列表缩放
        **单独开、同时开都正常生效且 rc=0**（3332/3333 完整链路，锁开/锁关 rc 均 0）。

        现行为（用户拍板 2026-10-07「取消锁，只留提示」）：**两个缩放都按各自路径生效**。
        仅当「画布模式 + 列表轨迹都开」且**任一方带缩放**时给一条信息提示，说明两者语义差别：
          · 画布段缩放 = 在**固定画布窗口内**缩放内容（窗口尺寸不变）；
          · 列表轨迹缩放 = 挂在画布段之后，放大的是**整个画布盒（含窗口）**，
            `iw` = 画布窗口宽 ⇒ overlay 的 w/h 随之变化 → 画布随缩放整体变大。
        两者叠加是**相乘**关系。**提示不影响任何生成结果**（不写回、不中和）。
        返回 conflict(bool)：命中「两者都开 + 任一方带缩放」时为 True（仅供调用方判断）。
        ⚠️ 幂等、无副作用：只读 sub_settings，不改工程文件。
        """
        if not self._sub_canvas_on(sub_settings):
            return False
        # 功能2：列表轨迹（move_mode=waypoints 且有航点才算「功能开启」）
        _mv = str(sub_settings.get("move_mode", "") or "").strip()
        _wps = sub_settings.get("move_waypoints") or []
        if not (_mv == "waypoints" and any(isinstance(w, dict) for w in _wps)):
            return False                   # 没开列表轨迹 → 无共存提示

        def _scaled(container, keys):
            for it in (container or []):
                if not isinstance(it, dict):
                    continue
                for k in keys:
                    try:
                        if abs(float(it.get(k, 1.0) or 1.0) - 1.0) > 1e-9:
                            return True
                    except (TypeError, ValueError):
                        continue
            return False

        cv_scaled = _scaled(sub_settings.get("canvas_segments"),
                            ("scale_start", "scale_end"))
        wp_scaled = _scaled(_wps, ("sa", "sb"))
        if not (cv_scaled or wp_scaled):
            return False                   # 都开但都没缩放 → 无缩放叠加，不提示

        try:
            self._append_info_ui(
                _("[画布模式] 子视频同时开启了「画布模式」与「列表轨迹」，且至少一方带缩放。"
                "两者的缩放**同时生效并相乘**：画布段缩放在**固定画布窗口内**缩放内容"
                "（窗口尺寸不变，按设定坐标看局部 / 看全部）；列表轨迹缩放挂在画布之后，"
                "放大的是**整个画布盒（含窗口）**，画布随缩放整体变大（定位随内容盒 w/h 变化）。"))
        except Exception:
            pass
        return True

    def _sub_canvas_size(self, sub_settings, sub_file):
        """子视频画布模式的两个尺寸，返回 (W, H, cw, ch)：

        - W×H = 内容基准 = 子视频**原始尺寸**（画布段 scale 表达式的缩放基准）。
          ⚠️ 内容始终是完整原始画面：画布模式下前置链已关闭裁剪，裁剪只决定窗口大小。
        - cw×ch = 画布（窗口）尺寸 = 裁剪框大小（启用裁剪时）或原始尺寸，
          与 _open_canvas_editor 的 canvas_w/h 取值规则完全一致（用户 2026-08-31 拍板）。
        """
        try:
            W, H = self._get_video_dimensions_cached(sub_file)
        except Exception:
            W, H = None, None
        if not W or not H:
            W, H = 320, 240
        cw, ch = W, H
        try:
            _c = _resolve_crop_size(sub_settings, W, H)
            if _c:
                cw, ch = _c
        except Exception:
            pass
        return int(W), int(H), int(cw), int(ch)

    def _build_sub_canvas_graph(self, sub_settings, sub_file, tag, src_label, out_label,
                                trim_start=0.0, speed_factor=1.0,
                                out_scale_expr=None):
        """子视频画布段（第 1 段）滤镜图：内容贴到**透明画布** → 产出独立数据流。

        透明底 black@0：与对角线包装盒 / 子视频 spin 的 rotate c=black@0 同一路线，
        画布空白处 alpha=0 → 贴到主视频时自动不参与混合。这是子视频与主视频画布的
        **唯一且必须**的差别（主视频用不透明 black，因为画布本身就是最终背景）。
        （2026-10-07：原先的 `neutralize_scale` 参数已随「画布×列表轨迹缩放互锁」取消而移除，
        两个缩放现在都原样生效；见 `_sub_canvas_scale_notice`。）
        返回 filter_complex 片段（含标签，供调用方 append 进 filter_parts）或 None
        （未启用 / 尺寸非法 / 无有效段）。
        """
        if not self._sub_canvas_on(sub_settings):
            return None
        W, H, cw, ch = self._sub_canvas_size(sub_settings, sub_file)
        _cg = None
        try:
            _cg = build_canvas_filtergraph(
                sub_settings, W, H,
                trim_start=trim_start, speed_factor=speed_factor,
                src_label=src_label, out_label=out_label,
                canvas_color="black@0", base_vf="", tag=str(tag),
                out_scale_expr=out_scale_expr)
        except Exception:
            _cg = None
        if _cg:
            try:
                # 双层旋转提示：画布内旋转 + 第 2 段自旋转是**叠加**关系（不互斥），
                # 用户明确要求保留融合可能，故只提示不禁用（2026-08-31）。
                _note = ""
                if (sub_settings.get("spin_enabled", False)
                        and float(sub_settings.get("spin_speed", 60.0) or 0) != 0) or \
                        float(sub_settings.get("rotate_angle", 0) or 0) != 0:
                    _note = _("；第 2 段自旋转同时开启 → 与画布内旋转叠加（预期效果，非 bug）")
                self._append_info_ui(
                    _('[画布模式] 子视频画布 {0}x{1}（透明底），内容基准 {2}x{3}{4}').format(cw, ch, W, H, _note))
            except Exception:
                pass
        return _cg

    def _get_effective_duration(self, settings: dict, raw_duration: Optional[float] = None, input_path: str = None) -> Optional[float]:
        """
        计算有效时长（考虑截取和变速设置）。
        若传入 raw_duration 则直接使用，否则从 input_path 获取。
        返回秒数，失败返回 None。
        """
        # 获取原始时长
        if raw_duration is None and input_path:
            raw_duration = self._get_media_duration(input_path)
        if raw_duration is None:
            return None
    
        # 1. 截取
        if settings.get("trim_enabled", False):
            start_str = settings.get("trim_start", "").strip()
            end_str = settings.get("trim_end", "").strip()
            start_sec = time_to_seconds(start_str) if start_str else 0.0
            end_sec = time_to_seconds(end_str) if end_str else None
            if end_sec is not None and end_sec > start_sec:
                raw_duration = end_sec - start_sec
            else:
                raw_duration = raw_duration - start_sec

        # 2. 变速调整：输出时长 = 原时长 / speed_factor
        # 例如 2x 快放 → 时长减半；0.5x 慢放 → 时长翻倍
        # 独立于截取，二者可叠加
        if settings.get("speed_enabled", False):
            try:
                sf = float(settings.get("speed_factor", "1.0"))
                if sf > 0 and sf != 1.0:
                    raw_duration /= sf
            except (ValueError, TypeError):
                pass
    
        return raw_duration if raw_duration > 0 else None

    def _calc_segments_total_duration(self, settings: dict) -> float:
        """计算分段拼接模式下所有片段的总时长（含逐段变速，秒）"""
        segments = settings.get("segments", [])
        if not segments:
            return 0.0
        total = 0.0
        for seg in segments:
            start = time_to_seconds(seg.get("start", ""))
            end = time_to_seconds(seg.get("end", ""))
            if start is not None and end is not None and end > start:
                seg_dur = end - start
                # 逐段变速：输出时长 = 原片段时长 / speed
                speed_val = seg.get("speed", "1.0").strip()
                try:
                    sf = float(speed_val)
                    if sf > 0 and sf != 1.0:
                        seg_dur /= sf
                except (ValueError, TypeError):
                    pass
                total += seg_dur
            else:
                # 如果某个片段时间无效，返回0（后续会回退到原始逻辑）
                return 0.0
        return total

    def _group_overlay_enable(self, enc_settings: dict, duration: Optional[float],
                              base_win, union_win, row_item=None) -> str:
        """组节点 overlay 的 enable：**组窗口 = 成员窗口并集**（2026-10-17 用户定案）。

        `base_win = (组内主窗口起点, 结束)`、`union_win = (并集起点, 并集末)`。
        组成员在组内各有自己的 enable（阶段 A3），整组若仍按组内主窗口收口 ⇒
          · 组员比组内主结束得晚 → 后半段被砍掉（用户实测：组员设到 6s、组内主 3s，
            整组 3s 就没）；
          · 组员比组内主开始得早 → 整段被组入点挡掉（成员腿已落绝对时间轴，前段真没组）；
        故两端都向并集外扩：只替换 `show_start/show_end`，起始/循环显示等其余条件仍由
        `_calc_enable_expr` 统一出串。

        `row_item`（dict|None，2026-10-18 审计）：**父行素材项**。父行窗的「循环/绿幕」
        页也有「显示时段」，此前没有任何消费端（enable 只读组内主 + 并集）⇒ 父行里填
        起止时间等于没填。这里按既有「父行优先」语义接管：父行填了 `show_start / show_end
        / show_cycle / show_once` 就用它覆盖，**没填则保持并集口径**。`duration` 同时
        换成组窗口长度（父行 = 一条"组素材"，它的时长就是 glen）。None ⇒ 老行为逐字符不变。

        并集不超出组内主窗口（或参数缺失）⇒ **原样返回**，老工程/常规组逐字符不变。
        """
        _row = row_item if isinstance(row_item, dict) else {}
        _row_win = {k: _row.get(k) for k in
                    ("show_start", "show_end", "show_cycle", "show_once")}
        if any(str(v or "").strip() for v in _row_win.values()):
            _oss = dict(enc_settings or {})
            for _k, _v in _row_win.items():
                if str(_v or "").strip():
                    _oss[_k] = _v
            try:
                _glen = float((union_win or (0.0, 0.0))[1] or 0.0)
            except (ValueError, TypeError, IndexError):
                _glen = 0.0
            return self._calc_enable_expr(_oss, _glen or duration)
        _gen = self._calc_enable_expr(enc_settings, duration)
        try:
            _bs, _be = float((base_win or (0.0, 0.0))[0] or 0.0), \
                float((base_win or (0.0, 0.0))[1] or 0.0)
            _us, _ue = float((union_win or (0.0, 0.0))[0] or 0.0), \
                float((union_win or (0.0, 0.0))[1] or 0.0)
        except (ValueError, TypeError, IndexError):
            return _gen
        _st = _us if _us < _bs - 1e-6 else None
        _en = _ue if _ue > _be + 1e-6 else None
        if _st is None and _en is None:
            return _gen
        _gss = dict(enc_settings or {})
        if _st is not None:
            _gss["show_start"] = _ffsec(_st)
        if _en is not None:
            _gss["show_end"] = _ffsec(_en)
        return self._calc_enable_expr(_gss, duration)

    def _calc_enable_expr(self, enc_settings: dict, duration: Optional[float]) -> str:
        """计算 overlay 的 enable 表达式（FFmpeg 单表达式，多条件用 * 做 AND）。

        语义（用户拍板）：
        - 「循环显示（周期/单次）」独立参与，始终用 * 叠加：lt(mod(t,周),单)
        - 「显示时段（起始/结束）」填了就**接管时间控制**，移除次数控制的 lte(t,...)：
          between(t,起,结) / gte(t,起) / lte(t,结)
        - 未填显示时段、且勾选「启用循环控制」次数有限 → lte(t,总时长)
        - 全部为空返回 "1"（恒显示）。注意：连接符必须是 *（逗号是滤镜分隔符，会报错）。
        """
        parts = []

        # ---- 显示时段 vs 次数控制：显示时段优先（接管时间），先入列 ----
        window = self._build_show_window_expr(enc_settings, duration)
        if window:
            parts.append(window)
        else:
            loop_enabled = enc_settings.get("loop_enabled", False)
            if loop_enabled:
                # 使用公共方法获取有效时长（已含截取+变速）
                effective_duration = self._get_effective_duration(enc_settings, duration)
                if effective_duration is None:
                    effective_duration = duration
                loop_mode = enc_settings.get("loop_mode", "infinite")
                loop_count = enc_settings.get("loop_count", 3)
                if loop_mode == "once":
                    if effective_duration is not None and effective_duration > 0:
                        parts.append(f"lte(t,{effective_duration})")
                    else:
                        self._append_info_ui(_("[循环] 无法获取视频时长，将一直显示"))
                elif loop_mode == "count":
                    if effective_duration is not None and effective_duration > 0:
                        total = effective_duration * max(1, loop_count)
                        parts.append(f"lte(t,{total})")
                    else:
                        self._append_info_ui(_("[循环] 无法获取视频时长，将按次数显示但无法精确"))
                # infinite：不产生条件（恒真，无意义）

        # ---- 循环显示（周期/单次）：独立叠加，放最后 ----
        cycle_once = self._build_cycle_once_expr(enc_settings)
        if cycle_once:
            parts.append(cycle_once)

        if not parts:
            return "1"
        return "*".join(parts)

    def _build_cycle_once_expr(self, enc_settings: dict) -> str:
        """循环显示（周期/单次）enable 子表达式；未填时返回空串。"""
        _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
        cycle = _f(enc_settings.get("show_cycle"))
        once = _f(enc_settings.get("show_once"))
        if cycle is not None and once is not None and cycle > 0 and once > 0:
            return f"lt(mod(t,{_ffsec(cycle)}),{_ffsec(once)})"
        return ""

    def _build_show_window_expr(self, enc_settings: dict, duration: Optional[float] = None) -> str:
        """构建「显示时段（起始/结束）」enable 子表达式；无设置时返回空串。
        仅设开始(非0)且设了有限循环次数 → 与 _resolve_display_window 一致收口为
        between(t,开始,开始+有效时长×次数)，避免窗口有界而 enable 无界→EOF 后冻帧；
        无限循环/无次数 → 维持 gte(t,开始) 无界。开始=0 视为未设置。"""
        _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
        start = _f(enc_settings.get("show_start"))
        end = _f(enc_settings.get("show_end"))
        # 开始=0 视为未设置（与 _resolve_display_window 一致）
        if start is not None and start <= 0:
            start = None
        if start is not None and end is not None and end > start:
            return f"between(t,{_ffsec(start)},{_ffsec(end)})"
        if start is not None:
            # 仅设开始：复用 _resolve_display_window 保证窗口/enable 同步（仅有限次数才收口）
            _ws, _we, _bounded = self._resolve_display_window(enc_settings, duration, input_path=None)
            if _bounded and _we is not None and _we > _ws:
                return f"between(t,{_ffsec(_ws)},{_ffsec(_we)})"
            return f"gte(t,{_ffsec(start)})"
        if end is not None:
            return f"lte(t,{_ffsec(end)})"
        return ""

    def _resolve_display_window(self, enc_settings: dict, duration: Optional[float] = None, input_path: str = None):
        """解析「显示时段 / 循环次数」产生的**有界显示窗口**，供子视频窗口优化（有限循环+锚定+eof_action=pass）使用。

        ⚠️ 统一约定（2026-09-02，抄统一尝试版）：**凡是有限显示（有界窗口）都走 loop=N 有限循环节省模式**，
        仅当「无界」（仅 show_start → gte / loop_mode=infinite）才维持无限 loop=-1。
        有界 = show_start+show_end(between) / 仅 show_end(lte) / 仅 show_start(无界×) /
        循环次数 once·count(lte)。有界窗口外子链不产生帧，下游重滤镜（缩放/旋转/绿幕…）
        只在窗口内运行，彻底省掉「enable 隐藏但内部照跑」的浪费。

        返回 (win_start, win_end, bounded)：
        - win_start: 窗口起始（输出时间线秒）；show_start 缺失时取 0。
        - win_end:   窗口结束（秒）；None 表示**无界**（一直显示 / 周期出现 → 无法用有限循环收敛）。
        - bounded:   win_end 有限且 > win_start → 可做有限循环优化；否则维持无限 loop（行为不变）。

        语义须与 _calc_enable_expr / _build_show_window_expr **完全一致**（这是窗口优化的前提，
        否则子链 EOF 时机与 enable 隐藏时机错位会出现冻帧/截断）：
        - show_start/show_end 任一填写 → 接管时间（between/gte/lte）：
            · 双填         → between(t,s,e)  有界
            · 仅 show_end  → lte(t,e)       有界（start=0）
            · 仅 show_start(非0) + 设循环次数 → between(t,s,s+有效时长×次数)  **有界**
            · 仅 show_start(非0) + 无限循环/无次数 → gte(t,s)  **无界**（子视频此后一直显示）
            · 开始=0 → 视为未设置（落到下方次数显示分支，按次数收口）
        - 显示时段未填且启用循环控制（次数显示）→ lte(t,T) 有界（start=0）：
            · once  → T = effective_duration
            · count → T = effective_duration * loop_count
        - loop_mode=infinite → 无界（恒显示，不优化）。
        """
        _f = _opt_float  # 空串/None/非法 → None（2026-09-22 抽公共，原局部 _f 上移）
        s = _f(enc_settings.get("show_start"))
        e = _f(enc_settings.get("show_end"))
        # 开始=0 视为「未设置开始」（用户规则：开始0+无结束 → 等同没设开始，按次数收口）
        if s is not None and s <= 0:
            s = None

        def _loop_total():
            """有效时长(截取+变速) × 循环次数；once=单次时长；infinite/无循环/未启用=无界(None)。
            必须 loop_enabled 才生效（与下方第二段「显示时段未填→看循环控制」判定口径一致）。"""
            if not enc_settings.get("loop_enabled", False):
                return None
            eff = self._get_effective_duration(enc_settings, duration, input_path=input_path)
            if eff is None:
                eff = duration
            if eff is None or eff <= 0:
                return None
            mode = enc_settings.get("loop_mode", "infinite")
            if mode == "once":
                return float(eff)
            if mode == "count":
                try:
                    _cnt = max(1, int(float(enc_settings.get("loop_count", 3) or 3)))
                except (ValueError, TypeError):
                    _cnt = 1
                return float(eff) * _cnt
            return None

        if s is not None or e is not None:
            ws = s if s is not None else 0.0
            we = e
            # 仅设了开始、未设结束 → 自动按「开始 + 有效时长×循环次数」算结束（有限循环）；
            # 无限循环(loop_mode=infinite)/无循环控制时仍无界（loop=-1）。
            if we is None:
                _tot = _loop_total()
                if _tot is not None:
                    we = ws + _tot
            return ws, we, (we is not None and we > ws)
        # 显示时段未填 → 看循环控制（次数显示）。与 _calc_enable_expr 一致：once/count 才有 lte。
        if enc_settings.get("loop_enabled", False):
            _tot = _loop_total()
            if _tot is not None:
                return 0.0, _tot, True
        return 0.0, None, False


