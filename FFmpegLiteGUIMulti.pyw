# ============ 非阻塞剪贴板读取（2026-09-16 修复「导入时间」死锁） ============
# 根因：SimplePreviewer / 各「复制时间」用 clipboard_clear()+clipboard_append() 把某个
# Toplevel 登记成 Windows 剪贴板的「惰性所有者」；主线程同步 clipboard_get() 会卡在等
# WM_RENDERFORMAT（同一进程同一线程无法自服务）→ 整个 GUI 卡死、只能杀进程。
# 实测触发条件：打开过 2 个时间预览窗口并从其中复制过时间，再到别的窗口点「导入时间」。
# 修法：读取放到后台线程（Windows 用 ctypes 直接 OpenClipboard/GetClipboardData 并带超时），
# 主线程全程不阻塞、继续跑事件循环以服务 WM_RENDERFORMAT；读毕经 after(0) 把结果交还主线程。
# 三个 clipboard_get 读点（音频分段 / 通用截取 / 转换页轨道编辑）统一走这里。
def read_clipboard_safe(root, on_done, timeout=1.5):
    """非阻塞读剪贴板纯文本：读完后经主线程 after(0) 调 on_done(text)。

    text 为 str（读不到 / 异常 → 空串）。主线程调用方全程不阻塞，故即便剪贴板
    所有者是另一个 Tk 窗口（需主线程渲染）也不会自锁死。"""
    if sys.platform != "win32":
        # X11 / 其它平台：Tk clipboard 在主线程读（无 Windows 惰性所有者死锁问题）
        try:
            on_done((root.clipboard_get() or "").strip())
        except Exception:
            on_done("")
        return

    def _worker():
        text = _win_clipboard_text(timeout)
        with suppress(Exception):
            root.after(0, lambda: on_done(text if text is not None else ""))

    threading.Thread(target=_worker, daemon=True).start()


def _win_clipboard_text(timeout=1.5):
    """Windows：用 ctypes 读 CF_UNICODETEXT，带超时（别的进程占用剪贴板时不永久卡）。"""
    import ctypes
    user32 = ctypes.windll.user32
    kernel32 = ctypes.windll.kernel32
    CF_UNICODETEXT = 13
    # ⚠️ 必须显式声明 64 位句柄类型（默认 c_int 会被截断成 32 位 → GlobalLock 返回 NULL / 读到错数据）
    user32.OpenClipboard.argtypes = [ctypes.c_void_p]
    user32.OpenClipboard.restype = ctypes.c_int
    user32.CloseClipboard.restype = ctypes.c_int
    user32.GetClipboardData.argtypes = [ctypes.c_uint]
    user32.GetClipboardData.restype = ctypes.c_void_p
    kernel32.GlobalLock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalLock.restype = ctypes.c_void_p
    kernel32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalSize.argtypes = [ctypes.c_void_p]
    kernel32.GlobalSize.restype = ctypes.c_size_t
    deadline = time.time() + max(0.1, timeout)
    while time.time() < deadline:
        if user32.OpenClipboard(0):
            break
        time.sleep(0.05)
    else:
        return None
    try:
        h = user32.GetClipboardData(CF_UNICODETEXT)
        if not h:
            return None
        p = kernel32.GlobalLock(h)
        if not p:
            return None
        try:
            size = kernel32.GlobalSize(h)
            if not size:
                return None
            raw = ctypes.string_at(p, size)
            if raw.endswith(b"\x00\x00"):
                raw = raw[:-2]
            return raw.decode("utf-16-le", "replace")
        finally:
            kernel32.GlobalUnlock(h)
    finally:
        user32.CloseClipboard()
    return None


def write_clipboard_safe(root, text):
    """把纯文本写入系统剪贴板（与 read_clipboard_safe 对称、同源修复）。

    win32：用 ctypes 直接 SetClipboardData(CF_UNICODETEXT)，数据由系统持有、
    不依赖本进程存活 —— 关掉任何 Tk 窗口后剪贴板仍有效，也**不再把任何 Tk 窗口**
    登记成「惰性所有者」（外部程序粘贴时不用来向我们进程要数据、不会卡主线程）。
    后台线程执行以避开别的进程占用剪贴板时的短暂阻塞（带 1.5s 超时重试）。
    非 win32：直接用 Tk 的 clipboard（无 Windows 惰性所有者死锁问题）。

    注意：此处**不可**再用 self.win.clipboard_clear/append（会把 Toplevel 登记成惰性
    所有者，正是「导入时间」卡死的根因），所有「复制到剪贴板」点统一走本函数。"""
    text = text or ""
    if sys.platform == "win32":
        threading.Thread(target=_win_clipboard_set, args=(text,), daemon=True).start()
    else:
        try:
            root.clipboard_clear()
            root.clipboard_append(text)
        except Exception:
            pass


def _win_clipboard_set(text):
    """Windows：用 ctypes 把 UTF-16 文本写入系统剪贴板（数据归系统所有）。带超时。"""
    import ctypes
    user32 = ctypes.windll.user32
    kernel32 = ctypes.windll.kernel32
    CF_UNICODETEXT = 13
    GMEM_MOVEABLE = 0x0002
    user32.OpenClipboard.argtypes = [ctypes.c_void_p]
    user32.OpenClipboard.restype = ctypes.c_int
    user32.CloseClipboard.restype = ctypes.c_int
    user32.EmptyClipboard.restype = ctypes.c_int
    user32.SetClipboardData.argtypes = [ctypes.c_uint, ctypes.c_void_p]
    user32.SetClipboardData.restype = ctypes.c_void_p
    kernel32.GlobalAlloc.argtypes = [ctypes.c_uint, ctypes.c_size_t]
    kernel32.GlobalAlloc.restype = ctypes.c_void_p
    kernel32.GlobalLock.argtypes = [ctypes.c_void_p]
    kernel32.GlobalLock.restype = ctypes.c_void_p
    kernel32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    data = text.encode("utf-16-le") + b"\x00\x00"
    deadline = time.time() + 1.5
    while time.time() < deadline:
        if user32.OpenClipboard(0):
            break
        time.sleep(0.05)
    else:
        return
    try:
        h = kernel32.GlobalAlloc(GMEM_MOVEABLE, len(data))
        if not h:
            return
        p = kernel32.GlobalLock(h)
        if not p:
            kernel32.GlobalFree(h)  # 审计 M3：GlobalLock 失败须释放 h，否则句柄泄漏
            return
        try:
            ctypes.memmove(p, data, len(data))
        finally:
            kernel32.GlobalUnlock(h)
        user32.EmptyClipboard()
        res = user32.SetClipboardData(CF_UNICODETEXT, h)
        if not res:
            kernel32.GlobalFree(h)  # 审计 M3：SetClipboardData 失败→所有权未转移，须释放 h
            return
    finally:
        user32.CloseClipboard()


def parse_ss_to_commands(text):
    """解析 `-ss S -to E` / `-ss S -t D` 逐行文本 → [(start_sec, end_sec), ...]。
    与分段拼接右栏导入同格式（复制时间按钮输出 `-ss 12.345 -to 20.000` 可直接粘贴）；
    跳过空行/# 注释/无 -ss 或无 -t/-to/时间无效/结束早于开始的行。"""
    import re as _re
    out = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = _re.search(r"-ss\s+([\d:.]+)", line, _re.IGNORECASE)
        if not m:
            continue
        s = time_to_seconds(m.group(1))
        if s is None:
            continue
        tm = _re.search(r"-t\s+([\d:.]+)", line, _re.IGNORECASE)
        tom = _re.search(r"-to\s+([\d:.]+)", line, _re.IGNORECASE)
        if tm:
            d = time_to_seconds(tm.group(1))
            if d is None:
                continue
            e = s + d
        elif tom:
            e = time_to_seconds(tom.group(1))
            if e is None:
                continue
        else:
            continue
        if e <= s:
            continue
        out.append((s, e))
    return out


def detect_format(text):
    """内容嗅探：返回 FORMAT_* 之一。text 为文件全部内容。"""
    if not text:
        return FORMAT_CSV
    head = text[:2000]
    # FFmetadata
    if ";FFMETADATA1" in head and "[CHAPTER]" in head:
        return FORMAT_FFMETADATA
    # EDL：TITLE: 开头或 001 001 V C 事件行
    if re.search(r"(?m)^TITLE:\s", head) or re.search(r"(?m)^\d{3}\s+\d{3}\s+[VAvA]\s+C\s", head):
        return FORMAT_EDL
    # CUE：FILE "..."（单双引号均可）+ INDEX 01
    if re.search(r"(?im)^FILE\s+['\"]", head) and re.search(r"(?im)^\s*INDEX\s+01\s+\d+:\d+:\d+", head):
        return FORMAT_CUE
    # YouTube：行首 MM:SS 或 H:MM:SS 时间戳 + 标题
    yt_lines = [ln for ln in text.splitlines() if re.match(r"^\d{1,2}:\d{2}(?::\d{2})?\s+\S", ln)]
    if len(yt_lines) >= 1 and not re.search(r",|\t", head):
        return FORMAT_YOUTUBE
    return FORMAT_CSV


# ---------------------------------------------------------------------------
# 解析
# ---------------------------------------------------------------------------

def parse_ffmetadata(text):
    """解析 FFmetadata 章节 -> 内部模型列表。START/END 按 TIMEBASE 换算为秒。"""
    chapters = []
    cur = None
    timebase = 1000000  # 默认 1/1000000（微秒）
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("TIMEBASE="):
            tb = line.split("=", 1)[1].strip()
            m = re.fullmatch(r"(\d+)/(\d+)", tb)
            if m:
                den = float(m.group(2))
                timebase = den / float(m.group(1)) if float(m.group(1)) else 1.0
            else:
                timebase = 1.0
            continue
        if line == "[CHAPTER]":
            cur = {"start": None, "end": None, "title": None, "_raw_start": None, "_raw_end": None}
            chapters.append(cur)
        elif cur is not None:
            if line.upper().startswith("START="):
                cur["_raw_start"] = _opt_float(line.split("=", 1)[1])
            elif line.upper().startswith("END="):
                cur["_raw_end"] = _opt_float(line.split("=", 1)[1])
            elif line.upper().startswith("TITLE="):
                cur["title"] = line.split("=", 1)[1]
    result = []
    for c in chapters:
        if c["_raw_start"] is None:
            continue
        # timebase = "1 单位 = 多少微秒"（TIMEBASE=1/1000 → 1000 微秒 = 1 毫秒）
        start = c["_raw_start"] * timebase / 1000000.0
        end = c["_raw_end"] * timebase / 1000000.0 if c["_raw_end"] is not None else None
        result.append({
            "start": start,
            "title": c["title"] if c["title"] is not None else "",
            "end": end,
        })
    return result


def parse_cue(text):
    """解析 CUE -> 内部模型列表。TRACK 的 INDEX 01 是起点，TITLE 是曲名。"""
    chapters = []
    cur = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.upper().startswith("TRACK "):
            cur = {"start": None, "title": None}
            chapters.append(cur)
        elif cur is not None:
            up = line.upper()
            if up.startswith("TITLE"):
                # TITLE "..." 或 TITLE '...' 或 TITLE 裸文本
                raw = line[5:].strip()
                if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ('"', "'"):
                    raw = raw[1:-1]
                cur["title"] = raw
            elif up.startswith("INDEX"):
                parts = up.split()
                if len(parts) >= 3 and parts[1] == "01":
                    cur["start"] = parse_cue_tc(parts[2])
    result = []
    for c in chapters:
        if c["start"] is None:
            continue
        result.append({
            "start": c["start"],
            "title": c["title"] if c["title"] is not None else "",
            "end": None,
        })
    return result


def parse_edl(text, fps=25.0):
    """解析 EDL -> 内部模型列表。每个事件行的事件起止时间转为章节。"""
    chapters = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        m = re.match(r"^\d{3}\s+\d{3}\s+[VAvA]\s+C\s+(\S+)\s+(\S+)", line)
        if not m:
            continue
        start = parse_edl_tc(m.group(1), fps)
        end = parse_edl_tc(m.group(2), fps)
        if start is None:
            continue
        chapters.append({"start": start, "end": end, "title": ""})
    return chapters


def parse_csv(text, delimiter=None):
    """解析 CSV/文本 -> 内部模型列表。每行: 时间[,分隔]标题（或 时间 标题）。
    自动探测分隔符（逗号/制表符）。标题可选。"""
    if delimiter is None:
        first = text.splitlines()[0] if text.splitlines() else ""
        delimiter = "\t" if "\t" in first else ","
    chapters = []
    for line in text.splitlines():
        line = line.rstrip("\r\n")
        if not line.strip():
            continue
        if delimiter in line:
            parts = [p.strip() for p in line.split(delimiter)]
            time_part = parts[0]
            title = parts[1] if len(parts) > 1 else ""
        else:
            # 无分隔符：尝试 "时间 标题"（空格分隔）
            m = re.match(r"^(\S+)\s+(.+)$", line.strip())
            if m:
                time_part, title = m.group(1), m.group(2)
            else:
                time_part, title = line.strip(), ""
        start = parse_hms_ms(time_part)
        if start is None:
            continue
        chapters.append({"start": start, "title": title.strip(), "end": None})
    return chapters


def parse_youtube(text):
    """解析 YouTube 时间戳文本 -> 内部模型列表。每行 "MM:SS 标题"。"""
    chapters = []
    for line in text.splitlines():
        line = line.rstrip("\r\n")
        m = re.match(r"^(\d{1,2}:\d{2}(?::\d{2})?(?:\.\d+)?)\s+(.+)$", line.strip())
        if not m:
            continue
        start = parse_hms_ms(m.group(1))
        if start is None:
            continue
        chapters.append({"start": start, "title": m.group(2).strip(), "end": None})
    return chapters


def parse_text(text, fmt=None, fps=25.0):
    """按指定格式（或自动嗅探）解析文本 -> 内部模型列表"""
    if fmt is None:
        fmt = detect_format(text)
    if fmt == FORMAT_FFMETADATA:
        return parse_ffmetadata(text)
    if fmt == FORMAT_CUE:
        return parse_cue(text)
    if fmt == FORMAT_EDL:
        return parse_edl(text, fps)
    if fmt == FORMAT_CSV:
        return parse_csv(text)
    if fmt == FORMAT_YOUTUBE:
        return parse_youtube(text)
    return []


def parse_file(path, fmt=None, fps=25.0):
    """按指定格式（或自动嗅探）解析文件 -> 内部模型列表"""
    text = chapter_fmts.read_text_auto(path)
    return parse_text(text, fmt, fps)


# ---------------------------------------------------------------------------
# 导出
# ---------------------------------------------------------------------------

def export_ffmetadata(chapters):
    """内部模型 -> FFmetadata 文本"""
    lines = [";FFMETADATA1"]
    for c in chapters:
        lines.append("[CHAPTER]")
        lines.append("TIMEBASE=1/1000")
        lines.append("START=%d" % int(round(c["start"] * 1000)))
        end_ms = int(round(c["end"] * 1000)) if c.get("end") is not None else int(round(c["start"] * 1000))
        lines.append("END=%d" % end_ms)
        lines.append("title=%s" % c.get("title", ""))
        lines.append("")
    return "\n".join(lines) + "\n"


def export_cue(chapters, title=""):
    """内部模型 -> CUE 文本"""
    lines = []
    if title:
        lines.append('REM GENRE "Chapters"')
        lines.append('TITLE "%s"' % title.replace('"', "'"))
    lines.append('FILE "chapters.cue" WAVE')
    for i, c in enumerate(chapters, 1):
        lines.append("  TRACK %02d AUDIO" % i)
        if c.get("title"):
            lines.append('    TITLE "%s"' % c["title"].replace('"', "'"))
        ms = int(round((c["start"] % 1) * 75))
        total_s = int(c["start"])
        mi, s = divmod(total_s, 60)
        lines.append("    INDEX 01 %02d:%02d:%02d" % (mi, s, ms))
    return "\n".join(lines) + "\n"


def export_edl(chapters, fps=25.0):
    """内部模型 -> EDL 文本（SMPTE 时间码 HH:MM:SS:FF）"""
    lines = ["TITLE: Chapters", "FCM: NON-DROP FRAME"]
    for i, c in enumerate(chapters, 1):
        start = c["start"]
        end = c.get("end")
        if end is None:
            end = start  # 无 end 时用起点占位
        start_tc = _format_edl_tc(start, fps)
        end_tc = _format_edl_tc(end, fps)
        lines.append("%03d  %03d  V     C        %s %s %s %s" % (
            i, i, start_tc, end_tc, start_tc, end_tc))
        if c.get("title"):
            lines.append("* FROM CLIP NAME: %s" % c["title"].replace("|", "/"))
    return "\n".join(lines) + "\n"


def _format_edl_tc(seconds, fps=25.0):
    seconds = max(0.0, float(seconds))
    total_frames = int(round(seconds * fps))
    fr = total_frames % int(round(fps))
    total_s = total_frames // int(round(fps))
    h, rem = divmod(total_s, 3600)
    m, s = divmod(rem, 60)
    return "%02d:%02d:%02d:%02d" % (h, m, s, fr)


def build_concat_segments_from_tracks(tracks):
    """串行合并（首尾拼接）预览/导出共用的视频轨收集（纯函数，便于无头测试）。

    入参 tracks：与 self.merge_tracks 同结构的轨道列表（每个元素需有
        .enabled / .type / .file_path / .enc_settings 属性）。
    返回 (segs, skipped)：
        segs   : [{"path": normalize_path 后路径,
                   "start": float(秒), "dur": float|None(=播到结尾),
                   "trim": bool(是否启用 trim)}, ...]
        skipped: 被跳过的轨道 file_path 列表（占位/错误/文件不存在）。
    ⚠ 不做任何路径字符过滤（`=` `,` `;` `!` `%` 全保留），具体能否进 EDL 由各
        格式化函数决定：内联 edl:// 与文件版同解析器，统一用
        _edl_escape_path 的 %<字节数>%<字面值> 长度守卫（旧注释「内联禁 =、
        文件版需转义 , ;」已实测证伪，2026-10-03）。
    """
    segs, skipped = [], []
    for t in tracks:
        if not getattr(t, "enabled", False) or getattr(t, "type", None) != "video":
            continue
        es = getattr(t, "enc_settings", {}) or {}
        if es.get("_placeholder", False) or es.get("_error"):
            skipped.append(getattr(t, "file_path", None))
            continue
        fp = getattr(t, "file_path", None)
        if not fp or not os.path.exists(fp):
            skipped.append(fp)
            continue
        start, dur, trim = 0.0, None, False
        if es.get("trim_enabled", False):
            trim = True
            ss = str(es.get("trim_start", "0") or "0").strip()
            s = time_to_seconds(ss) if ss else 0.0
            if s is None or s < 0:
                s = 0.0
            ee = str(es.get("trim_end", "") or "").strip()
            if ee:
                e = time_to_seconds(ee)
                if e is not None and e > s:
                    dur = e - s
            start = s
        segs.append({"path": normalize_path(fp), "start": start, "dur": dur, "trim": trim})
    return segs, skipped


def format_mpv_edl_inline(segs):
    """内联 edl:// 条目 -> ["file,start,dur", ...]。
    路径统一走 _edl_escape_path（mpv 官方 %<字节数>%<字面值> 长度守卫），
    因此调用方**不必**再过滤含 `=` 的路径（旧限制已拆，2026-10-03 实测）。"""
    out = []
    for s in segs:
        p = _edl_escape_path(s["path"])
        if s["trim"]:
            if s["dur"] is not None:
                out.append("%s,%.6f,%.6f" % (p, s["start"], s["dur"]))
            else:
                out.append("%s,%.6f" % (p, s["start"]))
        else:
            out.append(p)
    return out


def _edl_file_title(path):
    """mpv EDL 条目第 4 参数 `title=` 的值 —— **纯文件名**（把前面路径整段去掉）。

    官方语法（mpv DOCS/edl-mpv.rst「Implicit chapters」）：::

        # mpv EDL v0
        cap.ts,5,240
        OP.mkv,0,90,title=Show Opening

    mpv 会给每段条目的虚拟时间线插一个隐式章节，默认章节标题 = 该条目的**文件名**，
    所以不写 title 时章节里显示的是完整路径，路径一长（G:/a/UIDxxx_琪公主_发布作品/
    7541606378838920483-#有点上头....mp4）OSD 上就只看见前面一截 ⇒ 显式写 title=，
    只放文件名。

    ⚠ 与 _edl_escape_path 同一套「%<字节数>%<字面值>」守卫**必须再包一层**：
      param 的普通 <value> 只允许除 `,;!` 与换行以外的字符，文件名里一个逗号
      （`a,b.mkv`）就会把这条条目切成 5 段、file/start/length 全串位。
      guard 里的 valuebytes 原样取值，逗号分号全安全。
    ⚠ 字节数按 UTF-8 算（中文文件名正确），不是字符数。
    """
    name = path.rstrip("/").rsplit("/", 1)[-1] or path
    return "%%%d%%%s" % (len(name.encode("utf-8")), name)


def format_mpv_edl_file(segs):
    """mpv 原生 EDL 文件内容（含首行 `# mpv EDL v0`，UNIX/LF 换行）。
    ⚠ 必须以 LF 换行、首行固定头，否则 mpv 解析失败（最常见的「播不起来」原因）。
    路径统一走 _edl_escape_path（与内联同一套 %<字节数>%<字面值> 长度守卫）。
    ⚠ 旧注释写「文件版 `=` 合法、只需转义 , ;」是**错的**（2026-10-03 实测）：
    文件版与内联是同一个 EDL 解析器（;` 只是换行的等价物），裸 `=` 同样被当
    name=value 分割点 → 含 `=` 的路径导出的 .edl 也播不了，已一并修好。
    ⚠ 文件版每条**都**带第 4 参数 `title=<文件名>`（内联版刻意不加，见
      format_mpv_edl_inline）——导出的 .edl 是要给人看/以后再播的，
      章节标题显示短文件名比一长串路径有用。
    """
    lines = ["# mpv EDL v0"]
    for s in segs:
        p = _edl_escape_path(s["path"])
        title = "title=" + _edl_file_title(s["path"])
        if s["trim"]:
            if s["dur"] is not None:
                lines.append("%s,%.6f,%.6f,%s" % (p, s["start"], s["dur"], title))
            else:
                lines.append("%s,%.6f,%s" % (p, s["start"], title))
        else:
            lines.append("%s,%s" % (p, title))
    return "\n".join(lines) + "\n"


def _edl_escape_path(p):
    """mpv EDL 路径转义 —— **内联 edl:// 与实体 .edl 文件同一套写法**。

    官方语法（mpv DOCS/edl-mpv.rst）：
        param ::= [ <name> '=' ] ( <value> | '%' <number> '%' <valuebytes> )
    `%<字节数>%<字面值>` 是「任意内容守卫」：valuebytes 原样取值，
    因此其中出现 `=` `,` `;` `!` `%` 换行都不再参与语法解析。
    ⚠ 实测（2026-10-03，mpv 0.41 无头真机，tests/_verify_edl_escape.py）：
      · 裸路径含 `=` 或 `,`：`file=` 命名参数会被切成 name/value 两半 → 打不开；
      · 反斜杠 `\\,` `\\;`（旧写法）：`a,b.mp4` 同样打不开 —— **已废弃，不要再用**；
      · 只转义 `,` `;` 而不管 `=`（旧 `_edl_file_escape` 的短路分支）：文件版也打不开；
      · 本函数（无条件长度守卫）：`=` `,` `;` `!` `%` 空格 `#` 中文 六种怪名全 PASS；
      · 对照：`file://` + 百分号 URL 编码 除「文件名含字面 `%`」外都 PASS，故不用它。
    ⚠ 两处纪律：① 无条件守卫，禁「只在含分隔符时才转义」的短路（否则 `=` 必漏）；
    ② 字节数按 UTF-8 算（中文路径正确），不是字符数。
    """
    return "%%%d%%%s" % (len(p.encode("utf-8")), p)


def export_csv(chapters, delimiter=","):
    """内部模型 -> CSV 文本（时间,标题）"""
    lines = []
    for c in chapters:
        lines.append("%s%s%s" % (format_seconds_short(c["start"]), delimiter, c.get("title", "")))
    return "\n".join(lines) + "\n"


def export_youtube(chapters):
    """内部模型 -> YouTube 时间戳文本（MM:SS 标题）"""
    lines = []
    for c in chapters:
        lines.append("%s %s" % (format_seconds_short(c["start"]), c.get("title", "")))
    return "\n".join(lines) + "\n"


def _srt_tc(sec):
    """秒 -> SRT 时间码 HH:MM:SS,mmm（毫秒 3 位）。"""
    sec = max(0.0, float(sec))
    ms = int(round((sec - int(sec)) * 1000))
    if ms >= 1000:
        ms = 999
    h, rem = divmod(int(sec), 3600)
    m, s = divmod(rem, 60)
    return "%02d:%02d:%02d,%03d" % (h, m, s, ms)


def _ssa_tc(sec):
    """秒 -> SSA/ASS 时间码 h:mm:ss.cc（厘秒 2 位）。ASS 规范 cc 只允许 0-99，毫秒 3 位会被解析器拒收/误读。"""
    sec = max(0.0, float(sec))
    cs = int(round((sec - int(sec)) * 100))
    if cs >= 100:
        cs = 99
    h, rem = divmod(int(sec), 3600)
    m, s = divmod(rem, 60)
    return "%d:%02d:%02d.%02d" % (h, m, s, cs)


def _chapter_end(chapters, i, fallback=2.0):
    """章节结束时间：有 end 用 end；无 end 用下一条的 start；最后一条 start+fallback。"""
    c = chapters[i]
    if c.get("end") is not None:
        return float(c["end"])
    if i + 1 < len(chapters):
        return float(chapters[i + 1]["start"])
    return float(c["start"]) + fallback


def export_srt(chapters):
    """内部模型 -> SRT 字幕文本（章节标题作为字幕文本，可改名 .srt 供播放器/剪辑软件用）"""
    lines = []
    for i, c in enumerate(chapters, 1):
        lines.append(str(i))
        lines.append("%s --> %s" % (_srt_tc(c["start"]), _srt_tc(_chapter_end(chapters, i - 1))))
        lines.append(c.get("title", "") or " ")
        lines.append("")
    return "\n".join(lines) + "\n"


def export_ssa(chapters):
    """内部模型 -> SSA 字幕文本（可改名 .ass；含 V4 默认样式，时间码厘秒 2 位）

    样式段必须有：Dialogue 引用 Default 样式而文件里无定义时，部分播放器/libass
    行为异常（实测显示时间错位）。整体结构与 Aegisub 保存的 .ssa 一致，
    兼容 .ssa/.ass 两种后缀（ASS 播放器可读 SSA，反之不行，故输出 SSA 最稳）。
    """
    lines = [
        "[Script Info]",
        "ScriptType: v4.00",
        "PlayResX: 1920",
        "PlayResY: 1080",
        "YCbCr Matrix: TV.709",
        "",
        "[V4 Styles]",
        "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, TertiaryColour, BackColour, Bold, Italic, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, AlphaLevel, Encoding",
        "Style: Default,Arial,48,16777215,255,0,0,0,0,1,2,2,2,10,10,10,0,1",
        "",
        "[Fonts]",
        "",
        "[Graphics]",
        "",
        "[Events]",
        "Format: Marked, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
    ]
    for i, c in enumerate(chapters):
        s = _ssa_tc(c["start"])
        e = _ssa_tc(_chapter_end(chapters, i))
        txt = (c.get("title", "") or " ").replace("\n", " ").replace(",", ";")
        lines.append("Dialogue: Marked=0,%s,%s,Default,,0,0,0,,%s" % (s, e, txt))
    return "\n".join(lines) + "\n"


def export_text(chapters, fmt, fps=25.0):
    """按指定格式导出内部模型 -> 文本"""
    if fmt == FORMAT_FFMETADATA:
        return export_ffmetadata(chapters)
    if fmt == FORMAT_CUE:
        return export_cue(chapters)
    if fmt == FORMAT_EDL:
        return export_edl(chapters, fps)
    if fmt == FORMAT_CSV:
        return export_csv(chapters)
    if fmt == FORMAT_YOUTUBE:
        return export_youtube(chapters)
    if fmt == FORMAT_SRT:
        return export_srt(chapters)
    if fmt == FORMAT_SSA:
        return export_ssa(chapters)
    return ""


def export_file(chapters, path, fmt, fps=25.0):
    """按指定格式导出内部模型 -> 文件"""
    text = export_text(chapters, fmt, fps)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path


# ---------------------------------------------------------------------------
# 便捷：内部模型 -> 应用可用的 FFmetadata 临时文件路径
# ---------------------------------------------------------------------------

def write_ffmetadata_temp(chapters, tmpdir=None):
    """把内部模型写成 FFmetadata 临时文件，返回文件路径（调用方负责清理）。"""
    import tempfile
    text = export_ffmetadata(chapters)
    fd, path = tempfile.mkstemp(suffix=".txt", prefix="ffchapter_", dir=tmpdir, text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    return path


# 兼容命名空间：既有调用处统一走 chapter_fmts.xxx（保持零改动）
chapter_fmts = types.SimpleNamespace(
    FORMAT_FFMETADATA=FORMAT_FFMETADATA,
    FORMAT_CUE=FORMAT_CUE,
    FORMAT_EDL=FORMAT_EDL,
    FORMAT_CSV=FORMAT_CSV,
    FORMAT_YOUTUBE=FORMAT_YOUTUBE,
    FORMAT_SRT=FORMAT_SRT,
    FORMAT_SSA=FORMAT_SSA,
    FORMAT_NAMES=FORMAT_NAMES,
    parse_hms_ms=parse_hms_ms,
    parse_cue_tc=parse_cue_tc,
    parse_edl_tc=parse_edl_tc,
    format_ffmetadata_time=format_ffmetadata_time,
    format_seconds_short=format_seconds_short,
    detect_format=detect_format,
    parse_ffmetadata=parse_ffmetadata,
    parse_cue=parse_cue,
    parse_edl=parse_edl,
    parse_csv=parse_csv,
    parse_youtube=parse_youtube,
    parse_text=parse_text,
    parse_file=parse_file,
    export_ffmetadata=export_ffmetadata,
    export_cue=export_cue,
    export_edl=export_edl,
    export_csv=export_csv,
    export_youtube=export_youtube,
    export_text=export_text,
    export_file=export_file,
    read_text_auto=read_text_auto,
    write_ffmetadata_temp=write_ffmetadata_temp,
)


class ChapterEditor:
    """章节可视化编辑器：多格式导入 → 内部模型编辑 → 导出（应用为 FFmetadata 文件）。

    chapters: list[dict] 内部模型 [{"start": 秒, "title": str, "end": 秒|None}]
    应用后 result = 编辑后的内部模型；调用方负责用 write_ffmetadata_temp 转临时文件。
    """

    def __init__(self, parent, chapters, app):
        self.parent = parent
        self.app = app
        self.chapters = copy.deepcopy(chapters)
        self.result = None
        self.edl_fps = tk.DoubleVar(value=25.0)
        # 对话框内自包含撤销/重做栈（关窗即弃，不污染主窗口历史）
        # 🔴 实现在模块级 DialogUndoStack；本类 6 个 _chapter_* 方法仅作转发壳（调用点零改动）。
        self._chapter_undo = DialogUndoStack(
            self, "chapters", self.refresh_tree, "_chapter_undo_btn", "_chapter_redo_btn")

        self.window = tk.Toplevel(parent)
        self.window.withdraw()  # 先隐藏，构建完成后再由 center_window 居中显示
        self.window.title(_("章节编辑器"))
        self.window.transient(parent)
        self.window.grab_set()
        self.window.geometry("780x520")
        center_window(self.window, 780, 520)

        self.create_widgets()
        self.refresh_tree()
        self.window.protocol("WM_DELETE_WINDOW", self.on_cancel)

    # ---------- 界面 ----------
    def create_widgets(self):
        main = ttk.Frame(self.window, padding="8")
        main.pack(fill=tk.BOTH, expand=True)

        # 工具栏：导入/导出/编辑
        toolbar = ttk.Frame(main)
        toolbar.pack(fill=tk.X, pady=(0, 4))
        ttk.Button(toolbar, text=_("导入文件..."), command=self.import_file).pack(side=tk.LEFT, padx=(0, 4))
        _export_btn = ttk.Button(toolbar, text=_("导出为..."), command=self.export_file)
        _export_btn.pack(side=tk.LEFT, padx=4)
        ToolTip(_export_btn,
                _("导出当前章节列表，支持的格式：\n"
                "· FFmetadata (.txt)  写入视频的章节元数据\n"
                "· CUE (.cue)  光盘刻录索引   · EDL (.edl)  剪辑交换（用底部帧率）\n"
                "· CSV (.csv)  表格数据   · YouTube 文本 (.txt)  简介章节描述\n\n"
                "★ 字幕格式（重点）——章节 → 字幕：开始=字幕出现，结束=字幕消失\n"
                "· SRT (.srt)：通用标准字幕，毫秒时间码 HH:MM:SS,mmm，兼容性最好，"
                "几乎所有播放器/剪辑软件直接可用\n"
                "· SSA/ASS (.ssa/.ass)：含默认样式（Arial 48 白字+描边），"
                "厘秒时间码 h:mm:ss.cc；已按规范导出（含 V4 样式段），"
                "需换字体/样式可用 Aegisub 打开另存\n\n"
                "无结束时间的章节：用下一条的开始时间，最后一条自动 +2 秒"),
                wraplength=480)
        ttk.Separator(toolbar, orient=tk.VERTICAL).pack(side=tk.LEFT, fill=tk.Y, padx=8)
        ttk.Button(toolbar, text=_("添加章节"), command=self.add_row).pack(side=tk.LEFT, padx=4)
        ttk.Button(toolbar, text=_("删除选中"), command=self.delete_row).pack(side=tk.LEFT, padx=4)
        ttk.Button(toolbar, text=_("上移"), command=lambda: self.move_row(-1)).pack(side=tk.LEFT, padx=4)
        ttk.Button(toolbar, text=_("下移"), command=lambda: self.move_row(1)).pack(side=tk.LEFT, padx=4)
        # 简易时间预览：选中章节回填开始时间；「发送到章节」把标记段起点生成章节点
        ttk.Button(toolbar, text=_("简易时间预览"), command=self.open_simple_preview).pack(side=tk.LEFT, padx=4)
        # 外部时间：弹窗粘贴 `-ss S -to E` 逐行，每段起点生成章节点
        ttk.Button(toolbar, text=_("外部时间"), command=self.open_external_time).pack(side=tk.LEFT, padx=4)

        # 表格
        columns = ("start", "title", "end")
        self.tree = ttk.Treeview(main, columns=columns, show="headings", height=12)
        self.tree.heading("start", text=_("开始时间"))
        self.tree.heading("title", text=_("标题"))
        self.tree.heading("end", text=_("结束时间（可选）"))
        self.tree.column("start", width=120)
        self.tree.column("title", width=320)
        self.tree.column("end", width=140)
        self.tree.pack(fill=tk.BOTH, expand=True, pady=4)
        self.tree.bind("<Double-1>", self.on_double_click)

        # 底部：EDL 帧率 + 按钮
        bottom = ttk.Frame(main)
        bottom.pack(fill=tk.X, pady=(4, 0))
        ttk.Label(bottom, text=_("EDL 帧率:")).pack(side=tk.LEFT)
        ttk.Spinbox(bottom, from_=1, to=120, textvariable=self.edl_fps, width=6).pack(side=tk.LEFT, padx=(2, 12))
        hint = ttk.Label(bottom, text=_("导入/导出 EDL 时使用；常用 23.98/25/29.97"), foreground="gray")
        hint.pack(side=tk.LEFT)
        _btns = ttk.Frame(bottom)
        _btns.pack(side=tk.LEFT, expand=True, fill=tk.X)
        _inner = ttk.Frame(_btns)
        _inner.pack(anchor=tk.CENTER)
        self._chapter_undo_btn = ttk.Button(_inner, text=_("撤销"), state="disabled", command=self._chapter_do_undo)
        self._chapter_undo_btn.pack(side=tk.LEFT, padx=6)
        self._chapter_redo_btn = ttk.Button(_inner, text=_("重做"), state="disabled", command=self._chapter_do_redo)
        self._chapter_redo_btn.pack(side=tk.LEFT, padx=6)
        ttk.Button(_inner, text=_("应用"), command=self.on_ok).pack(side=tk.LEFT, padx=6)
        ttk.Button(_inner, text=_("取消"), command=self.on_cancel).pack(side=tk.LEFT, padx=6)

    # ---------- 数据 ----------
    def refresh_tree(self):
        self.tree.delete(*self.tree.get_children())
        for c in self.chapters:
            self.tree.insert("", tk.END, values=(
                chapter_fmts.format_seconds_short(c["start"]) if chapter_fmts else c["start"],
                c.get("title", ""),
                chapter_fmts.format_seconds_short(c["end"]) if (chapter_fmts and c.get("end") is not None) else "",
            ))

    def _collect_from_tree(self):
        """把表格当前显示值读回 self.chapters（含用户双击编辑后的文本）"""
        for iid, c in zip(self.tree.get_children(), self.chapters):
            vals = self.tree.item(iid, "values")
            try:
                if chapter_fmts:
                    sec = chapter_fmts.parse_hms_ms(str(vals[0]))
                else:
                    sec = None
                if sec is not None:
                    c["start"] = sec
            except Exception:
                pass
            c["title"] = str(vals[1])
            with suppress(Exception):
                if chapter_fmts and str(vals[2]).strip():
                    sec = chapter_fmts.parse_hms_ms(str(vals[2]))
                    if sec is not None:
                        c["end"] = sec

    # ---------- 对话框内自包含撤销/重做（2026-09-29 Phase 2）----------
    # 与主窗口多栈引擎相互独立：本栈只管 chapters 列表本身的增删改/导入，
    # 关窗即随对象销毁自动丢弃，绝不污染主窗口的 convert/merge/tasks 历史。
    # 🔴 2026-10-15：实现已收口到模块级 DialogUndoStack，这里只留同名转发壳
    #    （调用点零改动）。实例在 __init__ 注入。
    def _chapter_snapshot(self):
        return self._chapter_undo.snapshot()

    def _chapter_begin_edit(self):
        self._chapter_undo.begin_edit()

    def _chapter_push(self, label):
        self._chapter_undo.push(label)

    def _chapter_do_undo(self):
        self._chapter_undo.undo()

    def _chapter_do_redo(self):
        self._chapter_undo.redo()

    def _chapter_refresh_undo_buttons(self):
        self._chapter_undo.refresh_buttons()

    # ---------- 编辑操作 ----------
    def add_row(self):
        self._collect_from_tree()
        self._chapter_begin_edit()
        self.chapters.append({"start": 0.0, "title": _("新章节"), "end": None})
        self.refresh_tree()
        # 选中最后一行
        kids = self.tree.get_children()
        if kids:
            self.tree.selection_set(kids[-1])
        self._chapter_push(_("添加章节"))

    def delete_row(self):
        sel = self.tree.selection()
        if alert_if(not sel, _("提示"), _("请先选中要删除的章节"), 'info'):
            return
        self._collect_from_tree()
        self._chapter_begin_edit()
        idx = self.tree.index(sel[0])
        del self.chapters[idx]
        self.refresh_tree()
        self._chapter_push(_("删除章节"))

    def move_row(self, delta):
        sel = self.tree.selection()
        if not sel:
            return
        idx = self.tree.index(sel[0])
        new = idx + delta
        if new < 0 or new >= len(self.chapters):
            return
        self._collect_from_tree()
        self._chapter_begin_edit()
        self.chapters[idx], self.chapters[new] = self.chapters[new], self.chapters[idx]
        self.refresh_tree()
        kids = self.tree.get_children()
        if new < len(kids):
            self.tree.selection_set(kids[new])
        self._chapter_push(_("移动章节"))

    def on_double_click(self, event):
        sel = self.tree.selection()
        if not sel:
            return
        iid = sel[0]
        col = self.tree.identify_column(event.x)
        idx = self.tree.index(iid)
        self._chapter_begin_edit()   # 单元格编辑前记录前态（取消/格式无效时 _chapter_push 会自动判等丢弃）
        if col == "#1":  # 开始时间
            cur = self.tree.item(iid, "values")[0]
            val = simpledialog.askstring(_("编辑开始时间"), _("开始时间（秒或 HH:MM:SS）:"), initialvalue=str(cur), parent=self.window)
            if val is not None:
                sec = chapter_fmts.parse_hms_ms(val) if chapter_fmts else None
                if alert_if(sec is None, _("提示"), _("时间格式无法识别")):
                    return
                self.chapters[idx]["start"] = sec
        elif col == "#2":  # 标题
            cur = self.tree.item(iid, "values")[1]
            val = simpledialog.askstring(_("编辑标题"), _("章节标题:"), initialvalue=str(cur), parent=self.window)
            if val is not None:
                self.chapters[idx]["title"] = val
        elif col == "#3":  # 结束时间
            cur = self.tree.item(iid, "values")[2]
            val = simpledialog.askstring(_("编辑结束时间"), _("结束时间（秒或 HH:MM:SS，留空=不指定）:"),
                                         initialvalue=str(cur), parent=self.window)
            if val is not None:
                if str(val).strip():
                    sec = chapter_fmts.parse_hms_ms(str(val)) if chapter_fmts else None
                    if alert_if(sec is None, _("提示"), _("时间格式无法识别")):
                        return
                    self.chapters[idx]["end"] = sec
                else:
                    self.chapters[idx]["end"] = None
        self.refresh_tree()
        self._chapter_push(_("编辑章节"))

    # ---------- 导入 ----------
    def import_file(self):
        path = filedialog.askopenfilename(
            title=_("导入章节文件"),
            filetypes=[(_("章节文件"), "*.txt *.cue *.edl *.csv *.chapters *.ffmeta"),
                       ("FFmetadata", "*.txt *.chapters *.ffmeta"),
                       ("CUE", "*.cue"), ("EDL", "*.edl"), ("CSV", "*.csv"), (_("所有文件"), "*.*")])
        if not path:
            return
        try:
            text = chapter_fmts.read_text_auto(path)
        except Exception as e:
            messagebox.showerror(_("导入失败"), str(e))
            return
        fmt = chapter_fmts.detect_format(text) if chapter_fmts else chapter_fmts.FORMAT_CSV
        # EDL 用当前帧率
        if fmt == chapter_fmts.FORMAT_EDL:
            chs = chapter_fmts.parse_text(text, fmt, fps=self.edl_fps.get()) if chapter_fmts else []
        else:
            chs = chapter_fmts.parse_text(text, fmt) if chapter_fmts else []
        if alert_if(not chs, _("提示"), _("未识别到任何章节（格式: %s）") % (chapter_fmts.FORMAT_NAMES.get(fmt, fmt) if chapter_fmts else "?"), 'info'):
            return
        self._chapter_begin_edit()
        self.chapters = chs
        self.refresh_tree()
        self._append_status(_("已导入 %d 个章节（格式: %s）") % (
            len(chs), chapter_fmts.FORMAT_NAMES.get(fmt, fmt) if chapter_fmts else "?"))
        self._chapter_push(_("导入文件"))

    def open_simple_preview(self):
        """简易时间预览：选中章节回填「开始时间」；「发送到章节」把标记段起点生成章节点。
        未选中也能打开（标记/发送用，不改动已有章节）。"""
        if alert_if(not self.app or not self.app.ffmpeg_cmd, _("提示"), _("未找到 ffmpeg，无法预览")):
            return
        path = ""
        try:
            # 2026-09-23：章节编辑器只在封装页使用 → 预览取封装页主视频，
            # 不再兜底到转换页 input_file（会预览另一页的视频）。
            _pf, _unused = _page_main_video(self.app, "merge")
            path = _pf or ""
        except Exception:
            path = ""
        if alert_if(not path or not os.path.exists(path), _("错误"), _("未找到主视频文件，无法时间预览"), 'error'):
            return
        release_grab(self.app.root)
        sel = self.tree.selection()
        idx = int(sel[0]) if sel else None

        def on_start(t):
            if idx is None:
                return  # 未选中章节：起点仅预览定位，不回填
            self.chapters[idx]["start"] = float(t)
            self.refresh_tree()
            self.tree.selection_set(str(idx))

        def _on_marks_to_chapters(segs):
            """标记段 → 章节点：每段起点生成一个章节（标题=标记N），
            结束时间=标记段终点（对 SRT/SSA 字幕导出很关键，必填）。"""
            added = 0
            for s, e in segs:
                self.chapters.append({"start": float(s),
                                      "title": _('标记{0}').format(len(self.chapters) + 1),
                                      "end": float(e)})  # 结束时间对字幕导出很关键，必填
                added += 1
            if added:
                self.refresh_tree()
                self.tree.selection_set(str(len(self.chapters) - 1))
                self.tree.see(str(len(self.chapters) - 1))
                # 结果只写主窗口日志，不弹窗（弹窗会让预览窗口沉底、易堆积多个预览）
                with suppress(Exception):
                    if self.app:
                        self.app._append_info_ui(
                            _('[章节] 简易预览已追加 {0} 个章节（标题=标记N，可修改）').format(added))

        try:
            self.app.show_time_picker(self.app.root, path, on_set_start=on_start,
                                      initial_marks=[(c["start"], c.get("end")) for c in self.chapters],
                                      use_output_context=False,
                                      on_send_chapters=_on_marks_to_chapters)
        finally:
            # 预览期间不恢复章节编辑器的 grab（2026-08-28）：恢复模态锁会吞掉预览窗口的
            # 点击（表现为预览窗口"被章节编辑器挡住/无法操作"），与分段拼接入口同策略——
            # 预览打开即释放，关闭后由用户重新点主窗即可。
            pass

    def open_external_time(self):
        """「外部时间」弹窗：粘贴 `-ss 12.345 -to 20.000` 逐行（简易预览「复制时间」同款格式），
        解析后每段起点生成一个章节点（标题=标记N），追加不覆盖。"""
        win = tk.Toplevel(self.window)
        win.title(_("外部时间 - 粘贴时间命令"))
        win.transient(self.window)
        win.withdraw()
        win.resizable(False, False)
        with suppress(Exception):
            win.grab_set()
        tk.Label(win,
                 text=_("每行一条 `-ss 开始 -to 结束`（或 `-t 时长`），解析后每段起点生成章节点并填结束时间：\n"
                 "如 `-ss 12.345 -to 20.000`  →  章节「标记N」12.345s → 20.000s（字幕导出用）"),
                 foreground="#333333", anchor=tk.W).pack(fill=tk.X, padx=10, pady=(10, 4))
        txt = scrolledtext.ScrolledText(win, height=12, wrap=tk.NONE, font=("Consolas", 9))
        txt.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)
        bf = ttk.Frame(win)
        bf.pack(fill=tk.X, padx=10, pady=(0, 10))

        def _do():
            pairs = parse_ss_to_commands(txt.get(1.0, tk.END))
            if alert_if(not pairs, _("提示"), _("未解析到有效时间（格式：-ss 10.5 -to 20.3）"), 'info'):
                return
            added = 0
            for s, e in pairs:
                self.chapters.append({"start": float(s),
                                      "title": _('标记{0}').format(len(self.chapters) + 1),
                                      "end": float(e)})  # 结束时间对字幕（SRT/SSA）导出很关键，必填
                added += 1
            self.refresh_tree()
            self.tree.selection_set(str(len(self.chapters) - 1))
            self.tree.see(str(len(self.chapters) - 1))
            messagebox.showinfo(_("已导入"), _('已追加 {0} 个章节（标题=标记N，可修改）').format(added))

        ttk.Button(bf, text=_("解析并添加"), command=_do).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text=_("清空"), command=lambda: txt.delete(1.0, tk.END)).pack(side=tk.LEFT, padx=2)
        ttk.Button(bf, text=_("关闭"), command=win.destroy).pack(side=tk.RIGHT, padx=2)
        center_window(win, 560, 360)
        win.deiconify()

    def export_file(self):
        self._collect_from_tree()
        if alert_if(not self.chapters, _("提示"), _("没有可导出的章节"), 'info'):
            return
        path = filedialog.asksaveasfilename(
            title=_("导出章节"),
            defaultextension=".txt",
            filetypes=[("FFmetadata", "*.txt"), ("CUE", "*.cue"), ("EDL", "*.edl"),
                       ("CSV", "*.csv"), (_("YouTube 文本"), "*.txt"),
                       (_("SRT 字幕"), "*.srt"), (_("SSA 字幕"), "*.ssa *.ass")])
        if not path:
            return
        ext = os.path.splitext(path)[1].lower()
        fmt = {".cue": "cue", ".edl": "edl", ".csv": "csv",
               ".srt": "srt", ".ssa": "ssa", ".ass": "ssa"}.get(ext, "ffmetadata")
        try:
            chapter_fmts.export_file(self.chapters, path, fmt, fps=self.edl_fps.get()) if chapter_fmts else None
        except Exception as e:
            messagebox.showerror(_("导出失败"), str(e))
            return
        self._append_status(_("已导出 %d 个章节到 %s") % (len(self.chapters), path))

    def _append_status(self, msg):
        # 简洁状态提示：复用主程序信息栏（若可用）
        with suppress(Exception):
            if self.app:
                self.app._append_info_ui(_("[章节] ") + msg)

    # ---------- 确定/取消 ----------
    def on_ok(self):
        self._collect_from_tree()
        self.chapters = [c for c in self.chapters if c.get("start", 0) is not None]
        # 按开始时间排序（容忍用户乱序）
        self.chapters.sort(key=lambda c: c.get("start", 0))
        self.result = self.chapters
        self.window.destroy()

    def on_cancel(self):
        self.result = None
        self.window.destroy()


# ================== 多流同步参考（封装页专用，2026-09-13） ==================
# 背景：封装页多机位素材（如 3 列竖屏拼横屏）需要知道彼此的时间偏移。
# 设计定案（用户 2026-09-13 拍板）：
#   - 入口：封装页轨道列表右键「多流同步参考」，只收选中的视频轨（2..6 条）
#   - 布局：上下分道（非重叠）——各轨响度不同，重叠包络无法分辨
#   - 坐标：共享一条时间轴（横轴 = 参考轨时间），非参考轨按偏移平移绘制，
#           于是「对齐」= 各自的特征峰落在同一 x
#   - 打点：锚点会话——按轨道逐个点击同一事件、各记一个时间戳；
#           锚点完成立即按偏移平移到位；两个锚点还能算出速度漂移
#   - 输出：方案 A —— 只显示与复制，【绝不】改动轨道数据
_SYNC_WAVE_SR = 8000        # 波形解码采样率（与 _WAVE_SR 一致，单声道 s16）
_SYNC_WAVE_BUCKETS = 4000   # 每轨包络桶数
# 长素材降采样（2026-09-17 实测定档）：真正吃时间的是**逐样本的纯 Python 分桶
# 循环**，成本 ≈ 线性于「时长 × 采样率」——本机实测 30 分钟音频解 4000 桶：
# 8kHz 1.61s / 4kHz 0.80s / 2kHz 0.41s → 2 小时单轨 6.5s/3.2s/1.6s，6 轨顺序
# 解 38.7s/19.1s/9.9s；而 ffmpeg 自身各采样率耗时几乎一样（≈1000× 实时）。
# 且 2 小时 ÷ 4000 桶 = 1.8s/桶 —— 长素材的显示波形本来就只是粗览，精确对齐
# 走「自动找点」（它用独立的 _SYNC_MATCH_SR 解码，不受此处影响）→ 降采样只
# 损失抗混叠低通以上的高频瞬态锐度，观感几乎无差，成本却减半。
_SYNC_WAVE_LONG_SEC = 7200.0    # 超过 2 小时视为长素材
_SYNC_WAVE_SR_LONG = 4000       # 长素材的显示采样率
